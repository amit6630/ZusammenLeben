            },
            "@media (max-width: 768px)": {
              ".faq-executive-section": {
                "padding": "40px 0 !important"
              },
              ".header-title": {
                "font-size": "2rem"
              },
              ".links-grid": {
                "grid-template-columns": "1fr"
              },
              ".disclaimer-card": {
                "flex-direction": "column",
