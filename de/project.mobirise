    "guide-house-rules-waste.html": {
      "settings": {
        "title": "Hausordnung, Mülltrennung und Nachbarn in Deutschland",
        "order": "39",
        "meta_descr": "Ruhezeiten, Mülltrennung, Lüften, Treppenhausreinigung und gute Nachbarschaft: die geschriebenen und ungeschriebenen Regeln in einer deutschen Mietwohnung.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-house-rules-waste.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-house-rules-waste.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-house-rules-waste.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-house-rules-waste.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-house-rules-waste.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Hausordnung, Mülltrennung und Nachbarn in Deutschland\" />\n<meta property=\"og:description\" content=\"Ruhezeiten, Mülltrennung, Lüften, Treppenhausreinigung und gute Nachbarschaft: die geschriebenen und ungeschriebenen Regeln in einer deutschen Mietwohnung.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-house-rules-waste.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Hausordnung, Mülltrennung und gute Nachbarschaft\",\"description\":\"Ruhezeiten, Mülltrennung, Lüften, Treppenhausreinigung und gute Nachbarschaft: die geschriebenen und ungeschriebenen Regeln in einer deutschen Mietwohnung.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-house-rules-waste.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-house-rules-waste.html\",\"wordCount\":936,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Wann sind Ruhezeiten?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Meist von 22 bis 6 oder 7 Uhr, oft auch mittags und an Sonn- und Feiertagen ganztägig.\"}},{\"@type\":\"Question\",\"name\":\"Was gehört in den Gelben Sack?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Verpackungen aus Kunststoff, Metall und Verbundstoffen wie Getränkekartons. Kein Papier und kein Glas.\"}},{\"@type\":\"Question\",\"name\":\"Wie entsorge ich alte Möbel?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Als Sperrmüll, meist nach Termin mit dem Abfallwirtschaftsbetrieb des Landkreises.\"}},{\"@type\":\"Question\",\"name\":\"Wie vermeide ich Schimmel?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Mehrmals täglich einige Minuten mit ganz geöffneten Fenstern lüften, besonders nach Kochen und Duschen.\"}},{\"@type\":\"Question\",\"name\":\"Darf ich einen Hund halten?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oft nur mit Zustimmung des Vermieters. Hunde müssen angemeldet werden, und es fällt Hundesteuer an.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Hausordnung, Mülltrennung und gute Nachbarschaft\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-house-rules-waste.html\"}]}]}</script>"
