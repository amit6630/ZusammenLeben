              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 6px 0"
            },
            ".guide-mini-card p": {
              "font-size": "0.88rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.5"
            },
            ".cta-box": {
              "text-align": "center",
              "margin-top": "30px",
              "padding": "40px 32px",
              "background": "linear-gradient(180deg, #ffffff 0%, #f8fafc 100%)"
            },
            ".cta-box h3": {
              "font-size": "1.5rem",
              "margin-bottom": "14px"
            },
