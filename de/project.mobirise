              "border-bottom": "2px solid #e2e8f0",
              "margin-bottom": "1.25rem"
            },
            ".cat-icon": {
              "color": "#2563eb"
            },
            ".word-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fill, minmax(260px, 1fr))",
