    "guide-child-benefit.html": {
      "settings": {
        "title": "Kindergeld und Familienleistungen für Ukrainer",
        "order": "31",
        "meta_descr": "Kindergeld, Kinderzuschlag, Elterngeld und Schulhilfe: welche Familienleistungen ukrainische Familien in Deutschland bekommen und wie der Antrag geht.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-child-benefit.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-child-benefit.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-child-benefit.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-child-benefit.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-child-benefit.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Kindergeld und Familienleistungen für Ukrainer\" />\n<meta property=\"og:description\" content=\"Kindergeld, Kinderzuschlag, Elterngeld und Schulhilfe: welche Familienleistungen ukrainische Familien in Deutschland bekommen und wie der Antrag geht.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-child-benefit.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Kindergeld und Familienleistungen in Deutschland\",\"description\":\"Kindergeld, Kinderzuschlag, Elterngeld und Schulhilfe: welche Familienleistungen ukrainische Familien in Deutschland bekommen und wie der Antrag geht.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-child-benefit.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-child-benefit.html\",\"wordCount\":895,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Können Ukrainer mit § 24 Kindergeld bekommen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Eltern mit Aufenthaltserlaubnis nach § 24 können Kindergeld erhalten. Der Antrag geht an die Familienkasse.\"}},{\"@type\":\"Question\",\"name\":\"Mindert das Kindergeld die Jobcenter-Leistungen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Es zählt als Einkommen des Kindes, beantragt werden muss es trotzdem.\"}},{\"@type\":\"Question\",\"name\":\"Wie weit rückwirkend wird Kindergeld gezahlt?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Meist bis zu sechs Monate vor dem Antragsmonat. Stellen Sie den Antrag früh.\"}},{\"@type\":\"Question\",\"name\":\"Was ist der Kinderzuschlag?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Eine zusätzliche Leistung für berufstätige Eltern, deren Einkommen für die Kinder nicht reicht. Er öffnet auch den Zugang zur Schulunterstützung.\"}},{\"@type\":\"Question\",\"name\":\"Wer zahlt in Bayern das Elterngeld?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Das Zentrum Bayern Familie und Soziales (ZBFS). Fragen Sie früh, am besten in der Schwangerschaft.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Kindergeld und Familienleistungen in Deutschland\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-child-benefit.html\"}]}]}</script>"
