              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
