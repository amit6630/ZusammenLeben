            },
            ".resource-group-title": {
              "font-size": "0.8rem",
              "font-weight": "800",
              "letter-spacing": "1px",
              "display": "block",
              "margin-top": "24px",
              "margin-bottom": "8px",
              "color": "#64748b",
              "text-transform": "uppercase"
            },
            ".resource-link": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "padding": "12px 0",
              "border-bottom": "1px solid #e2e8f0",
              "color": "#2563eb",
              "text-decoration": "none",
              "font-size": "0.95rem",
              "transition": "opacity 0.2s"
            },
            ".resource-link:hover": {
