    "guide-anmeldung.html": {
      "settings": {
        "title": "Anmeldung: Den Wohnsitz in Deutschland anmelden",
        "order": "30",
        "meta_descr": "So melden Sie Ihren Wohnsitz in Oberfranken an: Frist, Unterlagen, Wohnungsgeberbestätigung und warum fast jeder weitere Schritt davon abhängt.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-anmeldung.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-anmeldung.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-anmeldung.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-anmeldung.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-anmeldung.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Anmeldung: Den Wohnsitz in Deutschland anmelden\" />\n<meta property=\"og:description\" content=\"So melden Sie Ihren Wohnsitz in Oberfranken an: Frist, Unterlagen, Wohnungsgeberbestätigung und warum fast jeder weitere Schritt davon abhängt.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-anmeldung.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Anmeldung: Den Wohnsitz in Deutschland anmelden\",\"description\":\"So melden Sie Ihren Wohnsitz in Oberfranken an: Frist, Unterlagen, Wohnungsgeberbestätigung und warum fast jeder weitere Schritt davon abhängt.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-anmeldung.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-anmeldung.html\",\"wordCount\":956,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Wie lange habe ich Zeit für die Anmeldung?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Zwei Wochen nach dem Einzug, im Bürgerbüro Ihres Ortes.\"}},{\"@type\":\"Question\",\"name\":\"Kann eine Person die ganze Familie anmelden?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oft ja, mit Vollmacht und den Dokumenten der anderen. Fragen Sie Ihr Bürgerbüro.\"}},{\"@type\":\"Question\",\"name\":\"Was, wenn der Vermieter die Bestätigung verweigert?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Der Vermieter ist gesetzlich dazu verpflichtet. Fordern Sie sie schriftlich an und wenden Sie sich bei weiterer Weigerung an das Bürgerbüro.\"}},{\"@type\":\"Question\",\"name\":\"Kostet die Anmeldung Geld?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nein. Die Anmeldung und die erste Bescheinigung sind kostenlos.\"}},{\"@type\":\"Question\",\"name\":\"Wann kommt die Steuer-ID?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Meist einige Wochen nach der Anmeldung, automatisch per Post.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Anmeldung: Den Wohnsitz in Deutschland anmelden\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-anmeldung.html\"}]}]}</script>"
      },
      "components": [
        {
          "_name": "amenu1",
          "_sourceTheme": "solarm5",
          "_styles": {
            "& when (@sticky)": {
