    "guide-bank-account-phone.html": {
      "settings": {
        "title": "Bankkonto, Handy und Rundfunkbeitrag: Die ersten Schritte",
        "order": "25",
        "meta_descr": "Wie Menschen aus der Ukraine ein Konto eröffnen, sicher einen Handyvertrag wählen und mit dem Brief zum Rundfunkbeitrag umgehen. Tipps und Rechte.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-bank-account-phone.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-bank-account-phone.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-bank-account-phone.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-bank-account-phone.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-bank-account-phone.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Bankkonto, Handy und Rundfunkbeitrag: Die ersten Schritte\" />\n<meta property=\"og:description\" content=\"Wie Menschen aus der Ukraine ein Konto eröffnen, sicher einen Handyvertrag wählen und mit dem Brief zum Rundfunkbeitrag umgehen. Tipps und Rechte.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-bank-account-phone.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Bankkonto, Handyvertrag und Rundfunkbeitrag\",\"description\":\"Wie Menschen aus der Ukraine ein Konto eröffnen, sicher einen Handyvertrag wählen und mit dem Brief zum Rundfunkbeitrag umgehen. Tipps und Rechte.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-bank-account-phone.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-bank-account-phone.html\",\"wordCount\":928,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Darf eine Bank mir ein Konto verweigern?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Jeder mit rechtmäßigem Aufenthalt in der EU hat Anspruch auf ein Basiskonto. Eine Bank darf es nur aus engen gesetzlichen Gründen ablehnen.\"}},{\"@type\":\"Question\",\"name\":\"Muss ich den Rundfunkbeitrag zahlen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Jeder Haushalt zahlt ihn, aber wer Leistungen vom Jobcenter bezieht, kann eine Befreiung beantragen.\"}},{\"@type\":\"Question\",\"name\":\"Kann ich einen Haustürvertrag widerrufen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"In den meisten Fällen ja, innerhalb von 14 Tagen. Widerrufen Sie schriftlich und bewahren Sie einen Nachweis auf.\"}},{\"@type\":\"Question\",\"name\":\"Was ist ein P-Konto?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ein Pfändungsschutzkonto, das bei Schulden einen Grundbetrag vor Pfändung schützt. Jedes Konto kann umgewandelt werden.\"}},{\"@type\":\"Question\",\"name\":\"Brauche ich eine Haftpflichtversicherung?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sie ist keine Pflicht, aber sehr zu empfehlen. Sie ist günstig und deckt Schäden, die Sie anderen verursachen.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Bankkonto, Handyvertrag und Rundfunkbeitrag\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-bank-account-phone.html\"}]}]}</script>"
      },
