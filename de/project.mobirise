              "font-size": "0.85rem"
            },
            ".city-directory-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(280px, 1fr))",
              "gap": "20px"
            },
            ".city-card": {
              "background": "#ffffff",
              "padding": "25px",
              "border-radius": "10px",
              "border": "1px solid #e2e8f0",
              "box-shadow": "0 2px 8px rgba(0, 0, 0, 0.03)",
              "transition": "transform 0.2s ease"
