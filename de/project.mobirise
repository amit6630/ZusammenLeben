                "height": "85px"
              },
              ".timeline-step": {
                "flex-direction": "column",
                "align-items": "flex-start",
                "padding": "24px"
              },
              ".step-badge": {
                "margin-bottom": "10px"
              },
              ".notice-callout": {
                "flex-direction": "column",
                "text-align": "center"
              },
