                "flex-direction": "column",
                "align-items": "flex-start",
                "gap": "4px"
              }
            },
            "@media (max-width: 480px)": {
              ".card-details-grid, .two-column-grid, .three-column-grid": {
                "grid-template-columns": "1fr"
              },
              ".block-title": {
                "font-size": "1.25rem"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            },
            "@media (max-width: 575px)": {
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            "@media (max-width: 767px)": {
              ".services-grid, .team-grid, .transparency-grid, .pillars-grid, .three-column-grid, .grid-3, .grid-2, .faq-grid, .survival-grid, .portal-grid-2, .city-directory-grid, .details-cards-stack, .two-column-grid, .levels-grid, .cert-grid, .benefits-grid, .links-grid, .timeline-wrapper": {
                "display": "flex !important",
                "flex-wrap": "nowrap !important",
                "flex-direction": "row !important",
                "grid-template-columns": "none !important",
                "gap": "12px !important",
                "overflow-x": "auto",
                "overscroll-behavior-x": "contain",
                "scroll-snap-type": "x mandatory",
                "padding": "4px 2px 14px !important",
                "scrollbar-width": "none"
              },
              ".services-grid::-webkit-scrollbar, .team-grid::-webkit-scrollbar, .transparency-grid::-webkit-scrollbar, .pillars-grid::-webkit-scrollbar, .three-column-grid::-webkit-scrollbar, .grid-3::-webkit-scrollbar, .grid-2::-webkit-scrollbar, .faq-grid::-webkit-scrollbar, .survival-grid::-webkit-scrollbar, .portal-grid-2::-webkit-scrollbar, .city-directory-grid::-webkit-scrollbar, .details-cards-stack::-webkit-scrollbar, .two-column-grid::-webkit-scrollbar, .levels-grid::-webkit-scrollbar, .cert-grid::-webkit-scrollbar, .benefits-grid::-webkit-scrollbar, .links-grid::-webkit-scrollbar, .timeline-wrapper::-webkit-scrollbar": {
                "display": "none"
              },
              ".services-grid > *, .team-grid > *, .transparency-grid > *, .pillars-grid > *, .three-column-grid > *, .grid-3 > *, .grid-2 > *, .faq-grid > *, .survival-grid > *, .portal-grid-2 > *, .city-directory-grid > *, .details-cards-stack > *, .two-column-grid > *, .levels-grid > *, .cert-grid > *, .benefits-grid > *, .links-grid > *, .timeline-wrapper > *": {
                "flex": "0 0 84% !important",
                "max-width": "84% !important",
                "min-width": "0",
                "margin": "0 !important",
                "scroll-snap-align": "start"
              },
              ".timeline-wrapper::before": {
                "display": "none !important"
              },
              ".metrics-section, .services-section, .process-section, .region-section, .team-section, .transparency-section, .cta-section": {
                "padding-top": "44px !important",
                "padding-bottom": "44px !important"
              },
              ".metrics-grid": {
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr) !important",
                "gap": "10px !important"
              },
              ".word-grid": {
                "max-height": "62vh",
                "overflow-y": "auto",
                "overscroll-behavior": "contain",
                "padding-right": "4px"
              },
              ".metrics-grid > *": {
                "min-width": "0",
                "padding": "18px 10px !important"
              },
              ".metrics-grid .metric-value": {
                "font-size": "2rem !important"
              },
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_name": "header01",
          "_sourceTheme": "holidaym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"guide-executive-section\" id=\"refugee-rights-guide\">\n    <div class=\"executive-container\">\n        \n        <!-- Header -->\n        <header class=\"guide-header\">\n            <span class=\"header-tag\">UMFASSENDER LEITFADEN</span>\n            <h1 class=\"header-title\">Ihre Rechte als ukrainischer Geflüchteter in Deutschland wahrnehmen</h1>\n            <p class=\"header-lead\">\n                Von der Rechtsstellung bis zu praktischen Verfahren: worauf Sie Anspruch haben, wo Sie sich bewerben und was genau zu tun ist, wenn Sie im System feststecken.\n            </p>\n        </header>\n\n        <!-- General Disclaimer / Notice -->\n        <div class=\"disclaimer-banner\">\n            <div class=\"disclaimer-icon\">\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z\"></path><path d=\"m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z\"></path><path d=\"M7 21h10\"></path><path d=\"M12 3v18\"></path><path d=\"M3 7h18\"></path></svg>\n            </div>\n            <div class=\"disclaimer-text\">\n                <strong>Wichtiger rechtlicher Hinweis:</strong> Der Status des vorübergehenden Schutzes (§ 24) wird vom EU-Rat regelmäßig verlängert. Die Verfahren, finanziellen Beträge und Anspruchsvoraussetzungen variieren von Stadt zu Stadt und sind ständig in Bewegung. Überprüfen Sie immer das aktuelle Gesamtdatum und Ihre persönliche Ablauf-Frist bei der örtlichen Ausländerbehörde.\n            </div>\n        </div>\n\n        <!-- Section 1: The Legal Basis -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"3\" y1=\"22\" x2=\"21\" y2=\"22\"></line><line x1=\"6\" y1=\"18\" x2=\"6\" y2=\"11\"></line><line x1=\"10\" y1=\"18\" x2=\"10\" y2=\"11\"></line><line x1=\"14\" y1=\"18\" x2=\"14\" y2=\"11\"></line><line x1=\"18\" y1=\"18\" x2=\"18\" y2=\"11\"></line><polygon points=\"12 2 20 7 4 7 12 2\"></polygon></svg>\n                </span>\n                Die Rechtsgrundlage: Warum Ihr Status anders ist\n            </h2>\n            \n            <div class=\"guide-card\">\n                <p>Geflüchtete aus der Ukraine in Deutschland durchlaufen kein Standard-Asylverfahren. Stattdessen fallen sie unter die im März 2022 erstmalig in der Geschichte aktivierte <strong>Massenzustiegsrichtlinie (vorübergehender Schutz)</strong> der Europäischen Union.</p>\n                <p>In Deutschland übersetzt sich dies in einen Aufenthaltstitel nach <strong>§ 24 des Aufenthaltsgesetzes (§ 24 AufenthG)</strong>. Die praktischen Auswirkungen sind enorm: keine langwierigen Asylverfahren, keine langen Befragungen, sofortiger Zugang zum Arbeitsmarkt und Anspruch auf reguläre soziale Unterstützung.</p>\n                \n                <div class=\"rule-box green-rule\">\n                    <h3>\n                        <span class=\"inline-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"></path><path d=\"M9 18h6\"></path><path d=\"M10 22h4\"></path></svg>\n                        </span>\n                        Ein entscheidender Unterschied\n                    </h3>\n                    <p>Ein normaler Asylbewerber erhält eingeschränkte Leistungen nach dem Asylbewerberleistungsgesetz (AsylbLG). Als Inhaber von § 24 erhalten Sie Unterstützung durch das Jobcenter (Bürgergeld) nach SGB II — <strong>genau dasselbe System, das auch für deutsche Einwohner gilt.</strong> Das ist ein massiver Vorteil, den Sie kennen und einfordern müssen.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 2: The Three Documents -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"></line></svg>\n                </span>\n                Die drei Dokumente, von denen alles abhängt\n            </h2>\n            <p class=\"section-intro-text\">Bevor Sie über Rechte sprechen, müssen Sie diese drei grundlegenden Dokumente sicherstellen. Ohne sie sieht Sie das deutsche System schlichtweg nicht.</p>\n            \n            <div class=\"three-column-grid\">\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>\n                    </div>\n                    <h3>Anmeldung (Wohlwohnen)</h3>\n                    <p>Der erste und wichtigste Schritt. Registrierung im <em>Bürgerbüro</em> (Rathaus). Ohne sie können Sie kein Bankkonto eröffnen, keine Versicherungen abschließen oder Bürgergeld beantragen. Buchen Sie sofort; die Wartezeiten können Wochen betragen.</p>\n                </div>\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>\n                    </div>\n                    <h3>Aufenthaltstitel (§ 24)</h3>\n                    <p>Ausgestellt von der <em>Ausländerbehörde</em>. Ein abgelaufener Titel stoppt Zahlungen und Versicherungen. Beginnen Sie den Verlängerungsprozess mindestens 8 Wochen vor Ablauf. Auch Fiktionsbescheinigungen sind rechtlich gültig.</p>\n                </div>\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\" ry=\"2\"></rect><line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"></line></svg>\n                    </div>\n                    <h3>Bankkonto</h3>\n                    <p>Erforderlich für Jobcenter-Zahlungen, Miete und Verträge. Sie haben ein gesetzliches Recht auf ein Basiskonto in Deutschland. Wenn eine Bank Sie ablehnt, fordern Sie eine schriftliche Ablehnung und melden Sie dies der Regulierungsbehörde BaFin.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 3: Financial Support -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"2\"></rect><circle cx=\"12\" cy=\"12\" r=\"2\"></circle><path d=\"M6 12h.01M18 12h.01\"></path></svg>\n                </span>\n                Finanzielle Unterstützung (Bürgergeld)\n            </h2>\n            \n            <div class=\"guide-card\">\n                <div class=\"card-header\">\n                    <h3>Grundleistungen vom Jobcenter</h3>\n                    <span class=\"status-tag info\">Standardförderung</span>\n                </div>\n                \n                <div class=\"card-details-grid\">\n                    <div class=\"detail-box\">\n                        <h4>Regelbedarf (Lebenshaltungskosten)</h4>\n                        <p>Der Grundbetrag für den täglichen Bedarf, ausgezahlt direkt auf Ihr Konto pro Haushaltsmitglied, berechnet nach Alter und Familienstand.</p>\n                    </div>\n                    <div class=\"detail-box\">\n                        <h4>Kosten der Unterkunft (KdU)</h4>\n                        <p>Wohnkosten inklusive Kaltmiete, Nebenkosten und Heizung. Werden strikt übernommen, wenn die Wohnung als „angemessen“ gilt.</p>\n                    </div>\n                </div>\n\n                <div class=\"rule-box amber-rule\">\n                    <h3>\n                        <span class=\"inline-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg>\n                        </span>\n                        Die Regel der „angemessenen Wohnung“\n                    </h3>\n                    <p>Hier stolpern die meisten Familien. Jeder Bezirk definiert seine eigenen strikten Höchstmietgrenzen. <strong>Unterzeichnen Sie niemals einen Mietvertrag, bevor Sie eine schriftliche Genehmigung (Mietbescheinigung) vom Jobcenter erhalten haben.</strong> Wenn Sie voreilig unterschreiben, müssen Sie die Mietdifferenz aus eigener Tasche zahlen.</p>\n                </div>\n\n                <h3 class=\"subsection-title\">Zusätzliche Ansprüche (erfordern separate Anträge):</h3>\n                <div class=\"three-column-grid compact-grid\">\n                    <div class=\"guide-mini-card\">\n                        <div class=\"card-title-with-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg>\n                            <h3>Erstausstattung</h3>\n                        </div>\n                        <p>Einmalige finanzielle Hilfe für erste Möbel, Haushaltsgeräte und Kleidung. <em>Wird nicht automatisch gewährt.</em></p>\n                    </div>\n                    <div class=\"guide-mini-card\">\n                        <div class=\"card-title-with-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"16\"></line><line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"></line></svg>\n                            <h3>Mehrbedarf</h3>\n                        </div>\n                        <p>Zusätzliche monatliche Leistungen für Schwangere, Alleinerziehende oder spezielle medizinische Diäten.</p>\n                    </div>\n                    <div class=\"guide-mini-card\">\n                        <div class=\"card-title-with-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 10v6M2 10l10-5 10 5-10 5z\"></path><path d=\"M6 12v5c3 3 9 3 12 0v-5\"></path></svg>\n                            <h3>BuT (Bildung und Teilhabe)</h3>\n                        </div>\n                        <p>Ein Paket für Kinder, das Schulbedarf, Mittagessen, Nachhilfe und Sportvereinsbeiträge abdeckt.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 4: Health & Work -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"></path></svg>\n                </span>\n                Krankenversicherung, Arbeit &amp; Bildung\n            </h2>\n            \n            <div class=\"two-column-grid\">\n                <!-- Health -->\n                <div class=\"guide-subcard\">\n                    <h3>Krankenversicherung</h3>\n                    <p>Versicherung ist obligatorisch. Bürgergeld-Empfänger sind über gesetzliche Krankenkassen versichert; die Beiträge zahlt das Jobcenter.</p>\n                    <p><strong>Wussten Sie schon?</strong> Sie können eine Befreiung von Rezeptgebühren (Zuzahlungsbefreiung) beantragen. Zudem müssen Krankenhäuser Sie in Notfällen auch dann behandeln, wenn Sie Ihre Versichertenkarte noch nicht bei sich haben.</p>\n                </div>\n\n                <!-- Work -->\n                <div class=\"guide-subcard\">\n                    <h3>Das Recht zu arbeiten</h3>\n                    <p>Ihr Aufenthaltstitel nach § 24 gibt Ihnen <strong>vollen und uneingeschränkten Zugang</strong> zum Arbeitsmarkt.</p>\n                    <p>Arbeit aufzunehmen streicht nicht die Jobcenter-Unterstützung; ist Ihr Einkommen niedrig, stocken sie es schlicht auf (unter Nutzung von Freibeträgen). Sie <strong>müssen</strong> jedoch jegliches Einkommen sofort <strong>melden</strong>, um schwere Strafen zu vermeiden.</p>\n                </div>\n                \n                <!-- Housing Rights -->\n                <div class=\"guide-subcard\">\n                    <h3>Wohn- &amp; Mieterrechte</h3>\n                    <p>Mieter in Deutschland genießen hohen Schutz. Vermieter können Sie nicht ohne rechtlichen Prozess räumen, und Mietkautionen sind streng auf maximal 3 Nettokaltmieten begrenzt.</p>\n                    <p><strong>Entscheidend:</strong> Füllen Sie beim Einzug immer ein Übergabeprotokoll mit Fotos aus. Der Beitritt zu einem örtlichen Mieterverein wird dringend empfohlen.</p>\n                </div>\n\n                <!-- Education -->\n                <div class=\"guide-subcard\">\n                    <h3>Schulpflicht &amp; Anerkennung</h3>\n                    <p>Für Kinder besteht gesetzliche Schulpflicht. Fernbleiben von der Schule führt zu unmittelbaren Problemen mit Behörden.</p>\n                    <p>Für Erwachsene mit reglementierten Berufen (z. B. Medizin, Lehrkräfte) ist ein formelles Anerkennungsverfahren erforderlich. Das Jobcenter kann diesen kostenintensiven Prozess oft finanzieren.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 5: Bescheid & Widerspruch -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polyline points=\"12 6 12 12 16 14\"></polyline></svg>\n                </span>\n                Das wichtigste Verfahren: Bescheid &amp; Widerspruch\n            </h2>\n            \n            <div class=\"guide-card alert-card-border\">\n                <div class=\"card-header\">\n                    <h3>Wie die deutsche Bürokratie kommuniziert</h3>\n                    <span class=\"status-tag critical\">Zeitkritisch</span>\n                </div>\n                <p>Jede offizielle Entscheidung kommt schriftlich per Dokument namens <strong>Bescheid</strong>. Am Ende befindet sich ein Abschnitt, der Ihre Rechtsmittelbelehrung erklärt.</p>\n                \n                <div class=\"rule-box red-rule\">\n                    <h3>\n                        <span class=\"inline-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line></svg>\n                        </span>\n                        Ein Monat. Das ist alles an Zeit, die Sie haben.\n                    </h3>\n                    <p>Die Standardfrist für einen <strong>Widerspruch</strong> beträgt exakt einen Monat ab dem Tag der Zustellung der Entscheidung. Verpassen Sie dieses Zeitfenster, wird die Entscheidung rechtlich bindend und ist fast unmöglich zu ändern.</p>\n                </div>\n\n                <div class=\"detail-box full-width-detail\">\n                    <h4>Was Sie in der Praxis tun müssen:</h4>\n                    <ol class=\"action-steps-list\">\n                        <li>Öffnen Sie jeden Brief sofort und prüfen Sie das Datum.</li>\n                        <li>Wenn eine Entscheidung falsch ist, schreiben Sie einen einfachen Widerspruch. Es bedarf keiner komplexen Paragraphensprache. Schreiben Sie einfach Ihren Namen, Aktenzeichen, Datum und „Ich lege Widerspruch gegen diesen Bescheid ein“. Eine detaillierte Begründung kann nachgereicht werden.</li>\n                        <li>Versenden Sie ihn per Einschreiben oder übergeben Sie ihn persönlich gegen Eingangsstempel. Behalten Sie eine Kopie.</li>\n                        <li><strong>Ignorieren Sie niemals einen Brief.</strong> In Deutschland bedeutet Schweigen Zustimmung.</li>\n                    </ol>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 6: Mistakes & Links -->\n        <div class=\"guide-block\">\n            <div class=\"two-column-grid\">\n                \n                <!-- 8 Mistakes -->\n                <div class=\"guide-subcard\">\n                    <h3 class=\"card-title-flex\">\n                        <span class=\"icon-danger\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"15\" y1=\"9\" x2=\"9\" y2=\"15\"></line><line x1=\"9\" y1=\"9\" x2=\"15\" y2=\"15\"></line></svg>\n                        </span>\n                        8 häufige Fehler\n                    </h3>\n                    <ul class=\"numbered-list\">\n                        <li><strong>1. Keine Extra-Zahlungen beantragen.</strong> Möbel- und Bildungsfonds laufen nicht automatisch.</li>\n                        <li><strong>2. Blind einen Mietvertrag unterschreiben.</strong> Warten Sie erst auf die Jobcenter-Genehmigung.</li>\n                        <li><strong>3. Die einmonatige Widerspruchsfrist verpassen.</strong></li>\n                        <li><strong>4. Lebensänderungen nicht melden.</strong> Einkommens- oder Adressänderungen müssen sofort gemeldet werden.</li>\n                        <li><strong>5. Sich auf Telefonate verlassen.</strong> Was nicht schriftlich vorliegt, ist nicht passiert.</li>\n                        <li><strong>6. Unterlagen verlieren.</strong> Führen Sie einen Ordner und fotografieren Sie jeden Brief.</li>\n                        <li><strong>7. Diplomanerkennung verschleppen.</strong> Der Prozess dauert Monate.</li>\n                        <li><strong>8. Unverstanden unterschreiben.</strong> Bestehen Sie auf einen Dolmetscher oder eine Erklärung.</li>\n                    </ul>\n                </div>\n\n                <!-- Links -->\n                <div class=\"guide-subcard\">\n                    <h3 class=\"card-title-flex\">\n                        <span class=\"icon-primary\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\"></path><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\"></path></svg>\n                        </span>\n                        Offizielle Ressourcen\n                    </h3>\n                    \n                    <span class=\"resource-group-title\">Portale &amp; Unterstützung</span>\n                    <a href=\"https://www.germany4ukraine.de\" target=\"_blank\" rel=\"noopener\" class=\"resource-link\"><strong>Germany4Ukraine</strong> Offizielles Regierungsportal</a>\n                    <a href=\"https://handbookgermany.de\" target=\"_blank\" rel=\"noopener\" class=\"resource-link\"><strong>Handbook Germany</strong> Ratgeber auf UA/RU/EN</a>\n                    <a href=\"https://www.arbeitsagentur.de\" target=\"_blank\" rel=\"noopener\" class=\"resource-link\"><strong>Agentur für Arbeit</strong> Arbeitsagentur</a>\n                    <a href=\"https://www.jobcenter-ge.de\" target=\"_blank\" rel=\"noopener\" class=\"resource-link\"><strong>Jobcenter Portal</strong> Ihr örtliches Amt finden</a>\n\n                    <span class=\"resource-group-title\">Recht &amp; Rechte</span>\n                    <a href=\"https://www.bamf.de/DE/Themen/Integration/ZugewanderteTeilnehmende/Migrationsberatung/migrationsberatung-node.html\" target=\"_blank\" rel=\"noopener\" class=\"resource-link\"><strong>MBE-Zentren</strong> Kostenlose Migrationsberatung</a>\n                    <a href=\"https://www.mieterbund.de\" target=\"_blank\" rel=\"noopener\" class=\"resource-link\"><strong>Deutscher Mieterbund</strong> Mietergewerkschaft</a>\n                    <a href=\"https://anwaltauskunft.de\" target=\"_blank\" rel=\"noopener\" class=\"resource-link\"><strong>Anwaltverein</strong> Einen Anwalt finden</a>\n                    \n                    <div class=\"notice-highlight compact-notice\">\n                        <strong>Rechtshilfe benötigt?</strong> Fragen Sie bei Ihrem örtlichen Amtsgericht nach einem <em>Beratungshilfeschein</em> für kostengünstige Rechtsberatung.\n                    </div>\n                </div>\n\n            </div>\n        </div>\n\n        <!-- Section 7: CTA -->\n        <div class=\"guide-block\">\n            <div class=\"guide-card cta-box\">\n                <h3>Wie ZusammenLeben helfen kann</h3>\n                <p class=\"cta-description\">\n                    Wir erklären Briefe in einfachen Worten, helfen Ihnen Fristen zu verstehen, bereiten Sie auf Behördentermine vor und vermitteln Sie an Beratungsstellen. <em>(Hinweis: Wir sind keine Anwälte und können keine verbindliche Rechtsberatung erteilen oder in Ihrem Namen Widersprüche einlegen).</em>\n                </p>\n                <p class=\"cta-statement\">\n                    Kontaktieren Sie uns sofort, wenn Sie einen Brief mit einer Frist erhalten, vor der Unterzeichnung eines Mietvertrags oder wenn Ihr Aufenthaltstitel abläuft!\n                </p>\n                \n                <!-- BUTTONS -->\n                <div class=\"mbr-section-btn cta-buttons-wrapper\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn custom-btn whatsapp-btn display-4 btn-warning\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                        WhatsApp Anna\n                    </a>\n                    <a class=\"btn custom-btn outline-btn btn-primary\" href=\"mailto:zusammenleben.de@gmail.com\" data-app-placeholder=\"Type Text\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"></path><polyline points=\"22,6 12,13 2,6\"></polyline></svg>\n                        Senden Sie uns eine E-Mail\n                    </a></div>\n            </div>\n        </div>\n\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "header01-2a",
          "_isUserblock": true,
          "_cid": "vqj8NxcbaH",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            },
            "a[href*=\"thebwas.com\"]": {
              "text-decoration": "underline",
              "text-underline-offset": "3px"
            },
            ".soc-item a": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-width": "44px",
              "min-height": "44px"
            },
            ".item-wrap a": {
              "word-break": "normal !important",
              "overflow-wrap": "normal !important",
              "hyphens": "auto",
              "-webkit-hyphens": "auto"
            },
            "@media (max-width: 767px)": {
              ".lists-wrapper": {
                "display": "grid !important",
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr)",
                "column-gap": "16px"
              },
              ".lists-wrapper .list-wrap": {
                "width": "auto !important",
                "max-width": "none !important",
                "margin": "0 !important"
              },
              ".lists-wrapper .item-wrap a": {
                "overflow-wrap": "break-word !important"
              }
            }
          },
          "_name": "footer01",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 scalem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"50\" max=\"400\" step=\"10\" value=\"150\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Lists\" name=\"showLists\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"list\" min=\"1\" max=\"5\" step=\"1\" value=\"4\" condition=\"showLists\">\n        <input type=\"color\" title=\"List Active Color\" value=\"#ffffff\" name=\"activeList\" condition=\"showLists\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Social Active Color\" value=\"#FF5753\" name=\"active\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#635d60\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#0c2c68\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#292325\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            \n            <!-- עמודת טקסט וכותרת ראשית -->\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showTitle || showText || showButtons || showLogo\">\n                <div class=\"content-wrapper\">\n                    <!-- תוספת המקום ללוגו -->\n                    <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"ZusammenLeben\" width=\"171\" height=\"171\">\n                        </a>\n                    </div>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>\n                        ZUSAMMENLEBEN\n                    </b></h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                        Unterstützung bei Integration, Wohnen und Gemeinschaft für Neuzugezogene und Einheimische in der Region.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-phone mbr-iconfont mbr-iconfont-btn\"></span>\n                            Kontaktieren Sie uns\n                        </a></div>\n                </div>\n            </div>\n\n            <!-- עמודות הקישורים -->\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLists\">\n                <div class=\"lists-wrapper\">\n                    <div class=\"list-wrap\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Startseite</a></li>\n                            <li class=\"item-wrap\"><a href=\"family-stories.html\" class=\"text-white\">Familiengeschichten</a></li>\n                            <li class=\"item-wrap\"><a href=\"services.html\" class=\"text-white\">Leistungen</a></li>\n                            <li class=\"item-wrap\"><a href=\"request-assistance.html\" class=\"text-white\">Hilfe anfordern</a></li>\n                            <li class=\"item-wrap\"><a href=\"community.html\" class=\"text-white\">Gemeinschaft</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"living-in-germany.html\" class=\"text-white\">Leben in Deutschland</a></li>\n                            <li class=\"item-wrap\"><a href=\"glossary.html\" class=\"text-white\">Glossar</a></li>\n                            <li class=\"item-wrap\"><a href=\"learning-german.html\" class=\"text-white\">Deutsch lernen</a></li>\n                            <li class=\"item-wrap\"><a href=\"refugee-rights.html\" class=\"text-white\">Flüchtlingsrechte</a></li>\n                            <li class=\"item-wrap\"><a href=\"guides.html\" class=\"text-white\">Ratgeber</a></li>\n                            <li class=\"item-wrap\"><a href=\"anna-shishoili.html\" class=\"text-white\">Anna Cheishvili</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 2\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"how-to-help.html\" class=\"text-white\">Wie Sie helfen können</a></li>\n                            <li class=\"item-wrap\"><a href=\"social-activity.html\" class=\"text-white\">Soziale Aktivitäten</a></li>\n                            <li class=\"item-wrap\"><a href=\"faq.html\" class=\"text-white\">Häufige Fragen (FAQ)</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Einsatzgebiete</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 3\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"emergency.html\" class=\"text-white\">Notfall</a></li>\n                            <li class=\"item-wrap\"><a href=\"Contact.html\" class=\"text-white\">Kontakt</a></li>\n                            <li class=\"item-wrap\"><a href=\"https://wa.me/380637004615\" class=\"text-white\" target=\"_blank\" rel=\"noopener\">WhatsApp-Support</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Standort</a></li>\n                            <li class=\"item-wrap\"><a href=\"impressum.html\" class=\"text-white\">Impressum</a></li>\n                            <li class=\"item-wrap\"><a href=\"privacy.html\" class=\"text-white\">Datenschutz</a></li>\n                            <li class=\"item-wrap\"><a href=\"usingtheweb.html\" class=\"text-white\">Nutzungsbedingungen</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 4\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Datenschutzerklärung</a></li>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Nutzungsbedingungen</a></li>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Impressum</a></li>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Offizielle Website</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- אזור זכויות יוצרים ורשתות חברתיות -->\n            <div class=\"col-12\" mbr-if=\"showSocial || showCopy\">\n                <div class=\"copy-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://wa.me/380637004615\" target=\"_blank\" rel=\"noopener\" aria-label=\"WhatsApp\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-whatsapp\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"mailto:zusammenleben.de@gmail.com\" aria-label=\"E-Mail\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy, .social-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\">\n                        © Urheberrecht 2026 Zusammenleben - Alle Rechte vorbehalten · Website von <a href=\"https://thebwas.com/\" class=\"text-white\">Amit Shechter</a>\n                    </p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
