              "padding-left": "16px",
              "position": "relative"
            },
            ".link-card li::before": {
              "content": "\"•\"",
              "color": "#cbd5e1",
              "font-weight": "bold",
              "position": "absolute",
              "left": "0"
            },
            ".link-card a": {
