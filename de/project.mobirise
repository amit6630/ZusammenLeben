        {
          "_styles": {
            ".guide-executive-section": {
              "padding": "80px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "'Inter', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.65",
              "direction": "ltr",
              "text-align": "left",
              "width": "100%",
              "overflow-x": "hidden",
              "-webkit-font-smoothing": "antialiased"
            },
            ".guide-executive-section *": {
              "box-sizing": "border-box"
            },
            ".executive-container": {
              "max-width": "1000px",
              "margin": "0 auto",
              "padding": "0 24px",
              "width": "100%"
            },
            ".guide-header": {
              "text-align": "center",
              "max-width": "820px",
              "margin": "0 auto 40px"
            },
            ".header-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-top": "50px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "border": "1px solid #bfdbfe"
            },
            ".header-title": {
              "font-size": "2.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.02em",
              "margin": "12px 0 16px 0",
              "line-height": "1.25"
            },
            ".header-lead": {
              "font-size": "1.15rem",
              "color": "#475569",
              "margin": "0"
            },
            ".disclaimer-banner": {
              "border-radius": "14px",
              "padding": "20px 24px",
              "display": "flex",
              "gap": "16px",
              "align-items": "flex-start",
              "margin-bottom": "45px"
            },
            ".privacy-banner": {
              "background": "#f0fdf4",
              "border": "1px solid #bbf7d0",
              "box-shadow": "0 4px 12px rgba(22, 101, 52, 0.03)"
            },
            ".disclaimer-icon": {
              "color": "#16a34a",
              "flex-shrink": "0",
              "background": "#dcfce7",
              "width": "38px",
              "height": "38px",
              "border-radius": "10px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "border": "1px solid #bbf7d0"
            },
            ".disclaimer-text": {
              "font-size": "0.95rem",
              "color": "#166534",
              "line-height": "1.6"
            },
            ".guide-block": {
              "margin-bottom": "45px"
            },
            ".block-title": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "24px",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "border-bottom": "2px solid #e2e8f0",
              "padding-bottom": "12px"
            },
            ".title-icon": {
              "color": "#2563eb",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#eff6ff",
              "width": "36px",
              "height": "36px",
              "border-radius": "8px",
              "border": "1px solid #dbeafe"
            },
            ".guide-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "18px",
              "padding": "32px",
              "margin-bottom": "24px",
              "box-shadow": "0 4px 20px rgba(0, 0, 0, 0.02)"
            },
            ".guide-card-intro": {
              "margin-bottom": "20px",
              "color": "#475569",
              "font-size": "1rem"
            },
            ".two-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "20px"
            },
            ".guide-subcard": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "26px",
              "display": "flex",
              "flex-direction": "column"
            },
            ".guide-subcard h3": {
              "font-size": "1.15rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 12px 0"
            },
            ".guide-subcard p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin-bottom": "12px"
            },
            ".card-details-grid": {
              "display": "grid",
              "grid-template-columns": "1fr",
              "gap": "16px",
              "margin": "16px 0"
            },
            ".notice-highlight": {
              "background": "#f0f9ff",
              "border-left": "4px solid #0284c7",
              "padding": "14px 18px",
              "border-radius": "8px",
              "font-size": "0.92rem",
              "color": "#0369a1",
              "margin-top": "auto"
            },
            ".numbered-list": {
              "padding-left": "0",
              "margin": "0",
              "list-style": "none"
            },
            ".numbered-list li": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "padding": "14px 18px",
              "border-radius": "12px",
              "margin-bottom": "10px",
              "font-size": "0.95rem",
              "color": "#1e293b",
              "word-break": "break-word",
              "transition": "border-color 0.2s ease"
            },
            ".numbered-list li:hover": {
              "border-color": "#cbd5e1"
            },
            ".doc-rule": {
              "background": "#f0fdf4",
              "border": "1px solid #bbf7d0",
              "padding": "20px",
              "border-radius": "12px",
              "margin": "20px 0"
            },
            ".rule-header": {
              "display": "flex",
              "align-items": "center",
              "gap": "8px",
              "margin-bottom": "6px",
              "color": "#16a34a"
            },
            ".rule-header h3": {
              "margin": "0",
              "font-size": "1.05rem",
              "font-weight": "700",
              "color": "#166534"
            },
            ".doc-rule p": {
              "color": "#166534",
              "margin": "0",
              "font-size": "0.92rem"
            },
            ".detail-box.lang-box": {
              "background": "#eff6ff",
              "border": "1px solid #bfdbfe",
              "padding": "20px",
              "border-radius": "12px"
            },
            ".lang-header": {
              "display": "flex",
              "align-items": "center",
              "gap": "10px",
              "color": "#2563eb",
              "margin-bottom": "8px"
            },
            ".lang-header h4": {
              "color": "#1e40af",
              "margin": "0",
              "font-weight": "700",
              "font-size": "1.05rem"
            },
            ".detail-box.lang-box p": {
              "color": "#1e3a8a",
              "margin": "0",
              "font-size": "0.93rem",
              "line-height": "1.6"
            },
            ".three-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(260px, 1fr))",
              "gap": "20px"
            },
            ".guide-mini-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "24px",
              "transition": "transform 0.25s ease"
            },
            ".guide-mini-card:hover": {
              "transform": "translateY(-3px)"
            },
            ".step-badge": {
              "width": "36px",
              "height": "36px",
              "border-radius": "50%",
              "background": "#eff6ff",
              "color": "#2563eb",
              "font-weight": "800",
              "font-size": "1.05rem",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "margin-bottom": "14px",
              "border": "1px solid #bfdbfe"
            },
            ".guide-mini-card h3": {
              "font-size": "1.05rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".guide-mini-card p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.55"
            },
            ".card-divider": {
              "margin": "20px 0",
              "border": "0",
              "border-top": "1px solid #e2e8f0"
            },
            ".highlight-green-title": {
              "color": "#16a34a !important"
            },
            ".emergency-card": {
              "background": "#fef2f2 !important",
              "border": "1px solid #fecaca !important"
            },
            ".emergency-header": {
              "display": "flex",
              "align-items": "center",
              "gap": "10px",
              "color": "#dc2626",
              "margin-bottom": "10px"
            },
            ".emergency-title": {
              "color": "#dc2626 !important",
              "font-size": "1.2rem",
              "font-weight": "800",
              "margin": "0"
            },
            ".emergency-subtitle": {
              "color": "#991b1b !important",
              "font-weight": "700",
              "margin-bottom": "10px"
            },
            ".emergency-desc": {
              "color": "#7f1d1d !important",
              "font-size": "0.92rem"
            },
            ".emergency-list": {
              "margin-top": "16px"
            },
            ".emergency-list li": {
              "background": "#ffffff !important",
              "border-color": "#fecaca !important",
              "color": "#dc2626 !important",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "padding": "12px 16px"
            },
            ".emergency-list li svg": {
              "flex-shrink": "0"
            },
            ".cta-card": {
              "text-align": "center",
              "padding": "40px 32px",
              "background": "#ffffff",
              "border": "2px dashed #cbd5e1",
              "border-radius": "20px"
            },
            ".cta-card h3": {
              "font-size": "1.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "0 0 12px 0"
            },
            ".cta-notice": {
              "font-weight": "700",
              "color": "#0f172a",
              "margin-bottom": "8px",
              "font-size": "1rem"
            },
            ".cta-sub": {
              "color": "#475569",
              "margin-bottom": "24px",
              "font-size": "0.95rem"
            },
            ".cta-buttons-wrapper": {
              "display": "flex",
              "justify-content": "center",
              "gap": "14px",
              "flex-wrap": "wrap"
            },
            ".guide-executive-section .btn.custom-btn": {
              "padding": "14px 28px !important",
              "border-radius": "100px !important",
              "font-weight": "700 !important",
              "font-size": "0.95rem !important",
              "display": "inline-flex !important",
              "align-items": "center !important",
              "justify-content": "center !important",
              "gap": "10px !important",
              "transition": "all 0.25s ease !important",
              "text-decoration": "none !important",
              "border-width": "1px !important",
              "margin": "0 !important"
            },
            ".guide-executive-section .btn.whatsapp-btn": {
              "background-color": "#25d366 !important",
              "border-color": "#25d366 !important",
              "color": "#ffffff !important",
              "box-shadow": "0 4px 12px rgba(37, 211, 102, 0.2) !important"
            },
            ".guide-executive-section .btn.whatsapp-btn:hover": {
              "background-color": "#20bd5a !important",
              "border-color": "#20bd5a !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 6px 18px rgba(37, 211, 102, 0.3) !important"
            },
            "@media (min-width: 992px)": {
              ".full-width-step": {
                "grid-column": "span 2"
              }
            },
            "@media (max-width: 768px)": {
              ".guide-executive-section": {
                "padding": "50px 0 !important"
              },
              ".executive-container": {
                "padding": "0 16px"
              },
              ".header-title": {
                "font-size": "1.9rem"
              },
              ".disclaimer-banner": {
                "flex-direction": "column",
                "align-items": "center",
                "text-align": "center"
              },
              ".two-column-grid, .three-column-grid": {
                "grid-template-columns": "1fr",
                "gap": "16px"
              },
              ".guide-card, .guide-subcard, .guide-mini-card": {
                "padding": "22px 18px"
              },
              ".full-width-step": {
                "grid-column": "span 1"
              },
              ".cta-buttons-wrapper": {
                "width": "100%"
              },
              ".guide-executive-section .btn.custom-btn": {
                "width": "100% !important"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
