            },
            ".city-card:hover": {
              "transform": "translateY(-3px)",
              "border-color": "#cbd5e1"
            },
            ".city-card h4": {
              "font-size": "1.25rem",
              "color": "#0f172a",
              "margin-bottom": "15px",
