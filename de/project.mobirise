    "guide-clubs-volunteering.html": {
      "settings": {
        "title": "Vereine und Ehrenamt in Deutschland: Gemeinschaft finden",
        "order": "42",
        "meta_descr": "Sportvereine, Musik, Chöre, Feuerwehr, Kirchengruppen und Ehrenamt: wie ukrainische Familien in Oberfranken Freunde finden und ankommen.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-clubs-volunteering.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-clubs-volunteering.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-clubs-volunteering.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-clubs-volunteering.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-clubs-volunteering.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Vereine und Ehrenamt in Deutschland: Gemeinschaft finden\" />\n<meta property=\"og:description\" content=\"Sportvereine, Musik, Chöre, Feuerwehr, Kirchengruppen und Ehrenamt: wie ukrainische Familien in Oberfranken Freunde finden und ankommen.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-clubs-volunteering.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Vereine und Ehrenamt: Ihren Platz finden\",\"description\":\"Sportvereine, Musik, Chöre, Feuerwehr, Kirchengruppen und Ehrenamt: wie ukrainische Familien in Oberfranken Freunde finden und ankommen.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-clubs-volunteering.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-clubs-volunteering.html\",\"wordCount\":888,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Darf ich mit § 24 ehrenamtlich arbeiten?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Ehrenamt ist erlaubt. Melden Sie Aufwandsentschädigungen dem Jobcenter, wenn Sie Leistungen beziehen.\"}},{\"@type\":\"Question\",\"name\":\"Wer zahlt den Sportverein meines Kindes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Das Bildungs- und Teilhabepaket zahlt einen Monatsbetrag, wenn Ihre Familie Leistungen bezieht.\"}},{\"@type\":\"Question\",\"name\":\"Brauche ich gutes Deutsch für einen Verein?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nein. Vereine sind ein toller Ort zum Deutschlernen. Die meisten empfangen neue Mitglieder herzlich.\"}},{\"@type\":\"Question\",\"name\":\"Können Erwachsene zur Freiwilligen Feuerwehr?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja, nach einer Grundausbildung. Kinder und Jugendliche können in die Jugendfeuerwehr.\"}},{\"@type\":\"Question\",\"name\":\"Wie finde ich Vereine in meiner Nähe?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Über die Website der Gemeinde, Aushänge, die Lokalzeitung oder indem Sie Schule und Nachbarn fragen.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Vereine und Ehrenamt: Ihren Platz finden\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-clubs-volunteering.html\"}]}]}</script>"
      },
