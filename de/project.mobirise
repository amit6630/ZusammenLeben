    "Contact.html": {
      "settings": {
        "title": "Kontakt zu ZusammenLeben | ZusammenLeben",
        "order": "15",
        "meta_descr": "ZusammenLeben in Konradsreuth, Oberfranken: per WhatsApp, Telefon, E-Mail oder Formular. Antworten auf Ukrainisch, Russisch, Deutsch und Englisch.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/Contact.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/Contact.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/Contact.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/Contact.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/Contact.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Kontakt zu ZusammenLeben | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"ZusammenLeben in Konradsreuth, Oberfranken: per WhatsApp, Telefon, E-Mail oder Formular. Antworten auf Ukrainisch, Russisch, Deutsch und Englisch.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/Contact.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"url\":\"https://zusammenleben-ukraine.de/de/Contact.html\",\"name\":\"Kontakt zu ZusammenLeben\",\"description\":\"ZusammenLeben in Konradsreuth, Oberfranken: per WhatsApp, Telefon, E-Mail oder Formular. Antworten auf Ukrainisch, Russisch, Deutsch und Englisch.\",\"inLanguage\":\"de\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"},\"about\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Kontakt zu ZusammenLeben\",\"item\":\"https://zusammenleben-ukraine.de/de/Contact.html\"}]},{\"@type\":\"NGO\",\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"name\":\"ZusammenLeben\",\"alternateName\":\"Zusammen Leben\",\"url\":\"https://zusammenleben-ukraine.de/\",\"logo\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\",\"email\":\"zusammenleben.de@gmail.com\",\"telephone\":\"+380637004615\",\"description\":\"Kostenlose ehrenamtliche Hilfe für ukrainische Familien in Nordbayern: Wohnung, Jobcenter, Anmeldung, Schulplatz und Übersetzung in Hof, Selb und Helmbrechts.\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Alte Hofer Str. 1\",\"postalCode\":\"95176\",\"addressLocality\":\"Konradsreuth\",\"addressRegion\":\"Bayern\",\"addressCountry\":\"DE\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Hof\"},{\"@type\":\"Place\",\"name\":\"Helmbrechts\"},{\"@type\":\"Place\",\"name\":\"Münchberg\"},{\"@type\":\"Place\",\"name\":\"Selb\"},{\"@type\":\"Place\",\"name\":\"Wunsiedel\"},{\"@type\":\"Place\",\"name\":\"Arzberg\"},{\"@type\":\"Place\",\"name\":\"Marktredwitz\"},{\"@type\":\"Place\",\"name\":\"Naila\"},{\"@type\":\"Place\",\"name\":\"Kulmbach\"},{\"@type\":\"Place\",\"name\":\"Bad Steben\"},{\"@type\":\"Place\",\"name\":\"Oberfranken\"}],\"knowsLanguage\":[\"uk\",\"ru\",\"de\",\"en\"],\"founder\":{\"@type\":\"Person\",\"name\":\"Ben Shamir\"},\"member\":{\"@type\":\"Person\",\"name\":\"Anna Cheishvili\",\"jobTitle\":\"Operations Manager\"},\"foundingDate\":\"2022\"}]}</script>"
      },
