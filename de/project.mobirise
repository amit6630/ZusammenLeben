          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" global once=\"menu\">\n    <mbr-parameters>\n        <header>Größe</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Volle Breite\" checked>\n        <header>Anzeigen/Ausblenden</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo-Größe\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Markenname\" name=\"showBrand\" checked>\n        <input type=\"checkbox\" title=\"Kontakt-Telefon\" name=\"showPhone\" checked>\n        <input type=\"checkbox\" title=\"Kontakt-Adresse\" name=\"showAddress\" checked>\n        <input type=\"color\" title=\"Farbe der Kontaktsymbole\" name=\"iconsContactColor\" value=\"#0c2c68\" condition=\"showPhone || showAddress\">\n        <input type=\"checkbox\" title=\"Menüpunkte\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Symbole\" name=\"showIcons\">\n        <select title=\"Anzahl\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Symbolfarbe\" name=\"iconsColor\" value=\"#222222\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Schaltfläche\" name=\"showButtons\" checked>\n        <header>Stile</header>\n        <input type=\"checkbox\" title=\"Fixiert\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Eingeklappt\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Deckkraft\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Farbe\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Hamburger-Menü\" name=\"hamburgerColor\" value=\"#222222\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                 'navbar-expand-lg':!collapsed,\n                 'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"brand-container\">\n                <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"ZusammenLeben\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                    <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-caption-wrap\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"index.html\" data-app-placeholder=\"Type Text\">Zusammen Leben</a></span>\n                </div>\n                \n                <!-- פרטי קשר + דגלים (מוצגים אך ורק במחשב) -->\n                <div class=\"contacts-menu desktop-only-flex\">\n                    <div class=\"card-wrap\">\n                        <span class=\"mobi-mbri-phone mobi-mbri\" style=\"font-size: 18px;\"></span>\n                        <div class=\"card-box\">\n                            <p class=\"mbr-text mbr-fonts-style mb-0 display-4\"><a href=\"tel:+380 63 700 4615\" class=\"text-primary\">+380 63 700 4615</a></p>\n                        </div>\n                    </div>\n                    \n                    <span class=\"menu-divider\">|</span>\n\n                    <div class=\"card-wrap\">\n                        <span class=\"mdi-maps-place\" style=\"font-size: 22px;\"></span>\n                        <div class=\"card-box\">\n                            <p class=\"mbr-text mbr-fonts-style mb-0 display-4\">Konradsreuth Alte Hofer Str. 1</p>\n                        </div>\n                    </div>\n\n                    <span class=\"menu-divider\">|</span>\n\n<div class=\"flags-menu\">\n    <a href=\"index.html\" title=\"Deutsch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/de.png\" srcset=\"https://flagcdn.com/48x36/de.png 2x\" alt=\"Deutschland\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">DE</span>\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"../index.html\" title=\"Englisch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/us.png\" srcset=\"https://flagcdn.com/48x36/us.png 2x\" alt=\"Vereinigte Staaten\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">EN</span>\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"../ua/index.html\" title=\"Ukrainisch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/ua.png\" srcset=\"https://flagcdn.com/48x36/ua.png 2x\" alt=\"Ukraine\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">UA</span>\n    </a>\n</div>\n                </div>\n\n                <!-- דגלים בלבד שיופיעו אך ורק בטלפון ליד ההמבורגר -->\n<div class=\"flags-menu mobile-only\">\n    <a href=\"index.html\" title=\"Deutsch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/de.png\" alt=\"DE\" width=\"18\" height=\"13\">\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"../index.html\" title=\"Englisch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/us.png\" alt=\"EN\" width=\"18\" height=\"13\">\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"../ua/index.html\" title=\"Ukrainisch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/ua.png\" alt=\"UA\" width=\"18\" height=\"13\">\n    </a>\n</div>\n                <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Navigation umschalten\" mbr-if=\"showItems || showIcons || showButtons\">\n                    <div class=\"hamburger\">\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                </button>\n            </div>\n            \n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-scroll-collapse>\n                <ul class=\"navbar-nav nav-dropdown\" data-app-modern-menu=\"true\" mbr-menu><li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"index.html\" data-app-placeholder=\"Type Text\">Startseite</a>\n                    </li>\n    \n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Über uns</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"social-activity.html\" data-app-placeholder=\"Type Text\">Unsere Aktivitäten</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"anna-shishoili.html\" data-app-placeholder=\"Type Text\">Anna Cheishvili</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"services.html\" data-app-placeholder=\"Type Text\">Dienstleistungen</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"request-assistance.html\" data-app-placeholder=\"Type Text\">Hilfe anfordern</a>\n                    </li>\n    \n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Leben in Deutschland</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"glossary.html\" data-app-placeholder=\"Type Text\">Glossar</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"learning-german.html\" data-app-placeholder=\"Type Text\">Deutsch lernen</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"refugee-rights.html\" data-app-placeholder=\"Type Text\">Rechte ukrainischer Flüchtlinge</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"guides.html\">Ratgeber & Artikel</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"areasweserve.html\" data-app-placeholder=\"Type Text\">Unsere Regionen</a>\n                    </li>\n\n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Gemeinschaft</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"community.html\" data-app-placeholder=\"Type Text\">Unsere Gemeinschaft</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"family-stories.html\" data-app-placeholder=\"Type Text\">Familiengeschichten</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"faq.html#list01-b\" data-app-placeholder=\"Type Text\">FAQ</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"how-to-help.html\" data-app-placeholder=\"Type Text\">Wie Sie helfen können</a>\n                    </li>\n    \n                    <!-- Emergency - Highlighted in a separate prominent color -->\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link font-weight-bold display-4 text-primary\" href=\"emergency.html\" style=\"color: #c81e1e !important;\" data-app-placeholder=\"Type Text\">Notfall</a>\n                    </li></ul>\n                \n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary display-4\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">Kontaktieren Sie uns</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
