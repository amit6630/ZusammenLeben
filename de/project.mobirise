    "guide-finding-apartment.html": {
      "settings": {
        "title": "Wohnungssuche in Oberfranken mit dem Jobcenter",
        "order": "17",
        "meta_descr": "Schritt für Schritt: So finden ukrainische Familien in Oberfranken eine Wohnung, bekommen die Miete vom Jobcenter genehmigt und vermeiden typische Fehler.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-finding-apartment.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-finding-apartment.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-finding-apartment.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-finding-apartment.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-finding-apartment.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Wohnungssuche in Oberfranken mit dem Jobcenter\" />\n<meta property=\"og:description\" content=\"Schritt für Schritt: So finden ukrainische Familien in Oberfranken eine Wohnung, bekommen die Miete vom Jobcenter genehmigt und vermeiden typische Fehler.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-finding-apartment.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Wohnungssuche in Oberfranken mit Unterstützung des Jobcenters\",\"description\":\"Schritt für Schritt: So finden ukrainische Familien in Oberfranken eine Wohnung, bekommen die Miete vom Jobcenter genehmigt und vermeiden typische Fehler.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-finding-apartment.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-finding-apartment.html\",\"wordCount\":922,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Darf ich den Mietvertrag vor der Zusicherung des Jobcenters unterschreiben?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sie dürfen, tragen aber das Risiko. Hält das Jobcenter die Miete später für zu hoch, zahlt es eventuell nur den angemessenen Teil. Holen Sie immer zuerst die schriftliche Zusicherung ein.\"}},{\"@type\":\"Question\",\"name\":\"Wer zahlt die Kaution?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Meist gewährt das Jobcenter die Kaution als Darlehen, das in kleinen Raten von den Leistungen zurückgezahlt wird.\"}},{\"@type\":\"Question\",\"name\":\"Wie schnell muss ich mich anmelden?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Innerhalb von zwei Wochen nach dem Einzug im Bürgerbüro Ihres Ortes, mit der Wohnungsgeberbestätigung.\"}},{\"@type\":\"Question\",\"name\":\"Darf ich in einen anderen Landkreis ziehen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nur wenn Ihr Aufenthaltstitel keine Wohnsitzauflage hat oder die Ausländerbehörde der Änderung zustimmt. Fragen Sie, bevor Sie in einem anderen Landkreis suchen.\"}},{\"@type\":\"Question\",\"name\":\"Was, wenn die Wohnung keine Küche hat?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Das ist in Deutschland üblich. Fragen Sie vor dem Kauf beim Jobcenter nach der Erstausstattung oder bei uns nach gespendeten Küchensachen.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Wohnungssuche in Oberfranken mit Unterstützung des Jobcenters\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-finding-apartment.html\"}]}]}</script>"
      },
