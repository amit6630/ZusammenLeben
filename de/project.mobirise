    },
    "guide-vocational-training.html": {
      "settings": {
        "title": "Berufsausbildung in Deutschland einfach erklärt",
        "order": "35",
        "meta_descr": "Wie die duale Ausbildung funktioniert, welche Berufe es gibt, Vergütung, Bewerbung und Unterstützung für Menschen aus der Ukraine.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-vocational-training.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-vocational-training.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-vocational-training.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-vocational-training.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-vocational-training.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Berufsausbildung in Deutschland einfach erklärt\" />\n<meta property=\"og:description\" content=\"Wie die duale Ausbildung funktioniert, welche Berufe es gibt, Vergütung, Bewerbung und Unterstützung für Menschen aus der Ukraine.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-vocational-training.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Die Berufsausbildung einfach erklärt\",\"description\":\"Wie die duale Ausbildung funktioniert, welche Berufe es gibt, Vergütung, Bewerbung und Unterstützung für Menschen aus der Ukraine.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-vocational-training.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-vocational-training.html\",\"wordCount\":989,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Wird die Ausbildung bezahlt?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Auszubildende erhalten eine monatliche Vergütung, die jedes Jahr steigt, und sind voll sozialversichert.\"}},{\"@type\":\"Question\",\"name\":\"Gibt es eine Altersgrenze?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nein. Erwachsene können in jedem Alter eine Ausbildung beginnen.\"}},{\"@type\":\"Question\",\"name\":\"Wie gut muss mein Deutsch sein?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Die meisten Betriebe erwarten mindestens B1, besser B2. Sprachförderung während der Ausbildung ist möglich.\"}},{\"@type\":\"Question\",\"name\":\"Wann beginnt die Ausbildung?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Meist am 1. August oder 1. September. Bewerben Sie sich bis zu einem Jahr im Voraus; das Handwerk hat im Sommer oft noch Plätze.\"}},{\"@type\":\"Question\",\"name\":\"Was ist eine Einstiegsqualifizierung?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ein bezahltes Langzeitpraktikum von sechs bis zwölf Monaten, das auf die Ausbildung vorbereitet und oft zu einem Ausbildungsplatz führt.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Die Berufsausbildung einfach erklärt\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-vocational-training.html\"}]}]}</script>"
      },
