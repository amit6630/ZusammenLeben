              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
