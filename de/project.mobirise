                },
                "min-width": "0"
              },
              ".desktop-only-flex": {
                "display": "flex !important",
                "justify-content": "flex-end",
                "align-items": "center",
                "gap": "3px",
                "flex-wrap": "nowrap",
                "margin-left": "auto",
                "padding-right": "20px"
              },
