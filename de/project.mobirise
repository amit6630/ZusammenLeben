    "guide-mental-health.html": {
      "settings": {
        "title": "Psychische Gesundheit: Hilfe für Ukrainer in Deutschland",
        "order": "33",
        "meta_descr": "Stress, Schlafprobleme, Trauer und Trauma nach dem Krieg: psychologische Hilfe, Krisentelefone, Psychotherapie und Hilfe für Kinder in Oberfranken.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-mental-health.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-mental-health.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-mental-health.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-mental-health.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-mental-health.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Psychische Gesundheit: Hilfe für Ukrainer in Deutschland\" />\n<meta property=\"og:description\" content=\"Stress, Schlafprobleme, Trauer und Trauma nach dem Krieg: psychologische Hilfe, Krisentelefone, Psychotherapie und Hilfe für Kinder in Oberfranken.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-mental-health.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Psychische Gesundheit: Wo Sie Unterstützung finden\",\"description\":\"Stress, Schlafprobleme, Trauer und Trauma nach dem Krieg: psychologische Hilfe, Krisentelefone, Psychotherapie und Hilfe für Kinder in Oberfranken.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-mental-health.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-mental-health.html\",\"wordCount\":1009,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Ist Psychotherapie kostenlos?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Psychotherapie bei approbierten Therapeuten wird von der gesetzlichen Krankenkasse bezahlt.\"}},{\"@type\":\"Question\",\"name\":\"Brauche ich eine Überweisung?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nein. Eine psychotherapeutische Sprechstunde können Sie direkt oder über die 116 117 buchen.\"}},{\"@type\":\"Question\",\"name\":\"Wen kann ich nachts anrufen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Die Krisendienste Bayern unter 0800 655 3000 oder die TelefonSeelsorge unter 0800 111 0 111. Bei Gefahr die 112.\"}},{\"@type\":\"Question\",\"name\":\"Wirkt sich eine Therapie auf meinen Aufenthalt aus?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nein. Psychologische Hilfe hat keine Auswirkung auf den Aufenthaltsstatus und ist vertraulich.\"}},{\"@type\":\"Question\",\"name\":\"Gibt es Hilfe für Kinder?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Schulsozialarbeit, Erziehungsberatungsstellen und Kinder- und Jugendlichenpsychotherapeuten.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Psychische Gesundheit: Wo Sie Unterstützung finden\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-mental-health.html\"}]}]}</script>"
      },
