              "line-height": "1.65 !important"
            },
            ".zl-body ul, .zl-body ol": {
              "padding-left": "1.3em",
              "margin": "0 0 16px"
            },
            ".zl-body li": {
              "margin-bottom": "8px"
            },
            ".zl-body a": {
              "color": "#1d4ed8",
              "text-decoration": "underline",
              "text-underline-offset": "2px",
              "font-weight": "600"
            },
            ".zl-body a[target=\"_blank\"]::after": {
              "content": "\" \\2197\"",
              "font-weight": "400"
            },
            ".zl-note": {
              "margin": "20px 0",
              "padding": "16px 18px",
