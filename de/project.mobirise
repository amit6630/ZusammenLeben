              "font-weight": "750",
              "color": "#0f172a",
              "margin": "28px 0 12px"
            },
            ".zl-count": {
              "display": "inline-grid",
              "place-items": "center",
              "min-width": "28px",
              "height": "28px",
              "padding": "0 8px",
              "border-radius": "999px",
              "background": "#e0e7ff",
              "color": "#0c2c68",
              "font-size": "14px",
              "font-weight": "700"
            },
            ".zl-rail": {
              "display": "flex",
              "gap": "16px",
              "overflow-x": "auto",
              "scroll-snap-type": "x mandatory",
              "overscroll-behavior-x": "contain",
              "padding": "4px 2px 16px",
