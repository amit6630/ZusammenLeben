              "padding": "20px 24px",
              "display": "flex",
              "gap": "16px",
              "align-items": "flex-start",
              "margin-bottom": "45px",
              "box-shadow": "0 4px 12px rgba(217, 119, 6, 0.05)"
            },
            ".disclaimer-icon": {
              "color": "#d97706",
              "flex-shrink": "0",
              "background": "#fef3c7",
              "width": "38px",
              "height": "38px",
              "border-radius": "10px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "border": "1px solid #fde68a"
            },
            ".disclaimer-text": {
              "font-size": "0.95rem",
              "color": "#92400e",
              "line-height": "1.6"
            },
            ".guide-block": {
              "margin-bottom": "45px"
            },
            ".block-title": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "24px",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "border-bottom": "2px solid #e2e8f0",
              "padding-bottom": "12px"
            },
