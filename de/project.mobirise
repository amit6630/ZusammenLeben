    "guide-health-insurance-doctor.html": {
      "settings": {
        "title": "Krankenversicherung und Arztbesuch: Ratgeber für Ukrainer",
        "order": "20",
        "meta_descr": "Wie die Krankenversicherung für Menschen aus der Ukraine funktioniert, wie Sie einen Hausarzt finden und welche Nummern nachts und im Notfall gelten.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-health-insurance-doctor.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-health-insurance-doctor.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-health-insurance-doctor.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-health-insurance-doctor.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-health-insurance-doctor.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Krankenversicherung und Arztbesuch: Ratgeber für Ukrainer\" />\n<meta property=\"og:description\" content=\"Wie die Krankenversicherung für Menschen aus der Ukraine funktioniert, wie Sie einen Hausarzt finden und welche Nummern nachts und im Notfall gelten.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-health-insurance-doctor.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Krankenversicherung und Arztbesuch in Deutschland\",\"description\":\"Wie die Krankenversicherung für Menschen aus der Ukraine funktioniert, wie Sie einen Hausarzt finden und welche Nummern nachts und im Notfall gelten.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-health-insurance-doctor.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-health-insurance-doctor.html\",\"wordCount\":943,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Wer zahlt meine Krankenversicherung?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Wenn Sie Leistungen vom Jobcenter beziehen, zahlt das Jobcenter die Beiträge. Wenn Sie arbeiten, sind Sie über den Arbeitgeber versichert.\"}},{\"@type\":\"Question\",\"name\":\"Welche Nummer rufe ich, wenn die Praxis geschlossen ist?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Die 116 117 für den ärztlichen Bereitschaftsdienst. Im lebensbedrohlichen Notfall die 112.\"}},{\"@type\":\"Question\",\"name\":\"Brauche ich einen Hausarzt?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Das ist sehr zu empfehlen. Die Hausarztpraxis koordiniert Ihre Behandlung und überweist an Fachärzte.\"}},{\"@type\":\"Question\",\"name\":\"Sind meine Kinder mitversichert?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Kinder sind über das Jobcenter oder über die Familienversicherung ohne Zusatzkosten versichert.\"}},{\"@type\":\"Question\",\"name\":\"Wird Psychotherapie bezahlt?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Nach einem Erstgespräch übernimmt die gesetzliche Krankenversicherung die Psychotherapie.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Krankenversicherung und Arztbesuch in Deutschland\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-health-insurance-doctor.html\"}]}]}</script>"
      },
      "components": [
        {
          "_name": "amenu1",
          "_sourceTheme": "solarm5",
          "_styles": {
            "& when (@sticky)": {
              "position": "sticky !important",
