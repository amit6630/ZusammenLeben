    "guide-pregnancy-birth.html": {
      "settings": {
        "title": "Schwangerschaft und Geburt in Deutschland: Ratgeber",
        "order": "32",
        "meta_descr": "Vorsorge, Hebamme, Mutterschutz, Geburt im Krankenhaus, Geburtsurkunde und Leistungen: was ukrainische Familien zu Schwangerschaft und Geburt wissen müssen.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-pregnancy-birth.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-pregnancy-birth.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-pregnancy-birth.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-pregnancy-birth.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-pregnancy-birth.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Schwangerschaft und Geburt in Deutschland: Ratgeber\" />\n<meta property=\"og:description\" content=\"Vorsorge, Hebamme, Mutterschutz, Geburt im Krankenhaus, Geburtsurkunde und Leistungen: was ukrainische Familien zu Schwangerschaft und Geburt wissen müssen.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-pregnancy-birth.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Schwangerschaft und Geburt in Deutschland\",\"description\":\"Vorsorge, Hebamme, Mutterschutz, Geburt im Krankenhaus, Geburtsurkunde und Leistungen: was ukrainische Familien zu Schwangerschaft und Geburt wissen müssen.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-pregnancy-birth.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-pregnancy-birth.html\",\"wordCount\":945,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Ist die Schwangerschaftsvorsorge kostenlos?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Alle empfohlenen Untersuchungen, die Hebamme, die Geburt und der Klinikaufenthalt werden von der gesetzlichen Krankenkasse bezahlt.\"}},{\"@type\":\"Question\",\"name\":\"Wann sollte ich eine Hebamme suchen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"So früh wie möglich, am besten in den ersten Schwangerschaftsmonaten, denn Hebammen sind sehr gefragt.\"}},{\"@type\":\"Question\",\"name\":\"Wo melde ich die Geburt an?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Beim Standesamt des Geburtsortes, innerhalb einer Woche.\"}},{\"@type\":\"Question\",\"name\":\"Gibt es Hilfe bei der Babyausstattung?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Die Erstausstattung vom Jobcenter und die Bundesstiftung „Mutter und Kind“ über eine Beratungsstelle.\"}},{\"@type\":\"Question\",\"name\":\"Wie lange dauert der Mutterschutz?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sechs Wochen vor dem Geburtstermin und acht Wochen nach der Geburt, bei Früh- oder Mehrlingsgeburten zwölf.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Schwangerschaft und Geburt in Deutschland\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-pregnancy-birth.html\"}]}]}</script>"
      },
