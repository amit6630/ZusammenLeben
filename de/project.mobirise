            },
            ".matrix-footer-note": {
              "font-size": "0.85rem",
              "color": "#64748b",
              "margin": "0"
            },
            ".cta-section": {
              "padding": "100px 0",
              "background": "#f8fafc",
              "border-top": "1px solid #e2e8f0"
            },
            ".cta-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "30px"
            },
            ".cta-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "padding": "45px",
              "border-radius": "28px",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.04)"
            },
            ".cta-families": {
              "background": "linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%)",
              "border-color": "#bae6fd"
            },
            ".cta-supporters": {
              "background": "linear-gradient(135deg, #ffffff 0%, #f8fafc 100%)"
            },
            ".cta-badge": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "1.2px"
            },
            ".cta-card h3": {
              "font-size": "1.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "10px 0 14px"
            },
            ".cta-card p": {
              "color": "#475569",
              "font-size": "1.05rem",
              "margin-bottom": "30px"
            },
            ".cta-card .mbr-section-btn": {
              "justify-content": "flex-start",
              "margin-bottom": "0"
            },
            "@media (max-width: 992px)": {
              ".hero-title": {
                "font-size": "2.8rem"
              },
              ".manifesto-card": {
                "padding": "35px"
              },
              ".services-section, .process-section, .region-section, .transparency-section, .cta-section": {
                "padding": "80px 0"
              }
            },
            "@media (max-width: 768px)": {
              ".mobirise-home-section .portal-container": {
                "padding-left": "16px !important",
                "padding-right": "16px !important"
              },
              ".services-section, .process-section, .region-section, .transparency-section, .cta-section": {
                "padding": "60px 0"
              },
              ".hero-wrapper": {
                "padding": "60px 0 50px"
              },
              ".hero-title": {
                "font-size": "2.2rem"
              },
              ".section-main-title": {
                "font-size": "2rem"
              }
            },
            "@media (max-width: 640px)": {
              ".hero-title": {
                "font-size": "1.9rem"
              },
              ".mobirise-home-section .btn": {
                "width": "100% !important",
                "justify-content": "center !important"
              },
              ".team-profile-card": {
                "flex-direction": "column",
                "align-items": "center",
                "text-align": "center",
                "padding": "30px 20px"
              },
              ".team-avatar": {
                "margin-bottom": "8px",
                "width": "85px",
                "height": "85px"
              },
              ".timeline-step": {
                "flex-direction": "column",
                "align-items": "flex-start",
                "padding": "24px"
              },
              ".step-badge": {
                "margin-bottom": "10px"
              },
              ".notice-callout": {
                "flex-direction": "column",
                "text-align": "center"
              },
              ".matrix-card, .cta-card, .manifesto-card": {
                "padding": "24px"
              }
            },
            "@media (max-width: 400px)": {
              ".metrics-grid, .services-grid, .transparency-grid, .cta-grid": {
                "grid-template-columns": "1fr"
              },
              ".mobirise-home-section .btn": {
                "padding": "14px 20px !important",
                "font-size": "0.95rem !important"
              }
            },
            "P": {
              "text-align": "left"
            },
            "H3": {
              "text-align": "left"
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            },
            "@media (max-width: 575px)": {
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            "@media (max-width: 767px)": {
              ".services-grid, .team-grid, .transparency-grid, .pillars-grid, .three-column-grid, .grid-3, .grid-2, .faq-grid, .survival-grid, .portal-grid-2, .city-directory-grid, .details-cards-stack, .two-column-grid, .levels-grid, .cert-grid, .benefits-grid, .links-grid, .timeline-wrapper": {
                "display": "flex !important",
                "flex-wrap": "nowrap !important",
                "flex-direction": "row !important",
                "grid-template-columns": "none !important",
                "gap": "12px !important",
                "overflow-x": "auto",
                "overscroll-behavior-x": "contain",
                "scroll-snap-type": "x mandatory",
                "padding": "4px 2px 14px !important",
                "scrollbar-width": "none"
              },
              ".services-grid::-webkit-scrollbar, .team-grid::-webkit-scrollbar, .transparency-grid::-webkit-scrollbar, .pillars-grid::-webkit-scrollbar, .three-column-grid::-webkit-scrollbar, .grid-3::-webkit-scrollbar, .grid-2::-webkit-scrollbar, .faq-grid::-webkit-scrollbar, .survival-grid::-webkit-scrollbar, .portal-grid-2::-webkit-scrollbar, .city-directory-grid::-webkit-scrollbar, .details-cards-stack::-webkit-scrollbar, .two-column-grid::-webkit-scrollbar, .levels-grid::-webkit-scrollbar, .cert-grid::-webkit-scrollbar, .benefits-grid::-webkit-scrollbar, .links-grid::-webkit-scrollbar, .timeline-wrapper::-webkit-scrollbar": {
                "display": "none"
              },
              ".services-grid > *, .team-grid > *, .transparency-grid > *, .pillars-grid > *, .three-column-grid > *, .grid-3 > *, .grid-2 > *, .faq-grid > *, .survival-grid > *, .portal-grid-2 > *, .city-directory-grid > *, .details-cards-stack > *, .two-column-grid > *, .levels-grid > *, .cert-grid > *, .benefits-grid > *, .links-grid > *, .timeline-wrapper > *": {
                "flex": "0 0 84% !important",
                "max-width": "84% !important",
                "min-width": "0",
                "margin": "0 !important",
                "scroll-snap-align": "start"
              },
              ".timeline-wrapper::before": {
                "display": "none !important"
              },
              ".metrics-section, .services-section, .process-section, .region-section, .team-section, .transparency-section, .cta-section": {
                "padding-top": "44px !important",
                "padding-bottom": "44px !important"
              },
              ".metrics-grid": {
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr) !important",
                "gap": "10px !important"
              },
              ".word-grid": {
                "max-height": "62vh",
                "overflow-y": "auto",
                "overscroll-behavior": "contain",
                "padding-right": "4px"
              },
              ".metrics-grid > *": {
                "min-width": "0",
                "padding": "18px 10px !important"
              },
              ".metrics-grid .metric-value": {
                "font-size": "2rem !important"
              },
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_name": "article01",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"mobirise-home-section\" id=\"global-home-portal\">\n    <div class=\"portal-wrapper\">\n        \n        <!-- Hero Section -->\n        <div class=\"hero-wrapper\">\n            <div class=\"portal-container\">\n                <div class=\"hero-badge-group\">\n                    <span class=\"pulse-indicator\"></span>\n                    <span class=\"badge-text\">Offizielle Ehrenamtliche Initiative • Oberfranken, Bayern</span>\n                </div>\n                \n                <h1 class=\"hero-title\">\n                    Würdevolle Unterstützung, Wohnraum &amp; Gemeinschaft für ukrainische Familien in Nordbayern\n                </h1>\n                \n                <p class=\"hero-subtitle\">\n                    Umfassende, 100% kostenlose Begleitung durch die deutsche Behördenwelt, Wohnungssuche, Übersetzung und Schulplatzvermittlung.\n                </p>\n\n                <!-- Mobirise Interactive CTA Buttons -->\n                <div class=\"mbr-section-btn hero-cta-bar\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\">\n                    <a class=\"btn btn-success display-4\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\" style=\"background-color: #0f7a3e !important; border-color: #0f7a3e !important;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 6px;\"><path d=\"M12.031 2c-5.514 0-9.996 4.482-9.996 9.996 0 1.763.459 3.486 1.332 5.013l-1.417 5.176 5.297-1.389c1.474.804 3.141 1.226 4.784 1.226 5.514 0 9.996-4.482 9.996-9.996 0-5.514-4.482-9.996-9.996-9.996zm0 18.286c-1.479 0-2.929-.396-4.195-1.147l-.301-.179-3.12.818.832-3.041-.197-.313c-.822-1.309-1.256-2.825-1.256-4.372 0-4.413 3.587-8 8-8s8 3.587 8 8-3.587 8.034-8 8.034z\"></path></svg> Schreiben Sie uns auf WhatsApp\n                    </a>\n                    <a class=\"btn btn-primary\" href=\"Contact.html#footer4-19\" data-app-placeholder=\"Type Text\">\n                        <span class=\"btn-icon\" style=\"display: inline-flex; align-items: center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 6px;\"><path d=\"M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z\"></path></svg></span> Kontakt per E-Mail\n                    </a>\n                </div>\n\n                <!-- White Manifesto Box -->\n                <div class=\"manifesto-card\">\n                    <div class=\"manifesto-header\">\n                        <span class=\"manifesto-tag\">UNSERE MISSION &amp; UMFANG</span>\n                        <h2>Ein persönlicher Ansprechpartner vor Ort in Oberfranken</h2>\n                    </div>\n                    <div class=\"manifesto-body\">\n                        <p> \n                            Seit Ausbruch des Krieges in der Ukraine begleiten wir kontinuierlich Familien und Einzelpersonen beim Einleben in Nordbayern. Wir sind keine fernab sitzende Behörde, kein eingetragenes Unternehmen und keine automatisierte Hotline. Wir sind ein engagiertes lokales Team, fest in Oberfranken verwurzelt — und nutzen unser direktes Netzwerk zu Behörden, Schulen, Vermietern und Hausverwaltungen, um Familien echte Stabilität zu bieten.\n                        </p>\n                        <p>\n                            Das Navigieren durch deutsche Gemeindeverfahren erfordert mehr als nur gute Absichten — es erfordert das Verständnis einer komplexen Sprache aus Fristen, Jobcenter-Terminen und behördlicher Post. Genau diese Lücke schließen wir mit klarer, kontinuierlicher menschlicher Unterstützung.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Live Impact Metrics -->\n        <div class=\"metrics-section\">\n            <div class=\"portal-container\">\n                <div class=\"metrics-grid\">\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value blue-val\">200+</div>\n                        <div class=\"metric-label\">Unterstützte Familien</div>\n                        <div class=\"metric-sub\">Persönliche Begleitung geboten</div>\n                    </div>\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value emerald-val\">70+</div>\n                        <div class=\"metric-label\">Wohneinheiten</div>\n                        <div class=\"metric-sub\">Integriert &amp; vermittelt</div>\n                    </div>\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value purple-val\">100%</div>\n                        <div class=\"metric-label\">Ehrenamtlich &amp; Kostenlos</div>\n                        <div class=\"metric-sub\">Keine Gebühren oder versteckte Kosten</div>\n                    </div>\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value amber-val\">2022+</div>\n                        <div class=\"metric-label\">Kontinuierliche Präsenz</div>\n                        <div class=\"metric-sub\">Aktive Hilfe seit Kriegsausbruch</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Comprehensive Support Grid -->\n        <div class=\"services-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">HILFE-ÖKOSYSTEM</span>\n                    <h2 class=\"section-main-title\">Wie wir Sie auf Ihrem Weg unterstützen</h2>\n                    <p class=\"section-description\">Ein vollständiges Netz menschlicher Unterstützung, zugeschnitten auf die lokalen bayerischen Strukturen.</p>\n                </div>\n\n                <div class=\"services-grid\">\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-blue\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\"></path></svg>\n                        </div>\n                        <h3>Wohnungssuche &amp; Unterkunft</h3>\n                        <p>Vermittlung passender regionaler Wohnmöglichkeiten, einschließlich Wohnungen direkt aus unserem lokalen Partnernetzwerk.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-emerald\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\"></path></svg>\n                        </div>\n                        <h3>Wohnsitzanmeldung</h3>\n                        <p>Schritt-für-Schritt-Vorbereitung auf die behördliche Anmeldung — das verpflichtende Fundament für alle rechtlichen Schritte in Deutschland.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-purple\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z\"></path></svg>\n                        </div>\n                        <h3>Jobcenter-Prozesse</h3>\n                        <p>Entschlüsselung offizieller Post, Vorbereitung auf Pflichttermine und Begleitung durch die Schritte zur Mietkostenübernahme.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-amber\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z\"></path></svg>\n                        </div>\n                        <h3>Schulen &amp; Kita</h3>\n                        <p>Finden regionaler Bildungseinrichtungen, Einreichen erforderlicher Dokumente und direkte Abstimmung mit den Schulleitungen.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-rose\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12.87 15.07l-2.54-2.51.03-.03c1.74-1.94 2.98-4.17 3.71-6.53H17V4h-7V2H8v2H1v2h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2.1l1.1-3h4.6l1.1 3H23l-4.5-12zm-2.62 7l1.62-4.41L19.12 17h-3.24z\"></path></svg>\n                        </div>\n                        <h3>Sprache &amp; Übersetzung</h3>\n                        <p>Vermittlung von Sprachmittlern für Ukrainisch, Russisch und Deutsch bei wichtigen behördlichen Terminen.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-indigo\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 10V7c0-1.1-.9-2-2-2H6c-1.1 0-2 .9-2 2v3c-1.1 0-2 .9-2 2v5h1.33L4 19h2l.67-2h10.66l.67 2h2l.67-2H22v-5c0-1.1-.9-2-2-2zm-9 0H6V7h5v3zm7 0h-5V7h5v3z\"></path></svg>\n                        </div>\n                        <h3>Möbel &amp; Erstausstattung</h3>\n                        <p>Koordination von Grundmöbeln, Küchenutensilien und Haushaltsgegenständen auf Basis lokaler Spenden und Bestände.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-teal\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"></path></svg>\n                        </div>\n                        <h3>Persönlicher Ansprechpartner</h3>\n                        <p>Ein fester Betreuer, der Ihre Vorgeschichte, Familiensituation und Ihren aktuellen Status persönlich kennt.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-sky\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\"></path></svg>\n                        </div>\n                        <h3>Soziale Integration</h3>\n                        <p>Direkte Vernetzung mit etablierten ukrainischen Familien in Ihrer Stadt, die diesen Prozess bereits durchlaufen haben.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Process Workflow Timeline -->\n        <div class=\"process-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">SCHRITT-FÜR-SCHRITT</span>\n                    <h2 class=\"section-main-title\">So funktioniert der Ablauf</h2>\n                </div>\n\n                <div class=\"timeline-wrapper\">\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">01</div>\n                        <div class=\"step-content\">\n                            <h3>Direkter Kontakt</h3>\n                            <p>Senden Sie eine Nachricht per WhatsApp oder E-Mail auf Ukrainisch, Russisch, Deutsch oder Englisch. Keine Online-Registrierung oder Formulare erforderlich.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">02</div>\n                        <div class=\"step-content\">\n                            <h3>Erstgespräch</h3>\n                            <p>Wir besprechen Ihre Familiensituation, den aktuellen Aufenthaltsort, dringende Sicherheitsbedürfnisse und die nächsten behördlichen Schritte.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">03</div>\n                        <div class=\"step-content\">\n                            <h3>Machbarkeitsprüfung</h3>\n                            <p>Wir prüfen die lokalen Kapazitäten, die Verfügbarkeit der Behörden vor Ort und den Wohnungsbestand, um Ihnen eine realistische Rückmeldung zu geben.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">04</div>\n                        <div class=\"step-content\">\n                            <h3>Individueller Hilfsplan</h3>\n                            <p>Wenn wir helfen können, leiten wir sofortige Schritte ein. Sollten unsere Kapazitäten erschöpft sein, informieren wir Sie direkt und nennen Alternativen.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">05</div>\n                        <div class=\"step-content\">\n                            <h3>Langfristige Begleitung</h3>\n                            <p>Unsere Unterstützung endet nicht mit dem Mietvertrag — wir begleiten Sie auch bei den ersten Versorgungsverträgen und beim Einleben vor Ort.</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Callout Warning Box -->\n                <div class=\"notice-callout\">\n                    <div class=\"notice-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z\"></path></svg>\n                    </div>\n                    <div class=\"notice-text\">\n                        <strong>Wichtiger Transparenzhinweis:</strong> Die Kontaktaufnahme mit unserem Team garantiert keine Wohnungsvermittlung, Jobcenter-Bewilligung oder Schulplätze. Wir prüfen jeden Fall individuell und kommunizieren ehrlich. Schnelle, ehrliche Rückmeldungen stehen bei uns über unerfüllbaren Versprechen.\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Geographic Focus Section -->\n        <div class=\"region-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">REGIONALER FOKUS</span>\n                    <h2 class=\"section-main-title\">Aktive Einsatzorte</h2>\n                    <p class=\"section-description\">Tiefgreifende lokale Expertise in Oberfranken und Nordbayern.</p>\n                </div>\n\n                <div class=\"pills-cloud\">\n                    <span class=\"city-pill highlighted\">Helmbrechts</span>\n                    <span class=\"city-pill highlighted\">Münchberg</span>\n                    <span class=\"city-pill highlighted\">Hof</span>\n                    <span class=\"city-pill\">Selb</span>\n                    <span class=\"city-pill\">Wunsiedel</span>\n                    <span class=\"city-pill\">Arzberg</span>\n                    <span class=\"city-pill\">Marktredwitz</span>\n                    <span class=\"city-pill\">Naila</span>\n                    <span class=\"city-pill\">Kulmbach</span>\n                    <span class=\"city-pill\">Bad Steben</span>\n                    <span class=\"city-pill info-tag\">+ Umliegende Städte in Nordbayern</span>\n                </div>\n\n                <div class=\"region-focus-card\">\n                    <h3>Warum ein regionaler Fokus bessere Ergebnisse bringt</h3>\n                    <p>\n                        Durch die ausschließliche Konzentration auf diese Region pflegen wir direkte Kontakte zu lokalen Sachbearbeitern, wissen, welche Schulen Plätze für ukrainischsprachige Kinder haben, und kennen die Vermieter, die Jobcenter-Bewilligungen akzeptieren.\n                    </p>\n                    <p>\n                        <em>Bitte beachten Sie: Außerhalb unseres Haupt-Einsatzgebietes können wir keine vollständige Unterstützung oder Wohnungsvermittlung anbieten.</em>\n                    </p>\n                </div>\n            </div>\n        </div>\n\n<div class=\"team-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">LEITUNG DER INITIATIVE</span>\n                    <h2 class=\"section-main-title\">Wer hinter dem Hilfsnetzwerk steht</h2>\n                </div>\n\n                <div class=\"team-grid\">\n                    <div class=\"team-profile-card\">\n                        <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2026-07-26-at-6.16.22-pm.jpeg-120x120.jpg\" width=\"120\" height=\"120\" alt=\"Ben Shamir\" class=\"team-avatar\">\n                        <div class=\"team-info\">\n                            <h3>Ben Shamir</h3>\n                            <span class=\"role-pill\">Gründer &amp; Koordinator</span>\n                            <p>Immobilienunternehmer mit umfangreicher Erfahrung in Deutschland. Bei Kriegsausbruch stellte Ben seine privaten Ressourcen, Infrastrukturen und regionalen Verbindungen zur Verfügung, um ein strukturiertes Aufnahmenetzwerk für ankommende Familien aufzubauen.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"team-profile-card\">\n                        <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2026-07-26-at-6.17.22-pm.jpeg-120x120.jpg\" width=\"120\" height=\"120\" alt=\"Anna Cheishvili\" class=\"team-avatar\">\n                        <div class=\"team-info\">\n                            <h3>Anna Cheishvili</h3>\n                            <span class=\"role-pill manager\">Operations Managerin</span>\n                            <p>Leitet das Tagesgeschäft vollständig ehrenamtlich. Anna ist die direkte Hauptansprechpartnerin für die Familien und übernimmt die tägliche Kommunikation über WhatsApp in deren Muttersprachen.</p>\n                            <a href=\"anna-shishoili.html\" style=\"color: #2563eb; font-weight: 600; text-decoration: underline; font-size: 0.9rem; margin-top: 10px; display: inline-block;\">Annas ganze Geschichte lesen →</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Transparency Matrix -->\n        <div class=\"transparency-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">FINANZIELLE TRANSPARENZ</span>\n                    <h2 class=\"section-main-title\">100% kostenloses Hilfsmodell</h2>\n                </div>\n\n                <div class=\"transparency-grid\">\n                    <div class=\"matrix-card free-card\">\n                        <div class=\"matrix-header\">\n                            <span class=\"matrix-status\">IMMER 100% KOSTENLOS</span>\n                            <h3>Abgedeckte ehrenamtliche Hilfe</h3>\n                        </div>\n                        <ul class=\"matrix-list\">\n                            <li><span>✓</span> Persönliche Begleitung &amp; Fallbetreuung</li>\n                            <li><span>✓</span> Übersetzung &amp; Prüfung behördlicher Dokumente</li>\n                            <li><span>✓</span> Terminabstimmung mit Kommunalbehörden</li>\n                            <li><span>✓</span> Wohnungssuche &amp; Verhandlung mit Vermietern</li>\n                            <li><span>✓</span> Unterstützung bei Schul- &amp; Kita-Anmeldungen</li>\n                        </ul>\n                    </div>\n\n                    <div class=\"matrix-card external-card\">\n                        <div class=\"matrix-header\">\n                            <span class=\"matrix-status warning\">EXTERNE DRITTKOSTEN</span>\n                            <h3>Kosten, die direkt an Anbieter gezahlt werden</h3>\n                        </div>\n                        <ul class=\"matrix-list warning-list\">\n                            <li><span>•</span> Kommunale oder staatliche Gebühren</li>\n                            <li><span>•</span> Mietkaution &amp; monatliche Miete</li>\n                            <li><span>•</span> Strom-, Heizung-, Gas- &amp; Nebenkostenverträge</li>\n                            <li><span>•</span> Internet- und Telekommunikationsanbieter</li>\n                        </ul>\n                        <p class=\"matrix-footer-note\">* Es fließen keinerlei Zahlungen oder Gelder über unsere Initiative.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Global Dual CTA with Mobirise Buttons -->\n        <div class=\"cta-section\">\n            <div class=\"portal-container\">\n                <div class=\"cta-grid\">\n                    <div class=\"cta-card cta-families\">\n                        <span class=\"cta-badge\">FÜR ANKOMMENDE FAMILIEN</span>\n                        <h3>Benötigen Sie Hilfe in Oberfranken?</h3>\n                        <p>Schreiben Sie Anna direkt auf WhatsApp oder per E-Mail auf Ukrainisch, Russisch, Deutsch oder Englisch.</p>\n                        \n                <div class=\"mbr-section-btn cta-buttons-wrapper\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn custom-btn whatsapp-btn display-4 btn-warning\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                        Anna auf WhatsApp schreiben\n                    </a>\n                            <a class=\"btn btn-primary\" href=\"Contact.html#footer4-19\" data-app-placeholder=\"Type Text\">\n                                E-Mail senden\n                            </a></div>\n                    </div>\n\n                    <div class=\"cta-card cta-supporters\">\n                        <span class=\"cta-badge dark\">FÜR LOKALE UNTERSTÜTZER</span>\n                        <h3>Möchten Sie unsere Arbeit unterstützen?</h3>\n                        <p>Leerstehender Wohnraum, Möbelspenden, Übersetzungs- oder Fahrdienste — Ihre Zeit bewirkt Vieles.</p>\n                        \n                        <div class=\"mbr-section-btn cta-buttons\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn btn-outline-primary\" href=\"how-to-help.html\" data-app-placeholder=\"Type Text\">\n                                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 6px;\"><path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\"></path></svg> Mitmachen &amp; Helfen\n                            </a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n    </div>\n</section>",
