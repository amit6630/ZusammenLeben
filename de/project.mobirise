    "guide-disability.html": {
      "settings": {
        "title": "Behinderung in Deutschland: Ausweis, Rechte, Unterstützung",
        "order": "44",
        "meta_descr": "Schwerbehindertenausweis, GdB, freie Fahrt, Hilfe für Kinder, Arbeit und kostenlose Beratung: ein Ratgeber für ukrainische Familien.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-disability.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-disability.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-disability.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-disability.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-disability.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Behinderung in Deutschland: Ausweis, Rechte, Unterstützung\" />\n<meta property=\"og:description\" content=\"Schwerbehindertenausweis, GdB, freie Fahrt, Hilfe für Kinder, Arbeit und kostenlose Beratung: ein Ratgeber für ukrainische Familien.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-disability.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Mit einer Behinderung in Deutschland leben\",\"description\":\"Schwerbehindertenausweis, GdB, freie Fahrt, Hilfe für Kinder, Arbeit und kostenlose Beratung: ein Ratgeber für ukrainische Familien.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-disability.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-disability.html\",\"wordCount\":904,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Gilt meine ukrainische Behinderungsgruppe in Deutschland?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nicht automatisch. Eine neue deutsche Feststellung ist nötig; Ihre ukrainischen Unterlagen helfen dabei.\"}},{\"@type\":\"Question\",\"name\":\"Wo stelle ich in Bayern den Antrag?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Beim Zentrum Bayern Familie und Soziales (ZBFS), Regionalstelle Oberfranken.\"}},{\"@type\":\"Question\",\"name\":\"Ab welchem GdB bekomme ich den Ausweis?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ab einem Grad der Behinderung von 50 gelten Sie als schwerbehindert und erhalten den Ausweis.\"}},{\"@type\":\"Question\",\"name\":\"Kann ich kostenlos Bus fahren?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Mit bestimmten Merkzeichen wie G und einer Wertmarke ist der Nahverkehr kostenlos oder günstiger.\"}},{\"@type\":\"Question\",\"name\":\"Wo bekomme ich kostenlose Beratung?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Bei der Ergänzenden unabhängigen Teilhabeberatung (EUTB), kostenlos und unabhängig von Behörden.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Mit einer Behinderung in Deutschland leben\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-disability.html\"}]}]}</script>"
      },
