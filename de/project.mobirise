              },
              ".survival-card": {
                "padding": "1.15rem"
              }
            }
          },
          "_name": "features05",
          "_sourceTheme": "tradem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"dictionary-section\" id=\"essential-german-dictionary\">\n    <div class=\"dict-container\">\n        \n        <!-- Header -->\n        <header class=\"dict-header\">\n            <span class=\"header-tag\">Offizielles Glossar</span>\n            <h1 class=\"header-title\">Wesentliches deutsches Wörterbuch für Neuzugänge</h1>\n            <p class=\"header-lead\">\n                Die wichtigsten Begriffe, denen Sie in Deutschland in den Bereichen Bürokratie, Wohnen, Finanzen und im täglichen Leben begegnen werden.\n            </p>\n        </header>\n\n        <!-- Quick Survival Guide (Notes and Emergency) -->\n        <div class=\"survival-grid\">\n            \n            <!-- Golden Rules -->\n            <div class=\"survival-card\">\n                <h3 class=\"card-header-title danger\">\n                    <span class=\"dict-svg-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg>\n                    </span>\n                    Die goldene Regel\n                </h3>\n                <p style=\"font-size: 0.925rem; color: #334155; margin-top: 0.25rem; line-height: 1.5;\">\n                    Jedes offizielle Schreiben, das das Wort <strong>Frist</strong> enthält, erfordert eine zwingende Reaktion vor dem angegebenen Datum. Es zu ignorieren wird rechtlich als negative Antwort oder Ablehnung gewertet.\n                </p>\n                <hr style=\"border: 0; border-top: 1px solid #e2e8f0; margin: 1rem 0;\">\n                <h4 class=\"small-title\">Die 5 wichtigsten Wörter</h4>\n                <ul class=\"critical-words-list\">\n                    <li><strong>Termin</strong> - Appointment</li>\n                    <li><strong>Frist</strong> - Deadline</li>\n                    <li><strong>Bescheid</strong> - Official Decision</li>\n                    <li><strong>Antrag</strong> - Application</li>\n                    <li><strong>Nachweis</strong> - Proof / Evidence</li>\n                </ul>\n            </div>\n\n            <!-- Emergency Phrases -->\n            <div class=\"survival-card\">\n                <h3 class=\"card-header-title primary\">\n                    <span class=\"dict-svg-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path><line x1=\"12\" y1=\"2\" x2=\"12\" y2=\"6\"></line><line x1=\"12\" y1=\"10\" x2=\"12.01\" y2=\"10\"></line></svg>\n                    </span>\n                    Notfall-Phrasen\n                </h3>\n                <p style=\"font-size: 0.85rem; color: #64748b; margin-top: -0.5rem; margin-bottom: 0.75rem;\">Speichern Sie diese auf Ihrem Handy oder halten Sie sie griffbereit.</p>\n                <div class=\"phrase-list\">\n                    <div class=\"phrase-item\">\n                        <span class=\"de-text\">Ich spreche kein Deutsch</span>\n                        <span class=\"en-text\">Ich spreche kein Deutsch</span>\n                    </div>\n                    <div class=\"phrase-item\">\n                        <span class=\"de-text\">Sprechen Sie Englisch?</span>\n                        <span class=\"en-text\">Sprechen Sie Englisch?</span>\n                    </div>\n                    <div class=\"phrase-item\">\n                        <span class=\"de-text\">Ich brauche einen Dolmetscher</span>\n                        <span class=\"en-text\">Ich brauche einen Dolmetscher</span>\n                    </div>\n                    <div class=\"phrase-item\">\n                        <span class=\"de-text\">Ich brauche Hilfe</span>\n                        <span class=\"en-text\">Ich brauche Hilfe</span>\n                    </div>\n                    <div class=\"phrase-item\">\n                        <span class=\"de-text\">Ich verstehe nicht</span>\n                        <span class=\"en-text\">Ich verstehe nicht</span>\n                    </div>\n                    <div class=\"phrase-item\">\n                        <span class=\"de-text\">Können Sie das bitte wiederholen?</span>\n                        <span class=\"en-text\">Können Sie das bitte wiederholen?</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Pronunciation and Language Tips -->\n            <div class=\"survival-card\">\n                <h3 class=\"card-header-title success\">\n                    <span class=\"dict-svg-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path><line x1=\"9\" y1=\"10\" x2=\"15\" y2=\"10\"></line></svg>\n                    </span>\n                    Sprachtipps\n                </h3>\n                <ul class=\"tips-list\">\n                    <li><strong>ß</strong> wird wie ein scharfes „s“ ausgesprochen.</li>\n                    <li><strong>ei</strong> wird wie „ai“ ausgesprochen.</li>\n                    <li><strong>ie</strong> wird als langes „i“ ausgesprochen.</li>\n                    <li><strong>eu</strong> wird wie „oi“ ausgesprochen.</li>\n                    <li><strong>v</strong> wird normalerweise als „f“ ausgesprochen.</li>\n                    <li><strong>w</strong> wird als „w“ (wie englisches „v“) ausgesprochen.</li>\n                </ul>\n                <div class=\"alert-tip\">\n                    <strong>Zusammengesetzte Wörter:</strong> Das Deutsche verbindet Wörter zu langen Einzelbegriffen. Wenn ein Wort unmöglich erscheint, versuchen Sie es aufzuteilen: <br><em>Wohnungsgeberbestätigung</em> = Wohnung + Geber + Bestätigung.\n                </div>\n            </div>\n        </div>\n\n        <!-- Category 1 -->\n        <div class=\"category-block\">\n            <h2 class=\"category-title\">\n                <span class=\"cat-icon dict-svg-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"3\" y1=\"22\" x2=\"21\" y2=\"22\"></line><line x1=\"6\" y1=\"18\" x2=\"6\" y2=\"11\"></line><line x1=\"10\" y1=\"18\" x2=\"10\" y2=\"11\"></line><line x1=\"14\" y1=\"18\" x2=\"14\" y2=\"11\"></line><line x1=\"18\" y1=\"18\" x2=\"18\" y2=\"11\"></line><polygon points=\"12 2 20 7 4 7 12 2\"></polygon></svg>\n                </span> \n                1. Behörden, Bürokratie und Dokumente\n            </h2>\n            <div class=\"word-grid\">\n                <div class=\"word-item\"><div class=\"word-de\">Anmeldung</div><div class=\"word-en\">Address registration</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Abmeldung</div><div class=\"word-en\">Address deregistration (when leaving)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Ummeldung</div><div class=\"word-en\">Address update (when moving)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Einwohnermeldeamt</div><div class=\"word-en\">Residents' registration office</div></div>\n                <div class=\"word-item\"><div class=\