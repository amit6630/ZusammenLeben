        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/services.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/services.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/services.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/services.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/services.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Unsere Leistungen: Wohnung, Jobcenter, Schule | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"Was wir für ukrainische Familien in Nordbayern konkret tun: Wohnungssuche, Jobcenter, Anmeldung, Schule, Möbel und Übersetzung, kostenlos.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/services.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"url\":\"https://zusammenleben-ukraine.de/de/services.html\",\"name\":\"Unsere Leistungen: Wohnung, Jobcenter, Schule\",\"description\":\"Was wir für ukrainische Familien in Nordbayern konkret tun: Wohnungssuche, Jobcenter, Anmeldung, Schule, Möbel und Übersetzung, kostenlos.\",\"inLanguage\":\"de\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"},\"about\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Unsere Leistungen: Wohnung, Jobcenter, Schule\",\"item\":\"https://zusammenleben-ukraine.de/de/services.html\"}]}]}</script>",
        "meta_descr": "Was wir für ukrainische Familien in Nordbayern konkret tun: Wohnungssuche, Jobcenter, Anmeldung, Schule, Möbel und Übersetzung, kostenlos."
