        {
          "alias": false,
          "_styles": {
            ".portal-container": {
              "font-family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "direction": "ltr",
              "text-align": "left",
              "background-color": "#f8fafc",
              "color": "#334155",
              "padding": "40px 15px",
              "max-width": "1140px",
              "margin": "0 auto",
              "line-height": "1.6",
              "box-sizing": "border-box"
            },
            ".portal-container h1, .portal-container h2, .portal-container h3, .portal-container h4, .portal-container h5": {
              "color": "#0f172a",
              "font-weight": "700",
              "margin-top": "0",
              "text-align": "left",
              "line-height": "1.3"
            },
            ".portal-container p": {
              "text-align": "left",
              "color": "#334155",
              "margin-bottom": "1rem"
            },
            ".portal-container a": {
              "transition": "all 0.2s ease-in-out"
            },
            ".portal-container ul": {
              "padding-left": "20px",
              "margin-bottom": "1rem"
            },
            ".portal-container li": {
              "margin-bottom": "0.5rem"
            },
            ".portal-header": {
              "margin-bottom": "40px",
              "text-align": "center"
            },
            ".portal-header h1": {
              "font-size": "clamp(2rem, 5vw, 2.75rem)",
              "font-weight": "800",
              "margin": "15px 0 10px 0",
              "letter-spacing": "-0.02em",
              "text-align": "center"
            },
            ".portal-header h2": {
              "font-size": "clamp(1.1rem, 3vw, 1.4rem)",
              "font-weight": "600",
              "color": "#2563eb",
              "margin-bottom": "15px",
              "text-align": "center"
            },
            ".portal-lead": {
              "font-size": "1.1rem",
              "color": "#64748b",
              "max-width": "800px",
              "margin": "0 auto",
              "text-align": "center !important"
            },
            ".badge-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-top": "50px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "border": "1px solid #bfdbfe"
            },
            ".badge-primary": {
              "background": "#dbeafe",
              "color": "#1e40af"
            },
            ".badge-danger": {
              "background": "#fee2e2",
              "color": "#991b1b"
            },
            ".badge-secondary": {
              "background": "#f1f5f9",
              "color": "#475569"
            },
            ".badge-warning": {
              "background": "#fef3c7",
              "color": "#92400e"
            },
            ".portal-nav-bar": {
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "center",
              "gap": "10px",
              "margin-bottom": "40px",
              "padding": "15px",
              "background": "#ffffff",
              "border-radius": "12px",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.03)",
              "border": "1px solid #e2e8f0"
            },
            ".nav-pill": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "8px",
              "padding": "10px 18px",
              "background": "#f8fafc",
              "color": "#334155",
              "text-decoration": "none",
              "font-weight": "600",
              "font-size": "0.95rem",
              "border-radius": "8px",
              "border": "1px solid #e2e8f0",
              "transition": "all 0.3s ease"
            },
            ".nav-pill:hover": {
              "background": "#2563eb",
              "color": "#fff",
              "border-color": "#2563eb",
              "transform": "translateY(-2px)"
            },
            ".pill-danger": {
              "color": "#dc2626",
              "border-color": "#fca5a5",
              "background": "#fef2f2"
            },
            ".pill-danger:hover": {
