              "border": "1px solid #e2e8f0",
              "border-radius": "12px !important",
              "margin-bottom": "12px",
              "overflow": "hidden",
              "box-shadow": "0 4px 6px -1px rgba(0, 0, 0, 0.02)"
            },
            ".custom-accordion .accordion-header": {
              "margin": "0"
            },
            ".custom-accordion .accordion-button": {
              "font-size": "1.05rem",
