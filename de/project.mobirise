              "font-weight": "600",
              "color": "#334155",
              "margin-bottom": "25px"
            },
            ".contact-methods-grid": {
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "center",
              "gap": "15px"
            },
            ".method-box": {
              "background": "#fff",
              "padding": "15px 25px",
              "border-radius": "8px",
              "border": "1px solid #e2e8f0",
