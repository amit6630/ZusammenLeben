        <div class=\"word-item\"><div class=\"word-de\">Dachgeschoss</div><div class=\"word-en\">Attic floor / Top floor</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Erdgeschoss</div><div class=\"word-en\">Ground floor</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Stockwerk</div><div class=\"word-en\">Floor / Level</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Aufzug</div><div class=\"word-en\">Elevator</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Quadratmeter</div><div class=\"word-en\">Square meters</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Vermieter</div><div class=\"word-en\">Landlord</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Mieter</div><div class=\"word-en\">Tenant</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Mietvertrag</div><div class=\"word-en\">Lease agreement / Rental contract</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Miete</div><div class=\"word-en\">Rent</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Kaltmiete</div><div class=\"word-en\">Basic rent (excluding utilities)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Warmmiete</div><div class=\"word-en\">Total rent (including utilities)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Nebenkosten</div><div class=\"word-en\">Utility costs / Additional charges</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Betriebskosten</div><div class=\"word-en\">Building operating costs</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Kaution</div><div class=\"word-en\">Security deposit</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Wohnungsgeberbestätigung</div><div class=\"word-en\">Land