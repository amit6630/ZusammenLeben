        {
          "alias": false,
          "_styles": {
            ".guide-executive-section": {
              "padding": "80px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "'Inter', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.6",
              "direction": "ltr",
              "text-align": "left",
              "-webkit-font-smoothing": "antialiased"
            },
            ".guide-executive-section *": {
              "box-sizing": "border-box"
            },
            ".executive-container": {
              "max-width": "980px",
              "margin": "0 auto",
              "padding": "0 24px"
            },
            ".guide-header": {
              "text-align": "center",
              "max-width": "820px",
              "margin": "0 auto 40px"
            },
            ".header-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "margin-top": "50px",
              "border": "1px solid #bfdbfe"
            },
            ".header-title": {
              "font-size": "2.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.025em",
              "margin": "0 0 16px 0",
              "line-height": "1.25",
              "text-align": "center"
            },
            ".header-lead": {
              "font-size": "1.15rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.6"
            },
            ".disclaimer-banner": {
              "background": "#fffbeb",
              "border": "1px solid #fde68a",
              "border-radius": "14px",
              "padding": "20px 24px",
              "display": "flex",
              "gap": "16px",
              "align-items": "flex-start",
              "margin-bottom": "45px",
              "box-shadow": "0 2px 8px rgba(245, 158, 11, 0.05)"
            },
            ".disclaimer-icon": {
              "color": "#d97706",
              "flex-shrink": "0",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#fef3c7",
              "padding": "10px",
              "border-radius": "10px"
            },
            ".disclaimer-text": {
              "font-size": "0.95rem",
              "color": "#92400e",
              "line-height": "1.6"
            },
            ".guide-block": {
              "margin-bottom": "45px"
            },
            ".section-intro-text": {
              "color": "#475569",
              "margin-bottom": "24px",
              "font-size": "1rem"
            },
            ".block-title": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "20px",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "border-bottom": "2px solid #e2e8f0",
              "padding-bottom": "12px"
            },
            ".title-icon": {
              "color": "#2563eb",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#eff6ff",
              "width": "36px",
              "height": "36px",
              "border-radius": "8px",
              "border": "1px solid #dbeafe",
              "flex-shrink": "0"
            },
            ".guide-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "32px",
              "margin-bottom": "20px",
              "box-shadow": "0 4px 20px rgba(0, 0, 0, 0.03)"
            },
            ".guide-card.alert-card-border": {
              "border": "1px solid #fca5a5"
            },
            ".card-header": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "margin-bottom": "18px",
              "flex-wrap": "wrap",
              "gap": "12px"
            },
            ".card-header h3": {
              "font-size": "1.25rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "0"
            },
            ".status-tag": {
              "font-size": "0.75rem",
              "font-weight": "700",
              "padding": "6px 14px",
              "border-radius": "100px",
              "letter-spacing": "0.5px",
              "text-transform": "uppercase"
            },
            ".status-tag.critical": {
              "background": "#fff7ed",
              "color": "#c2410c",
              "border": "1px solid #ffedd5"
            },
            ".status-tag.info": {
              "background": "#eff6ff",
              "color": "#1d4ed8",
              "border": "1px solid #dbeafe"
            },
            ".card-details-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(280px, 1fr))",
              "gap": "16px",
              "margin": "24px 0"
            },
            ".detail-box": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "padding": "20px",
              "border-radius": "12px"
            },
            ".detail-box.full-width-detail": {
              "margin-top": "20px"
            },
            ".detail-box h4": {
              "font-size": "0.95rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".detail-box p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0"
            },
            ".rule-box": {
              "padding": "24px",
              "border-radius": "14px",
              "margin": "20px 0"
            },
            ".rule-box h3": {
              "font-size": "1.15rem",
              "font-weight": "700",
              "margin": "0 0 10px 0",
              "display": "flex",
              "align-items": "center",
              "gap": "8px"
            },
            ".rule-box p": {
              "font-size": "0.95rem",
              "margin": "0",
              "line-height": "1.6"
            },
            ".rule-box .inline-icon": {
              "display": "inline-flex",
              "align-items": "center"
            },
            ".rule-box.green-rule": {
              "background": "#f0fdf4",
              "border": "1px solid #bbf7d0",
              "border-left": "5px solid #22c55e",
              "color": "#166534"
            },
            ".rule-box.green-rule h3": {
              "color": "#166534"
            },
            ".rule-box.amber-rule": {
              "background": "#fffbeb",
              "border": "1px solid #fde68a",
              "border-left": "5px solid #f59e0b",
              "color": "#92400e"
            },
            ".rule-box.amber-rule h3": {
              "color": "#92400e"
            },
            ".rule-box.red-rule": {
              "background": "#fef2f2",
              "border": "1px solid #fecaca",
              "border-left": "5px solid #ef4444",
              "color": "#991b1b"
            },
            ".rule-box.red-rule h3": {
              "color": "#991b1b"
            },
            ".two-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "20px"
            },
            ".guide-subcard": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "28px",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.02)"
            },
            ".guide-subcard h3": {
              "font-size": "1.2rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 12px 0"
            },
            ".guide-subcard h3.card-title-flex": {
              "display": "flex",
              "align-items": "center",
              "gap": "10px"
            },
            ".guide-subcard p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin-bottom": "12px",
              "line-height": "1.65"
            },
            ".guide-subcard p:last-child": {
              "margin-bottom": "0"
            },
            ".three-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(240px, 1fr))",
              "gap": "16px"
            },
            ".three-column-grid.compact-grid": {
              "margin-top": "16px"
            },
            ".guide-mini-card": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "border-radius": "14px",
              "padding": "24px",
              "transition": "transform 0.2s ease, box-shadow 0.2s ease"
            },
            ".guide-mini-card:hover": {
              "transform": "translateY(-2px)",
              "box-shadow": "0 6px 15px rgba(0, 0, 0, 0.04)"
            },
            ".mini-icon": {
              "color": "#2563eb",
              "margin-bottom": "14px",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#eff6ff",
              "padding": "10px",
              "border-radius": "10px",
              "border": "1px solid #dbeafe"
            },
            ".card-title-with-icon": {
              "display": "flex",
              "align-items": "center",
              "gap": "8px",
              "margin-bottom": "8px",
              "color": "#2563eb"
            },
            ".card-title-with-icon h3": {
              "margin": "0 !important",
              "font-size": "1.05rem !important"
            },
            ".guide-mini-card h3": {
              "font-size": "1.05rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".guide-mini-card p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.5"
            },
            ".subsection-title": {
              "font-size": "1.1rem",
              "font-weight": "700",
              "margin-top": "32px",
              "margin-bottom": "16px",
              "color": "#0f172a"
            },
            ".action-steps-list": {
              "margin": "0",
              "padding-left": "20px",
              "color": "#475569"
            },
            ".action-steps-list li": {
              "margin-bottom": "10px",
              "font-size": "0.95rem",
              "line-height": "1.6"
            },
            ".numbered-list": {
              "padding-left": "0",
              "margin": "0",
              "list-style": "none"
            },
            ".numbered-list li": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "padding": "14px 18px",
              "border-radius": "10px",
              "margin-bottom": "10px",
              "font-size": "0.92rem",
              "color": "#334155"
            },
