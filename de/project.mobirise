              "gap": "12px"
            },
            ".phrase-item": {
              "display": "flex",
              "flex-direction": "column",
              "background": "#fff",
              "padding": "12px 15px",
              "border-radius": "6px",
              "border-left": "3px solid #2563eb",
              "box-shadow": "0 1px 2px rgba(0, 0, 0, 0.05)"
            },
            ".phrase-item strong": {
              "color": "#0f172a",
              "font-size": "1rem"
            },
            ".phrase-item span": {
