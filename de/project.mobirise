    "guide-legal-help.html": {
      "settings": {
        "title": "Rechtshilfe in Deutschland: kostenlose Beratung und Rechte",
        "order": "45",
        "meta_descr": "Beratungshilfe, Prozesskostenhilfe, Fristen, Streit mit Vermieter, Arbeitgeber oder Händler: wo Ukrainer in Deutschland kostenlos Rat bekommen.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-legal-help.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-legal-help.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-legal-help.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-legal-help.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-legal-help.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Rechtshilfe in Deutschland: kostenlose Beratung und Rechte\" />\n<meta property=\"og:description\" content=\"Beratungshilfe, Prozesskostenhilfe, Fristen, Streit mit Vermieter, Arbeitgeber oder Händler: wo Ukrainer in Deutschland kostenlos Rat bekommen.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-legal-help.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Rechtliche Hilfe in Deutschland\",\"description\":\"Beratungshilfe, Prozesskostenhilfe, Fristen, Streit mit Vermieter, Arbeitgeber oder Händler: wo Ukrainer in Deutschland kostenlos Rat bekommen.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-legal-help.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-legal-help.html\",\"wordCount\":875,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Was ist Beratungshilfe?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Hilfe für anwaltliche Beratung außerhalb eines Gerichtsverfahrens bei geringem Einkommen. Antrag beim Amtsgericht, Eigenanteil höchstens 15 Euro.\"}},{\"@type\":\"Question\",\"name\":\"Wie lange kann ich einem Jobcenter-Bescheid widersprechen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Meist einen Monat ab Zugang. Die Frist steht am Ende des Bescheids.\"}},{\"@type\":\"Question\",\"name\":\"Brauche ich am Sozialgericht einen Anwalt?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nein. Das Verfahren ist für Versicherte kostenlos, und Sie können ohne Anwalt klagen.\"}},{\"@type\":\"Question\",\"name\":\"Wo bekomme ich kostenlose Beratung bei Arbeitsproblemen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Faire Integration berät Geflüchtete kostenlos, auch auf Ukrainisch und Russisch; Gewerkschaften helfen Mitgliedern.\"}},{\"@type\":\"Question\",\"name\":\"Kann ich einen Haustürvertrag widerrufen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Meist ja, innerhalb von 14 Tagen, bei Verträgen an der Haustür, am Telefon oder online.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Rechtliche Hilfe in Deutschland\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-legal-help.html\"}]}]}</script>"
      },
      "components": [
        {
          "_name": "amenu1",
