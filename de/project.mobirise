    "guide-first-job.html": {
      "settings": {
        "title": "Den ersten Job in Deutschland finden: Ratgeber für Ukrainer",
        "order": "24",
        "meta_descr": "Wo Ukrainer in Oberfranken Arbeit finden, wie Minijob und Arbeitsvertrag funktionieren, was ans Jobcenter gemeldet wird und wie ein Lebenslauf aussieht.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-first-job.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-first-job.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-first-job.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-first-job.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-first-job.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Den ersten Job in Deutschland finden: Ratgeber für Ukrainer\" />\n<meta property=\"og:description\" content=\"Wo Ukrainer in Oberfranken Arbeit finden, wie Minijob und Arbeitsvertrag funktionieren, was ans Jobcenter gemeldet wird und wie ein Lebenslauf aussieht.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-first-job.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Den ersten Job in Deutschland finden\",\"description\":\"Wo Ukrainer in Oberfranken Arbeit finden, wie Minijob und Arbeitsvertrag funktionieren, was ans Jobcenter gemeldet wird und wie ein Lebenslauf aussieht.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-first-job.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-first-job.html\",\"wordCount\":909,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Darf ich in Deutschland arbeiten?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Mit einer Aufenthaltserlaubnis nach § 24 dürfen Sie ab dem ersten Tag angestellt oder selbstständig arbeiten.\"}},{\"@type\":\"Question\",\"name\":\"Verliere ich meine Leistungen, wenn ich arbeite?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Die Leistungen werden gekürzt, aber ein Teil des Einkommens bleibt anrechnungsfrei. Mit Arbeit haben Sie insgesamt fast immer mehr Geld.\"}},{\"@type\":\"Question\",\"name\":\"Gilt der Mindestlohn für mich?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Der gesetzliche Mindestlohn gilt für alle Beschäftigten in Deutschland.\"}},{\"@type\":\"Question\",\"name\":\"Können Erwachsene eine Ausbildung beginnen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Die Ausbildung steht auch Erwachsenen offen und führt oft am schnellsten zu einem anerkannten deutschen Abschluss.\"}},{\"@type\":\"Question\",\"name\":\"Soll ich eine Steuererklärung machen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oft lohnt es sich. Über das kostenlose Portal ELSTER bekommen viele Beschäftigte Geld zurück.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Den ersten Job in Deutschland finden\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-first-job.html\"}]}]}</script>"
      },
      "components": [
        {
          "_name": "amenu1",
          "_sourceTheme": "solarm5",
          "_styles": {
            "& when (@sticky)": {
              "position": "sticky !important",
              "top": "0 !important",
              "z-index": "1030 !important",
              "width": "100%",
              "nav.navbar, .navbar-dropdown, .navbar-fixed-top": {
                "position": "relative !important"
              }
            },
            "& when not (@sticky)": {
              "position": "relative",
              "z-index": "1030",
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "body": {
              "position": "relative"
            },
            ".navbar": {
              "min-height": "80px",
