    "guide-violence-protection.html": {
      "settings": {
        "title": "Schutz vor Gewalt in Deutschland: Hilfe und Hilfetelefone",
        "order": "46",
        "meta_descr": "Häusliche Gewalt, Frauenhäuser, Gewaltschutz, Hilfetelefone mit Dolmetschern, Hilfe für Kinder und Opfer von Straftaten: wo es in Deutschland Hilfe gibt.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-violence-protection.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-violence-protection.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-violence-protection.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-violence-protection.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-violence-protection.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Schutz vor Gewalt in Deutschland: Hilfe und Hilfetelefone\" />\n<meta property=\"og:description\" content=\"Häusliche Gewalt, Frauenhäuser, Gewaltschutz, Hilfetelefone mit Dolmetschern, Hilfe für Kinder und Opfer von Straftaten: wo es in Deutschland Hilfe gibt.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-violence-protection.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Schutz vor Gewalt: Wo Sie Hilfe bekommen\",\"description\":\"Häusliche Gewalt, Frauenhäuser, Gewaltschutz, Hilfetelefone mit Dolmetschern, Hilfe für Kinder und Opfer von Straftaten: wo es in Deutschland Hilfe gibt.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-violence-protection.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-violence-protection.html\",\"wordCount\":948,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Wen kann ich nachts anrufen, wenn ich in Gefahr bin?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Die Polizei unter 110. Das Hilfetelefon 116 016 ist kostenlos, anonym und rund um die Uhr erreichbar, mit Dolmetscherinnen.\"}},{\"@type\":\"Question\",\"name\":\"Kann die Polizei meinen Partner aus der Wohnung weisen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Die Polizei kann eine gewalttätige Person für mehrere Tage aus der Wohnung weisen, auch wenn sie Mieter ist.\"}},{\"@type\":\"Question\",\"name\":\"Kostet ein Frauenhaus Geld?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Für Sie meist nicht: Die Kosten tragen in der Regel Jobcenter oder Sozialamt.\"}},{\"@type\":\"Question\",\"name\":\"Verliere ich meinen Aufenthalt, wenn ich meinen Partner verlasse?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Mit vorübergehendem Schutz haben Sie einen eigenen Titel. Bei anderen Titeln früh beraten lassen; besondere Regeln schützen Opfer.\"}},{\"@type\":\"Question\",\"name\":\"Wo bekommen Kinder Hilfe?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Kinder und Jugendliche erreichen die 116 111 kostenlos und anonym. Das Jugendamt schützt gefährdete Kinder.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Schutz vor Gewalt: Wo Sie Hilfe bekommen\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-violence-protection.html\"}]}]}</script>"
      },
      "components": [
        {
          "_name": "amenu1",
          "_sourceTheme": "solarm5",
          "_styles": {
            "& when (@sticky)": {
              "position": "sticky !important",
              "top": "0 !important",
