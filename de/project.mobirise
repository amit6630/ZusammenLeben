              "justify-content": "center",
              "gap": "15px",
              "margin-top": "20px"
            },
            ".portal-btn": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "10px",
              "padding": "14px 28px",
              "font-size": "1.05rem",
              "font-weight": "700",
              "border-radius": "8px",
              "text-decoration": "none",
              "transition": "all 0.3s ease",
              "cursor": "pointer"
            },
            ".btn-whatsapp": {
              "background-color": "#16a34a",
              "color": "#fff",
              "border": "2px solid #16a34a",
              "box-shadow": "0 4px 10px rgba(22, 163, 74, 0.3)"
            },
            ".btn-whatsapp:hover": {
              "background-color": "#15803d",
              "border-color": "#15803d",
              "color": "#fff",
              "transform": "translateY(-2px)"
            },
            ".btn-outline": {
              "background-color": "transparent",
              "color": "#2563eb",
              "border": "2px solid #2563eb"
            },
            ".btn-outline:hover": {
              "background-color": "#2563eb",
              "color": "#fff"
            },
            ".portal-footer-reminder": {
              "background": "#0f172a",
              "color": "#000000",
              "padding": "40px",
              "border-radius": "12px",
              "text-align": "center",
              "margin-top": "60px"
            },
            ".portal-footer-reminder h3": {
              "color": "#000000",
              "margin-bottom": "25px",
              "font-size": "1.5rem",
              "text-align": "center"
            },
            ".footer-numbers-grid": {
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "center",
              "gap": "20px",
              "font-size": "1.1rem"
            },
            ".footer-numbers-grid div": {
              "background": "rgba(255, 255, 255, 0.1)",
              "padding": "10px 20px",
              "border-radius": "6px",
              "backdrop-filter": "blur(5px)"
            },
            ".footer-emergency-warning": {
              "margin-top": "25px",
              "font-size": "0.95rem",
              "color": "#94a3b8",
              "border-top": "1px solid rgba(255, 255, 255, 0.1)",
              "padding-top": "20px"
            },
            "@media (max-width: 768px)": {
              ".portal-container": {
                "padding": "20px 10px"
              },
              ".portal-alert": {
                "flex-direction": "column",
                "gap": "10px"
              },
              ".emergency-number a": {
                "font-size": "2.8rem"
              },
              ".action-buttons-group": {
                "flex-direction": "column"
              },
              ".portal-btn": {
                "width": "100%",
                "justify-content": "center"
              },
              ".footer-numbers-grid": {
                "flex-direction": "column",
                "gap": "10px"
              },
              ".block-heading h3": {
                "font-size": "1.4rem"
              }
            },
            "H3": {
              "color": "#000000"
            },
            "P": {
              "text-align": "left"
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            },
            "@media (max-width: 575px)": {
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            "@media (max-width: 767px)": {
              ".services-grid, .team-grid, .transparency-grid, .pillars-grid, .three-column-grid, .grid-3, .grid-2, .faq-grid, .survival-grid, .portal-grid-2, .city-directory-grid, .details-cards-stack, .two-column-grid, .levels-grid, .cert-grid, .benefits-grid, .links-grid, .timeline-wrapper": {
                "display": "flex !important",
                "flex-wrap": "nowrap !important",
                "flex-direction": "row !important",
                "grid-template-columns": "none !important",
                "gap": "12px !important",
                "overflow-x": "auto",
                "overscroll-behavior-x": "contain",
                "scroll-snap-type": "x mandatory",
                "padding": "4px 2px 14px !important",
                "scrollbar-width": "none"
              },
              ".services-grid::-webkit-scrollbar, .team-grid::-webkit-scrollbar, .transparency-grid::-webkit-scrollbar, .pillars-grid::-webkit-scrollbar, .three-column-grid::-webkit-scrollbar, .grid-3::-webkit-scrollbar, .grid-2::-webkit-scrollbar, .faq-grid::-webkit-scrollbar, .survival-grid::-webkit-scrollbar, .portal-grid-2::-webkit-scrollbar, .city-directory-grid::-webkit-scrollbar, .details-cards-stack::-webkit-scrollbar, .two-column-grid::-webkit-scrollbar, .levels-grid::-webkit-scrollbar, .cert-grid::-webkit-scrollbar, .benefits-grid::-webkit-scrollbar, .links-grid::-webkit-scrollbar, .timeline-wrapper::-webkit-scrollbar": {
                "display": "none"
              },
              ".services-grid > *, .team-grid > *, .transparency-grid > *, .pillars-grid > *, .three-column-grid > *, .grid-3 > *, .grid-2 > *, .faq-grid > *, .survival-grid > *, .portal-grid-2 > *, .city-directory-grid > *, .details-cards-stack > *, .two-column-grid > *, .levels-grid > *, .cert-grid > *, .benefits-grid > *, .links-grid > *, .timeline-wrapper > *": {
                "flex": "0 0 84% !important",
                "max-width": "84% !important",
                "min-width": "0",
                "margin": "0 !important",
                "scroll-snap-align": "start"
              },
              ".timeline-wrapper::before": {
                "display": "none !important"
              },
              ".metrics-section, .services-section, .process-section, .region-section, .team-section, .transparency-section, .cta-section": {
                "padding-top": "44px !important",
                "padding-bottom": "44px !important"
              },
              ".metrics-grid": {
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr) !important",
                "gap": "10px !important"
              },
              ".word-grid": {
                "max-height": "62vh",
                "overflow-y": "auto",
                "overscroll-behavior": "contain",
                "padding-right": "4px"
              },
              ".metrics-grid > *": {
                "min-width": "0",
                "padding": "18px 10px !important"
              },
              ".metrics-grid .metric-value": {
                "font-size": "2rem !important"
              },
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_name": "people04",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"portal-container\" dir=\"ltr\" lang=\"de\" style=\"max-width: 1140px; margin: 0 auto; box-sizing: border-box;\">\n    \n    <!-- Main Header -->\n    <div class=\"portal-header text-center\">\n        <span class=\"badge-tag badge-primary mb-2\"><i class=\"fa-solid fa-shield-halved\"></i> Geprüfte Ressourcen &amp; Unterstützungsknotenpunkt</span>\n        <h1>Notfallhilfe &amp; Unterstützungsdienste</h1>\n        <h2>Nordbayern — Telefonnummern, Adressen und Hilfe</h2>\n        <p class=\"portal-lead mt-2\">Ein umfassendes Verzeichnis von Notdiensten, Medizinzentren, Rechtshilfe, Wohnungsfürsorge und sozialen Netzwerken in der Region, strukturiert für den schnellen Zugriff im Krisenfall.</p>\n    </div>\n\n    <!-- Quick Jump Navigation Bar -->\n    <nav class=\"portal-nav-bar\" aria-label=\"Quick Navigation\">\n        <a href=\"#immediate-danger\" class=\"nav-pill pill-danger\"><i class=\"fa-solid fa-triangle-exclamation\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M12 2v3\"></path><path d=\"M4.93 4.93l2.12 2.12\"></path><path d=\"M19.07 4.93l-2.12 2.12\"></path><path d=\"M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V10a6 6 0 0 0-12 0v9z\"></path><path d=\"M4 19h16\"></path></svg> Akute Gefahr</a>\n        <a href=\"#medical\" class=\"nav-pill\"><i class=\"fa-solid fa-stethoscope\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M3 21h18\"></path><path d=\"M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16\"></path><path d=\"M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4\"></path><path d=\"M10 9h4\"></path><path d=\"M12 7v4\"></path></svg> Medizin &amp; Giftnotruf</a>\n        <a href=\"#women-aid\" class=\"nav-pill\"><i class=\"fa-solid fa-person-dress\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M12 2a5 5 0 0 0-5 5c0 2 1 3.5 2.5 4.5A8 8 0 0 0 2 19v1h20v-1a8 8 0 0 0-7.5-7.5C16 10.5 17 9 17 7a5 5 0 0 0-5-5z\"></path></svg> Frauenhilfe</a>\n        <a href=\"#youth-family\" class=\"nav-pill\"><i class=\"fa-solid fa-children\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><circle cx=\"19\" cy=\"7\" r=\"2\"></circle><circle cx=\"5\" cy=\"7\" r=\"2\"></circle><path d=\"M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a3 3 0 0 0 3 3h2a3 3 0 0 0 3-3v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z\"></path></svg> Jugend &amp; Familie</a>\n        <a href=\"#housing-food\" class=\"nav-pill\"><i class=\"fa-solid fa-house-crack\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg> Wohnen &amp; Nahrung</a>\n        <a href=\"#cities\" class=\"nav-pill\"><i class=\"fa-solid fa-city\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"></line><path d=\"M12 20V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v16\"></path><path d=\"M4 20V10a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v10\"></path><line x1=\"2\" y1=\"20\" x2=\"22\" y2=\"20\"></line></svg> Städtische Verzeichnisse</a>\n        <a href=\"#contact-team\" class=\"nav-pill pill-highlight\"><i class=\"fa-solid fa-users\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m11 17 2 2a1 1 0 0 0 1.4 0l4.3-4.3a1 1 0 0 0 0-1.4l-2.1-2.1a1 1 0 0 0-1.4 0L12 14\"></path><path d=\"m13 11 2-2a1 1 0 0 0 0-1.4L12.9 5.5a1 1 0 0 0-1.4 0L8.4 8.6a1 1 0 0 0 0 1.4l2.1 2.1a1 1 0 0 0 1.4 0z\"></path><path d=\"M2 11l4.5-4.5a2 2 0 0 1 2.8 0l1.2 1.2\"></path><path d=\"M22 13l-4.5 4.5a2 2 0 0 1-2.8 0l-1.2-1.2\"></path></svg> Unser Team</a>\n    </nav>\n\n    <!-- Important Disclaimer -->\n    <div class=\"portal-alert\">\n        <div class=\"alert-icon\"><i class=\"fa-solid fa-triangle-exclamation fa-2x\"></i></div>\n        <div>\n            <h3 class=\"h5 fw-bold\" style=\"color: inherit; margin-top: 0;\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg> Wichtiger betrieblicher Hinweis</h3>\n            <p class=\"mb-2\">Unsere soziale Initiative ist ein ehrenamtliches Unterstützungsnetzwerk und <strong>ersetzt keine</strong> offiziellen Notrufzentralen, die Polizei, die Feuerwehr, Krankenhäuser oder das Jugendamt.</p>\n            <p class=\"mb-0\"><strong>In jeder unmittelbar lebensbedrohlichen Situation, bei schweren Unfällen, Feuer oder aktiver Gewalt — wählen Sie sofort <a href=\"tel:112\" style=\"color: inherit; text-decoration: underline; font-weight: 700;\">112</a> oder <a href=\"tel:110\" style=\"color: inherit; text-decoration: underline; font-weight: 700;\">110</a>.</strong> Wir können keine Rund-um-die-Uhr-Verfügbarkeit oder sofortige Lösung für jeden Fall garantieren.</p>\n        </div>\n    </div>\n\n    <!-- Section 1: Immediate Danger -->\n    <div id=\"immediate-danger\" class=\"portal-block\">\n        <div class=\"block-heading\">\n            <h3><i class=\"fa-solid fa-phone-volume\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M12 2v3\"></path><path d=\"M4.93 4.93l2.12 2.12\"></path><path d=\"M19.07 4.93l-2.12 2.12\"></path><path d=\"M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V10a6 6 0 0 0-12 0v9z\"></path><path d=\"M4 19h16\"></path></svg> Akute Gefahr — Jetzt anrufen</h3>\n            <p class=\"text-muted\" style=\"color: var(--portal-text-muted) !important;\">Nutzen Sie diese Nummern, wenn jede Sekunde zählt. Kostenlos aus jedem Festnetz- oder Mobilfunknetz in ganz Deutschland und der EU.</p>\n        </div>\n        \n        <div class=\"portal-grid-2\">\n            <div class=\"portal-card emergency-card red-theme\">\n                <div class=\"card-top-meta\">\n                    <span class=\"badge-tag badge-danger\">Lebensrettung</span>\n                    <span class=\"badge-tag badge-secondary\">24/7 Kostenlos</span>\n                </div>\n                <div class=\"emergency-number\"><a href=\"tel:112\" style=\"text-decoration: none;\">112</a></div>\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Rettungsdienst, Notarzt und Feuerwehr</h4>\n                <p class=\"text-muted\" style=\"color: var(--portal-text-muted);\">Rufen Sie an bei Situationen wie:</p>\n                <ul>\n                    <li>Lebensbedrohliche medizinische Notfälle &amp; schwere Atemnot</li>\n                    <li>Bewusstlosigkeit oder schwere Unfälle</li>\n                    <li>Brände und schwere Verletzungen</li>\n                    <li>Verdacht auf Vergiftung &amp; Entsendung des Notarztes</li>\n                </ul>\n                <div class=\"card-footer-note\">Gültig in allen EU-Mitgliedstaaten.</div>\n            </div>\n\n            <div class=\"portal-card emergency-card blue-theme\">\n                <div class=\"card-top-meta\">\n                    <span class=\"badge-tag badge-primary\">Strafverfolgung</span>\n                    <span class=\"badge-tag badge-secondary\">24/7 Kostenlos</span>\n                </div>\n                <div class=\"emergency-number\"><a href=\"tel:110\" style=\"text-decoration: none;\">110</a></div>\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Polizeinotruf</h4>\n                <p class=\"text-muted\" style=\"color: var(--portal-text-muted);\">Rufen Sie an bei Situationen wie:</p>\n                <ul>\n                    <li>Aktive Gewalt oder Drohung mit körperlicher Gewalt</li>\n                    <li>Einbrüche oder laufende Straftaten</li>\n                    <li>Unmittelbare Gefahr für ein Kind oder häusliche Gewalt</li>\n                    <li>Schwere Belästigung, Stalking oder Sicherheitsbedrohungen</li>\n                </ul>\n                <div class=\"card-footer-note\">Bei einem akuten Notfall ist kein Aufsuchen einer Dienststelle erforderlich.</div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Section 2: Medical & Poison Control -->\n    <div id=\"medical\" class=\"portal-block\">\n        <div class=\"block-heading\">\n            <h3><i class=\"fa-solid fa-stethoscope\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M3 21h18\"></path><path d=\"M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16\"></path><path d=\"M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4\"></path><path d=\"M10 9h4\"></path><path d=\"M12 7v4\"></path></svg> Dringende Medizinische Hilfe &amp; Giftnotruf</h3>\n        </div>\n        <div class=\"portal-grid-2\">\n            <div class=\"portal-card\">\n                <div class=\"card-top-meta\">\n                    <span class=\"badge-tag badge-warning\">Nicht lebensbedrohlich</span>\n                </div>\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\"><a href=\"tel:116117\" style=\"color: var(--portal-primary); text-decoration: none;\">116 117</a> — Ärztlicher Bereitschaftsdienst</h4>\n                <p style=\"color: var(--portal-text-muted);\">Bei dringenden medizinischen Anliegen außerhalb der regulären Praxiszeiten (abends, nachts, am Wochenende):</p>\n                <ul>\n                    <li>Hohes Fieber ohne unmittelbares Lebensrisiko</li>\n                    <li>Starke Schmerzen, die eine rasche Abklärung erfordern</li>\n                    <li>Suche nach einer geöffneten Bereitschaftspraxis</li>\n                </ul>\n                <div class=\"inline-warning\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg> In lebensbedrohlichen Fällen wählen Sie immer die 112.</div>\n            </div>\n\n            <div class=\"portal-card\">\n                <div class=\"card-top-meta\">\n                    <span class=\"badge-tag badge-warning\">Toxikologie</span>\n                </div>\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Giftnotrufzentrale (Bayern / München)</h4>\n                <div class=\"highlight-number-box\"><a href=\"tel:08919240\" style=\"color: inherit; text-decoration: none;\">089 19240</a></div>\n                <p style=\"color: var(--portal-text-muted); font-size: 0.95rem;\">Kontakt bei Verschlucken oder Kontakt mit giftigen Substanzen, Chemikalien oder gefährlichen Pflanzen. Veröffentlicht vom Klinikum Fichtelgebirge.</p>\n                <div class=\"inline-warning\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg> Bei Bewusstlosigkeit oder Atemnot wählen Sie zuerst die 112.</div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Section 3: Emergency Call Guide & Phrases -->\n    <div class=\"portal-block\">\n        <div class=\"portal-card bg-subtle\">\n            <h4 class=\"h5 fw-bold mb-3\" style=\"color: #0f172a;\"><i class=\"fa-solid fa-headset\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg> Was Sie bei einem Notruf sagen müssen</h4>\n            <p style=\"color: var(--portal-text-muted);\">Seien Sie darauf vorbereitet, die <strong>5 Ws</strong> klar und ruhig zu beantworten:</p>\n            <div class=\"steps-grid mb-4\">\n                <div class=\"step-box\"><strong>1. Wo?</strong> Stadt, Straße, Hausnummer, Etage, Name am Klingelschild.</div>\n                <div class=\"step-box\"><strong>2. Was?</strong> Kurze Beschreibung des Vorfalls.</div>\n                <div class=\"step-box\"><strong>3. Wer?</strong> Anzahl der betroffenen Personen und Kategorien (Kinder, Senioren).</div>\n                <div class=\"step-box\"><strong>4. Zustand?</strong> Bewusstsein, Atmung, Verletzungen.</div>\n                <div class=\"step-box\"><strong>5. Warten?</strong> Legen Sie erst auf, wenn die Leitstelle das Gespräch beendet.</div>\n            </div>\n            \n            <h5 class=\"h6 fw-bold mb-3\" style=\"color: #0f172a;\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path></svg> Wichtige deutsche Sätze für Personen ohne Deutschkenntnisse:</h5>\n            <div class=\"phrases-grid\">\n                <div class=\"phrase-item\"><strong>Ich spreche nur Englisch</strong><span>Ich spreche nur Englisch</span></div>\n                <div class=\"phrase-item\"><strong>Ich spreche Ukrainisch</strong><span>Ich spreche Ukrainisch</span></div>\n                <div class=\"phrase-item\"><strong>Ich brauche einen Dolmetscher</strong><span>Ich benötige einen Dolmetscher</span></div>\n                <div class=\"phrase-item\"><strong>Es ist ein Notfall</strong><span>Das ist ein Notfall</span></div>\n                <div class=\"phrase-item\"><strong>Meine Adresse ist...</strong><span>Meine Adresse lautet...</span></div>\n                <div class=\"phrase-item\"><strong>Ein Kind ist in Gefahr</strong><span>Ein Kind ist in Gefahr</span></div>\n                <div class=\"phrase-item\"><strong>Ich brauche einen Krankenwagen</strong><span>Ich brauche einen Krankenwagen</span></div>\n                <div class=\"phrase-item\"><strong>Ich brauche die Polizei</strong><span>Ich brauche die Polizei</span></div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Section 4: Women's Assistance -->\n    <div id=\"women-aid\" class=\"portal-block\">\n        <div class=\"block-heading\">\n            <h3><i class=\"fa-solid fa-person-dress\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M12 2a5 5 0 0 0-5 5c0 2 1 3.5 2.5 4.5A8 8 0 0 0 2 19v1h20v-1a8 8 0 0 0-7.5-7.5C16 10.5 17 9 17 7a5 5 0 0 0-5-5z\"></path></svg> Unterstützung für Frauen in Gewalt- oder Notlagen</h3>\n        </div>\n        <div class=\"portal-grid-2\">\n            <div class=\"portal-card\">\n                <div class=\"card-top-meta\">\n                    <span class=\"badge-tag badge-danger\">Vertraulich</span>\n                    <span class=\"badge-tag badge-secondary\">24/7 Kostenlos</span>\n                </div>\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Hilfetelefon Gewalt gegen Frauen</h4>\n                <div class=\"highlight-number-box\" style=\"color: var(--portal-danger);\"><a href=\"tel:116016\" style=\"color: inherit; text-decoration: none;\">116 016</a></div>\n                <p style=\"color: var(--portal-text-muted); font-size: 0.95rem;\">Bundesweites Beratungsangebot bei häuslicher Gewalt, Stalking, sexuellen Übergriffen und Menschenhandel (Hilfetelefon Gewalt gegen Frauen).</p>\n                <ul>\n                    <li>Vollkommen anonym &amp; kostenfrei</li>\n                    <li>Verfügbar auf Ukrainisch, Englisch und weiteren Sprachen</li>\n                    <li>Direkte Weitervermittlung an örtliche Frauenhäuser und Schutzräume</li>\n                </ul>\n            </div>\n\n            <div class=\"portal-card\">\n                <div class=\"card-top-meta\">\n                    <span class=\"badge-tag badge-primary\">Mütterschutz</span>\n                </div>\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Schwangere in Not</h4>\n                <div class=\"highlight-number-box\"><a href=\"tel:08004040020\" style=\"color: inherit; text-decoration: none;\">0800 40 40 020</a></div>\n                <p style=\"color: var(--portal-text-muted); font-size: 0.95rem;\">Vertrauliche Beratung für Schwangere in finanziellen, sozialen oder persönlichen Krisen ohne ausreichende Unterstützung (Hilfetelefon Schwangere in Not).</p>\n                <div class=\"card-footer-note\">Rund um die Uhr in mehreren Sprachen erreichbar, kostenlos und anonym.</div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Section 5: Youth & Family -->\n    <div id=\"youth-family\" class=\"portal-block\">\n        <div class=\"block-heading\">\n            <h3><i class=\"fa-solid fa-children\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><circle cx=\"19\" cy=\"7\" r=\"2\"></circle><circle cx=\"5\" cy=\"7\" r=\"2\"></circle><path d=\"M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a3 3 0 0 0 3 3h2a3 3 0 0 0 3-3v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z\"></path></svg> Hilfe für Kinder, Jugendliche und Eltern</h3>\n        </div>\n        \n        <div class=\"portal-card mb-4\" style=\"background: #fffbe0; border-color: #fef3c7;\">\n            <h4 class=\"h5 fw-bold\" style=\"color: #92400e; margin-top: 0;\"><i class=\"fa-solid fa-child-reaching\"></i> Sofortige Kinderschutzmeldung</h4>\n            <p style=\"color: #78350f; font-size: 0.95rem; margin-bottom: 0;\">Wenn ein Kind in unmittelbarer Gefahr ist, vernachlässigt wird oder Gewalt ausgesetzt ist, kontaktieren Sie sofort die <strong>Polizei (<a href=\"tel:110\" style=\"color: inherit; text-decoration: underline;\">110</a>)</strong> oder den <strong>Rettungsdienst (<a href=\"tel:112\" style=\"color: inherit; text-decoration: underline;\">112</a>)</strong>. Für nicht-akute Überprüfungen des Kindeswohls wenden Sie sich an das örtliche <strong>Jugendamt</strong>. Sie müssen kein Verwandter sein, um ein berechtigtes Sicherheitsrisiko zu melden.</p>\n        </div>\n\n        <div class=\"portal-grid-2 mb-4\">\n            <div class=\"portal-card\">\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Jugendtelefon (Nummer gegen Kummer)</h4>\n                <div class=\"highlight-number-box\"><a href=\"tel:116111\" style=\"color: inherit; text-decoration: none;\">116 111</a></div>\n                <p style=\"color: var(--portal-text-muted); font-size: 0.95rem; margin-bottom: 0;\">Für Kinder und Jugendliche bei Stress, Familienkonflikten, Schuldruck, Mobbing oder seelischen Belastungen. Mo–Sa, 14:00–20:00 Uhr. Kostenlos und anonym.</p>\n            </div>\n\n            <div class=\"portal-card\">\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Elterntelefon</h4>\n                <div class=\"highlight-number-box\"><a href=\"tel:08001110550\" style=\"color: inherit; text-decoration: none;\">0800 111 0550</a></div>\n                <p style=\"color: var(--portal-text-muted); font-size: 0.95rem; margin-bottom: 0;\">Beratung für Eltern bei Familienstress, Erziehungsfragen und dem Wohl des Kindes. Mo/Mi/Fr 09:00–17:00 Uhr, Di/Do 09:00–19:00 Uhr.</p>\n            </div>\n        </div>\n        \n        <div class=\"portal-card mb-4\">\n            <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M3 21h18\"></path><path d=\"M6 18v-7\"></path><path d=\"M10 18v-7\"></path><path d=\"M14 18v-7\"></path><path d=\"M18 18v-7\"></path><path d=\"M12 2 2 7h20L12 2z\"></path></svg> Jugendamt Landkreis Hof</h4>\n            <p style=\"color: var(--portal-text-muted); font-size: 0.95rem; margin-bottom: 6px;\">Zuständig für Helmbrechts, Münchberg, Naila, Bad Steben und umliegende Orte im Landkreis Hof.</p>\n            <p style=\"color: var(--portal-text-muted); font-size: 0.95rem; margin-bottom: 0;\">\n                <strong>Zentrale Hotline:</strong> <a href=\"tel:0928157275\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 57-275</a> | <strong>Allgemeiner Sozialdienst (ASD):</strong> <a href=\"tel:0928157404\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 57-404</a><br>\n                <strong>E-Mail:</strong> <a href=\"mailto:kreisjugendamt@landkreis-hof.de\" style=\"color: var(--portal-primary); text-decoration: none;\">kreisjugendamt@landkreis-hof.de</a>\n            </p>\n        </div>\n        \n        <!-- Emotional Support / TelefonSeelsorge -->\n <div class=\"portal-card mb-4\">\n            <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -0.125em; color: #16a34a;\"><path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"></path></svg> Seelische Unterstützung &amp; TelefonSeelsorge</h4>\n            <p style=\"color: var(--portal-text-muted); font-size: 0.95rem;\">Für alle Personen in persönlichen Krisen, Einsamkeit, Angst oder seelischen Notlagen. Rund um die Uhr erreichbar, kostenlos und anonym:</p>\n            <p style=\"color: var(--portal-text-muted); font-size: 0.95rem; margin-bottom: 0;\">\n                <strong>Kostenfreie Rufnummern:</strong> <a href=\"tel:08001110111\" style=\"color: var(--portal-primary); text-decoration: none;\">0800 111 0 111</a> | <a href=\"tel:08001110222\" style=\"color: var(--portal-primary); text-decoration: none;\">0800 111 0 222</a> | <a href=\"tel:116123\" style=\"color: var(--portal-primary); text-decoration: none;\">116 123</a>\n            </p>\n        </div>\n\n        <!-- Official Ukraine & Jobcenter info -->\n        <div class=\"portal-card\">\n            <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\"><svg width=\"1.2em\" height=\"0.9em\" viewBox=\"0 0 640 480\" style=\"vertical-align: -0.125em; display: inline-block; border-radius: 2px; overflow: hidden;\"><g fill-rule=\"evenodd\" stroke-width=\"1pt\"><path fill=\"#0057b7\" d=\"M0 0h640v240H0z\"></path><path fill=\"#ffd700\" d=\"M0 240h640v240H0z\"></path></g></svg> Offizielle Hilfe für Ukrainer &amp; Beschäftigung</h4>\n            <ul style=\"margin-top: 10px; padding-left: 20px;\">\n                <li><strong>Germany4Ukraine Portal:</strong> Offizielles Portal des Bundes für Registrierung, Unterkunft, Arbeit und Leistungen.</li>\n                <li><strong>Bundesagentur für Arbeit (Erstberatung auf Ukrainisch/Russisch):</strong> <a href=\"tel:+499111787915\" style=\"color: var(--portal-primary); text-decoration: none;\">+49 911 178 7915</a></li>\n                <li style=\"color: var(--portal-danger); font-weight: 600; margin-top: 4px;\"><em>Hinweis:</em> Ältere Verzeichnisse, die die Helpline Ukraine (0800 500 225 0) nennen, sind inaktiv.</li>\n            </ul>\n        </div>\n    </div>\n\n    <!-- Section 6: Housing, Food & Infrastructure -->\n    <div id=\"housing-food\" class=\"portal-block\">\n        <div class=\"block-heading\">\n            <h3><i class=\"fa-solid fa-house-crack\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg> Wohnungslosigkeit, Lebensmittelnotstand &amp; Infrastruktur-Notfälle</h3>\n        </div>\n        <div class=\"portal-grid-2\">\n            <div class=\"portal-card\">\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Drohende Räumung oder Obdachlosigkeit heute Nacht</h4>\n                <ul style=\"padding-left: 20px;\">\n                    <li>Wenden Sie sich sofort an Ihr örtliches <strong>Ordnungsamt</strong> oder die Stadtverwaltung.</li>\n                    <li>Außerhalb der Öffnungszeiten kontaktieren Sie die Polizei unter <a href=\"tel:110\" style=\"color: var(--portal-primary); text-decoration: none;\">110</a>, wenn Sie mit Kindern keine sichere Unterkunft haben.</li>\n                    <li>Informieren Sie Ihre Sachbearbeitung im Jobcenter umgehend schriftlich, sobald Sie eine Kündigung erhalten. Warten Sie nicht.</li>\n                    <li>Bewahren Sie Kopien Ihres Mietvertrags, von Schreiben und Mitteilungen auf.</li>\n                </ul>\n            </div>\n\n            <div class=\"portal-card\">\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Lebensmittelnotstand &amp; Grundversorgung</h4>\n                <ul style=\"padding-left: 20px;\">\n                    <li>Kontaktieren Sie das <strong>Jobcenter</strong> oder <strong>Sozialamt</strong>, wenn sich Leistungszahlungen verzögert haben.</li>\n                    <li>Wenden Sie sich für Notfallverpflegung an örtliche Tafeln (<strong>Tafel</strong>), die Caritas oder Diakonie.</li>\n                    <li>Bringen Sie Ausweisdokumente, Ihre Anmeldebestätigung und Kontoauszüge zum Hilfsangebot mit.</li>\n                </ul>\n            </div>\n        </div>\n\n        <div class=\"portal-card mt-4\">\n            <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg> Versorgungsausfälle, Gasgeruch &amp; Dokumentenverlust</h4>\n            <ul style=\"margin-top: 10px; padding-left: 20px;\">\n                <li><strong>Gasgeruch:</strong> Betätigen Sie keine Lichtschalter und vermeiden Sie offenes Feuer. Verlassen Sie sofort das Gebäude und wählen Sie <a href=\"tel:112\" style=\"color: var(--portal-danger); text-decoration: none; font-weight: bold;\">112</a>.</li>\n                <li><strong>Heizungs-/Wasserundichtigkeit oder Ausfall:</strong> Dokumentieren Sie das Problem mit Fotos und informieren Sie Ihren Vermieter oder die Hausverwaltung umgehend schriftlich.</li>\n                <li><strong>Wasser-Notfallnummer Arzberg:</strong> Für die kommunale Wasserversorgung und Rohrbürche in Arzberg: <a href=\"tel:0923340440\" style=\"color: var(--portal-primary); text-decoration: none;\">09233 404-40</a>.</li>\n                <li><strong>Verlorene Dokumente:</strong> Erstatten Sie bei Diebstahl Anzeige bei der Polizei, lassen Sie Bankkarten sofort sperren und kontaktieren Sie die Ausländerbehörde bezüglich Ihres Aufenthaltstitels.</li>\n            </ul>\n        </div>\n    </div>\n\n    <!-- Section 7: City Directories -->\n    <div id=\"cities\" class=\"portal-block\">\n        <div class=\"block-heading\">\n            <h3><i class=\"fa-solid fa-city\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"></line><path d=\"M12 20V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v16\"></path><path d=\"M4 20V10a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v10\"></path><line x1=\"2\" y1=\"20\" x2=\"22\" y2=\"20\"></line></svg> Regionale Behörden &amp; Städtische Verzeichnisse</h3>\n            <p class=\"text-muted\" style=\"color: var(--portal-text-muted) !important;\">Wichtige Verwaltungsstellen, Polizeidienststellen und örtliche Notaufnahmen in Nordbayern.</p>\n        </div>\n        \n        <div class=\"city-directory-grid\">\n            <!-- Hof -->\n            <div class=\"city-card\">\n                <h4>Hof (Stadt &amp; Landkreis)</h4>\n                <p><strong>Rathaus:</strong> Klosterstraße 1, 95028 Hof | <a href=\"tel:092818150\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 815-0</a></p>\n                <p><strong>Bürgeramt:</strong> Karolinenstraße 40 | <a href=\"tel:092818151450\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 815-1450</a></p>\n                <p><strong>Jobcenter Hof Stadt:</strong> Äußere Bayreuther Str. 2 | <a href=\"tel:09281785950\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 785-950</a></p>\n                <p><strong>Jobcenter Hof Land (Münchberg):</strong> Amtsgasse 4 | <a href=\"tel:092817396888\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 7396888</a></p>\n                <p><strong>Polizei (PI Hof):</strong> Kulmbacher Str. 101 | <a href=\"tel:092817040\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 704-0</a> (Notruf: <a href=\"tel:110\" style=\"color: var(--portal-primary); text-decoration: none;\">110</a>)</p>\n                <p><strong>Krankenhaus (Sana Klinikum Hof):</strong> Eppenreuther Str. 9 | Notaufnahme: <a href=\"tel:09281983399\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 98-3399</a></p>\n            </div>\n\n            <!-- Helmbrechts -->\n            <div class=\"city-card\">\n                <h4>Helmbrechts</h4>\n                <p><strong>Rathaus:</strong> Luitpoldstraße 21, 95233 Helmbrechts | <a href=\"tel:092527010\" style=\"color: var(--portal-primary); text-decoration: none;\">09252 701-0</a></p>\n                <p><strong>Jobcenter:</strong> Zuständig ist das Jobcenter Hof Land (Geschäftsstelle Münchberg: <a href=\"tel:092817396833\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 7396833</a>)</p>\n                <p><strong>Polizei (PI Münchberg):</strong> Angerstraße 29, 95213 Münchberg | <a href=\"tel:09251870040\" style=\"color: var(--portal-primary); text-decoration: none;\">09251 87004-0</a></p>\n            </div>\n\n            <!-- Münchberg -->\n            <div class=\"city-card\">\n                <h4>Münchberg</h4>\n                <p><strong>Rathaus:</strong> Ludwigstraße 15, 95213 Münchberg | <a href=\"tel:092518740\" style=\"color: var(--portal-primary); text-decoration: none;\">09251 874-0</a></p>\n                <p><strong>Jobcenter Geschäftsstelle:</strong> Amtsgasse 4 | <a href=\"tel:092817396833\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 7396833</a></p>\n                <p><strong>Polizeiinspektion:</strong> Angerstraße 29 | <a href=\"tel:09251870040\" style=\"color: var(--portal-primary); text-decoration: none;\">09251 87004-0</a></p>\n            </div>\n\n            <!-- Naila & Bad Steben -->\n            <div class=\"city-card\">\n                <h4>Naila &amp; Bad Steben</h4>\n                <p><strong>Rathaus Naila:</strong> Marktplatz 12 | <a href=\"tel:09282680\" style=\"color: var(--portal-primary); text-decoration: none;\">09282 68-0</a></p>\n                <p><strong>Rathaus Bad Steben:</strong> Hauptstraße 2 | <a href=\"tel:09288740\" style=\"color: var(--portal-primary); text-decoration: none;\">09288 74-0</a></p>\n                <p><strong>Polizei (PI Naila):</strong> Anger 24, 95119 Naila | <a href=\"tel:09282979040\" style=\"color: var(--portal-primary); text-decoration: none;\">09282 97904-0</a></p>\n            </div>\n\n            <!-- Selb -->\n            <div class=\"city-card\">\n                <h4>Selb</h4>\n                <p><strong>Rathaus &amp; Bürgeramt:</strong> Ludwigstraße 6 | <a href=\"tel:092878830\" style=\"color: var(--portal-primary); text-decoration: none;\">09287 883-0</a></p>\n                <p><strong>Jobcenter Fichtelgebirge:</strong> Poststraße 7 | <a href=\"tel:09287991176\" style=\"color: var(--portal-primary); text-decoration: none;\">09287 9911-76</a></p>\n                <p><strong>Medizinische Versorgung:</strong> Medizincampus Selb / Klinikum Fichtelgebirge | <a href=\"tel:092879710\" style=\"color: var(--portal-primary); text-decoration: none;\">09287 971-0</a></p>\n                <p><strong>Polizeiinspektion:</strong> Försterstraße 2a | <a href=\"tel:0928799140\" style=\"color: var(--portal-primary); text-decoration: none;\">09287 9914-0</a></p>\n            </div>\n\n            <!-- Wunsiedel -->\n            <div class=\"city-card\">\n                <h4>Wunsiedel</h4>\n                <p><strong>Rathaus:</strong> Marktplatz 6 | <a href=\"tel:092326020\" style=\"color: var(--portal-primary); text-decoration: none;\">09232 602-0</a></p>\n                <p><strong>Zentrale Notaufnahme (Marktredwitz):</strong> Schillerhain 1–8 | Notaufnahme: <a href=\"tel:092318092120\" style=\"color: var(--portal-primary); text-decoration: none;\">09231 809-2120</a></p>\n                <p><strong>Polizei (PI Wunsiedel):</strong> Kemnather Straße 31 | <a href=\"tel:0923299470\" style=\"color: var(--portal-primary); text-decoration: none;\">09232 9947-0</a></p>\n            </div>\n\n            <!-- Arzberg & Marktredwitz -->\n            <div class=\"city-card\">\n                <h4>Arzberg &amp; Marktredwitz</h4>\n                <p><strong>Rathaus Arzberg:</strong> Friedrich-Ebert-Straße 6 | <a href=\"tel:092334040\" style=\"color: var(--portal-primary); text-decoration: none;\">09233 404-0</a></p>\n                <p><strong>Rathaus Marktredwitz:</strong> Egerstraße 2 | <a href=\"tel:092315010\" style=\"color: var(--portal-primary); text-decoration: none;\">09231 501-0</a></p>\n                <p><strong>Krankenhaus-Notaufnahme:</strong> Klinikum Fichtelgebirge Marktredwitz | Notaufnahme: <a href=\"tel:092318092120\" style=\"color: var(--portal-primary); text-decoration: none;\">09231 809-2120</a></p>\n                <p><strong>Polizei (PI Marktredwitz):</strong> Karlsbader Straße 2 | <a href=\"tel:0923196760\" style=\"color: var(--portal-primary); text-decoration: none;\">09231 9676-0</a></p>\n            </div>\n\n            <!-- Kulmbach -->\n            <div class=\"city-card\">\n                <h4>Kulmbach</h4>\n                <p><strong>Rathaus:</strong> Marktplatz 1, 95326 Kulmbach | <a href=\"tel:092219400\" style=\"color: var(--portal-primary); text-decoration: none;\">09221 940-0</a></p>\n                <p><strong>Jobcenter Kulmbach:</strong> <a href=\"tel:0922182732200\" style=\"color: var(--portal-primary); text-decoration: none;\">09221 82732-200</a></p>\n                <p><strong>Krankenhaus (Klinikum Kulmbach):</strong> Albert-Schweitzer-Str. 10 | Notaufnahme: <a href=\"tel:09221980\" style=\"color: var(--portal-primary); text-decoration: none;\">09221 98-0</a></p>\n                <p><strong>Polizei (PI Kulmbach):</strong> Hardenbergstraße 2 | <a href=\"tel:092216090\" style=\"color: var(--portal-primary); text-decoration: none;\">09221 609-0</a></p>\n            </div>\n        </div>\n    </div>\n\n    <!-- Section 8: Direct Contact with Initiative -->\n    <div id=\"contact-team\" class=\"portal-block\">\n        <div class=\"portal-card contact-highlight-box text-center\" style=\"padding: 40px 20px;\">\n            <h3 class=\"fw-bold mb-3\" style=\"color: #0f172a;\"><i class=\"fa-solid fa-users\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m11 17 2 2a1 1 0 0 0 1.4 0l4.3-4.3a1 1 0 0 0 0-1.4l-2.1-2.1a1 1 0 0 0-1.4 0L12 14\"></path><path d=\"m13 11 2-2a1 1 0 0 0 0-1.4L12.9 5.5a1 1 0 0 0-1.4 0L8.4 8.6a1 1 0 0 0 0 1.4l2.1 2.1a1 1 0 0 0 1.4 0z\"></path><path d=\"M2 11l4.5-4.5a2 2 0 0 1 2.8 0l1.2 1.2\"></path><path d=\"M22 13l-4.5 4.5a2 2 0 0 1-2.8 0l-1.2-1.2\"></path></svg> Kontaktieren Sie unser ehrenamtliches Unterstützungsteam</h3>\n            <p class=\"text-muted mx-auto mb-4\" style=\"max-width: 700px; color: var(--portal-text-muted);\">Wenden Sie sich in nicht-lebensbedrohlichen Situationen an uns für Hilfe bei Übersetzungen, Unterlagen für das Jobcenter, Orientierung bei der Anmeldung oder dringenden Grundbedürfnissen:</p>\n            \n            <div class=\"services-pills-wrap\">\n                <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M12 2C6.5 2 2 4.5 2 8c0 1.5.8 2.8 2 3.8V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.2c1.2-1 2-2.3 2-3.8 0-3.5-4.5-6-10-6z\"></path></svg> Lebensmittelnotstand • <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z\"></path></svg> Kleidung für den Grundbedarf • <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline></svg> Jobcenter-Angelegenheiten • <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><rect x=\"4\" y=\"2\" width=\"16\" height=\"20\" rx=\"2\" ry=\"2\"></rect><line x1=\"9\" y1=\"6\" x2=\"9\" y2=\"6.01\"></line><line x1=\"15\" y1=\"6\" x2=\"15\" y2=\"6.01\"></line><line x1=\"9\" y1=\"10\" x2=\"9\" y2=\"10.01\"></line><line x1=\"15\" y1=\"10\" x2=\"15\" y2=\"10.01\"></line><line x1=\"9\" y1=\"14\" x2=\"9\" y2=\"14.01\"></line><line x1=\"15\" y1=\"14\" x2=\"15\" y2=\"14.01\"></line><line x1=\"9\" y1=\"18\" x2=\"15\" y2=\"18\"></line></svg> Hilfe bei der Anmeldung • <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg> Drohende Obdachlosigkeit • <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"></rect><circle cx=\"9\" cy=\"10\" r=\"2\"></circle><path d=\"M15 8h2\"></path><path d=\"M15 12h2\"></path><path d=\"M7 16h10\"></path></svg> Verlorene Dokumente\n            </div>\n\n            <div class=\"contact-methods-grid mb-4\">\n                <div class=\"method-box\"><strong>WhatsApp:</strong> <a href=\"https://wa.me/4917631189912\" target=\"_blank\" rel=\"noopener\" style=\"color: #15803d; text-decoration: none;\">Anna &amp; Ben kontaktieren</a></div>\n                <div class=\"method-box\"><strong>E-Mail:</strong> <a href=\"mailto:zusammenleben.de@gmail.com\" style=\"color: var(--portal-primary); text-decoration: none;\">Direkte E-Mail senden</a></div>\n            </div>\n\n            <p style=\"color: var(--portal-text-muted); font-size: 0.9rem; max-width: 800px; margin: 0 auto 25px auto;\">Alle Begleit- und Unterstützungsdienste unserer sozialen Initiative sind vollkommen ehrenamtlich und kostenlos. Wir sind hauptsächlich in Hof, Helmbrechts, Münchberg, Selb, Wunsiedel, Arzberg, Marktredwitz, Naila, Kulmbach und Bad Steben tätig.</p>\n\n            <!-- Action Buttons: WhatsApp + Link to Details Page -->\n            <div class=\"action-buttons-group\">\n                <a href=\"https://wa.me/4917631189912\" target=\"_blank\" rel=\"noopener\" class=\"portal-btn btn-whatsapp\"><i class=\"fa-brands fa-whatsapp\"></i> Dringende Anfrage via WhatsApp</a>\n                <a href=\"request-assistance.html\" class=\"portal-btn btn-outline\"><i class=\"fa-solid fa-file-pen\"></i> Formular für Unterstützungsanfragen</a>\n            </div>\n        </div>\n    </div>\n\n    <!-- Footer Quick Reminder -->\n    <div class=\"portal-footer-reminder\">\n        <h3><i class=\"fa-solid fa-bell\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"></path><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"></path></svg> Übersicht der wichtigsten Rufnummern</h3>\n        <div class=\"footer-numbers-grid mb-3\">\n            <div><strong>Rettungsdienst / Feuerwehr:</strong> <a href=\"tel:112\" style=\"color: #000000; text-decoration: underline;\">112</a></div>\n            <div><strong>Polizei:</strong> <a href=\"tel:110\" style=\"color: #000000; text-decoration: underline;\">110</a></div>\n            <div><strong>Ärztlicher Bereitschaftsdienst:</strong> <a href=\"tel:116117\" style=\"color: #000000; text-decoration: underline;\">116 117</a></div>\n            <div><strong>Hilfetelefon Frauen:</strong> <a href=\"tel:116016\" style=\"color: #000000; text-decoration: underline;\">116 016</a></div>\n            <div><strong>Nummer gegen Kummer:</strong> <a href=\"tel:116111\" style=\"color: #000000; text-decoration: underline;\">116 111</a></div>\n            <div><strong>Giftnotruf:</strong> <a href=\"tel:08919240\" style=\"color: #000000; text-decoration: underline;\">089 19240</a></div>\n        </div>\n        <div class=\"footer-emergency-warning\">Im Zweifel über den Ernst einer Notlage wählen Sie immer sofort die 112 oder 110.</div>\n    </div>\n\n</section>",
