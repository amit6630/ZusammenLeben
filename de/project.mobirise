              "border-radius": "8px",
              "padding": "1rem",
              "margin-top": "2rem"
            },
            "@media (max-width: 640px)": {
              ".dictionary-section": {
                "padding": "1.75rem 0.5rem"
              },
              ".survival-grid": {
                "grid-template-columns": "1fr",
                "gap": "1rem"
              },
              ".word-grid": {
                "grid-template-columns": "1fr",
