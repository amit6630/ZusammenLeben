              }
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border-bottom": "1px solid #e6e6e6",
              "padding": "0.5rem 1.8rem",
              "transition": "all 0.25s ease-in-out",
              "&:hover, &:focus": {
                "background": "@primaryColor !important",
                "color": "white !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom": "none",
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative",
              "transition": "all 0.2s",
              "&:hover": {
                "color": "@primaryColor !important"
              }
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".navbar-buttons": {
              "text-align": "center",
              "min-width": "0",
              "flex-shrink": "0"
            },
            ".card-wrap": {
              "display": "flex",
              "align-items": "center",
              "padding": "2px 4px",
              "min-width": "auto"
            },
            ".contacts-menu .mbr-iconfont": {
              "color": "#ffffff"
            },
            ".contacts-menu .menu-divider": {
              "color": "#ccc",
              "font-weight": "300",
              "margin": "0 1px"
            },
            ".desktop-only-flex .mbr-iconfont": {
              "color": "@iconsContactColor"
            },
            ".flags-menu": {
              "display": "flex",
              "align-items": "center",
              "gap": "5px",
              "background": "rgba(0, 0, 0, 0.03)",
              "padding": "3px 8px",
              "border-radius": "20px",
              "border": "1px solid #eaeaea"
            },
            ".lang-link": {
              "display": "flex",
              "align-items": "center",
              "gap": "3px",
              "text-decoration": "none !important",
              "transition": "transform 0.2s ease",
              "&:hover": {
                "transform": "scale(1.08)"
              },
              "white-space": "nowrap",
              "flex-shrink": "0"
            },
            ".lang-code": {
              "font-size": "12px",
              "font-weight": "700",
              "color": "#333",
              "letter-spacing": "0.5px",
              "white-space": "nowrap"
            },
            ".flag-divider": {
              "color": "#ccc",
              "font-size": "12px"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "28px",
              "height": "18px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "flex-basis": "auto",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "26px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "0",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "top": "6px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "top": "6px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "top": "12px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "6px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "6px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".navbar-nav .nav-link": {
              "white-space": "nowrap"
            },
            ".navbar-buttons .btn": {
              "white-space": "nowrap"
            },
            "@media (min-width: 992px) and (max-width: 1399px)": {
              ".navbar-nav .nav-link, .navbar-nav .dropdown-item": {
                "font-size": "14px !important"
              },
              ".navbar-nav .nav-link": {
                "padding-left": ".3em !important",
                "padding-right": ".3em !important"
              },
              ".navbar-buttons .btn": {
                "padding": ".55rem 1rem !important",
                "font-size": "14px !important"
              },
              ".navbar-nav": {
                "margin": "0 !important"
              }
            },
            "@media (min-width: 992px) and (max-width: 1199px)": {
              ".navbar-buttons .btn": {
                "padding": ".5rem .8rem !important",
                "font-size": "13.5px !important"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" global once=\"menu\">\n    <mbr-parameters>\n        <header>Größe</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Volle Breite\" checked>\n        <header>Anzeigen/Ausblenden</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo-Größe\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Markenname\" name=\"showBrand\" checked>\n        <input type=\"checkbox\" title=\"Kontakt-Telefon\" name=\"showPhone\" checked>\n        <input type=\"checkbox\" title=\"Kontakt-Adresse\" name=\"showAddress\" checked>\n        <input type=\"color\" title=\"Farbe der Kontaktsymbole\" name=\"iconsContactColor\" value=\"#0c2c68\" condition=\"showPhone || showAddress\">\n        <input type=\"checkbox\" title=\"Menüpunkte\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Symbole\" name=\"showIcons\">\n        <select title=\"Anzahl\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Symbolfarbe\" name=\"iconsColor\" value=\"#222222\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Schaltfläche\" name=\"showButtons\" checked>\n        <header>Stile</header>\n        <input type=\"checkbox\" title=\"Fixiert\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Eingeklappt\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Deckkraft\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Farbe\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Hamburger-Menü\" name=\"hamburgerColor\" value=\"#222222\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                 'navbar-expand-lg':!collapsed,\n                 'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"brand-container\">\n                <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"ZusammenLeben\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                    <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-caption-wrap\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"index.html\" data-app-placeholder=\"Type Text\">Zusammen Leben</a></span>\n                </div>\n                \n                <!-- פרטי קשר + דגלים (מוצגים אך ורק במחשב) -->\n                <div class=\"contacts-menu desktop-only-flex\">\n                    <div class=\"card-wrap\">\n                        <span class=\"mobi-mbri-phone mobi-mbri\" style=\"font-size: 18px;\"></span>\n                        <div class=\"card-box\">\n                            <p class=\"mbr-text mbr-fonts-style mb-0 display-4\"><a href=\"tel:+380 63 700 4615\" class=\"text-primary\">+380 63 700 4615</a></p>\n                        </div>\n                    </div>\n                    \n                    <span class=\"menu-divider\">|</span>\n\n                    <div class=\"card-wrap\">\n                        <span class=\"mdi-maps-place\" style=\"font-size: 22px;\"></span>\n                        <div class=\"card-box\">\n                            <p class=\"mbr-text mbr-fonts-style mb-0 display-4\">Konradsreuth Alte Hofer Str. 1</p>\n                        </div>\n                    </div>\n\n                    <span class=\"menu-divider\">|</span>\n\n<div class=\"flags-menu\">\n    <a href=\"index.html\" title=\"Deutsch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/de.png\" srcset=\"https://flagcdn.com/48x36/de.png 2x\" alt=\"Deutschland\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">DE</span>\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"../index.html\" title=\"Englisch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/us.png\" srcset=\"https://flagcdn.com/48x36/us.png 2x\" alt=\"Vereinigte Staaten\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">EN</span>\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"../ua/index.html\" title=\"Ukrainisch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/ua.png\" srcset=\"https://flagcdn.com/48x36/ua.png 2x\" alt=\"Ukraine\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">UA</span>\n    </a>\n</div>\n                </div>\n\n                <!-- דגלים בלבד שיופיעו אך ורק בטלפון ליד ההמבורגר -->\n<div class=\"flags-menu mobile-only\">\n    <a href=\"index.html\" title=\"Deutsch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/de.png\" alt=\"DE\" width=\"18\" height=\"13\">\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"../index.html\" title=\"Englisch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/us.png\" alt=\"EN\" width=\"18\" height=\"13\">\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"../ua/index.html\" title=\"Ukrainisch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/ua.png\" alt=\"UA\" width=\"18\" height=\"13\">\n    </a>\n</div>\n                <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Navigation umschalten\" mbr-if=\"showItems || showIcons || showButtons\">\n                    <div class=\"hamburger\">\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                </button>\n            </div>\n            \n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-scroll-collapse>\n                <ul class=\"navbar-nav nav-dropdown\" data-app-modern-menu=\"true\" mbr-menu><li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"index.html\" data-app-placeholder=\"Type Text\">Startseite</a>\n                    </li>\n    \n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Über uns</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"social-activity.html\" data-app-placeholder=\"Type Text\">Unsere Aktivitäten</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"anna-shishoili.html\" data-app-placeholder=\"Type Text\">Anna Cheishvili</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"services.html\" data-app-placeholder=\"Type Text\">Dienstleistungen</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"request-assistance.html\" data-app-placeholder=\"Type Text\">Hilfe anfordern</a>\n                    </li>\n    \n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Leben in Deutschland</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"glossary.html\" data-app-placeholder=\"Type Text\">Glossar</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"learning-german.html\" data-app-placeholder=\"Type Text\">Deutsch lernen</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"refugee-rights.html\" data-app-placeholder=\"Type Text\">Rechte ukrainischer Flüchtlinge</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"guides.html\">Ratgeber & Artikel</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"areasweserve.html\" data-app-placeholder=\"Type Text\">Unsere Regionen</a>\n                    </li>\n\n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Gemeinschaft</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"community.html\" data-app-placeholder=\"Type Text\">Unsere Gemeinschaft</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"family-stories.html\" data-app-placeholder=\"Type Text\">Familiengeschichten</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"faq.html#list01-b\" data-app-placeholder=\"Type Text\">FAQ</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"how-to-help.html\" data-app-placeholder=\"Type Text\">Wie Sie helfen können</a>\n                    </li>\n    \n                    <!-- Emergency - Highlighted in a separate prominent color -->\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link font-weight-bold display-4 text-primary\" href=\"emergency.html\" style=\"color: #c81e1e !important;\" data-app-placeholder=\"Type Text\">Notfall</a>\n                    </li></ul>\n                \n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary display-4\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">Kontaktieren Sie uns</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "amenu1-2l",
          "_isUserblock": true,
          "_cid": "vquIWTRKB4",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            ".guide-executive-section": {
              "padding": "80px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "'Inter', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.6",
              "direction": "ltr",
              "text-align": "left",
              "-webkit-font-smoothing": "antialiased",
              "overflow-x": "hidden",
              "width": "100%"
            },
            ".guide-executive-section *": {
              "box-sizing": "border-box",
              "max-width": "100%",
              "overflow-wrap": "break-word",
              "word-wrap": "break-word"
            },
            ".executive-container": {
              "max-width": "980px",
              "margin": "0 auto",
              "padding": "0 24px",
              "width": "100%"
            },
            ".guide-header": {
              "text-align": "center",
              "max-width": "820px",
              "margin": "0 auto 40px"
            },
            ".header-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "margin-top": "20px",
              "border": "1px solid #bfdbfe"
            },
            ".header-title": {
              "font-size": "2.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.025em",
              "margin": "0 0 16px 0",
              "line-height": "1.25",
              "text-align": "center"
            },
            ".header-lead": {
              "font-size": "1.15rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.6"
            },
            ".disclaimer-banner": {
              "background": "#fffbeb",
              "border": "1px solid #fde68a",
              "border-radius": "14px",
              "padding": "20px 24px",
              "display": "flex",
              "gap": "16px",
              "align-items": "flex-start",
              "margin-bottom": "45px",
              "box-shadow": "0 2px 8px rgba(245, 158, 11, 0.05)"
            },
            ".disclaimer-icon": {
              "color": "#d97706",
              "flex-shrink": "0",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#fef3c7",
              "padding": "10px",
              "border-radius": "10px"
            },
            ".disclaimer-text": {
              "font-size": "0.95rem",
              "color": "#92400e",
              "line-height": "1.6"
            },
            ".guide-block": {
              "margin-bottom": "45px",
              "width": "100%"
            },
            ".block-title": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "20px",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "border-bottom": "2px solid #e2e8f0",
              "padding-bottom": "12px"
            },
            ".title-icon": {
              "color": "#2563eb",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#eff6ff",
              "width": "36px",
              "height": "36px",
              "border-radius": "8px",
              "border": "1px solid #dbeafe",
              "flex-shrink": "0"
            },
            ".three-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(260px, 1fr))",
              "gap": "16px",
              "width": "100%"
            },
            ".two-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(280px, 1fr))",
              "gap": "20px",
              "width": "100%"
            },
            ".guide-mini-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "14px",
              "padding": "24px",
              "transition": "transform 0.2s ease, box-shadow 0.2s ease",
              "width": "100%"
            },
            ".guide-mini-card:hover": {
              "transform": "translateY(-2px)",
              "box-shadow": "0 6px 15px rgba(0, 0, 0, 0.04)"
            },
            ".mini-icon": {
              "color": "#2563eb",
              "margin-bottom": "14px",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#eff6ff",
              "padding": "10px",
              "border-radius": "10px",
              "border": "1px solid #dbeafe"
            },
            ".guide-mini-card h3": {
              "font-size": "1.05rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".guide-mini-card p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.55"
            },
            ".guide-subcard": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "28px",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.02)",
              "width": "100%"
            },
            ".guide-subcard h3": {
              "font-size": "1.2rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 12px 0"
            },
            ".guide-subcard p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin-bottom": "12px",
              "line-height": "1.65"
            },
            ".action-steps-list": {
              "margin": "0",
              "padding-left": "20px",
              "color": "#475569"
            },
            ".action-steps-list li": {
              "margin-bottom": "10px",
              "font-size": "0.95rem",
              "line-height": "1.6"
            },
            ".rule-box": {
              "padding": "20px 24px",
              "border-radius": "14px",
              "margin": "20px 0 0 0",
              "width": "100%"
            },
            ".rule-box h3": {
              "font-size": "1.05rem",
              "font-weight": "700",
              "margin": "0 0 8px 0",
              "display": "flex",
              "align-items": "center",
              "gap": "8px"
            },
            ".rule-box p": {
              "font-size": "0.9rem",
              "margin": "0",
              "line-height": "1.55"
            },
            ".rule-box .inline-icon": {
              "display": "inline-flex",
              "align-items": "center"
            },
            ".rule-box.green-rule": {
              "background": "#f0fdf4",
              "border": "1px solid #bbf7d0",
              "border-left": "5px solid #22c55e",
              "color": "#166534"
            },
            ".rule-box.green-rule h3": {
              "color": "#166534"
            },
            ".guide-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "32px",
              "margin-bottom": "20px",
              "box-shadow": "0 4px 20px rgba(0, 0, 0, 0.03)",
              "width": "100%"
            },
            ".cta-box": {
              "text-align": "center",
              "margin-top": "10px",
              "padding": "40px 32px",
              "background": "linear-gradient(180deg, #ffffff 0%, #f8fafc 100%)"
            },
            ".cta-box h3": {
              "font-size": "1.5rem",
              "font-weight": "800",
              "margin-bottom": "14px",
              "color": "#0f172a"
            },
            ".cta-description": {
              "max-width": "700px",
              "margin": "0 auto 16px",
              "color": "#475569",
              "font-size": "1rem"
            },
            ".cta-statement": {
              "font-weight": "700",
              "color": "#0f172a",
              "margin-bottom": "28px",
              "font-size": "1.05rem"
            },
            ".guide-executive-section .mbr-section-btn": {
              "display": "flex",
              "gap": "12px",
              "flex-wrap": "wrap",
              "margin": "0",
              "justify-content": "center",
              "width": "100%"
            },
            ".guide-executive-section .btn.custom-btn": {
              "padding": "14px 28px !important",
              "border-radius": "100px !important",
              "font-weight": "700 !important",
              "font-size": "0.95rem !important",
              "display": "inline-flex !important",
              "align-items": "center !important",
              "justify-content": "center !important",
              "gap": "8px !important",
              "transition": "all 0.25s ease !important",
              "border-width": "1px !important",
              "text-decoration": "none !important"
            },
            ".guide-executive-section .btn.whatsapp-btn": {
              "background-color": "#25d366 !important",
              "border-color": "#25d366 !important",
              "color": "#ffffff !important"
            },
            ".guide-executive-section .btn.whatsapp-btn:hover": {
              "background-color": "#20bd5a !important",
              "border-color": "#20bd5a !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 4px 12px rgba(37, 211, 102, 0.3) !important"
            },
            ".guide-executive-section .btn.outline-btn": {
              "background-color": "#ffffff !important",
              "border-color": "#cbd5e1 !important",
              "color": "#0f172a !important"
            },
            ".guide-executive-section .btn.outline-btn:hover": {
              "background-color": "#f1f5f9 !important",
              "border-color": "#94a3b8 !important",
              "transform": "translateY(-2px) !important"
            },
            "@media (max-width: 768px)": {
              ".guide-executive-section": {
                "padding": "40px 0 !important"
              },
              ".executive-container": {
                "padding": "0 16px"
              },
              ".header-title": {
                "font-size": "1.75rem"
              },
              ".header-lead": {
                "font-size": "1rem"
              },
              ".disclaimer-banner": {
                "padding": "16px",
                "flex-direction": "column",
                "gap": "12px"
              },
              ".three-column-grid, .two-column-grid": {
                "grid-template-columns": "1fr !important",
                "gap": "14px"
              },
              ".guide-mini-card": {
                "padding": "18px 16px"
              },
              ".guide-subcard": {
                "padding": "20px 16px"
              },
              ".cta-box": {
                "padding": "28px 16px"
              },
              ".rule-box": {
                "padding": "16px"
              },
              ".block-title": {
                "font-size": "1.2rem"
              },
              ".guide-executive-section .btn.custom-btn": {
                "width": "100% !important"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            },
            "@media (max-width: 575px)": {
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            "@media (max-width: 767px)": {
              ".services-grid, .team-grid, .transparency-grid, .pillars-grid, .three-column-grid, .grid-3, .grid-2, .faq-grid, .survival-grid, .portal-grid-2, .city-directory-grid, .details-cards-stack, .two-column-grid, .levels-grid, .cert-grid, .benefits-grid, .links-grid, .timeline-wrapper": {
                "display": "flex !important",
                "flex-wrap": "nowrap !important",
                "flex-direction": "row !important",
                "grid-template-columns": "none !important",
                "gap": "12px !important",
                "overflow-x": "auto",
                "overscroll-behavior-x": "contain",
                "scroll-snap-type": "x mandatory",
                "padding": "4px 2px 14px !important",
                "scrollbar-width": "none"
              },
              ".services-grid::-webkit-scrollbar, .team-grid::-webkit-scrollbar, .transparency-grid::-webkit-scrollbar, .pillars-grid::-webkit-scrollbar, .three-column-grid::-webkit-scrollbar, .grid-3::-webkit-scrollbar, .grid-2::-webkit-scrollbar, .faq-grid::-webkit-scrollbar, .survival-grid::-webkit-scrollbar, .portal-grid-2::-webkit-scrollbar, .city-directory-grid::-webkit-scrollbar, .details-cards-stack::-webkit-scrollbar, .two-column-grid::-webkit-scrollbar, .levels-grid::-webkit-scrollbar, .cert-grid::-webkit-scrollbar, .benefits-grid::-webkit-scrollbar, .links-grid::-webkit-scrollbar, .timeline-wrapper::-webkit-scrollbar": {
                "display": "none"
              },
              ".services-grid > *, .team-grid > *, .transparency-grid > *, .pillars-grid > *, .three-column-grid > *, .grid-3 > *, .grid-2 > *, .faq-grid > *, .survival-grid > *, .portal-grid-2 > *, .city-directory-grid > *, .details-cards-stack > *, .two-column-grid > *, .levels-grid > *, .cert-grid > *, .benefits-grid > *, .links-grid > *, .timeline-wrapper > *": {
                "flex": "0 0 84% !important",
                "max-width": "84% !important",
                "min-width": "0",
                "margin": "0 !important",
                "scroll-snap-align": "start"
              },
              ".timeline-wrapper::before": {
                "display": "none !important"
              },
              ".metrics-section, .services-section, .process-section, .region-section, .team-section, .transparency-section, .cta-section": {
                "padding-top": "44px !important",
                "padding-bottom": "44px !important"
              },
              ".metrics-grid": {
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr) !important",
                "gap": "10px !important"
              },
              ".word-grid": {
                "max-height": "62vh",
                "overflow-y": "auto",
                "overscroll-behavior": "contain",
                "padding-right": "4px"
              },
              ".metrics-grid > *": {
                "min-width": "0",
                "padding": "18px 10px !important"
              },
              ".metrics-grid .metric-value": {
                "font-size": "2rem !important"
              },
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_name": "header02",
          "_sourceTheme": "emblemm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"guide-executive-section\" id=\"how-can-you-help\">\n    <div class=\"executive-container\">\n        \n        <!-- Header -->\n        <header class=\"guide-header\">\n            <span class=\"header-tag\" mbr-editable>HELFEN SIE UNS</span>\n            <h1 class=\"header-title\" mbr-editable>Wie Sie helfen können</h1>\n            <p class=\"header-lead\" mbr-editable>\n                Für Einzelpersonen, Unternehmen und Fachkräfte in der Region\n            </p>\n        </header>\n\n        <!-- General Disclaimer / Notice -->\n        <div class=\"disclaimer-banner\">\n            <div class=\"disclaimer-icon\">\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"></path></svg>\n            </div>\n            <div class=\"disclaimer-text\" mbr-editable>\n                <strong>Jeder Beitrag zählt:</strong> Unsere Arbeit basiert auf Menschen, die von dem geben, was sie haben — Zeit, Raum, Wissen, Möbel oder einfach die Bereitschaft, jemanden zu einem Termin zu fahren. Kein Beitrag ist zu klein, und es ist keine langfristige Verpflichtung erforderlich.\n            </div>\n        </div>\n\n        <!-- Section 1: Ways to Help Grid -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg>\n                </span>\n                Möglichkeiten zu helfen\n            </h2>\n\n            <div class=\"three-column-grid\">\n                \n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg>\n                    </div>\n                    <h3 mbr-editable>Allgemeine Ehrenamtliche Hilfe</h3>\n                    <p mbr-editable>Familienbegleitung, Unterstützung bei der Organisation und Präsenz bei Gemeinschaftstreffen.</p>\n                </div>\n\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"2\" y1=\"12\" x2=\"22\" y2=\"12\"></line><path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"></path></svg>\n                    </div>\n                    <h3 mbr-editable>Übersetzung</h3>\n                    <p mbr-editable>Personen mit Kenntnissen in Ukrainisch, Russisch oder Deutsch, die bei Gesprächen oder der Übersetzung von Dokumenten helfen können. Einer unserer wichtigsten Bedarfe.</p>\n                </div>\n\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect><polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle></svg>\n                    </div>\n                    <h3 mbr-editable>Fahrdienste</h3>\n                    <p mbr-editable>Fahrten zu Terminen bei Behörden, Ärzten oder in eine Nachbarstadt. In einer ländlichen Region ist das eine größere Hilfe, als es klingt.</p>\n                </div>\n\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"></path><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"></polyline><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"></line></svg>\n                    </div>\n                    <h3 mbr-editable>Umzug &amp; Transport</h3>\n                    <p mbr-editable>Wer über ein Nutzfahrzeug oder einen Transporter verfügt, kann beim Möbeltransport zwischen Wohnungen helfen.</p>\n                </div>\n\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg>\n                    </div>\n                    <h3 mbr-editable>Möbelspenden</h3>\n                    <p mbr-editable>Betten, Kleiderschränke, Tische, Stühle und Sofas in gutem Zustand.</p>\n                </div>\n\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z\"></path><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line><path d=\"M16 10a4 4 0 0 1-8 0\"></path></svg>\n                    </div>\n                    <h3 mbr-editable>Haushaltsausstattung</h3>\n                    <p mbr-editable>Küchenutensilien, Bettwäsche, kleine Elektrogeräte und Lampen.</p>\n                </div>\n\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 12 20 22 4 22 4 12\"></polyline><rect x=\"2\" y=\"7\" width=\"20\" height=\"5\"></rect><line x1=\"12\" y1=\"22\" x2=\"12\" y2=\"7\"></line><path d=\"M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z\"></path><path d=\"M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z\"></path></svg>\n                    </div>\n                    <h3 mbr-editable>Kleiderspenden</h3>\n                    <p mbr-editable>Besonders Winterkleidung und Kinderkleidung in gutem Zustand.</p>\n                </div>\n\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"></path></svg>\n                    </div>\n                    <h3 mbr-editable>Kinderausstattung</h3>\n                    <p mbr-editable>Kinderwagen, Kindersitze, Schulbedarf, Spielzeug und Bücher.</p>\n                </div>\n\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"></path></svg>\n                    </div>\n                    <h3 mbr-editable>Fachliche Unterstützung</h3>\n                    <p mbr-editable>Lehrkräfte, Pädagogen, medizinische Fachkräfte, Techniker und Handwerker, die Wissen oder Arbeitsstunden einbringen können.</p>\n                </div>\n\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect><path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path></svg>\n                    </div>\n                    <h3 mbr-editable>Stellenangebote</h3>\n                    <p mbr-editable>Arbeitgeber in der Region, die bereit sind, ukrainischsprachige Kandidaten zu berücksichtigen, auch für Stellen ohne hohe Deutschkenntnisse.</p>\n                </div>\n\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 20V6a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v14\"></path><path d=\"M2 20h20\"></path><path d=\"M14 12v.01\"></path></svg>\n                    </div>\n                    <h3 mbr-editable>Wohnungsangebot</h3>\n                    <p mbr-editable>Wohnungseigentümer im Tätigkeitsgebiet sind eingeladen, sich bei uns zu melden. Wir erklären den Ablauf, die Einbindung des Jobcenters und die Voraussetzungen. Jede Immobilie wird individuell und unverbindlich geprüft.</p>\n                </div>\n\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg>\n                    </div>\n                    <h3 mbr-editable>Bereitstellung von Räumlichkeiten</h3>\n                    <p mbr-editable>Ein Veranstaltungsort für Begegnungen, ein Saal oder ein verfügbarer Raum für ein Treffen.</p>\n                </div>\n\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"></line><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"></line><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"></line></svg>\n                    </div>\n                    <h3 mbr-editable>Unternehmenskooperation</h3>\n                    <p mbr-editable>Lokale Unternehmen, die mit Ausrüstung, Dienstleistungen oder Kontakten zum lokalen Netzwerk unterstützen können.</p>\n                </div>\n\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>\n                    </div>\n                    <h3 mbr-editable>Logistische Unterstützung</h3>\n                    <p mbr-editable>Lagerraum, Zwischenlagerung, Fahrzeuge oder Transportunterstützung.</p>\n                </div>\n\n            </div>\n        </div>\n\n        <!-- Section 2: How to Offer & Process -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polyline points=\"12 6 12 12 16 14\"></polyline></svg>\n                </span>\n                Hilfe anbieten &amp; Nächste Schritte\n            </h2>\n\n            <div class=\"two-column-grid\">\n                <!-- How to Offer -->\n                <div class=\"guide-subcard\">\n                    <h3 mbr-editable>So können Sie Ihre Hilfe anbieten</h3>\n                    <p mbr-editable>Es gibt keine Formulare auf der Website. Schreiben Sie uns einfach per WhatsApp oder E-Mail und teilen Sie uns kurz mit:</p>\n                    <ol class=\"action-steps-list\" mbr-editable>\n                        <li>Was Sie beitragen können — Zeit, Ausrüstung, Raum oder Wissen</li>\n                        <li>In welchem Bereich oder in welcher Stadt</li>\n                        <li>Ihre zeitliche Verfügbarkeit, so gut Sie es einschätzen können</li>\n                    </ol>\n                </div>\n\n                <!-- What Happens Next -->\n                <div class=\"guide-subcard\">\n                    <h3 mbr-editable>Was passiert nach Ihrer Kontaktaufnahme</h3>\n                    <p mbr-editable>Wir lesen Ihre Nachricht, melden uns bei Ihnen und finden gemeinsam heraus, was zu Ihnen passt und was aktuell benötigt wird.</p>\n                    <p mbr-editable>Manchmal ist der Bedarf unmittelbar da, und manchmal bleiben wir in Kontakt, bis sich eine passende Gelegenheit ergibt. In beiden Fällen — vielen Dank.</p>\n\n                    <div class=\"rule-box green-rule\">\n                        <h3>\n                            <span class=\"inline-icon\">\n                                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><polyline points=\"22 4 12 14.01 9 11.01\"></polyline></svg>\n                            </span>\n                            Keine langfristige Verpflichtung\n                        </h3>\n                        <p>Sie können ganz unverbindlich im kleinen Rahmen beginnen. Jeder Beitrag, ob groß oder klein, bewirkt direkt etwas.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 3: CTA Box -->\n        <div class=\"guide-block\">\n            <div class=\"guide-card cta-box\">\n                <h3 mbr-editable>Bereit zu helfen?</h3>\n                <p class=\"cta-description\" mbr-editable>\n                    Wir erklären Ihnen genau, was benötigt wird, und stimmen alles mit Ihnen ab. Starten Sie ganz ohne Druck im kleinen Rahmen.\n                </p>\n                <p class=\"cta-statement\" mbr-editable>\n                    Kontaktieren Sie uns noch heute per WhatsApp oder E-Mail und teilen Sie uns mit, wie Sie helfen können!\n                </p>\n                \n                <!-- BUTTONS -->\n                <div class=\"mbr-section-btn cta-buttons-wrapper\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn custom-btn whatsapp-btn display-4 btn-warning\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                        WhatsApp Anna\n                    </a>\n                    <a class=\"btn custom-btn outline-btn btn-primary\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"></path><polyline points=\"22,6 12,13 2,6\"></polyline></svg>\n                        Kontaktieren Sie uns\n                    </a></div>\n            </div>\n        </div>\n\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
