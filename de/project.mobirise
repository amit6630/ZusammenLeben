    "guide-winter-heating.html": {
      "settings": {
        "title": "Winter in Deutschland: Heizen, Schimmel und Energiekosten",
        "order": "48",
        "meta_descr": "Richtig heizen und lüften, Schimmel vermeiden, die Energieabrechnung verstehen, Strom sparen, Hilfe bei hohen Kosten und sicher durch Schnee und Eis.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-winter-heating.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-winter-heating.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-winter-heating.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-winter-heating.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-winter-heating.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Winter in Deutschland: Heizen, Schimmel und Energiekosten\" />\n<meta property=\"og:description\" content=\"Richtig heizen und lüften, Schimmel vermeiden, die Energieabrechnung verstehen, Strom sparen, Hilfe bei hohen Kosten und sicher durch Schnee und Eis.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-winter-heating.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Gut durch den deutschen Winter\",\"description\":\"Richtig heizen und lüften, Schimmel vermeiden, die Energieabrechnung verstehen, Strom sparen, Hilfe bei hohen Kosten und sicher durch Schnee und Eis.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-winter-heating.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-winter-heating.html\",\"wordCount\":911,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Was bedeutet Stufe 3 am Heizkörper?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Etwa 20 °C. Die Zahlen sind Zieltemperaturen, keine Leistungsstufen; Stufe 5 heizt nicht schneller.\"}},{\"@type\":\"Question\",\"name\":\"Wie lüfte ich im Winter richtig?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Fenster fünf bis zehn Minuten weit öffnen, zwei- bis viermal täglich, statt sie stundenlang zu kippen.\"}},{\"@type\":\"Question\",\"name\":\"Wer zahlt die Schimmelbeseitigung?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Der Vermieter, wenn Baumängel die Ursache sind. Melden Sie Schimmel schriftlich mit Fotos.\"}},{\"@type\":\"Question\",\"name\":\"Zahlt das Jobcenter die Heizkosten?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja, angemessene Heizkosten zusätzlich zur Miete, auch Nachzahlungen. Strom gehört zum Regelbedarf.\"}},{\"@type\":\"Question\",\"name\":\"Muss ich Schnee räumen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oft ja, abwechselnd mit anderen Mietern. Prüfen Sie Mietvertrag oder Hausordnung.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Gut durch den deutschen Winter\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-winter-heating.html\"}]}]}</script>"
      },
