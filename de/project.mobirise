        "meta_descr": "Praktische Ratgeber für ukrainische Familien in Oberfranken: Wohnung, Jobcenter-Briefe, Schule, Gesundheit, Arbeit, Aufenthalt und Alltag.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guides.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guides.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guides.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guides.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guides.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Ratgeber für ukrainische Familien | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"Praktische Ratgeber für ukrainische Familien in Oberfranken: Wohnung, Jobcenter-Briefe, Schule, Gesundheit, Arbeit, Aufenthalt und Alltag.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guides.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"CollectionPage\",\"url\":\"https://zusammenleben-ukraine.de/de/guides.html\",\"name\":\"Ratgeber für ukrainische Familien\",\"description\":\"Praktische Ratgeber für ukrainische Familien in Oberfranken: Wohnung, Jobcenter-Briefe, Schule, Gesundheit, Arbeit, Aufenthalt und Alltag.\",\"inLanguage\":\"de\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"}},{\"@type\":\"ItemList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"url\":\"https://zusammenleben-ukraine.de/de/guide-finding-apartment.html\",\"name\":\"Wohnungssuche in Oberfranken mit Unterstützung des Jobcenters\"},{\"@type\":\"ListItem\",\"position\":2,\"url\":\"https://zusammenleben-ukraine.de/de/guide-jobcenter-letters.html\",\"name\":\"Briefe vom Jobcenter verstehen und richtig beantworten\"},{\"@type\":\"ListItem\",\"position\":3,\"url\":\"https://zusammenleben-ukraine.de/de/guide-school-kita-bavaria.html\",\"name\":\"Ihr Kind in Bayern für Schule oder Kita anmelden\"},{\"@type\":\"ListItem\",\"position\":4,\"url\":\"https://zusammenleben-ukraine.de/de/guide-health-insurance-doctor.html\",\"name\":\"Krankenversicherung und Arztbesuch in Deutschland\"},{\"@type\":\"ListItem\",\"position\":5,\"url\":\"https://zusammenleben-ukraine.de/de/guide-recognition-qualifications.html\",\"name\":\"Ukrainische Berufsabschlüsse in Deutschland anerkennen lassen\"},{\"@type\":\"ListItem\",\"position\":6,\"url\":\"https://zusammenleben-ukraine.de/de/guide-integration-course.html\",\"name\":\"Der Integrationskurs: Ihr schnellster Weg zur deutschen Sprache\"},{\"@type\":\"ListItem\",\"position\":7,\"url\":\"https://zusammenleben-ukraine.de/de/guide-residence-permit-24.html\",\"name\":\"Ihre Aufenthaltserlaubnis nach §24: Das Wichtigste\"},{\"@type\":\"ListItem\",\"position\":8,\"url\":\"https://zusammenleben-ukraine.de/de/guide-first-job.html\",\"name\":\"Den ersten Job in Deutschland finden\"},{\"@type\":\"ListItem\",\"position\":9,\"url\":\"https://zusammenleben-ukraine.de/de/guide-bank-account-phone.html\",\"name\":\"Bankkonto, Handyvertrag und Rundfunkbeitrag\"},{\"@type\":\"ListItem\",\"position\":10,\"url\":\"https://zusammenleben-ukraine.de/de/guide-driving-licence.html\",\"name\":\"Mit ukrainischem Führerschein in Deutschland fahren\"},{\"@type\":\"ListItem\",\"position\":11,\"url\":\"https://zusammenleben-ukraine.de/de/guide-anmeldung.html\",\"name\":\"Anmeldung: Den Wohnsitz in Deutschland anmelden\"},{\"@type\":\"ListItem\",\"position\":12,\"url\":\"https://zusammenleben-ukraine.de/de/guide-child-benefit.html\",\"name\":\"Kindergeld und Familienleistungen in Deutschland\"},{\"@type\":\"ListItem\",\"position\":13,\"url\":\"https://zusammenleben-ukraine.de/de/guide-pregnancy-birth.html\",\"name\":\"Schwangerschaft und Geburt in Deutschland\"},{\"@type\":\"ListItem\",\"position\":14,\"url\":\"https://zusammenleben-ukraine.de/de/guide-mental-health.html\",\"name\":\"Psychische Gesundheit: Wo Sie Unterstützung finden\"},{\"@type\":\"ListItem\",\"position\":15,\"url\":\"https://zusammenleben-ukraine.de/de/guide-university-study.html\",\"name\":\"Studieren an einer deutschen Hochschule\"},{\"@type\":\"ListItem\",\"position\":16,\"url\":\"https://zusammenleben-ukraine.de/de/guide-vocational-training.html\",\"name\":\"Die Berufsausbildung einfach erklärt\"},{\"@type\":\"ListItem\",\"position\":17,\"url\":\"https://zusammenleben-ukraine.de/de/guide-self-employment.html\",\"name\":\"Selbstständig werden in Deutschland\"},{\"@type\":\"ListItem\",\"position\":18,\"url\":\"https://zusammenleben-ukraine.de/de/guide-tax-return.html\",\"name\":\"Steuern in Deutschland: Grundwissen für Beschäftigte\"},{\"@type\":\"ListItem\",\"position\":19,\"url\":\"https://zusammenleben-ukraine.de/de/guide-social-insurance.html\",\"name\":\"Die Sozialversicherung in Deutschland\"},{\"@type\":\"ListItem\",\"position\":20,\"url\":\"https://zusammenleben-ukraine.de/de/guide-house-rules-waste.html\",\"name\":\"Hausordnung, Mülltrennung und gute Nachbarschaft\"},{\"@type\":\"ListItem\",\"position\":21,\"url\":\"https://zusammenleben-ukraine.de/de/guide-public-transport.html\",\"name\":\"Unterwegs: Öffentlicher Nahverkehr in Oberfranken\"},{\"@type\":\"ListItem\",\"position\":22,\"url\":\"https://zusammenleben-ukraine.de/de/guide-saving-money.html\",\"name\":\"Geld sparen im Alltag\"},{\"@type\":\"ListItem\",\"position\":23,\"url\":\"https://zusammenleben-ukraine.de/de/guide-clubs-volunteering.html\",\"name\":\"Vereine und Ehrenamt: Ihren Platz finden\"},{\"@type\":\"ListItem\",\"position\":24,\"url\":\"https://zusammenleben-ukraine.de/de/guide-elderly-care.html\",\"name\":\"Ältere Menschen und Pflege in Deutschland\"},{\"@type\":\"ListItem\",\"position\":25,\"url\":\"https://zusammenleben-ukraine.de/de/guide-disability.html\",\"name\":\"Mit einer Behinderung in Deutschland leben\"},{\"@type\":\"ListItem\",\"position\":26,\"url\":\"https://zusammenleben-ukraine.de/de/guide-legal-help.html\",\"name\":\"Rechtliche Hilfe in Deutschland\"},{\"@type\":\"ListItem\",\"position\":27,\"url\":\"https://zusammenleben-ukraine.de/de/guide-violence-protection.html\",\"name\":\"Schutz vor Gewalt: Wo Sie Hilfe bekommen\"},{\"@type\":\"ListItem\",\"position\":28,\"url\":\"https://zusammenleben-ukraine.de/de/guide-ukrainian-documents.html\",\"name\":\"Ukrainische Dokumente in Deutschland gültig halten\"},{\"@type\":\"ListItem\",\"position\":29,\"url\":\"https://zusammenleben-ukraine.de/de/guide-winter-heating.html\",\"name\":\"Gut durch den deutschen Winter\"},{\"@type\":\"ListItem\",\"position\":30,\"url\":\"https://zusammenleben-ukraine.de/de/guide-long-term-stay.html\",\"name\":\"Eine langfristige Zukunft in Deutschland planen\"}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"}]}]}</script>"
