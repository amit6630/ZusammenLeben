    "guide-school-kita-bavaria.html": {
      "settings": {
        "title": "Schule und Kita für ukrainische Kinder in Bayern anmelden",
        "order": "19",
        "meta_descr": "So melden Sie ein Kind aus der Ukraine in Bayern für Schule oder Kita an: Schulpflicht, Deutschklassen, Unterlagen und realistische Wartezeiten.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-school-kita-bavaria.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-school-kita-bavaria.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-school-kita-bavaria.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-school-kita-bavaria.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-school-kita-bavaria.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Schule und Kita für ukrainische Kinder in Bayern anmelden\" />\n<meta property=\"og:description\" content=\"So melden Sie ein Kind aus der Ukraine in Bayern für Schule oder Kita an: Schulpflicht, Deutschklassen, Unterlagen und realistische Wartezeiten.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-school-kita-bavaria.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Ihr Kind in Bayern für Schule oder Kita anmelden\",\"description\":\"So melden Sie ein Kind aus der Ukraine in Bayern für Schule oder Kita an: Schulpflicht, Deutschklassen, Unterlagen und realistische Wartezeiten.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-school-kita-bavaria.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-school-kita-bavaria.html\",\"wordCount\":890,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Muss mein Kind in Bayern zur Schule gehen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Für schulpflichtige Kinder mit Wohnsitz in Bayern gilt die Schulpflicht, auch für Kinder aus der Ukraine.\"}},{\"@type\":\"Question\",\"name\":\"Gibt es einen Rechtsanspruch auf einen Kita-Platz?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja, ab dem ersten Geburtstag. Weil Plätze knapp sind, melden Sie Ihr Kind früh bei mehreren Kitas an.\"}},{\"@type\":\"Question\",\"name\":\"Ist die Masernimpfung Pflicht?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Für Schule und Kita ist ein Nachweis über den Masernschutz vorgeschrieben.\"}},{\"@type\":\"Question\",\"name\":\"Darf mein Kind weiter ukrainischen Online-Unterricht besuchen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja, zusätzlich. Er ersetzt aber nicht den Besuch einer deutschen Schule, der Pflicht ist.\"}},{\"@type\":\"Question\",\"name\":\"Wer zahlt Ausflüge und Mittagessen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Familien mit geringem Einkommen können das Bildungs- und Teilhabepaket beantragen, das Ausflüge, Mittagessen und Schulbedarf abdeckt.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Ihr Kind in Bayern für Schule oder Kita anmelden\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-school-kita-bavaria.html\"}]}]}</script>"
      },
