              "font-size": "0.9rem",
              "margin-bottom": "8px",
              "color": "#334155"
            },
            ".contact-highlight-box": {
              "background": "linear-gradient(145deg, #ffffff 0%, #f8fafc 100%)",
              "border": "2px solid #2563eb"
            },
            ".services-pills-wrap": {
              "display": "inline-block",
              "background": "#f1f5f9",
              "padding": "10px 20px",
              "border-radius": "30px",
