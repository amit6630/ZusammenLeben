    "guide-elderly-care.html": {
      "settings": {
        "title": "Ältere Menschen und Pflege: Hilfe für Familien in Deutschland",
        "order": "43",
        "meta_descr": "Grundsicherung im Alter, Pflegegrade, Pflege zu Hause, Tagespflege, Pflegeheim und Vorsorgevollmacht: Ratgeber für ältere Ukrainer und Familien.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-elderly-care.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-elderly-care.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-elderly-care.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-elderly-care.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-elderly-care.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Ältere Menschen und Pflege: Hilfe für Familien in Deutschland\" />\n<meta property=\"og:description\" content=\"Grundsicherung im Alter, Pflegegrade, Pflege zu Hause, Tagespflege, Pflegeheim und Vorsorgevollmacht: Ratgeber für ältere Ukrainer und Familien.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-elderly-care.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Ältere Menschen und Pflege in Deutschland\",\"description\":\"Grundsicherung im Alter, Pflegegrade, Pflege zu Hause, Tagespflege, Pflegeheim und Vorsorgevollmacht: Ratgeber für ältere Ukrainer und Familien.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-elderly-care.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-elderly-care.html\",\"wordCount\":888,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Wer zahlt Grundsicherung für Rentner?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Das Sozialamt des Landkreises zahlt Grundsicherung im Alter, nicht das Jobcenter.\"}},{\"@type\":\"Question\",\"name\":\"Wie beantrage ich einen Pflegegrad?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Bei der Pflegekasse Ihrer Krankenkasse. Eine Gutachterin besucht die Person zu Hause und legt den Pflegegrad fest.\"}},{\"@type\":\"Question\",\"name\":\"Können Angehörige für die Pflege Geld bekommen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Die pflegebedürftige Person erhält Pflegegeld, das sie an pflegende Angehörige weitergeben kann.\"}},{\"@type\":\"Question\",\"name\":\"Was ist eine Vorsorgevollmacht?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ein Dokument, das einer Vertrauensperson erlaubt, für jemanden zu entscheiden und zu handeln, der es nicht mehr kann.\"}},{\"@type\":\"Question\",\"name\":\"Wer zahlt das Pflegeheim?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Die Pflegeversicherung zahlt einen Anteil; den Rest zahlt die Bewohnerin oder bei Bedarf das Sozialamt.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Ältere Menschen und Pflege in Deutschland\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-elderly-care.html\"}]}]}</script>"
      },
