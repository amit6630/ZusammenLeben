              "margin-bottom": "12px",
              "font-size": "0.95rem",
              "color": "#475569",
              "padding-left": "16px",
              "position": "relative"
            },
            ".link-card li::before": {
              "content": "\"•\"",
              "color": "#cbd5e1",
              "font-weight": "bold",
              "position": "absolute",
              "left": "0"
            },
            ".link-card a": {
              "color": "#0f172a",
              "text-decoration": "none",
              "font-weight": "600",
              "transition": "color 0.2s ease"
            },
            ".link-card a:hover": {
