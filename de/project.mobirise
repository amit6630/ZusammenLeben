              "color": "#fff",
              "border-color": "#dc2626"
            },
            ".pill-highlight": {
              "color": "#047857",
              "border-color": "#6ee7b7",
              "background": "#ecfdf5"
            },
            ".pill-highlight:hover": {
              "background": "#059669",
              "color": "#fff",
              "border-color": "#059669"
            },
            ".portal-alert": {
              "display": "flex",
              "gap": "20px",
              "background": "#fffbeb",
