              "padding": "0 24px 24px 24px",
              "font-size": "1rem",
              "color": "#334155",
              "line-height": "1.6",
              "background-color": "#ffffff"
            },
            ".custom-accordion .accordion-button:not(.collapsed) + .accordion-collapse .accordion-body": {
              "background-color": "#eff6ff",
              "padding-top": "8px"
            },
            ".official-links-section": {
