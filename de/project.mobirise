    "guide-integration-course.html": {
      "settings": {
        "title": "Integrationskurs: So nehmen Menschen aus der Ukraine teil",
        "order": "22",
        "meta_descr": "Was der Integrationskurs umfasst, wie Menschen aus der Ukraine einen Platz bekommen, was er kostet und wie die B1-Abschlussprüfung abläuft.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-integration-course.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-integration-course.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-integration-course.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-integration-course.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-integration-course.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Integrationskurs: So nehmen Menschen aus der Ukraine teil\" />\n<meta property=\"og:description\" content=\"Was der Integrationskurs umfasst, wie Menschen aus der Ukraine einen Platz bekommen, was er kostet und wie die B1-Abschlussprüfung abläuft.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-integration-course.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Der Integrationskurs: Ihr schnellster Weg zur deutschen Sprache\",\"description\":\"Was der Integrationskurs umfasst, wie Menschen aus der Ukraine einen Platz bekommen, was er kostet und wie die B1-Abschlussprüfung abläuft.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-integration-course.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-integration-course.html\",\"wordCount\":943,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Ist der Integrationskurs kostenlos?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Für Menschen im Leistungsbezug beim Jobcenter ja. Andere zahlen einen ermäßigten Beitrag oder beantragen beim BAMF eine Befreiung.\"}},{\"@type\":\"Question\",\"name\":\"Welches Niveau erreiche ich?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ziel ist das Niveau B1. Die Abschlussprüfung zeigt, ob Sie A2 oder B1 erreicht haben.\"}},{\"@type\":\"Question\",\"name\":\"Kann ich mit kleinen Kindern teilnehmen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Es gibt Elternkurse mit Kinderbetreuung. Fragen Sie beim Kursträger nach.\"}},{\"@type\":\"Question\",\"name\":\"Kann ich arbeiten und den Kurs besuchen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Viele Träger bieten Abend-, Teilzeit- oder Onlineformate an, die sich mit einer Arbeit verbinden lassen.\"}},{\"@type\":\"Question\",\"name\":\"Was kommt nach B1?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Berufssprachkurse bis B2 oder C1, ebenfalls vom BAMF gefördert. Die Zulassung erhalten Sie über Jobcenter oder Agentur für Arbeit.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Der Integrationskurs: Ihr schnellster Weg zur deutschen Sprache\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-integration-course.html\"}]}]}</script>"
      },
