    "guide-ukrainian-documents.html": {
      "settings": {
        "title": "Ukrainische Dokumente in Deutschland: Pass und Apostille",
        "order": "47",
        "meta_descr": "Ukrainischen Pass im Ausland verlängern, Konsularregistrierung, in Deutschland geborenes Kind, Apostille, beeidigte Übersetzung und verlorene Papiere.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-ukrainian-documents.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-ukrainian-documents.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-ukrainian-documents.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-ukrainian-documents.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-ukrainian-documents.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Ukrainische Dokumente in Deutschland: Pass und Apostille\" />\n<meta property=\"og:description\" content=\"Ukrainischen Pass im Ausland verlängern, Konsularregistrierung, in Deutschland geborenes Kind, Apostille, beeidigte Übersetzung und verlorene Papiere.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-ukrainian-documents.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Ukrainische Dokumente in Deutschland gültig halten\",\"description\":\"Ukrainischen Pass im Ausland verlängern, Konsularregistrierung, in Deutschland geborenes Kind, Apostille, beeidigte Übersetzung und verlorene Papiere.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-ukrainian-documents.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-ukrainian-documents.html\",\"wordCount\":959,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Wo verlängere ich meinen ukrainischen Pass in Bayern?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Beim ukrainischen Generalkonsulat in München oder in einem Passservicezentrum im Ausland, meist mit Online-Termin.\"}},{\"@type\":\"Question\",\"name\":\"Brauche ich eine Apostille für ukrainische Urkunden?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oft ja. Standesämter verlangen meist Apostille und beeidigte Übersetzung; fragen Sie vorher nach.\"}},{\"@type\":\"Question\",\"name\":\"Werden in der Ukraine gemachte Übersetzungen anerkannt?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oft nicht. Deutsche Ämter verlangen meist einen in Deutschland beeidigten Übersetzer.\"}},{\"@type\":\"Question\",\"name\":\"Gilt Diia in Deutschland als Ausweis?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nein. Deutsche Behörden erkennen Diia-Dokumente nicht als Ausweis an.\"}},{\"@type\":\"Question\",\"name\":\"Was tue ich, wenn mein Pass gestohlen wird?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Polizei informieren, Ausländerbehörde benachrichtigen und beim Konsulat einen neuen Pass beantragen.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Ukrainische Dokumente in Deutschland gültig halten\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-ukrainian-documents.html\"}]}]}</script>"
      },
