                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            "@media (max-width: 767px)": {
              ".services-grid, .team-grid, .transparency-grid, .pillars-grid, .three-column-grid, .grid-3, .grid-2, .faq-grid, .survival-grid, .portal-grid-2, .city-directory-grid, .details-cards-stack, .two-column-grid, .levels-grid, .cert-grid, .benefits-grid, .links-grid, .timeline-wrapper": {
                "display": "flex !important",
                "flex-wrap": "nowrap !important",
                "flex-direction": "row !important",
                "grid-template-columns": "none !important",
                "gap": "12px !important",
                "overflow-x": "auto",
                "overscroll-behavior-x": "contain",
                "scroll-snap-type": "x mandatory",
                "padding": "4px 2px 14px !important",
                "scrollbar-width": "none"
              },
              ".services-grid::-webkit-scrollbar, .team-grid::-webkit-scrollbar, .transparency-grid::-webkit-scrollbar, .pillars-grid::-webkit-scrollbar, .three-column-grid::-webkit-scrollbar, .grid-3::-webkit-scrollbar, .grid-2::-webkit-scrollbar, .faq-grid::-webkit-scrollbar, .survival-grid::-webkit-scrollbar, .portal-grid-2::-webkit-scrollbar, .city-directory-grid::-webkit-scrollbar, .details-cards-stack::-webkit-scrollbar, .two-column-grid::-webkit-scrollbar, .levels-grid::-webkit-scrollbar, .cert-grid::-webkit-scrollbar, .benefits-grid::-webkit-scrollbar, .links-grid::-webkit-scrollbar, .timeline-wrapper::-webkit-scrollbar": {
                "display": "none"
              },
              ".services-grid > *, .team-grid > *, .transparency-grid > *, .pillars-grid > *, .three-column-grid > *, .grid-3 > *, .grid-2 > *, .faq-grid > *, .survival-grid > *, .portal-grid-2 > *, .city-directory-grid > *, .details-cards-stack > *, .two-column-grid > *, .levels-grid > *, .cert-grid > *, .benefits-grid > *, .links-grid > *, .timeline-wrapper > *": {
                "flex": "0 0 84% !important",
                "max-width": "84% !important",
                "min-width": "0",
                "margin": "0 !important",
                "scroll-snap-align": "start"
              },
              ".timeline-wrapper::before": {
                "display": "none !important"
              },
              ".metrics-section, .services-section, .process-section, .region-section, .team-section, .transparency-section, .cta-section": {
                "padding-top": "44px !important",
                "padding-bottom": "44px !important"
              },
              ".metrics-grid": {
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr) !important",
                "gap": "10px !important"
              },
              ".word-grid": {
                "max-height": "62vh",
                "overflow-y": "auto",
                "overscroll-behavior": "contain",
                "padding-right": "4px"
              },
              ".metrics-grid > *": {
                "min-width": "0",
                "padding": "18px 10px !important"
              },
              ".metrics-grid .metric-value": {
                "font-size": "2rem !important"
              },
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_name": "features05",
          "_sourceTheme": "tradem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"dictionary-section\" id=\"essential-german-dictionary\">\n    <div class=\"dict-container\">\n        \n        <!-- Header -->\n        <header class=\"dict-header\">\n            <span class=\"header-tag\">Offizielles Glossar</span>\n            <h1 class=\"header-title\">Wesentliches deutsches Wörterbuch für Neuzugänge</h1>\n            <p class=\"header-lead\">\n                Die wichtigsten Begriffe, denen Sie in Deutschland in den Bereichen Bürokratie, Wohnen, Finanzen und im täglichen Leben begegnen werden.\n            </p>\n        </header>\n\n        <!-- Quick Survival Guide (Notes and Emergency) -->\n        <div class=\"survival-grid\">\n            \n            <!-- Golden Rules -->\n            <div class=\"survival-card\">\n                <h3 class=\"card-header-title danger\">\n                    <span class=\"dict-svg-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg>\n                    </span>\n                    Die goldene Regel\n                </h3>\n                <p style=\"font-size: 0.925rem; color: #334155; margin-top: 0.25rem; line-height: 1.5;\">\n                    Jedes offizielle Schreiben, das das Wort <strong>Frist</strong> enthält, erfordert eine zwingende Reaktion vor dem angegebenen Datum. Es zu ignorieren wird rechtlich als negative Antwort oder Ablehnung gewertet.\n                </p>\n                <hr style=\"border: 0; border-top: 1px solid #e2e8f0; margin: 1rem 0;\">\n                <h4 class=\"small-title\">Die 5 wichtigsten Wörter</h4>\n                <ul class=\"critical-words-list\">\n                    <li><strong>Termin</strong> - Appointment</li>\n                    <li><strong>Frist</strong> - Deadline</li>\n                    <li><strong>Bescheid</strong> - Official Decision</li>\n                    <li><strong>Antrag</strong> - Application</li>\n                    <li><strong>Nachweis</strong> - Proof / Evidence</li>\n                </ul>\n            </div>\n\n            <!-- Emergency Phrases -->\n            <div class=\"survival-card\">\n                <h3 class=\"card-header-title primary\">\n                    <span class=\"dict-svg-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path><line x1=\"12\" y1=\"2\" x2=\"12\" y2=\"6\"></line><line x1=\"12\" y1=\"10\" x2=\"12.01\" y2=\"10\"></line></svg>\n                    </span>\n                    Notfall-Phrasen\n                </h3>\n                <p style=\"font-size: 0.85rem; color: #64748b; margin-top: -0.5rem; margin-bottom: 0.75rem;\">Speichern Sie diese auf Ihrem Handy oder halten Sie sie griffbereit.</p>\n                <div class=\"phrase-list\">\n                    <div class=\"phrase-item\">\n                        <span class=\"de-text\">Ich spreche kein Deutsch</span>\n                        <span class=\"en-text\">Ich spreche kein Deutsch</span>\n                    </div>\n                    <div class=\"phrase-item\">\n                        <span class=\"de-text\">Sprechen Sie Englisch?</span>\n                        <span class=\"en-text\">Sprechen Sie Englisch?</span>\n                    </div>\n                    <div class=\"phrase-item\">\n                        <span class=\"de-text\">Ich brauche einen Dolmetscher</span>\n                        <span class=\"en-text\">Ich brauche einen Dolmetscher</span>\n                    </div>\n                    <div class=\"phrase-item\">\n                        <span class=\"de-text\">Ich brauche Hilfe</span>\n                        <span class=\"en-text\">Ich brauche Hilfe</span>\n                    </div>\n                    <div class=\"phrase-item\">\n                        <span class=\"de-text\">Ich verstehe nicht</span>\n                        <span class=\"en-text\">Ich verstehe nicht</span>\n                    </div>\n                    <div class=\"phrase-item\">\n                        <span class=\"de-text\">Können Sie das bitte wiederholen?</span>\n                        <span class=\"en-text\">Können Sie das bitte wiederholen?</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Pronunciation and Language Tips -->\n            <div class=\"survival-card\">\n                <h3 class=\"card-header-title success\">\n                    <span class=\"dict-svg-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path><line x1=\"9\" y1=\"10\" x2=\"15\" y2=\"10\"></line></svg>\n                    </span>\n                    Sprachtipps\n                </h3>\n                <ul class=\"tips-list\">\n                    <li><strong>ß</strong> wird wie ein scharfes „s“ ausgesprochen.</li>\n                    <li><strong>ei</strong> wird wie „ai“ ausgesprochen.</li>\n                    <li><strong>ie</strong> wird als langes „i“ ausgesprochen.</li>\n                    <li><strong>eu</strong> wird wie „oi“ ausgesprochen.</li>\n                    <li><strong>v</strong> wird normalerweise als „f“ ausgesprochen.</li>\n                    <li><strong>w</strong> wird als „w“ (wie englisches „v“) ausgesprochen.</li>\n                </ul>\n                <div class=\"alert-tip\">\n                    <strong>Zusammengesetzte Wörter:</strong> Das Deutsche verbindet Wörter zu langen Einzelbegriffen. Wenn ein Wort unmöglich erscheint, versuchen Sie es aufzuteilen: <br><em>Wohnungsgeberbestätigung</em> = Wohnung + Geber + Bestätigung.\n                </div>\n            </div>\n        </div>\n\n        <!-- Category 1 -->\n        <div class=\"category-block\">\n            <h2 class=\"category-title\">\n                <span class=\"cat-icon dict-svg-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"3\" y1=\"22\" x2=\"21\" y2=\"22\"></line><line x1=\"6\" y1=\"18\" x2=\"6\" y2=\"11\"></line><line x1=\"10\" y1=\"18\" x2=\"10\" y2=\"11\"></line><line x1=\"14\" y1=\"18\" x2=\"14\" y2=\"11\"></line><line x1=\"18\" y1=\"18\" x2=\"18\" y2=\"11\"></line><polygon points=\"12 2 20 7 4 7 12 2\"></polygon></svg>\n                </span> \n                1. Behörden, Bürokratie und Dokumente\n            </h2>\n            <div class=\"word-grid\">\n                <div class=\"word-item\"><div class=\"word-de\">Anmeldung</div><div class=\"word-en\">Address registration</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Abmeldung</div><div class=\"word-en\">Address deregistration (when leaving)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Ummeldung</div><div class=\"word-en\">Address update (when moving)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Einwohnermeldeamt</div><div class=\"word-en\">Residents' registration office</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Bürgerbüro</div><div class=\"word-en\">Citizen service office</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Rathaus</div><div class=\"word-en\">City hall / Town hall</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Landratsamt</div><div class=\"word-en\">District administration office</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Ausländerbehörde</div><div class=\"word-en\">Immigration office / Foreigners' authority</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Jobcenter</div><div class=\"word-en\">Job center (social and housing support)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Agentur für Arbeit</div><div class=\"word-en\">Employment agency</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Jugendamt</div><div class=\"word-en\">Youth welfare office</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Sozialamt</div><div class=\"word-en\">Social welfare office</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Finanzamt</div><div class=\"word-en\">Tax office</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Behörde</div><div class=\"word-en\">Authority / Government agency</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Amt</div><div class=\"word-en\">Official department / Office</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Termin</div><div class=\"word-en\">Appointment</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Terminvereinbarung</div><div class=\"word-en\">Making an appointment</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Wartezeit</div><div class=\"word-en\">Waiting time</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Antrag</div><div class=\"word-en\">Official application</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Antrag stellen</div><div class=\"word-en\">To submit an application</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Formular</div><div class=\"word-en\">Form</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">ausfüllen</div><div class=\"word-en\">To fill out</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">unterschreiben</div><div class=\"word-en\">To sign</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Unterschrift</div><div class=\"word-en\">Signature</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Bescheid</div><div class=\"word-en\">Official written decision</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Bewilligung</div><div class=\"word-en\">Approval / Grant</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Ablehnung</div><div class=\"word-en\">Rejection</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Widerspruch</div><div class=\"word-en\">Appeal / Objection</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Frist</div><div class=\"word-en\">Deadline</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Nachweis</div><div class=\"word-en\">Proof / Evidence</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Bescheinigung</div><div class=\"word-en\">Official certificate</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Meldebescheinigung</div><div class=\"word-en\">Address registration certificate</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Aufenthaltstitel</div><div class=\"word-en\">Residence permit document</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Aufenthaltserlaubnis</div><div class=\"word-en\">Residence permit status</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Reisepass</div><div class=\"word-en\">Passport</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Personalausweis</div><div class=\"word-en\">Identity card</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Geburtsurkunde</div><div class=\"word-en\">Birth certificate</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Heiratsurkunde</div><div class=\"word-en\">Marriage certificate</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Steueridentifikationsnummer</div><div class=\"word-en\">Tax identification number</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Sozialversicherungsnummer</div><div class=\"word-en\">Social security number</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Übersetzung</div><div class=\"word-en\">Translation</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">beglaubigte Übersetzung</div><div class=\"word-en\">Certified translation</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Dolmetscher</div><div class=\"word-en\">Interpreter</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Vollmacht</div><div class=\"word-en\">Power of attorney</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Kopie</div><div class=\"word-en\">Copy</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Original</div><div class=\"word-en\">Original document</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Einschreiben</div><div class=\"word-en\">Registered mail</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Briefkasten</div><div class=\"word-en\">Mailbox</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Sachbearbeiter</div><div class=\"word-en\">Case worker / Clerk</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Aktenzeichen</div><div class=\"word-en\">File reference number</div></div>\n            </div>\n        </div>\n\n        <!-- Category 2 -->\n        <div class=\"category-block\">\n<h2 class=\"category-title\">\n                <span class=\"cat-icon dict-svg-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg>\n                </span>\n                2. Wohnen, Miete und Nebenkosten\n            </h2>\n            <div class=\"word-grid\">\n                <div class=\"word-item\"><div class=\"word-de\">Wohnung</div><div class=\"word-en\">Apartment</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Haus</div><div class=\"word-en\">House</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Zimmer</div><div class=\"word-en\">Room</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Wohnzimmer</div><div class=\"word-en\">Living room</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Schlafzimmer</div><div class=\"word-en\">Bedroom</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Küche</div><div class=\"word-en\">Kitchen</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Badezimmer</div><div class=\"word-en\">Bathroom</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Balkon</div><div class=\"word-en\">Balcony</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Keller</div><div class=\"word-en\">Basement / Cellar</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Dachgeschoss</div><div class=\"word-en\">Attic floor / Top floor</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Erdgeschoss</div><div class=\"word-en\">Ground floor</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Stockwerk</div><div class=\"word-en\">Floor / Level</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Aufzug</div><div class=\"word-en\">Elevator</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Quadratmeter</div><div class=\"word-en\">Square meters</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Vermieter</div><div class=\"word-en\">Landlord</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Mieter</div><div class=\"word-en\">Tenant</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Mietvertrag</div><div class=\"word-en\">Lease agreement / Rental contract</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Miete</div><div class=\"word-en\">Rent</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Kaltmiete</div><div class=\"word-en\">Basic rent (excluding utilities)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Warmmiete</div><div class=\"word-en\">Total rent (including utilities)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Nebenkosten</div><div class=\"word-en\">Utility costs / Additional charges</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Betriebskosten</div><div class=\"word-en\">Building operating costs</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Kaution</div><div class=\"word-en\">Security deposit</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Wohnungsgeberbestätigung</div><div class=\"word-en\">Landlord's confirmation of residence</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Übergabeprotokoll</div><div class=\"word-en\">Apartment handover protocol</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Wohnungsbesichtigung</div><div class=\"word-en\">Apartment viewing</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Kündigung</div><div class=\"word-en\">Notice of termination / Cancellation</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Kündigungsfrist</div><div class=\"word-en\">Notice period</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Umzug</div><div class=\"word-en\">Moving / Relocation</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">möbliert</div><div class=\"word-en\">Furnished</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">unmöbliert</div><div class=\"word-en\">Unfurnished</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Einbauküche</div><div class=\"word-en\">Fitted kitchen</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Heizung</div><div class=\"word-en\">Heating</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Fernwärme</div><div class=\"word-en\">District heating</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Strom</div><div class=\"word-en\">Electricity</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Stromanbieter</div><div class=\"word-en\">Electricity provider</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Gas</div><div class=\"word-en\">Gas</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Wasser</div><div class=\"word-en\">Water</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Zähler</div><div class=\"word-en\">Meter</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Zählerstand</div><div class=\"word-en\">Meter reading</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Abrechnung</div><div class=\"word-en\">Annual statement / Billing</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Nachzahlung</div><div class=\"word-en\">Additional payment due</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Rückzahlung</div><div class=\"word-en\">Refund</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Internetanschluss</div><div class=\"word-en\">Internet connection</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Rundfunkbeitrag</div><div class=\"word-en\">Broadcasting fee (mandatory)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Hausordnung</div><div class=\"word-en\">House rules</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Ruhezeit</div><div class=\"word-en\">Quiet hours</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Mülltrennung</div><div class=\"word-en\">Waste separation</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Nachbar</div><div class=\"word-en\">Neighbor</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Hausmeister</div><div class=\"word-en\">Caretaker / Janitor</div></div>\n            </div>\n        </div>\n\n        <!-- Category 3 -->\n<div class=\"category-block\">\n            <h2 class=\"category-title\">\n                <span class=\"cat-icon dict-svg-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect><path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path></svg>\n                </span>\n                3. Geld, Arbeit, Banken und Versicherungen\n            </h2>\n            <div class=\"word-grid\">\n                <div class=\"word-item\"><div class=\"word-de\">Bank</div><div class=\"word-en\">Bank</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Girokonto</div><div class=\"word-en\">Checking account / Current account</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Kontonummer</div><div class=\"word-en\">Account number</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">IBAN</div><div class=\"word-en\">International Bank Account Number</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Bankkarte</div><div class=\"word-en\">Bank card</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">EC-Karte / Girocard</div><div class=\"word-en\">German debit card</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Überweisung</div><div class=\"word-en\">Bank transfer</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Dauerauftrag</div><div class=\"word-en\">Standing order</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Lastschrift</div><div class=\"word-en\">Direct debit authorization</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Kontoauszug</div><div class=\"word-en\">Bank statement</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Bargeld</div><div class=\"word-en\">Cash</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Rechnung</div><div class=\"word-en\">Invoice / Bill</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Quittung</div><div class=\"word-en\">Receipt</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Gebühr</div><div class=\"word-en\">Fee / Charge</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Bürgergeld</div><div class=\"word-en\">Basic income allowance</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Regelsatz</div><div class=\"word-en\">Standard allowance rate</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Leistung</div><div class=\"word-en\">Benefit / State payment</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Kindergeld</div><div class=\"word-en\">Child benefit</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Wohngeld</div><div class=\"word-en\">Housing allowance</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Einkommen</div><div class=\"word-en\">Income</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Vermögen</div><div class=\"word-en\">Assets / Wealth</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Mitwirkungspflicht</div><div class=\"word-en\">Duty to cooperate with authorities</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Veränderungsmitteilung</div><div class=\"word-en\">Notification of change in circumstances</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Arbeit</div><div class=\"word-en\">Work / Employment</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Arbeitsvertrag</div><div class=\"word-en\">Employment contract</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Arbeitgeber</div><div class=\"word-en\">Employer</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Arbeitnehmer</div><div class=\"word-en\">Employee</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Bewerbung</div><div class=\"word-en\">Job application</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Lebenslauf</div><div class=\"word-en\">Curriculum Vitae (CV) / Resume</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Vorstellungsgespräch</div><div class=\"word-en\">Job interview</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Minijob</div><div class=\"word-en\">Marginal part-time job</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Vollzeit</div><div class=\"word-en\">Full-time</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Teilzeit</div><div class=\"word-en\">Part-time</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Gehalt</div><div class=\"word-en\">Salary</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Lohn</div><div class=\"word-en\">Wage</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">brutto</div><div class=\"word-en\">Gross (before taxes)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">netto</div><div class=\"word-en\">Net (after taxes)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Steuer</div><div class=\"word-en\">Tax</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Steuerklasse</div><div class=\"word-en\">Tax class / bracket</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Anerkennung</div><div class=\"word-en\">Recognition (of qualifications)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Zeugnis</div><div class=\"word-en\">Certificate / Diploma</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Praktikum</div><div class=\"word-en\">Internship</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Ausbildung</div><div class=\"word-en\">Vocational training</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Krankenkasse</div><div class=\"word-en\">Health insurance fund</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Krankenversicherung</div><div class=\"word-en\">Health insurance</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Versicherungskarte</div><div class=\"word-en\">Health insurance card</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Haftpflichtversicherung</div><div class=\"word-en\">Third-party liability insurance</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Beitrag</div><div class=\"word-en\">Contribution / Premium</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Vertrag</div><div class=\"word-en\">Contract</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Mahnung</div><div class=\"word-en\">Payment reminder / Warning</div></div>\n            </div>\n        </div>\n\n        <!-- Category 4 -->\n<!-- Category 4 -->\n        <div class=\"category-block\">\n            <h2 class=\"category-title\">\n                <span class=\"cat-icon dict-svg-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"></path></svg>\n                </span>\n                4. Gesundheit, Bildung, Notfälle und Alltag\n            </h2>\n            <div class=\"word-grid\">\n                <div class=\"word-item\"><div class=\"word-de\">Notruf</div><div class=\"word-en\">Emergency call</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Notaufnahme</div><div class=\"word-en\">Emergency room</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Krankenwagen</div><div class=\"word-en\">Ambulance</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Feuerwehr</div><div class=\"word-en\">Fire department</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Polizei</div><div class=\"word-en\">Police</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Notfall</div><div class=\"word-en\">Emergency</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Hilfe!</div><div class=\"word-en\">Help!</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Gefahr</div><div class=\"word-en\">Danger</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Unfall</div><div class=\"word-en\">Accident</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Arzt / Ärztin</div><div class=\"word-en\">Doctor (male / female)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Hausarzt</div><div class=\"word-en\">General practitioner (GP)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Kinderarzt</div><div class=\"word-en\">Pediatrician</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Facharzt</div><div class=\"word-en\">Specialist doctor</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Überweisung (Medical)</div><div class=\"word-en\">Referral to a specialist</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Praxis</div><div class=\"word-en\">Doctor's office / Clinic</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Krankenhaus / Klinikum</div><div class=\"word-en\">Hospital</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Apotheke</div><div class=\"word-en\">Pharmacy</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Notdienstapotheke</div><div class=\"word-en\">Emergency/On-call pharmacy</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Rezept</div><div class=\"word-en\">Prescription</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Medikament</div><div class=\"word-en\">Medication</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Impfung</div><div class=\"word-en\">Vaccination</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Impfpass</div><div class=\"word-en\">Vaccination record booklet</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Schmerzen</div><div class=\"word-en\">Pain</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Fieber</div><div class=\"word-en\">Fever</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">krank</div><div class=\"word-en\">Sick / Ill</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Krankschreibung</div><div class=\"word-en\">Sick leave certificate</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Schwangerschaft</div><div class=\"word-en\">Pregnancy</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Zahnarzt</div><div class=\"word-en\">Dentist</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Schule</div><div class=\"word-en\">School</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Grundschule</div><div class=\"word-en\">Primary school</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Kindergarten</div><div class=\"word-en\">Kindergarten</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Kita</div><div class=\"word-en\">Daycare center (abbreviation)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Schulanmeldung</div><div class=\"word-en\">School enrollment</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Klasse</div><div class=\"word-en\">Class / Grade</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Lehrer / Lehrerin</div><div class=\"word-en\">Teacher (male / female)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Elternabend</div><div class=\"word-en\">Parents' evening / meeting</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Hausaufgaben</div><div class=\"word-en\">Homework</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Ferien</div><div class=\"word-en\">School holidays</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Willkommensklasse</div><div class=\"word-en\">Welcome class (for new students)</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Sprachkurs</div><div class=\"word-en\">Language course</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Integrationskurs</div><div class=\"word-en\">Integration course</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Volkshochschule (VHS)</div><div class=\"word-en\">Adult education center</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Supermarkt</div><div class=\"word-en\">Supermarket</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Öffnungszeiten</div><div class=\"word-en\">Opening hours</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">geschlossen</div><div class=\"word-en\">Closed</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Feiertag</div><div class=\"word-en\">Public holiday</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Bahnhof</div><div class=\"word-en\">Train station</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Fahrkarte</div><div class=\"word-en\">Ticket</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Fahrplan</div><div class=\"word-en\">Timetable / Schedule</div></div>\n                <div class=\"word-item\"><div class=\"word-de\">Führerschein</div><div class=\"word-en\">Driver's license</div></div>\n            </div>\n        </div>\n\n<!-- Disclaimer -->\n        <div class=\"dict-disclaimer\">\n            <p style=\"font-size: 0.85rem; color: #64748b; margin: 0; line-height: 1.5;\">\n                <strong>Haftungsausschluss:</strong> Dieses Glossar dient nur zu allgemeinen Informationszwecken, um Neuzugängen bei der Orientierung im Alltagswortschatz zu helfen. Offizielle Verfahren und rechtlich bindende Dokumente sollten stets mit zugelassenen Beratern oder den jeweiligen Behörden abgeklärt werden.\n            </p>\n        </div>\n\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "features05-27",
          "_isUserblock": true,
          "_cid": "vqj6LMRbZq",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            },
            "a[href*=\"thebwas.com\"]": {
              "text-decoration": "underline",
              "text-underline-offset": "3px"
            },
            ".soc-item a": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-width": "44px",
              "min-height": "44px"
            },
            ".item-wrap a": {
              "word-break": "normal !important",
              "overflow-wrap": "normal !important",
              "hyphens": "auto",
              "-webkit-hyphens": "auto"
            },
            "@media (max-width: 767px)": {
              ".lists-wrapper": {
                "display": "grid !important",
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr)",
                "column-gap": "16px"
              },
              ".lists-wrapper .list-wrap": {
                "width": "auto !important",
                "max-width": "none !important",
                "margin": "0 !important"
              },
              ".lists-wrapper .item-wrap a": {
                "overflow-wrap": "break-word !important"
              }
            }
          },
          "_name": "footer01",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 scalem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"50\" max=\"400\" step=\"10\" value=\"150\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Lists\" name=\"showLists\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"list\" min=\"1\" max=\"5\" step=\"1\" value=\"4\" condition=\"showLists\">\n        <input type=\"color\" title=\"List Active Color\" value=\"#ffffff\" name=\"activeList\" condition=\"showLists\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Social Active Color\" value=\"#FF5753\" name=\"active\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#635d60\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#0c2c68\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#292325\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            \n            <!-- עמודת טקסט וכותרת ראשית -->\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showTitle || showText || showButtons || showLogo\">\n                <div class=\"content-wrapper\">\n                    <!-- תוספת המקום ללוגו -->\n                    <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"ZusammenLeben\" width=\"171\" height=\"171\">\n                        </a>\n                    </div>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>\n                        ZUSAMMENLEBEN\n                    </b></h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                        Unterstützung bei Integration, Wohnen und Gemeinschaft für Neuzugezogene und Einheimische in der Region.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-phone mbr-iconfont mbr-iconfont-btn\"></span>\n                            Kontaktieren Sie uns\n                        </a></div>\n                </div>\n            </div>\n\n            <!-- עמודות הקישורים -->\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLists\">\n                <div class=\"lists-wrapper\">\n                    <div class=\"list-wrap\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Startseite</a></li>\n                            <li class=\"item-wrap\"><a href=\"family-stories.html\" class=\"text-white\">Familiengeschichten</a></li>\n                            <li class=\"item-wrap\"><a href=\"services.html\" class=\"text-white\">Leistungen</a></li>\n                            <li class=\"item-wrap\"><a href=\"request-assistance.html\" class=\"text-white\">Hilfe anfordern</a></li>\n                            <li class=\"item-wrap\"><a href=\"community.html\" class=\"text-white\">Gemeinschaft</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"living-in-germany.html\" class=\"text-white\">Leben in Deutschland</a></li>\n                            <li class=\"item-wrap\"><a href=\"glossary.html\" class=\"text-white\">Glossar</a></li>\n                            <li class=\"item-wrap\"><a href=\"learning-german.html\" class=\"text-white\">Deutsch lernen</a></li>\n                            <li class=\"item-wrap\"><a href=\"refugee-rights.html\" class=\"text-white\">Flüchtlingsrechte</a></li>\n                            <li class=\"item-wrap\"><a href=\"guides.html\" class=\"text-white\">Ratgeber</a></li>\n                            <li class=\"item-wrap\"><a href=\"anna-shishoili.html\" class=\"text-white\">Anna Cheishvili</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 2\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"how-to-help.html\" class=\"text-white\">Wie Sie helfen können</a></li>\n                            <li class=\"item-wrap\"><a href=\"social-activity.html\" class=\"text-white\">Soziale Aktivitäten</a></li>\n                            <li class=\"item-wrap\"><a href=\"faq.html\" class=\"text-white\">Häufige Fragen (FAQ)</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Einsatzgebiete</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 3\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"emergency.html\" class=\"text-white\">Notfall</a></li>\n                            <li class=\"item-wrap\"><a href=\"Contact.html\" class=\"text-white\">Kontakt</a></li>\n                            <li class=\"item-wrap\"><a href=\"https://wa.me/380637004615\" class=\"text-white\" target=\"_blank\" rel=\"noopener\">WhatsApp-Support</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Standort</a></li>\n                            <li class=\"item-wrap\"><a href=\"impressum.html\" class=\"text-white\">Impressum</a></li>\n                            <li class=\"item-wrap\"><a href=\"privacy.html\" class=\"text-white\">Datenschutz</a></li>\n                            <li class=\"item-wrap\"><a href=\"usingtheweb.html\" class=\"text-white\">Nutzungsbedingungen</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 4\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Datenschutzerklärung</a></li>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Nutzungsbedingungen</a></li>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Impressum</a></li>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Offizielle Website</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- אזור זכויות יוצרים ורשתות חברתיות -->\n            <div class=\"col-12\" mbr-if=\"showSocial || showCopy\">\n                <div class=\"copy-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://wa.me/380637004615\" target=\"_blank\" rel=\"noopener\" aria-label=\"WhatsApp\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-whatsapp\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"mailto:zusammenleben.de@gmail.com\" aria-label=\"E-Mail\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy, .social-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\">\n                        © Urheberrecht 2026 Zusammenleben - Alle Rechte vorbehalten · Website von <a href=\"https://thebwas.com/\" class=\"text-white\">Amit Shechter</a>\n                    </p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "footer01-2b",
          "_isUserblock": true,
          "_cid": "vqpoIpWKp1",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
