    "guide-tax-return.html": {
      "settings": {
        "title": "Steuern in Deutschland: Steuer-ID, Steuerklassen, Erklärung",
        "order": "37",
        "meta_descr": "Steuer-ID, Steuerklassen, Kirchensteuer, wann die Steuererklärung Pflicht ist, was absetzbar ist und wie sie kostenlos mit ELSTER geht: Steuern für Ukrainer.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-tax-return.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-tax-return.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-tax-return.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-tax-return.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-tax-return.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Steuern in Deutschland: Steuer-ID, Steuerklassen, Erklärung\" />\n<meta property=\"og:description\" content=\"Steuer-ID, Steuerklassen, Kirchensteuer, wann die Steuererklärung Pflicht ist, was absetzbar ist und wie sie kostenlos mit ELSTER geht: Steuern für Ukrainer.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-tax-return.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Steuern in Deutschland: Grundwissen für Beschäftigte\",\"description\":\"Steuer-ID, Steuerklassen, Kirchensteuer, wann die Steuererklärung Pflicht ist, was absetzbar ist und wie sie kostenlos mit ELSTER geht: Steuern für Ukrainer.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-tax-return.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-tax-return.html\",\"wordCount\":938,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Muss ich eine Steuererklärung machen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oft nicht, in manchen Fällen aber schon, etwa bei zwei Jobs oder Steuerklassen III/V.\"}},{\"@type\":\"Question\",\"name\":\"Lohnt sich eine freiwillige Erklärung?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oft ja. Viele Beschäftigte bekommen Geld zurück, besonders nach einem Jobstart im Laufe des Jahres.\"}},{\"@type\":\"Question\",\"name\":\"Wie weit rückwirkend geht das?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Eine freiwillige Erklärung ist bis zu vier Jahre rückwirkend möglich.\"}},{\"@type\":\"Question\",\"name\":\"Was ist Kirchensteuer?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Eine Steuer für Mitglieder der katholischen und evangelischen Kirche, die mit der Lohnsteuer abgezogen wird. Sie hängt von der bei der Anmeldung angegebenen Religion ab.\"}},{\"@type\":\"Question\",\"name\":\"Ist ELSTER kostenlos?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. ELSTER ist das kostenlose offizielle Onlineportal der Steuerverwaltung.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Steuern in Deutschland: Grundwissen für Beschäftigte\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-tax-return.html\"}]}]}</script>"
      },
