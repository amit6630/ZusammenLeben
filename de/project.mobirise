            },
            ".cta-statement": {
              "font-weight": "700",
              "color": "#0f172a",
              "margin-bottom": "28px",
              "font-size": "1.05rem"
            },
            ".guide-executive-section .mbr-section-btn": {
              "display": "flex",
              "gap": "12px",
              "flex-wrap": "wrap",
              "margin": "0",
