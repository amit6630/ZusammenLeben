    "guide-social-insurance.html": {
      "settings": {
        "title": "Sozialversicherung in Deutschland einfach erklärt",
        "order": "38",
        "meta_descr": "Kranken-, Pflege-, Renten-, Arbeitslosen- und Unfallversicherung: was vom Lohn abgeht, was jede zahlt und was ukrainische Beschäftigte wissen sollten.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-social-insurance.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-social-insurance.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-social-insurance.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-social-insurance.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/de/guide-social-insurance.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Sozialversicherung in Deutschland einfach erklärt\" />\n<meta property=\"og:description\" content=\"Kranken-, Pflege-, Renten-, Arbeitslosen- und Unfallversicherung: was vom Lohn abgeht, was jede zahlt und was ukrainische Beschäftigte wissen sollten.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/de/guide-social-insurance.html\" />\n<meta property=\"og:locale\" content=\"de_DE\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Die Sozialversicherung in Deutschland\",\"description\":\"Kranken-, Pflege-, Renten-, Arbeitslosen- und Unfallversicherung: was vom Lohn abgeht, was jede zahlt und was ukrainische Beschäftigte wissen sollten.\",\"inLanguage\":\"de\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/de/guide-social-insurance.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/de/guide-social-insurance.html\",\"wordCount\":881,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Welche Versicherungen gehen vom Lohn ab?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Kranken-, Pflege-, Renten- und Arbeitslosenversicherung. Die Unfallversicherung zahlt der Arbeitgeber.\"}},{\"@type\":\"Question\",\"name\":\"Wann bekomme ich Arbeitslosengeld?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nach mindestens zwölf Beitragsmonaten in den letzten dreißig Monaten.\"}},{\"@type\":\"Question\",\"name\":\"Bin ich im Minijob versichert?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nicht krankenversichert über den Job, aber renten- und unfallversichert, wenn Sie sich nicht von der Rentenversicherung befreien lassen.\"}},{\"@type\":\"Question\",\"name\":\"Wer zahlt nach einem Arbeitsunfall?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Die gesetzliche Unfallversicherung. Sagen Sie Arzt und Arbeitgeber, dass es ein Arbeitsunfall war.\"}},{\"@type\":\"Question\",\"name\":\"Wie beantrage ich Pflegeleistungen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Über Ihre Krankenkasse, die die Pflegekasse führt und eine Begutachtung veranlasst.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://zusammenleben-ukraine.de/de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ratgeber\",\"item\":\"https://zusammenleben-ukraine.de/de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Die Sozialversicherung in Deutschland\",\"item\":\"https://zusammenleben-ukraine.de/de/guide-social-insurance.html\"}]}]}</script>"
      },
      "components": [
        {
          "_name": "amenu1",
          "_sourceTheme": "solarm5",
          "_styles": {
            "& when (@sticky)": {
              "position": "sticky !important",
              "top": "0 !important",
              "z-index": "1030 !important",
              "width": "100%",
              "nav.navbar, .navbar-dropdown, .navbar-fixed-top": {
                "position": "relative !important"
              }
            },
            "& when not (@sticky)": {
              "position": "relative",
              "z-index": "1030",
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "body": {
              "position": "relative"
            },
            ".navbar": {
              "min-height": "80px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".navbar-logo img": {
                "width": "auto"
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-logo img": {
                  "height": "2.5rem !important"
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".container, .container-fluid": {
              "display": "flex",
              "flex-wrap": "wrap",
              "margin": "auto",
              "align-items": "center"
            },
            ".brand-container": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding-bottom": "4px",
              "padding-top": "4px",
              "width": "100%"
            },
            ".navbar-brand": {
              "min-height": "60px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "5px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              "display": "flex",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
