            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
