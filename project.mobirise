          "_name": "list01",
          "_sourceTheme": "guidem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"guide-executive-section\" id=\"request-assistance-guide\">\n    <div class=\"executive-container\">\n        \n        <!-- Header -->\n        <header class=\"guide-header\">\n            <span class=\"header-tag\">GETTING IN TOUCH</span>\n            <h1 class=\"header-title\">How to Reach Us</h1>\n            <p class=\"header-lead\">\n                No forms, no complicated documents — a simple WhatsApp message or email is all you need to start the process.\n            </p>\n        </header>\n\n        <!-- General Disclaimer / Privacy Notice -->\n        <div class=\"disclaimer-banner privacy-banner\">\n            <div class=\"disclaimer-icon\">\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg>\n            </div>\n            <div class=\"disclaimer-text\">\n                <strong>Zero Bureaucracy, Total Privacy:</strong> There are no intake forms on this website and we do not automatically collect personal data. This is a conscious choice: a family's sensitive information should not be stored where there is no real need. Send us a message in the language you prefer. A brief general picture is enough, and we will figure out the rest in conversation.\n            </div>\n        </div>\n\n        <!-- Section 1: Who & Where (2 Columns) -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><circle cx=\"12\" cy=\"12\" r=\"6\"></circle><circle cx=\"12\" cy=\"12\" r=\"2\"></circle></svg>\n                </span> \n                Who Is This For &amp; Service Area\n            </h2>\n            \n            <div class=\"two-column-grid\">\n                <!-- Target Audience -->\n                <div class=\"guide-subcard\">\n                    <h3>Who the Service is For</h3>\n                    <p>Families and individuals from Ukraine who are currently in Northern Bavaria, or are about to move to the area, and need assistance in one or more of the following areas: housing, dealing with the Jobcenter, Anmeldung, school or kindergarten registration, translation, furniture and equipment, or general guidance in navigating the local system.</p>\n                    <div class=\"notice-highlight\">\n                        <strong>Applying for others:</strong> You can also reach out on behalf of someone else — a relative, neighbor, or friend — provided they are aware of the inquiry and are interested in it.\n                    </div>\n                </div>\n\n                <!-- Region Limits -->\n                <div class=\"guide-subcard\">\n                    <h3>Regional Limitations</h3>\n                    <p>Our activity is strictly focused on <strong>Northern Bavaria and Upper Franconia (Oberfranken)</strong>.</p>\n                    <p>Inquiries from other regions in Germany will be received and read, but in most cases, we will not be able to provide practical assistance on the ground. However, we will do our best to point you toward a relevant contact or organization in your area.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 2: What to write -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"></line><polyline points=\"10 9 9 9 8 9\"></polyline></svg>\n                </span> \n                What to Include in Your First Message\n            </h2>\n            \n            <div class=\"guide-card\">\n                <p class=\"guide-card-intro\">To save time on long initial text exchanges, it is very helpful to briefly include the following details in your first message:</p>\n                \n                <div class=\"card-details-grid\">\n                    <ul class=\"numbered-list\">\n                        <li><strong>1. Identification:</strong> Your first name and how you prefer us to address you.</li>\n                        <li><strong>2. Location:</strong> The city or town where you are currently located.</li>\n                        <li><strong>3. Household Size:</strong> How many adults and how many children, along with the children's ages.</li>\n                        <li><strong>4. Core Issue:</strong> What is your main need or problem right now?</li>\n                        <li><strong>5. Priority:</strong> What is urgent, and what can wait?</li>\n                        <li><strong>6. Deadlines:</strong> If there is a close deadline that must be met — for example, a letter with a response date or a date you must leave temporary housing.</li>\n                    </ul>\n                </div>\n\n                <div class=\"rule-box doc-rule\">\n                    <div class=\"rule-header\">\n                        <svg class=\"rule-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline></svg>\n                        <h3>Regarding Documents</h3>\n                    </div>\n                    <p>There is no need to attach any official documents or photos at this initial stage. If a specific document is needed later to understand your case, we will ask for it and explain exactly why.</p>\n                </div>\n\n                <div class=\"card-details-grid\">\n                    <div class=\"detail-box lang-box\">\n                        <div class=\"lang-header\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path></svg>\n                            <h4>In What Languages Can You Apply?</h4>\n                        </div>\n                        <p><strong>Ukrainian, Russian, German, and English.</strong> Please write in the language you find most comfortable. It is always better to provide a clear explanation in your native language than a hesitant, translated phrase in German.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 3: The Process -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"23 4 23 10 17 10\"></polyline><path d=\"M20.49 15a9 9 0 1 1-2.12-9.36L23 10\"></path></svg>\n                </span> \n                What Happens After You Reach Out?\n            </h2>\n            \n            <div class=\"three-column-grid\">\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon step-badge\">1</div>\n                    <h3>Reading &amp; Understanding</h3>\n                    <p>We read everything you wrote to grasp the general picture of your situation.</p>\n                </div>\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon step-badge\">2</div>\n                    <h3>Clarification</h3>\n                    <p>We may ask a few short follow-up questions to understand exactly what is required.</p>\n                </div>\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon step-badge\">3</div>\n                    <h3>Assessment</h3>\n                    <p>We check what we can practically do, based on your location, your specific need, and our current availability.</p>\n                </div>\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon step-badge\">4</div>\n                    <h3>Honest Answer</h3>\n                    <p>We will tell you what is possible and what is not. If we cannot assist, we will say so quickly rather than leaving you waiting.</p>\n                </div>\n                <div class=\"guide-mini-card full-width-step\">\n                    <div class=\"mini-icon step-badge\">5</div>\n                    <h3>Continued Support</h3>\n                    <p>If we are able to help, we will establish the next steps together and accompany you throughout the process.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 4: Expectations & Emergency -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z\"></path><path d=\"m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z\"></path><path d=\"M7 21h10\"></path><path d=\"M12 3v18\"></path><path d=\"M3 7h18\"></path></svg>\n                </span> \n                Expectations &amp; Emergency Information\n            </h2>\n            \n            <div class=\"two-column-grid\">\n                <!-- What we guarantee / cannot guarantee -->\n                <div class=\"guide-subcard\">\n                    <h3>What We Cannot Guarantee</h3>\n                    <p>We do not guarantee finding an apartment, securing a Jobcenter approval, obtaining a spot in a kindergarten or school, securing financial allowances, or providing an immediate solution. We cannot influence the decisions made by authorities, and we do not provide binding legal advice.</p>\n                    <hr class=\"card-divider\">\n                    <h3 class=\"highlight-green-title\">What We DO Guarantee</h3>\n                    <p>We promise that we will read every inquiry, review it seriously, answer you honestly, and <strong>never charge you a dime.</strong></p>\n                </div>\n\n                <!-- Emergency Block -->\n                <div class=\"guide-subcard emergency-card\">\n                    <div class=\"emergency-header\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg>\n                        <h3 class=\"emergency-title\">This Is Not An Emergency Line</h3>\n                    </div>\n                    <p class=\"emergency-subtitle\">Reaching out to us is not intended for life-threatening or dangerous situations.</p>\n                    <p class=\"emergency-desc\">In the event of an immediate danger — medical, security, or otherwise — please contact the official emergency services in Germany immediately:</p>\n                    <ul class=\"numbered-list emergency-list\">\n                        <li>\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg>\n                            <span><strong>112</strong> — Ambulance &amp; Fire Department</span>\n                        </li>\n                        <li>\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg>\n                            <span><strong>110</strong> — Police</span>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n\n        <!-- CTA Area -->\n        <div class=\"guide-block\">\n            <div class=\"guide-card cta-card\">\n                <h3>Contact Us Directly</h3>\n                <p class=\"cta-notice\">\n                    Please note: The direct email address for assistance is provided at the bottom of this page.\n                </p>\n                <p class=\"cta-sub\">\n                    Choose the method most convenient for you:\n                </p>\n                \n                <!-- BUTTONS (Mobirise Compatible) -->\n                <div class=\"mbr-section-btn cta-buttons-wrapper\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn custom-btn whatsapp-btn display-4 btn-warning\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                        WhatsApp Anna\n                    </a></div>\n            </div>\n        </div>\n\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "list01-2d",
          "_isUserblock": true,
          "_cid": "vqptsrc2Fe",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "footer4",
          "_sourceTheme": "restaurantm4",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "*:focus": {
              "outline": "none",
              "box-shadow": "none"
            },
            ".form-control": {
              "width": "100%",
              "background": "@inputBg",
              "border-radius": "0 !important",
              "border": "none !important",
              "min-height": "47px",
              "&::-webkit-input-placeholder": {
                "color": "contrast(@inputBg)"
              },
              "&::-moz-placeholder": {
                "color": "contrast(@inputBg)"
              },
              "&:-ms-input-placeholder": {
                "color": "contrast(@inputBg)"
              },
              "&:-moz-placeholder": {
                "color": "contrast(@inputBg)"
              }
            },
            "input.form-control": {
              "padding": "0.5rem"
            },
            ".soc-item": {
              "display": "inline-block",
              "margin": "0 0.1rem 0.2rem 0.1rem",
              "padding": "10px 11px 0 11px",
              "border": "2px solid @iconsColor !important",
              "border-radius": "50% !important",
              "&:hover": {
                "opacity": "0.5"
              },
              ".socicon": {
                "font-size": "1.5rem",
                "color": "@iconsColor"
              }
            },
            ".days-column, .hours-column": {
              "display": "inline-block",
              "span": {
                "display": "block"
              }
            },
            ".logo": {
              "img": {
                "width": "auto",
                "display": "inline-block"
              }
            },
            "@media (max-width: 767px)": {
              ".days-column": {
                "padding-right": "0 !important"
              },
              ".hours-column": {
                "max-width": "50% !important"
              },
              ".opening-hours": {
                "padding-bottom": "48px !important"
              }
            },
            ".form-title, .btn-row": {
              "color": "#0c2c68"
            },
            ".follow-title, .social-list, .logo": {
              "color": "#0c2c68"
            },
            ".address-title, .address-block": {
              "color": "#0c2c68"
            },
            ".hours-column": {
              "color": "#0c2c68"
            },
            ".opening-hours-title, .opening-hours": {
              "color": "#0c2c68"
            },
            ".contacts-title, .contacts-block": {
              "color": "#0c2c68",
              "text-align": "center"
            },
            "LABEL": {
              "color": "#0c2c68"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer4 restaurantm4_footer4\" group=\"Footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n\t\t<select title=\"Icons\" name=\"iconsCount\" condition=\"showIcons\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t</select>\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n\t\t<input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#0c2c68\" condition=\"showIcons\">\n\t\t<input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n\t\t<input type=\"checkbox\" title=\"Form\" name=\"showForm\" checked>\n\t\t<input type=\"color\" title=\"Input Bg\" name=\"inputBg\" value=\"#ffffff\" condition=\"showForm\">\n\t\t<input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background8.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#f7f7f7\" selected>\n\t\t</fieldset>\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t<input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row content justify-content-center align-items-start mbr-white\">\n\t\t\t\n\t\t\t<!-- עמודת פרטי התקשרות וסיוע -->\n\t\t\t<div class=\"col-12 col-md-5 col-lg-5 pb-4\" mbr-if=\"showContacts || showIcons\">\n\t\t\t\t<div class=\"contacts\" mbr-if=\"showContacts\">\n\t\t\t\t\t<h3 class=\"contacts-title mbr-fonts-style pb-2 align-left\" mbr-theme-style=\"display-5\" data-app-selector=\".contacts-title, .contacts-block\">\n\t\t\t\t\t\t<b>Need Assistance?</b>\n\t\t\t\t\t</h3>\n\t\t\t\t\t<p class=\"contacts-block mbr-fonts-style align-left\" mbr-theme-style=\"display-7\" data-app-selector=\".contacts-title, .contacts-block\">\n\t\t\t\t\t\tWe are here to support Ukrainian families in Northern Bavaria with housing, authority coordination, and integration.<br><br>\n\t\t\t\t\t\t<strong>WhatsApp Support:</strong><br>\n\t\t\t\t\t\t<a href=\"https://wa.me/380637004615\" class=\"text-primary\">+380 63 700 4615</a><br><br>\n\t\t\t\t\t\t<strong>Main Center:</strong><br>\n\t\t\t\t\t\tKonradsreuth Alte Hofer Str. 1 ⚲<br><br>\n\t\t\t\t\t\t<strong>Email Us:</strong><br><a href=\"mailto:zusammenleben.de@gmail.com\" class=\"text-primary\">zusammenleben.de@gmail.com&nbsp;✉</a>\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"social-list pt-3 align-left\" mbr-if=\"showIcons\">\n\t\t\t\t\t<div class=\"soc-item\">\n\t\t\t\t\t\t<a href=\"https://wa.me/380637004615\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-whatsapp socicon\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 1\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-facebook socicon\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 2\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 3\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"socicon-instagram socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 4\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"socicon-googleplus socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 5\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"socicon-behance socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<!-- עמודת טופס בקשת סיוע -->\n\t\t\t<div class=\"form-1 col-12 col-md-7 col-lg-6\" mbr-if=\"showForm\">\n\t\t\t\t<h3 class=\"form-title pb-3 mbr-fonts-style align-left\" mbr-theme-style=\"display-5\" data-app-selector=\".form-title, .btn-row\">\n\t\t\t\t\t<b>Request Assistance</b>\n\t\t\t\t</h3>\n\t\t\t\t\n\t\t\t\t<div mbr-form>\n\t\t\t\t\t<!--Formbuilder Form-->\n\t\t\t\t\t<form action=\"zusammenleben.de@gmail.com\" name=\"Assistance Request Form\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"zusammenleben.de@gmail.com\">\n\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thank you! Your request has been sent. We will get back to you shortly.</div>\n\t\t\t\t\t\t\t<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"dragArea row\">\n\t\t\t\t\t\t\t<div class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\" data-for=\"full name\">\n\t\t\t\t\t\t\t\t<input type=\"text\" name=\"full name\" placeholder=\"*Full Name\" data-form-field=\"full name\" style=\"text-align:left\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<div class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\" data-for=\"tel\">\n\t\t\t\t\t\t\t\t<input type=\"tel\" name=\"tel\" placeholder=\"*Phone / WhatsApp\" data-form-field=\"tel\" mbr-theme-style=\"display-7\" required=\"required\" style=\"text-align:left\" class=\"form-control\" value>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<div data-for=\"email\" class=\"col-md-12 form-group mb-3\">\n\t\t\t\t\t\t\t\t<input type=\"email\" name=\"email\" placeholder=\"Email Address\" style=\"text-align:left\" data-form-field=\"E-mail\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<div data-for=\"message\" class=\"col-md-12 form-group mb-3 pb-2\">\n\t\t\t\t\t\t\t\t<textarea name=\"message\" placeholder=\"How can we help you? (Housing, Jobcenter, School, Translation, etc.)\" data-form-field=\"Message\" style=\"text-align:left\" mbr-theme-style=\"display-7\" class=\"form-control\" rows=\"4\"></textarea>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n\t\t\t\t\t\t\t\t<div data-for=\"I agree to the terms and conditions and privacy policy\" class=\"form-check me-2\">\n\t\t\t\t\t\t\t\t\t<input type=\"checkbox\" value=\"Yes\" name=\"I agree to the terms and conditions and privacy policy\" data-form-field=\"I agree to the terms and conditions\" mbr-theme-style=\"display-7\" class=\"form-check-input\" required=\"required\">\n\t\t\t\t\t\t\t\t\t<label mbr-text for=\"I agree to the terms and conditions and privacy policy\" mbr-theme-style=\"display-7\" class=\"form-check-label text-muted\">\n\t\t\t\t\t\t\t\t\t\tI agree to the <a href=\"usingtheweb.html\" class=\"text-black\">Terms &amp; Conditions</a> &amp; <a href=\"privacy.html\" class=\"text-black\">Privacy Policy</a>\n\t\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<div class=\"col-md-12 input-group-btn align-center\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n\t\t\t\t\t\t\t\t<button type=\"submit\" class=\"w-100 btn btn-form btn-primary\" data-app-placeholder=\"Type Text\">Send Assistance Request</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</form>\n\t\t\t\t\t<!--Formbuilder Form-->\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t</div>\n\t</div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "footer4-1z",
          "_isUserblock": true,
          "_cid": "vqj20Eg7Ge",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 scalem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"50\" max=\"400\" step=\"10\" value=\"150\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Lists\" name=\"showLists\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"list\" min=\"1\" max=\"5\" step=\"1\" value=\"4\" condition=\"showLists\">\n        <input type=\"color\" title=\"List Active Color\" value=\"#ffffff\" name=\"activeList\" condition=\"showLists\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Social Active Color\" value=\"#FF5753\" name=\"active\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#635d60\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#0c2c68\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#292325\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            \n            <!-- עמודת טקסט וכותרת ראשית -->\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showTitle || showText || showButtons || showLogo\">\n                <div class=\"content-wrapper\">\n                    <!-- תוספת המקום ללוגו -->\n                    <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"Logo\">\n                        </a>\n                    </div>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>\n                        ZUSAMMENLEBEN\n                    </b></h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                        Supporting integration, housing, and community connection for newcomers and locals in the area.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-phone mbr-iconfont mbr-iconfont-btn\"></span>\n                            Contact Us\n                        </a></div>\n                </div>\n            </div>\n\n            <!-- עמודות הקישורים -->\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLists\">\n                <div class=\"lists-wrapper\">\n                    <div class=\"list-wrap\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Home</a></li>\n                            <li class=\"item-wrap\"><a href=\"family-stories.html\" class=\"text-white\">Family Stories</a></li>\n                            <li class=\"item-wrap\"><a href=\"services.html\" class=\"text-white\">Services</a></li>\n                            <li class=\"item-wrap\"><a href=\"request-assistance.html\" class=\"text-white\">Request Assistance</a></li>\n                            <li class=\"item-wrap\"><a href=\"community.html\" class=\"text-white\">Community</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"living-in-germany.html\" class=\"text-white\">Living in Germany</a></li>\n                            <li class=\"item-wrap\"><a href=\"glossary.html\" class=\"text-white\">Glossary</a></li>\n                            <li class=\"item-wrap\"><a href=\"learning-german.html\" class=\"text-white\">Learning German</a></li>\n                            <li class=\"item-wrap\"><a href=\"refugee-rights.html\" class=\"text-white\">Refugee Rights</a></li>\n                            <li class=\"item-wrap\"><a href=\"anna-shishoili.html\" class=\"text-white\">Anna Shishoili</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 2\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"how-to-help.html\" class=\"text-white\">How Can You Help</a></li>\n                            <li class=\"item-wrap\"><a href=\"social-activity.html\" class=\"text-white\">Social Activity</a></li>\n                            <li class=\"item-wrap\"><a href=\"faq.html\" class=\"text-white\">FAQ</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Areas We Serve</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 3\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"emergency.html\" class=\"text-white\">Emergency</a></li>\n                            <li class=\"item-wrap\"><a href=\"Contact.html\" class=\"text-white\">Contact</a></li>\n                            <li class=\"item-wrap\"><a href=\"https://wa.me/380637004615\" class=\"text-white\" target=\"_blank\">WhatsApp Support</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Location</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 4\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Privacy Policy</a></li>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Terms of Use</a></li>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Impressum</a></li>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Official Site</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- אזור זכויות יוצרים ורשתות חברתיות -->\n            <div class=\"col-12\" mbr-if=\"showSocial || showCopy\">\n                <div class=\"copy-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://wa.me/380637004615\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-whatsapp\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"mailto:info@zusammenleben.de\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy, .social-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\">\n                        © Copyright 2026 Zusammenleben - All Rights Reserved\n                    </p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
