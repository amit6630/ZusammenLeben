        {
          "alias": false,
          "_styles": {
            ".german-guide-section": {
              "padding": "100px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.6",
              "direction": "ltr",
              "text-align": "left"
            },
            ".german-guide-section *": {
              "box-sizing": "border-box"
            },
            ".guide-container": {
              "max-width": "1000px",
              "margin": "0 auto",
              "padding": "0 24px"
            },
            ".guide-header": {
              "text-align": "center",
              "max-width": "820px",
              "margin": "0 auto 50px"
            },
            ".header-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-top": "50px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "border": "1px solid #bfdbfe"
            },
            ".header-title": {
              "font-size": "2.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.02em",
              "margin": "0 0 16px 0",
              "line-height": "1.25"
            },
            ".header-lead": {
              "font-size": "1.15rem",
              "color": "#475569",
              "margin": "0"
            },
            ".guide-block": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "36px",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.02)"
            },
            ".block-title": {
              "font-size": "1.6rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "16px",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "border-bottom": "2px solid #f1f5f9",
              "padding-bottom": "16px"
            },
            ".icon-wrapper": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "width": "40px",
              "height": "40px",
              "background": "#eff6ff",
              "color": "#2563eb",
              "border-radius": "10px",
              "flex-shrink": "0"
            },
            ".intro-text": {
              "font-size": "1.05rem",
              "color": "#475569",
              "margin-bottom": "20px"
            },
            ".benefits-grid, .cert-grid, .faq-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(300px, 1fr))",
              "gap": "20px"
            },
            ".benefit-card, .faq-card": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "padding": "20px",
              "border-radius": "12px"
            },
            ".benefit-card h4, .faq-card h4": {
              "font-size": "1.1rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin-bottom": "10px"
            },
            ".benefit-card p, .faq-card p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin": "0"
            },
