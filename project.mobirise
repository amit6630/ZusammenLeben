        {
          "_styles": {
            ".guide-executive-section": {
              "padding": "80px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "'Inter', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.65",
              "direction": "ltr",
              "text-align": "left",
              "width": "100%",
              "overflow-x": "hidden",
              "-webkit-font-smoothing": "antialiased"
            },
            ".guide-executive-section *": {
              "box-sizing": "border-box"
            },
            ".executive-container": {
              "max-width": "1000px",
              "margin": "0 auto",
              "padding": "0 24px",
              "width": "100%"
            },
            ".guide-header": {
              "text-align": "center",
              "max-width": "820px",
              "margin": "0 auto 40px"
            },
            ".header-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-top": "50px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "border": "1px solid #bfdbfe"
            },
            ".header-title": {
              "font-size": "2.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.02em",
              "margin": "12px 0 16px 0",
              "line-height": "1.25"
            },
            ".header-lead": {
              "font-size": "1.15rem",
              "color": "#475569",
              "margin": "0"
            },
            ".disclaimer-banner": {
              "border-radius": "14px",
              "padding": "20px 24px",
              "display": "flex",
              "gap": "16px",
              "align-items": "flex-start",
              "margin-bottom": "45px"
            },
            ".privacy-banner": {
              "background": "#f0fdf4",
              "border": "1px solid #bbf7d0",
              "box-shadow": "0 4px 12px rgba(22, 101, 52, 0.03)"
            },
            ".disclaimer-icon": {
              "color": "#16a34a",
              "flex-shrink": "0",
              "background": "#dcfce7",
              "width": "38px",
              "height": "38px",
              "border-radius": "10px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "border": "1px solid #bbf7d0"
            },
            ".disclaimer-text": {
              "font-size": "0.95rem",
              "color": "#166534",
              "line-height": "1.6"
            },
            ".guide-block": {
              "margin-bottom": "45px"
            },
            ".block-title": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "24px",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "border-bottom": "2px solid #e2e8f0",
              "padding-bottom": "12px"
            },
            ".title-icon": {
              "color": "#2563eb",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#eff6ff",
              "width": "36px",
              "height": "36px",
              "border-radius": "8px",
              "border": "1px solid #dbeafe"
            },
            ".guide-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "18px",
              "padding": "32px",
              "margin-bottom": "24px",
              "box-shadow": "0 4px 20px rgba(0, 0, 0, 0.02)"
            },
