            },
            ".zl-cta p": {
              "margin": "0 0 16px",
              "color": "#dbeafe"
            },
            ".zl-btns": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "10px"
            },
            ".zl-btn": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-height": "46px",
              "padding": "10px 20px",
              "border-radius": "999px",
              "font-weight": "700",
              "text-decoration": "none !important"
            },
            ".zl-btn--wa": {
              "background": "#0f7a3e",
              "color": "#fff !important"
            },
            ".zl-btn--light": {
              "background": "#fff",
              "color": "#0c2c68 !important"
            },
            ".zl-btn--ghost": {
              "border": "2px solid #0c2c68",
              "color": "#0c2c68 !important",
              "background": "transparent"
            },
            ".zl-related": {
              "margin-top": "36px"
            },
            ".zl-related h2": {
              "font-size": "22px",
              "margin": "0 0 12px",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fill, minmax(250px, 1fr))",
              "gap": "16px"
            },
            ".zl-tile": {
              "display": "flex",
              "flex-direction": "column",
              "gap": "8px",
              "padding": "20px",
              "background": "#fff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "color": "#1e293b !important",
              "text-decoration": "none !important",
              "transition": "transform .2s, box-shadow .2s, border-color .2s"
            },
            ".zl-tile:hover": {
              "transform": "translateY(-3px)",
              "border-color": "#93c5fd",
              "box-shadow": "0 14px 30px -20px rgba(29, 78, 216, .45)"
            },
            ".zl-tile h2, .zl-tile h3": {
              "font-size": "18px",
              "line-height": "1.3",
              "margin": "0",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-tile p": {
              "margin": "0",
              "font-size": "15px",
              "color": "#475569"
            },
            ".zl-tile .zl-more": {
              "margin-top": "auto",
              "font-weight": "700",
              "color": "#1d4ed8",
              "font-size": "15px"
            },
            ".zl-ico": {
              "width": "42px",
              "height": "42px",
              "border-radius": "12px",
              "display": "grid",
              "place-items": "center",
              "background": "#e0e7ff",
              "color": "#0c2c68"
            },
            ".zl-ico svg": {
              "width": "22px",
              "height": "22px"
            },
            ".zl-hub-head": {
              "margin-bottom": "26px",
              "max-width": "760px"
            },
            ".zl-hub-head .zl-lead": {
              "margin-bottom": "0"
            },
            ".zl-comm-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(230px, 1fr))",
              "gap": "16px",
              "margin": "6px 0 0"
            },
            ".zl-comm-grid .zl-tile:hover": {
              "transform": "none",
              "box-shadow": "none",
              "border-color": "#e2e8f0"
            },
            "@media (max-width: 575px)": {
              ".zl-grid": {
                "grid-template-columns": "1fr 1fr",
                "gap": "10px"
              },
              ".zl-grid .zl-tile": {
                "padding": "14px",
                "gap": "8px"
              },
              ".zl-grid .zl-tile p, .zl-grid .zl-tile .zl-more": {
                "display": "none"
              },
              ".zl-grid .zl-tile h2, .zl-grid .zl-tile h3": {
                "font-size": "15px"
              },
              ".zl-grid .zl-ico": {
                "width": "34px",
                "height": "34px"
              },
              ".zl-comm-grid": {
                "gap": "10px"
              },
              ".zl-comm-grid .zl-tile": {
                "padding": "16px"
              },
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            }
