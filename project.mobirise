              "background": "#fffbeb",
              "border": "1px solid #fde68a",
              "border-left": "5px solid #f59e0b",
              "color": "#92400e"
            },
            ".rule-box.amber-rule h3": {
              "color": "#92400e"
            },
            ".rule-box.red-rule": {
              "background": "#fef2f2",
              "border": "1px solid #fecaca",
              "border-left": "5px solid #ef4444",
              "color": "#991b1b"
            },
            ".rule-box.red-rule h3": {
              "color": "#991b1b"
            },
            ".two-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "20px"
            },
            ".guide-subcard": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "28px",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.02)"
            },
            ".guide-subcard h3": {
              "font-size": "1.2rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 12px 0"
            },
            ".guide-subcard h3.card-title-flex": {
              "display": "flex",
              "align-items": "center",
              "gap": "10px"
            },
            ".guide-subcard p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin-bottom": "12px",
              "line-height": "1.65"
            },
            ".guide-subcard p:last-child": {
              "margin-bottom": "0"
            },
            ".three-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(240px, 1fr))",
              "gap": "16px"
            },
            ".three-column-grid.compact-grid": {
              "margin-top": "16px"
            },
            ".guide-mini-card": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "border-radius": "14px",
              "padding": "24px",
              "transition": "transform 0.2s ease, box-shadow 0.2s ease"
            },
            ".guide-mini-card:hover": {
              "transform": "translateY(-2px)",
              "box-shadow": "0 6px 15px rgba(0, 0, 0, 0.04)"
            },
            ".mini-icon": {
              "color": "#2563eb",
              "margin-bottom": "14px",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#eff6ff",
              "padding": "10px",
              "border-radius": "10px",
              "border": "1px solid #dbeafe"
            },
            ".card-title-with-icon": {
              "display": "flex",
              "align-items": "center",
              "gap": "8px",
              "margin-bottom": "8px",
              "color": "#2563eb"
            },
            ".card-title-with-icon h3": {
              "margin": "0 !important",
              "font-size": "1.05rem !important"
            },
            ".guide-mini-card h3": {
              "font-size": "1.05rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".guide-mini-card p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.5"
            },
