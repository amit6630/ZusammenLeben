            "&": {
              "background": "#f8fafc",
              "color": "#1e293b",
              "padding": "120px 16px 72px",
              "font-family": "'Inter Tight', sans-serif",
              "line-height": "1.65"
            },
            ".zl-wrap": {
              "max-width": "780px",
              "margin": "0 auto"
            },
            ".zl-wrap--wide": {
              "max-width": "1100px"
            },
            ".zl-crumbs ol": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "6px",
              "list-style": "none",
              "padding": "0",
              "margin": "0 0 18px",
              "font-size": "14px",
              "color": "#475569"
            },
