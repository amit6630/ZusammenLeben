              "font-size": "0.95rem"
            },
            ".cta-buttons-wrapper": {
              "display": "flex",
              "justify-content": "center",
              "gap": "14px",
              "flex-wrap": "wrap"
            },
            ".guide-executive-section .btn.custom-btn": {
