              "font-weight": "750"
            },
            ".zl-cta p": {
              "margin": "0 0 16px",
              "color": "#dbeafe"
            },
            ".zl-btns": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "10px"
            },
            ".zl-btn": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-height": "46px",
              "padding": "10px 20px",
              "border-radius": "999px",
              "font-weight": "700",
              "text-decoration": "none !important"
            },
            ".zl-btn--wa": {
              "background": "#0f7a3e",
              "color": "#fff !important"
            },
            ".zl-btn--light": {
              "background": "#fff",
              "color": "#0c2c68 !important"
            },
            ".zl-btn--ghost": {
              "border": "2px solid #0c2c68",
              "color": "#0c2c68 !important",
              "background": "transparent"
            },
            ".zl-related": {
              "margin-top": "36px"
            },
            ".zl-related h2": {
