              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(250px, 1fr))",
              "gap": "16px"
            },
            ".level-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "padding": "24px",
              "border-radius": "12px",
              "position": "relative",
              "transition": "transform 0.2s ease, box-shadow 0.2s ease"
            },
            ".level-card:hover": {
              "transform": "translateY(-3px)",
              "box-shadow": "0 10px 25px rgba(0, 0, 0, 0.05)"
            },
            ".level-badge": {
              "background": "#e2e8f0",
              "color": "#334155",
              "font-weight": "800",
              "font-size": "1.2rem",
              "padding": "6px 14px",
              "border-radius": "8px",
              "display": "inline-block",
              "margin-bottom": "12px"
            },
            ".highlight-level": {
              "border": "2px solid #2563eb",
              "background": "#eff6ff"
            },
            ".target-badge": {
              "background": "#2563eb",
              "color": "#ffffff"
            },
            ".level-name": {
              "font-size": "1.15rem",
              "font-weight": "700",
              "margin-bottom": "8px",
              "color": "#0f172a"
            },
            ".level-card p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0"
            },
            ".cert-card": {
              "background": "#ffffff",
              "border": "1px solid #cbd5e1",
              "padding": "24px",
              "border-radius": "12px",
              "border-left": "5px solid #2563eb"
            },
            ".cert-title": {
              "font-size": "1.25rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "10px"
            },
            ".cert-meta": {
              "margin-top": "16px",
              "padding-top": "16px",
              "border-top": "1px solid #e2e8f0",
              "font-size": "0.9rem",
              "color": "#0f172a"
            },
            ".steps-container": {
              "display": "flex",
              "flex-direction": "column",
              "gap": "16px"
            },
            ".step-item": {
              "display": "flex",
              "align-items": "flex-start",
              "gap": "16px",
              "background": "#f8fafc",
              "padding": "16px",
              "border-radius": "10px",
              "border": "1px solid #e2e8f0"
            },
            ".step-number": {
              "background": "#2563eb",
              "color": "#ffffff",
              "font-weight": "800",
              "width": "32px",
              "height": "32px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "border-radius": "50%",
              "flex-shrink": "0"
            },
            ".step-content h4": {
              "margin": "0 0 6px 0",
              "font-size": "1.1rem",
              "font-weight": "700",
              "color": "#0f172a"
            },
            ".step-content p": {
              "margin": "0",
              "font-size": "0.95rem",
              "color": "#475569"
            },
            ".alert-box": {
              "padding": "16px 20px",
              "border-radius": "10px",
              "font-size": "0.95rem"
            },
            ".alert-box.info": {
              "background": "#eff6ff",
              "border-left": "4px solid #3b82f6",
              "color": "#1e3a8a"
            },
            ".alert-box.critical": {
              "background": "#fff1f2",
              "border": "1px solid #fecdd3",
              "border-left": "5px solid #e11d48",
              "color": "#881337"
            },
            ".alert-heading": {
              "color": "#e11d48",
              "font-weight": "800",
              "font-size": "1.15rem",
              "margin-bottom": "10px"
            },
            ".standard-list": {
              "padding-left": "20px",
              "color": "#475569",
              "font-size": "1.05rem"
            },
            ".standard-list li": {
              "margin-bottom": "10px"
            },
            ".support-box": {
              "background": "#f1f5f9",
              "border": "1px solid #e2e8f0",
              "padding": "30px",
              "border-radius": "16px",
              "text-align": "center"
            },
            ".support-box h4": {
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "10px"
            },
            ".support-box p": {
              "color": "#475569",
              "font-size": "0.95rem",
              "margin-bottom": "20px",
              "max-width": "700px",
              "margin-left": "auto",
              "margin-right": "auto"
            },
            ".sources-links": {
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "center",
              "gap": "12px"
            },
            ".source-link-btn": {
              "background": "#ffffff",
              "padding": "10px 20px",
              "border-radius": "100px",
              "font-size": "0.9rem",
              "font-weight": "700",
              "color": "#2563eb",
              "border": "2px solid #2563eb",
              "text-decoration": "none",
              "transition": "all 0.3s ease",
              "box-shadow": "0 2px 8px rgba(37, 99, 235, 0.1)",
              "display": "inline-block"
            },
            ".source-link-btn:hover": {
              "background": "#2563eb",
              "color": "#ffffff",
              "transform": "translateY(-2px)",
              "box-shadow": "0 4px 14px rgba(37, 99, 235, 0.25)",
              "text-decoration": "none"
            },
            "@media (max-width: 768px)": {
              ".header-title": {
                "font-size": "2rem"
              },
              ".guide-block": {
                "padding": "24px 20px"
              },
              ".benefits-grid, .cert-grid, .faq-grid": {
                "grid-template-columns": "1fr"
              },
              ".sources-links": {
                "flex-direction": "column",
                "gap": "10px"
              },
              ".source-link-btn": {
                "width": "100%",
                "text-align": "center"
              }
            }
