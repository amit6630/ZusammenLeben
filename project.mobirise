        {
          "_name": "slider01",
          "_sourceTheme": "smartm5",
          "_styles": {
            ".guide-executive-section": {
              "padding": "80px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "'Inter', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.65",
              "direction": "ltr",
              "text-align": "left",
              "-webkit-font-smoothing": "antialiased"
            },
            ".guide-executive-section *": {
              "box-sizing": "border-box"
            },
            ".executive-container": {
              "max-width": "1000px",
              "margin": "0 auto",
              "padding": "0 24px"
            },
            ".guide-header": {
              "text-align": "center",
              "max-width": "820px",
              "margin": "0 auto 40px"
            },
            ".header-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-top": "50px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "border": "1px solid #bfdbfe"
            },
            ".header-title": {
              "font-size": "2.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.02em",
              "margin": "12px 0 16px 0",
              "line-height": "1.25"
            },
            ".header-lead": {
              "font-size": "1.15rem",
              "color": "#475569",
              "margin": "0"
            },
            ".disclaimer-banner": {
              "background": "#fffbeb",
              "border": "1px solid #fde68a",
              "border-radius": "14px",
              "padding": "20px 24px",
              "display": "flex",
              "gap": "16px",
              "align-items": "flex-start",
              "margin-bottom": "45px",
              "box-shadow": "0 4px 12px rgba(217, 119, 6, 0.05)"
            },
            ".disclaimer-icon": {
              "color": "#d97706",
              "flex-shrink": "0",
              "background": "#fef3c7",
              "width": "38px",
              "height": "38px",
              "border-radius": "10px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "border": "1px solid #fde68a"
            },
            ".disclaimer-text": {
              "font-size": "0.95rem",
              "color": "#92400e",
              "line-height": "1.6"
            },
            ".guide-block": {
              "margin-bottom": "45px"
            },
            ".block-title": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "24px",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "border-bottom": "2px solid #e2e8f0",
              "padding-bottom": "12px"
            },
            ".title-icon": {
              "color": "#2563eb",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#eff6ff",
              "width": "36px",
              "height": "36px",
              "border-radius": "8px",
              "border": "1px solid #dbeafe"
            },
            ".guide-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "18px",
              "padding": "32px",
              "margin-bottom": "24px",
              "box-shadow": "0 4px 20px rgba(0, 0, 0, 0.02)",
              "transition": "border-color 0.25s ease"
            },
            ".guide-card:hover": {
              "border-color": "#cbd5e1"
            },
            ".card-header": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "margin-bottom": "16px",
              "flex-wrap": "wrap",
              "gap": "10px"
            },
            ".card-header h3": {
              "font-size": "1.3rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "0"
            },
            ".status-tag": {
              "font-size": "0.75rem",
              "font-weight": "700",
              "padding": "5px 14px",
              "border-radius": "100px",
              "text-transform": "uppercase",
              "letter-spacing": "0.5px"
            },
            ".status-tag.critical": {
              "background": "#fef3c7",
              "color": "#92400e",
              "border": "1px solid #fde68a"
            },
            ".status-tag.info": {
              "background": "#eff6ff",
              "color": "#1e40af",
              "border": "1px solid #bfdbfe"
            },
            ".card-details-grid": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "gap": "20px",
              "margin-top": "20px"
            },
            ".detail-box": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "padding": "20px",
              "border-radius": "12px"
            },
            ".detail-box-spacing": {
              "margin-top": "20px"
            },
            ".detail-box h4": {
              "font-size": "0.95rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".detail-box p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0"
            },
            ".rule-box": {
              "border-radius": "12px",
              "padding": "20px",
              "margin-top": "20px",
              "font-size": "0.92rem",
              "line-height": "1.55"
            },
            ".rule-header": {
              "display": "flex",
              "align-items": "center",
              "gap": "8px",
              "margin-bottom": "6px"
            },
            ".rule-header h3": {
              "margin": "0",
              "font-size": "1.05rem",
              "font-weight": "700"
            },
            ".danger-rule": {
              "background": "#fef2f2",
              "border": "1px solid #fecaca",
              "color": "#991b1b"
            },
            ".danger-rule .rule-header, .danger-rule .rule-icon": {
              "color": "#dc2626"
            },
            ".danger-rule p": {
              "color": "#991b1b",
              "margin": "0"
            },
            ".info-rule": {
              "background": "#f0fdf4",
              "border": "1px solid #bbf7d0",
              "color": "#166534"
            },
            ".info-rule .rule-header, .info-rule .rule-icon": {
              "color": "#16a34a"
            },
            ".info-rule p": {
              "color": "#166534",
              "margin": "0"
            },
            ".notice-highlight": {
              "background": "#f0f9ff",
              "border-left": "4px solid #0284c7",
              "padding": "14px 18px",
              "border-radius": "8px",
              "font-size": "0.92rem",
              "color": "#0369a1",
              "margin-top": "16px"
            },
            ".two-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "20px"
            },
            ".guide-subcard": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "26px",
              "display": "flex",
              "flex-direction": "column"
            },
            ".guide-subcard h3": {
              "font-size": "1.15rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 12px 0"
            },
            ".guide-subcard p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin-bottom": "12px"
            },
            ".subcard-rule": {
              "background": "#fff8f1",
              "border": "1px solid #ffedd5",
              "color": "#9a3412",
              "padding": "14px 18px",
              "margin-top": "auto"
            },
            ".three-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(260px, 1fr))",
              "gap": "20px"
            },
            ".guide-mini-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "24px",
              "transition": "transform 0.25s ease"
            },
            ".guide-mini-card:hover": {
              "transform": "translateY(-3px)"
            },
            ".mini-icon": {
              "width": "42px",
              "height": "42px",
              "border-radius": "10px",
              "background": "#eff6ff",
              "color": "#2563eb",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "margin-bottom": "14px",
              "border": "1px solid #dbeafe"
            },
            ".guide-mini-card h3": {
              "font-size": "1.05rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".guide-mini-card p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.55"
            },
            ".mini-card-note": {
              "margin-top": "12px !important",
              "font-size": "0.85rem !important",
              "color": "#64748b !important"
            },
            ".extreme-block": {
              "margin-top": "-10px"
            },
            ".extreme-card": {
              "background": "#fffbeb",
              "border": "1px solid #fde68a"
            },
            ".extreme-header": {
              "display": "flex",
              "align-items": "center",
              "gap": "10px",
              "color": "#b45309",
              "margin-bottom": "10px"
            },
            ".extreme-header h3": {
              "font-size": "1.2rem",
              "font-weight": "800",
              "color": "#92400e",
              "margin": "0"
            },
            ".extreme-card p": {
              "margin": "0",
              "color": "#92400e",
              "font-size": "0.95rem"
            },
            ".summary-cta-card": {
              "text-align": "center",
              "padding": "40px 32px",
              "background": "#ffffff",
              "border-radius": "20px"
            },
            ".summary-title": {
              "font-size": "1.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "0 0 16px 0"
            },
            ".summary-text": {
              "max-width": "750px",
              "margin": "0 auto 20px",
              "color": "#475569",
              "font-size": "0.98rem",
              "line-height": "1.6"
            },
            ".summary-tagline": {
              "font-weight": "700",
              "color": "#0f172a",
              "margin-bottom": "28px",
              "font-size": "1.05rem"
            },
            ".cta-buttons-wrapper": {
              "display": "flex",
              "justify-content": "center",
              "gap": "14px",
              "flex-wrap": "wrap"
            },
            ".guide-executive-section .btn.custom-btn": {
              "padding": "14px 28px !important",
              "border-radius": "100px !important",
              "font-weight": "700 !important",
              "font-size": "0.95rem !important",
              "display": "inline-flex !important",
              "align-items": "center !important",
              "justify-content": "center !important",
              "gap": "10px !important",
              "transition": "all 0.25s ease !important",
              "text-decoration": "none !important",
              "border-width": "1px !important",
              "margin": "0 !important"
            },
            ".guide-executive-section .btn.whatsapp-btn": {
              "background-color": "#25d366 !important",
              "border-color": "#25d366 !important",
              "color": "#ffffff !important",
              "box-shadow": "0 4px 12px rgba(37, 211, 102, 0.2) !important"
            },
            ".guide-executive-section .btn.whatsapp-btn:hover": {
              "background-color": "#20bd5a !important",
              "border-color": "#20bd5a !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 6px 18px rgba(37, 211, 102, 0.3) !important"
            },
            ".guide-executive-section .btn.outline-btn": {
              "background-color": "transparent !important",
              "border-color": "#2563eb !important",
              "color": "#2563eb !important"
            },
            ".guide-executive-section .btn.outline-btn:hover": {
              "background-color": "#eff6ff !important",
              "color": "#1d4ed8 !important",
              "border-color": "#1d4ed8 !important",
              "transform": "translateY(-2px) !important"
            },
            "@media (max-width: 768px)": {
              ".guide-executive-section": {
                "padding": "50px 0 !important"
              },
              ".executive-container": {
                "padding": "0 16px"
              },
              ".card-details-grid": {
                "grid-template-columns": "1fr"
              },
              ".header-title": {
                "font-size": "1.9rem"
              },
              ".guide-card": {
                "padding": "22px 18px"
              },
              ".summary-cta-card": {
                "padding": "28px 18px"
              },
              ".cta-buttons-wrapper": {
                "flex-direction": "column",
                "width": "100%"
              },
              ".guide-executive-section .btn.custom-btn": {
                "width": "100% !important"
              },
              ".disclaimer-banner": {
                "flex-direction": "column",
                "align-items": "center",
                "text-align": "center"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
