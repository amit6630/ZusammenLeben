        {
          "alias": false,
          "_styles": {
            ".guide-executive-section": {
              "padding": "80px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "'Inter', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.6",
              "direction": "ltr",
              "text-align": "left",
              "-webkit-font-smoothing": "antialiased"
            },
            ".guide-executive-section *": {
              "box-sizing": "border-box"
            },
            ".executive-container": {
              "max-width": "980px",
              "margin": "0 auto",
              "padding": "0 24px"
            },
            ".guide-header": {
              "text-align": "center",
              "max-width": "800px",
              "margin": "0 auto 40px"
            },
            ".header-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-top": "50px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "border": "1px solid #bfdbfe"
            },
            ".header-title": {
              "font-size": "2.6rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.025em",
              "margin": "0 0 16px 0",
              "line-height": "1.2",
              "text-align": "center"
            },
            ".header-lead": {
              "font-size": "1.15rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.6"
            },
            ".disclaimer-banner": {
              "background": "#fffbeb",
              "border": "1px solid #fde68a",
              "border-radius": "14px",
              "padding": "20px 24px",
              "display": "flex",
              "gap": "16px",
              "align-items": "center",
              "margin-bottom": "45px",
              "box-shadow": "0 2px 8px rgba(245, 158, 11, 0.05)"
            },
            ".disclaimer-icon": {
              "color": "#d97706",
              "flex-shrink": "0",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#fef3c7",
              "padding": "10px",
              "border-radius": "10px"
            },
            ".disclaimer-text": {
              "font-size": "0.95rem",
              "color": "#92400e",
              "line-height": "1.6"
            },
            ".guide-block": {
              "margin-bottom": "45px"
            },
            ".block-title": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "20px",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "border-bottom": "2px solid #e2e8f0",
              "padding-bottom": "12px"
            },
            ".title-icon": {
              "color": "#2563eb",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#eff6ff",
              "width": "36px",
              "height": "36px",
              "border-radius": "8px",
              "border": "1px solid #dbeafe"
            },
            ".guide-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "32px",
              "margin-bottom": "20px",
              "box-shadow": "0 4px 20px rgba(0, 0, 0, 0.03)"
            },
            ".card-header": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "margin-bottom": "18px",
              "flex-wrap": "wrap",
              "gap": "12px"
            },
            ".card-header h3, .guide-card h3": {
              "font-size": "1.25rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "0"
            },
            ".status-tag": {
              "font-size": "0.75rem",
              "font-weight": "700",
              "padding": "6px 14px",
              "border-radius": "100px",
              "letter-spacing": "0.5px",
              "text-transform": "uppercase"
            },
            ".status-tag.critical": {
              "background": "#fff7ed",
              "color": "#c2410c",
              "border": "1px solid #ffedd5"
            },
            ".card-details-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(280px, 1fr))",
              "gap": "16px",
              "margin": "24px 0"
            },
            ".detail-box": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "padding": "20px",
