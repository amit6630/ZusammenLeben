            "&": {
              "background": "#f8fafc",
              "color": "#1e293b",
              "padding": "120px 16px 72px",
              "font-family": "'Inter Tight', sans-serif",
              "line-height": "1.65"
            },
            ".zl-wrap": {
              "max-width": "780px",
              "margin": "0 auto"
            },
            ".zl-wrap--wide": {
              "max-width": "1100px"
            },
            ".zl-crumbs ol": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "6px",
              "list-style": "none",
              "padding": "0",
              "margin": "0 0 18px",
              "font-size": "14px",
              "color": "#475569"
            },
            ".zl-crumbs li + li::before": {
              "content": "\"/\"",
              "margin-right": "6px",
              "color": "#94a3b8"
            },
            ".zl-crumbs a": {
              "color": "#1d4ed8",
              "text-decoration": "underline",
              "text-underline-offset": "2px"
            },
            ".zl-tag": {
              "display": "inline-block",
              "padding": "4px 12px",
              "border-radius": "999px",
              "background": "#e0e7ff",
              "color": "#0c2c68",
              "font-size": "13px",
              "font-weight": "700",
              "letter-spacing": ".04em",
              "text-transform": "uppercase"
            },
            "h1": {
              "margin": "14px 0 12px",
              "font-size": "clamp(30px, 4.4vw, 46px)",
              "line-height": "1.12",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-.01em"
            },
            ".zl-lead": {
              "font-size": "clamp(17px, 1.6vw, 20px)",
              "color": "#475569",
              "margin": "0 0 14px",
              "line-height": "1.5 !important"
            },
            ".zl-meta": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "14px",
              "font-size": "14px",
              "color": "#475569",
              "margin-bottom": "26px"
            },
            ".zl-card": {
              "background": "#fff",
              "border": "1px solid #e2e8f0",
              "border-radius": "18px",
              "padding": "clamp(22px, 3.4vw, 40px)",
              "box-shadow": "0 10px 30px -18px rgba(15, 23, 42, .25)"
            },
            ".zl-body h2": {
              "font-size": "clamp(21px, 2.2vw, 26px)",
              "line-height": "1.25",
              "margin": "30px 0 10px",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-body h2:first-child": {
              "margin-top": "0"
            },
            ".zl-body p, .zl-body li": {
              "font-size": "17px"
            },
            ".zl-body p": {
              "margin": "0 0 14px"
            },
            "p, li, summary": {
              "line-height": "1.65 !important"
            },
            ".zl-body ul, .zl-body ol": {
              "padding-left": "1.3em",
              "margin": "0 0 16px"
            },
            ".zl-body li": {
              "margin-bottom": "8px"
            },
            ".zl-body a": {
              "color": "#1d4ed8",
              "text-decoration": "underline",
              "text-underline-offset": "2px",
              "font-weight": "600"
            },
            ".zl-body a[target=\"_blank\"]::after": {
              "content": "\" \\2197\"",
              "font-weight": "400"
            },
            ".zl-note": {
              "margin": "20px 0",
              "padding": "16px 18px",
              "border-radius": "12px",
              "background": "#eff6ff",
              "border-left": "4px solid #1d4ed8",
              "font-size": "16px"
            },
            ".zl-note--warn": {
              "background": "#fffbeb",
              "border-left-color": "#b45309"
            },
            ".zl-faq": {
              "margin-top": "28px"
            },
            ".zl-faq h2": {
              "margin-bottom": "12px"
            },
            ".zl-faq details": {
              "border": "1px solid #e2e8f0",
              "border-radius": "12px",
              "background": "#fff",
              "margin-bottom": "10px"
            },
            ".zl-faq summary": {
              "cursor": "pointer",
              "padding": "14px 18px",
              "font-weight": "700",
              "font-size": "17px",
              "list-style-position": "inside"
            },
            ".zl-faq details p": {
              "padding": "0 18px 16px",
              "margin": "0",
              "font-size": "16px",
              "color": "#475569"
            },
            ".zl-disclaimer": {
              "margin-top": "18px",
              "font-size": "14px",
              "color": "#475569"
            },
            ".zl-cta": {
              "margin-top": "28px",
              "padding": "clamp(22px, 3vw, 32px)",
              "border-radius": "18px",
              "background": "#0c2c68",
              "color": "#fff"
            },
            ".zl-cta h2": {
              "color": "#fff",
              "margin": "0 0 6px",
              "font-size": "24px",
              "font-weight": "750"
            },
            ".zl-cta p": {
              "margin": "0 0 16px",
              "color": "#dbeafe"
            },
            ".zl-btns": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "10px"
            },
            ".zl-btn": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-height": "46px",
              "padding": "10px 20px",
              "border-radius": "999px",
              "font-weight": "700",
              "text-decoration": "none !important"
            },
            ".zl-btn--wa": {
              "background": "#0f7a3e",
              "color": "#fff !important"
            },
            ".zl-btn--light": {
              "background": "#fff",
              "color": "#0c2c68 !important"
            },
            ".zl-btn--ghost": {
              "border": "2px solid #0c2c68",
              "color": "#0c2c68 !important",
              "background": "transparent"
            },
            ".zl-related": {
              "margin-top": "36px"
            },
            ".zl-related h2": {
              "font-size": "22px",
              "margin": "0 0 12px",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fill, minmax(250px, 1fr))",
              "gap": "16px"
            },
            ".zl-tile": {
              "display": "flex",
              "flex-direction": "column",
              "gap": "8px",
              "padding": "20px",
              "background": "#fff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "color": "#1e293b !important",
              "text-decoration": "none !important",
              "transition": "transform .2s, box-shadow .2s, border-color .2s"
            },
            ".zl-tile:hover": {
              "transform": "translateY(-3px)",
              "border-color": "#93c5fd",
              "box-shadow": "0 14px 30px -20px rgba(29, 78, 216, .45)"
            },
            ".zl-tile h2, .zl-tile h3": {
              "font-size": "18px",
              "line-height": "1.3",
              "margin": "0",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-tile p": {
              "margin": "0",
              "font-size": "15px",
              "color": "#475569"
            },
            ".zl-tile .zl-more": {
              "margin-top": "auto",
              "font-weight": "700",
              "color": "#1d4ed8",
              "font-size": "15px"
            },
            ".zl-ico": {
              "width": "42px",
              "height": "42px",
              "border-radius": "12px",
              "display": "grid",
              "place-items": "center",
              "background": "#e0e7ff",
              "color": "#0c2c68"
            },
            ".zl-ico svg": {
              "width": "22px",
              "height": "22px"
            },
            ".zl-hub-head": {
              "margin-bottom": "26px",
              "max-width": "760px"
            },
            ".zl-hub-head .zl-lead": {
              "margin-bottom": "0"
            },
            ".zl-comm-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(230px, 1fr))",
              "gap": "16px",
              "margin": "6px 0 0"
            },
            ".zl-comm-grid .zl-tile:hover": {
              "transform": "none",
              "box-shadow": "none",
              "border-color": "#e2e8f0"
            },
            "@media (max-width: 575px)": {
              ".zl-grid": {
                "grid-template-columns": "1fr 1fr",
                "gap": "10px"
              },
              ".zl-grid .zl-tile": {
                "padding": "14px",
                "gap": "8px"
              },
              ".zl-grid .zl-tile p, .zl-grid .zl-tile .zl-more": {
                "display": "none"
              },
              ".zl-grid .zl-tile h2, .zl-grid .zl-tile h3": {
                "font-size": "15px"
              },
              ".zl-grid .zl-ico": {
                "width": "34px",
                "height": "34px"
              },
              ".zl-comm-grid": {
                "gap": "10px"
              },
              ".zl-comm-grid .zl-tile": {
                "padding": "16px"
              },
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            }
