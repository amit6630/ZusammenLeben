              "letter-spacing": "1px",
              "display": "block",
              "margin-top": "24px",
              "margin-bottom": "8px",
              "color": "#64748b",
              "text-transform": "uppercase"
            },
            ".resource-link": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "padding": "12px 0",
              "border-bottom": "1px solid #e2e8f0",
              "color": "#2563eb",
              "text-decoration": "none",
              "font-size": "0.95rem",
              "transition": "opacity 0.2s"
            },
            ".resource-link:hover": {
              "opacity": "0.8",
              "text-decoration": "underline"
            },
            ".resource-link strong": {
              "color": "#0f172a"
            },
            ".icon-danger": {
              "color": "#ef4444",
              "display": "inline-flex"
            },
            ".icon-primary": {
              "color": "#2563eb",
              "display": "inline-flex"
            },
            ".notice-highlight": {
              "background": "#f0f9ff",
              "border-left": "4px solid #0284c7",
              "padding": "16px 20px",
              "border-radius": "8px",
