              "padding-left": "20px",
              "color": "#475569"
            },
            ".action-steps-list li": {
              "margin-bottom": "10px",
              "font-size": "0.95rem",
              "line-height": "1.6"
            },
            ".rule-box": {
              "padding": "20px 24px",
              "border-radius": "14px",
              "margin": "20px 0 0 0",
              "width": "100%"
            },
