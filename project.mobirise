              "margin": "0",
              "font-size": "0.93rem",
              "line-height": "1.6"
            },
            ".three-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(260px, 1fr))",
              "gap": "20px"
            },
            ".guide-mini-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "24px",
