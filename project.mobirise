    "guide-bank-account-phone.html": {
      "settings": {
        "title": "Bank Account, Phone and Broadcasting Fee: First Steps",
        "order": "25",
        "meta_descr": "How people from Ukraine open a German bank account, choose a phone contract safely, and deal with the broadcasting fee letter. Practical tips and rights.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-bank-account-phone.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-bank-account-phone.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-bank-account-phone.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-bank-account-phone.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-bank-account-phone.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Bank Account, Phone and Broadcasting Fee: First Steps\" />\n<meta property=\"og:description\" content=\"How people from Ukraine open a German bank account, choose a phone contract safely, and deal with the broadcasting fee letter. Practical tips and rights.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-bank-account-phone.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Bank Account, Phone Contract and Broadcasting Fee\",\"description\":\"How people from Ukraine open a German bank account, choose a phone contract safely, and deal with the broadcasting fee letter. Practical tips and rights.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/guide-bank-account-phone.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-bank-account-phone.html\",\"wordCount\":1099,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can a bank refuse me an account?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Everyone living legally in the EU has the right to a basic account (Basiskonto). A bank may only refuse it for narrow legal reasons.\"}},{\"@type\":\"Question\",\"name\":\"Do I have to pay the broadcasting fee?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Every household pays it, but people who receive Jobcenter benefits can apply for an exemption.\"}},{\"@type\":\"Question\",\"name\":\"Can I cancel a contract signed at the door?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"In most cases yes, within 14 days. Cancel in writing and keep proof.\"}},{\"@type\":\"Question\",\"name\":\"What is a P-Konto?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A protected account that keeps a basic amount of money safe from seizure if you have debts. Any account can be converted.\"}},{\"@type\":\"Question\",\"name\":\"Do I need liability insurance?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It is not compulsory, but strongly recommended. It is inexpensive and covers damage you cause to others.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Bank Account, Phone Contract and Broadcasting Fee\",\"item\":\"https://zusammenleben-ukraine.de/guide-bank-account-phone.html\"}]}]}</script>"
      },
