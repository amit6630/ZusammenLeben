    "guide-clubs-volunteering.html": {
      "settings": {
        "title": "Clubs and Volunteering in Germany: Find Your Community",
        "order": "42",
        "meta_descr": "Sports clubs, music, choirs, fire brigade, church groups and volunteering: how Ukrainian families in Upper Franconia find friends and feel at home.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-clubs-volunteering.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-clubs-volunteering.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-clubs-volunteering.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-clubs-volunteering.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-clubs-volunteering.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Clubs and Volunteering in Germany: Find Your Community\" />\n<meta property=\"og:description\" content=\"Sports clubs, music, choirs, fire brigade, church groups and volunteering: how Ukrainian families in Upper Franconia find friends and feel at home.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-clubs-volunteering.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Clubs and Volunteering: Finding Your Place\",\"description\":\"Sports clubs, music, choirs, fire brigade, church groups and volunteering: how Ukrainian families in Upper Franconia find friends and feel at home.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/guide-clubs-volunteering.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-clubs-volunteering.html\",\"wordCount\":1030,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can I volunteer with a §24 permit?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Volunteering is allowed. Report expense allowances to the Jobcenter if you receive benefits.\"}},{\"@type\":\"Question\",\"name\":\"Who pays my child's sports club?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The education and participation package pays a monthly amount if your family receives benefits.\"}},{\"@type\":\"Question\",\"name\":\"Do I need good German to join a club?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Clubs are a great place to learn German. Most welcome new members warmly.\"}},{\"@type\":\"Question\",\"name\":\"Can adults join the volunteer fire brigade?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, after basic training. Children and teenagers can join the youth fire brigade.\"}},{\"@type\":\"Question\",\"name\":\"How do I find clubs near me?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Check the town website, notice boards, the local newspaper, or ask the school and neighbours.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Clubs and Volunteering: Finding Your Place\",\"item\":\"https://zusammenleben-ukraine.de/guide-clubs-volunteering.html\"}]}]}</script>"
      },
