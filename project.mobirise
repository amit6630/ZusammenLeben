              "height": "44px",
              "border-radius": "10px",
              "background": "#eff6ff",
              "color": "#2563eb",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "margin-bottom": "16px",
              "border": "1px solid #dbeafe"
            },
            ".service-card h3": {
              "font-size": "1.1rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".service-card p": {
