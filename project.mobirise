              "color": "#64748b",
              "margin": "0",
              "line-height": "1.5"
            },
            ".details-cards-stack": {
              "display": "flex",
              "flex-direction": "column",
              "gap": "20px"
            },
            ".detail-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "28px",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.02)"
            },
            ".detail-card.highlight-card": {
              "background": "linear-gradient(180deg, #ffffff 0%, #faf5ff 100%)",
              "border-color": "#e9d5ff"
            },
            ".card-title-group": {
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "margin-bottom": "14px"
            },
            ".card-title-group h3": {
              "font-size": "1.2rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0"
            },
            ".card-title-icon": {
              "width": "36px",
              "height": "36px",
              "border-radius": "8px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "flex-shrink": "0"
            },
            ".card-title-icon.blue": {
              "background": "#eff6ff",
              "color": "#2563eb",
              "border": "1px solid #dbeafe"
            },
            ".card-title-icon.green": {
              "background": "#f0fdf4",
              "color": "#16a34a",
              "border": "1px solid #bbf7d0"
            },
            ".card-title-icon.amber": {
              "background": "#fffbeb",
              "color": "#d97706",
              "border": "1px solid #fde68a"
            },
            ".card-title-icon.purple": {
              "background": "#faf5ff",
              "color": "#9333ea",
              "border": "1px solid #f3e8ff"
            },
            ".detail-card p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin-bottom": "12px"
            },
            ".detail-card p:last-child": {
              "margin-bottom": "0"
            },
            ".alert-box": {
              "border-radius": "12px",
              "padding": "16px 20px",
              "display": "flex",
              "gap": "14px",
              "align-items": "flex-start",
              "margin-top": "18px",
              "font-size": "0.9rem",
              "line-height": "1.5"
            },
            ".alert-box.red-alert": {
              "background": "#fef2f2",
              "border": "1px solid #fecaca",
              "color": "#991b1b"
            },
            ".alert-icon": {
              "color": "#dc2626",
              "flex-shrink": "0",
              "margin-top": "2px"
            },
            ".anna-cta-block": {
              "text-align": "center",
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "20px",
              "padding": "40px 24px",
              "box-shadow": "0 4px 20px rgba(0, 0, 0, 0.03)"
            },
            ".anna-cta-block h3": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "0 0 6px 0"
            },
            ".anna-cta-block p": {
              "font-size": "0.95rem",
              "color": "#64748b",
              "margin": "0 0 24px 0"
            },
            ".anna-profile-section .mbr-section-btn": {
              "display": "flex",
              "justify-content": "center",
              "gap": "14px",
              "flex-wrap": "wrap",
              "margin": "0"
            },
            ".anna-profile-section .btn.custom-btn": {
              "padding": "14px 28px !important",
              "border-radius": "100px !important",
              "font-weight": "700 !important",
              "font-size": "0.95rem !important",
              "display": "inline-flex !important",
              "align-items": "center !important",
              "justify-content": "center !important",
              "gap": "10px !important",
              "transition": "all 0.25s ease !important",
              "text-decoration": "none !important",
              "border-width": "1px !important"
            },
            ".anna-profile-section .btn.whatsapp-btn": {
              "background-color": "#25d366 !important",
              "border-color": "#25d366 !important",
              "color": "#ffffff !important",
              "box-shadow": "0 4px 12px rgba(37, 211, 102, 0.2) !important"
            },
            ".anna-profile-section .btn.whatsapp-btn:hover": {
              "background-color": "#20bd5a !important",
              "border-color": "#20bd5a !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 6px 18px rgba(37, 211, 102, 0.3) !important"
            },
            ".anna-profile-section .btn.email-btn": {
              "background-color": "#2563eb !important",
              "border-color": "#2563eb !important",
              "color": "#ffffff !important",
              "box-shadow": "0 4px 12px rgba(37, 99, 235, 0.2) !important"
            },
            ".anna-profile-section .btn.email-btn:hover": {
              "background-color": "#1d4ed8 !important",
              "border-color": "#1d4ed8 !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 6px 18px rgba(37, 99, 235, 0.3) !important"
            },
            "@media (max-width: 768px)": {
              ".anna-profile-section": {
                "padding": "50px 0 !important"
              },
              ".anna-container": {
                "padding": "0 16px"
              },
              ".anna-hero-card": {
                "padding": "24px 20px"
              },
              ".anna-hero-grid": {
                "flex-direction": "column",
                "align-items": "center",
                "text-align": "center",
                "gap": "20px"
              },
              ".anna-profile-img": {
                "width": "160px",
                "height": "160px"
              },
              ".anna-name": {
                "font-size": "1.9rem"
              },
              ".anna-description-box": {
                "text-align": "left",
                "padding": "16px"
              },
              ".detail-card": {
                "padding": "20px 16px"
              },
              ".anna-profile-section .mbr-section-btn": {
                "flex-direction": "column",
                "width": "100%"
              },
              ".anna-profile-section .btn.custom-btn": {
