        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            },
            "a[href*=\"thebwas.com\"]": {
              "text-decoration": "underline",
              "text-underline-offset": "3px"
            },
            ".soc-item a": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-width": "44px",
              "min-height": "44px"
            },
            ".item-wrap a": {
              "word-break": "normal !important",
              "overflow-wrap": "normal !important",
              "hyphens": "auto",
              "-webkit-hyphens": "auto"
            },
            "@media (max-width: 767px)": {
              ".lists-wrapper": {
                "display": "grid !important",
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr)",
                "column-gap": "16px"
              },
              ".lists-wrapper .list-wrap": {
                "width": "auto !important",
                "max-width": "none !important",
                "margin": "0 !important"
              },
              ".lists-wrapper .item-wrap a": {
                "overflow-wrap": "break-word !important"
              }
            }
          },
          "_name": "footer01",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 scalem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"50\" max=\"400\" step=\"10\" value=\"150\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Lists\" name=\"showLists\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"list\" min=\"1\" max=\"5\" step=\"1\" value=\"4\" condition=\"showLists\">\n        <input type=\"color\" title=\"List Active Color\" value=\"#ffffff\" name=\"activeList\" condition=\"showLists\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Social Active Color\" value=\"#FF5753\" name=\"active\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#635d60\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#0c2c68\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#292325\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            \n            <!-- עמודת טקסט וכותרת ראשית -->\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showTitle || showText || showButtons || showLogo\">\n                <div class=\"content-wrapper\">\n                    <!-- תוספת המקום ללוגו -->\n                    <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"ZusammenLeben\" width=\"171\" height=\"171\">\n                        </a>\n                    </div>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>\n                        ZUSAMMENLEBEN\n                    </b></h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                        Supporting integration, housing, and community connection for newcomers and locals in the area.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-phone mbr-iconfont mbr-iconfont-btn\"></span>\n                            Contact Us\n                        </a></div>\n                </div>\n            </div>\n\n            <!-- עמודות הקישורים -->\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLists\">\n                <div class=\"lists-wrapper\">\n                    <div class=\"list-wrap\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Home</a></li>\n                            <li class=\"item-wrap\"><a href=\"family-stories.html\" class=\"text-white\">Family Stories</a></li>\n                            <li class=\"item-wrap\"><a href=\"services.html\" class=\"text-white\">Services</a></li>\n                            <li class=\"item-wrap\"><a href=\"request-assistance.html\" class=\"text-white\">Request Assistance</a></li>\n                            <li class=\"item-wrap\"><a href=\"community.html\" class=\"text-white\">Community</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"living-in-germany.html\" class=\"text-white\">Living in Germany</a></li>\n                            <li class=\"item-wrap\"><a href=\"glossary.html\" class=\"text-white\">Glossary</a></li>\n                            <li class=\"item-wrap\"><a href=\"learning-german.html\" class=\"text-white\">Learning German</a></li>\n                            <li class=\"item-wrap\"><a href=\"refugee-rights.html\" class=\"text-white\">Refugee Rights</a></li>\n                            <li class=\"item-wrap\"><a href=\"guides.html\" class=\"text-white\">Guides</a></li>\n                            <li class=\"item-wrap\"><a href=\"anna-shishoili.html\" class=\"text-white text-primary\">Anna Cheishvili</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 2\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"how-to-help.html\" class=\"text-white\">How Can You Help</a></li>\n                            <li class=\"item-wrap\"><a href=\"social-activity.html\" class=\"text-white\">Social Activity</a></li>\n                            <li class=\"item-wrap\"><a href=\"faq.html\" class=\"text-white\">FAQ</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Areas We Serve</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 3\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"emergency.html\" class=\"text-white\">Emergency</a></li>\n                            <li class=\"item-wrap\"><a href=\"Contact.html\" class=\"text-white\">Contact</a></li>\n                            <li class=\"item-wrap\"><a href=\"https://wa.me/380637004615\" class=\"text-white\" target=\"_blank\" rel=\"noopener\">WhatsApp Support</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Location</a></li>\n                            <li class=\"item-wrap\"><a href=\"impressum.html\" class=\"text-white\">Legal Notice</a></li>\n                            <li class=\"item-wrap\"><a href=\"privacy.html\" class=\"text-white\">Privacy Policy</a></li>\n                            <li class=\"item-wrap\"><a href=\"usingtheweb.html\" class=\"text-white\">Terms of Use</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 4\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Privacy Policy</a></li>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Terms of Use</a></li>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Impressum</a></li>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Official Site</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- אזור זכויות יוצרים ורשתות חברתיות -->\n            <div class=\"col-12\" mbr-if=\"showSocial || showCopy\">\n                <div class=\"copy-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://wa.me/380637004615\" target=\"_blank\" rel=\"noopener\" aria-label=\"WhatsApp\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-whatsapp\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"mailto:zusammenleben.de@gmail.com\" aria-label=\"E-Mail\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy, .social-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\">\n                        © Copyright 2026 Zusammenleben - All Rights Reserved · Website by <a href=\"https://thebwas.com/\" class=\"text-white\">Amit Shechter</a>\n                    </p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "footer01-2b",
          "_isUserblock": true,
          "_cid": "vqpoIpWKp1",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "usingtheweb.html": {
      "settings": {
        "title": "Terms of Use | ZusammenLeben",
        "order": "28",
        "meta_descr": "Terms of use for zusammenleben-ukraine.de: general information without legal advice, voluntary support without guarantees, external links and copyright.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/usingtheweb.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/usingtheweb.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/usingtheweb.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/usingtheweb.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/usingtheweb.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Terms of Use | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"Terms of use for zusammenleben-ukraine.de: general information without legal advice, voluntary support without guarantees, external links and copyright.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/usingtheweb.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"url\":\"https://zusammenleben-ukraine.de/usingtheweb.html\",\"name\":\"Terms of Use\",\"inLanguage\":\"en\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Terms of Use\",\"item\":\"https://zusammenleben-ukraine.de/usingtheweb.html\"}]}]}</script>"
      },
      "components": [
        {
          "_name": "amenu1",
          "_sourceTheme": "solarm5",
          "_styles": {
            "& when (@sticky)": {
              "position": "sticky !important",
              "top": "0 !important",
              "z-index": "1030 !important",
              "width": "100%",
              "nav.navbar, .navbar-dropdown, .navbar-fixed-top": {
                "position": "relative !important"
              }
            },
            "& when not (@sticky)": {
              "position": "relative",
              "z-index": "1030",
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "body": {
              "position": "relative"
            },
            ".navbar": {
              "min-height": "80px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".navbar-logo img": {
                "width": "auto"
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-logo img": {
                  "height": "2.5rem !important"
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".container, .container-fluid": {
              "display": "flex",
              "flex-wrap": "wrap",
              "margin": "auto",
              "align-items": "center"
            },
            ".brand-container": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding-bottom": "4px",
              "padding-top": "4px",
              "width": "100%"
            },
            ".navbar-brand": {
              "min-height": "60px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "5px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              "display": "flex",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            "@media (min-width: 992px)": {
              ".brand-container": {
                "width": "auto",
                "flex-grow": "1",
                "justify-content": "flex-start"
              },
              ".navbar-brand": {
                "padding-right": "20px"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "padding-top": "10px",
                "padding-bottom": "10px",
                "display": "flex !important",
                "flex-basis": "auto",
                ".navbar-nav": {
                  "margin": "0 -0.5em",
                  "flex-grow": "1",
                  "justify-content": "flex-end"
                },
                ".mbr-section-btn": {
                  "margin-left": "auto"
                },
                "min-width": "0"
              },
              ".desktop-only-flex": {
                "display": "flex !important",
                "justify-content": "flex-end",
                "align-items": "center",
                "gap": "3px",
                "flex-wrap": "nowrap",
                "margin-left": "auto",
                "padding-right": "20px"
              },
              ".mobile-only": {
                "display": "none !important"
              },
              ".navbar-nav": {
                "flex-wrap": "wrap !important",
                "row-gap": "2px"
              },
              ".navbar-buttons .btn": {
                "padding": ".6rem 1.2rem !important",
                "font-size": "15px !important",
                "min-height": "44px"
              },
              ".navbar-nav .nav-link": {
                "padding-left": ".45em !important",
                "padding-right": ".45em !important"
              }
            },
            "@media (max-width: 991px)": {
              ".navbar": {
                "min-height": "60px !important"
              },
              ".desktop-only-flex": {
                "display": "none !important"
              },
              ".mobile-only": {
                "display": "flex !important",
                "align-items": "center",
                "gap": "0 !important",
                "background": "rgba(0, 0, 0, 0.03)",
                "padding": "0 4px !important",
                "border-radius": "20px",
                "border": "1px solid #eaeaea",
                "margin-left": "auto",
                "margin-right": "8px"
              },
              ".navbar-brand": {
                "flex-shrink": "initial",
                "flex-basis": "auto",
                "word-break": "break-word",
                "padding-right": "0.5rem",
                "min-height": "50px"
              },
              ".navbar-logo img": {
                "height": "2.3rem !important"
              },
              ".navbar-collapse": {
                "padding-top": "2px !important",
                "padding-bottom": "5px !important",
                "border-top": "1px solid #dddddd",
                "background": "@menuBgColor"
              },
              ".navbar-nav .nav-item": {
                "margin": "0 !important"
              },
              ".navbar-nav .nav-link": {
                "padding": "0.2rem 0.4rem !important",
                "font-size": "0.82rem !important",
                "margin": "0 !important",
                "justify-content": "center"
              },
              ".dropdown-menu .dropdown-item": {
                "padding": "0.25rem 0.8rem !important",
                "font-size": "0.78rem !important",
                "margin": "0 !important",
                "text-align": "center"
              },
              ".mbr-section-btn": {
                "display": "flex",
                "flex-wrap": "wrap",
                "justify-content": "center",
                "padding": "2px 0",
                ".btn": {
                  "padding": "0.35rem 0.8rem !important",
                  "font-size": "0.82rem !important",
                  "flex-grow": "1",
                  "margin": "4px 15px"
                }
              },
              "nav.opened .dropdown-menu": {
                "top": "0"
              },
              ".mobile-only .lang-link": {
                "min-width": "30px",
                "min-height": "40px",
                "justify-content": "center"
              },
              ".navbar-caption": {
                "word-break": "normal !important",
                "overflow-wrap": "normal !important"
              },
              "button.navbar-toggler": {
                "width": "44px !important",
                "height": "44px !important",
                "padding": "13px 9px !important"
              },
              "button.navbar-toggler .hamburger": {
                "position": "relative",
                "width": "26px",
                "height": "18px"
              }
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border-bottom": "1px solid #e6e6e6",
              "padding": "0.5rem 1.8rem",
              "transition": "all 0.25s ease-in-out",
              "&:hover, &:focus": {
                "background": "@primaryColor !important",
                "color": "white !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom": "none",
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative",
              "transition": "all 0.2s",
              "&:hover": {
                "color": "@primaryColor !important"
              }
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".navbar-buttons": {
              "text-align": "center",
              "min-width": "0",
              "flex-shrink": "0"
            },
            ".card-wrap": {
              "display": "flex",
              "align-items": "center",
              "padding": "2px 4px",
              "min-width": "auto"
            },
            ".contacts-menu .mbr-iconfont": {
              "color": "#ffffff"
            },
            ".contacts-menu .menu-divider": {
              "color": "#ccc",
              "font-weight": "300",
              "margin": "0 1px"
            },
            ".desktop-only-flex .mbr-iconfont": {
              "color": "@iconsContactColor"
            },
            ".flags-menu": {
              "display": "flex",
              "align-items": "center",
              "gap": "5px",
              "background": "rgba(0, 0, 0, 0.03)",
              "padding": "3px 8px",
              "border-radius": "20px",
              "border": "1px solid #eaeaea"
            },
            ".lang-link": {
              "display": "flex",
              "align-items": "center",
              "gap": "3px",
              "text-decoration": "none !important",
              "transition": "transform 0.2s ease",
              "&:hover": {
                "transform": "scale(1.08)"
              },
              "white-space": "nowrap",
              "flex-shrink": "0"
            },
            ".lang-code": {
              "font-size": "12px",
              "font-weight": "700",
              "color": "#333",
              "letter-spacing": "0.5px",
              "white-space": "nowrap"
            },
            ".flag-divider": {
              "color": "#ccc",
              "font-size": "12px"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "28px",
              "height": "18px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "flex-basis": "auto",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "26px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "0",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "top": "6px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "top": "6px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "top": "12px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "6px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "6px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".navbar-nav .nav-link": {
              "white-space": "nowrap"
            },
            ".navbar-buttons .btn": {
              "white-space": "nowrap"
            },
            "@media (min-width: 992px) and (max-width: 1399px)": {
              ".navbar-nav .nav-link, .navbar-nav .dropdown-item": {
                "font-size": "14px !important"
              },
              ".navbar-nav .nav-link": {
                "padding-left": ".3em !important",
                "padding-right": ".3em !important"
              },
              ".navbar-buttons .btn": {
                "padding": ".55rem 1rem !important",
                "font-size": "14px !important"
              },
              ".navbar-nav": {
                "margin": "0 !important"
              }
            },
            "@media (min-width: 992px) and (max-width: 1199px)": {
              ".navbar-buttons .btn": {
                "padding": ".5rem .8rem !important",
                "font-size": "13.5px !important"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" global once=\"menu\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\" checked>\n        <input type=\"checkbox\" title=\"Contact Phone\" name=\"showPhone\" checked>\n        <input type=\"checkbox\" title=\"Contact Address\" name=\"showAddress\" checked>\n        <input type=\"color\" title=\"Contact Icons Color\" name=\"iconsContactColor\" value=\"#0c2c68\" condition=\"showPhone || showAddress\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#222222\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#222222\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                 'navbar-expand-lg':!collapsed,\n                 'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"brand-container\">\n                <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"ZusammenLeben\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                    <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-caption-wrap\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"index.html\" data-app-placeholder=\"Type Text\">Zusammen Leben</a></span>\n                </div>\n                \n                <!-- פרטי קשר + דגלים (מוצגים אך ורק במחשב) -->\n                <div class=\"contacts-menu desktop-only-flex\">\n                    <div class=\"card-wrap\">\n                        <span class=\"mobi-mbri-phone mobi-mbri\" style=\"font-size: 18px;\"></span>\n                        <div class=\"card-box\">\n                            <p class=\"mbr-text mbr-fonts-style mb-0 display-4\"><a href=\"tel:+380 63 700 4615\" class=\"text-primary\">+380 63 700 4615</a></p>\n                        </div>\n                    </div>\n                    \n                    <span class=\"menu-divider\">|</span>\n\n                    <div class=\"card-wrap\">\n                        <span class=\"mdi-maps-place\" style=\"font-size: 22px;\"></span>\n                        <div class=\"card-box\">\n                            <p class=\"mbr-text mbr-fonts-style mb-0 display-4\">Konradsreuth Alte Hofer Str. 1</p>\n                        </div>\n                    </div>\n\n                    <span class=\"menu-divider\">|</span>\n\n<div class=\"flags-menu\">\n    <a href=\"de/index.html\" title=\"Deutsch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/de.png\" srcset=\"https://flagcdn.com/48x36/de.png 2x\" alt=\"Germany\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">DE</span>\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"index.html\" title=\"English\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/us.png\" srcset=\"https://flagcdn.com/48x36/us.png 2x\" alt=\"United States\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">EN</span>\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"ua/index.html\" title=\"Українська\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/ua.png\" srcset=\"https://flagcdn.com/48x36/ua.png 2x\" alt=\"Ukraine\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">UA</span>\n    </a>\n</div>\n                </div>\n\n                <!-- דגלים בלבד שיופיעו אך ורק בטלפון ליד ההמבורגר -->\n<div class=\"flags-menu mobile-only\">\n    <a href=\"de/index.html\" title=\"Deutsch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/de.png\" alt=\"DE\" width=\"18\" height=\"13\">\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"index.html\" title=\"English\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/us.png\" alt=\"EN\" width=\"18\" height=\"13\">\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"ua/index.html\" title=\"Українська\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/ua.png\" alt=\"UA\" width=\"18\" height=\"13\">\n    </a>\n</div>\n                <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                    <div class=\"hamburger\">\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                </button>\n            </div>\n            \n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-scroll-collapse>\n                <ul class=\"navbar-nav nav-dropdown\" data-app-modern-menu=\"true\" mbr-menu><li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"index.html\" data-app-placeholder=\"Type Text\">Home</a>\n                    </li>\n    \n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">About Us</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"social-activity.html\" data-app-placeholder=\"Type Text\">Our Activity</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"anna-shishoili.html\" data-app-placeholder=\"Type Text\">Anna Cheishvili</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"services.html\" data-app-placeholder=\"Type Text\">Services</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"request-assistance.html\" data-app-placeholder=\"Type Text\">Request Assistance</a>\n                    </li>\n    \n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Living in Germany</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"glossary.html\" data-app-placeholder=\"Type Text\">Glossary</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"learning-german.html\" data-app-placeholder=\"Type Text\">Learning German</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"refugee-rights.html\" data-app-placeholder=\"Type Text\">Rights of Ukrainian Refugees</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"guides.html\">Guides & Articles</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"areasweserve.html\" data-app-placeholder=\"Type Text\">Areas We Serve</a>\n                    </li>\n\n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Community</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"community.html\" data-app-placeholder=\"Type Text\">Our Community</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"family-stories.html\" data-app-placeholder=\"Type Text\">Family Stories</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"faq.html#list01-b\" data-app-placeholder=\"Type Text\">FAQ</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"how-to-help.html\" data-app-placeholder=\"Type Text\">How Can you Help</a>\n                    </li>\n    \n                    <!-- Emergency - Highlighted in a separate prominent color -->\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link font-weight-bold display-4 text-primary\" href=\"emergency.html\" style=\"color: #c81e1e !important;\" data-app-placeholder=\"Type Text\">Emergency</a>\n                    </li></ul>\n                \n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary display-4\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">Contact Us</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
