            },
            ".guide-mini-card:hover": {
              "transform": "translateY(-3px)"
            },
            ".step-badge": {
              "width": "36px",
              "height": "36px",
              "border-radius": "50%",
              "background": "#eff6ff",
              "color": "#2563eb",
              "font-weight": "800",
              "font-size": "1.05rem",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "margin-bottom": "14px",
              "border": "1px solid #bfdbfe"
            },
            ".guide-mini-card h3": {
              "font-size": "1.05rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".guide-mini-card p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.55"
            },
