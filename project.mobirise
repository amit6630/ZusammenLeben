    "guide-house-rules-waste.html": {
      "settings": {
        "title": "House Rules, Waste Sorting and Neighbours in Germany",
        "order": "39",
        "meta_descr": "Quiet hours, waste separation, airing, stairwell cleaning and getting along with neighbours: the unwritten and written rules of living in a German apartment.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-house-rules-waste.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-house-rules-waste.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-house-rules-waste.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-house-rules-waste.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-house-rules-waste.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"House Rules, Waste Sorting and Neighbours in Germany\" />\n<meta property=\"og:description\" content=\"Quiet hours, waste separation, airing, stairwell cleaning and getting along with neighbours: the unwritten and written rules of living in a German apartment.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-house-rules-waste.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"House Rules, Waste Sorting and Good Neighbours\",\"description\":\"Quiet hours, waste separation, airing, stairwell cleaning and getting along with neighbours: the unwritten and written rules of living in a German apartment.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/guide-house-rules-waste.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-house-rules-waste.html\",\"wordCount\":1094,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"When are quiet hours?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Usually from 10 pm to 6 or 7 am, often also at lunchtime and all day on Sundays and holidays.\"}},{\"@type\":\"Question\",\"name\":\"What goes in the yellow bag?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Packaging made of plastic, metal and composite materials, such as drink cartons. Not paper or glass.\"}},{\"@type\":\"Question\",\"name\":\"How do I dispose of old furniture?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"As bulky waste, usually by appointment with the district waste service.\"}},{\"@type\":\"Question\",\"name\":\"How do I prevent mould?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Air several times a day with windows fully open for a few minutes, especially after cooking and showering.\"}},{\"@type\":\"Question\",\"name\":\"Can I have a dog?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Often only with the landlord's consent. Dogs must be registered and require a dog tax.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"House Rules, Waste Sorting and Good Neighbours\",\"item\":\"https://zusammenleben-ukraine.de/guide-house-rules-waste.html\"}]}]}</script>"
      },
