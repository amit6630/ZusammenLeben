              "font-size": "0.7rem",
              "background": "#2563eb",
              "color": "#ffffff",
              "padding": "2px 8px",
              "border-radius": "100px",
              "font-weight": "700"
            },
            ".town-row p": {
              "font-size": "0.88rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.45"
            },
