              "color": "#0c2c68 !important",
              "background": "transparent"
            },
            ".zl-related": {
              "margin-top": "36px"
            },
            ".zl-related h2": {
              "font-size": "22px",
              "margin": "0 0 12px",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fill, minmax(250px, 1fr))",
              "gap": "16px"
            },
            ".zl-tile": {
              "display": "flex",
              "flex-direction": "column",
              "gap": "8px",
              "padding": "20px",
              "background": "#fff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "color": "#1e293b !important",
              "text-decoration": "none !important",
              "transition": "transform .2s, box-shadow .2s, border-color .2s"
            },
            ".zl-tile:hover": {
              "transform": "translateY(-3px)",
              "border-color": "#93c5fd",
              "box-shadow": "0 14px 30px -20px rgba(29, 78, 216, .45)"
            },
            ".zl-tile h2, .zl-tile h3": {
              "font-size": "18px",
              "line-height": "1.3",
              "margin": "0",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-tile p": {
              "margin": "0",
              "font-size": "15px",
              "color": "#475569"
            },
            ".zl-tile .zl-more": {
              "margin-top": "auto",
              "font-weight": "700",
              "color": "#1d4ed8",
              "font-size": "15px"
            },
            ".zl-ico": {
              "width": "42px",
              "height": "42px",
              "border-radius": "12px",
              "display": "grid",
              "place-items": "center",
              "background": "#e0e7ff",
              "color": "#0c2c68"
            },
            ".zl-ico svg": {
              "width": "22px",
              "height": "22px"
            },
            ".zl-hub-head": {
              "margin-bottom": "26px",
              "max-width": "760px"
            },
            ".zl-hub-head .zl-lead": {
              "margin-bottom": "0"
            },
            ".zl-cat": {
              "display": "flex",
              "align-items": "center",
              "gap": "10px",
              "font-size": "22px",
              "font-weight": "750",
              "color": "#0f172a",
              "margin": "28px 0 12px"
            },
            ".zl-count": {
              "display": "inline-grid",
              "place-items": "center",
              "min-width": "28px",
              "height": "28px",
              "padding": "0 8px",
              "border-radius": "999px",
              "background": "#e0e7ff",
              "color": "#0c2c68",
              "font-size": "14px",
              "font-weight": "700"
            },
            ".zl-rail": {
              "display": "flex",
              "gap": "16px",
              "overflow-x": "auto",
              "scroll-snap-type": "x mandatory",
              "overscroll-behavior-x": "contain",
              "padding": "4px 2px 16px",
              "scrollbar-width": "none"
            },
            ".zl-rail::-webkit-scrollbar": {
