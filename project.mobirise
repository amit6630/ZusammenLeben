    "glossary.html": {
      "settings": {
        "title": "German Glossary for Newcomers from Ukraine | ZusammenLeben",
        "order": "8",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/glossary.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/glossary.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/glossary.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/glossary.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/glossary.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"German Glossary for Newcomers from Ukraine | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"The German words you meet at the Jobcenter, town hall and school, explained simply: Anmeldung, Bescheid, Kaution, Widerspruch and many more.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/glossary.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"url\":\"https://zusammenleben-ukraine.de/glossary.html\",\"name\":\"German Glossary for Newcomers from Ukraine\",\"description\":\"The German words you meet at the Jobcenter, town hall and school, explained simply: Anmeldung, Bescheid, Kaution, Widerspruch and many more.\",\"inLanguage\":\"en\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"},\"about\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"German Glossary for Newcomers from Ukraine\",\"item\":\"https://zusammenleben-ukraine.de/glossary.html\"}]}]}</script>",
        "meta_descr": "The German words you meet at the Jobcenter, town hall and school, explained simply: Anmeldung, Bescheid, Kaution, Widerspruch and many more."
