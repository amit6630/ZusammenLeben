                "position": "relative !important"
              }
            },
            "& when not (@sticky)": {
              "position": "relative",
              "z-index": "1030",
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "body": {
              "position": "relative"
            },
            ".navbar": {
              "min-height": "80px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
