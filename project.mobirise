    "guide-health-insurance-doctor.html": {
      "settings": {
        "title": "Health Insurance and Doctors in Germany for Ukrainians",
        "order": "20",
        "meta_descr": "How health insurance works for people from Ukraine in Germany, how to choose a family doctor, and which numbers to call at night and in emergencies.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-health-insurance-doctor.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-health-insurance-doctor.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-health-insurance-doctor.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-health-insurance-doctor.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-health-insurance-doctor.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Health Insurance and Doctors in Germany for Ukrainians\" />\n<meta property=\"og:description\" content=\"How health insurance works for people from Ukraine in Germany, how to choose a family doctor, and which numbers to call at night and in emergencies.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-health-insurance-doctor.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Health Insurance and Seeing a Doctor in Germany\",\"description\":\"How health insurance works for people from Ukraine in Germany, how to choose a family doctor, and which numbers to call at night and in emergencies.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/guide-health-insurance-doctor.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-health-insurance-doctor.html\",\"wordCount\":1087,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Who pays my health insurance?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"If you receive Jobcenter benefits, the Jobcenter pays the contributions. If you work, you are insured through your employer.\"}},{\"@type\":\"Question\",\"name\":\"What number do I call when the doctor is closed?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Call 116 117 for the on-call medical service. In a life-threatening emergency call 112.\"}},{\"@type\":\"Question\",\"name\":\"Do I need a family doctor?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It is strongly recommended. The family doctor coordinates your care and refers you to specialists.\"}},{\"@type\":\"Question\",\"name\":\"Are my children insured too?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Children are insured through the Jobcenter or through family insurance at no extra cost.\"}},{\"@type\":\"Question\",\"name\":\"Is psychotherapy covered?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. After an initial consultation, psychotherapy is covered by statutory health insurance.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Health Insurance and Seeing a Doctor in Germany\",\"item\":\"https://zusammenleben-ukraine.de/guide-health-insurance-doctor.html\"}]}]}</script>"
      },
