    "guides.html": {
      "settings": {
        "title": "Guides for Ukrainian Families in Germany | ZusammenLeben",
        "order": "16",
        "meta_descr": "Practical guides for Ukrainian families in Upper Franconia: housing, Jobcenter letters, school, health, work, residence permit and everyday life.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guides.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guides.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guides.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guides.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guides.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Guides for Ukrainian Families in Germany | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"Practical guides for Ukrainian families in Upper Franconia: housing, Jobcenter letters, school, health, work, residence permit and everyday life.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guides.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"CollectionPage\",\"url\":\"https://zusammenleben-ukraine.de/guides.html\",\"name\":\"Guides for Ukrainian Families in Germany\",\"description\":\"Practical guides for Ukrainian families in Upper Franconia: housing, Jobcenter letters, school, health, work, residence permit and everyday life.\",\"inLanguage\":\"en\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"}},{\"@type\":\"ItemList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"url\":\"https://zusammenleben-ukraine.de/guide-finding-apartment.html\",\"name\":\"Finding an Apartment in Upper Franconia with Jobcenter Support\"},{\"@type\":\"ListItem\",\"position\":2,\"url\":\"https://zusammenleben-ukraine.de/guide-jobcenter-letters.html\",\"name\":\"How to Read and Answer Jobcenter Letters\"},{\"@type\":\"ListItem\",\"position\":3,\"url\":\"https://zusammenleben-ukraine.de/guide-school-kita-bavaria.html\",\"name\":\"Registering Your Child for School or Kita in Bavaria\"},{\"@type\":\"ListItem\",\"position\":4,\"url\":\"https://zusammenleben-ukraine.de/guide-health-insurance-doctor.html\",\"name\":\"Health Insurance and Seeing a Doctor in Germany\"},{\"@type\":\"ListItem\",\"position\":5,\"url\":\"https://zusammenleben-ukraine.de/guide-recognition-qualifications.html\",\"name\":\"Getting Your Ukrainian Qualifications Recognised in Germany\"},{\"@type\":\"ListItem\",\"position\":6,\"url\":\"https://zusammenleben-ukraine.de/guide-integration-course.html\",\"name\":\"The Integration Course: Your Fastest Route to German\"},{\"@type\":\"ListItem\",\"position\":7,\"url\":\"https://zusammenleben-ukraine.de/guide-residence-permit-24.html\",\"name\":\"Your §24 Residence Permit: What You Need to Know\"},{\"@type\":\"ListItem\",\"position\":8,\"url\":\"https://zusammenleben-ukraine.de/guide-first-job.html\",\"name\":\"Finding Your First Job in Germany\"},{\"@type\":\"ListItem\",\"position\":9,\"url\":\"https://zusammenleben-ukraine.de/guide-bank-account-phone.html\",\"name\":\"Bank Account, Phone Contract and Broadcasting Fee\"},{\"@type\":\"ListItem\",\"position\":10,\"url\":\"https://zusammenleben-ukraine.de/guide-driving-licence.html\",\"name\":\"Driving in Germany with a Ukrainian Licence\"}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"}]}]}</script>"
      },
