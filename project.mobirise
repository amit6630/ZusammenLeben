          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            ".regional-executive-section": {
              "padding": "70px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.6",
              "direction": "ltr",
              "text-align": "left"
            },
            ".regional-executive-section *": {
              "box-sizing": "border-box"
            },
            ".executive-container": {
              "max-width": "1050px",
              "margin": "0 auto",
              "padding": "0 24px",
              "width": "100%"
            },
            ".executive-header": {
              "text-align": "center",
              "max-width": "780px",
              "margin": "0 auto 50px"
            },
            ".header-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-top": "50px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "border": "1px solid #bfdbfe"
            },
            ".header-title": {
              "font-size": "2.6rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.02em",
              "margin": "0 0 16px 0",
              "line-height": "1.2"
            },
            ".header-lead": {
              "font-size": "1.2rem",
              "color": "#475569",
              "margin": "0"
            },
            ".section-block": {
              "margin-bottom": "60px"
            },
            ".block-title": {
              "font-size": "1.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "24px",
              "display": "flex",
              "align-items": "center",
              "gap": "10px"
            },
            ".title-icon": {
              "font-size": "1.3rem",
              "display": "inline-flex",
              "align-items": "center"
            },
            ".philosophy-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "40px",
              "position": "relative",
              "overflow": "hidden",
              "margin-bottom": "60px",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.03)"
            },
            ".card-accent-line": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "6px",
              "height": "100%",
              "background": "#2563eb"
            },
            ".philosophy-card h2": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "margin": "0 0 14px 0",
              "color": "#0f172a"
            },
            ".philosophy-card p": {
              "font-size": "1.08rem",
              "color": "#334155",
              "margin": "0",
              "line-height": "1.7"
            },
            ".pillars-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(280px, 1fr))",
              "gap": "20px"
            },
            ".pillar-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "14px",
              "padding": "24px",
              "display": "flex",
              "gap": "16px",
              "transition": "transform 0.2s ease, box-shadow 0.2s ease",
              "min-width": "0"
            },
            ".pillar-card:hover": {
              "transform": "translateY(-3px)",
              "box-shadow": "0 12px 24px rgba(0, 0, 0, 0.04)",
              "border-color": "#cbd5e1"
            },
            ".pillar-icon": {
              "font-size": "1.8rem",
              "flex-shrink": "0",
              "background": "#f1f5f9",
              "width": "48px",
              "height": "48px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "border-radius": "10px"
            },
            ".pillar-content h3": {
              "font-size": "1.1rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 6px 0"
            },
            ".pillar-content p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.5"
            },
            ".map-layout-grid": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "gap": "24px",
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "20px",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.02)"
            },
            ".map-wrapper": {
              "width": "100%",
              "min-height": "420px",
              "border-radius": "12px",
              "overflow": "hidden",
              "border": "1px solid #cbd5e1"
            },
            ".towns-scroll-list": {
              "max-height": "420px",
              "overflow-y": "auto",
              "padding-right": "8px",
              "display": "flex",
              "flex-direction": "column",
              "gap": "12px"
            },
            ".town-row": {
              "background": "#f8fafc",
              "border": "1px solid #f1f5f9",
              "padding": "14px 16px",
              "border-radius": "10px"
            },
            ".town-row.focus-row": {
              "background": "#eff6ff",
              "border-color": "#bfdbfe"
            },
            ".town-name": {
              "font-size": "1rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "4px",
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center"
            },
            ".badge-tag": {
              "font-size": "0.7rem",
              "background": "#2563eb",
              "color": "#ffffff",
              "padding": "2px 8px",
              "border-radius": "100px",
              "font-weight": "700"
            },
            ".town-row p": {
              "font-size": "0.88rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.45"
            },
            ".towns-footnote": {
              "font-size": "0.88rem",
              "color": "#64748b",
              "margin-top": "14px",
              "font-style": "italic"
            },
            ".reality-comparison-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(280px, 1fr))",
              "gap": "24px"
            },
            ".reality-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "30px",
              "position": "relative"
            },
            ".reality-card.advantages": {
              "border-top": "4px solid #16a34a"
            },
            ".reality-card.considerations": {
              "border-top": "4px solid #d97706"
            },
            ".reality-badge": {
              "font-size": "0.7rem",
              "font-weight": "800",
              "color": "#16a34a",
              "letter-spacing": "1px",
              "margin-bottom": "8px"
            },
            ".warning-badge": {
              "color": "#d97706"
            },
            ".reality-card h3": {
              "font-size": "1.25rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "0 0 12px 0"
            },
            ".reality-card p": {
              "font-size": "0.98rem",
              "color": "#334155",
              "margin": "0",
              "line-height": "1.6"
            },
            ".scope-notice-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-left": "4px solid #64748b",
              "border-radius": "12px",
              "padding": "24px",
              "display": "flex",
              "gap": "16px",
              "margin-bottom": "50px"
            },
            ".notice-icon": {
              "font-size": "1.5rem",
              "flex-shrink": "0"
            },
            ".notice-body h4": {
              "font-size": "1rem",
              "font-weight": "700",
              "color": "#334155",
              "margin": "0 0 6px 0"
            },
            ".notice-body p": {
              "font-size": "0.92rem",
              "color": "#64748b",
              "margin": "0",
              "line-height": "1.5"
            },
            ".executive-cta-wrapper": {
              "text-align": "center"
            },
            ".regional-executive-section .btn-success": {
              "background-color": "#25d366 !important",
              "border-color": "#25d366 !important",
              "color": "#ffffff !important",
              "padding": "18px 36px !important",
              "border-radius": "100px !important",
              "font-weight": "700 !important",
              "font-size": "1.05rem !important",
              "display": "inline-flex !important",
              "align-items": "center !important",
              "justify-content": "center !important",
              "gap": "10px !important",
              "box-shadow": "0 8px 20px rgba(37, 211, 102, 0.2) !important",
              "transition": "all 0.25s ease !important",
              "text-decoration": "none !important",
              "max-width": "100%"
            },
            ".regional-executive-section .btn-success:hover": {
              "background-color": "#20bd5a !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 12px 25px rgba(37, 211, 102, 0.3) !important"
            },
            "@media (max-width: 900px)": {
              ".map-layout-grid": {
                "grid-template-columns": "1fr",
                "padding": "16px"
              },
              ".map-wrapper": {
                "min-height": "280px"
              },
              ".towns-scroll-list": {
                "max-height": "350px"
              }
            },
            "@media (max-width: 640px)": {
              ".regional-executive-section": {
                "padding": "40px 0 !important"
              },
              ".executive-container": {
                "padding": "0 16px"
              },
              ".executive-header": {
                "margin-bottom": "32px"
              },
              ".header-title": {
                "font-size": "1.8rem"
              },
              ".header-lead": {
                "font-size": "1rem"
              },
              ".section-block": {
                "margin-bottom": "40px"
              },
              ".block-title": {
                "font-size": "1.25rem"
              },
              ".philosophy-card": {
                "padding": "20px 16px 20px 22px",
                "margin-bottom": "40px"
              },
              ".philosophy-card h2": {
                "font-size": "1.2rem"
              },
              ".philosophy-card p": {
                "font-size": "0.98rem"
              },
              ".pillars-grid, .reality-comparison-grid": {
                "grid-template-columns": "1fr",
                "gap": "14px"
              },
              ".pillar-card": {
                "padding": "16px"
              },
              ".reality-card": {
                "padding": "20px 16px"
              },
              ".scope-notice-card": {
                "flex-direction": "row",
                "padding": "16px",
                "gap": "12px",
                "margin-bottom": "32px"
              },
              ".regional-executive-section .btn-success": {
                "width": "100% !important",
                "padding": "16px 20px !important",
                "font-size": "1rem !important"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            },
            "@media (max-width: 575px)": {
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            "@media (max-width: 767px)": {
              ".services-grid, .team-grid, .transparency-grid, .pillars-grid, .three-column-grid, .grid-3, .grid-2, .faq-grid, .survival-grid, .portal-grid-2, .city-directory-grid, .details-cards-stack, .two-column-grid, .levels-grid, .cert-grid, .benefits-grid, .links-grid, .timeline-wrapper": {
                "display": "flex !important",
                "flex-wrap": "nowrap !important",
                "flex-direction": "row !important",
                "grid-template-columns": "none !important",
                "gap": "12px !important",
                "overflow-x": "auto",
                "overscroll-behavior-x": "contain",
                "scroll-snap-type": "x mandatory",
                "padding": "4px 2px 14px !important",
                "scrollbar-width": "none"
              },
              ".services-grid::-webkit-scrollbar, .team-grid::-webkit-scrollbar, .transparency-grid::-webkit-scrollbar, .pillars-grid::-webkit-scrollbar, .three-column-grid::-webkit-scrollbar, .grid-3::-webkit-scrollbar, .grid-2::-webkit-scrollbar, .faq-grid::-webkit-scrollbar, .survival-grid::-webkit-scrollbar, .portal-grid-2::-webkit-scrollbar, .city-directory-grid::-webkit-scrollbar, .details-cards-stack::-webkit-scrollbar, .two-column-grid::-webkit-scrollbar, .levels-grid::-webkit-scrollbar, .cert-grid::-webkit-scrollbar, .benefits-grid::-webkit-scrollbar, .links-grid::-webkit-scrollbar, .timeline-wrapper::-webkit-scrollbar": {
                "display": "none"
              },
              ".services-grid > *, .team-grid > *, .transparency-grid > *, .pillars-grid > *, .three-column-grid > *, .grid-3 > *, .grid-2 > *, .faq-grid > *, .survival-grid > *, .portal-grid-2 > *, .city-directory-grid > *, .details-cards-stack > *, .two-column-grid > *, .levels-grid > *, .cert-grid > *, .benefits-grid > *, .links-grid > *, .timeline-wrapper > *": {
                "flex": "0 0 84% !important",
                "max-width": "84% !important",
                "min-width": "0",
                "margin": "0 !important",
                "scroll-snap-align": "start"
              },
              ".timeline-wrapper::before": {
                "display": "none !important"
              },
              ".metrics-section, .services-section, .process-section, .region-section, .team-section, .transparency-section, .cta-section": {
                "padding-top": "44px !important",
                "padding-bottom": "44px !important"
              },
              ".metrics-grid": {
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr) !important",
                "gap": "10px !important"
              },
              ".word-grid": {
                "max-height": "62vh",
                "overflow-y": "auto",
                "overscroll-behavior": "contain",
                "padding-right": "4px"
              },
              ".metrics-grid > *": {
                "min-width": "0",
                "padding": "18px 10px !important"
              },
              ".metrics-grid .metric-value": {
                "font-size": "2rem !important"
              },
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_name": "article07",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"regional-executive-section\" id=\"regional-focus-page\">\n    <div class=\"executive-container\">\n        \n        <!-- Top Editorial Header -->\n        <header class=\"executive-header\">\n            <div class=\"header-tag\">REGIONAL SPECIALIZATION</div>\n            <h1 class=\"header-title\">Northern Bavaria &amp; Upper Franconia</h1>\n            <p class=\"header-lead\">\n                Why we operate in a single dedicated region — and how this targeted approach delivers tangible stability for arriving families.\n            </p>\n        </header>\n\n        <!-- Core Philosophy Card -->\n        <div class=\"executive-card philosophy-card\">\n            <div class=\"card-accent-line\"></div>\n            <h2>Depth Over Scale</h2>\n            <p>\n                We could easily claim that we operate across all of Germany. It would sound larger, but it would be far less effective in practice. Genuine, reliable guidance requires deep local familiarity: knowing the exact municipal clerk handling your file, which school has immediate capacity for Ukrainian-speaking children, which property management company is willing to work directly with the Jobcenter, and where actual vacant apartments exist right now.\n            </p>\n        </div>\n\n        <!-- 6 Core Pillars Grid with Icons -->\n        <div class=\"section-block\">\n            <h2 class=\"block-title\"><span class=\"title-icon\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 4px;\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm0-14c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z\"></path></svg></span> What Our Local Focus Enables</h2>\n            \n            <div class=\"pillars-grid\">\n                <div class=\"pillar-card\">\n                    <div class=\"pillar-icon\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 1L2 6v2h20V6L12 1zm-7 8v8h2V9H5zm4 0v8h2V9H9zm4 0v8h2V9h-2zm4 0v8h2V9h-2zM2 19v2h20v-2H2z\"></path></svg></div>\n                    <div class=\"pillar-content\">\n                        <h3>Municipal Authorities</h3>\n                        <p>We know how municipal offices operate in each town, their specific requirements, and realistic processing timelines.</p>\n                    </div>\n                </div>\n\n                <div class=\"pillar-card\">\n                    <div class=\"pillar-icon\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v2h2v-2h2v-2h-8.35zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z\"></path></svg></div>\n                    <div class=\"pillar-content\">\n                        <h3>Landlords &amp; Property Managers</h3>\n                        <p>Relationships built over years. Landlords who know us respond faster and are willing to enter an unfamiliar intake process.</p>\n                    </div>\n                </div>\n\n                <div class=\"pillar-card\">\n                    <div class=\"pillar-icon\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z\"></path></svg></div>\n                    <div class=\"pillar-content\">\n                        <h3>Local Jobcenter Operations</h3>\n                        <p>Accumulated experience regarding regional Jobcenter expectations, required documents, and approval standards.</p>\n                    </div>\n                </div>\n\n                <div class=\"pillar-card\">\n                    <div class=\"pillar-icon\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z\"></path></svg></div>\n                    <div class=\"pillar-content\">\n                        <h3>Educational Institutions</h3>\n                        <p>We know which schools and kindergartens accept new children and where dedicated language support classes are active.</p>\n                    </div>\n                </div>\n\n                <div class=\"pillar-card\">\n                    <div class=\"pillar-icon\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\"></path></svg></div>\n                    <div class=\"pillar-content\">\n                        <h3>Existing Community</h3>\n                        <p>New families arrive in an area where others have already successfully walked the exact same path.</p>\n                    </div>\n                </div>\n\n                <div class=\"pillar-card\">\n                    <div class=\"pillar-icon\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"></path></svg></div>\n                    <div class=\"pillar-content\">\n                        <h3>In-Person Support</h3>\n                        <p>Real physical presence — we can meet you locally, accompany you to official appointments, and inspect apartments in person.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Regional Interactive Map & Cities Overview -->\n        <div class=\"section-block\">\n            <h2 class=\"block-title\"><span class=\"title-icon\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 4px;\"><path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\"></path></svg></span> Key Municipalities in Our Operating Area</h2>\n            \n            <div class=\"map-layout-grid\">\n                <!-- Google Map Embed -->\n                <div class=\"map-wrapper\">\n                    <iframe title=\"Northern Bavaria Map\" src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d326922.3888365874!2d11.668512534575822!3d50.22237077651036!2m3!1f0!f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47a10fbc2867e0eb%3A0x10132fed3273ed0!2sOberfranken%2C%20Germany!5e0!3m2!1sen!2sde!4v1710000000000!5m2!1sen!2sde\" width=\"100%\" height=\"100%\" style=\"border:0;\" allowfullscreen loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\">\n                    </iframe>\n                </div>\n\n                <!-- Municipalities List -->\n                <div class=\"towns-scroll-list\" tabindex=\"0\" role=\"region\" aria-label=\"Towns we serve\">\n                    <div class=\"town-row focus-row\">\n                        <div class=\"town-name\">Helmbrechts <span class=\"badge-tag\">Main Hub</span></div>\n                        <p>A medium-sized town with essential local services and reasonable housing availability. A major hub of our activity.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Münchberg</div>\n                        <p>A location with good rail and road connectivity, local educational institutions, and resident services.</p>\n                    </div>\n\n                    <div class=\"town-row focus-row\">\n                        <div class=\"town-name\">Hof <span class=\"badge-tag\">Regional Center</span></div>\n                        <p>The largest city in the area. Highest concentration of authorities and services, diverse schools, comprehensive healthcare, and public transit.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Selb</div>\n                        <p>An industrial town with a history of integrating workers, local services, and available housing stock.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Wunsiedel</div>\n                        <p>A district town hosting local government authorities and regional services.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Arzberg</div>\n                        <p>A smaller settlement with a quiet residential character and housing availability that varies over time.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Marktredwitz</div>\n                        <p>A regional junction with solid commercial options, services, and transportation links.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Naila</div>\n                        <p>A town offering local services and educational institutions in a relatively rural atmosphere.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Kulmbach</div>\n                        <p>A city with local authorities, educational and medical services, and established infrastructure.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Bad Steben</div>\n                        <p>A small resort and health-spa town, quiet and more limited in general services.</p>\n                    </div>\n                </div>\n            </div>\n\n            <p class=\"towns-footnote\">\n                * And additional surrounding towns and communities across Northern Bavaria and Upper Franconia based on need and availability.\n            </p>\n        </div>\n\n        <!-- Regional Reality / Characteristics -->\n        <div class=\"section-block\">\n            <h2 class=\"block-title\"><span class=\"title-icon\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 4px;\"><path d=\"M14 9.5V6h3V4H7v2h3v3.5L3 13v2h2.2c.4 1.7 1.9 3 3.8 3s3.4-1.3 3.8-3H15c.4 1.7 1.9 3 3.8 3s3.4-1.3 3.8-3H21v-2l-7-3.5zM9 16c-.8 0-1.5-.7-1.5-1.5S8.2 13 9 13s1.5.7 1.5 1.5S9.8 16 9 16zm9.8 0c-.8 0-1.5-.7-1.5-1.5s.7-1.5 1.5-1.5 1.5.7 1.5 1.5-.7 1.5-1.5 1.5z\"></path></svg></span> What to Know About the Region</h2>\n            \n            <div class=\"reality-comparison-grid\">\n                <div class=\"reality-card advantages\">\n                    <div class=\"reality-badge\">BENEFITS</div>\n                    <h3>Clear Advantages</h3>\n                    <p>This is a rural-urban region, not a metropolis. The benefits are clear: lower housing costs than in major cities, a quiet environment, smaller educational institutions, and less administrative overload.</p>\n                </div>\n\n                <div class=\"reality-card considerations\">\n                    <div class=\"reality-badge warning-badge\">EXPECTATIONS</div>\n                    <h3>Factors to Keep in Mind</h3>\n                    <p>Public transport in smaller towns runs less frequently than in big cities, job opportunities are more limited, and travel to a neighboring city may be required for certain services. Families arriving from Kyiv or Kharkiv often experience a change in pace. We state this upfront to ensure accurate expectations.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Geographic Scope Clarification -->\n        <div class=\"scope-notice-card\">\n            <div class=\"notice-icon\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z\"></path></svg></div>\n            <div class=\"notice-body\">\n                <h4>Geographic Scope Clarification</h4>\n                <p>\n                    Our operational support does not extend fully across all of Germany. Inquiries from other regions will be reviewed, but in most cases, we cannot provide practical assistance outside our primary area. Where possible, we will try to refer you to a relevant local contact.\n                </p>\n            </div>\n        </div>\n\n        <!-- Direct WhatsApp Action Button -->\n        <div class=\"mbr-section-btn cta-buttons-wrapper\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn custom-btn whatsapp-btn display-4 btn-warning\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\">\n                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                WhatsApp Anna\n            </a></div>\n\n    </div>\n</section>",
          "_cid": "vqdOIvJmvE",
          "_anchor": "article07-1w",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            },
            "a[href*=\"thebwas.com\"]": {
              "text-decoration": "underline",
              "text-underline-offset": "3px"
            },
            ".soc-item a": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-width": "44px",
              "min-height": "44px"
            },
            ".item-wrap a": {
              "word-break": "normal !important",
              "overflow-wrap": "normal !important",
              "hyphens": "auto",
              "-webkit-hyphens": "auto"
            },
            "@media (max-width: 767px)": {
              ".lists-wrapper": {
                "display": "grid !important",
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr)",
                "column-gap": "16px"
              },
              ".lists-wrapper .list-wrap": {
                "width": "auto !important",
                "max-width": "none !important",
                "margin": "0 !important"
              },
              ".lists-wrapper .item-wrap a": {
                "overflow-wrap": "break-word !important"
              }
            }
          },
          "_name": "footer01",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 scalem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"50\" max=\"400\" step=\"10\" value=\"150\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Lists\" name=\"showLists\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"list\" min=\"1\" max=\"5\" step=\"1\" value=\"4\" condition=\"showLists\">\n        <input type=\"color\" title=\"List Active Color\" value=\"#ffffff\" name=\"activeList\" condition=\"showLists\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Social Active Color\" value=\"#FF5753\" name=\"active\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#635d60\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#0c2c68\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#292325\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            \n            <!-- עמודת טקסט וכותרת ראשית -->\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showTitle || showText || showButtons || showLogo\">\n                <div class=\"content-wrapper\">\n                    <!-- תוספת המקום ללוגו -->\n                    <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"ZusammenLeben\" width=\"171\" height=\"171\">\n                        </a>\n                    </div>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>\n                        ZUSAMMENLEBEN\n                    </b></h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                        Supporting integration, housing, and community connection for newcomers and locals in the area.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-phone mbr-iconfont mbr-iconfont-btn\"></span>\n                            Contact Us\n                        </a></div>\n                </div>\n            </div>\n\n            <!-- עמודות הקישורים -->\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLists\">\n                <div class=\"lists-wrapper\">\n                    <div class=\"list-wrap\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Home</a></li>\n                            <li class=\"item-wrap\"><a href=\"family-stories.html\" class=\"text-white\">Family Stories</a></li>\n                            <li class=\"item-wrap\"><a href=\"services.html\" class=\"text-white\">Services</a></li>\n                            <li class=\"item-wrap\"><a href=\"request-assistance.html\" class=\"text-white\">Request Assistance</a></li>\n                            <li class=\"item-wrap\"><a href=\"community.html\" class=\"text-white\">Community</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"living-in-germany.html\" class=\"text-white\">Living in Germany</a></li>\n                            <li class=\"item-wrap\"><a href=\"glossary.html\" class=\"text-white\">Glossary</a></li>\n                            <li class=\"item-wrap\"><a href=\"learning-german.html\" class=\"text-white\">Learning German</a></li>\n                            <li class=\"item-wrap\"><a href=\"refugee-rights.html\" class=\"text-white\">Refugee Rights</a></li>\n                            <li class=\"item-wrap\"><a href=\"guides.html\" class=\"text-white\">Guides</a></li>\n                            <li class=\"item-wrap\"><a href=\"anna-shishoili.html\" class=\"text-white text-primary\">Anna Cheishvili</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 2\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"how-to-help.html\" class=\"text-white\">How Can You Help</a></li>\n                            <li class=\"item-wrap\"><a href=\"social-activity.html\" class=\"text-white\">Social Activity</a></li>\n                            <li class=\"item-wrap\"><a href=\"faq.html\" class=\"text-white\">FAQ</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Areas We Serve</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 3\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"emergency.html\" class=\"text-white\">Emergency</a></li>\n                            <li class=\"item-wrap\"><a href=\"Contact.html\" class=\"text-white\">Contact</a></li>\n                            <li class=\"item-wrap\"><a href=\"https://wa.me/380637004615\" class=\"text-white\" target=\"_blank\" rel=\"noopener\">WhatsApp Support</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Location</a></li>\n                            <li class=\"item-wrap\"><a href=\"impressum.html\" class=\"text-white\">Legal Notice</a></li>\n                            <li class=\"item-wrap\"><a href=\"privacy.html\" class=\"text-white\">Privacy Policy</a></li>\n                            <li class=\"item-wrap\"><a href=\"usingtheweb.html\" class=\"text-white\">Terms of Use</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 4\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Privacy Policy</a></li>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Terms of Use</a></li>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Impressum</a></li>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Official Site</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- אזור זכויות יוצרים ורשתות חברתיות -->\n            <div class=\"col-12\" mbr-if=\"showSocial || showCopy\">\n                <div class=\"copy-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://wa.me/380637004615\" target=\"_blank\" rel=\"noopener\" aria-label=\"WhatsApp\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-whatsapp\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"mailto:zusammenleben.de@gmail.com\" aria-label=\"E-Mail\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy, .social-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\">\n                        © Copyright 2026 Zusammenleben - All Rights Reserved · Website by <a href=\"https://thebwas.com/\" class=\"text-white\">Amit Shechter</a>\n                    </p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "footer01-2b",
          "_isUserblock": true,
          "_cid": "vqpoIpWKp1",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
