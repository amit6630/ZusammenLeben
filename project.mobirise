@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Learning German in Upper Franconia\",\"item\":\"https://zusammenleben-ukraine.de/learning-german.html\"}]}]}</script>",
