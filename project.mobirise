              "color": "#0f172a",
              "letter-spacing": "-.01em"
            },
            ".zl-lead": {
              "font-size": "clamp(17px, 1.6vw, 20px)",
              "color": "#475569",
              "margin": "0 0 14px",
              "line-height": "1.5 !important"
            },
            ".zl-meta": {
              "display": "flex",
