                  "height": "2.5rem !important"
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".container, .container-fluid": {
              "display": "flex",
              "flex-wrap": "wrap",
              "margin": "auto",
              "align-items": "center"
            },
