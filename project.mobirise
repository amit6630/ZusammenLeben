              "background": "#2563eb",
              "color": "#ffffff",
              "border": "none"
            },
            ".city-pill.info-tag:hover": {
              "background": "#1d4ed8"
            },
            ".region-focus-card": {
              "max-width": "850px",
              "margin": "0 auto",
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "padding": "35px",
              "border-radius": "20px",
              "text-align": "center"
            },
            ".region-focus-card h3": {
              "font-size": "1.35rem",
              "color": "#0f172a",
              "font-weight": "700",
              "margin-bottom": "15px"
            },
            ".region-focus-card p": {
              "color": "#475569",
              "font-size": "1.05rem",
              "margin-bottom": "10px"
            },
            ".team-section": {
              "padding": "80px 16px",
              "background": "#f8fafc",
              "border-top": "1px solid #e2e8f0"
            },
            ".team-section .portal-container": {
              "max-width": "800px"
            },
            ".team-grid": {
              "display": "grid",
              "grid-template-columns": "1fr",
              "gap": "20px",
              "max-width": "1000px",
              "margin": "0 auto"
            },
            ".team-profile-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "padding": "24px",
              "border-radius": "16px",
              "display": "flex",
              "gap": "20px",
              "align-items": "flex-start",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.03)"
            },
            ".team-avatar": {
              "width": "75px",
              "height": "75px",
              "border-radius": "50%",
              "object-fit": "cover",
              "flex-shrink": "0",
              "border": "3px solid #f1f5f9"
            },
            ".team-info": {
              "flex": "1"
            },
            ".team-info h3": {
              "font-size": "1.15rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 6px 0"
            },
            ".role-pill": {
              "display": "inline-block",
              "font-size": "0.75rem",
              "font-weight": "700",
              "color": "#475569",
              "text-transform": "uppercase",
              "margin-bottom": "10px",
              "padding": "4px 10px",
              "background": "#f1f5f9",
              "border-radius": "12px",
              "letter-spacing": "0.5px"
            },
            ".role-pill.manager": {
              "color": "#2563eb",
              "background": "#eff6ff"
            },
            ".team-info p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.5"
            },
            ".transparency-section": {
              "padding": "100px 0",
              "background": "#ffffff"
            },
            ".transparency-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "30px",
              "max-width": "950px",
              "margin": "0 auto"
            },
            ".matrix-card": {
              "background": "#ffffff",
              "border-radius": "24px",
              "padding": "40px",
              "border": "1px solid #e2e8f0",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.04)"
            },
            ".free-card": {
              "border-top": "6px solid #16a34a"
            },
            ".external-card": {
              "border-top": "6px solid #d97706"
            },
            ".matrix-status": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#16a34a",
              "letter-spacing": "1px"
            },
            ".matrix-status.warning": {
              "color": "#d97706"
            },
            ".matrix-header h3": {
              "font-size": "1.35rem",
              "color": "#0f172a",
              "font-weight": "800",
              "margin-top": "6px",
              "margin-bottom": "24px"
            },
            ".matrix-list": {
              "list-style": "none",
              "padding": "0",
              "margin": "0 0 20px 0"
            },
            ".matrix-list li": {
              "font-size": "1rem",
              "color": "#334155",
              "margin-bottom": "14px",
              "display": "flex",
              "gap": "12px"
            },
            ".matrix-list li span": {
              "color": "#16a34a",
              "font-weight": "bold"
            },
            ".matrix-list.warning-list li span": {
              "color": "#d97706"
            },
            ".matrix-footer-note": {
              "font-size": "0.85rem",
              "color": "#64748b",
              "margin": "0"
            },
            ".cta-section": {
              "padding": "100px 0",
              "background": "#f8fafc",
              "border-top": "1px solid #e2e8f0"
            },
            ".cta-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "30px"
            },
            ".cta-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "padding": "45px",
              "border-radius": "28px",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.04)"
            },
            ".cta-families": {
              "background": "linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%)",
              "border-color": "#bae6fd"
            },
            ".cta-supporters": {
              "background": "linear-gradient(135deg, #ffffff 0%, #f8fafc 100%)"
            },
            ".cta-badge": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "1.2px"
            },
            ".cta-card h3": {
              "font-size": "1.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "10px 0 14px"
            },
            ".cta-card p": {
              "color": "#475569",
              "font-size": "1.05rem",
              "margin-bottom": "30px"
            },
            ".cta-card .mbr-section-btn": {
              "justify-content": "flex-start",
              "margin-bottom": "0"
            },
            "@media (max-width: 992px)": {
              ".hero-title": {
                "font-size": "2.8rem"
              },
              ".manifesto-card": {
                "padding": "35px"
              },
