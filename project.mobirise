    "guide-residence-permit-24.html": {
      "settings": {
        "title": "Residence Permit §24 for Ukrainians: What to Know Now",
        "order": "23",
        "meta_descr": "Temporary protection under §24 explained: validity, extensions, what to do before your card expires and when to contact the immigration office.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-residence-permit-24.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-residence-permit-24.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-residence-permit-24.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-residence-permit-24.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-residence-permit-24.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Residence Permit §24 for Ukrainians: What to Know Now\" />\n<meta property=\"og:description\" content=\"Temporary protection under §24 explained: validity, extensions, what to do before your card expires and when to contact the immigration office.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-residence-permit-24.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Your §24 Residence Permit: What You Need to Know\",\"description\":\"Temporary protection under §24 explained: validity, extensions, what to do before your card expires and when to contact the immigration office.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/guide-residence-permit-24.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-residence-permit-24.html\",\"wordCount\":999,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How long is temporary protection valid?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"At EU level it currently runs until 4 March 2027. Always check official sources, because extensions are decided separately.\"}},{\"@type\":\"Question\",\"name\":\"Can I work with a §24 permit?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Employment and self-employment are allowed from the first day.\"}},{\"@type\":\"Question\",\"name\":\"What if my card expires?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Contact the immigration office of your district before it expires and ask whether you need a new card or a confirmation.\"}},{\"@type\":\"Question\",\"name\":\"Can I travel to Ukraine?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Short visits are possible, but long stays can affect protection and benefits. Inform the Jobcenter and ask the immigration office before you travel.\"}},{\"@type\":\"Question\",\"name\":\"Can I switch to another residence permit?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, for example for employment, training or studies, if you meet the requirements. Get advice from migration counselling first.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Your §24 Residence Permit: What You Need to Know\",\"item\":\"https://zusammenleben-ukraine.de/guide-residence-permit-24.html\"}]}]}</script>"
      },
