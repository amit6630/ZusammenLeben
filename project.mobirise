            "&": {
              "background": "#f8fafc",
              "color": "#1e293b",
              "padding": "120px 16px 72px",
              "font-family": "'Inter Tight', sans-serif",
              "line-height": "1.65"
            },
            ".zl-wrap": {
              "max-width": "780px",
              "margin": "0 auto"
            },
            ".zl-wrap--wide": {
              "max-width": "1100px"
            },
            ".zl-crumbs ol": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "6px",
              "list-style": "none",
              "padding": "0",
              "margin": "0 0 18px",
              "font-size": "14px",
              "color": "#475569"
            },
            ".zl-crumbs li + li::before": {
              "content": "\"/\"",
              "margin-right": "6px",
              "color": "#94a3b8"
            },
            ".zl-crumbs a": {
              "color": "#1d4ed8",
              "text-decoration": "underline",
              "text-underline-offset": "2px"
            },
            ".zl-tag": {
              "display": "inline-block",
              "padding": "4px 12px",
              "border-radius": "999px",
              "background": "#e0e7ff",
              "color": "#0c2c68",
              "font-size": "13px",
              "font-weight": "700",
              "letter-spacing": ".04em",
              "text-transform": "uppercase"
            },
            "h1": {
              "margin": "14px 0 12px",
              "font-size": "clamp(30px, 4.4vw, 46px)",
              "line-height": "1.12",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-.01em"
            },
            ".zl-lead": {
              "font-size": "clamp(17px, 1.6vw, 20px)",
              "color": "#475569",
              "margin": "0 0 14px",
              "line-height": "1.5 !important"
            },
            ".zl-meta": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "14px",
              "font-size": "14px",
              "color": "#475569",
              "margin-bottom": "26px"
            },
            ".zl-card": {
              "background": "#fff",
              "border": "1px solid #e2e8f0",
              "border-radius": "18px",
              "padding": "clamp(22px, 3.4vw, 40px)",
              "box-shadow": "0 10px 30px -18px rgba(15, 23, 42, .25)"
            },
            ".zl-body h2": {
              "font-size": "clamp(21px, 2.2vw, 26px)",
              "line-height": "1.25",
              "margin": "30px 0 10px",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-body h2:first-child": {
              "margin-top": "0"
            },
            ".zl-body p, .zl-body li": {
              "font-size": "17px"
            },
            ".zl-body p": {
              "margin": "0 0 14px"
            },
            "p, li, summary": {
              "line-height": "1.65 !important"
            },
            ".zl-body ul, .zl-body ol": {
              "padding-left": "1.3em",
              "margin": "0 0 16px"
            },
            ".zl-body li": {
              "margin-bottom": "8px"
            },
            ".zl-body a": {
              "color": "#1d4ed8",
              "text-decoration": "underline",
              "text-underline-offset": "2px",
              "font-weight": "600"
            },
            ".zl-body a[target=\"_blank\"]::after": {
              "content": "\" \\2197\"",
              "font-weight": "400"
            },
            ".zl-note": {
              "margin": "20px 0",
              "padding": "16px 18px",
              "border-radius": "12px",
              "background": "#eff6ff",
              "border-left": "4px solid #1d4ed8",
              "font-size": "16px"
            },
            ".zl-note--warn": {
              "background": "#fffbeb",
              "border-left-color": "#b45309"
            },
            ".zl-faq": {
              "margin-top": "28px"
            },
            ".zl-faq h2": {
              "margin-bottom": "12px"
            },
            ".zl-faq details": {
              "border": "1px solid #e2e8f0",
              "border-radius": "12px",
              "background": "#fff",
              "margin-bottom": "10px"
            },
            ".zl-faq summary": {
              "cursor": "pointer",
              "padding": "14px 18px",
              "font-weight": "700",
              "font-size": "17px",
              "list-style-position": "inside"
            },
            ".zl-faq details p": {
              "padding": "0 18px 16px",
              "margin": "0",
              "font-size": "16px",
              "color": "#475569"
            },
            ".zl-disclaimer": {
              "margin-top": "18px",
              "font-size": "14px",
              "color": "#475569"
            },
            ".zl-cta": {
              "margin-top": "28px",
              "padding": "clamp(22px, 3vw, 32px)",
              "border-radius": "18px",
              "background": "#0c2c68",
              "color": "#fff"
            },
            ".zl-cta h2": {
              "color": "#fff",
              "margin": "0 0 6px",
              "font-size": "24px",
              "font-weight": "750"
            },
            ".zl-cta p": {
              "margin": "0 0 16px",
              "color": "#dbeafe"
            },
            ".zl-btns": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "10px"
            },
            ".zl-btn": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-height": "46px",
              "padding": "10px 20px",
              "border-radius": "999px",
              "font-weight": "700",
              "text-decoration": "none !important"
            },
            ".zl-btn--wa": {
              "background": "#0f7a3e",
              "color": "#fff !important"
            },
            ".zl-btn--light": {
              "background": "#fff",
              "color": "#0c2c68 !important"
            },
            ".zl-btn--ghost": {
              "border": "2px solid #0c2c68",
              "color": "#0c2c68 !important",
              "background": "transparent"
            },
            ".zl-related": {
              "margin-top": "36px"
            },
            ".zl-related h2": {
              "font-size": "22px",
              "margin": "0 0 12px",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fill, minmax(250px, 1fr))",
              "gap": "16px"
            },
            ".zl-tile": {
              "display": "flex",
              "flex-direction": "column",
              "gap": "8px",
              "padding": "20px",
              "background": "#fff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "color": "#1e293b !important",
              "text-decoration": "none !important",
              "transition": "transform .2s, box-shadow .2s, border-color .2s"
            },
            ".zl-tile:hover": {
              "transform": "translateY(-3px)",
              "border-color": "#93c5fd",
              "box-shadow": "0 14px 30px -20px rgba(29, 78, 216, .45)"
            },
            ".zl-tile h2, .zl-tile h3": {
              "font-size": "18px",
              "line-height": "1.3",
              "margin": "0",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-tile p": {
              "margin": "0",
              "font-size": "15px",
              "color": "#475569"
            },
            ".zl-tile .zl-more": {
              "margin-top": "auto",
              "font-weight": "700",
              "color": "#1d4ed8",
              "font-size": "15px"
            },
            ".zl-ico": {
              "width": "42px",
              "height": "42px",
              "border-radius": "12px",
              "display": "grid",
              "place-items": "center",
              "background": "#e0e7ff",
              "color": "#0c2c68"
            },
            ".zl-ico svg": {
              "width": "22px",
              "height": "22px"
            },
            ".zl-hub-head": {
              "margin-bottom": "26px",
              "max-width": "760px"
            },
            ".zl-hub-head .zl-lead": {
              "margin-bottom": "0"
            },
            ".zl-cat": {
              "display": "flex",
              "align-items": "center",
              "gap": "10px",
              "font-size": "22px",
              "font-weight": "750",
              "color": "#0f172a",
              "margin": "28px 0 12px"
            },
            ".zl-count": {
              "display": "inline-grid",
              "place-items": "center",
              "min-width": "28px",
              "height": "28px",
              "padding": "0 8px",
              "border-radius": "999px",
              "background": "#e0e7ff",
              "color": "#0c2c68",
              "font-size": "14px",
              "font-weight": "700"
            },
            ".zl-rail": {
              "display": "flex",
              "gap": "16px",
              "overflow-x": "auto",
              "scroll-snap-type": "x mandatory",
              "overscroll-behavior-x": "contain",
              "padding": "4px 2px 16px",
              "scrollbar-width": "none"
            },
            ".zl-rail::-webkit-scrollbar": {
              "display": "none"
            },
            ".zl-rail > .zl-tile": {
              "flex": "0 0 calc((100% - 48px) / 4)",
              "min-width": "230px",
              "scroll-snap-align": "start"
            },
            ".zl-rail .zl-tile h3": {
              "font-size": "17px"
            },
            ".zl-rail .zl-tile p": {
              "display": "-webkit-box",
              "-webkit-line-clamp": "3",
              "-webkit-box-orient": "vertical",
              "overflow": "hidden"
            },
            ".zl-comm-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(230px, 1fr))",
              "gap": "16px",
              "margin": "6px 0 0"
            },
            ".zl-comm-grid .zl-tile:hover": {
              "transform": "none",
              "box-shadow": "none",
              "border-color": "#e2e8f0"
            },
            "@media (max-width: 575px)": {
              ".zl-grid": {
                "grid-template-columns": "1fr 1fr",
                "gap": "10px"
              },
              ".zl-grid .zl-tile": {
                "padding": "14px",
                "gap": "8px"
              },
              ".zl-grid .zl-tile p, .zl-grid .zl-tile .zl-more": {
                "display": "none"
              },
              ".zl-grid .zl-tile h2, .zl-grid .zl-tile h3": {
                "font-size": "15px"
              },
              ".zl-grid .zl-ico": {
                "width": "34px",
                "height": "34px"
              },
              ".zl-rail > .zl-tile": {
                "flex-basis": "72%",
                "min-width": "0",
                "padding": "14px"
              },
              ".zl-rail .zl-tile p": {
                "-webkit-line-clamp": "2",
                "font-size": "14px"
              },
              ".zl-cat": {
                "font-size": "19px",
                "margin-top": "22px"
              },
              ".zl-comm-grid": {
                "gap": "10px"
              },
              ".zl-comm-grid .zl-tile": {
                "padding": "16px"
              },
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            }
          },
          "_name": "article08",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"zl-page\">\n<div class=\"zl-wrap\">\n<nav class=\"zl-crumbs\" aria-label=\"Breadcrumb\"><ol><li><a href=\"index.html\">Home</a></li><li><a href=\"guides.html\">Guides</a></li><li aria-current=\"page\">Your §24 Residence Permit: What You Need to Know</li></ol></nav>\n<header>\n<span class=\"zl-tag\">Guides</span>\n<h1>Your §24 Residence Permit: What You Need to Know</h1>\n<p class=\"zl-lead\">Most people who fled Ukraine to Germany hold a residence permit for temporary protection under section 24 of the Residence Act. The rules have been extended several times. Here is what matters for your family.</p>\n<p class=\"zl-meta\"><span>Updated: <time datetime=\"2026-10-26\">26 October 2026</time></span><span>5 min read</span><span>ZusammenLeben</span></p>\n</header>\n<article class=\"zl-card zl-body\"><h2>What temporary protection is</h2>\n<p>When the full-scale war began in 2022, the European Union activated the Temporary Protection Directive for the first time. In Germany it is implemented through section 24 of the Residence Act (<em>Aufenthaltsgesetz</em>). Most people who fled Ukraine to Germany hold a residence permit for temporary protection under this section. It is a collective protection: you do not need to go through an individual asylum procedure, and you receive rights quickly.</p>\n<h2>What §24 gives you</h2>\n<ul>\n<li>The right to live in Germany while temporary protection applies in the EU.</li>\n<li>The right to work, as an employee or self-employed, from the first day. The permit states \"Erwerbstätigkeit erlaubt\".</li>\n<li>Access to integration and language courses, school, vocational training and studies.</li>\n<li>Health care and, if needed, social benefits.</li>\n<li>Travel within the Schengen area for short stays, with a valid passport and the residence permit.</li>\n</ul>\n<h2>Who it covers</h2>\n<p>It covers Ukrainian citizens who lived in Ukraine before 24 February 2022 and their family members, and some other groups such as people with international protection in Ukraine. Third-country nationals who only had a temporary residence in Ukraine are treated differently; they should get individual advice.</p>\n<h2>How long is it valid?</h2>\n<p>Temporary protection is decided at EU level and has been extended several times. At the time of writing it runs until <strong>4 March 2027</strong>. Germany has in the past extended existing permits automatically by regulation, so the date printed on your card does not always match the real validity. Check the official sources below, keep every letter from the immigration office (<em>Ausländerbehörde</em>), and save the official notice of an extension on your phone. It helps if an employer, landlord or bank questions the date.</p>\n<div class=\"zl-note zl-note--warn\"><strong>Important:</strong> if your card expires soon, contact the immigration office of your district (<em>Landratsamt</em>) in time and ask whether you need a new card or a confirmation. Do not travel abroad with an expired card without checking first.</div>\n<h2>Your documents</h2>\n<p>The permit is issued as an electronic residence card (<em>elektronischer Aufenthaltstitel</em>, eAT), a plastic card with your photo and fingerprints. Until it is ready, you receive a provisional certificate (<em>Fiktionsbescheinigung</em>), which also allows you to work. Keep your Ukrainian passport valid: for many procedures and for travel you need it in addition to the card. If it expires, contact the Ukrainian consulate in Germany early, as appointments can take time. If you move within Germany, inform the immigration office and the citizens' office.</p>\n<h2>New arrivals</h2>\n<p>People who arrive from Ukraine now register at the citizens' office of their town and apply for a residence permit at the immigration office of the district. Bring your passport or other identity documents, proof of where you lived in Ukraine before the war if you have it, biometric photos and your registration certificate. Benefits and access to work depend on this registration, so do it in the first days. Rules for new arrivals have changed over time, so ask the immigration office which benefits apply to you.</p>\n<h2>Family members and children born in Germany</h2>\n<p>Close family members who lived in Ukraine and arrive later can apply for the same protection at the immigration office after registering their address. Bring documents that show the family relationship, such as marriage or birth certificates. If a child is born in Germany, first register the birth at the registry office (<em>Standesamt</em>) of the town where the child was born, then apply for a residence document for the child at the immigration office and add the child to your benefit and health insurance records.</p>\n<h2>Moving to another town</h2>\n<p>Some permits come with a residence condition (<em>Wohnsitzauflage</em>) that ties you to a federal state or district. It is printed on the card or on a supplementary sheet. Before you move, ask the immigration office whether your permit has one and how to change it. A condition can often be lifted if you have a job, a training place or a family reason in another place. Moving without approval can cause problems with benefits and registration.</p>\n<h2>Travel</h2>\n<p>With a valid passport and residence permit you can travel within the Schengen area for short stays. Visits to Ukraine are possible, but long stays outside Germany can affect your protection and benefits. If you receive benefits, inform the Jobcenter before any trip and ask whether it is allowed. When in doubt, ask the immigration office before you leave, not after you return.</p>\n<h2>Thinking long term</h2>\n<p>Temporary protection is, as the name says, temporary. If you plan to stay, it is worth looking at other residence permits early. Common routes are a permit for employment or for skilled workers, a permit for vocational training or studies, or later a settlement permit after several years of legal residence with work, German and secured income. Requirements and deadlines change, so get advice from a migration counselling service before you apply. Switching too early or too late can both have disadvantages.</p>\n<p>Language certificates, a stable job, recognised qualifications and German school certificates for your children all strengthen your position for any future permit. The integration course and work are therefore the best preparation, whatever the EU decides.</p>\n<h2>Where to get independent advice</h2>\n<p>Migration counselling for adults (<em>Migrationsberatung für erwachsene Zuwanderer</em>, MBE) and the youth migration services (<em>Jugendmigrationsdienste</em>) are free. In Upper Franconia they are run by welfare organisations such as Caritas, Diakonie and the German Red Cross. For legal questions, a lawyer specialising in migration law can help; with a low income you can apply for legal advice assistance at the local court.</p>\n<h2>How we help</h2>\n<p>We help families understand letters from the immigration office, prepare documents and keep deadlines. We do not give legal advice, but we connect you with counselling services and accompany you where possible. <a href=\"request-assistance.html\">Ask for help</a>.</p>\n<h2>Useful official sources</h2>\n<ul>\n<li><a href=\"https://www.make-it-in-germany.com/en/visa-residence/types/ukraine\" target=\"_blank\" rel=\"noopener\">Make it in Germany: residence for people from Ukraine</a></li>\n<li><a href=\"https://www.germany4ukraine.de/EN/online-services/seite_node.html\" target=\"_blank\" rel=\"noopener\">Germany4Ukraine: online services and authorities</a></li>\n<li><a href=\"https://www.bamf.de/EN/Startseite/startseite_node.html\" target=\"_blank\" rel=\"noopener\">Federal Office for Migration and Refugees (BAMF)</a></li>\n</ul>\n<p class=\"zl-disclaimer\">General information, not legal advice. Rules change; always check the official sources linked above.</p>\n</article>\n<div class=\"zl-faq zl-body\"><h2>Frequently asked questions</h2>\n<details><summary>How long is temporary protection valid?</summary><p>At EU level it currently runs until 4 March 2027. Always check official sources, because extensions are decided separately.</p></details>\n<details><summary>Can I work with a §24 permit?</summary><p>Yes. Employment and self-employment are allowed from the first day.</p></details>\n<details><summary>What if my card expires?</summary><p>Contact the immigration office of your district before it expires and ask whether you need a new card or a confirmation.</p></details>\n<details><summary>Can I travel to Ukraine?</summary><p>Short visits are possible, but long stays can affect protection and benefits. Inform the Jobcenter and ask the immigration office before you travel.</p></details>\n<details><summary>Can I switch to another residence permit?</summary><p>Yes, for example for employment, training or studies, if you meet the requirements. Get advice from migration counselling first.</p></details>\n</div>\n<div class=\"zl-cta\"><h2>Need personal help?</h2><p>Our volunteers answer in Ukrainian, Russian, German and English. Free of charge.</p><div class=\"zl-btns\"><a class=\"zl-btn zl-btn--wa\" href=\"https://wa.me/380637004615\" target=\"_blank\" rel=\"noopener\">Message us on WhatsApp</a><a class=\"zl-btn zl-btn--light\" href=\"Contact.html\">Contact form</a></div></div>\n<div class=\"zl-related\"><h2>More guides</h2><div class=\"zl-grid\">\n<a class=\"zl-tile\" href=\"guide-anmeldung.html\"><span class=\"zl-ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><circle cx=\"9\" cy=\"11\" r=\"2\"/><path d=\"M6 16c1-2 5-2 6 0M14 10h4M14 13h3\"/></svg></span><h3>Anmeldung: Registering Your Address in Germany</h3><span class=\"zl-more\">Read the guide →</span></a>\n<a class=\"zl-tile\" href=\"guide-jobcenter-letters.html\"><span class=\"zl-ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 7l9 6 9-6\"/></svg></span><h3>How to Read and Answer Jobcenter Letters</h3><span class=\"zl-more\">Read the guide →</span></a>\n<a class=\"zl-tile\" href=\"guide-ukrainian-documents.html\"><span class=\"zl-ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><circle cx=\"9\" cy=\"11\" r=\"2\"/><path d=\"M6 16c1-2 5-2 6 0M14 10h4M14 13h3\"/></svg></span><h3>Keeping Your Ukrainian Documents Valid in Germany</h3><span class=\"zl-more\">Read the guide →</span></a>\n</div><p style=\"margin-top:14px\"><a class=\"zl-btn zl-btn--ghost\" href=\"guides.html\">All guides</a></p></div>\n</div>\n</section>",
