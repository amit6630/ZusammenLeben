              "margin-top": "auto",
              "font-weight": "700",
              "color": "#1d4ed8",
              "font-size": "15px"
            },
            ".zl-ico": {
              "width": "42px",
              "height": "42px",
              "border-radius": "12px",
              "display": "grid",
              "place-items": "center",
              "background": "#e0e7ff",
