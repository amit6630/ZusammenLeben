    "guide-finding-apartment.html": {
      "settings": {
        "title": "Finding an Apartment in Upper Franconia with the Jobcenter",
        "order": "17",
        "meta_descr": "Step by step: how Ukrainian families find a flat in Upper Franconia, get Jobcenter approval for the rent and avoid the most common mistakes.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-finding-apartment.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-finding-apartment.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-finding-apartment.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-finding-apartment.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-finding-apartment.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Finding an Apartment in Upper Franconia with the Jobcenter\" />\n<meta property=\"og:description\" content=\"Step by step: how Ukrainian families find a flat in Upper Franconia, get Jobcenter approval for the rent and avoid the most common mistakes.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-finding-apartment.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Finding an Apartment in Upper Franconia with Jobcenter Support\",\"description\":\"Step by step: how Ukrainian families find a flat in Upper Franconia, get Jobcenter approval for the rent and avoid the most common mistakes.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/guide-finding-apartment.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-finding-apartment.html\",\"wordCount\":1051,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can I sign a lease before the Jobcenter approves it?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"You can, but you carry the risk. If the Jobcenter later finds the rent too high, it may only pay the appropriate part. Always get written approval first.\"}},{\"@type\":\"Question\",\"name\":\"Who pays the deposit?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"In most cases the Jobcenter grants the deposit as a loan, repaid in small monthly instalments from your benefits.\"}},{\"@type\":\"Question\",\"name\":\"How fast must I register my new address?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Within two weeks of moving in, at the citizens' office of your town, using the landlord's confirmation.\"}},{\"@type\":\"Question\",\"name\":\"Can I move to another district?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Only if your residence permit has no residence condition, or if the immigration office approves the change. Ask before you search in another district.\"}},{\"@type\":\"Question\",\"name\":\"What if the apartment has no kitchen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"That is common in Germany. Ask the Jobcenter about the initial furnishing allowance before buying, or ask us about donated kitchen equipment.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Finding an Apartment in Upper Franconia with Jobcenter Support\",\"item\":\"https://zusammenleben-ukraine.de/guide-finding-apartment.html\"}]}]}</script>"
      },
