    "guide-recognition-qualifications.html": {
      "settings": {
        "title": "Getting Ukrainian Diplomas Recognised in Germany",
        "order": "21",
        "meta_descr": "Which professions need official recognition in Germany, where to apply, which documents you need and who can pay the costs for Ukrainian diplomas.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-recognition-qualifications.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-recognition-qualifications.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-recognition-qualifications.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-recognition-qualifications.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-recognition-qualifications.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Getting Ukrainian Diplomas Recognised in Germany\" />\n<meta property=\"og:description\" content=\"Which professions need official recognition in Germany, where to apply, which documents you need and who can pay the costs for Ukrainian diplomas.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-recognition-qualifications.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Getting Your Ukrainian Qualifications Recognised in Germany\",\"description\":\"Which professions need official recognition in Germany, where to apply, which documents you need and who can pay the costs for Ukrainian diplomas.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/guide-recognition-qualifications.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-recognition-qualifications.html\",\"wordCount\":1065,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Do I need recognition to work in Germany?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Only for regulated professions such as doctor, nurse or teacher. For most other jobs you can apply directly.\"}},{\"@type\":\"Question\",\"name\":\"Who pays for recognition?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Often the Jobcenter or employment agency covers costs if recognition improves your job prospects. Ask before applying.\"}},{\"@type\":\"Question\",\"name\":\"What does partial recognition mean?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Parts of your training are missing compared with the German standard. An adaptation course or exam closes the gap.\"}},{\"@type\":\"Question\",\"name\":\"My documents were lost. What now?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Tell the responsible office. A skills analysis with a practical test can often replace missing documents.\"}},{\"@type\":\"Question\",\"name\":\"Can I work while the procedure runs?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"In many fields yes, for example as an assistant or in a related role. Ask the employer and the office what is allowed.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Getting Your Ukrainian Qualifications Recognised in Germany\",\"item\":\"https://zusammenleben-ukraine.de/guide-recognition-qualifications.html\"}]}]}</script>"
      },
