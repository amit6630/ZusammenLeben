            },
            ".zl-rail > .zl-tile": {
              "flex": "0 0 calc((100% - 48px) / 4)",
              "min-width": "230px",
              "scroll-snap-align": "start"
            },
            ".zl-rail .zl-tile h3": {
              "font-size": "17px"
            },
            ".zl-rail .zl-tile p": {
              "display": "-webkit-box",
              "-webkit-line-clamp": "3",
              "-webkit-box-orient": "vertical",
              "overflow": "hidden"
            },
            ".zl-comm-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(230px, 1fr))",
              "gap": "16px",
              "margin": "6px 0 0"
            },
            ".zl-comm-grid .zl-tile:hover": {
              "transform": "none",
              "box-shadow": "none",
              "border-color": "#e2e8f0"
            },
            "@media (max-width: 575px)": {
