              "margin-bottom": "20px",
              "color": "#475569",
              "font-size": "1rem"
            },
            ".two-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "20px"
            },
