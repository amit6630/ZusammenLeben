              },
              ".guide-executive-section .btn.custom-btn": {
                "width": "100% !important"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
