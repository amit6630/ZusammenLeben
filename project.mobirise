              "border": "1px solid #e2e8f0",
              "border-radius": "18px",
              "padding": "clamp(22px, 3.4vw, 40px)",
              "box-shadow": "0 10px 30px -18px rgba(15, 23, 42, .25)"
            },
            ".zl-body h2": {
              "font-size": "clamp(21px, 2.2vw, 26px)",
              "line-height": "1.25",
              "margin": "30px 0 10px",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-body h2:first-child": {
              "margin-top": "0"
            },
            ".zl-body p, .zl-body li": {
              "font-size": "17px"
            },
            ".zl-body p": {
              "margin": "0 0 14px"
            },
            "p, li, summary": {
              "line-height": "1.65 !important"
            },
            ".zl-body ul, .zl-body ol": {
              "padding-left": "1.3em",
              "margin": "0 0 16px"
            },
            ".zl-body li": {
              "margin-bottom": "8px"
            },
            ".zl-body a": {
              "color": "#1d4ed8",
              "text-decoration": "underline",
              "text-underline-offset": "2px",
              "font-weight": "600"
            },
            ".zl-body a[target=\"_blank\"]::after": {
              "content": "\" \\2197\"",
              "font-weight": "400"
            },
            ".zl-note": {
              "margin": "20px 0",
              "padding": "16px 18px",
              "border-radius": "12px",
              "background": "#eff6ff",
              "border-left": "4px solid #1d4ed8",
              "font-size": "16px"
            },
            ".zl-note--warn": {
              "background": "#fffbeb",
              "border-left-color": "#b45309"
            },
