    "guides.html": {
      "settings": {
        "title": "Guides for Ukrainian Families in Germany | ZusammenLeben",
        "order": "16",
        "meta_descr": "Practical guides for Ukrainian families in Upper Franconia: housing, Jobcenter letters, school, health, work, residence permit and everyday life.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guides.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guides.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guides.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guides.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guides.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Guides for Ukrainian Families in Germany | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"Practical guides for Ukrainian families in Upper Franconia: housing, Jobcenter letters, school, health, work, residence permit and everyday life.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guides.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"CollectionPage\",\"url\":\"https://zusammenleben-ukraine.de/guides.html\",\"name\":\"Guides for Ukrainian Families in Germany\",\"description\":\"Practical guides for Ukrainian families in Upper Franconia: housing, Jobcenter letters, school, health, work, residence permit and everyday life.\",\"inLanguage\":\"en\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"}},{\"@type\":\"ItemList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"url\":\"https://zusammenleben-ukraine.de/guide-finding-apartment.html\",\"name\":\"Finding an Apartment in Upper Franconia with Jobcenter Support\"},{\"@type\":\"ListItem\",\"position\":2,\"url\":\"https://zusammenleben-ukraine.de/guide-jobcenter-letters.html\",\"name\":\"How to Read and Answer Jobcenter Letters\"},{\"@type\":\"ListItem\",\"position\":3,\"url\":\"https://zusammenleben-ukraine.de/guide-school-kita-bavaria.html\",\"name\":\"Registering Your Child for School or Kita in Bavaria\"},{\"@type\":\"ListItem\",\"position\":4,\"url\":\"https://zusammenleben-ukraine.de/guide-health-insurance-doctor.html\",\"name\":\"Health Insurance and Seeing a Doctor in Germany\"},{\"@type\":\"ListItem\",\"position\":5,\"url\":\"https://zusammenleben-ukraine.de/guide-recognition-qualifications.html\",\"name\":\"Getting Your Ukrainian Qualifications Recognised in Germany\"},{\"@type\":\"ListItem\",\"position\":6,\"url\":\"https://zusammenleben-ukraine.de/guide-integration-course.html\",\"name\":\"The Integration Course: Your Fastest Route to German\"},{\"@type\":\"ListItem\",\"position\":7,\"url\":\"https://zusammenleben-ukraine.de/guide-residence-permit-24.html\",\"name\":\"Your §24 Residence Permit: What You Need to Know\"},{\"@type\":\"ListItem\",\"position\":8,\"url\":\"https://zusammenleben-ukraine.de/guide-first-job.html\",\"name\":\"Finding Your First Job in Germany\"},{\"@type\":\"ListItem\",\"position\":9,\"url\":\"https://zusammenleben-ukraine.de/guide-bank-account-phone.html\",\"name\":\"Bank Account, Phone Contract and Broadcasting Fee\"},{\"@type\":\"ListItem\",\"position\":10,\"url\":\"https://zusammenleben-ukraine.de/guide-driving-licence.html\",\"name\":\"Driving in Germany with a Ukrainian Licence\"},{\"@type\":\"ListItem\",\"position\":11,\"url\":\"https://zusammenleben-ukraine.de/guide-anmeldung.html\",\"name\":\"Anmeldung: Registering Your Address in Germany\"},{\"@type\":\"ListItem\",\"position\":12,\"url\":\"https://zusammenleben-ukraine.de/guide-child-benefit.html\",\"name\":\"Child Benefit and Family Payments in Germany\"},{\"@type\":\"ListItem\",\"position\":13,\"url\":\"https://zusammenleben-ukraine.de/guide-pregnancy-birth.html\",\"name\":\"Pregnancy and Birth in Germany\"},{\"@type\":\"ListItem\",\"position\":14,\"url\":\"https://zusammenleben-ukraine.de/guide-mental-health.html\",\"name\":\"Mental Health: Where to Find Psychological Support\"},{\"@type\":\"ListItem\",\"position\":15,\"url\":\"https://zusammenleben-ukraine.de/guide-university-study.html\",\"name\":\"Studying at a German University\"},{\"@type\":\"ListItem\",\"position\":16,\"url\":\"https://zusammenleben-ukraine.de/guide-vocational-training.html\",\"name\":\"Vocational Training (Ausbildung) Explained\"},{\"@type\":\"ListItem\",\"position\":17,\"url\":\"https://zusammenleben-ukraine.de/guide-self-employment.html\",\"name\":\"Becoming Self-Employed in Germany\"},{\"@type\":\"ListItem\",\"position\":18,\"url\":\"https://zusammenleben-ukraine.de/guide-tax-return.html\",\"name\":\"Taxes in Germany: The Basics for Employees\"},{\"@type\":\"ListItem\",\"position\":19,\"url\":\"https://zusammenleben-ukraine.de/guide-social-insurance.html\",\"name\":\"Social Insurance in Germany Explained\"},{\"@type\":\"ListItem\",\"position\":20,\"url\":\"https://zusammenleben-ukraine.de/guide-house-rules-waste.html\",\"name\":\"House Rules, Waste Sorting and Good Neighbours\"},{\"@type\":\"ListItem\",\"position\":21,\"url\":\"https://zusammenleben-ukraine.de/guide-public-transport.html\",\"name\":\"Getting Around: Public Transport in Upper Franconia\"},{\"@type\":\"ListItem\",\"position\":22,\"url\":\"https://zusammenleben-ukraine.de/guide-saving-money.html\",\"name\":\"Saving Money in Everyday Life\"},{\"@type\":\"ListItem\",\"position\":23,\"url\":\"https://zusammenleben-ukraine.de/guide-clubs-volunteering.html\",\"name\":\"Clubs and Volunteering: Finding Your Place\"},{\"@type\":\"ListItem\",\"position\":24,\"url\":\"https://zusammenleben-ukraine.de/guide-elderly-care.html\",\"name\":\"Older People and Long-Term Care in Germany\"},{\"@type\":\"ListItem\",\"position\":25,\"url\":\"https://zusammenleben-ukraine.de/guide-disability.html\",\"name\":\"Living with a Disability in Germany\"},{\"@type\":\"ListItem\",\"position\":26,\"url\":\"https://zusammenleben-ukraine.de/guide-legal-help.html\",\"name\":\"Getting Legal Help in Germany\"},{\"@type\":\"ListItem\",\"position\":27,\"url\":\"https://zusammenleben-ukraine.de/guide-violence-protection.html\",\"name\":\"Protection from Violence: Where to Get Help\"},{\"@type\":\"ListItem\",\"position\":28,\"url\":\"https://zusammenleben-ukraine.de/guide-ukrainian-documents.html\",\"name\":\"Keeping Your Ukrainian Documents Valid in Germany\"},{\"@type\":\"ListItem\",\"position\":29,\"url\":\"https://zusammenleben-ukraine.de/guide-winter-heating.html\",\"name\":\"Getting Through the German Winter\"},{\"@type\":\"ListItem\",\"position\":30,\"url\":\"https://zusammenleben-ukraine.de/guide-long-term-stay.html\",\"name\":\"Planning a Long-Term Future in Germany\"}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"}]}]}</script>"
