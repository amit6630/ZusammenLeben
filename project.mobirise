        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/anna-shishoili.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/anna-shishoili.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/anna-shishoili.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/anna-shishoili.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/anna-shishoili.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Anna Cheishvili, Operations Manager | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"Meet Anna Cheishvili, the volunteer operations manager of ZusammenLeben and the first contact for Ukrainian families in Upper Franconia.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/anna-shishoili.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"url\":\"https://zusammenleben-ukraine.de/anna-shishoili.html\",\"name\":\"Anna Cheishvili, Operations Manager\",\"description\":\"Meet Anna Cheishvili, the volunteer operations manager of ZusammenLeben and the first contact for Ukrainian families in Upper Franconia.\",\"inLanguage\":\"en\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"},\"about\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Anna Cheishvili, Operations Manager\",\"item\":\"https://zusammenleben-ukraine.de/anna-shishoili.html\"}]}]}</script>",
        "meta_descr": "Meet Anna Cheishvili, the volunteer operations manager of ZusammenLeben and the first contact for Ukrainian families in Upper Franconia."
