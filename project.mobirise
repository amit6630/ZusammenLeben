                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            "@media (max-width: 767px)": {
              ".services-grid, .team-grid, .transparency-grid, .pillars-grid, .three-column-grid, .grid-3, .grid-2, .faq-grid, .survival-grid, .portal-grid-2, .city-directory-grid, .details-cards-stack, .two-column-grid, .levels-grid, .cert-grid, .benefits-grid, .links-grid, .timeline-wrapper": {
                "display": "flex !important",
                "flex-wrap": "nowrap !important",
                "flex-direction": "row !important",
                "grid-template-columns": "none !important",
                "gap": "12px !important",
                "overflow-x": "auto",
                "overscroll-behavior-x": "contain",
                "scroll-snap-type": "x mandatory",
                "padding": "4px 2px 14px !important",
                "scrollbar-width": "none"
              },
              ".services-grid::-webkit-scrollbar, .team-grid::-webkit-scrollbar, .transparency-grid::-webkit-scrollbar, .pillars-grid::-webkit-scrollbar, .three-column-grid::-webkit-scrollbar, .grid-3::-webkit-scrollbar, .grid-2::-webkit-scrollbar, .faq-grid::-webkit-scrollbar, .survival-grid::-webkit-scrollbar, .portal-grid-2::-webkit-scrollbar, .city-directory-grid::-webkit-scrollbar, .details-cards-stack::-webkit-scrollbar, .two-column-grid::-webkit-scrollbar, .levels-grid::-webkit-scrollbar, .cert-grid::-webkit-scrollbar, .benefits-grid::-webkit-scrollbar, .links-grid::-webkit-scrollbar, .timeline-wrapper::-webkit-scrollbar": {
                "display": "none"
              },
              ".services-grid > *, .team-grid > *, .transparency-grid > *, .pillars-grid > *, .three-column-grid > *, .grid-3 > *, .grid-2 > *, .faq-grid > *, .survival-grid > *, .portal-grid-2 > *, .city-directory-grid > *, .details-cards-stack > *, .two-column-grid > *, .levels-grid > *, .cert-grid > *, .benefits-grid > *, .links-grid > *, .timeline-wrapper > *": {
                "flex": "0 0 84% !important",
                "max-width": "84% !important",
                "min-width": "0",
                "margin": "0 !important",
                "scroll-snap-align": "start"
              },
              ".timeline-wrapper::before": {
                "display": "none !important"
              },
              ".metrics-section, .services-section, .process-section, .region-section, .team-section, .transparency-section, .cta-section": {
                "padding-top": "44px !important",
                "padding-bottom": "44px !important"
              },
              ".metrics-grid": {
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr) !important",
                "gap": "10px !important"
              },
              ".word-grid": {
                "max-height": "62vh",
                "overflow-y": "auto",
                "overscroll-behavior": "contain",
                "padding-right": "4px"
              },
              ".metrics-grid > *": {
                "min-width": "0",
                "padding": "18px 10px !important"
              },
              ".metrics-grid .metric-value": {
                "font-size": "2rem !important"
              },
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_name": "list01",
          "_sourceTheme": "humanitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"faq-executive-section\" id=\"faq-page\">\n    <div class=\"faq-container\">\n        \n        <!-- Header -->\n        <header class=\"faq-header\">\n            <div class=\"header-tag\">KNOWLEDGE BASE</div>\n            <h1 class=\"header-title\">Q&amp;A — Guide for Newcomers</h1>\n            <p class=\"header-lead\">Everything we were asked, organized by topic — with references to official authorities<br></p>\n        </header>\n\n        <!-- Disclaimer Box -->\n        <div class=\"disclaimer-card\">\n            <div class=\"disclaimer-icon\">\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line></svg>\n            </div>\n            <div class=\"disclaimer-text\">\n                <strong>Important Clarification:</strong> The answers provided are based on practical experience in the region. They do not constitute legal advice. Procedures, financial amounts, and eligibilities vary between cities and authorities, and are updated periodically. Always verify details with the competent official authority.\n            </div>\n        </div>\n\n<!-- FAQ Categories Wrapper -->\n<div class=\"faq-categories-wrapper\">\n\n    <!-- PART A: About Our Activity -->\n    <div class=\"faq-topic-section\">\n        <h2 class=\"topic-title\">\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z\"></path></svg>\n            Part A — About Our Activity\n        </h2>\n        <div class=\"accordion custom-accordion\" id=\"accordionPartA\">\n            \n            <!-- Question A1 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingA1\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseA1\" aria-expanded=\"false\" aria-controls=\"collapseA1\">\n                        Is the service provided free of charge?\n                    </button>\n                </h3>\n                <div id=\"collapseA1\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingA1\" data-bs-parent=\"#accordionPartA\">\n                    <div class=\"accordion-body\">\n                        Yes, absolutely. All social support services — consulting, translation, coordination with authorities, accompanying to meetings, and housing assistance — are provided <strong>entirely on a volunteer basis</strong>. There are no processing fees, consulting fees, or brokerage fees at any stage. If anyone asks for payment in our name, it is not us, and we would appreciate it if you let us know.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Question A2 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingA2\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseA2\" aria-expanded=\"false\" aria-controls=\"collapseA2\">\n                        So what does cost money?\n                    </button>\n                </h3>\n                <div id=\"collapseA2\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingA2\" data-bs-parent=\"#accordionPartA\">\n                    <div class=\"accordion-body\">\n                        Payments to external entities: rent and deposits to landlords, municipal fees, electricity, gas, internet, broadcasting fees (<em>Rundfunkbeitrag</em>), and insurance. All of these are <strong>paid directly to the relevant provider</strong> and never pass through us. If a process involves a fee, you will be told in advance who to pay and why.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Question A3 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingA3\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseA3\" aria-expanded=\"false\" aria-controls=\"collapseA3\">\n                        Who is eligible to apply?\n                    </button>\n                </h3>\n                <div id=\"collapseA3\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingA3\" data-bs-parent=\"#accordionPartA\">\n                    <div class=\"accordion-body\">\n                        Families and individuals from Ukraine currently residing in Northern Bavaria or planning to move to the area. There are no prerequisites regarding family size, legal status, or time spent in Germany. We don’t screen you — we simply check if we can practically assist you.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Question A4 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingA4\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseA4\" aria-expanded=\"false\" aria-controls=\"collapseA4\">\n                        Are you a registered NGO?\n                    </button>\n                </h3>\n                <div id=\"collapseA4\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingA4\" data-bs-parent=\"#accordionPartA\">\n                    <div class=\"accordion-body\">\n                        No. This is a volunteer social-humanitarian initiative, not a registered association (<em>eingetragener Verein</em>). We state this clearly because it matters: <strong>we are not an official body</strong>, we do not represent any authority, and we cannot issue official certificates.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Question A5 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingA5\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseA5\" aria-expanded=\"false\" aria-controls=\"collapseA5\">\n                        Who manages the activity?\n                    </button>\n                </h3>\n                <div id=\"collapseA5\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingA5\" data-bs-parent=\"#accordionPartA\">\n                    <div class=\"accordion-body\">\n                        Ben Shamir is the founder who provided the properties and operational infrastructure. Anna Cheishvili manages the daily operations entirely on a volunteer basis and is the primary point of contact for families. They are supported by a community of volunteers, translators, and veteran families.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Question A6 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingA6\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseA6\" aria-expanded=\"false\" aria-controls=\"collapseA6\">\n                        Do you work with the authorities?\n                    </button>\n                </h3>\n                <div id=\"collapseA6\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingA6\" data-bs-parent=\"#accordionPartA\">\n                    <div class=\"accordion-body\">\n                        We are in regular contact with local authorities in the region while handling cases. However, we are not an official body, we represent no authority, and we are not part of any government system. A clerk who knows us might respond faster, but we have no authority or influence over official decisions.\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n\n    <!-- PART B: Contact, Availability & Process -->\n    <div class=\"faq-topic-section\">\n        <h2 class=\"topic-title\">\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z\"></path></svg>\n            Part B — Contact, Availability &amp; Process\n        </h2>\n        <div class=\"accordion custom-accordion\" id=\"accordionPartB\">\n            \n            <!-- Question B1 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingB1\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseB1\" aria-expanded=\"false\" aria-controls=\"collapseB1\">\n                        How can I contact you?\n                    </button>\n                </h3>\n                <div id=\"collapseB1\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingB1\" data-bs-parent=\"#accordionPartB\">\n                    <div class=\"accordion-body\">\n                        Via WhatsApp or email. There are no forms on the website, and we do not collect data through it.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Question B2 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingB2\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseB2\" aria-expanded=\"false\" aria-controls=\"collapseB2\">\n                        In what languages can I write?\n                    </button>\n                </h3>\n                <div id=\"collapseB2\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingB2\" data-bs-parent=\"#accordionPartB\">\n                    <div class=\"accordion-body\">\n                        Ukrainian, Russian, German, and English. Write in the language you are most comfortable with — a clear explanation in your native language is better than a broken one in German.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Question B3 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingB3\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseB3\" aria-expanded=\"false\" aria-controls=\"collapseB3\">\n                        How long does it take to get a reply?\n                    </button>\n                </h3>\n                <div id=\"collapseB3\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingB3\" data-bs-parent=\"#accordionPartB\">\n                    <div class=\"accordion-body\">\n                        We try to respond on the same day. On busy days, the response might come the following day. If you haven't heard back within two days, please send a reminder — sometimes messages get lost.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Question B4 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingB4\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseB4\" aria-expanded=\"false\" aria-controls=\"collapseB4\">\n                        What should I write in the first message?\n                    </button>\n                </h3>\n                <div id=\"collapseB4\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingB4\" data-bs-parent=\"#accordionPartB\">\n                    <div class=\"accordion-body\">\n                        Please include: <strong>your first name</strong>, <strong>your current city</strong>, <strong>number of adults and children (and ages)</strong>, <strong>your primary need</strong>, and whether there is an <strong>urgent deadline</strong>. There is no need to attach documents at this stage.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Question B5 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingB5\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseB5\" aria-expanded=\"false\" aria-controls=\"collapseB5\">\n                        What happens after I reach out?\n                    </button>\n                </h3>\n                <div id=\"collapseB5\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingB5\" data-bs-parent=\"#accordionPartB\">\n                    <div class=\"accordion-body\">\n                        We will read your message, possibly ask a few clarifying questions, check what we can practically do, and give you an honest answer. If we can't help, we will tell you quickly so you aren't left waiting.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Question B6 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingB6\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseB6\" aria-expanded=\"false\" aria-controls=\"collapseB6\">\n                        How long does the process take?\n                    </button>\n                </h3>\n                <div id=\"collapseB6\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingB6\" data-bs-parent=\"#accordionPartB\">\n                    <div class=\"accordion-body\">\n                        It varies greatly. Explaining a letter takes minutes. Finding an apartment can take weeks or months, depending on regional availability. Processes dependent on authorities take as long as the authority requires. We cannot commit to a timeline and won't pretend otherwise.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Question B7 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingB7\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseB7\" aria-expanded=\"false\" aria-controls=\"collapseB7\">\n                        Can I contact you on behalf of someone else?\n                    </button>\n                </h3>\n                <div id=\"collapseB7\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingB7\" data-bs-parent=\"#accordionPartB\">\n                    <div class=\"accordion-body\">\n                        Yes — a relative, neighbor, or friend — provided they know about the inquiry and are interested in it. At some point, we will prefer to speak directly with them.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Question B8 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingB8\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseB8\" aria-expanded=\"false\" aria-controls=\"collapseB8\">\n                        What documents are required?\n                    </button>\n                </h3>\n                <div id=\"collapseB8\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingB8\" data-bs-parent=\"#accordionPartB\">\n                    <div class=\"accordion-body\">\n                        For the initial contact — none. If a document is needed later, we will ask for it and explain exactly why. Regardless, it's highly recommended to keep handy: IDs, address registration certificate (<em>Meldebescheinigung</em>), residence permit, health insurance card, and official letters.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Question B9 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingB9\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseB9\" aria-expanded=\"false\" aria-controls=\"collapseB9\">\n                        Do you store my information?\n                    </button>\n                </h3>\n                <div id=\"collapseB9\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingB9\" data-bs-parent=\"#accordionPartB\">\n                    <div class=\"accordion-body\">\n                        The website has no forms and collects no data. Whatever you share directly via WhatsApp or email is used solely to handle your case. We do not pass it to third parties without your consent, except where required by law.\n                    </div>\n                </div>\n            </div>\n\n            <!-- Question B10 -->\n            <div class=\"accordion-item\">\n                <h3 class=\"accordion-header\" id=\"headingB10\">\n                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseB10\" aria-expanded=\"false\" aria-controls=\"collapseB10\">\n                        I'm not sure you are the right address. Should I reach out anyway?\n                    </button>\n                </h3>\n                <div id=\"collapseB10\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingB10\" data-bs-parent=\"#accordionPartB\">\n                    <div class=\"accordion-body\">\n                        Yes. If we can't help, we will tell you and try to refer you to an appropriate organization. Asking costs nothing.\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n\n</div>\n<!-- PART C: Operating Area -->\n            <div class=\"faq-topic-section\">\n                <h2 class=\"topic-title\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\"></path></svg>\n                    Part C — Operating Area\n                </h2>\n                <div class=\"accordion custom-accordion\" id=\"accordionPartC\">\n                    \n                    <!-- C1 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingC1\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseC1\" aria-expanded=\"false\" aria-controls=\"collapseC1\">\n                                In which areas do you operate?\n                            </button>\n                        </h3>\n                        <div id=\"collapseC1\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingC1\" data-bs-parent=\"#accordionPartC\">\n                            <div class=\"accordion-body\">\n                                Northern Bavaria, primarily Upper Franconia (Oberfranken): Helmbrechts, Münchberg, Hof, Selb, Wunsiedel, Arzberg, Marktredwitz, Naila, Kulmbach, Bad Steben, and other surrounding communities.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- C2 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingC2\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseC2\" aria-expanded=\"false\" aria-controls=\"collapseC2\">\n                                I live in Munich, Berlin, or another city. Can you help?\n                            </button>\n                        </h3>\n                        <div id=\"collapseC2\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingC2\" data-bs-parent=\"#accordionPartC\">\n                            <div class=\"accordion-body\">\n                                Not fully. We will read your inquiry and try to refer you to a local resource, but we cannot provide practical, on-the-ground support outside our region. Real help requires knowing the specific authority, school, and landlords in a given area.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- C3 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingC3\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseC3\" aria-expanded=\"false\" aria-controls=\"collapseC3\">\n                                Why specifically this region?\n                            </button>\n                        </h3>\n                        <div id=\"collapseC3\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingC3\" data-bs-parent=\"#accordionPartC\">\n                            <div class=\"accordion-body\">\n                                Because this is where we know the system. Focus allows for physical accompaniment, knowing the clerks, building ties with landlords, and knowing exactly what works where. Claiming \"we operate all over Germany\" would sound bigger but work far less effectively.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- C4 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingC4\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseC4\" aria-expanded=\"false\" aria-controls=\"collapseC4\">\n                                I'm planning to move to the area. Can I contact you in advance?\n                            </button>\n                        </h3>\n                        <div id=\"collapseC4\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingC4\" data-bs-parent=\"#accordionPartC\">\n                            <div class=\"accordion-body\">\n                                Yes, and it is highly recommended. Contacting us early allows us to check availability and coordinate things before your move.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- C5 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingC5\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseC5\" aria-expanded=\"false\" aria-controls=\"collapseC5\">\n                                What should I know about the area before moving?\n                            </button>\n                        </h3>\n                        <div id=\"collapseC5\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingC5\" data-bs-parent=\"#accordionPartC\">\n                            <div class=\"accordion-body\">\n                                This is a rural-urban region. <strong>The benefits:</strong> significantly lower housing costs than big cities, a quiet environment, and smaller educational institutions. <strong>What to consider:</strong> public transport is less frequent, job variety is more limited, and you may sometimes need to travel to a neighboring city for specific services.\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n<!-- PART D: Housing -->\n<div class=\"faq-topic-section\">\n    <h2 class=\"topic-title\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\"></path></svg>\n        Part D — Housing &amp; Apartments\n    </h2>\n    <div class=\"accordion custom-accordion\" id=\"accordionPartD\">\n        \n        <!-- Question 1 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingD1\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseD1\" aria-expanded=\"false\" aria-controls=\"collapseD1\">\n                    Does every family get an apartment?\n                </button>\n            </h3>\n            <div id=\"collapseD1\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartD\">\n                <div class=\"accordion-body\">\n                    No. We cannot guarantee finding an apartment. Availability varies greatly between periods and cities, and sometimes there simply isn't a suitably sized vacant apartment in the region. We will tell you this upfront.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 2 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingD2\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseD2\" aria-expanded=\"false\" aria-controls=\"collapseD2\">\n                    How long does it take to find an apartment?\n                </button>\n            </h3>\n            <div id=\"collapseD2\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartD\">\n                <div class=\"accordion-body\">\n                    There is no single answer. Sometimes weeks, sometimes long months. Large families usually wait longer because apartments with four or more rooms are rare in the area.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 3 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingD3\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseD3\" aria-expanded=\"false\" aria-controls=\"collapseD3\">\n                    Is there a limit on family size?\n                </button>\n            </h3>\n            <div id=\"collapseD3\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartD\">\n                <div class=\"accordion-body\">\n                    In principle, there is no limit on our part. In practice, the larger the family, the harder it is to find a suitable apartment, which directly impacts the duration of the process.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 4 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingD4\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseD4\" aria-expanded=\"false\" aria-controls=\"collapseD4\">\n                    Can I sign a lease for an apartment I found myself?\n                </button>\n            </h3>\n            <div id=\"collapseD4\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartD\">\n                <div class=\"accordion-body\">\n                    You can, but <strong>do not sign</strong> before checking with the Jobcenter. If the rent exceeds what is considered \"reasonable\" (<em>angemessen</em>) according to the district's housing limits, you will have to pay the difference out of pocket — sometimes for years. Always request written approval (<em>Zusicherung</em>) before signing. This is the most expensive mistake we see.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 5 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingD5\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseD5\" aria-expanded=\"false\" aria-controls=\"collapseD5\">\n                    What is Kaltmiete and Warmmiete?\n                </button>\n            </h3>\n            <div id=\"collapseD5\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartD\">\n                <div class=\"accordion-body\">\n                    <em>Kaltmiete</em> is the basic (\"cold\") rent only. <em>Warmmiete</em> includes additional utility costs and heating. When discussing a budget, always ask which one is being referred to. The difference can be hundreds of euros.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 6 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingD6\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseD6\" aria-expanded=\"false\" aria-controls=\"collapseD6\">\n                    How much security deposit can be requested?\n                </button>\n            </h3>\n            <div id=\"collapseD6\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartD\">\n                <div class=\"accordion-body\">\n                    By law, up to three months of basic rent (<em>Kaltmiete</em>). It can be paid in three monthly installments. The deposit is refunded at the end of the lease, minus deductions for proven damage only.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 7 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingD7\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseD7\" aria-expanded=\"false\" aria-controls=\"collapseD7\">\n                    Who signs the lease agreement?\n                </button>\n            </h3>\n            <div id=\"collapseD7\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartD\">\n                <div class=\"accordion-body\">\n                    Usually the family itself. The Jobcenter pays housing costs but is not a party to the contract. There are exceptions where payments are transferred directly to the landlord.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 8 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingD8\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseD8\" aria-expanded=\"false\" aria-controls=\"collapseD8\">\n                    What is an Übergabeprotokoll and why is it important?\n                </button>\n            </h3>\n            <div id=\"collapseD8\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartD\">\n                <div class=\"accordion-body\">\n                    The handover protocol (<em>Übergabeprotokoll</em>) — a document recording the apartment's condition on the day you move in, including existing defects. Fill it out and take photos of everything. This is the document that will protect you at the end of the tenancy against claims for damages you did not cause.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 9 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingD9\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseD9\" aria-expanded=\"false\" aria-controls=\"collapseD9\">\n                    I'm afraid I'll be evicted from my apartment. What should I do?\n                </button>\n            </h3>\n            <div id=\"collapseD9\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartD\">\n                <div class=\"accordion-body\">\n                    Eviction in Germany requires a legal process — a landlord cannot simply kick you out. If you receive an eviction notice (<em>Kündigung</em>), contact us immediately — strict deadlines apply. Consider joining a tenants' association (<em>Mieterverein</em>): membership costs a few dozen euros per year and includes legal advice.<br><br>\n                    • <strong>Find a local tenants' association:</strong> <a href=\"https://www.mieterbund.de\" target=\"_blank\" rel=\"noopener\">www.mieterbund.de</a>\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 10 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingD10\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseD10\" aria-expanded=\"false\" aria-controls=\"collapseD10\">\n                    The landlord is demanding something that seems unfair to me. What should I do?\n                </button>\n            </h3>\n            <div id=\"collapseD10\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartD\">\n                <div class=\"accordion-body\">\n                    Do not sign and do not pay before verifying. Tenants' rights in Germany are strong, but they only work if you know them. Contact us or a tenants' association (<em>Mieterverein</em>).\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 11 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingD11\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseD11\" aria-expanded=\"false\" aria-controls=\"collapseD11\">\n                    Is it possible to receive furniture?\n                </button>\n            </h3>\n            <div id=\"collapseD11\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartD\">\n                <div class=\"accordion-body\">\n                    Sometimes yes, depending on donations and availability at the time. This refers to second-hand items in good working condition, not new furniture.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 12 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingD12\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseD12\" aria-expanded=\"false\" aria-controls=\"collapseD12\">\n                    Did you know there is a right to furniture assistance from the Jobcenter?\n                </button>\n            </h3>\n            <div id=\"collapseD12\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartD\">\n                <div class=\"accordion-body\">\n                    Yes, and it is one of the rights families miss most. Initial equipment allocation (<em>Erstausstattung</em>) is a one-time grant for furniture, household items, and clothing when moving into your first apartment. It is not given automatically — you must submit a separate application. If you moved into an apartment and didn't apply, it is worth checking if you can still submit a request.\n                </div>\n            </div>\n        </div>\n\n    </div>\n</div>    \n<!-- PART E: Jobcenter & Finance -->\n            <div class=\"faq-topic-section\">\n                <h2 class=\"topic-title\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z\"></path></svg>\n                    Part E — Jobcenter &amp; Financial Rights\n                </h2>\n                <div class=\"accordion custom-accordion\" id=\"accordionPartE\">\n                    \n                    <!-- E1 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingE1\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseE1\" aria-expanded=\"false\" aria-controls=\"collapseE1\">\n                                Do you help with the Jobcenter?\n                            </button>\n                        </h3>\n                        <div id=\"collapseE1\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingE1\" data-bs-parent=\"#accordionPartE\">\n                            <div class=\"accordion-body\">\n                                Yes — by explaining letters, preparing for meetings, providing general guidance, and accompanying during the apartment approval process. However, the decisions themselves are solely made by the Jobcenter, and we have no influence over them.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- E2 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingE2\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseE2\" aria-expanded=\"false\" aria-controls=\"collapseE2\">\n                                I received a letter and don't understand it. What should I do?\n                            </button>\n                        </h3>\n                        <div id=\"collapseE2\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingE2\" data-bs-parent=\"#accordionPartE\">\n                            <div class=\"accordion-body\">\n                                Take a photo and send it to us on WhatsApp. We will explain in simple terms what it says, what they are asking for, and the deadline. Don't wait — official letters have strict deadlines.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- E3 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingE3\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseE3\" aria-expanded=\"false\" aria-controls=\"collapseE3\">\n                                How much time do I have to respond to a decision?\n                            </button>\n                        </h3>\n                        <div id=\"collapseE3\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingE3\" data-bs-parent=\"#accordionPartE\">\n                            <div class=\"accordion-body\">\n                                Usually one month from the date of delivery. The exact deadline appears at the end of every decision notice under the <em>Rechtsbehelfsbelehrung</em> section. After this deadline, the decision becomes final and is very difficult to change.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- E4 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingE4\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseE4\" aria-expanded=\"false\" aria-controls=\"collapseE4\">\n                                How do I submit an appeal (Widerspruch)?\n                            </button>\n                        </h3>\n                        <div id=\"collapseE4\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingE4\" data-bs-parent=\"#accordionPartE\">\n                            <div class=\"accordion-body\">\n                                You don't need sophisticated legal phrasing. A simple letter is enough, including: your full name, case number (<em>Aktenzeichen</em>), the date of the decision you are appealing, and a sentence stating your objection. The detailed reasoning can be sent later. Send it by registered mail or hand it in directly to get a receipt stamp, and keep a copy.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- E5 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingE5\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseE5\" aria-expanded=\"false\" aria-controls=\"collapseE5\">\n                                The appeal was rejected. Is there anything else I can do?\n                            </button>\n                        </h3>\n                        <div id=\"collapseE5\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingE5\" data-bs-parent=\"#accordionPartE\">\n                            <div class=\"accordion-body\">\n                                Yes. You can appeal to the Social Court (<em>Sozialgericht</em>). Proceedings there are exempt from court fees — a fact many people do not know. In such cases, legal counsel is strongly recommended.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- E6 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingE6\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseE6\" aria-expanded=\"false\" aria-controls=\"collapseE6\">\n                                I have no money for a lawyer.\n                            </button>\n                        </h3>\n                        <div id=\"collapseE6\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingE6\" data-bs-parent=\"#accordionPartE\">\n                            <div class=\"accordion-body\">\n                                There are two state-funding systems available: <strong>Beratungshilfe</strong> (assistance funding initial consultation; apply at the local <em>Amtsgericht</em> for a voucher) and <strong>Prozesskostenhilfe</strong> (funding for a full legal process). Both are available to Bürgergeld recipients.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- E7 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingE7\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseE7\" aria-expanded=\"false\" aria-controls=\"collapseE7\">\n                                What is Bürgergeld and what does it include?\n                            </button>\n                        </h3>\n                        <div id=\"collapseE7\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingE7\" data-bs-parent=\"#accordionPartE\">\n                            <div class=\"accordion-body\">\n                                Basic support that includes standard living allowances (<em>Regelbedarf</em>) for every person in the household, plus accommodation expenses (<em>Kosten der Unterkunft</em>) — rent, service charges, and heating.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- E8 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingE8\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseE8\" aria-expanded=\"false\" aria-controls=\"collapseE8\">\n                                Are there other things I can request?\n                            </button>\n                        </h3>\n                        <div id=\"collapseE8\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingE8\" data-bs-parent=\"#accordionPartE\">\n                            <div class=\"accordion-body\">\n                                Yes, and they all require a separate application: <strong>Erstausstattung</strong> (initial furniture and clothing), <strong>Mehrbedarf</strong> (additional needs for pregnancy, single parenthood, disability, or medical diet), and <strong>Bildung und Teilhabe</strong> (education and participation package for children).\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- E9 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingE9\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseE9\" aria-expanded=\"false\" aria-controls=\"collapseE9\">\n                                I started working. What now?\n                            </button>\n                        </h3>\n                        <div id=\"collapseE9\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingE9\" data-bs-parent=\"#accordionPartE\">\n                            <div class=\"accordion-body\">\n                                You must report it immediately. Working does not necessarily cancel your eligibility — if your income is below the threshold, the Jobcenter supplements it. There are exemption limits (<em>Freibeträge</em>) allowing you to keep a portion of the income. Failing to report is a severe violation and can lead to repayment demands.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- E10 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingE10\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseE10\" aria-expanded=\"false\" aria-controls=\"collapseE10\">\n                                What else must be reported?\n                            </button>\n                        </h3>\n                        <div id=\"collapseE10\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingE10\" data-bs-parent=\"#accordionPartE\">\n                            <div class=\"accordion-body\">\n                                Moving to a new apartment, changes in family composition, extended trips abroad, receiving an inheritance or money from outside, and changes in the income of any household member. Rule of thumb: if you are unsure whether to report it — report it.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- E11 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingE11\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseE11\" aria-expanded=\"false\" aria-controls=\"collapseE11\">\n                                Where can I find my local Jobcenter?\n                            </button>\n                        </h3>\n                        <div id=\"collapseE11\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingE11\" data-bs-parent=\"#accordionPartE\">\n                            <div class=\"accordion-body\">\n                                Search by location: <a href=\"https://www.jobcenter-ge.de\" target=\"_blank\" rel=\"noopener noreferrer\">jobcenter-ge.de</a>, Federal Employment Agency: <a href=\"https://www.arbeitsagentur.de\" target=\"_blank\" rel=\"noopener noreferrer\">arbeitsagentur.de</a>, or call the national toll-free helpline: <strong>0800 4 5555 00</strong>.\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n\n<!-- PART F: Status, Authorities & Documents -->\n<div class=\"faq-topic-section\">\n    <h2 class=\"topic-title\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z\"></path></svg>\n        Part F — Status, Authorities &amp; Documents\n    </h2>\n    <div class=\"accordion custom-accordion\" id=\"accordionPartF\">\n        \n        <!-- Question 1 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingF1\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseF1\" aria-expanded=\"false\" aria-controls=\"collapseF1\">\n                    Do you assist with address registration (Anmeldung)?\n                </button>\n            </h3>\n            <div id=\"collapseF1\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartF\">\n                <div class=\"accordion-body\">\n                    Yes. We explain what is required, assist with booking appointments, and help navigate the procedure. Requirements vary between local municipalities, so it is important to verify details directly with your local city hall (<em>Bürgeramt / Rathaus</em>).\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 2 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingF2\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseF2\" aria-expanded=\"false\" aria-controls=\"collapseF2\">\n                    Why is Anmeldung so important?\n                </button>\n            </h3>\n            <div id=\"collapseF2\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartF\">\n                <div class=\"accordion-body\">\n                    Because almost everything depends on it: health insurance, bank accounts, Jobcenter registration, enrolling children in school, and sometimes even securing a lease. Delaying your address registration delays everything else.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 3 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingF3\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseF3\" aria-expanded=\"false\" aria-controls=\"collapseF3\">\n                    My residence permit is expiring. What should I do?\n                </button>\n            </h3>\n            <div id=\"collapseF3\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartF\">\n                <div class=\"accordion-body\">\n                    Contact the Foreigners Authority (<em>Ausländerbehörde</em>) at least eight weeks in advance. An expired permit creates a chain reaction of problems: stopped payments, health insurance issues, and employment blocks. Do not wait until the last minute.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 4 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingF4\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseF4\" aria-expanded=\"false\" aria-controls=\"collapseF4\">\n                    What is a Fiktionsbescheinigung?\n                </button>\n            </h3>\n            <div id=\"collapseF4\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartF\">\n                <div class=\"accordion-body\">\n                    It is a temporary certificate confirming that your application for a residence permit or extension is legally under review. It serves as a valid official document for most purposes, but be sure to monitor its expiration date as well.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 5 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingF5\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseF5\" aria-expanded=\"false\" aria-controls=\"collapseF5\">\n                    Can I work with my current status?\n                </button>\n            </h3>\n            <div id=\"collapseF5\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartF\">\n                <div class=\"accordion-body\">\n                    A residence permit under § 24 AufenthG grants full access to the labor market — without needing separate approval and without restrictions on the type of work. This is a significant advantage compared to standard asylum procedures.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 6 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingF6\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseF6\" aria-expanded=\"false\" aria-controls=\"collapseF6\">\n                    How do I open a bank account if I was rejected?\n                </button>\n            </h3>\n            <div id=\"collapseF6\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartF\">\n                <div class=\"accordion-body\">\n                    In Germany, you have a legal right to a basic bank account (<em>Basiskonto</em>) — every retail bank is required by law to offer one. If a bank refuses, demand a written rejection notice and file a complaint with the Federal Financial Supervisory Authority (BaFin).<br><br>\n                    • <strong>Official Portal:</strong> <a href=\"https://www.bafin.de\" target=\"_blank\" rel=\"noopener\">www.bafin.de</a><br>\n                    • <strong>Consumer Hotline:</strong> <a href=\"tel:08002100500\">0800 2 100 500</a>\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 7 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingF7\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseF7\" aria-expanded=\"false\" aria-controls=\"collapseF7\">\n                    I lost an important document. What now?\n                </button>\n            </h3>\n            <div id=\"collapseF7\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartF\">\n                <div class=\"accordion-body\">\n                    Contact the authority that issued the original document. Address registration confirmations (<em>Meldebestätigung</em>) are reissued at city hall (<em>Bürgeramt</em>); Jobcenter documents can be requested from your assigned caseworker. Preventive tip: take photo scans of all your essential documents today and save them digitally.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 8 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingF8\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseF8\" aria-expanded=\"false\" aria-controls=\"collapseF8\">\n                    Are my certificates and diplomas from Ukraine recognized?\n                </button>\n            </h3>\n            <div id=\"collapseF8\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartF\">\n                <div class=\"accordion-body\">\n                    It depends on the purpose. Professional and academic degree recognition follows a formal evaluation procedure (<em>Anerkennung</em>). To prove German language proficiency, Ukrainian certificates are generally not accepted and an official German language certificate is required.<br><br>\n                    • <strong>Recognition Portal:</strong> <a href=\"https://www.anerkennung-in-deutschland.de\" target=\"_blank\" rel=\"noopener\">www.anerkennung-in-deutschland.de</a><br>\n                    • <strong>Hotline:</strong> <a href=\"tel:03018151111\">030 1815 1111</a>\n                </div>\n            </div>\n        </div>\n\n    </div>\n</div>\n<!-- PART G: Children & Education -->\n<div class=\"faq-topic-section\">\n    <h2 class=\"topic-title\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z\"></path></svg>\n        Part G — Children &amp; Education\n    </h2>\n    <div class=\"accordion custom-accordion\" id=\"accordionPartG\">\n        \n        <!-- Question 1 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingG1\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseG1\" aria-expanded=\"false\" aria-controls=\"collapseG1\">\n                    Do you register children for school?\n                </button>\n            </h3>\n            <div id=\"collapseG1\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartG\">\n                <div class=\"accordion-body\">\n                    We assist in locating suitable educational settings, understanding documents, translation, and coordination. The actual school placement itself is determined by local authorities and the schools.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 2 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingG2\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseG2\" aria-expanded=\"false\" aria-controls=\"collapseG2\">\n                    Is it mandatory to register my child for school?\n                </button>\n            </h3>\n            <div id=\"collapseG2\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartG\">\n                <div class=\"accordion-body\">\n                    Yes. In Germany, schooling is mandatory (<em>Schulpflicht</em>) and authorities enforce it strictly. An unregistered child creates legal complications with authorities. It is not just a right — it is an obligation.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 3 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingG3\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseG3\" aria-expanded=\"false\" aria-controls=\"collapseG3\">\n                    My child doesn't speak German. How does it work?\n                </button>\n            </h3>\n            <div id=\"collapseG3\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartG\">\n                <div class=\"accordion-body\">\n                    Most schools have integration classes for students who do not speak German. In Bavaria, they are usually called <em>Deutschklasse</em> or <em>Übergangsklasse</em>. Ask about this explicitly during registration.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 4 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingG4\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseG4\" aria-expanded=\"false\" aria-controls=\"collapseG4\">\n                    How long is the waiting time for a daycare or kindergarten spot?\n                </button>\n            </h3>\n            <div id=\"collapseG4\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartG\">\n                <div class=\"accordion-body\">\n                    It depends on the city, and wait times can often take several months. While children have a legal right to a spot starting from age one, availability is limited in practice. Register early and apply to several facilities simultaneously.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 5 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingG5\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseG5\" aria-expanded=\"false\" aria-controls=\"collapseG5\">\n                    Is there financial assistance for children's needs?\n                </button>\n            </h3>\n            <div id=\"collapseG5\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartG\">\n                <div class=\"accordion-body\">\n                    Yes — the Education and Participation package (<em>Bildung und Teilhabe / BuT</em>): covers school supplies, school lunches, transport, tutoring, and a allowance for sports or cultural clubs. It requires a separate application via the Jobcenter or local authority, and many families miss out on it.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 6 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingG6\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseG6\" aria-expanded=\"false\" aria-controls=\"collapseG6\">\n                    What is Kindergeld and how do I apply for it?\n                </button>\n            </h3>\n            <div id=\"collapseG6\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartG\">\n                <div class=\"accordion-body\">\n                    <em>Kindergeld</em> is a child benefit paid monthly for each child. Applications are submitted to the <em>Familienkasse</em> of the Federal Employment Agency.<br><br>\n                    • <strong>Official portal:</strong> <a href=\"https://www.arbeitsagentur.de/familie-und-kinder\" target=\"_blank\" rel=\"noopener\">www.arbeitsagentur.de/familie-und-kinder</a><br>\n                    • <strong>Hotline:</strong> <a href=\"tel:08004555530\">0800 4 5555 30</a>\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 7 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingG7\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseG7\" aria-expanded=\"false\" aria-controls=\"collapseG7\">\n                    There is a problem at school and I cannot communicate. What should I do?\n                </button>\n            </h3>\n            <div id=\"collapseG7\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartG\">\n                <div class=\"accordion-body\">\n                    Contact us — often a translated conversation with the school staff is enough to resolve the issue. Additionally, every school has an advisory teacher (<em>Beratungslehrer</em>), and every district offers an educational psychological support service (<em>Schulpsychologischer Dienst</em>).\n                </div>\n            </div>\n        </div>\n\n    </div>\n</div>\n            <!-- PART H: Health -->\n<!-- PART H: Health & Medical -->\n<div class=\"faq-topic-section\">\n    <h2 class=\"topic-title\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M21 11c0 5.55-3.84 10.74-9 12-5.16-1.26-9-6.45-9-12V5l9-4 9 4v6zm-9 10c3.75-1 7-5.46 7-9.78V6.3l-7-3.11-7 3.11v4.92C5 15.54 8.25 20 12 21zm-1-6h2v-2h2v-2h-2V9h-2v2H9v2h2v2z\"></path></svg>\n        Part H — Health &amp; Medical\n    </h2>\n    <div class=\"accordion custom-accordion\" id=\"accordionPartH\">\n        \n        <!-- Question 1 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingH1\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseH1\" aria-expanded=\"false\" aria-controls=\"collapseH1\">\n                    What happens if I'm sick and don't have insurance yet?\n                </button>\n            </h3>\n            <div id=\"collapseH1\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartH\">\n                <div class=\"accordion-body\">\n                    In an emergency, you will receive medical treatment regardless. Do not avoid going to the emergency room because of paperwork. However, you must arrange your health insurance coverage as soon as possible afterwards.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 2 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingH2\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseH2\" aria-expanded=\"false\" aria-controls=\"collapseH2\">\n                    What is covered by health insurance?\n                </button>\n            </h3>\n            <div id=\"collapseH2\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartH\">\n                <div class=\"accordion-body\">\n                    Statutory health insurance covers family doctors (GPs), specialists (often with a referral), hospital stays, prescription medications, emergency treatment, pregnancy and childbirth care, vaccinations, and routine health check-ups.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 3 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingH3\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseH3\" aria-expanded=\"false\" aria-controls=\"collapseH3\">\n                    Can I reduce medication costs?\n                </button>\n            </h3>\n            <div id=\"collapseH3\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartH\">\n                <div class=\"accordion-body\">\n                    Yes. Bürgergeld recipients are entitled to an exemption from co-payments (<em>Zuzahlungsbefreiung</em>). You must submit an application for this directly to your health insurance fund (<em>Krankenkasse</em>).\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 4 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingH4\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseH4\" aria-expanded=\"false\" aria-controls=\"collapseH4\">\n                    Can I get an interpreter for a medical appointment?\n                </button>\n            </h3>\n            <div id=\"collapseH4\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartH\">\n                <div class=\"accordion-body\">\n                    In complex medical situations, funding for an interpreter can sometimes be approved. Eligibility varies by case and health insurance fund, so it is best to check with your <em>Krankenkasse</em> in advance. We can also assist in connecting you with a volunteer interpreter.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 5 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingH5\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseH5\" aria-expanded=\"false\" aria-controls=\"collapseH5\">\n                    The clinics are closed and I need a doctor.\n                </button>\n            </h3>\n            <div id=\"collapseH5\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartH\">\n                <div class=\"accordion-body\">\n                    Call the national on-call medical service: <a href=\"tel:116117\"><strong>116 117</strong></a> — for non-life-threatening medical care outside regular clinic hours. For life-threatening emergencies, dial <a href=\"tel:112\"><strong>112</strong></a> immediately.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 6 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingH6\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseH6\" aria-expanded=\"false\" aria-controls=\"collapseH6\">\n                    How do I find an emergency pharmacy on call?\n                </button>\n            </h3>\n            <div id=\"collapseH6\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartH\">\n                <div class=\"accordion-body\">\n                    Pharmacies operate on a regional emergency duty rotation system (<em>Apotheken-Notdienst</em>). The current schedule is posted on the front door of every pharmacy and is also available on official local pharmacy websites.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 7 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingH7\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseH7\" aria-expanded=\"false\" aria-controls=\"collapseH7\">\n                    I need mental health support. What should I do?\n                </button>\n            </h3>\n            <div id=\"collapseH7\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartH\">\n                <div class=\"accordion-body\">\n                    Seeking support is completely normal and valid, and many people in your situation need help. Your first point of contact is your family doctor (GP), who can provide a referral for therapy or mental health care. In cases of acute mental health distress or crisis, contact emergency services directly.\n                </div>\n            </div>\n        </div>\n\n    </div>\n</div>\n\n <!-- PART I: Language, Work & Integration -->\n<div class=\"faq-topic-section\">\n    <h2 class=\"topic-title\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z\"></path></svg>\n        Part I — Language, Work &amp; Integration\n    </h2>\n    <div class=\"accordion custom-accordion\" id=\"accordionPartI\">\n        \n        <!-- Question 1 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingI1\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseI1\" aria-expanded=\"false\" aria-controls=\"collapseI1\">\n                    Do you assist with job searches?\n                </button>\n            </h3>\n            <div id=\"collapseI1\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartI\">\n                <div class=\"accordion-body\">\n                    Not directly. We can assist with general guidance and sometimes connect you with local employers or networks, but we are not an employment agency. The official authority for job placement is the Employment Agency (<em>Agentur für Arbeit</em>) or the Jobcenter.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 2 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingI2\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseI2\" aria-expanded=\"false\" aria-controls=\"collapseI2\">\n                    Where can I learn German?\n                </button>\n            </h3>\n            <div id=\"collapseI2\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartI\">\n                <div class=\"accordion-body\">\n                    You can learn German through a BAMF integration course or through courses offered by the local <em>Volkshochschule</em> (VHS).<br><br>\n                    • <strong>Find courses by location:</strong> <a href=\"https://bamf-navi.bamf.de\" target=\"_blank\" rel=\"noopener\">bamf-navi.bamf.de</a><br>\n                    • <strong>BAMF Website:</strong> <a href=\"https://www.bamf.de\" target=\"_blank\" rel=\"noopener\">www.bamf.de</a><br>\n                    • <strong>BAMF Hotline:</strong> <a href=\"tel:09119430\">0911 943-0</a>\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 3 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingI3\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseI3\" aria-expanded=\"false\" aria-controls=\"collapseI3\">\n                    I was rejected from an integration course in recent months. What should I do?\n                </button>\n            </h3>\n            <div id=\"collapseI3\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartI\">\n                <div class=\"accordion-body\">\n                    You should try applying again. Regulations changed several times during 2026, opening up new opportunities that were not available earlier in the year. Contact the Jobcenter or the BAMF directly to re-verify your current status. Do not rely on information provided to you six months ago.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 4 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingI4\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseI4\" aria-expanded=\"false\" aria-controls=\"collapseI4\">\n                    What level of German language proficiency do I need?\n                </button>\n            </h3>\n            <div id=\"collapseI4\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartI\">\n                <div class=\"accordion-body\">\n                    For most significant integration goals, you need <strong>B1 level</strong>. This is the standard threshold required for obtaining a permanent residence permit (<em>Niederlassungserlaubnis</em>) and for citizenship applications.\n                </div>\n            </div>\n        </div>\n\n        <!-- Question 5 -->\n        <div class=\"accordion-item\">\n            <h3 class=\"accordion-header\" id=\"headingI5\">\n                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseI5\" aria-expanded=\"false\" aria-controls=\"collapseI5\">\n                    How do I get my qualifications or degree from Ukraine recognized?\n                </button>\n            </h3>\n            <div id=\"collapseI5\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionPartI\">\n                <div class=\"accordion-body\">\n                    Degree and trade recognition is done through the official recognition procedure (<em>Anerkennung</em>). Start as early as possible, as the process can take several months. In many cases, the Jobcenter or Employment Agency can cover the associated evaluation costs.<br><br>\n                    Official portal: <a href=\"https://www.anerkennung-in-deutschland.de\" target=\"_blank\" rel=\"noopener\">www.anerkennung-in-deutschland.de</a>\n                </div>\n            </div>\n        </div>\n\n    </div>\n</div>    \n<!-- PART J: Community & Volunteering -->\n            <div class=\"faq-topic-section\">\n                <h2 class=\"topic-title\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\"></path></svg>\n                    Part J — Community, Volunteering &amp; Apartments\n                </h2>\n                <div class=\"accordion custom-accordion\" id=\"accordionPartJ\">\n                    \n                    <!-- J1 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingJ1\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseJ1\" aria-expanded=\"false\" aria-controls=\"collapseJ1\">\n                                Can we join the community?\n                            </button>\n                        </h3>\n                        <div id=\"collapseJ1\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingJ1\" data-bs-parent=\"#accordionPartJ\">\n                            <div class=\"accordion-body\">\n                                Yes, and it is highly recommended. Write to us and we will connect you to the local group and families in your area. Isolation is one of the biggest challenges in the first year.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- J2 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingJ2\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseJ2\" aria-expanded=\"false\" aria-controls=\"collapseJ2\">\n                                What happens in the community in practice?\n                            </button>\n                        </h3>\n                        <div id=\"collapseJ2\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingJ2\" data-bs-parent=\"#accordionPartJ\">\n                            <div class=\"accordion-body\">\n                                Informal meetups, WhatsApp groups by city, passing along furniture and equipment between families, accompanying people to appointments, sharing practical information, and connecting veteran families with new ones.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- J3 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingJ3\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseJ3\" aria-expanded=\"false\" aria-controls=\"collapseJ3\">\n                                I want to volunteer. Is it possible?\n                            </button>\n                        </h3>\n                        <div id=\"collapseJ3\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingJ3\" data-bs-parent=\"#accordionPartJ\">\n                            <div class=\"accordion-body\">\n                                Absolutely. Translation — our greatest need — driving and transport, moving items, accompanying people to appointments, professional assistance, or simply your time. No long-term commitment is required.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- J4 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingJ4\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseJ4\" aria-expanded=\"false\" aria-controls=\"collapseJ4\">\n                                Can I offer an apartment?\n                            </button>\n                        </h3>\n                        <div id=\"collapseJ4\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingJ4\" data-bs-parent=\"#accordionPartJ\">\n                            <div class=\"accordion-body\">\n                                Yes. Property owners in the area are welcome to reach out via WhatsApp or email with the property details — city, size, number of rooms, floor, base rent and utilities, and available move-in date. We will explain the process and the Jobcenter's involvement.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- J5 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingJ5\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseJ5\" aria-expanded=\"false\" aria-controls=\"collapseJ5\">\n                                What exactly is required of me as a landlord?\n                            </button>\n                        </h3>\n                        <div id=\"collapseJ5\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingJ5\" data-bs-parent=\"#accordionPartJ\">\n                            <div class=\"accordion-body\">\n                                A standard rental agreement, residency confirmation for <em>Anmeldung</em> purposes, and basic cooperation with the Jobcenter regarding apartment approval. We guide the process from both sides.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- J6 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingJ6\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseJ6\" aria-expanded=\"false\" aria-controls=\"collapseJ6\">\n                                I want to donate furniture. How?\n                            </button>\n                        </h3>\n                        <div id=\"collapseJ6\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingJ6\" data-bs-parent=\"#accordionPartJ\">\n                            <div class=\"accordion-body\">\n                                Write to us about what you have, its condition, which city you are in, and whether you can assist with transport. We are happy to accept even a single item.\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n<!-- PART K: Emergencies -->\n            <div class=\"faq-topic-section\">\n                <h2 class=\"topic-title\" style=\"color: #dc2626;\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2L1 21h22M12 6l7.53 13H4.47M11 10v4h2v-4m-2 6v2h2v-2\"></path></svg>\n                    Part K — Emergencies &amp; Urgent Situations\n                </h2>\n                <div class=\"accordion custom-accordion\" id=\"accordionPartK\">\n                    \n                    <!-- K1 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingK1\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseK1\" aria-expanded=\"false\" aria-controls=\"collapseK1\">\n                                What to do in an emergency?\n                            </button>\n                        </h3>\n                        <div id=\"collapseK1\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingK1\" data-bs-parent=\"#accordionPartK\">\n                            <div class=\"accordion-body\">\n                                <strong>112</strong> — Ambulance and Fire Department. <strong>110</strong> — Police. <strong>116 117</strong> — On-call doctor. We are NOT an emergency hotline and do not replace them.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- K2 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingK2\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseK2\" aria-expanded=\"false\" aria-controls=\"collapseK2\">\n                                What to say in an emergency call?\n                            </button>\n                        </h3>\n                        <div id=\"collapseK2\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingK2\" data-bs-parent=\"#accordionPartK\">\n                            <div class=\"accordion-body\">\n                                State where you are (city and street), what happened, how many people are involved, and who you are. You can say \"Ukrainisch\" or \"English\" and ask for an interpreter. Do not hang up until you are told to do so.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- K3 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingK3\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseK3\" aria-expanded=\"false\" aria-controls=\"collapseK3\">\n                                I have nowhere to sleep tonight.\n                            </button>\n                        </h3>\n                        <div id=\"collapseK3\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingK3\" data-bs-parent=\"#accordionPartK\">\n                            <div class=\"accordion-body\">\n                                Contact us immediately, as well as the municipality — the local authority is obligated to provide a solution for homelessness. We will try to assist and coordinate, but we cannot guarantee an immediate solution.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- K4 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingK4\">\n                            <button class=\"accordion-button\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseK4\" aria-expanded=\"true\" aria-controls=\"collapseK4\">\n                                I am experiencing domestic violence.\n                            </button>\n                        </h3>\n                        <div id=\"collapseK4\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingK4\" data-bs-parent=\"#accordionPartK\">\n                            <div class=\"accordion-body\">\n                                Contact the police immediately at <strong>110</strong>. Germany has a highly developed protection system, including women's shelters (<em>Frauenhaus</em>) and restraining orders. Even if your residency status is unstable, reaching out to the police will not harm it.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- K5 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingK5\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseK5\" aria-expanded=\"false\" aria-controls=\"collapseK5\">\n                                I received a letter with an urgent deadline and I don't understand it.\n                            </button>\n                        </h3>\n                        <div id=\"collapseK5\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingK5\" data-bs-parent=\"#accordionPartK\">\n                            <div class=\"accordion-body\">\n                                Take a picture and send it to us immediately. This is exactly the type of situation where you should contact us and not wait.\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- K6 -->\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\" id=\"headingK6\">\n                            <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseK6\" aria-expanded=\"false\" aria-controls=\"collapseK6\">\n                                Do you provide legal advice?\n                            </button>\n                        </h3>\n                        <div id=\"collapseK6\" class=\"accordion-collapse collapse\" aria-labelledby=\"headingK6\" data-bs-parent=\"#accordionPartK\">\n                            <div class=\"accordion-body\">\n                                No. We explain processes and provide guidance, but we are not lawyers and are not authorized to give legal advice. In cases that require it, we will direct you to a qualified professional.\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n\n        </div> <!-- End FAQ Categories -->\n\n        <!-- Official Contacts & Links Grid -->\n        <div class=\"official-links-section\">\n            <h3 class=\"links-title\">Official Contacts &amp; Portals</h3>\n            <div class=\"links-grid\">\n                \n                <div class=\"link-card\">\n                    <h4>National Portals</h4>\n                    <ul>\n                        <li><a href=\"https://www.germany4ukraine.de\" target=\"_blank\" rel=\"noopener\">Germany4Ukraine</a> — Official portal for refugees</li>\n                        <li><a href=\"https://www.bamf.de\" target=\"_blank\" rel=\"noopener\">BAMF (0911 943-0)</a> — Migration &amp; Refugees</li>\n                        <li><a href=\"https://www.arbeitsagentur.de\" target=\"_blank\" rel=\"noopener\">Agentur für Arbeit</a> — Employment Agency</li>\n                        <li><a href=\"https://handbookgermany.de\" target=\"_blank\" rel=\"noopener\">Handbook Germany</a> — Multilingual life guide</li>\n                        <li><a href=\"https://www.anerkennung-in-deutschland.de\" target=\"_blank\" rel=\"noopener\">Anerkennung in Deutschland</a> — Degree recognition</li>\n                    </ul>\n                </div>\n\n                <div class=\"link-card\">\n                    <h4>Regional &amp; Free Consulting</h4>\n                    <ul>\n                        <li><strong>Free Migration Counseling:</strong> Search for MBE (Adults) or JMD (Youth up to 27) provided by Caritas, Diakonie, AWO, or Red Cross.</li>\n                        <li><a href=\"https://www.landkreis-hof.de\" target=\"_blank\" rel=\"noopener\">Landkreis Hof</a></li>\n                        <li><a href=\"https://www.landkreis-wunsiedel.de\" target=\"_blank\" rel=\"noopener\">Landkreis Wunsiedel</a></li>\n                        <li><a href=\"https://www.landkreis-kulmbach.de\" target=\"_blank\" rel=\"noopener\">Landkreis Kulmbach</a></li>\n                    </ul>\n                </div>\n\n            </div>\n            <p class=\"cant-find-text\">Didn't find an answer? Write to us. Even a small question is a question.</p>\n        </div>\n\n    \n</section>",
          "_cid": "vqc8V2TwSh",
          "_anchor": "list01-b",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            },
            "a[href*=\"thebwas.com\"]": {
              "text-decoration": "underline",
              "text-underline-offset": "3px"
            },
            ".soc-item a": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-width": "44px",
              "min-height": "44px"
            },
            ".item-wrap a": {
              "word-break": "normal !important",
              "overflow-wrap": "normal !important",
              "hyphens": "auto",
              "-webkit-hyphens": "auto"
            },
            "@media (max-width: 767px)": {
              ".lists-wrapper": {
                "display": "grid !important",
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr)",
                "column-gap": "16px"
              },
              ".lists-wrapper .list-wrap": {
                "width": "auto !important",
                "max-width": "none !important",
                "margin": "0 !important"
              },
              ".lists-wrapper .item-wrap a": {
                "overflow-wrap": "break-word !important"
              }
            }
          },
          "_name": "footer01",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 scalem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"50\" max=\"400\" step=\"10\" value=\"150\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Lists\" name=\"showLists\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"list\" min=\"1\" max=\"5\" step=\"1\" value=\"4\" condition=\"showLists\">\n        <input type=\"color\" title=\"List Active Color\" value=\"#ffffff\" name=\"activeList\" condition=\"showLists\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Social Active Color\" value=\"#FF5753\" name=\"active\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#635d60\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#0c2c68\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#292325\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            \n            <!-- עמודת טקסט וכותרת ראשית -->\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showTitle || showText || showButtons || showLogo\">\n                <div class=\"content-wrapper\">\n                    <!-- תוספת המקום ללוגו -->\n                    <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"ZusammenLeben\" width=\"171\" height=\"171\">\n                        </a>\n                    </div>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>\n                        ZUSAMMENLEBEN\n                    </b></h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                        Supporting integration, housing, and community connection for newcomers and locals in the area.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-phone mbr-iconfont mbr-iconfont-btn\"></span>\n                            Contact Us\n                        </a></div>\n                </div>\n            </div>\n\n            <!-- עמודות הקישורים -->\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLists\">\n                <div class=\"lists-wrapper\">\n                    <div class=\"list-wrap\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Home</a></li>\n                            <li class=\"item-wrap\"><a href=\"family-stories.html\" class=\"text-white\">Family Stories</a></li>\n                            <li class=\"item-wrap\"><a href=\"services.html\" class=\"text-white\">Services</a></li>\n                            <li class=\"item-wrap\"><a href=\"request-assistance.html\" class=\"text-white\">Request Assistance</a></li>\n                            <li class=\"item-wrap\"><a href=\"community.html\" class=\"text-white\">Community</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"living-in-germany.html\" class=\"text-white\">Living in Germany</a></li>\n                            <li class=\"item-wrap\"><a href=\"glossary.html\" class=\"text-white\">Glossary</a></li>\n                            <li class=\"item-wrap\"><a href=\"learning-german.html\" class=\"text-white\">Learning German</a></li>\n                            <li class=\"item-wrap\"><a href=\"refugee-rights.html\" class=\"text-white\">Refugee Rights</a></li>\n                            <li class=\"item-wrap\"><a href=\"guides.html\" class=\"text-white\">Guides</a></li>\n                            <li class=\"item-wrap\"><a href=\"anna-shishoili.html\" class=\"text-white text-primary\">Anna Cheishvili</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 2\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"how-to-help.html\" class=\"text-white\">How Can You Help</a></li>\n                            <li class=\"item-wrap\"><a href=\"social-activity.html\" class=\"text-white\">Social Activity</a></li>\n                            <li class=\"item-wrap\"><a href=\"faq.html\" class=\"text-white\">FAQ</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Areas We Serve</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 3\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"emergency.html\" class=\"text-white\">Emergency</a></li>\n                            <li class=\"item-wrap\"><a href=\"Contact.html\" class=\"text-white\">Contact</a></li>\n                            <li class=\"item-wrap\"><a href=\"https://wa.me/380637004615\" class=\"text-white\" target=\"_blank\" rel=\"noopener\">WhatsApp Support</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Location</a></li>\n                            <li class=\"item-wrap\"><a href=\"impressum.html\" class=\"text-white\">Legal Notice</a></li>\n                            <li class=\"item-wrap\"><a href=\"privacy.html\" class=\"text-white\">Privacy Policy</a></li>\n                            <li class=\"item-wrap\"><a href=\"usingtheweb.html\" class=\"text-white\">Terms of Use</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 4\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Privacy Policy</a></li>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Terms of Use</a></li>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Impressum</a></li>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Official Site</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- אזור זכויות יוצרים ורשתות חברתיות -->\n            <div class=\"col-12\" mbr-if=\"showSocial || showCopy\">\n                <div class=\"copy-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://wa.me/380637004615\" target=\"_blank\" rel=\"noopener\" aria-label=\"WhatsApp\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-whatsapp\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"mailto:zusammenleben.de@gmail.com\" aria-label=\"E-Mail\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy, .social-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\">\n                        © Copyright 2026 Zusammenleben - All Rights Reserved · Website by <a href=\"https://thebwas.com/\" class=\"text-white\">Amit Shechter</a>\n                    </p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
