              "font-size": "15px"
            },
            ".zl-ico": {
              "width": "42px",
              "height": "42px",
              "border-radius": "12px",
              "display": "grid",
              "place-items": "center",
              "background": "#e0e7ff",
              "color": "#0c2c68"
            },
            ".zl-ico svg": {
              "width": "22px",
              "height": "22px"
            },
            ".zl-hub-head": {
              "margin-bottom": "26px",
              "max-width": "760px"
            },
            ".zl-hub-head .zl-lead": {
              "margin-bottom": "0"
            },
            ".zl-comm-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(230px, 1fr))",
              "gap": "16px",
              "margin": "6px 0 0"
            },
            ".zl-comm-grid .zl-tile:hover": {
              "transform": "none",
              "box-shadow": "none",
              "border-color": "#e2e8f0"
            },
            "@media (max-width: 575px)": {
              ".zl-grid": {
                "grid-template-columns": "1fr 1fr",
                "gap": "10px"
              },
              ".zl-grid .zl-tile": {
                "padding": "14px",
                "gap": "8px"
              },
              ".zl-grid .zl-tile p, .zl-grid .zl-tile .zl-more": {
                "display": "none"
              },
              ".zl-grid .zl-tile h2, .zl-grid .zl-tile h3": {
