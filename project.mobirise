    "refugee-rights.html": {
      "settings": {
        "title": "Rights of Ukrainian Refugees in Germany | ZusammenLeben",
        "order": "7",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/refugee-rights.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/refugee-rights.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/refugee-rights.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/refugee-rights.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/refugee-rights.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Rights of Ukrainian Refugees in Germany | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"Your rights with temporary protection in Germany: residence, work, benefits, health care, school and where to get independent advice.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/refugee-rights.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"url\":\"https://zusammenleben-ukraine.de/refugee-rights.html\",\"name\":\"Rights of Ukrainian Refugees in Germany\",\"description\":\"Your rights with temporary protection in Germany: residence, work, benefits, health care, school and where to get independent advice.\",\"inLanguage\":\"en\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"},\"about\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Rights of Ukrainian Refugees in Germany\",\"item\":\"https://zusammenleben-ukraine.de/refugee-rights.html\"}]}]}</script>",
        "meta_descr": "Your rights with temporary protection in Germany: residence, work, benefits, health care, school and where to get independent advice."
      },
      "components": [
        {
          "_name": "amenu1",
          "_sourceTheme": "solarm5",
          "_styles": {
            "& when (@sticky)": {
