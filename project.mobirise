                "color": "@primaryColor !important"
              }
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".navbar-buttons": {
              "text-align": "center",
              "min-width": "0",
              "flex-shrink": "0"
            },
