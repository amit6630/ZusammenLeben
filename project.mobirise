        {
          "_styles": {
            ".guide-executive-section": {
              "padding": "100px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.6",
              "direction": "ltr",
              "text-align": "left"
            },
            ".guide-executive-section *": {
              "box-sizing": "border-box"
            },
            ".executive-container": {
              "max-width": "1000px",
              "margin": "0 auto",
              "padding": "0 24px"
            },
            ".guide-header": {
              "text-align": "center",
              "max-width": "820px",
              "margin": "0 auto 40px"
            },
            ".header-tag": {
              "font-size": "0.8rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-bottom": "12px",
              "margin-top": "50px",
              "display": "block",
              "text-transform": "uppercase"
            },
            ".header-title": {
              "font-size": "2.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.02em",
              "margin": "0 0 16px 0",
              "line-height": "1.25"
            },
            ".header-lead": {
              "font-size": "1.15rem",
              "color": "#475569",
              "margin": "0"
            },
            ".disclaimer-banner": {
              "background": "#fffbeb",
              "border": "1px solid #fde68a",
              "border-radius": "12px",
              "padding": "20px 24px",
              "display": "flex",
              "gap": "16px",
              "align-items": "flex-start",
              "margin-bottom": "50px"
            },
            ".disclaimer-icon": {
              "font-size": "1.4rem",
              "flex-shrink": "0"
            },
            ".disclaimer-text": {
              "font-size": "0.95rem",
              "color": "#92400e",
              "line-height": "1.55"
            },
            ".guide-block": {
              "margin-bottom": "55px"
            },
            ".block-title": {
              "font-size": "1.45rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "24px",
              "display": "flex",
              "align-items": "center",
              "gap": "10px",
              "border-bottom": "2px solid #e2e8f0",
              "padding-bottom": "12px"
            },
            ".title-icon": {
              "font-size": "1.3rem"
            },
            ".guide-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "32px",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.02)"
            },
            ".two-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "20px"
            },
            ".three-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(240px, 1fr))",
              "gap": "20px"
            },
            ".guide-subcard": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "14px",
              "padding": "24px",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.02)"
            },
            ".guide-subcard h3": {
              "font-size": "1.15rem",
              "font-weight": "800",
              "margin": "0 0 12px 0",
              "text-transform": "uppercase",
              "letter-spacing": "0.5px"
            },
            ".guide-subcard p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin-bottom": "0"
            },
            ".detail-box h4": {
              "font-size": "1rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".detail-box p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.5"
            },
            ".rule-box": {
              "padding": "24px",
              "border-radius": "14px",
              "border": "1px solid",
              "border-left-width": "5px"
            },
            ".numbered-list": {
              "padding-left": "0",
              "margin": "0",
              "list-style": "none"
            },
            ".numbered-list li": {
              "background": "#f8fafc",
              "border": "1px solid #f1f5f9",
              "padding": "16px 20px",
              "border-radius": "10px",
              "margin-bottom": "12px",
              "font-size": "0.95rem",
              "color": "#1e293b",
              "line-height": "1.6"
            },
            ".numbered-list li strong": {
              "color": "#0f172a"
            },
            ".numbered-list li:last-child": {
              "margin-bottom": "0"
            },
            ".guide-executive-section .btn.custom-btn": {
              "padding": "14px 28px !important",
              "border-radius": "100px !important",
              "font-weight": "600 !important",
              "font-size": "1rem !important",
              "margin": "0 !important",
              "transition": "all 0.3s ease !important",
              "border-width": "2px !important",
              "text-decoration": "none"
            },
            ".guide-executive-section .btn.outline-btn": {
              "background-color": "transparent !important",
              "border-color": "#2563eb !important",
              "color": "#2563eb !important"
            },
            ".guide-executive-section .btn.outline-btn:hover": {
              "background-color": "#eff6ff !important",
              "color": "#1d4ed8 !important",
              "border-color": "#1d4ed8 !important",
              "transform": "translateY(-2px) !important"
            },
            ".guide-executive-section .btn.whatsapp-btn": {
              "background-color": "#25d366 !important",
              "border-color": "#25d366 !important",
              "color": "#ffffff !important",
              "box-shadow": "0 4px 14px rgba(37, 211, 102, 0.2) !important"
            },
            ".guide-executive-section .btn.whatsapp-btn:hover": {
              "background-color": "#20bd5a !important",
              "border-color": "#20bd5a !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 6px 20px rgba(37, 211, 102, 0.3) !important"
            },
            "@media (max-width: 768px)": {
              ".header-title": {
                "font-size": "2rem"
              },
              ".guide-card, .guide-subcard, .rule-box": {
                "padding": "20px"
              },
              ".mbr-section-btn": {
                "flex-direction": "column",
                "width": "100%"
              },
              ".guide-executive-section .btn.custom-btn": {
                "width": "100%",
                "justify-content": "center",
                "text-align": "center"
              },
              ".disclaimer-banner": {
                "flex-direction": "column",
                "align-items": "center",
                "text-align": "center"
              }
            }
          },
          "_name": "list01",
          "_sourceTheme": "guidem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"guide-executive-section\" id=\"contact-guide-section\">\n    <div class=\"executive-container\">\n        \n        <!-- Header -->\n        <header class=\"guide-header\">\n            <span class=\"header-tag\">GET IN TOUCH</span>\n            <h1 class=\"header-title\">Contact Us</h1>\n            <p class=\"header-lead\">\n                One direct address, no forms, and no queues.\n            </p>\n        </header>\n\n        <!-- General Disclaimer / Intro -->\n        <div class=\"disclaimer-banner\" style=\"background: #eff6ff; border-color: #bfdbfe;\">\n            <div class=\"disclaimer-icon\" style=\"display: flex; align-items: center; justify-content: center;\">\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#1e3a8a\"><path d=\"M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z\"></path></svg>\n            </div>\n            <div class=\"disclaimer-text\" style=\"color: #1e3a8a;\">\n                <strong>Direct Communication:</strong> We do not work with online forms and we do not collect information through the website. The way to reach us is direct: a message on WhatsApp or an email. Write in the language most comfortable for you — Ukrainian, Russian, German, or English.\n            </div>\n        </div>\n\n        <!-- Section 1: Contact Details (Grid) -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\" style=\"display: flex; align-items: center; gap: 10px;\">\n                <span class=\"title-icon\" style=\"display: inline-flex; align-items: center;\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z\"></path></svg>\n                </span> \n                Our Contact Information\n            </h2>\n            \n            <div class=\"two-column-grid\">\n                <!-- WhatsApp -->\n                <div class=\"guide-subcard\" style=\"border-top: 4px solid #25d366;\">\n                    <h3><span style=\"color: #25d366; display: inline-flex; align-items: center; gap: 8px;\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12.031 2c-5.514 0-9.996 4.482-9.996 9.996 0 1.763.459 3.486 1.332 5.013l-1.417 5.176 5.297-1.389c1.474.804 3.141 1.226 4.784 1.226 5.514 0 9.996-4.482 9.996-9.996 0-5.514-4.482-9.996-9.996-9.996zm0 18.286c-1.479 0-2.929-.396-4.195-1.147l-.301-.179-3.12.818.832-3.041-.197-.313c-.822-1.309-1.256-2.825-1.256-4.372 0-4.413 3.587-8 8-8s8 3.587 8 8-3.587 8.034-8 8.034z\"></path></svg>\n                        WhatsApp\n                    </span></h3>\n                    <p style=\"font-size: 1.1rem; font-weight: 700; color: #0f172a; margin-bottom: 8px;\"><a href=\"https://wa.me/380637004615\" class=\"text-primary\">+380 63 700 4615</a></p>\n                    <p>The fastest and most recommended way to get in touch. You can send a text message, a voice note, or a photo of a letter you received.</p>\n                </div>\n\n                <!-- Email -->\n                <div class=\"guide-subcard\" style=\"border-top: 4px solid #3b82f6;\">\n                    <h3><span style=\"color: #3b82f6; display: inline-flex; align-items: center; gap: 8px;\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z\"></path></svg>\n                        Email\n                    </span></h3>\n                    <p style=\"font-size: 1.1rem; font-weight: 700; color: #0f172a; margin-bottom: 8px;\"><a href=\"mailto:zusammenleben.de@gmail.com\" class=\"text-primary\">zusammenleben.de@gmail.com</a></p>\n                    <p>Suitable for more detailed inquiries, communications from authorities and organizations, and anything that requires documentation.</p>\n                </div>\n            </div>\n\n            <!-- Quick Info Bar -->\n            <div class=\"guide-card\" style=\"margin-top: 24px; padding: 24px;\">\n                <div class=\"three-column-grid\">\n                    <div class=\"detail-box\" style=\"background: #ffffff; border: none; padding: 0;\">\n                        <h4 style=\"display: flex; align-items: center; gap: 8px;\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#2563eb\"><path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\"></path></svg>\n                            Donation Address\n                        </h4>\n                        <p><strong>Konradsreuth, Alte Hofer Str. 1</strong><br>For drop-offs: Food, clothing, and furniture.</p>\n                    </div>\n                    <div class=\"detail-box\" style=\"background: #ffffff; border: none; padding: 0;\">\n                        <h4 style=\"display: flex; align-items: center; gap: 8px;\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#2563eb\"><path d=\"M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z\"></path></svg>\n                            Response Hours\n                        </h4>\n                        <p><strong>Every day, 09:00 – 21:00</strong><br>We try to be available. Messages sent outside these hours will be read and answered later.</p>\n                    </div>\n                    <div class=\"detail-box\" style=\"background: #ffffff; border: none; padding: 0;\">\n                        <h4 style=\"display: flex; align-items: center; gap: 8px;\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#2563eb\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z\"></path></svg>\n                            Service Info\n                        </h4>\n                        <p><strong>Area:</strong> Northern Bavaria &amp; Upper Franconia.<br><strong>Languages:</strong> Ukrainian, Russian, German, English.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 2: By Type of Inquiry -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\" style=\"display: flex; align-items: center; gap: 10px;\">\n                <span class=\"title-icon\" style=\"display: inline-flex; align-items: center;\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 16H5V5h2v2h10V5h2v14z\"></path></svg>\n                </span> \n                By Type of Inquiry\n            </h2>\n            <p style=\"margin-bottom: 20px; color: #475569;\">To ensure your message reaches the right person quickly, please mention the type of inquiry in your first line:</p>\n            \n            <div class=\"guide-card\">\n                <ul class=\"numbered-list\" style=\"list-style: none; padding-left: 0;\">\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\"></path></svg>\n                        <span><strong>Requesting Family Assistance:</strong> Please specify the city you are in, the number of people, the ages of the children, and what the main need is right now.</span>\n                    </li>\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"></path></svg>\n                        <span><strong>Personal Inquiry to Anna:</strong> Write directly on WhatsApp. If you are already in touch with her, continue in the same chat.</span>\n                    </li>\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\"></path></svg>\n                        <span><strong>Offering an Apartment:</strong> Specify the city, apartment size in sq.m., number of rooms, floor, whether there is an elevator, basic rent (Kaltmiete) and utilities (Nebenkosten), possible move-in date, and if the apartment is furnished. We will get back to you with a full explanation of the process.</span>\n                    </li>\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"></path></svg>\n                        <span><strong>Volunteering:</strong> Write how you can help, in which area, and what your availability is.</span>\n                    </li>\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z\"></path></svg>\n                        <span><strong>Equipment/Furniture Donation:</strong> Specify what you have, its condition, which city it is in, and whether you can assist with transportation.</span>\n                    </li>\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z\"></path></svg>\n                        <span><strong>Collaboration:</strong> Businesses, professionals, and service providers in the area are welcome to reach out via email.</span>\n                    </li>\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M4 10v7h3v-7H4zm6 0v7h3v-7h-3zM2 22h19v-3H2v3zm14-12v7h3v-7h-3zm-4.5-9L2 6v2h19V6l-9.5-5z\"></path></svg>\n                        <span><strong>Authorities &amp; Organizations:</strong> Email is preferred for tracking and documentation purposes.</span>\n                    </li>\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z\"></path></svg>\n                        <span><strong>Media Inquiries:</strong> By email only. We are happy to talk, subject to the absolute protection of the families' privacy.</span>\n                    </li>\n                    <li style=\"margin-bottom: 0; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 16h-2v-2h2v2zm1.07-7.75l-.9.92C12.45 11.9 12 12.5 12 14h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z\"></path></svg>\n                        <span><strong>General Questions:</strong> Any question, big or small. If the answer lies with another entity, we will direct you to them.</span>\n                    </li>\n                </ul>\n            </div>\n        </div>\n\n        <!-- Section 3: Attachments & Expectations -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\" style=\"display: flex; align-items: center; gap: 10px;\">\n                <span class=\"title-icon\" style=\"display: inline-flex; align-items: center;\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4s-4 1.79-4 4v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z\"></path></svg>\n                </span> \n                What to Attach — and What Not To\n            </h2>\n            \n            <div class=\"two-column-grid\">\n                <div class=\"rule-box\" style=\"margin-top: 0; background: #f0fdf4; border-color: #bbf7d0; border-left-color: #22c55e;\">\n                    <h3 style=\"color: #166534; margin-top: 0; font-size: 1.1rem; display: flex; align-items: center; gap: 8px;\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#22c55e\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"></path></svg>\n                        Helpful to Attach\n                    </h3>\n                    <p style=\"margin-bottom: 0; color: #15803d;\">A clear photo of an official letter you do not understand, or a copy of a document you need help deciphering.</p>\n                </div>\n                \n                <div class=\"rule-box mail-rule\" style=\"margin-top: 0; background: #fef2f2; border-color: #fecaca; border-left-color: #ef4444;\">\n                    <h3 style=\"color: #991b1b; margin-top: 0; font-size: 1.1rem; display: flex; align-items: center; gap: 8px;\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#ef4444\"><path d=\"M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z\"></path></svg>\n                        No Need to Send\n                    </h3>\n                    <p style=\"margin-bottom: 0; color: #b91c1c;\">Identification documents, medical records, or financial information in the initial stage. If any of this is required later, we will ask explicitly and explain exactly why. <strong>Keep your privacy safe, even with us.</strong></p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 4: Honesty about response times & Emergency -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\" style=\"display: flex; align-items: center; gap: 10px;\">\n                <span class=\"title-icon\" style=\"display: inline-flex; align-items: center;\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M6 2v6l4 4-4 4v6h12v-6l-4-4 4-4V2H6zm10 14.5V18H8v-1.5l4-4 4 4zm-4-5l-4-4V6h8v3.5l-4 4z\"></path></svg>\n                </span> \n                Response Times — Honestly\n            </h2>\n            \n            <div class=\"guide-card\" style=\"margin-bottom: 24px;\">\n                <p>We are a group of volunteers, not a customer service call center. We try our best to reply on the same day, but on busy days, the response may arrive the following day. If you haven't received an answer within two days, please send a gentle reminder — sometimes a message simply gets buried.</p>\n            </div>\n\n            <div class=\"guide-card\" style=\"background: #fff1f2; border-color: #fecaca; padding: 24px;\">\n                <h3 style=\"color: #e11d48; margin-top: 0; margin-bottom: 10px; font-size: 1.25rem; display: flex; align-items: center; gap: 8px;\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#e11d48\"><path d=\"M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z\"></path></svg>\n                    Important: This is not an emergency line\n                </h3>\n                <p style=\"margin-bottom: 0; color: #9f1239;\">In situations of immediate danger — medical, security, or otherwise — please contact the official German emergency services immediately: <strong>Dial 112</strong> (Ambulance &amp; Fire) or <strong>Dial 110</strong> (Police).</p>\n            </div>\n        </div>\n\n        <!-- CTA Buttons -->\n        <div class=\"guide-block\">\n            <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\" style=\"display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; margin-top: 40px;\"><a class=\"btn custom-btn whatsapp-btn display-4 btn-warning\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                        WhatsApp Anna\n                    </a>\n                <a class=\"btn btn-primary custom-btn outline-btn display-4\" href=\"Contact.html#footer4-19\" data-app-placeholder=\"Type Text\" style=\"display: inline-flex; align-items: center; gap: 8px;\">\n                    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z\"></path></svg>\n                    Send an Email\n                </a></div>\n        </div>\n\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "list01-2e",
          "_isUserblock": true,
          "_cid": "vqpuTCauNU",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "footer4",
          "_sourceTheme": "restaurantm4",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "*:focus": {
              "outline": "none",
              "box-shadow": "none"
            },
            ".form-control": {
              "width": "100%",
              "background": "@inputBg",
              "border-radius": "0 !important",
              "border": "none !important",
              "min-height": "47px",
              "&::-webkit-input-placeholder": {
                "color": "contrast(@inputBg)"
              },
              "&::-moz-placeholder": {
                "color": "contrast(@inputBg)"
              },
              "&:-ms-input-placeholder": {
                "color": "contrast(@inputBg)"
              },
              "&:-moz-placeholder": {
                "color": "contrast(@inputBg)"
              }
            },
            "input.form-control": {
              "padding": "0.5rem"
            },
            ".soc-item": {
              "display": "inline-block",
              "margin": "0 0.1rem 0.2rem 0.1rem",
              "padding": "10px 11px 0 11px",
              "border": "2px solid @iconsColor !important",
              "border-radius": "50% !important",
              "&:hover": {
                "opacity": "0.5"
              },
              ".socicon": {
                "font-size": "1.5rem",
                "color": "@iconsColor"
              }
            },
            ".days-column, .hours-column": {
              "display": "inline-block",
              "span": {
                "display": "block"
              }
            },
            ".logo": {
              "img": {
                "width": "auto",
                "display": "inline-block"
              }
            },
            "@media (max-width: 767px)": {
              ".days-column": {
                "padding-right": "0 !important"
              },
              ".hours-column": {
                "max-width": "50% !important"
              },
              ".opening-hours": {
                "padding-bottom": "48px !important"
              }
            },
            ".form-title, .btn-row": {
              "color": "#0c2c68"
            },
            ".follow-title, .social-list, .logo": {
              "color": "#0c2c68"
            },
            ".address-title, .address-block": {
              "color": "#0c2c68"
            },
            ".hours-column": {
              "color": "#0c2c68"
            },
            ".opening-hours-title, .opening-hours": {
              "color": "#0c2c68"
            },
            ".contacts-title, .contacts-block": {
              "color": "#0c2c68",
              "text-align": "center"
            },
            "LABEL": {
              "color": "#0c2c68"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer4 restaurantm4_footer4\" group=\"Footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"1\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n\t\t<input type=\"range\" title=\"Logo\" inline name=\"logoSize\" min=\"5\" max=\"13\" step=\"0.1\" value=\"8\" condition=\"showLogo\">\n\t\t<select title=\"Icons\" name=\"iconsCount\" condition=\"showIcons\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t</select>\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n\t\t<input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#0c2c68\" condition=\"showIcons\">\n\t\t<input type=\"checkbox\" title=\"Address\" name=\"showAddress\">\n\t\t<input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n\t\t<input type=\"checkbox\" title=\"Opening Hours\" name=\"showOpeningHours\">\n\t\t<input type=\"checkbox\" title=\"Form\" name=\"showForm\" checked>\n\t\t<input type=\"color\" title=\"Input Bg\" name=\"inputBg\" value=\"#ffffff\" condition=\"showForm\">\n\t\t<input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background8.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#f7f7f7\" selected>\n\t\t</fieldset>\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t<input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row content justify-content-center align-items-start mbr-white\">\n\t\t\t<div class=\"col-12 col-md-6 col-lg-4 pb-3\" mbr-if=\"showLogo || showAddress || showContacts || showIcons\">\n\t\t\t\t<div class=\"address\" mbr-if=\"showAddress\">\n\t\t\t\t\t<h3 class=\"address-title mbr-fonts-style pb-2 align-center\" mbr-theme-style=\"display-5\" data-app-selector=\".address-title, .address-block\">Contact Us</h3>\n\t\t\t\t\t<p class=\"address-block mbr-fonts-style pb-3 align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".address-title, .address-block\">\n\t\t\t\t\t\tKonradsreuth Alte Hofer Str. 1<br>\n\t\t\t\t\t\tGermany\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"contacts\" mbr-if=\"showContacts\">\n\t\t\t\t\t<h3 class=\"contacts-title mbr-fonts-style pb-2 align-center\" mbr-theme-style=\"display-5\" data-app-selector=\".contacts-title, .contacts-block\"><b>Contact Us</b></h3>\n\t\t\t\t\t<p class=\"contacts-block mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".contacts-title, .contacts-block\">For Support<br><a href=\"tel:+380637004615\" class=\"text-primary\">+380 63 700 4615</a><br><br>Konradsreuth Alte Hofer Str. 1 ⚲\n<br><br><a href=\"mailto:zusammenleben.de@gmail.com\" class=\"text-primary\">zusammenleben.de@gmail.com ✉&nbsp;</a><br><br></p>\n\t\t\t\t</div>\n                <div class=\"social-list pb-3 align-center\" mbr-if=\"showIcons\">\n\t\t\t\t\t<div class=\"soc-item\">\n\t\t\t\t\t\t<a href=\"#\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-whatsapp socicon\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 1\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-facebook socicon\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 2\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 3\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"socicon-instagram socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 4\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"socicon-googleplus socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 5\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"socicon-behance socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"form-1 col-sm-12 col-md-5 col-xl-4\" mbr-class=\"{'col-lg-4': !showOpeningHours || (!showLogo && !showIcons && !showContacts && !showAddress), \n\t\t\t\t'col-lg-3': showOpeningHours && (showLogo || showIcons || showContacts || showAddress)}\" mbr-if=\"showForm\">\n\t\t\t\t<h3 class=\"form-title pb-3 mbr-fonts-style align-center\" mbr-theme-style=\"display-5\" data-app-selector=\".form-title, .btn-row\"><b>Get in tach</b></h3>\n                <div mbr-form>\n<!--Formbuilder Form-->\n<form action=\"zusammenleben.de@gmail.com\" name=\"My Mobirise Form\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"zusammenleben.de@gmail.com\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for filling out the form!</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">\n</div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-lg-6 col-md-12 col-sm-12 form-group\" data-for=\"tel\" style>\n<input type=\"tel\" name=\"tel\" placeholder=\"*Phone \" data-form-field=\"tel\" mbr-theme-style=\"display-7\" required=\"required\" style=\"text-align:left\" class=\"form-control\" value>\n</div>\n<div class=\"col-lg-6 col-md-12 col-sm-12 form-group\" data-for=\"full name\">\n<input type=\"text\" name=\"full name\" data-form-field=\"full name\" style=\"text-align:left\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" placeholder=\"*Full Name\" value>\n</div>\n<div data-for=\"email\" class=\"col-md-12 form-group mb-3 \">\n<input type=\"text\" name=\"email\" placeholder=\"Email\" style=\"text-align:left\" data-form-field=\"E-mail\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value>\n</div>\n<div data-for=\"message\" class=\"col-md-12 form-group mb-3 pb-2\">\n<textarea name=\"message\" placeholder=\"How can we help you?\" data-form-field=\"Message\" style=\"text-align:left\" mbr-theme-style=\"display-7\" class=\"form-control\"></textarea>\n</div>\n    <div class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<div class=\"form-control-label\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"checkbox\" class=\"mbr-fonts-style\">\n</label>\n</div>\n<div data-for=\"I agree to the terms and conditions and privacy policy\" class=\"form-check ms-2\">\n  <input type=\"checkbox\" value=\"Yes\" name=\"I agree to the terms and conditions and privacy policy\" data-form-field=\"I agree to the terms and conditions\" mbr-theme-style=\"display-7\" class=\"form-check-input\" required=\"required\">\n  <label mbr-text for=\"I agree to the terms and conditions and privacy policy\" mbr-theme-style=\"display-7\" class=\"form-check-label\">\n    I agree to the <a href=\"usingtheweb.html\" class=\"text-black\">Terms &amp; Conditions</a> &amp; <a href=\"privacy.html\" class=\"text-black\">Privacy Policy</a>\n  </label>\n</div>\n\n</div>\n<div class=\"col-md-12 input-group-btn align-center \" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"w-100 btn btn-form btn-primary\" data-app-placeholder=\"Type Text\">Submit</a></div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\t\t\t</div>\n\n\t\t\t<div class=\"col-sm-12 col-md-6 col-lg-5 col-xl-4 opening-hours pb-3 align-center\" mbr-if=\"showOpeningHours\">\n\t\t\t\t<div class=\"logo pb-3 align-center\" mbr-if=\"showLogo\">\n\t\t\t\t\t<a href=\"https://mobiri.se\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-327x327.png\" alt=\"Mobirise\" mbr-style=\"{'height': logoSize + 'rem'}\">\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n            <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\">\n                    <a class=\"nav-link link text-primary\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">FAQ</a>\n                </li></ul>\n        </div>\n\t\t</div>\n\t</div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "footer4-19",
          "_isUserblock": true,
          "_cid": "vqcVLCsuXG",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 scalem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"50\" max=\"400\" step=\"10\" value=\"150\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Lists\" name=\"showLists\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"list\" min=\"1\" max=\"5\" step=\"1\" value=\"4\" condition=\"showLists\">\n        <input type=\"color\" title=\"List Active Color\" value=\"#ffffff\" name=\"activeList\" condition=\"showLists\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Social Active Color\" value=\"#FF5753\" name=\"active\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#635d60\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#0c2c68\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#292325\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            \n            <!-- עמודת טקסט וכותרת ראשית -->\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showTitle || showText || showButtons || showLogo\">\n                <div class=\"content-wrapper\">\n                    <!-- תוספת המקום ללוגו -->\n                    <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"Logo\">\n                        </a>\n                    </div>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>\n                        ZUSAMMENLEBEN\n                    </b></h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                        Supporting integration, housing, and community connection for newcomers and locals in the area.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-phone mbr-iconfont mbr-iconfont-btn\"></span>\n                            Contact Us\n                        </a></div>\n                </div>\n            </div>\n\n            <!-- עמודות הקישורים -->\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLists\">\n                <div class=\"lists-wrapper\">\n                    <div class=\"list-wrap\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Home</a></li>\n                            <li class=\"item-wrap\"><a href=\"family-stories.html\" class=\"text-white\">Family Stories</a></li>\n                            <li class=\"item-wrap\"><a href=\"services.html\" class=\"text-white\">Services</a></li>\n                            <li class=\"item-wrap\"><a href=\"request-assistance.html\" class=\"text-white\">Request Assistance</a></li>\n                            <li class=\"item-wrap\"><a href=\"community.html\" class=\"text-white\">Community</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"living-in-germany.html\" class=\"text-white\">Living in Germany</a></li>\n                            <li class=\"item-wrap\"><a href=\"glossary.html\" class=\"text-white\">Glossary</a></li>\n                            <li class=\"item-wrap\"><a href=\"learning-german.html\" class=\"text-white\">Learning German</a></li>\n                            <li class=\"item-wrap\"><a href=\"refugee-rights.html\" class=\"text-white\">Refugee Rights</a></li>\n                            <li class=\"item-wrap\"><a href=\"anna-shishoili.html\" class=\"text-white\">Anna Shishoili</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 2\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"how-to-help.html\" class=\"text-white\">How Can You Help</a></li>\n                            <li class=\"item-wrap\"><a href=\"social-activity.html\" class=\"text-white\">Social Activity</a></li>\n                            <li class=\"item-wrap\"><a href=\"faq.html\" class=\"text-white\">FAQ</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Areas We Serve</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 3\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"emergency.html\" class=\"text-white\">Emergency</a></li>\n                            <li class=\"item-wrap\"><a href=\"Contact.html\" class=\"text-white\">Contact</a></li>\n                            <li class=\"item-wrap\"><a href=\"https://wa.me/380637004615\" class=\"text-white\" target=\"_blank\">WhatsApp Support</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Location</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 4\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Privacy Policy</a></li>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Terms of Use</a></li>\n                            <li class=\"item-wrap\"><a href=\"#\" class=\"text-white\">Impressum</a></li>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Official Site</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- אזור זכויות יוצרים ורשתות חברתיות -->\n            <div class=\"col-12\" mbr-if=\"showSocial || showCopy\">\n                <div class=\"copy-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                  