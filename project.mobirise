        {
          "_name": "agallery1",
          "_sourceTheme": "cookm5",
          "_styles": {
            ".anna-profile-section": {
              "padding": "80px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "'Inter', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.65",
              "direction": "ltr",
              "text-align": "left",
              "-webkit-font-smoothing": "antialiased"
            },
            ".anna-profile-section *": {
              "box-sizing": "border-box"
            },
            ".anna-container": {
              "max-width": "980px",
              "margin": "0 auto",
              "padding": "0 24px"
            },
            ".anna-hero-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "20px",
              "padding": "40px",
              "margin-bottom": "45px",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.03)"
            },
            ".anna-hero-grid": {
              "display": "flex",
              "gap": "40px",
              "align-items": "flex-start"
            },
            ".anna-avatar-col": {
              "flex-shrink": "0"
            },
            ".anna-profile-img": {
              "width": "200px",
              "height": "200px",
              "border-radius": "18px",
              "object-fit": "cover",
              "border": "1px solid #e2e8f0",
              "box-shadow": "0 8px 20px rgba(0, 0, 0, 0.06)",
              "transition": "transform 0.3s ease"
            },
            ".anna-profile-img:hover": {
              "transform": "scale(1.02)"
            },
            ".anna-bio-col": {
              "flex-grow": "1"
            },
            ".executive-badge": {
              "display": "inline-block",
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "1.5px",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 14px",
              "border-radius": "100px",
              "border": "1px solid #bfdbfe",
              "margin-bottom": "12px"
            },
            ".anna-name": {
              "font-size": "2.4rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.02em",
              "margin": "0 0 4px 0",
              "line-height": "1.2"
            },
            ".anna-role": {
              "font-size": "1.15rem",
              "font-weight": "700",
              "color": "#2563eb",
              "margin-bottom": "12px"
            },
            ".anna-tagline": {
              "font-size": "1.1rem",
              "font-weight": "500",
              "color": "#475569",
              "margin": "0 0 20px 0",
              "line-height": "1.5"
            },
            ".anna-description-box": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "border-radius": "14px",
              "padding": "20px 24px"
            },
            ".anna-description-box p": {
              "font-size": "0.95rem",
              "color": "#334155",
              "margin-bottom": "12px"
            },
            ".anna-description-box p:last-child": {
              "margin-bottom": "0"
            },
            ".anna-block": {
              "margin-bottom": "45px"
            },
            ".anna-section-title": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "24px",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "border-bottom": "2px solid #e2e8f0",
              "padding-bottom": "12px"
            },
            ".section-title-icon": {
              "color": "#2563eb",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#eff6ff",
              "width": "36px",
              "height": "36px",
              "border-radius": "8px",
              "border": "1px solid #dbeafe"
            },
            ".services-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(280px, 1fr))",
              "gap": "20px"
            },
            ".service-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "24px",
              "transition": "transform 0.25s ease, box-shadow 0.25s ease"
            },
            ".service-card:hover": {
              "transform": "translateY(-3px)",
              "box-shadow": "0 10px 25px rgba(0, 0, 0, 0.04)",
              "border-color": "#cbd5e1"
            },
            ".card-icon": {
              "width": "44px",
              "height": "44px",
              "border-radius": "10px",
              "background": "#eff6ff",
              "color": "#2563eb",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "margin-bottom": "16px",
              "border": "1px solid #dbeafe"
            },
            ".service-card h3": {
              "font-size": "1.1rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".service-card p": {
              "font-size": "0.9rem",
              "color": "#64748b",
              "margin": "0",
              "line-height": "1.5"
            },
            ".details-cards-stack": {
              "display": "flex",
              "flex-direction": "column",
              "gap": "20px"
            },
            ".detail-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "28px",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.02)"
            },
            ".detail-card.highlight-card": {
              "background": "linear-gradient(180deg, #ffffff 0%, #faf5ff 100%)",
              "border-color": "#e9d5ff"
            },
            ".card-title-group": {
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "margin-bottom": "14px"
            },
            ".card-title-group h3": {
              "font-size": "1.2rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0"
            },
            ".card-title-icon": {
              "width": "36px",
              "height": "36px",
              "border-radius": "8px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "flex-shrink": "0"
            },
            ".card-title-icon.blue": {
              "background": "#eff6ff",
              "color": "#2563eb",
              "border": "1px solid #dbeafe"
            },
            ".card-title-icon.green": {
              "background": "#f0fdf4",
              "color": "#16a34a",
              "border": "1px solid #bbf7d0"
            },
            ".card-title-icon.amber": {
              "background": "#fffbeb",
              "color": "#d97706",
              "border": "1px solid #fde68a"
            },
            ".card-title-icon.purple": {
              "background": "#faf5ff",
              "color": "#9333ea",
              "border": "1px solid #f3e8ff"
            },
            ".detail-card p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin-bottom": "12px"
            },
            ".detail-card p:last-child": {
              "margin-bottom": "0"
            },
            ".alert-box": {
              "border-radius": "12px",
              "padding": "16px 20px",
              "display": "flex",
              "gap": "14px",
              "align-items": "flex-start",
              "margin-top": "18px",
              "font-size": "0.9rem",
              "line-height": "1.5"
            },
            ".alert-box.red-alert": {
              "background": "#fef2f2",
              "border": "1px solid #fecaca",
              "color": "#991b1b"
            },
            ".alert-icon": {
              "color": "#dc2626",
              "flex-shrink": "0",
              "margin-top": "2px"
            },
            ".anna-cta-block": {
              "text-align": "center",
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "20px",
              "padding": "40px 24px",
              "box-shadow": "0 4px 20px rgba(0, 0, 0, 0.03)"
            },
            ".anna-cta-block h3": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "0 0 6px 0"
            },
            ".anna-cta-block p": {
              "font-size": "0.95rem",
              "color": "#64748b",
              "margin": "0 0 24px 0"
            },
            ".anna-profile-section .mbr-section-btn": {
              "display": "flex",
              "justify-content": "center",
              "gap": "14px",
              "flex-wrap": "wrap",
              "margin": "0"
            },
            ".anna-profile-section .btn.custom-btn": {
              "padding": "14px 28px !important",
              "border-radius": "100px !important",
              "font-weight": "700 !important",
              "font-size": "0.95rem !important",
              "display": "inline-flex !important",
              "align-items": "center !important",
              "justify-content": "center !important",
              "gap": "10px !important",
              "transition": "all 0.25s ease !important",
              "text-decoration": "none !important",
              "border-width": "1px !important"
            },
            ".anna-profile-section .btn.whatsapp-btn": {
              "background-color": "#25d366 !important",
              "border-color": "#25d366 !important",
              "color": "#ffffff !important",
              "box-shadow": "0 4px 12px rgba(37, 211, 102, 0.2) !important"
            },
            ".anna-profile-section .btn.whatsapp-btn:hover": {
              "background-color": "#20bd5a !important",
              "border-color": "#20bd5a !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 6px 18px rgba(37, 211, 102, 0.3) !important"
            },
            ".anna-profile-section .btn.email-btn": {
              "background-color": "#2563eb !important",
              "border-color": "#2563eb !important",
              "color": "#ffffff !important",
              "box-shadow": "0 4px 12px rgba(37, 99, 235, 0.2) !important"
            },
            ".anna-profile-section .btn.email-btn:hover": {
              "background-color": "#1d4ed8 !important",
              "border-color": "#1d4ed8 !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 6px 18px rgba(37, 99, 235, 0.3) !important"
            },
            "@media (max-width: 768px)": {
              ".anna-profile-section": {
                "padding": "50px 0 !important"
              },
              ".anna-container": {
                "padding": "0 16px"
              },
              ".anna-hero-card": {
                "padding": "24px 20px"
              },
              ".anna-hero-grid": {
                "flex-direction": "column",
                "align-items": "center",
                "text-align": "center",
                "gap": "20px"
              },
              ".anna-profile-img": {
                "width": "160px",
                "height": "160px"
              },
              ".anna-name": {
                "font-size": "1.9rem"
              },
              ".anna-description-box": {
                "text-align": "left",
                "padding": "16px"
              },
              ".detail-card": {
                "padding": "20px 16px"
              },
              ".anna-profile-section .mbr-section-btn": {
                "flex-direction": "column",
                "width": "100%"
              },
              ".anna-profile-section .btn.custom-btn": {
                "width": "100% !important"
              },
              ".alert-box": {
                "flex-direction": "column",
                "gap": "8px"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            },
            "@media (max-width: 575px)": {
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            "@media (max-width: 767px)": {
              ".services-grid, .team-grid, .transparency-grid, .pillars-grid, .three-column-grid, .grid-3, .grid-2, .faq-grid, .survival-grid, .portal-grid-2, .city-directory-grid, .details-cards-stack, .two-column-grid, .levels-grid, .cert-grid, .benefits-grid, .links-grid, .timeline-wrapper": {
                "display": "flex !important",
                "flex-wrap": "nowrap !important",
                "flex-direction": "row !important",
                "grid-template-columns": "none !important",
                "gap": "12px !important",
                "overflow-x": "auto",
                "overscroll-behavior-x": "contain",
                "scroll-snap-type": "x mandatory",
                "padding": "4px 2px 14px !important",
                "scrollbar-width": "none"
              },
              ".services-grid::-webkit-scrollbar, .team-grid::-webkit-scrollbar, .transparency-grid::-webkit-scrollbar, .pillars-grid::-webkit-scrollbar, .three-column-grid::-webkit-scrollbar, .grid-3::-webkit-scrollbar, .grid-2::-webkit-scrollbar, .faq-grid::-webkit-scrollbar, .survival-grid::-webkit-scrollbar, .portal-grid-2::-webkit-scrollbar, .city-directory-grid::-webkit-scrollbar, .details-cards-stack::-webkit-scrollbar, .two-column-grid::-webkit-scrollbar, .levels-grid::-webkit-scrollbar, .cert-grid::-webkit-scrollbar, .benefits-grid::-webkit-scrollbar, .links-grid::-webkit-scrollbar, .timeline-wrapper::-webkit-scrollbar": {
                "display": "none"
              },
              ".services-grid > *, .team-grid > *, .transparency-grid > *, .pillars-grid > *, .three-column-grid > *, .grid-3 > *, .grid-2 > *, .faq-grid > *, .survival-grid > *, .portal-grid-2 > *, .city-directory-grid > *, .details-cards-stack > *, .two-column-grid > *, .levels-grid > *, .cert-grid > *, .benefits-grid > *, .links-grid > *, .timeline-wrapper > *": {
                "flex": "0 0 84% !important",
                "max-width": "84% !important",
                "min-width": "0",
                "margin": "0 !important",
                "scroll-snap-align": "start"
              },
              ".timeline-wrapper::before": {
                "display": "none !important"
              },
              ".metrics-section, .services-section, .process-section, .region-section, .team-section, .transparency-section, .cta-section": {
                "padding-top": "44px !important",
                "padding-bottom": "44px !important"
              },
              ".metrics-grid": {
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr) !important",
                "gap": "10px !important"
              },
              ".word-grid": {
                "max-height": "62vh",
                "overflow-y": "auto",
                "overscroll-behavior": "contain",
                "padding-right": "4px"
              },
              ".metrics-grid > *": {
                "min-width": "0",
                "padding": "18px 10px !important"
              },
              ".metrics-grid .metric-value": {
                "font-size": "2rem !important"
              },
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"anna-profile-section\" id=\"anna-operations-profile\">\n    <div class=\"anna-container\">\n        \n        <!-- Hero Section: Profile & Lead -->\n        <div class=\"anna-hero-card\">\n            <div class=\"anna-hero-grid\">\n                <div class=\"anna-avatar-col\">\n                    <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2026-07-26-at-6.17.22-pm.jpeg-150x150.jpg\" width=\"150\" height=\"150\" alt=\"Anna Cheishvili\" class=\"anna-profile-img\">\n                </div>\n                \n                <div class=\"anna-bio-col\">\n                    <span class=\"executive-badge\">Volunteer Team</span>\n                    <h1 class=\"anna-name\">Anna Cheishvili</h1>\n                    <div class=\"anna-role\">Operations Manager</div>\n                    <h2 class=\"anna-tagline\">The personal address for families, on a fully voluntary basis.</h2>\n                    \n                    <div class=\"anna-description-box\">\n                        <p>When a family reaches out to us, Anna is the one who answers. She manages operations entirely voluntarily, knows the families by name, remembers who is waiting for an answer from which authority, and accompanies them from the first call until long after moving into the apartment.</p>\n                        <p>The difference between an anonymous assistance system and personal accompaniment is not just nice phrasing—it is the difference between re-explaining your story in every call, and writing a short message to someone who already knows exactly what stage you are at.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section: Services Grid -->\n        <div class=\"anna-block\">\n            <h2 class=\"anna-section-title\">\n                <span class=\"section-title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><polyline points=\"22 4 12 14.01 9 11.01\"></polyline></svg>\n                </span>\n                What the Accompaniment Includes\n            </h2>\n            \n            <div class=\"services-grid\">\n                <!-- Service 1 -->\n                <div class=\"service-card\">\n                    <div class=\"card-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path></svg>\n                    </div>\n                    <h3>Personal Response</h3>\n                    <p>In a language comfortable for the family, without intermediaries or case numbers.</p>\n                </div>\n\n                <!-- Service 2 -->\n                <div class=\"service-card\">\n                    <div class=\"card-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 21h18\"></path><path d=\"M3 10h18\"></path><path d=\"M5 6l7-3 7 3\"></path><path d=\"M4 10v11\"></path><path d=\"M20 10v11\"></path><path d=\"M8 14v3\"></path><path d=\"M12 14v3\"></path><path d=\"M16 14v3\"></path></svg>\n                    </div>\n                    <h3>Authority Coordination</h3>\n                    <p>Applying, checking status, and understanding requirements from local authorities.</p>\n                </div>\n\n                <!-- Service 3 -->\n                <div class=\"service-card\">\n                    <div class=\"card-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"></line></svg>\n                    </div>\n                    <h3>Document Explanation</h3>\n                    <p>Clear guidance on letters received by mail—deadlines, requirements, and next steps.</p>\n                </div>\n\n                <!-- Service 4 -->\n                <div class=\"service-card\">\n                    <div class=\"card-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect><path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path></svg>\n                    </div>\n                    <h3>Jobcenter Processes</h3>\n                    <p>Preparing for meetings, clarifying rules, and tracking official apartment approvals.</p>\n                </div>\n\n                <!-- Service 5 -->\n                <div class=\"service-card\">\n                    <div class=\"card-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\"></path><path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\"></path></svg>\n                    </div>\n                    <h3>Anmeldung Assistance</h3>\n                    <p>What documents to bring, booking appointments, and resolving missing paperwork.</p>\n                </div>\n\n                <!-- Service 6 -->\n                <div class=\"service-card\">\n                    <div class=\"card-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 10v6M2 10l10-5 10 5-10 5z\"></path><path d=\"M6 12v5c3 3 9 3 12 0v-5\"></path></svg>\n                    </div>\n                    <h3>Educational Frameworks</h3>\n                    <p>Registering children for schools and kindergartens, and coordinating with institutions.</p>\n                </div>\n\n                <!-- Service 7 -->\n                <div class=\"service-card\">\n                    <div class=\"card-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 8 6 6\"></path><path d=\"m4 14 6-6 2 3\"></path><path d=\"M2 5h12\"></path><path d=\"M7 2h1\"></path><path d=\"m22 22-5-10-5 10\"></path><path d=\"M14 18h6\"></path></svg>\n                    </div>\n                    <h3>Interpreters</h3>\n                    <p>Connecting to qualified interpreters for crucial official meetings and documentation.</p>\n                </div>\n\n                <!-- Service 8 -->\n                <div class=\"service-card\">\n                    <div class=\"card-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"16.5\" y1=\"9.4\" x2=\"7.5\" y2=\"4.21\"></line><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"></path><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"></polyline><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"></line></svg>\n                    </div>\n                    <h3>Moving Organization</h3>\n                    <p>Post-move setup—electricity and internet contracts, health insurance, and furniture.</p>\n                </div>\n\n                <!-- Service 9 -->\n                <div class=\"service-card\">\n                    <div class=\"card-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg>\n                    </div>\n                    <h3>Community Connection</h3>\n                    <p>Integrating into the local community and connecting with peer families who completed the process.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section: In-Depth Operational Principles -->\n        <div class=\"anna-block\">\n            <div class=\"details-cards-stack\">\n                \n                <!-- Card 1: WhatsApp & Emergency Notice -->\n                <div class=\"detail-card\">\n                    <div class=\"card-title-group\">\n                        <div class=\"card-title-icon blue\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"></path><path d=\"M9 18h6\"></path><path d=\"M10 22h4\"></path></svg>\n                        </div>\n                        <h3>How It Works in Practice</h3>\n                    </div>\n                    <p>Most communication takes place on WhatsApp for convenience. Letters from the Jobcenter can be photographed, sent, and explained back in plain language—clarifying what is requested and what action to take.</p>\n                    <p>Anna maintains high availability throughout the day, but please note this is not an official emergency hotline. During peak periods, responses may arrive later in the day.</p>\n                    \n                    <div class=\"alert-box red-alert\">\n                        <div class=\"alert-icon\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2\"></polygon><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line></svg>\n                        </div>\n                        <div>\n                            <strong>Immediate Emergency Protocol:</strong> In situations involving immediate danger, official German emergency services must be contacted immediately at <strong>112</strong> or <strong>110</strong>. Do not wait for a response from our team.\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Card 2: Long-Term Support -->\n                <div class=\"detail-card\">\n                    <div class=\"card-title-group\">\n                        <div class=\"card-title-icon green\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg>\n                        </div>\n                        <h3>Accompaniment Beyond the Move</h3>\n                    </div>\n                    <p>The initial months after moving into an apartment are often the most complex. Once settled, families face electricity and gas registrations, health insurance inquiries, and official mail at their new address.</p>\n                    <p>Anna continues to support families months into their residency. Even independent families write occasionally with questions, maintaining an open door whenever guidance is needed.</p>\n                </div>\n\n                <!-- Card 3: Empowerment Approach -->\n                <div class=\"detail-card\">\n                    <div class=\"card-title-group\">\n                        <div class=\"card-title-icon amber\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path></svg>\n                        </div>\n                        <h3>Our Approach: Restoring Autonomy</h3>\n                    </div>\n                    <p>We do not make decisions for families. Anna presents options, explains consequences, and offers recommendations—but full decision-making authority remains with the family.</p>\n                    <p>Families recovering from war and relocation have experienced significant loss of control. Our mission is to restore autonomy, not impose additional external control.</p>\n                </div>\n\n                <!-- Card 4: Free of Charge -->\n                <div class=\"detail-card highlight-card\">\n                    <div class=\"card-title-group\">\n                        <div class=\"card-title-icon purple\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"></path></svg>\n                        </div>\n                        <h3>100% Free of Charge</h3>\n                    </div>\n                    <p>All accompaniment services managed by Anna are provided entirely on a voluntary basis and completely free of charge. There are no consultation, handling, or agency fees at any stage.</p>\n                    <p>Direct payments for utilities, internet providers, or property leases are settled directly with the respective entities and never pass through us.</p>\n                </div>\n\n            </div>\n        </div>\n\n        <!-- CTA Section -->\n        <div class=\"anna-cta-block\">\n            <h3>Contact Anna Directly</h3>\n            <p>You can reach out in Ukrainian, Russian, or German.</p>\n            \n            <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn custom-btn whatsapp-btn btn-warning\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                    WhatsApp Anna\n                </a>\n                <a class=\"btn btn-primary custom-btn email-btn\" href=\"Contact.html#footer4-19\" data-app-placeholder=\"Type Text\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"></path><polyline points=\"22,6 12,13 2,6\"></polyline></svg>\n                    Send an Email\n                </a></div>\n        </div>\n\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "agallery1-1t",
          "_isUserblock": true,
          "_cid": "vqdrgcKToO",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
