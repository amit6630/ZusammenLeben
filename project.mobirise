              "margin": "20px 0",
              "border": "0",
              "border-top": "1px solid #e2e8f0"
            },
            ".highlight-green-title": {
              "color": "#16a34a !important"
            },
            ".emergency-card": {
              "background": "#fef2f2 !important",
              "border": "1px solid #fecaca !important"
            },
            ".emergency-header": {
              "display": "flex",
              "align-items": "center",
              "gap": "10px",
              "color": "#dc2626",
              "margin-bottom": "10px"
            },
            ".emergency-title": {
              "color": "#dc2626 !important",
              "font-size": "1.2rem",
              "font-weight": "800",
              "margin": "0"
            },
            ".emergency-subtitle": {
              "color": "#991b1b !important",
              "font-weight": "700",
              "margin-bottom": "10px"
            },
            ".emergency-desc": {
