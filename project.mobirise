    "guide-child-benefit.html": {
      "settings": {
        "title": "Child Benefit and Family Payments for Ukrainians",
        "order": "31",
        "meta_descr": "Kindergeld, child supplement, parental allowance and school support: which family payments Ukrainian families in Germany can receive and how to apply.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-child-benefit.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-child-benefit.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-child-benefit.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-child-benefit.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-child-benefit.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Child Benefit and Family Payments for Ukrainians\" />\n<meta property=\"og:description\" content=\"Kindergeld, child supplement, parental allowance and school support: which family payments Ukrainian families in Germany can receive and how to apply.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-child-benefit.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Child Benefit and Family Payments in Germany\",\"description\":\"Kindergeld, child supplement, parental allowance and school support: which family payments Ukrainian families in Germany can receive and how to apply.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/guide-child-benefit.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-child-benefit.html\",\"wordCount\":1081,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can Ukrainians with §24 receive child benefit?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Parents with a residence permit under §24 can receive child benefit. Apply to the family benefits office.\"}},{\"@type\":\"Question\",\"name\":\"Does child benefit reduce Jobcenter benefits?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. It counts as the child's income, but you still have to apply for it.\"}},{\"@type\":\"Question\",\"name\":\"How far back is child benefit paid?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Usually for up to six months before the month of application. Apply early.\"}},{\"@type\":\"Question\",\"name\":\"What is the child supplement?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"An extra payment for working parents whose income is not enough for their children. It also opens access to school support.\"}},{\"@type\":\"Question\",\"name\":\"Who pays parental allowance in Bavaria?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The Bavarian Centre for Family and Social Affairs (ZBFS). Ask early, ideally during pregnancy.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Child Benefit and Family Payments in Germany\",\"item\":\"https://zusammenleben-ukraine.de/guide-child-benefit.html\"}]}]}</script>"
      },
