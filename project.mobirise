    "guide-school-kita-bavaria.html": {
      "settings": {
        "title": "School and Kita Registration for Ukrainian Children in Bavaria",
        "order": "19",
        "meta_descr": "How to register a child from Ukraine for school or kindergarten in Bavaria: compulsory schooling, German classes, documents and realistic waiting times.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-school-kita-bavaria.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-school-kita-bavaria.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-school-kita-bavaria.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-school-kita-bavaria.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-school-kita-bavaria.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"School and Kita Registration for Ukrainian Children in Bavaria\" />\n<meta property=\"og:description\" content=\"How to register a child from Ukraine for school or kindergarten in Bavaria: compulsory schooling, German classes, documents and realistic waiting times.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-school-kita-bavaria.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Registering Your Child for School or Kita in Bavaria\",\"description\":\"How to register a child from Ukraine for school or kindergarten in Bavaria: compulsory schooling, German classes, documents and realistic waiting times.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/guide-school-kita-bavaria.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-school-kita-bavaria.html\",\"wordCount\":1034,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Does my child have to go to school in Bavaria?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. School is compulsory for school-age children who live in Bavaria, including children from Ukraine.\"}},{\"@type\":\"Question\",\"name\":\"Is there a right to a Kita place?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, from the age of one. Because places are limited, register early with several Kitas.\"}},{\"@type\":\"Question\",\"name\":\"Is measles vaccination required?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Proof of measles protection is required for school and Kita in Germany.\"}},{\"@type\":\"Question\",\"name\":\"Can my child continue Ukrainian online school?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, in addition. It does not replace attending a German school, which is compulsory.\"}},{\"@type\":\"Question\",\"name\":\"Who pays for school trips and lunch?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Families with low income can apply for the education and participation package, which covers trips, lunch and school supplies.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Registering Your Child for School or Kita in Bavaria\",\"item\":\"https://zusammenleben-ukraine.de/guide-school-kita-bavaria.html\"}]}]}</script>"
      },
