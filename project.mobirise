    "Contact.html": {
      "settings": {
        "title": "Contact ZusammenLeben | ZusammenLeben",
        "order": "15",
        "meta_descr": "Contact ZusammenLeben in Konradsreuth, Upper Franconia, by WhatsApp, phone, email or contact form. We reply in Ukrainian, Russian, German and English.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/Contact.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/Contact.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/Contact.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/Contact.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/Contact.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Contact ZusammenLeben | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"Contact ZusammenLeben in Konradsreuth, Upper Franconia, by WhatsApp, phone, email or contact form. We reply in Ukrainian, Russian, German and English.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/Contact.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"url\":\"https://zusammenleben-ukraine.de/Contact.html\",\"name\":\"Contact ZusammenLeben\",\"description\":\"Contact ZusammenLeben in Konradsreuth, Upper Franconia, by WhatsApp, phone, email or contact form. We reply in Ukrainian, Russian, German and English.\",\"inLanguage\":\"en\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"},\"about\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Contact ZusammenLeben\",\"item\":\"https://zusammenleben-ukraine.de/Contact.html\"}]},{\"@type\":\"NGO\",\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"name\":\"ZusammenLeben\",\"alternateName\":\"Zusammen Leben\",\"url\":\"https://zusammenleben-ukraine.de/\",\"logo\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\",\"email\":\"zusammenleben.de@gmail.com\",\"telephone\":\"+380637004615\",\"description\":\"Free volunteer support for Ukrainian families in Northern Bavaria: housing, Jobcenter, Anmeldung, school places and translation in Hof, Selb, Helmbrechts.\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Alte Hofer Str. 1\",\"postalCode\":\"95176\",\"addressLocality\":\"Konradsreuth\",\"addressRegion\":\"Bayern\",\"addressCountry\":\"DE\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Hof\"},{\"@type\":\"Place\",\"name\":\"Helmbrechts\"},{\"@type\":\"Place\",\"name\":\"Münchberg\"},{\"@type\":\"Place\",\"name\":\"Selb\"},{\"@type\":\"Place\",\"name\":\"Wunsiedel\"},{\"@type\":\"Place\",\"name\":\"Arzberg\"},{\"@type\":\"Place\",\"name\":\"Marktredwitz\"},{\"@type\":\"Place\",\"name\":\"Naila\"},{\"@type\":\"Place\",\"name\":\"Kulmbach\"},{\"@type\":\"Place\",\"name\":\"Bad Steben\"},{\"@type\":\"Place\",\"name\":\"Oberfranken\"}],\"knowsLanguage\":[\"uk\",\"ru\",\"de\",\"en\"],\"founder\":{\"@type\":\"Person\",\"name\":\"Ben Shamir\"},\"member\":{\"@type\":\"Person\",\"name\":\"Anna Cheishvili\",\"jobTitle\":\"Operations Manager\"},\"foundingDate\":\"2022\"}]}</script>"
      },
