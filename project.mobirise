                  "margin-left": "auto"
                },
                "min-width": "0"
              },
              ".desktop-only-flex": {
                "display": "flex !important",
                "justify-content": "flex-end",
                "align-items": "center",
                "gap": "3px",
                "flex-wrap": "nowrap",
                "margin-left": "auto",
                "padding-right": "20px"
              },
              ".mobile-only": {
                "display": "none !important"
              },
              ".navbar-nav": {
                "flex-wrap": "wrap !important",
                "row-gap": "2px"
              },
              ".navbar-buttons .btn": {
                "padding": ".6rem 1.2rem !important",
