    "guide-winter-heating.html": {
      "settings": {
        "title": "Winter in Germany: Heating, Mould and Energy Bills",
        "order": "48",
        "meta_descr": "How to heat and ventilate correctly, avoid mould, read the energy bill, save on electricity, get help with high costs and stay safe in snow and ice.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-winter-heating.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-winter-heating.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-winter-heating.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-winter-heating.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-winter-heating.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Winter in Germany: Heating, Mould and Energy Bills\" />\n<meta property=\"og:description\" content=\"How to heat and ventilate correctly, avoid mould, read the energy bill, save on electricity, get help with high costs and stay safe in snow and ice.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-winter-heating.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Getting Through the German Winter\",\"description\":\"How to heat and ventilate correctly, avoid mould, read the energy bill, save on electricity, get help with high costs and stay safe in snow and ice.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/guide-winter-heating.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-winter-heating.html\",\"wordCount\":1036,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What does level 3 on the radiator mean?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"About 20 °C. The numbers are target temperatures, not power levels; level 5 does not heat faster.\"}},{\"@type\":\"Question\",\"name\":\"How should I ventilate in winter?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Open windows wide for five to ten minutes, two to four times a day, instead of tilting them for hours.\"}},{\"@type\":\"Question\",\"name\":\"Who pays for mould removal?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The landlord, if building defects cause it. Report mould in writing with photos.\"}},{\"@type\":\"Question\",\"name\":\"Does the Jobcenter pay heating costs?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, reasonable heating costs are paid in addition to rent, including back payments. Electricity is part of the standard benefit.\"}},{\"@type\":\"Question\",\"name\":\"Do I have to clear snow?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Often yes, in rotation with other tenants. Check your tenancy agreement or house rules.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Getting Through the German Winter\",\"item\":\"https://zusammenleben-ukraine.de/guide-winter-heating.html\"}]}]}</script>"
      },
