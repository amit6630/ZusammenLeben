              },
              ".towns-scroll-list": {
                "max-height": "350px"
              }
            },
            "@media (max-width: 640px)": {
              ".regional-executive-section": {
                "padding": "40px 0 !important"
              },
              ".executive-container": {
                "padding": "0 16px"
              },
              ".executive-header": {
                "margin-bottom": "32px"
              },
              ".header-title": {
                "font-size": "1.8rem"
              },
              ".header-lead": {
                "font-size": "1rem"
              },
              ".section-block": {
                "margin-bottom": "40px"
              },
              ".block-title": {
                "font-size": "1.25rem"
              },
              ".philosophy-card": {
                "padding": "20px 16px 20px 22px",
                "margin-bottom": "40px"
              },
              ".philosophy-card h2": {
