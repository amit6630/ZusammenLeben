            },
            ".zl-faq h2": {
              "margin-bottom": "12px"
            },
            ".zl-faq details": {
              "border": "1px solid #e2e8f0",
              "border-radius": "12px",
              "background": "#fff",
              "margin-bottom": "10px"
            },
            ".zl-faq summary": {
              "cursor": "pointer",
              "padding": "14px 18px",
              "font-weight": "700",
              "font-size": "17px",
              "list-style-position": "inside"
            },
