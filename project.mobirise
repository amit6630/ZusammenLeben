            },
            ".cta-box": {
              "text-align": "center",
              "margin-top": "30px",
              "padding": "40px 32px",
              "background": "linear-gradient(180deg, #ffffff 0%, #f8fafc 100%)"
            },
            ".cta-box h3": {
              "font-size": "1.5rem",
              "margin-bottom": "14px"
            },
            ".cta-description": {
              "max-width": "700px",
              "margin": "0 auto 16px",
              "color": "#475569",
              "font-size": "1rem"
            },
            ".cta-statement": {
              "font-weight": "700",
              "color": "#0f172a",
              "margin-bottom": "28px",
              "font-size": "1.05rem"
            },
            ".guide-executive-section .mbr-section-btn": {
              "display": "flex",
              "gap": "12px",
              "flex-wrap": "wrap",
              "margin": "0",
