    "guide-pregnancy-birth.html": {
      "settings": {
        "title": "Pregnancy and Birth in Germany: A Guide for Ukrainians",
        "order": "32",
        "meta_descr": "Check-ups, midwife, maternity protection, hospital birth, birth certificate and benefits: pregnancy and birth in Germany for Ukrainian families.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-pregnancy-birth.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-pregnancy-birth.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-pregnancy-birth.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-pregnancy-birth.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-pregnancy-birth.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Pregnancy and Birth in Germany: A Guide for Ukrainians\" />\n<meta property=\"og:description\" content=\"Check-ups, midwife, maternity protection, hospital birth, birth certificate and benefits: pregnancy and birth in Germany for Ukrainian families.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-pregnancy-birth.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Pregnancy and Birth in Germany\",\"description\":\"Check-ups, midwife, maternity protection, hospital birth, birth certificate and benefits: pregnancy and birth in Germany for Ukrainian families.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/guide-pregnancy-birth.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-pregnancy-birth.html\",\"wordCount\":1073,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is pregnancy care free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. All recommended check-ups, the midwife, the birth and the hospital stay are covered by statutory health insurance.\"}},{\"@type\":\"Question\",\"name\":\"When should I look for a midwife?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"As early as possible, ideally in the first months of pregnancy, because midwives are in high demand.\"}},{\"@type\":\"Question\",\"name\":\"Where do I register the birth?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"At the registry office (Standesamt) of the town where the baby was born, within one week.\"}},{\"@type\":\"Question\",\"name\":\"Can I get help with baby equipment?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Jobcenter initial equipment and the federal foundation \\\"Mother and Child\\\" through a counselling centre.\"}},{\"@type\":\"Question\",\"name\":\"How long is maternity leave?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Six weeks before the due date and eight weeks after the birth, twelve after premature or multiple births.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Pregnancy and Birth in Germany\",\"item\":\"https://zusammenleben-ukraine.de/guide-pregnancy-birth.html\"}]}]}</script>"
      },
