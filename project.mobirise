              "color": "#dbeafe"
            },
            ".zl-btns": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "10px"
            },
            ".zl-btn": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-height": "46px",
              "padding": "10px 20px",
              "border-radius": "999px",
              "font-weight": "700",
              "text-decoration": "none !important"
            },
            ".zl-btn--wa": {
              "background": "#0f7a3e",
              "color": "#fff !important"
            },
            ".zl-btn--light": {
              "background": "#fff",
              "color": "#0c2c68 !important"
            },
            ".zl-btn--ghost": {
              "border": "2px solid #0c2c68",
              "color": "#0c2c68 !important",
              "background": "transparent"
            },
            ".zl-related": {
              "margin-top": "36px"
            },
            ".zl-related h2": {
              "font-size": "22px",
              "margin": "0 0 12px",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fill, minmax(250px, 1fr))",
              "gap": "16px"
            },
            ".zl-tile": {
              "display": "flex",
              "flex-direction": "column",
              "gap": "8px",
              "padding": "20px",
              "background": "#fff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "color": "#1e293b !important",
              "text-decoration": "none !important",
              "transition": "transform .2s, box-shadow .2s, border-color .2s"
            },
            ".zl-tile:hover": {
              "transform": "translateY(-3px)",
              "border-color": "#93c5fd",
              "box-shadow": "0 14px 30px -20px rgba(29, 78, 216, .45)"
            },
            ".zl-tile h2, .zl-tile h3": {
              "font-size": "18px",
              "line-height": "1.3",
              "margin": "0",
              "color": "#0f172a",
              "font-weight": "750"
            },
