        {
          "_name": "agallery1",
          "_sourceTheme": "cookm5",
          "_styles": {
            ".anna-profile-section": {
              "padding": "80px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "'Inter', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.65",
              "direction": "ltr",
              "text-align": "left",
              "-webkit-font-smoothing": "antialiased"
            },
            ".anna-profile-section *": {
              "box-sizing": "border-box"
            },
            ".anna-container": {
              "max-width": "980px",
              "margin": "0 auto",
              "padding": "0 24px"
            },
            ".anna-hero-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "20px",
              "padding": "40px",
              "margin-bottom": "45px",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.03)"
            },
            ".anna-hero-grid": {
              "display": "flex",
              "gap": "40px",
              "align-items": "flex-start"
            },
            ".anna-avatar-col": {
              "flex-shrink": "0"
            },
            ".anna-profile-img": {
              "width": "200px",
              "height": "200px",
              "border-radius": "18px",
              "object-fit": "cover",
              "border": "1px solid #e2e8f0",
              "box-shadow": "0 8px 20px rgba(0, 0, 0, 0.06)",
              "transition": "transform 0.3s ease"
            },
            ".anna-profile-img:hover": {
              "transform": "scale(1.02)"
            },
            ".anna-bio-col": {
              "flex-grow": "1"
            },
            ".executive-badge": {
              "display": "inline-block",
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "1.5px",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 14px",
              "border-radius": "100px",
              "border": "1px solid #bfdbfe",
              "margin-bottom": "12px"
            },
            ".anna-name": {
              "font-size": "2.4rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.02em",
              "margin": "0 0 4px 0",
              "line-height": "1.2"
            },
            ".anna-role": {
              "font-size": "1.15rem",
              "font-weight": "700",
              "color": "#2563eb",
              "margin-bottom": "12px"
            },
            ".anna-tagline": {
              "font-size": "1.1rem",
              "font-weight": "500",
              "color": "#475569",
              "margin": "0 0 20px 0",
              "line-height": "1.5"
            },
            ".anna-description-box": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "border-radius": "14px",
              "padding": "20px 24px"
            },
            ".anna-description-box p": {
              "font-size": "0.95rem",
              "color": "#334155",
              "margin-bottom": "12px"
            },
            ".anna-description-box p:last-child": {
              "margin-bottom": "0"
            },
            ".anna-block": {
              "margin-bottom": "45px"
            },
            ".anna-section-title": {
              "font-size": "1.4rem",
              "font-weight": "800",
