              "border-color": "#93c5fd",
              "box-shadow": "0 14px 30px -20px rgba(29, 78, 216, .45)"
            },
            ".zl-tile h2, .zl-tile h3": {
              "font-size": "18px",
              "line-height": "1.3",
              "margin": "0",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-tile p": {
              "margin": "0",
              "font-size": "15px",
              "color": "#475569"
            },
            ".zl-tile .zl-more": {
              "margin-top": "auto",
              "font-weight": "700",
              "color": "#1d4ed8",
              "font-size": "15px"
            },
            ".zl-ico": {
              "width": "42px",
              "height": "42px",
              "border-radius": "12px",
              "display": "grid",
              "place-items": "center",
              "background": "#e0e7ff",
              "color": "#0c2c68"
            },
            ".zl-ico svg": {
              "width": "22px",
              "height": "22px"
            },
            ".zl-hub-head": {
