    "guide-anmeldung.html": {
      "settings": {
        "title": "Anmeldung: Registering Your Address in Germany",
        "order": "30",
        "meta_descr": "How to register your address (Anmeldung) in Upper Franconia: deadline, documents, the landlord confirmation, and why almost every other step depends on it.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-anmeldung.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-anmeldung.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-anmeldung.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-anmeldung.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-anmeldung.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Anmeldung: Registering Your Address in Germany\" />\n<meta property=\"og:description\" content=\"How to register your address (Anmeldung) in Upper Franconia: deadline, documents, the landlord confirmation, and why almost every other step depends on it.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-anmeldung.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Anmeldung: Registering Your Address in Germany\",\"description\":\"How to register your address (Anmeldung) in Upper Franconia: deadline, documents, the landlord confirmation, and why almost every other step depends on it.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/guide-anmeldung.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-anmeldung.html\",\"wordCount\":1109,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How long do I have to register?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Within two weeks after moving into a home, at the citizens' office of your town.\"}},{\"@type\":\"Question\",\"name\":\"Can one person register the whole family?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Often yes, with a power of attorney and the documents of the others. Ask your citizens' office.\"}},{\"@type\":\"Question\",\"name\":\"What if the landlord refuses the confirmation?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The landlord is legally obliged to provide it. Ask in writing, and contact the citizens' office if it is still refused.\"}},{\"@type\":\"Question\",\"name\":\"Does registration cost money?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The registration and the first certificate are free.\"}},{\"@type\":\"Question\",\"name\":\"When does the tax ID arrive?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Usually a few weeks after registration, automatically by post.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Anmeldung: Registering Your Address in Germany\",\"item\":\"https://zusammenleben-ukraine.de/guide-anmeldung.html\"}]}]}</script>"
      },
