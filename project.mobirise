              "background": "#f1f5f9",
              "border-radius": "12px",
              "letter-spacing": "0.5px"
            },
            ".role-pill.manager": {
              "color": "#2563eb",
              "background": "#eff6ff"
            },
            ".team-info p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.5"
            },
            ".transparency-section": {
              "padding": "100px 0",
              "background": "#ffffff"
            },
            ".transparency-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "30px",
              "max-width": "950px",
              "margin": "0 auto"
            },
            ".matrix-card": {
              "background": "#ffffff",
              "border-radius": "24px",
              "padding": "40px",
              "border": "1px solid #e2e8f0",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.04)"
            },
            ".free-card": {
