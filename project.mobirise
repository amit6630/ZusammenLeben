    "guide-integration-course.html": {
      "settings": {
        "title": "Integration Course in Germany: How Ukrainians Can Join",
        "order": "22",
        "meta_descr": "What the German integration course includes, how people from Ukraine get a place, what it costs and how the final B1 exam works. A practical guide.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-integration-course.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-integration-course.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-integration-course.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-integration-course.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-integration-course.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Integration Course in Germany: How Ukrainians Can Join\" />\n<meta property=\"og:description\" content=\"What the German integration course includes, how people from Ukraine get a place, what it costs and how the final B1 exam works. A practical guide.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-integration-course.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"The Integration Course: Your Fastest Route to German\",\"description\":\"What the German integration course includes, how people from Ukraine get a place, what it costs and how the final B1 exam works. A practical guide.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/guide-integration-course.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-integration-course.html\",\"wordCount\":1081,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is the integration course free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"For people who receive Jobcenter benefits it is free. Others pay a reduced contribution or apply for an exemption at BAMF.\"}},{\"@type\":\"Question\",\"name\":\"What level do I reach?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The course aims at level B1. The final exam shows whether you reached A2 or B1.\"}},{\"@type\":\"Question\",\"name\":\"Can I attend if I have small children?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. There are parent courses with childcare. Ask the course provider.\"}},{\"@type\":\"Question\",\"name\":\"Can I work and attend the course?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Many providers offer evening, part-time or online formats that can be combined with a job.\"}},{\"@type\":\"Question\",\"name\":\"What comes after B1?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Job-related German courses up to B2 or C1, also funded by BAMF. Ask the Jobcenter or employment agency for admission.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"The Integration Course: Your Fastest Route to German\",\"item\":\"https://zusammenleben-ukraine.de/guide-integration-course.html\"}]}]}</script>"
      },
