        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/request-assistance.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/request-assistance.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/request-assistance.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/request-assistance.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/request-assistance.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Request Assistance: How to Reach Us | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"Ask ZusammenLeben for help by WhatsApp, email or form in Ukrainian, Russian, German or English. What to include so we can answer quickly.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/request-assistance.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"url\":\"https://zusammenleben-ukraine.de/request-assistance.html\",\"name\":\"Request Assistance: How to Reach Us\",\"description\":\"Ask ZusammenLeben for help by WhatsApp, email or form in Ukrainian, Russian, German or English. What to include so we can answer quickly.\",\"inLanguage\":\"en\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"},\"about\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Request Assistance: How to Reach Us\",\"item\":\"https://zusammenleben-ukraine.de/request-assistance.html\"}]}]}</script>",
        "meta_descr": "Ask ZusammenLeben for help by WhatsApp, email or form in Ukrainian, Russian, German or English. What to include so we can answer quickly."
