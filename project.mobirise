    "guide-ukrainian-documents.html": {
      "settings": {
        "title": "Ukrainian Documents in Germany: Passport, Apostille",
        "order": "47",
        "meta_descr": "Renewing a Ukrainian passport abroad, consular registration, a child born in Germany, apostille, sworn translations and lost documents: a practical guide.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-ukrainian-documents.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-ukrainian-documents.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-ukrainian-documents.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-ukrainian-documents.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-ukrainian-documents.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Ukrainian Documents in Germany: Passport, Apostille\" />\n<meta property=\"og:description\" content=\"Renewing a Ukrainian passport abroad, consular registration, a child born in Germany, apostille, sworn translations and lost documents: a practical guide.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-ukrainian-documents.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Keeping Your Ukrainian Documents Valid in Germany\",\"description\":\"Renewing a Ukrainian passport abroad, consular registration, a child born in Germany, apostille, sworn translations and lost documents: a practical guide.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/guide-ukrainian-documents.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-ukrainian-documents.html\",\"wordCount\":1070,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Where can I renew my Ukrainian passport in Bavaria?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"At the Ukrainian Consulate General in Munich or a passport service centre abroad, usually with an online appointment.\"}},{\"@type\":\"Question\",\"name\":\"Do I need an apostille for Ukrainian certificates?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Often yes. German registry offices usually ask for an apostille and a sworn translation; ask the office first.\"}},{\"@type\":\"Question\",\"name\":\"Are translations made in Ukraine accepted?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Often not. German offices usually need a translator sworn in Germany.\"}},{\"@type\":\"Question\",\"name\":\"Is Diia accepted as ID in Germany?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Diia documents are not accepted as identity documents by German authorities.\"}},{\"@type\":\"Question\",\"name\":\"What do I do if my passport is stolen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Report it to the police, inform the immigration office and apply for a new passport at the consulate.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Keeping Your Ukrainian Documents Valid in Germany\",\"item\":\"https://zusammenleben-ukraine.de/guide-ukrainian-documents.html\"}]}]}</script>"
      },
