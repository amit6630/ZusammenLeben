    "guide-public-transport.html": {
      "settings": {
        "title": "Public Transport in Upper Franconia: Bus, Train, Tickets",
        "order": "40",
        "meta_descr": "Deutschland-Ticket, regional trains, buses and on-demand services in rural Upper Franconia, school transport, fares, fines and long-distance travel explained.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-public-transport.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-public-transport.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-public-transport.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-public-transport.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-public-transport.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Public Transport in Upper Franconia: Bus, Train, Tickets\" />\n<meta property=\"og:description\" content=\"Deutschland-Ticket, regional trains, buses and on-demand services in rural Upper Franconia, school transport, fares, fines and long-distance travel explained.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-public-transport.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Getting Around: Public Transport in Upper Franconia\",\"description\":\"Deutschland-Ticket, regional trains, buses and on-demand services in rural Upper Franconia, school transport, fares, fines and long-distance travel explained.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/guide-public-transport.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-public-transport.html\",\"wordCount\":1051,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What does the Deutschland-Ticket cover?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"All local and regional public transport in Germany, but not long-distance trains like ICE or IC.\"}},{\"@type\":\"Question\",\"name\":\"Can I buy a ticket on the train?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"On many regional trains in Bavaria no. Buy it before boarding, in the app or at the machine.\"}},{\"@type\":\"Question\",\"name\":\"What if there is no bus in the evening?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Check for call buses or shared call taxis, which run on request if you book in advance.\"}},{\"@type\":\"Question\",\"name\":\"Is school transport free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"In Bavaria often yes, if the distance exceeds a limit. Ask the school office.\"}},{\"@type\":\"Question\",\"name\":\"What happens without a valid ticket?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"You pay an increased fare of several dozen euros, and repeated fare dodging can be prosecuted.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Getting Around: Public Transport in Upper Franconia\",\"item\":\"https://zusammenleben-ukraine.de/guide-public-transport.html\"}]}]}</script>"
      },
