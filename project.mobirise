            },
            ".zl-rail .zl-tile p": {
              "display": "-webkit-box",
              "-webkit-line-clamp": "3",
              "-webkit-box-orient": "vertical",
              "overflow": "hidden"
            },
            ".zl-comm-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(230px, 1fr))",
              "gap": "16px",
              "margin": "6px 0 0"
            },
            ".zl-comm-grid .zl-tile:hover": {
              "transform": "none",
