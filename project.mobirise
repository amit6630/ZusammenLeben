    "guide-elderly-care.html": {
      "settings": {
        "title": "Older People and Care in Germany: Support for Families",
        "order": "43",
        "meta_descr": "Income support in old age, care levels, home care, day care, care homes and power of attorney: a guide for older Ukrainians and their families.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-elderly-care.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-elderly-care.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-elderly-care.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-elderly-care.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-elderly-care.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Older People and Care in Germany: Support for Families\" />\n<meta property=\"og:description\" content=\"Income support in old age, care levels, home care, day care, care homes and power of attorney: a guide for older Ukrainians and their families.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-elderly-care.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Older People and Long-Term Care in Germany\",\"description\":\"Income support in old age, care levels, home care, day care, care homes and power of attorney: a guide for older Ukrainians and their families.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/guide-elderly-care.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-elderly-care.html\",\"wordCount\":1073,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Who pays income support for pensioners?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The social welfare office of the district pays basic income support in old age, not the Jobcenter.\"}},{\"@type\":\"Question\",\"name\":\"How do I apply for a care level?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"At the care fund of your health insurance. An assessor visits at home and decides the care level.\"}},{\"@type\":\"Question\",\"name\":\"Can relatives be paid for caring?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The person in need receives a care allowance, which can be passed on to the caring relatives.\"}},{\"@type\":\"Question\",\"name\":\"What is a power of attorney?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A document allowing a trusted person to decide and act for someone who can no longer do so.\"}},{\"@type\":\"Question\",\"name\":\"Who pays for a care home?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Care insurance pays a share; the rest is paid by the resident or, if needed, by the social welfare office.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Older People and Long-Term Care in Germany\",\"item\":\"https://zusammenleben-ukraine.de/guide-elderly-care.html\"}]}]}</script>"
      },
