              "color": "#1e3a8a",
              "margin": "0",
              "font-size": "0.93rem",
              "line-height": "1.6"
            },
            ".three-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(260px, 1fr))",
              "gap": "20px"
            },
            ".guide-mini-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "24px",
              "transition": "transform 0.25s ease"
            },
            ".guide-mini-card:hover": {
              "transform": "translateY(-3px)"
            },
            ".step-badge": {
              "width": "36px",
              "height": "36px",
              "border-radius": "50%",
              "background": "#eff6ff",
              "color": "#2563eb",
              "font-weight": "800",
              "font-size": "1.05rem",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "margin-bottom": "14px",
              "border": "1px solid #bfdbfe"
            },
            ".guide-mini-card h3": {
              "font-size": "1.05rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".guide-mini-card p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.55"
            },
            ".card-divider": {
              "margin": "20px 0",
              "border": "0",
              "border-top": "1px solid #e2e8f0"
            },
            ".highlight-green-title": {
              "color": "#16a34a !important"
            },
            ".emergency-card": {
              "background": "#fef2f2 !important",
              "border": "1px solid #fecaca !important"
            },
            ".emergency-header": {
              "display": "flex",
              "align-items": "center",
              "gap": "10px",
              "color": "#dc2626",
              "margin-bottom": "10px"
            },
            ".emergency-title": {
              "color": "#dc2626 !important",
              "font-size": "1.2rem",
              "font-weight": "800",
              "margin": "0"
            },
            ".emergency-subtitle": {
              "color": "#991b1b !important",
              "font-weight": "700",
              "margin-bottom": "10px"
            },
            ".emergency-desc": {
              "color": "#7f1d1d !important",
              "font-size": "0.92rem"
            },
            ".emergency-list": {
              "margin-top": "16px"
            },
            ".emergency-list li": {
              "background": "#ffffff !important",
              "border-color": "#fecaca !important",
              "color": "#dc2626 !important",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "padding": "12px 16px"
            },
            ".emergency-list li svg": {
              "flex-shrink": "0"
            },
            ".cta-card": {
              "text-align": "center",
              "padding": "40px 32px",
              "background": "#ffffff",
              "border": "2px dashed #cbd5e1",
              "border-radius": "20px"
