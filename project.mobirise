              "padding": "3px 8px",
              "border-radius": "20px",
              "border": "1px solid #eaeaea"
            },
            ".lang-link": {
              "display": "flex",
              "align-items": "center",
              "gap": "3px",
              "text-decoration": "none !important",
              "transition": "transform 0.2s ease",
              "&:hover": {
                "transform": "scale(1.08)"
              },
              "white-space": "nowrap",
              "flex-shrink": "0"
            },
