    "guide-first-job.html": {
      "settings": {
        "title": "Finding Your First Job in Germany as a Ukrainian",
        "order": "24",
        "meta_descr": "Where Ukrainians find work in Upper Franconia, how Minijobs and contracts work, what to report to the Jobcenter and how to write a German CV.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-first-job.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-first-job.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-first-job.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-first-job.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-first-job.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Finding Your First Job in Germany as a Ukrainian\" />\n<meta property=\"og:description\" content=\"Where Ukrainians find work in Upper Franconia, how Minijobs and contracts work, what to report to the Jobcenter and how to write a German CV.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-first-job.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Finding Your First Job in Germany\",\"description\":\"Where Ukrainians find work in Upper Franconia, how Minijobs and contracts work, what to report to the Jobcenter and how to write a German CV.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/guide-first-job.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-first-job.html\",\"wordCount\":1042,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Am I allowed to work in Germany?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. With a §24 permit you may work as an employee or self-employed from the first day.\"}},{\"@type\":\"Question\",\"name\":\"Do I lose my benefits if I work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Your benefits are reduced, but part of your income is not counted. Working almost always leaves you with more money in total.\"}},{\"@type\":\"Question\",\"name\":\"Does the minimum wage apply to me?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. The legal minimum wage applies to all employees in Germany.\"}},{\"@type\":\"Question\",\"name\":\"Can adults start vocational training?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Ausbildung is open to adults and often leads fastest to a recognised German qualification.\"}},{\"@type\":\"Question\",\"name\":\"Should I file a tax return?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It is often worth it. With the free ELSTER portal many employees get money back.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Finding Your First Job in Germany\",\"item\":\"https://zusammenleben-ukraine.de/guide-first-job.html\"}]}]}</script>"
      },
