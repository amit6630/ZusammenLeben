    "guide-social-insurance.html": {
      "settings": {
        "title": "Social Insurance in Germany Explained Simply",
        "order": "38",
        "meta_descr": "Health, care, pension, unemployment and accident insurance: what is deducted from your wage, what each pays and what Ukrainian employees should know.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-social-insurance.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-social-insurance.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-social-insurance.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-social-insurance.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/guide-social-insurance.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Social Insurance in Germany Explained Simply\" />\n<meta property=\"og:description\" content=\"Health, care, pension, unemployment and accident insurance: what is deducted from your wage, what each pays and what Ukrainian employees should know.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/guide-social-insurance.html\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Social Insurance in Germany Explained\",\"description\":\"Health, care, pension, unemployment and accident insurance: what is deducted from your wage, what each pays and what Ukrainian employees should know.\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/guide-social-insurance.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/guide-social-insurance.html\",\"wordCount\":1094,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Which insurances are deducted from my wage?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Health, long-term care, pension and unemployment insurance. Accident insurance is paid by the employer.\"}},{\"@type\":\"Question\",\"name\":\"When can I receive unemployment benefit?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"After at least twelve months of contributions within the last thirty months.\"}},{\"@type\":\"Question\",\"name\":\"Am I insured in a minijob?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Not for health through the job, but in pension and accident insurance, unless you opt out of pension insurance.\"}},{\"@type\":\"Question\",\"name\":\"Who pays after a work accident?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The statutory accident insurance. Tell the doctor and employer it was a work accident.\"}},{\"@type\":\"Question\",\"name\":\"How do I apply for care support?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Through your health insurance fund, which runs the care fund and arranges an assessment.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://zusammenleben-ukraine.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://zusammenleben-ukraine.de/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Social Insurance in Germany Explained\",\"item\":\"https://zusammenleben-ukraine.de/guide-social-insurance.html\"}]}]}</script>"
      },
