              ".brand-container": {
                "width": "auto",
                "flex-grow": "1",
                "justify-content": "flex-start"
              },
              ".navbar-brand": {
                "padding-right": "20px"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "padding-top": "10px",
                "padding-bottom": "10px",
                "display": "flex !important",
                "flex-basis": "auto",
                ".navbar-nav": {
                  "margin": "0 -0.5em",
                  "flex-grow": "1",
                  "justify-content": "flex-end"
                },
                ".mbr-section-btn": {
                  "margin-left": "auto"
                },
                "min-width": "0"
              },
              ".desktop-only-flex": {
                "display": "flex !important",
                "justify-content": "flex-end",
                "align-items": "center",
                "gap": "3px",
                "flex-wrap": "nowrap",
                "margin-left": "auto",
                "padding-right": "20px"
              },
              ".mobile-only": {
                "display": "none !important"
              },
              ".navbar-nav": {
                "flex-wrap": "wrap !important",
