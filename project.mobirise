                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
