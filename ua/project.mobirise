              "color": "#475569",
              "margin-bottom": "12px",
              "line-height": "1.65"
            },
            ".guide-subcard p:last-child": {
              "margin-bottom": "0"
            },
            ".three-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(240px, 1fr))",
              "gap": "16px",
              "margin-top": "24px"
            },
            ".guide-mini-card": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "border-radius": "14px",
              "padding": "24px",
              "transition": "transform 0.2s ease, box-shadow 0.2s ease"
            },
            ".guide-mini-card:hover": {
              "transform": "translateY(-2px)",
              "box-shadow": "0 6px 15px rgba(0, 0, 0, 0.04)"
            },
            ".mini-icon": {
              "color": "#2563eb",
              "margin-bottom": "14px",
              "display": "inline-block"
            },
            ".guide-mini-card h3": {
              "font-size": "1.05rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".guide-mini-card p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.5"
            },
            ".rule-box": {
              "padding": "24px",
              "border-radius": "14px",
              "margin": "20px 0"
            },
            ".rule-box.green-rule": {
              "background": "#f0fdf4",
              "border": "1px solid #bbf7d0",
              "border-left": "5px solid #22c55e",
              "color": "#166534"
            },
            ".rule-box h3": {
              "font-size": "1.2rem",
              "font-weight": "700",
              "color": "#166534",
              "margin": "0 0 10px 0"
            },
            ".rule-box p": {
              "font-size": "0.95rem",
              "margin": "0 0 8px 0",
              "line-height": "1.6"
            },
            ".rule-box p:last-child": {
              "margin-bottom": "0"
            },
            ".cta-box": {
              "text-align": "center",
              "margin-top": "30px",
              "padding": "40px 32px",
              "background": "linear-gradient(180deg, #ffffff 0%, #f8fafc 100%)"
            },
            ".cta-box h3": {
              "font-size": "1.5rem",
              "margin-bottom": "14px"
            },
            ".cta-description": {
              "max-width": "700px",
              "margin": "0 auto 16px",
              "color": "#475569",
              "font-size": "1rem"
            },
            ".cta-statement": {
              "font-weight": "700",
              "color": "#0f172a",
              "margin-bottom": "28px",
              "font-size": "1.05rem"
            },
            ".guide-executive-section .mbr-section-btn": {
