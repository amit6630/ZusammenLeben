    "learning-german.html": {
      "settings": {
        "title": "Вивчення німецької у Верхній Франконії | ZusammenLeben",
        "order": "6",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/learning-german.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/learning-german.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/learning-german.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/learning-german.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/learning-german.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Вивчення німецької у Верхній Франконії | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"Способи вивчити німецьку для українських родин у Північній Баварії: інтеграційні курси, мовні кафе, онлайн-ресурси та практика щодня.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/learning-german.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"url\":\"https://zusammenleben-ukraine.de/ua/learning-german.html\",\"name\":\"Вивчення німецької у Верхній Франконії\",\"description\":\"Способи вивчити німецьку для українських родин у Північній Баварії: інтеграційні курси, мовні кафе, онлайн-ресурси та практика щодня.\",\"inLanguage\":\"uk\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"},\"about\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Вивчення німецької у Верхній Франконії\",\"item\":\"https://zusammenleben-ukraine.de/ua/learning-german.html\"}]}]}</script>",
        "meta_descr": "Способи вивчити німецьку для українських родин у Північній Баварії: інтеграційні курси, мовні кафе, онлайн-ресурси та практика щодня."
      },
      "components": [
        {
          "_name": "amenu1",
          "_sourceTheme": "solarm5",
          "_styles": {
            "& when (@sticky)": {
              "position": "sticky !important",
              "top": "0 !important",
              "z-index": "1030 !important",
              "width": "100%",
              "nav.navbar, .navbar-dropdown, .navbar-fixed-top": {
                "position": "relative !important"
              }
            },
            "& when not (@sticky)": {
              "position": "relative",
              "z-index": "1030",
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "body": {
              "position": "relative"
            },
            ".navbar": {
              "min-height": "80px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".navbar-logo img": {
                "width": "auto"
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-logo img": {
                  "height": "2.5rem !important"
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".container, .container-fluid": {
              "display": "flex",
              "flex-wrap": "wrap",
              "margin": "auto",
              "align-items": "center"
            },
            ".brand-container": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding-bottom": "4px",
              "padding-top": "4px",
              "width": "100%"
            },
            ".navbar-brand": {
              "min-height": "60px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "5px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              "display": "flex",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            "@media (min-width: 992px)": {
              ".brand-container": {
                "width": "auto",
                "flex-grow": "1",
                "justify-content": "flex-start"
              },
              ".navbar-brand": {
                "padding-right": "20px"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "padding-top": "10px",
                "padding-bottom": "10px",
                "display": "flex !important",
                "flex-basis": "auto",
                ".navbar-nav": {
                  "margin": "0 -0.5em",
                  "flex-grow": "1",
                  "justify-content": "flex-end"
                },
                ".mbr-section-btn": {
                  "margin-left": "auto"
                },
                "min-width": "0"
              },
              ".desktop-only-flex": {
                "display": "flex !important",
                "justify-content": "flex-end",
                "align-items": "center",
                "gap": "3px",
                "flex-wrap": "nowrap",
                "margin-left": "auto",
                "padding-right": "20px"
              },
              ".mobile-only": {
                "display": "none !important"
              },
              ".navbar-nav": {
                "flex-wrap": "wrap !important",
                "row-gap": "2px"
              },
              ".navbar-buttons .btn": {
                "padding": ".6rem 1.2rem !important",
                "font-size": "15px !important",
                "min-height": "44px"
              },
              ".navbar-nav .nav-link": {
                "padding-left": ".45em !important",
                "padding-right": ".45em !important"
              }
            },
            "@media (max-width: 991px)": {
              ".navbar": {
                "min-height": "60px !important"
              },
              ".desktop-only-flex": {
                "display": "none !important"
              },
              ".mobile-only": {
                "display": "flex !important",
                "align-items": "center",
                "gap": "0 !important",
                "background": "rgba(0, 0, 0, 0.03)",
                "padding": "0 4px !important",
                "border-radius": "20px",
                "border": "1px solid #eaeaea",
                "margin-left": "auto",
                "margin-right": "8px"
              },
              ".navbar-brand": {
                "flex-shrink": "initial",
                "flex-basis": "auto",
                "word-break": "break-word",
