              "gap": "10px",
              "font-size": "22px",
              "font-weight": "750",
              "color": "#0f172a",
              "margin": "28px 0 12px"
            },
            ".zl-count": {
              "display": "inline-grid",
              "place-items": "center",
              "min-width": "28px",
              "height": "28px",
              "padding": "0 8px",
              "border-radius": "999px",
              "background": "#e0e7ff",
              "color": "#0c2c68",
              "font-size": "14px",
              "font-weight": "700"
            },
            ".zl-rail": {
              "display": "flex",
              "gap": "16px",
              "overflow-x": "auto",
              "scroll-snap-type": "x mandatory",
              "overscroll-behavior-x": "contain",
              "padding": "4px 2px 16px",
              "scrollbar-width": "none"
            },
            ".zl-rail::-webkit-scrollbar": {
              "display": "none"
            },
            ".zl-rail > .zl-tile": {
              "flex": "0 0 calc((100% - 48px) / 3.6)",
              "min-width": "230px",
              "scroll-snap-align": "start"
            },
            ".zl-rail-wrap": {
              "position": "relative"
            },
            ".zl-rail-btn": {
              "position": "absolute",
              "top": "calc(50% - 30px)",
              "z-index": "2",
              "width": "44px",
              "height": "44px",
              "border-radius": "50%",
              "border": "1px solid #e2e8f0",
              "background": "#fff",
              "color": "#0c2c68",
              "display": "grid",
              "place-items": "center",
              "cursor": "pointer",
              "box-shadow": "0 6px 18px rgba(15, 23, 42, .14)"
            },
            ".zl-rail-btn svg": {
