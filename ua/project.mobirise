              "margin": "0 auto",
              "padding": "0 24px"
            },
            ".guide-header": {
              "text-align": "center",
              "max-width": "820px",
              "margin": "0 auto 50px"
            },
            ".header-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-top": "50px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "border": "1px solid #bfdbfe"
            },
            ".header-title": {
              "font-size": "2.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.02em",
