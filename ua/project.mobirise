    "guide-social-insurance.html": {
      "settings": {
        "title": "Соціальне страхування в Німеччині простими словами",
        "order": "38",
        "meta_descr": "Медичне, страхування догляду, пенсійне, на випадок безробіття та від нещасних випадків: що утримують із зарплати, що виплачує кожне і що важливо знати.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-social-insurance.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-social-insurance.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-social-insurance.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-social-insurance.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-social-insurance.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Соціальне страхування в Німеччині простими словами\" />\n<meta property=\"og:description\" content=\"Медичне, страхування догляду, пенсійне, на випадок безробіття та від нещасних випадків: що утримують із зарплати, що виплачує кожне і що важливо знати.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-social-insurance.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Соціальне страхування в Німеччині\",\"description\":\"Медичне, страхування догляду, пенсійне, на випадок безробіття та від нещасних випадків: що утримують із зарплати, що виплачує кожне і що важливо знати.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-social-insurance.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-social-insurance.html\",\"wordCount\":945,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Які страхування утримують із зарплати?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Медичне, догляду, пенсійне та на випадок безробіття. Страхування від нещасних випадків сплачує роботодавець.\"}},{\"@type\":\"Question\",\"name\":\"Коли можна отримувати допомогу з безробіття?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Після щонайменше дванадцяти місяців внесків за останні тридцять місяців.\"}},{\"@type\":\"Question\",\"name\":\"Чи застрахований я на мініджобі?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Медичної страховки через роботу немає, але є пенсійне страхування та від нещасних випадків, якщо ви не відмовилися від пенсійного.\"}},{\"@type\":\"Question\",\"name\":\"Хто платить після нещасного випадку на роботі?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Державне страхування від нещасних випадків. Скажіть лікарю й роботодавцю, що це був робочий випадок.\"}},{\"@type\":\"Question\",\"name\":\"Як подати заяву на допомогу з догляду?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Через лікарняну касу, яка веде касу догляду й організовує оцінювання.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Соціальне страхування в Німеччині\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-social-insurance.html\"}]}]}</script>"
      },
