              "border-radius": "18px",
              "background": "#0c2c68",
              "color": "#fff"
            },
            ".zl-cta h2": {
              "color": "#fff",
              "margin": "0 0 6px",
              "font-size": "24px",
              "font-weight": "750"
            },
            ".zl-cta p": {
              "margin": "0 0 16px",
              "color": "#dbeafe"
            },
            ".zl-btns": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "10px"
            },
            ".zl-btn": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-height": "46px",
              "padding": "10px 20px",
              "border-radius": "999px",
              "font-weight": "700",
              "text-decoration": "none !important"
            },
            ".zl-btn--wa": {
              "background": "#0f7a3e",
              "color": "#fff !important"
            },
            ".zl-btn--light": {
              "background": "#fff",
              "color": "#0c2c68 !important"
            },
            ".zl-btn--ghost": {
              "border": "2px solid #0c2c68",
              "color": "#0c2c68 !important",
              "background": "transparent"
            },
            ".zl-related": {
              "margin-top": "36px"
            },
            ".zl-related h2": {
              "font-size": "22px",
              "margin": "0 0 12px",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fill, minmax(250px, 1fr))",
              "gap": "16px"
            },
            ".zl-tile": {
              "display": "flex",
              "flex-direction": "column",
              "gap": "8px",
              "padding": "20px",
              "background": "#fff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "color": "#1e293b !important",
              "text-decoration": "none !important",
              "transition": "transform .2s, box-shadow .2s, border-color .2s"
            },
            ".zl-tile:hover": {
              "transform": "translateY(-3px)",
              "border-color": "#93c5fd",
              "box-shadow": "0 14px 30px -20px rgba(29, 78, 216, .45)"
            },
            ".zl-tile h2, .zl-tile h3": {
              "font-size": "18px",
              "line-height": "1.3",
              "margin": "0",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-tile p": {
              "margin": "0",
              "font-size": "15px",
              "color": "#475569"
            },
            ".zl-tile .zl-more": {
              "margin-top": "auto",
              "font-weight": "700",
              "color": "#1d4ed8",
              "font-size": "15px"
            },
            ".zl-ico": {
              "width": "42px",
              "height": "42px",
              "border-radius": "12px",
              "display": "grid",
              "place-items": "center",
              "background": "#e0e7ff",
              "color": "#0c2c68"
            },
            ".zl-ico svg": {
              "width": "22px",
              "height": "22px"
            },
            ".zl-hub-head": {
              "margin-bottom": "26px",
              "max-width": "760px"
            },
            ".zl-hub-head .zl-lead": {
              "margin-bottom": "0"
            },
            ".zl-cat": {
              "display": "flex",
              "align-items": "center",
              "gap": "10px",
              "font-size": "22px",
              "font-weight": "750",
              "color": "#0f172a",
              "margin": "28px 0 12px"
            },
            ".zl-count": {
              "display": "inline-grid",
              "place-items": "center",
              "min-width": "28px",
              "height": "28px",
              "padding": "0 8px",
              "border-radius": "999px",
              "background": "#e0e7ff",
              "color": "#0c2c68",
              "font-size": "14px",
              "font-weight": "700"
            },
            ".zl-rail": {
              "display": "flex",
              "gap": "16px",
              "overflow-x": "auto",
              "scroll-snap-type": "x mandatory",
              "overscroll-behavior-x": "contain",
              "padding": "4px 2px 16px",
              "scrollbar-width": "none"
            },
            ".zl-rail::-webkit-scrollbar": {
              "display": "none"
            },
            ".zl-rail > .zl-tile": {
              "flex": "0 0 calc((100% - 48px) / 3.6)",
              "min-width": "230px",
              "scroll-snap-align": "start"
            },
            ".zl-rail-wrap": {
              "position": "relative"
            },
            ".zl-rail-btn": {
              "position": "absolute",
              "top": "calc(50% - 30px)",
              "z-index": "2",
              "width": "44px",
              "height": "44px",
              "border-radius": "50%",
              "border": "1px solid #e2e8f0",
              "background": "#fff",
              "color": "#0c2c68",
              "display": "grid",
              "place-items": "center",
              "cursor": "pointer",
              "box-shadow": "0 6px 18px rgba(15, 23, 42, .14)"
            },
            ".zl-rail-btn svg": {
              "width": "20px",
              "height": "20px"
            },
            ".zl-rail-btn:hover": {
              "background": "#e0e7ff"
            },
            ".zl-rail-btn[hidden]": {
              "display": "none"
            },
            ".zl-rail-prev": {
              "left": "4px"
            },
            ".zl-rail-next": {
              "right": "4px"
            },
            ".zl-rail .zl-tile h3": {
              "font-size": "17px"
            },
            ".zl-rail .zl-tile p": {
              "display": "-webkit-box",
              "-webkit-line-clamp": "3",
              "-webkit-box-orient": "vertical",
              "overflow": "hidden"
            },
            ".zl-comm-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(230px, 1fr))",
              "gap": "16px",
              "margin": "6px 0 0"
            },
            ".zl-comm-grid .zl-tile:hover": {
              "transform": "none",
              "box-shadow": "none",
              "border-color": "#e2e8f0"
            },
            "@media (max-width: 575px)": {
              ".zl-grid": {
                "grid-template-columns": "1fr 1fr",
                "gap": "10px"
              },
              ".zl-grid .zl-tile": {
                "padding": "14px",
                "gap": "8px"
              },
              ".zl-grid .zl-tile p, .zl-grid .zl-tile .zl-more": {
                "display": "none"
              },
              ".zl-grid .zl-tile h2, .zl-grid .zl-tile h3": {
                "font-size": "15px"
              },
              ".zl-grid .zl-ico": {
                "width": "34px",
                "height": "34px"
              },
              ".zl-rail > .zl-tile": {
                "flex-basis": "72%",
                "min-width": "0",
                "padding": "14px"
              },
              ".zl-rail .zl-tile p": {
                "-webkit-line-clamp": "2",
                "font-size": "14px"
              },
              ".zl-rail-btn": {
                "display": "none"
              },
              ".zl-cat": {
                "font-size": "19px",
                "margin-top": "22px"
              },
              ".zl-comm-grid": {
                "gap": "10px"
              },
              ".zl-comm-grid .zl-tile": {
                "padding": "16px"
              },
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            },
            "@media (max-width: 991px)": {
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_name": "article08",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"zl-page\">\n<div class=\"zl-wrap\">\n<nav class=\"zl-crumbs\" aria-label=\"Навігація\"><ol><li><a href=\"index.html\">Головна</a></li><li aria-current=\"page\">Умови використання</li></ol></nav>\n<h1>Умови використання</h1>\n<div class=\"zl-card zl-body\"><h2>1. Загальна інформація, не юридична консультація</h2>\n<p>Матеріали сайту — це загальна інформація для родин з України в Німеччині. Вони не замінюють юридичної, медичної чи податкової консультації. Правила та процедури змінюються і різняться між установами. Завжди перевіряйте офіційні джерела, на які ми посилаємося.</p>\n<h2>2. Волонтерська допомога</h2>\n<p>ZusammenLeben — волонтерська ініціатива. Допомога безкоштовна і залежить від наших можливостей у конкретний момент. Права на певну послугу, квартиру, зустріч чи результат немає. Рішення щодо виплат, перебування та місць у школі ухвалюють відповідні установи.</p>\n<h2>3. Зовнішні посилання</h2>\n<p>Ми посилаємося на офіційні та надійні сайти. Ми не впливаємо на їхній зміст і не несемо за нього відповідальності. Якщо помітите непрацююче чи проблемне посилання, повідомте нам.</p>\n<h2>4. Авторське право</h2>\n<p>Тексти, графіка та фото на сайті захищені. Ділитися посиланнями на наші сторінки можна вільно. Для копіювання матеріалів потрібен наш дозвіл.</p>\n<h2>5. Контакт</h2>\n<p>Питання щодо цих умов: <a href=\"mailto:zusammenleben.de@gmail.com\">zusammenleben.de@gmail.com</a>.</p>\n<p><em>Оновлено: жовтень 2026.</em></p></div>\n</div>\n</section>",
          "_cid": "zl8d91efea",
