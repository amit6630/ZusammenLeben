    "guide-elderly-care.html": {
      "settings": {
        "title": "Літні люди та догляд у Німеччині: підтримка родин",
        "order": "43",
        "meta_descr": "Базова допомога в старості, ступені догляду, догляд удома, будинки для літніх і довіреність: посібник для літніх українців та їхніх родин.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-elderly-care.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-elderly-care.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-elderly-care.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-elderly-care.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-elderly-care.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Літні люди та догляд у Німеччині: підтримка родин\" />\n<meta property=\"og:description\" content=\"Базова допомога в старості, ступені догляду, догляд удома, будинки для літніх і довіреність: посібник для літніх українців та їхніх родин.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-elderly-care.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Літні люди та тривалий догляд у Німеччині\",\"description\":\"Базова допомога в старості, ступені догляду, догляд удома, будинки для літніх і довіреність: посібник для літніх українців та їхніх родин.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-elderly-care.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-elderly-care.html\",\"wordCount\":927,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Хто виплачує базову допомогу пенсіонерам?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Соціальне відомство району виплачує базову допомогу в старості, а не Jobcenter.\"}},{\"@type\":\"Question\",\"name\":\"Як подати заяву на ступінь догляду?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"До каси догляду вашої лікарняної каси. Оцінювач відвідує людину вдома й визначає ступінь.\"}},{\"@type\":\"Question\",\"name\":\"Чи можуть родичі отримувати гроші за догляд?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Людина, яка потребує догляду, отримує Pflegegeld, яке може передати родичам, що доглядають.\"}},{\"@type\":\"Question\",\"name\":\"Що таке довіреність на випадок недієздатності?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Документ, що дозволяє довіреній особі вирішувати й діяти за людину, яка вже не може цього робити.\"}},{\"@type\":\"Question\",\"name\":\"Хто оплачує будинок для літніх?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Страхування догляду оплачує частку; решту сплачує мешканець або за потреби Sozialamt.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Літні люди та тривалий догляд у Німеччині\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-elderly-care.html\"}]}]}</script>"
      },
