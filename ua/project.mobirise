    "Contact.html": {
      "settings": {
        "title": "Контакти ZusammenLeben | ZusammenLeben",
        "order": "13",
        "meta_descr": "Зв'яжіться з ZusammenLeben у Конрадсройті через WhatsApp, телефон, e-mail або форму. Відповідаємо українською, російською, німецькою, англійською.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/Contact.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/Contact.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/Contact.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/Contact.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/Contact.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Контакти ZusammenLeben | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"Зв'яжіться з ZusammenLeben у Конрадсройті через WhatsApp, телефон, e-mail або форму. Відповідаємо українською, російською, німецькою, англійською.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/Contact.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"url\":\"https://zusammenleben-ukraine.de/ua/Contact.html\",\"name\":\"Контакти ZusammenLeben\",\"description\":\"Зв'яжіться з ZusammenLeben у Конрадсройті через WhatsApp, телефон, e-mail або форму. Відповідаємо українською, російською, німецькою, англійською.\",\"inLanguage\":\"uk\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"},\"about\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Контакти ZusammenLeben\",\"item\":\"https://zusammenleben-ukraine.de/ua/Contact.html\"}]},{\"@type\":\"NGO\",\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"name\":\"ZusammenLeben\",\"alternateName\":\"Zusammen Leben\",\"url\":\"https://zusammenleben-ukraine.de/\",\"logo\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\",\"email\":\"zusammenleben.de@gmail.com\",\"telephone\":\"+380637004615\",\"description\":\"Безкоштовна волонтерська підтримка українських родин у Північній Баварії: житло, Jobcenter, реєстрація, школа та переклад у Гофі, Зельбі, Гельмбрехтсі.\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Alte Hofer Str. 1\",\"postalCode\":\"95176\",\"addressLocality\":\"Konradsreuth\",\"addressRegion\":\"Bayern\",\"addressCountry\":\"DE\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Hof\"},{\"@type\":\"Place\",\"name\":\"Helmbrechts\"},{\"@type\":\"Place\",\"name\":\"Münchberg\"},{\"@type\":\"Place\",\"name\":\"Selb\"},{\"@type\":\"Place\",\"name\":\"Wunsiedel\"},{\"@type\":\"Place\",\"name\":\"Arzberg\"},{\"@type\":\"Place\",\"name\":\"Marktredwitz\"},{\"@type\":\"Place\",\"name\":\"Naila\"},{\"@type\":\"Place\",\"name\":\"Kulmbach\"},{\"@type\":\"Place\",\"name\":\"Bad Steben\"},{\"@type\":\"Place\",\"name\":\"Oberfranken\"}],\"knowsLanguage\":[\"uk\",\"ru\",\"de\",\"en\"],\"founder\":{\"@type\":\"Person\",\"name\":\"Ben Shamir\"},\"member\":{\"@type\":\"Person\",\"name\":\"Anna Cheishvili\",\"jobTitle\":\"Operations Manager\"},\"foundingDate\":\"2022\"}]}</script>"
      },
      "components": [
        {
          "_name": "amenu1",
          "_sourceTheme": "solarm5",
          "_styles": {
            "& when (@sticky)": {
              "position": "sticky !important",
              "top": "0 !important",
              "z-index": "1030 !important",
              "width": "100%",
              "nav.navbar, .navbar-dropdown, .navbar-fixed-top": {
                "position": "relative !important"
              }
            },
            "& when not (@sticky)": {
              "position": "relative",
              "z-index": "1030",
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "body": {
              "position": "relative"
            },
            ".navbar": {
              "min-height": "80px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
