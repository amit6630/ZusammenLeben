            },
            ".icon-danger": {
              "color": "#ef4444",
              "display": "inline-flex"
            },
            ".icon-primary": {
              "color": "#2563eb",
              "display": "inline-flex"
            },
            ".notice-highlight": {
              "background": "#f0f9ff",
              "border-left": "4px solid #0284c7",
              "padding": "16px 20px",
              "border-radius": "8px",
              "font-size": "0.95rem",
              "color": "#0369a1",
              "margin-top": "20px",
              "line-height": "1.6"
            },
            ".notice-highlight.compact-notice": {
              "font-size": "0.88rem",
              "padding": "12px 16px"
            },
            ".cta-box": {
              "text-align": "center",
              "margin-top": "30px",
              "padding": "40px 32px",
              "background": "linear-gradient(180deg, #ffffff 0%, #f8fafc 100%)"
            },
            ".cta-box h3": {
              "font-size": "1.5rem",
              "margin-bottom": "14px"
            },
            ".cta-description": {
              "max-width": "700px",
              "margin": "0 auto 16px",
              "color": "#475569",
              "font-size": "1rem"
            },
            ".cta-statement": {
              "font-weight": "700",
              "color": "#0f172a",
              "margin-bottom": "28px",
              "font-size": "1.05rem"
            },
            ".guide-executive-section .mbr-section-btn": {
              "display": "flex",
              "gap": "12px",
              "flex-wrap": "wrap",
              "margin": "0",
              "justify-content": "center"
            },
            ".guide-executive-section .btn.custom-btn": {
              "padding": "14px 28px !important",
              "border-radius": "100px !important",
              "font-weight": "700 !important",
              "font-size": "0.95rem !important",
              "display": "inline-flex !important",
              "align-items": "center !important",
              "justify-content": "center !important",
              "gap": "8px !important",
              "transition": "all 0.25s ease !important",
              "border-width": "1px !important",
              "text-decoration": "none !important"
            },
            ".guide-executive-section .btn.outline-btn": {
              "background-color": "#ffffff !important",
              "border-color": "#cbd5e1 !important",
              "color": "#0f172a !important"
            },
            ".guide-executive-section .btn.outline-btn:hover": {
              "background-color": "#f1f5f9 !important",
              "border-color": "#94a3b8 !important",
              "transform": "translateY(-2px) !important"
            },
            ".guide-executive-section .btn.whatsapp-btn": {
              "background-color": "#25d366 !important",
              "border-color": "#25d366 !important",
              "color": "#ffffff !important",
              "box-shadow": "0 4px 12px rgba(37, 211, 102, 0.2) !important"
            },
            ".guide-executive-section .btn.whatsapp-btn:hover": {
              "background-color": "#20bd5a !important",
              "border-color": "#20bd5a !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 6px 18px rgba(37, 211, 102, 0.3) !important"
            },
            "@media (max-width: 768px)": {
              ".guide-executive-section": {
                "padding": "40px 0 !important"
              },
              ".executive-container": {
                "padding": "0 16px"
              },
              ".header-title": {
                "font-size": "1.85rem"
              },
              ".guide-card, .cta-box": {
                "padding": "22px 16px"
              },
              ".guide-subcard": {
                "padding": "20px"
              },
              ".guide-executive-section .mbr-section-btn": {
                "flex-direction": "column",
                "width": "100%"
              },
              ".guide-executive-section .btn.custom-btn": {
                "width": "100% !important"
              },
              ".disclaimer-banner": {
                "flex-direction": "column",
                "align-items": "flex-start",
                "gap": "12px"
              },
              ".resource-link": {
                "flex-direction": "column",
                "align-items": "flex-start",
                "gap": "4px"
              }
            },
            "@media (max-width: 480px)": {
              ".card-details-grid, .two-column-grid, .three-column-grid": {
                "grid-template-columns": "1fr"
              },
              ".block-title": {
                "font-size": "1.25rem"
              }
            }
          },
          "_name": "header01",
          "_sourceTheme": "holidaym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"guide-executive-section\" id=\"refugee-rights-guide\">\n    <div class=\"executive-container\">\n        \n        <!-- Header -->\n        <header class=\"guide-header\">\n            <span class=\"header-tag\">ПОВНИЙ ГАЙД</span>\n            <h1 class=\"header-title\">Реалізація ваших прав як біженця з України в Німеччині</h1>\n            <p class=\"header-lead\">\n                Від юридичного статусу до практичних процедур: на що ви маєте право, куди звертатися та що саме робити, якщо ви застрягли в бюрократичній системі.\n            </p>\n        </header>\n\n        <!-- General Disclaimer / Notice -->\n        <div class=\"disclaimer-banner\">\n            <div class=\"disclaimer-icon\">\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z\"></path><path d=\"m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z\"></path><path d=\"M7 21h10\"></path><path d=\"M12 3v18\"></path><path d=\"M3 7h18\"></path></svg>\n            </div>\n            <div class=\"disclaimer-text\">\n                <strong>Важливе юридичне повідомлення:</strong> Статус тимчасового захисту (§ 24) періодично продовжується Радою ЄС. Процедури, суми фінансової допомоги та критерії відповідності відрізняються залежно від міста та постійно змінюються. Завжди перевіряйте поточний загальний термін та термін дії вашої особистої посвідки в місцевому відомстві у справах іноземців (Ausländerbehörde).\n            </div>\n        </div>\n\n        <!-- Section 1: The Legal Basis -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"3\" y1=\"22\" x2=\"21\" y2=\"22\"></line><line x1=\"6\" y1=\"18\" x2=\"6\" y2=\"11\"></line><line x1=\"10\" y1=\"18\" x2=\"10\" y2=\"11\"></line><line x1=\"14\" y1=\"18\" x2=\"14\" y2=\"11\"></line><line x1=\"18\" y1=\"18\" x2=\"18\" y2=\"11\"></line><polygon points=\"12 2 20 7 4 7 12 2\"></polygon></svg>\n                </span>\n                Правова основа: чому ваш статус відрізняється\n            </h2>\n            \n            <div class=\"guide-card\">\n                <p>Біженці з України в Німеччині не проходять стандартну процедуру отримання притулку (Asyl). Натомість вони підпадають під дію <strong>Директиви ЄС про тимчасовий захист</strong>, яка була активована вперше в історії у березні 2022 року.</p>\n                <p>У Німеччині це трансформується у посвідку на проживання згідно з <strong>Параграфом 24 Закону про перебування (§ 24 AufenthG)</strong>. Практичні наслідки цього величезні: відсутність тривалих процедур отримання притулку, відсутність довгих співбесід, негайний доступ до ринку праці та право на стандартну соціальну підтримку.</p>\n                \n                <div class=\"rule-box green-rule\">\n                    <h3>\n                        <span class=\"inline-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"></path><path d=\"M9 18h6\"></path><path d=\"M10 22h4\"></path></svg>\n                        </span>\n                        Критична відмінність\n                    </h3>\n                    <p>Звичайний шукач притулку отримує обмежену підтримку за Законом про допомогу шукачам притулку (AsylbLG). Як власник статусу за § 24, ви отримуєте підтримку через Jobcenter (Bürgergeld) згідно з SGB II — <strong>за тією ж системою, яка обслуговує жителів Німеччини.</strong> Це величезна перевага, яку ви повинні знати та використовувати.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 2: The Three Documents -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"></line></svg>\n                </span>\n                Три документи, від яких залежить усе\n            </h2>\n            <p class=\"section-intro-text\">Перш ніж обговорювати права, ви повинні отримати ці три базові документи. Без них німецька система вас просто \"не бачить\".</p>\n            \n            <div class=\"three-column-grid\">\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>\n                    </div>\n                    <h3>Anmeldung (Реєстрація адреси)</h3>\n                    <p>Перший і найважливіший крок. Оформлюється в ратуші (<em>Bürgerbüro</em>). Без цього ви не зможете відкрити банківський рахунок, оформити страховку або подати заяву до Jobcenter. Записуйтеся негайно, очікування може тривати тижнями.</p>\n                </div>\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>\n                    </div>\n                    <h3>Посвідка на проживання (§ 24)</h3>\n                    <p>Видається відомством з справ іноземців (<em>Ausländerbehörde</em>). Прострочений документ зупиняє виплати та страховку. Починайте процес продовження щонайменше за 8 тижнів до закінчення терміну. Тимчасові довідки (<em>Fiktionsbescheinigung</em>) також мають юридичну силу.</p>\n                </div>\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\" ry=\"2\"></rect><line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"></line></svg>\n                    </div>\n                    <h3>Банківський рахунок</h3>\n                    <p>Необхідний для виплат від Jobcenter, оплати оренди та укладення договорів. Ви маєте законне право на базовий рахунок (<em>Basiskonto</em>) у Німеччині. Якщо банк відмовляє, вимагайте письмову відмову та повідомляйте регулятор BaFin.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 3: Financial Support -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"2\"></rect><circle cx=\"12\" cy=\"12\" r=\"2\"></circle><path d=\"M6 12h.01M18 12h.01\"></path></svg>\n                </span>\n                Фінансова підтримка (Bürgergeld)\n            </h2>\n            \n            <div class=\"guide-card\">\n                <div class=\"card-header\">\n                    <h3>Базові виплати від Jobcenter</h3>\n                    <span class=\"status-tag info\">Стандартна підтримка</span>\n                </div>\n                \n                <div class=\"card-details-grid\">\n                    <div class=\"detail-box\">\n                        <h4>Regelbedarf (Базова допомога на проживання)</h4>\n                        <p>Базова сума для щоденного життя, яка виплачується безпосередньо на ваш рахунок на кожного члена домогосподарства, розрахована залежно від віку та сімейного стану.</p>\n                    </div>\n                    <div class=\"detail-box\">\n                        <h4>Kosten der Unterkunft (KdU - Витрати на житло)</h4>\n                        <p>Витрати на житло, включаючи базову орендну плату, комунальні послуги та опалення. Оплачуються суворо в тому випадку, якщо квартира вважається \"доцільною\" (<em>angemessen</em>).</p>\n                    </div>\n                </div>\n\n                <div class=\"rule-box amber-rule\">\n                    <h3>\n                        <span class=\"inline-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg>\n                        </span>\n                        Правило \"відповідної/доцільної квартири\"\n                    </h3>\n                    <p>Це те, на чому спотикається більшість сімей. Кожен район визначає свої суворі максимальні ліміти оренди. <strong>Ніколи не підписуйте договір оренди до отримання письмового схвалення від Jobcenter (Mietbescheinigung).</strong> Якщо ви підпишете договір передчасно, вам доведеться платити різницю в оренді з власної кишені.</p>\n                </div>\n\n                <h3 class=\"subsection-title\">Додаткові виплати (потребують окремих заявок):</h3>\n                <div class=\"three-column-grid compact-grid\">\n                    <div class=\"guide-mini-card\">\n                        <div class=\"card-title-with-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg>\n                            <h3>Erstausstattung</h3>\n                        </div>\n                        <p>Одноразова фінансова допомога на первинне придбання меблів, побутової техніки та одягу. <em>Не надається автоматично.</em></p>\n                    </div>\n                    <div class=\"guide-mini-card\">\n                        <div class=\"card-title-with-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"16\"></line><line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"></line></svg>\n                            <h3>Mehrbedarf</h3>\n                        </div>\n                        <p>Додаткові щомісячні надбавки для вагітних жінок, батьків-одинаків або при особливих медичних дієтах.</p>\n                    </div>\n                    <div class=\"guide-mini-card\">\n                        <div class=\"card-title-with-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 10v6M2 10l10-5 10 5-10 5z\"></path><path d=\"M6 12v5c3 3 9 3 12 0v-5\"></path></svg>\n                            <h3>BuT (Освіта та розвиток)</h3>\n                        </div>\n                        <p>Пакет допомоги для дітей, що покриває шкільне приладдя, обіди, репетиторство та гуртки чи спортивні секції.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 4: Health & Work -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"></path></svg>\n                </span>\n                Медичне страхування, робота та освіта\n            </h2>\n            \n            <div class=\"two-column-grid\">\n                <!-- Health -->\n                <div class=\"guide-subcard\">\n                    <h3>Медичне страхування (Krankenkasse)</h3>\n                    <p>Страхування є обов'язковим. Отримувачі Bürgergeld застраховані через державні медичні каси, які оплачує Jobcenter.</p>\n                    <p><strong>Чи знаєте ви?</strong> Ви можете подати заяву на звільнення від доплати за ліки (<em>Zuzahlungsbefreiung</em>). Крім того, у екстрених випадках лікарні зобов'язані надати вам допомогу, навіть якщо у вас ще немає з собою страхової картки.</p>\n                </div>\n\n                <!-- Work -->\n                <div class=\"guide-subcard\">\n                    <h3>Право на роботу</h3>\n                    <p>Ваша посвідка за § 24 надає вам <strong>повний та необмежений доступ</strong> до ринку праці.</p>\n                    <p>Робота не скасовує підтримку Jobcenter; якщо ваш дохід низький, вони просто доплачують різницю (з урахуванням неоподатковуваних пільг). Однак ви <strong>зобов'язані негайно повідомляти</strong> про будь-який дохід, щоб уникнути суворих штрафів.</p>\n                </div>\n                \n                <!-- Housing Rights -->\n                <div class=\"guide-subcard\">\n                    <h3>Житло та права орендарів</h3>\n                    <p>Орендарі в Німеччині дуже захищені. Орендодавці не можуть виселити вас без судового процесу, а застава (<em>Kaution</em>) суворо обмежена сумою 3 місячних базових орендних плат.</p>\n                    <p><strong>Важливо:</strong> Завжди заповнюйте акт прийому-передачі (<em>Übergabeprotokoll</em>) з фотографіями під час заселення. Настійно рекомендується приєднатися до місцевого союзу орендарів (<em>Mieterverein</em>).</p>\n                </div>\n\n                <!-- Education -->\n                <div class=\"guide-subcard\">\n                    <h3>Школа та визнання дипломів</h3>\n                    <p>Відвідування школи є юридично обов'язковим (<em>Schulpflicht</em>) для дітей. Прогули призводять до негайних проблем із владою.</p>\n                    <p>Для дорослих з регламентованими професіями (наприклад, медицина, викладання) необхідно пройти офіційну процедуру визнання (<em>Anerkennung</em>). Jobcenter часто може профінансувати цю коштовну процедуру.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 5: Bescheid & Widerspruch -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polyline points=\"12 6 12 12 16 14\"></polyline></svg>\n                </span>\n                Найважливіший процес: Bescheid та Widerspruch\n            </h2>\n            \n            <div class=\"guide-card alert-card-border\">\n                <div class=\"card-header\">\n                    <h3>Як спілкується німецька бюрократія</h3>\n                    <span class=\"status-tag critical\">Критично за часом</span>\n                </div>\n                <p>Кожне офіційне рішення надходить у письмовому вигляді через документ, який називається <strong>Bescheid</strong> (Офіційне рішення). Наприкінці є розділ, який пояснює ваше право на оскарження (<em>Rechtsbehelfsbelehrung</em>).</p>\n                \n                <div class=\"rule-box red-rule\">\n                    <h3>\n                        <span class=\"inline-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line></svg>\n                        </span>\n                        Один місяць. Це весь час, який у вас є.\n                    </h3>\n                    <p>Стандартний термін для подачі апеляції/заперечення (<strong>Widerspruch</strong>) становить рівно один місяць з дня вручення рішення. Якщо ви пропустите це вікно, рішення стає остаточним та його майже неможливо змінити.</p>\n                </div>\n\n                <div class=\"detail-box full-width-detail\">\n                    <h4>Що вам потрібно зробити на практиці:</h4>\n                    <ol class=\"action-steps-list\">\n                        <li>Відкривайте кожен лист негайно та перевіряйте дату.</li>\n                        <li>Якщо рішення неправильне, напишіть простий <em>Widerspruch</em> (Заперечення). Це не має бути складний юридичний текст. Просто напишіть своє ім'я, номер справи, дату та \"Я не згоден з цим рішенням\". Детальне обґрунтування можна надіслати пізніше.</li>\n                        <li>Надішліть його рекомендованим листом (<em>Einschreiben</em>) або віддайте особисто та отримайте штамп про вручення. Збережіть копію.</li>\n                        <li><strong>Ніколи не ігноруйте листи.</strong> У Німеччині мовчання означає згоду.</li>\n                    </ol>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 6: Mistakes & Links -->\n        <div class=\"guide-block\">\n            <div class=\"two-column-grid\">\n                \n                <!-- 8 Mistakes -->\n                <div class=\"guide-subcard\">\n                    <h3 class=\"card-title-flex\">\n                        <span class=\"icon-danger\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"15\" y1=\"9\" x2=\"9\" y2=\"15\"></line><line x1=\"9\" y1=\"9\" x2=\"15\" y2=\"15\"></line></svg>\n                        </span>\n                        8 найпоширеніших помилок\n                    </h3>\n                    <ul class=\"numbered-list\">\n                        <li><strong>1. Не подавати заяви на додаткові виплати.</strong> Кошти на меблі та освіту не призначаються автоматично.</li>\n                        <li><strong>2. Наосліп підписувати договір оренди.</strong> Спочатку дочекайтеся схвалення Jobcenter.</li>\n                        <li><strong>3. Пропуск 1-місячного терміну апеляції.</strong></li>\n                        <li><strong>4. Неповідомлення про зміни в житті.</strong> Про зміни доходу/адреси потрібно повідомляти негайно.</li>\n                        <li><strong>5. Покладатися на телефонні дзвінки.</strong> Якщо цього немає у письмовому вигляді, цього не було.</li>\n                        <li><strong>6. Втрата документів.</strong> Заведіть папку та фотографуйте кожен лист.</li>\n                        <li><strong>7. Затягування з визнанням диплома.</strong> Процес займає місяці.</li>\n                        <li><strong>8. Підписання документів без розуміння.</strong> Вимагайте перекладача або пояснень.</li>\n                    </ul>\n                </div>\n\n                <!-- Links -->\n                <div class=\"guide-subcard\">\n                    <h3 class=\"card-title-flex\">\n                        <span class=\"icon-primary\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\"></path><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\"></path></svg>\n                        </span>\n                        Офіційні ресурси\n                    </h3>\n                    \n                    <span class=\"resource-group-title\">Портали та підтримка</span>\n                    <a href=\"https://www.germany4ukraine.de\" target=\"_blank\" class=\"resource-link\"><strong>Germany4Ukraine</strong> Офіційний державний портал</a>\n                    <a href=\"https://handbookgermany.de\" target=\"_blank\" class=\"resource-link\"><strong>Handbook Germany</strong> Довідник (UA/RU/EN)</a>\n                    <a href=\"https://www.arbeitsagentur.de\" target=\"_blank\" class=\"resource-link\"><strong>Agentur für Arbeit</strong> Агентство з працевлаштування</a>\n                    <a href=\"https://www.jobcenter-ge.de\" target=\"_blank\" class=\"resource-link\"><strong>Jobcenter Portal</strong> Знайти своє відділення</a>\n\n                    <span class=\"resource-group-title\">Права та юридична допомога</span>\n                    <a href=\"https://www.bamf.de/DE/Themen/Integration/ZugewanderteTeilnehmende/Migrationsberatung/migrationsberatung-node.html\" target=\"_blank\" class=\"resource-link\"><strong>Центри MBE</strong> Безкоштовні міграційні консультації</a>\n                    <a href=\"https://www.mieterbund.de\" target=\"_blank\" class=\"resource-link\"><strong>Deutscher Mieterbund</strong> Німецький союз орендарів</a>\n                    <a href=\"https://anwaltauskunft.de\" target=\"_blank\" class=\"resource-link\"><strong>Anwaltverein</strong> Знайти адвоката</a>\n                    \n                    <div class=\"notice-highlight compact-notice\">\n                        <strong>Потрібна юридична допомога?</strong> Запитайте у місцевому суді талон на юридичну консультацію (<em>Beratungshilfeschein</em>) для отримання недорогої юридичної допомоги.\n                    </div>\n                </div>\n\n            </div>\n        </div>\n\n        <!-- Section 7: CTA -->\n        <div class=\"guide-block\">\n            <div class=\"guide-card cta-box\">\n                <h3>Як ZusammenLeben може допомогти</h3>\n                <p class=\"cta-description\">\n                    Ми пояснюємо листи простими словами, допомагаємо зрозуміти терміни, готуємо вас до візитів в установи та зв'язуємо з консультантами. <em>(Примітка: Ми не є юристами та не можемо надавати юридичні консультації або подавати апеляції від вашого імені).</em>\n                </p>\n                <p class=\"cta-statement\">\n                    Зв'яжіться з нами негайно, якщо ви отримали лист з дедлайном, перед підписанням договору оренди або якщо термін дії вашої посвідки закінчується!\n                </p>\n                \n                <!-- BUTTONS -->\n                <div class=\"mbr-section-btn cta-buttons-wrapper\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn custom-btn whatsapp-btn display-4 btn-warning\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                        Написати Ганні у WhatsApp\n                    </a>\n                    <a class=\"btn custom-btn outline-btn btn-primary\" href=\"mailto:info@yourdomain.com\" data-app-placeholder=\"Type Text\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"></path><polyline points=\"22,6 12,13 2,6\"></polyline></svg>\n                        Надіслати нам Email\n                    </a></div>\n            </div>\n        </div>\n\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "header01-2a",
          "_isUserblock": true,
          "_cid": "vqj8NxcbaH",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 scalem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"50\" max=\"400\" step=\"10\" value=\"150\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Lists\" name=\"showLists\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"list\" min=\"1\" max=\"5\" step=\"1\" value=\"4\" condition=\"showLists\">\n        <input type=\"color\" title=\"List Active Color\" value=\"#ffffff\" name=\"activeList\" condition=\"showLists\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Social Active Color\" value=\"#FF5753\" name=\"active\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#635d60\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#0c2c68\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#292325\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            \n            <!-- עמודת טקסט וכותרת ראשית -->\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showTitle || showText || showButtons || showLogo\">\n                <div class=\"content-wrapper\">\n                    <!-- תוספת המקום ללוגו -->\n                    <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"Logo\">\n                        </a>\n                    </div>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>\n                        ZUSAMMENLEBEN\n                    </b></h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                        Підтримка інтеграції, пошук житла та зв'язок зі спільнотою для новоприбулих і місцевих жителів регіону.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-phone mbr-iconfont mbr-iconfont-btn\"></span>\n                            Зв'язатися з нами\n                        </a></div>\n                </div>\n            </div>\n\n            <!-- עמודות הקישורים -->\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLists\">\n                <div class=\"lists-wrapper\">\n                    <div class=\"list-wrap\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Головна</a></li>\n                            <li class=\"item-wrap\"><a href=\"family-stories.html\" class=\"text-white\">Історії родин</a></li>\n                            <li class=\"item-wrap\"><a href=\"services.html\" class=\"text-white\">Послуги</a></li>\n                            <li class=\"item-wrap\"><a href=\"request-assistance.html\" class=\"text-white\">Запит на допомогу</a></li>\n                            <li class=\"item-wrap\"><a href=\"community.html\" class=\"text-white\">Спільнота</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"living-in-germany.html\" class=\"text-white\">Життя в Німеччині</a></li>\n                            <li class=\"item-wrap\"><a href=\"glossary.html\" class=\"text-white\">Глосарій</a></li>\n                            <li class=\"item-wrap\"><a href=\"learning-german.html\" class=\"text-white\">Вивчення німецької</a></li>\n                            <li class=\"item-wrap\"><a href=\"refugee-rights.html\" class=\"text-white\">Права біженців</a></li>\n                            <li class=\"item-wrap\"><a href=\"anna-shishoili.html\" class=\"text-white\">Анна Шишашвілі</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 2\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"how-to-help.html\" class=\"text-white\">Як ви можете допомогти</a></li>\n                            <li class=\"item-wrap\"><a href=\"social-activity.html\" class=\"text-white\">Соціальна діяльність</a></li>\n                            <li class=\"item-wrap\"><a href=\"faq.html\" class=\"text-white\">Часті запитання (FAQ)</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Регіони діяльності</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 3\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"emergency.html\" class=\"text-white\">Екстрена допомога</a></li>\n                            <li class=\"item-wrap\"><a href=\"Contact.html\" class=\"text-white\">Контакти</a></li>\n                            <li class=\"item-wrap\"><a href=\"https://wa.me/380637004615\" class=\"text-white\" target=\"_blank\">Підтримка у WhatsApp</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Локація</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 4\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"privacy.html\" class=\"text-white\">Політика конфіденційності</a></li>\n                            <li class=\"item-wrap\"><a href=\"usingtheweb.html\" class=\"text-white\">Умови використання</a></li>\n                            <li class=\"item-wrap\"><a href=\"impressum.html\" class=\"text-white\">Вихідні дані (Impressum)</a></li>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Офіційний сайт</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- אזור זכויות יוצרים ורשתות חברתיות -->\n            <div class=\"col-12\" mbr-if=\"showSocial || showCopy\">\n                <div class=\"copy-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://wa.me/380637004615\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-whatsapp\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"mailto:info@zusammenleben.de\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy, .social-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\">\n                        © Copyright 2026 Zusammenleben - Всі права захищені\n                    </p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "footer01-2b",
          "_isUserblock": true,
          "_cid": "vqpoIpWKp1",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "Contact.html": {
      "settings": {
        "title": "Contact us",
        "order": "13",
        "meta_descr": "",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/Contact.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/Contact.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/Contact.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/Contact.html\" />"
      },
      "components": [
        {
          "_name": "amenu1",
          "_sourceTheme": "solarm5",
          "_styles": {
            "& when (@sticky)": {
              "position": "sticky !important",
              "top": "0 !important",
              "z-index": "1030 !important",
              "width": "100%",
              "nav.navbar, .navbar-dropdown, .navbar-fixed-top": {
                "position": "relative !important"
              }
            },
            "& when not (@sticky)": {
              "position": "relative",
              "z-index": "1030",
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "body": {
              "position": "relative"
            },
            ".navbar": {
              "min-height": "80px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".navbar-logo img": {
                "width": "auto"
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-logo img": {
                  "height": "2.5rem !important"
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".container, .container-fluid": {
              "display": "flex",
              "flex-wrap": "wrap",
              "margin": "auto",
              "align-items": "center"
            },
            ".brand-container": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding-bottom": "4px",
              "padding-top": "4px",
              "width": "100%"
            },
            ".navbar-brand": {
              "min-height": "60px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "5px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              "display": "flex",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            "@media (min-width: 992px)": {
              ".brand-container": {
                "width": "auto",
                "flex-grow": "1",
                "justify-content": "flex-start"
              },
              ".navbar-brand": {
                "padding-right": "20px"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "padding-top": "10px",
                "padding-bottom": "10px",
                "display": "flex !important",
                "flex-basis": "auto",
                ".navbar-nav": {
                  "margin": "0 -0.5em",
                  "flex-grow": "1",
                  "justify-content": "flex-end"
                },
                ".mbr-section-btn": {
                  "margin-left": "auto"
                }
              },
              ".desktop-only-flex": {
                "display": "flex !important",
                "justify-content": "flex-end",
                "align-items": "center",
                "gap": "3px",
                "flex-wrap": "nowrap",
                "margin-left": "auto",
                "padding-right": "20px"
              },
              ".mobile-only": {
                "display": "none !important"
              }
            },
            "@media (max-width: 991px)": {
              ".navbar": {
                "min-height": "60px !important"
              },
              ".desktop-only-flex": {
                "display": "none !important"
              },
              ".mobile-only": {
                "display": "flex !important",
                "align-items": "center",
                "gap": "3px",
                "background": "rgba(0, 0, 0, 0.03)",
                "padding": "2px 5px",
                "border-radius": "20px",
                "border": "1px solid #eaeaea",
                "margin-left": "auto",
                "margin-right": "8px"
              },
              ".navbar-brand": {
                "flex-shrink": "initial",
                "flex-basis": "auto",
                "word-break": "break-word",
                "padding-right": "0.5rem",
                "min-height": "50px"
              },
              ".navbar-logo img": {
                "height": "2.3rem !important"
              },
              ".navbar-collapse": {
                "padding-top": "2px !important",
                "padding-bottom": "5px !important",
                "border-top": "1px solid #dddddd",
                "background": "@menuBgColor"
              },
              ".navbar-nav .nav-item": {
                "margin": "0 !important"
              },
              ".navbar-nav .nav-link": {
                "padding": "0.2rem 0.4rem !important",
                "font-size": "0.82rem !important",
                "margin": "0 !important",
                "justify-content": "center"
              },
              ".dropdown-menu .dropdown-item": {
                "padding": "0.25rem 0.8rem !important",
                "font-size": "0.78rem !important",
                "margin": "0 !important",
                "text-align": "center"
              },
              ".mbr-section-btn": {
                "display": "flex",
                "flex-wrap": "wrap",
                "justify-content": "center",
                "padding": "2px 0",
                ".btn": {
                  "padding": "0.35rem 0.8rem !important",
                  "font-size": "0.82rem !important",
                  "flex-grow": "1",
                  "margin": "4px 15px"
                }
              },
              "nav.opened .dropdown-menu": {
                "top": "0"
              }
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border-bottom": "1px solid #e6e6e6",
              "padding": "0.5rem 1.8rem",
              "transition": "all 0.25s ease-in-out",
              "&:hover, &:focus": {
                "background": "@primaryColor !important",
                "color": "white !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom": "none",
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative",
              "transition": "all 0.2s",
              "&:hover": {
                "color": "@primaryColor !important"
              }
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".navbar-buttons": {
              "text-align": "center",
              "min-width": "150px"
            },
            ".card-wrap": {
              "display": "flex",
              "align-items": "center",
              "padding": "2px 4px",
              "min-width": "auto"
            },
            ".contacts-menu .mbr-iconfont": {
              "color": "#ffffff"
            },
            ".contacts-menu .menu-divider": {
              "color": "#ccc",
              "font-weight": "300",
              "margin": "0 1px"
            },
            ".desktop-only-flex .mbr-iconfont": {
              "color": "@iconsContactColor"
            },
            ".flags-menu": {
              "display": "flex",
              "align-items": "center",
              "gap": "5px",
              "background": "rgba(0, 0, 0, 0.03)",
              "padding": "3px 8px",
              "border-radius": "20px",
              "border": "1px solid #eaeaea"
            },
            ".lang-link": {
              "display": "flex",
              "align-items": "center",
              "gap": "3px",
              "text-decoration": "none !important",
              "transition": "transform 0.2s ease",
              "&:hover": {
                "transform": "scale(1.08)"
              }
            },
            ".lang-code": {
              "font-size": "10px",
              "font-weight": "700",
              "color": "#333",
              "letter-spacing": "0.5px"
            },
            ".flag-divider": {
              "color": "#ccc",
              "font-size": "11px"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "28px",
              "height": "18px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "flex-basis": "auto",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "26px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "0",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "top": "6px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "top": "6px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "top": "12px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "6px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "6px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" global once=\"menu\">\n    <mbr-parameters>\n        <header>Розмір</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Повна ширина\" checked>\n        <header>Показати/Приховати</header>\n        <input type=\"checkbox\" title=\"Логотип\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Розмір логотипу\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Назва бренду\" name=\"showBrand\" checked>\n        <input type=\"checkbox\" title=\"Телефон\" name=\"showPhone\" checked>\n        <input type=\"checkbox\" title=\"Адреса\" name=\"showAddress\" checked>\n        <input type=\"color\" title=\"Колір іконок контактів\" name=\"iconsContactColor\" value=\"#0c2c68\" condition=\"showPhone || showAddress\">\n        <input type=\"checkbox\" title=\"Пункти меню\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Іконки\" name=\"showIcons\">\n        <select title=\"Кількість\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Колір іконок\" name=\"iconsColor\" value=\"#222222\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Кнопка\" name=\"showButtons\" checked>\n        <header>Стилі</header>\n        <input type=\"checkbox\" title=\"Закріплене\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Згорнуте\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Прозоре\" name=\"transparent\">\n        <input type=\"range\" title=\"Прозорість\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Колір\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Гамбургер\" name=\"hamburgerColor\" value=\"#222222\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                 'navbar-expand-lg':!collapsed,\n                 'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"brand-container\">\n                <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"Zusammen Leben\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                    <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-caption-wrap\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"index.html\" data-app-placeholder=\"Type Text\">Zusammen Leben</a></span>\n                </div>\n                \n                <!-- פרטי קשר + דגלים (מוצגים אך ורק במחשב) -->\n                <div class=\"contacts-menu desktop-only-flex\">\n                    <div class=\"card-wrap\">\n                        <span class=\"mobi-mbri-phone mobi-mbri\" style=\"font-size: 18px;\"></span>\n                        <div class=\"card-box\">\n                            <p class=\"mbr-text mbr-fonts-style mb-0 display-4\"><a href=\"tel:+380 63 700 4615\" class=\"text-primary\">+380 63 700 4615</a></p>\n                        </div>\n                    </div>\n                    \n                    <span class=\"menu-divider\">|</span>\n\n                    <div class=\"card-wrap\">\n                        <span class=\"mdi-maps-place\" style=\"font-size: 22px;\"></span>\n                        <div class=\"card-box\">\n                            <p class=\"mbr-text mbr-fonts-style mb-0 display-4\">Konradsreuth Alte Hofer Str. 1</p>\n                        </div>\n                    </div>\n\n                    <span class=\"menu-divider\">|</span>\n\n<div class=\"flags-menu\">\n    <a href=\"https://amit6630.github.io/ZusammenLeben/de/\" title=\"Deutsch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/de.png\" srcset=\"https://flagcdn.com/48x36/de.png 2x\" alt=\"Germany\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">DE</span>\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"https://amit6630.github.io/ZusammenLeben/\" title=\"English\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/us.png\" srcset=\"https://flagcdn.com/48x36/us.png 2x\" alt=\"United States\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">EN</span>\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"https://amit6630.github.io/ZusammenLeben/ua/\" title=\"Українська\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/ua.png\" srcset=\"https://flagcdn.com/48x36/ua.png 2x\" alt=\"Ukraine\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">UA</span>\n    </a>\n</div>\n                </div>\n\n                <!-- דגלים בלבד שיופיעו אך ורק בטלפון ליד ההמבורגר -->\n<div class=\"flags-menu mobile-only\">\n    <a href=\"https://amit6630.github.io/ZusammenLeben/de/\" title=\"Deutsch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/de.png\" alt=\"DE\" width=\"18\" height=\"13\">\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"https://amit6630.github.io/ZusammenLeben/\" title=\"English\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/us.png\" alt=\"EN\" width=\"18\" height=\"13\">\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"https://amit6630.github.io/ZusammenLeben/ua/\" title=\"Українська\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/ua.png\" alt=\"UA\" width=\"18\" height=\"13\">\n    </a>\n</div>\n\n                <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                    <div class=\"hamburger\">\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                </button>\n            </div>\n            \n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-scroll-collapse>\n                <ul class=\"navbar-nav nav-dropdown\" data-app-modern-menu=\"true\" mbr-menu><li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"index.html\" data-app-placeholder=\"Type Text\">Головна</a>\n                    </li>\n    \n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Про нас</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"social-activity.html\" data-app-placeholder=\"Type Text\">Наша діяльність</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"anna-shishoili.html\" data-app-placeholder=\"Type Text\">Анна Шишойлі</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"services.html\" data-app-placeholder=\"Type Text\">Послуги</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"request-assistance.html\" data-app-placeholder=\"Type Text\">Запит на допомогу</a>\n                    </li>\n    \n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Життя в Німеччині</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"glossary.html\" data-app-placeholder=\"Type Text\">Глосарій</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"learning-german.html\" data-app-placeholder=\"Type Text\">Вивчення німецької</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"refugee-rights.html\" data-app-placeholder=\"Type Text\">Права українських біженців</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"areasweserve.html#amenu1-1m\" data-app-placeholder=\"Type Text\">Регіони обслуговування</a>\n                    </li>\n\n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Спільнота</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"community.html\" data-app-placeholder=\"Type Text\">Наша спільнота</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"family-stories.html\" data-app-placeholder=\"Type Text\">Історії родин</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"faq.html#list01-b\" data-app-placeholder=\"Type Text\">Часті запитання</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"how-to-help.html\" data-app-placeholder=\"Type Text\">Як ви можете допомогти</a>\n                    </li>\n    \n                    <!-- Emergency - Highlighted in a separate prominent color -->\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link font-weight-bold display-4 text-primary\" href=\"emergency.html\" style=\"color: #ff3333 !important;\" data-app-placeholder=\"Type Text\">Екстрена допомога</a>\n                    </li></ul>\n                \n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary display-4\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">Зв'яжіться з нами</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
