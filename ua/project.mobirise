        {
          "_styles": {
            "@media (max-width: 767px)": {
              ".zl-clamp": {
                "max-height": "440px",
                "overflow": "hidden",
                "position": "relative"
              },
              ".zl-clamp::after": {
                "content": "\"\"",
                "position": "absolute",
                "left": "0",
                "right": "0",
                "bottom": "0",
