    "guide-violence-protection.html": {
      "settings": {
        "title": "Захист від насильства в Німеччині: допомога та гарячі лінії",
        "order": "46",
        "meta_descr": "Домашнє насильство, жіночі притулки, захисні приписи, гарячі лінії з перекладачами, допомога дітям і жертвам злочинів у Німеччині.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-violence-protection.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-violence-protection.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-violence-protection.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-violence-protection.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-violence-protection.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Захист від насильства в Німеччині: допомога та гарячі лінії\" />\n<meta property=\"og:description\" content=\"Домашнє насильство, жіночі притулки, захисні приписи, гарячі лінії з перекладачами, допомога дітям і жертвам злочинів у Німеччині.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-violence-protection.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Захист від насильства: де отримати допомогу\",\"description\":\"Домашнє насильство, жіночі притулки, захисні приписи, гарячі лінії з перекладачами, допомога дітям і жертвам злочинів у Німеччині.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-violence-protection.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-violence-protection.html\",\"wordCount\":915,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Куди телефонувати вночі, якщо я в небезпеці?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"До поліції за номером 110. Лінія 116 016 безкоштовна, анонімна й цілодобова, з перекладачками.\"}},{\"@type\":\"Question\",\"name\":\"Чи може поліція виселити партнера з квартири?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так. Поліція може наказати агресору покинути квартиру на кілька днів, навіть якщо він орендар.\"}},{\"@type\":\"Question\",\"name\":\"Чи платний жіночий притулок?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Для вас зазвичай ні: витрати переважно покриває Jobcenter чи соціальне відомство.\"}},{\"@type\":\"Question\",\"name\":\"Чи втрачу я право на перебування, якщо піду від партнера?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"З тимчасовим захистом у вас власний дозвіл. Для інших дозволів рано отримайте консультацію; особливі правила захищають жертв.\"}},{\"@type\":\"Question\",\"name\":\"Де отримати допомогу дітям?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Діти й підлітки можуть безкоштовно й анонімно телефонувати на 116 111. Jugendamt захищає дітей у небезпеці.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Захист від насильства: де отримати допомогу\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-violence-protection.html\"}]}]}</script>"
      },
