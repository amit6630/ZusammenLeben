    "guide-legal-help.html": {
      "settings": {
        "title": "Юридична допомога в Німеччині: безкоштовні консультації",
        "order": "45",
        "meta_descr": "Beratungshilfe, допомога з судовими витратами, строки, спори з орендодавцем, роботодавцем чи продавцем: де українцям отримати безкоштовну пораду.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-legal-help.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-legal-help.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-legal-help.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-legal-help.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-legal-help.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Юридична допомога в Німеччині: безкоштовні консультації\" />\n<meta property=\"og:description\" content=\"Beratungshilfe, допомога з судовими витратами, строки, спори з орендодавцем, роботодавцем чи продавцем: де українцям отримати безкоштовну пораду.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-legal-help.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Юридична допомога в Німеччині\",\"description\":\"Beratungshilfe, допомога з судовими витратами, строки, спори з орендодавцем, роботодавцем чи продавцем: де українцям отримати безкоштовну пораду.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-legal-help.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-legal-help.html\",\"wordCount\":906,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Що таке Beratungshilfe?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Допомога з оплатою консультації адвоката поза судом для людей з низьким доходом. Заява до місцевого суду, внесок не більше 15 євро.\"}},{\"@type\":\"Question\",\"name\":\"Скільки часу є на заперечення проти рішення Jobcenter?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Зазвичай один місяць після отримання. Строк указано наприкінці рішення.\"}},{\"@type\":\"Question\",\"name\":\"Чи потрібен адвокат у соціальному суді?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ні. Процес для застрахованих безкоштовний, і діяти можна без адвоката.\"}},{\"@type\":\"Question\",\"name\":\"Де отримати безкоштовну пораду щодо проблем на роботі?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Faire Integration безкоштовно консультує біженців, також українською й російською; профспілки допомагають своїм членам.\"}},{\"@type\":\"Question\",\"name\":\"Чи можна відмовитися від договору, підписаного під дверима?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Зазвичай так, протягом 14 днів, для договорів, укладених під дверима, телефоном чи онлайн.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Юридична допомога в Німеччині\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-legal-help.html\"}]}]}</script>"
      },
      "components": [
        {
          "_name": "amenu1",
          "_sourceTheme": "solarm5",
          "_styles": {
            "& when (@sticky)": {
              "position": "sticky !important",
              "top": "0 !important",
              "z-index": "1030 !important",
              "width": "100%",
              "nav.navbar, .navbar-dropdown, .navbar-fixed-top": {
                "position": "relative !important"
              }
            },
            "& when not (@sticky)": {
              "position": "relative",
              "z-index": "1030",
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "body": {
              "position": "relative"
            },
            ".navbar": {
              "min-height": "80px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".navbar-logo img": {
                "width": "auto"
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-logo img": {
                  "height": "2.5rem !important"
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".container, .container-fluid": {
              "display": "flex",
              "flex-wrap": "wrap",
              "margin": "auto",
              "align-items": "center"
            },
            ".brand-container": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding-bottom": "4px",
              "padding-top": "4px",
              "width": "100%"
            },
            ".navbar-brand": {
              "min-height": "60px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "5px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              "display": "flex",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            "@media (min-width: 992px)": {
              ".brand-container": {
                "width": "auto",
                "flex-grow": "1",
                "justify-content": "flex-start"
              },
              ".navbar-brand": {
                "padding-right": "20px"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "padding-top": "10px",
                "padding-bottom": "10px",
                "display": "flex !important",
                "flex-basis": "auto",
                ".navbar-nav": {
                  "margin": "0 -0.5em",
                  "flex-grow": "1",
                  "justify-content": "flex-end"
                },
                ".mbr-section-btn": {
                  "margin-left": "auto"
                },
                "min-width": "0"
              },
              ".desktop-only-flex": {
                "display": "flex !important",
