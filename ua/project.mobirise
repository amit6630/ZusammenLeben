              "font-size": "0.95rem",
              "color": "#475569",
              "margin-bottom": "12px",
              "line-height": "1.65"
            },
            ".guide-subcard p:last-child": {
              "margin-bottom": "0"
            },
            ".three-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(240px, 1fr))",
              "gap": "16px"
            },
            ".three-column-grid.compact-grid": {
              "margin-top": "16px"
            },
            ".guide-mini-card": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
