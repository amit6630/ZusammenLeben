        {
          "alias": false,
          "_styles": {
            ".german-guide-section": {
              "padding": "100px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.6",
              "direction": "ltr",
              "text-align": "left"
            },
            ".german-guide-section *": {
              "box-sizing": "border-box"
            },
            ".guide-container": {
              "max-width": "1000px",
              "margin": "0 auto",
              "padding": "0 24px"
            },
            ".guide-header": {
              "text-align": "center",
              "max-width": "820px",
              "margin": "0 auto 50px"
            },
            ".header-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-top": "50px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "border": "1px solid #bfdbfe"
            },
            ".header-title": {
              "font-size": "2.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.02em",
              "margin": "0 0 16px 0",
              "line-height": "1.25"
            },
            ".header-lead": {
              "font-size": "1.15rem",
              "color": "#475569",
              "margin": "0"
            },
            ".guide-block": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "36px",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.02)"
            },
            ".block-title": {
              "font-size": "1.6rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "16px",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "border-bottom": "2px solid #f1f5f9",
              "padding-bottom": "16px"
            },
            ".icon-wrapper": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "width": "40px",
              "height": "40px",
              "background": "#eff6ff",
              "color": "#2563eb",
              "border-radius": "10px",
              "flex-shrink": "0"
            },
            ".intro-text": {
              "font-size": "1.05rem",
              "color": "#475569",
              "margin-bottom": "20px"
            },
            ".benefits-grid, .cert-grid, .faq-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(300px, 1fr))",
              "gap": "20px"
            },
            ".benefit-card, .faq-card": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "padding": "20px",
              "border-radius": "12px"
            },
            ".benefit-card h4, .faq-card h4": {
              "font-size": "1.1rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin-bottom": "10px"
            },
            ".benefit-card p, .faq-card p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin": "0"
            },
            ".levels-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(250px, 1fr))",
              "gap": "16px"
            },
            ".level-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "padding": "24px",
              "border-radius": "12px",
              "position": "relative",
              "transition": "transform 0.2s ease, box-shadow 0.2s ease"
            },
            ".level-card:hover": {
              "transform": "translateY(-3px)",
              "box-shadow": "0 10px 25px rgba(0, 0, 0, 0.05)"
            },
            ".level-badge": {
              "background": "#e2e8f0",
              "color": "#334155",
              "font-weight": "800",
              "font-size": "1.2rem",
              "padding": "6px 14px",
              "border-radius": "8px",
              "display": "inline-block",
              "margin-bottom": "12px"
            },
            ".highlight-level": {
              "border": "2px solid #2563eb",
              "background": "#eff6ff"
            },
            ".target-badge": {
              "background": "#2563eb",
              "color": "#ffffff"
            },
            ".level-name": {
              "font-size": "1.15rem",
              "font-weight": "700",
              "margin-bottom": "8px",
              "color": "#0f172a"
            },
            ".level-card p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0"
            },
            ".cert-card": {
              "background": "#ffffff",
              "border": "1px solid #cbd5e1",
              "padding": "24px",
              "border-radius": "12px",
              "border-left": "5px solid #2563eb"
            },
            ".cert-title": {
              "font-size": "1.25rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "10px"
            },
            ".cert-meta": {
              "margin-top": "16px",
              "padding-top": "16px",
              "border-top": "1px solid #e2e8f0",
              "font-size": "0.9rem",
              "color": "#0f172a"
            },
            ".steps-container": {
              "display": "flex",
              "flex-direction": "column",
              "gap": "16px"
            },
            ".step-item": {
              "display": "flex",
              "align-items": "flex-start",
              "gap": "16px",
              "background": "#f8fafc",
              "padding": "16px",
              "border-radius": "10px",
              "border": "1px solid #e2e8f0"
            },
            ".step-number": {
              "background": "#2563eb",
              "color": "#ffffff",
              "font-weight": "800",
              "width": "32px",
              "height": "32px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "border-radius": "50%",
              "flex-shrink": "0"
            },
            ".step-content h4": {
              "margin": "0 0 6px 0",
              "font-size": "1.1rem",
              "font-weight": "700",
              "color": "#0f172a"
            },
            ".step-content p": {
              "margin": "0",
              "font-size": "0.95rem",
              "color": "#475569"
            },
            ".alert-box": {
              "padding": "16px 20px",
              "border-radius": "10px",
              "font-size": "0.95rem"
            },
            ".alert-box.info": {
              "background": "#eff6ff",
              "border-left": "4px solid #3b82f6",
              "color": "#1e3a8a"
            },
            ".alert-box.critical": {
              "background": "#fff1f2",
              "border": "1px solid #fecdd3",
              "border-left": "5px solid #e11d48",
              "color": "#881337"
            },
            ".alert-heading": {
              "color": "#e11d48",
              "font-weight": "800",
              "font-size": "1.15rem",
              "margin-bottom": "10px"
            },
            ".standard-list": {
              "padding-left": "20px",
              "color": "#475569",
              "font-size": "1.05rem"
            },
            ".standard-list li": {
              "margin-bottom": "10px"
            },
            ".support-box": {
              "background": "#f1f5f9",
              "border": "1px solid #e2e8f0",
              "padding": "30px",
              "border-radius": "16px",
              "text-align": "center"
            },
            ".support-box h4": {
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "10px"
            },
            ".support-box p": {
              "color": "#475569",
              "font-size": "0.95rem",
              "margin-bottom": "20px",
              "max-width": "700px",
              "margin-left": "auto",
              "margin-right": "auto"
            },
            ".sources-links": {
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "center",
              "gap": "12px"
            },
            ".source-link-btn": {
              "background": "#ffffff",
              "padding": "10px 20px",
              "border-radius": "100px",
              "font-size": "0.9rem",
              "font-weight": "700",
              "color": "#2563eb",
              "border": "2px solid #2563eb",
              "text-decoration": "none",
              "transition": "all 0.3s ease",
              "box-shadow": "0 2px 8px rgba(37, 99, 235, 0.1)",
              "display": "inline-block"
            },
            ".source-link-btn:hover": {
              "background": "#2563eb",
              "color": "#ffffff",
              "transform": "translateY(-2px)",
              "box-shadow": "0 4px 14px rgba(37, 99, 235, 0.25)",
              "text-decoration": "none"
            },
            "@media (max-width: 768px)": {
              ".header-title": {
                "font-size": "2rem"
              },
              ".guide-block": {
                "padding": "24px 20px"
              },
              ".benefits-grid, .cert-grid, .faq-grid": {
                "grid-template-columns": "1fr"
              },
              ".sources-links": {
                "flex-direction": "column",
                "gap": "10px"
              },
              ".source-link-btn": {
                "width": "100%",
                "text-align": "center"
              }
            }
          },
          "_name": "slider05",
          "_sourceTheme": "flexm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"german-guide-section\" id=\"german-integration-guide\">\n    <div class=\"guide-container container\">\n        \n        <!-- Header -->\n        <header class=\"guide-header\">\n            <span class=\"header-tag\">ОФІЦІЙНИЙ ПОСІБНИК</span>\n            <h1 class=\"header-title mbr-fonts-style display-2\"><strong>Вивчення німецької мови: Соціальна інтеграція</strong></h1>\n            <p class=\"header-lead mbr-fonts-style display-7\">\n                Рівні, сертифікати, іспити та реєстрація — повний посібник.\n            </p>\n        </header>\n\n        <!-- Why do you need a certificate -->\n        <div class=\"guide-block mb-5\">\n            <h2 class=\"block-title\">\n                <span class=\"icon-wrapper\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 21h18\"></path><path d=\"M5 21V7l7-4 7 4v14\"></path><path d=\"M9 10h6\"></path><path d=\"M9 14h6\"></path><path d=\"M9 18h6\"></path></svg>\n                </span>\n                Навіщо вам потрібен сертифікат?\n            </h2>\n            <p class=\"intro-text\">У Німеччині простої заяви «я розмовляю німецькою» недостатньо для державних органів. У більшості випадків обов'язково потрібне офіційне підтвердження у вигляді сертифіката від визнаної установи. Він знадобиться вам насамперед для:</p>\n            \n            <div class=\"benefits-grid mt-4\">\n                <div class=\"benefit-card\">\n                    <h4>Постійне проживання (Niederlassungserlaubnis)</h4>\n                    <p>У більшості випадків вимагається підтвердження володіння німецькою мовою на рівні B1, а також складання іспиту \"Leben in Deutschland\" або проходження орієнтаційного курсу.</p>\n                </div>\n                <div class=\"benefit-card\">\n                    <h4>Німецьке громадянство (Einbürgerung)</h4>\n                    <p>Заявники відповідно до Розділу 10 Закону про громадянство повинні підтвердити рівень володіння німецькою мовою B1. Примітка: тест на громадянство перевіряє знання, а не мовні навички.</p>\n                </div>\n                <div class=\"benefit-card\">\n                    <h4>Робота та навчання</h4>\n                    <p>Багато роботодавців, професійно-технічних навчальних закладів та університетів вимагають сертифікат. Визнання кваліфікацій, здобутих в Україні, часто вимагає певного рівня володіння мовою.</p>\n                </div>\n                <div class=\"benefit-card\">\n                    <h4>Завершення інтеграційного курсу</h4>\n                    <p>Сертифікат є офіційним документом, який підтверджує, що ви успішно завершили курс.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- The Six Levels -->\n        <div class=\"guide-block mb-5\">\n            <h2 class=\"block-title\">\n                <span class=\"icon-wrapper\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"></line><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"></line><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"></line><line x1=\"2\" y1=\"20\" x2=\"22\" y2=\"20\"></line></svg>\n                </span>\n                Шість рівнів (CEFR)\n            </h2>\n            <p class=\"intro-text\">Усі сертифікати в Німеччині базуються на єдиній європейській шестирівневій шкалі. Ключовим рівнем є <strong>B1</strong> — поріг для майже всіх важливих прав (постійне проживання, громадянство, професійне визнання).</p>\n            \n            <div class=\"levels-grid mt-4\">\n                <div class=\"level-card\">\n                    <div class=\"level-badge\">A1</div>\n                    <h4 class=\"level-name\">Початковий</h4>\n                    <p>Базові фрази, представлення себе, прості запитання та відповіді.</p>\n                </div>\n                <div class=\"level-card\">\n                    <div class=\"level-badge\">A2</div>\n                    <h4 class=\"level-name\">Базовий</h4>\n                    <p>Розуміння повсякденних виразів, вирішення простих побутових завдань, розуміння коротких текстів, таких як вивіски чи оголошення.</p>\n                </div>\n                <div class=\"level-card highlight-level\">\n                    <div class=\"level-badge target-badge\">B1</div>\n                    <h4 class=\"level-name\">Самостійний (Цільовий рівень)</h4>\n                    <p>Розуміння основних ідей щодо роботи та дозвілля, вирішення більшості повсякденних ситуацій, опис власного досвіду.</p>\n                </div>\n                <div class=\"level-card\">\n                    <div class=\"level-badge\">B2</div>\n                    <h4 class=\"level-name\">Просунутий</h4>\n                    <p>Ведення професійних розмов, розуміння складних текстів, робота на більшості стандартних робочих місць.</p>\n                </div>\n                <div class=\"level-card\">\n                    <div class=\"level-badge\">C1</div>\n                    <h4 class=\"level-name\">Компетентний</h4>\n                    <p>Академічне навчання, керівні посади, вільне та гнучке використання мови.</p>\n                </div>\n                <div class=\"level-card\">\n                    <div class=\"level-badge\">C2</div>\n                    <h4 class=\"level-name\">Досконалий</h4>\n                    <p>Рівень, близький до носія мови.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Which Certificate -->\n        <div class=\"guide-block mb-5\">\n            <h2 class=\"block-title\">\n                <span class=\"icon-wrapper\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"></line><polyline points=\"10 9 9 9 8 9\"></polyline></svg>\n                </span>\n                Який сертифікат підходить саме вам?\n            </h2>\n            \n            <div class=\"cert-grid mt-4\">\n                <div class=\"cert-card\">\n                    <h3 class=\"cert-title\">1. DTZ (Deutsch-Test für Zuwanderer)</h3>\n                    <p><strong>Найкраще для:</strong> Учасників інтеграційних курсів.</p>\n                    <p>Стандартний підсумковий іспит інтеграційного курсу. Він передбачає рівневу оцінку: результати коливаються від A2 до B1. Навіть якщо ви не досягнете B1 у всіх частинах, ви все одно можете отримати сертифікат A2.</p>\n                    <div class=\"cert-meta\">\n                        <span><strong>Вартість:</strong> Безкоштовно для учасників курсів (зазвичай 100-170 євро в інших випадках)</span>\n                    </div>\n                </div>\n\n                <div class=\"cert-card\">\n                    <h3 class=\"cert-title\">2. telc Deutsch</h3>\n                    <p><strong>Найкраще для:</strong> Тих, хто навчається самостійно і потребує визнаного B1.</p>\n                    <p>Відкритий для всіх бажаючих без обов'язкового проходження інтеграційного курсу. Пропонує більше дат та місць проведення іспитів. Сертифікат <em>telc C1 Hochschule</em> приймається майже всіма німецькими університетами.</p>\n                    <div class=\"cert-meta\">\n                        <span><strong>Вартість:</strong> ~120-250 євро залежно від рівня та екзаменаційного центру</span>\n                    </div>\n                </div>\n\n                <div class=\"cert-card\">\n                    <h3 class=\"cert-title\">3. Goethe-Zertifikat</h3>\n                    <p><strong>Найкраще для:</strong> Міжнародного визнання та гнучкості.</p>\n                    <p>Найбільш визнаний у світі сертифікат. Модульна структура дозволяє складати та перескладати окремі мовні навички окремо (читання, аудіювання, письмо, говоріння).</p>\n                    <div class=\"cert-meta\">\n                        <span><strong>Вартість:</strong> Залежить від модуля/рівня</span>\n                    </div>\n                </div>\n\n                <div class=\"cert-card\">\n                    <h3 class=\"cert-title\">4. ÖSD</h3>\n                    <p><strong>Найкраще для:</strong> Надійна альтернатива.</p>\n                    <p>Австрійський сертифікат, який повністю визнається в Німеччині, зокрема для отримання громадянства на рівні B1. Менш поширений у деяких регіонах, але абсолютно дійсний.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Step by step -->\n        <div class=\"guide-block mb-5\">\n            <h2 class=\"block-title\">\n                <span class=\"icon-wrapper\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 11l3 3L22 4\"></path><path d=\"M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11\"></path></svg>\n                </span>\n                Реєстрація: Крок за кроком\n            </h2>\n            <div class=\"steps-container mt-4\">\n                <div class=\"step-item\">\n                    <div class=\"step-number\">1</div>\n                    <div class=\"step-content\">\n                        <h4>Визначтеся з сертифікатом</h4>\n                        <p>Якщо ви навчаєтеся на інтеграційному курсі, ви будете складати DTZ. В іншому випадку оберіть telc або Goethe.</p>\n                    </div>\n                </div>\n                <div class=\"step-item\">\n                    <div class=\"step-number\">2</div>\n                    <div class=\"step-content\">\n                        <h4>Знайдіть екзаменаційний центр</h4>\n                        <p>Почніть з місцевого VHS (Volkshochschule). Зазвичай це найдоступніший та найвигідніший варіант.</p>\n                    </div>\n                </div>\n                <div class=\"step-item\">\n                    <div class=\"step-number\">3</div>\n                    <div class=\"step-content\">\n                        <h4>Зареєструйтеся заздалегідь</h4>\n                        <p>Реєстрація на DTZ закривається щонайменше за 4 тижні. На іспити Goethe — за 3-4 тижні. Скасування реєстрації після закінчення терміну неможливе.</p>\n                    </div>\n                </div>\n                <div class=\"step-item\">\n                    <div class=\"step-number\">4</div>\n                    <div class=\"step-content\">\n                        <h4>Підготуйте документи</h4>\n                        <p>Посвідчення особи або закордонний паспорт. Для DTZ візьміть із собою документ про право/обов'язок на участь від BAMF, Jobcenter або Ведомства у справах іноземців (Ausländerbehörde).</p>\n                    </div>\n                </div>\n                <div class=\"step-item\">\n                    <div class=\"step-number\">5</div>\n                    <div class=\"step-content\">\n                        <h4>Оплатіть збір</h4>\n                        <p>Зазвичай банківським переказом у визначений термін.</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"alert-box info mt-4\">\n                <strong>Важливе зауваження:</strong> Реєстрація на підготовчий курс НЕ є реєстрацією на самий іспит. Іспити вимагають окремої реєстрації.\n            </div>\n        </div>\n\n        <!-- Integration Course & 2026 Update -->\n        <div class=\"guide-block mb-5\">\n            <h2 class=\"block-title\">\n                <span class=\"icon-wrapper\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20.42 4.58a5.4 5.4 0 0 0-7.65 0l-.77.78-.77-.78a5.4 5.4 0 0 0-7.65 0C1.46 6.7 1.33 10.28 4 13l8 8 8-8c2.67-2.72 2.54-6.3.42-8.42z\"></path></svg>\n                </span>\n                Інтеграційний курс (фінансована програма)\n            </h2>\n            <p>Курс включає 700 годин (600 годин мови до рівня B1, 100 годин орієнтаційного курсу щодо культури та права Німеччини).</p>\n            <ul class=\"standard-list\">\n                <li><strong>Вартість:</strong> 2.29 євро за годину (~1,600 євро загалом). Якщо ви отримуєте соціальну допомогу від держави, курс зазвичай на <strong>100% безкоштовний</strong> (витрати покриває BAMF).</li>\n                <li><strong>Повернення коштів:</strong> Якщо ви успішно складете іспит протягом 2 років, ви можете повернути 50% сплаченої вами суми.</li>\n                <li><strong>Заяви на звільнення від оплати:</strong> Повинні бути подані *до* початку курсу. Звільнення заднім числом суворо обмежене.</li>\n            </ul>\n\n            <div class=\"alert-box critical mt-4\">\n                <h4 class=\"alert-heading\">⚠️ ВАЖЛИВЕ ОНОВЛЕННЯ: Статус у 2026 році для біженців з України</h4>\n                <p>Ситуація змінювалася двічі цього року. Завжди перевіряйте актуальний статус.</p>\n                <p>У лютому 2026 року BAMF призупинив надання дозволів на добровільну участь відповідно до Розділу 44(4). Однак, <strong>починаючи з 1 серпня 2026 року</strong>, нова урядова директива відновлює доступ до добровольних інтеграційних курсів для військових біженців з України та інших осіб із перспективою виходу на ринок праці.</p>\n                <p><strong>Дія:</strong> Якщо вам відмовили раніше цього року, спробуйте ще раз! Негайно зверніться до Jobcenter або BAMF.</p>\n            </div>\n        </div>\n\n        <!-- FAQ -->\n        <div class=\"guide-block mb-5\">\n            <h2 class=\"block-title\">\n                <span class=\"icon-wrapper\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg>\n                </span>\n                Поширені запитання\n            </h2>\n            <div class=\"faq-grid mt-4\">\n                <div class=\"faq-card\">\n                    <h4>Скільки часу потрібно, щоб досягти рівня B1?</h4>\n                    <p>Повний інтеграційний курс триває від 6 до 12 місяців. Інтенсивне самостійне навчання поза заняттями прискорює цей процес.</p>\n                </div>\n                <div class=\"faq-card\">\n                    <h4>Я не склав іспит. Що робити далі?</h4>\n                    <p>Для іспитів Goethe (B1+) ви перескладаєте лише той модуль, який не склали. Для DTZ у рамках інтеграційних курсів ви зазвичай отримуєте одну безкоштовну спробу перескладання.</p>\n                </div>\n                <div class=\"faq-card\">\n                    <h4>Чи дійсний мій сертифікат за 2023 рік?</h4>\n                    <p>Загалом мовні сертифікати не мають терміну придатності, але деякі відомства у справах громадянства надають перевагу сертифікатам, виданим менше ніж 5-10 років тому. Уточнюйте на місці.</p>\n                </div>\n                <div class=\"faq-card\">\n                    <h4>Чи можу я скласти іспит онлайн?</h4>\n                    <p>Ні. Стандартизовані іспити (Goethe, telc, DTZ) повинні складатися особисто в акредитованому центрі. Суто комерційні онлайн-тести зазвичай не приймаються.</p>\n                </div>\n                <div class=\"faq-card\">\n                    <h4>Чи є альтернативи складанню іспиту?</h4>\n                    <p>Так. Закінчення німецької школи (щонайменше Hauptschule) або успішне проходження визнаного професійного навчання (Ausbildung) у Німеччині звільняє від вимоги надавати сертифікат B1.</p>\n                </div>\n                <div class=\"faq-card\">\n                    <h4>Чи є догляд за дітьми під час проходження курсу?</h4>\n                    <p>Так, програма «Інтеграційний курс з доглядом за дітьми Plus» діє до кінця 2026 року, пропонуючи безкоштовний догляд за дітьми. Шукайте деталі через BAMF-NAvI.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Footer / Support & Action Buttons -->\n        <div class=\"support-box mt-5\">\n            <h4>Як ми можемо допомогти та офіційні джерела</h4>\n            <p>Ми можемо допомогти розібратися з листами від BAMF/Jobcenter, знайти екзаменаційні центри та з орієнтацією в процесі реєстрації. Однак ми не можемо впливати на результати іспитів або рішення BAMF.</p>\n            \n            <div class=\"sources-links mt-4\">\n                <a href=\"https://www.bamf.de\" target=\"_blank\" rel=\"noopener\" class=\"source-link-btn\">Портал BAMF ↗</a>\n                <a href=\"https://bamf-navi.bamf.de\" target=\"_blank\" rel=\"noopener\" class=\"source-link-btn\">Пошук BAMF-NAvI ↗</a>\n                <a href=\"https://germany4ukraine.de\" target=\"_blank\" rel=\"noopener\" class=\"source-link-btn\">Germany4Ukraine ↗</a>\n                <a href=\"https://www.goethe.de\" target=\"_blank\" rel=\"noopener\" class=\"source-link-btn\">Goethe-Institut ↗</a>\n                <a href=\"https://www.telc.net\" target=\"_blank\" rel=\"noopener\" class=\"source-link-btn\">Іспити telc ↗</a>\n            </div>\n        </div>\n\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "slider05-22",
          "_isUserblock": true,
          "_cid": "vqj4TmrZ2m",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 scalem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"50\" max=\"400\" step=\"10\" value=\"150\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Lists\" name=\"showLists\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"list\" min=\"1\" max=\"5\" step=\"1\" value=\"4\" condition=\"showLists\">\n        <input type=\"color\" title=\"List Active Color\" value=\"#ffffff\" name=\"activeList\" condition=\"showLists\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Social Active Color\" value=\"#FF5753\" name=\"active\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#635d60\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#0c2c68\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#292325\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            \n            <!-- עמודת טקסט וכותרת ראשית -->\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showTitle || showText || showButtons || showLogo\">\n                <div class=\"content-wrapper\">\n                    <!-- תוספת המקום ללוגו -->\n                    <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"Logo\">\n                        </a>\n                    </div>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>\n                        ZUSAMMENLEBEN\n                    </b></h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                        Підтримка інтеграції, пошук житла та зв'язок зі спільнотою для новоприбулих і місцевих жителів регіону.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-phone mbr-iconfont mbr-iconfont-btn\"></span>\n                            Зв'язатися з нами\n                        </a></div>\n                </div>\n            </div>\n\n            <!-- עמודות הקישורים -->\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLists\">\n                <div class=\"lists-wrapper\">\n                    <div class=\"list-wrap\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Головна</a></li>\n                            <li class=\"item-wrap\"><a href=\"family-stories.html\" class=\"text-white\">Історії родин</a></li>\n                            <li class=\"item-wrap\"><a href=\"services.html\" class=\"text-white\">Послуги</a></li>\n                            <li class=\"item-wrap\"><a href=\"request-assistance.html\" class=\"text-white\">Запит на допомогу</a></li>\n                            <li class=\"item-wrap\"><a href=\"community.html\" class=\"text-white\">Спільнота</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"living-in-germany.html\" class=\"text-white\">Життя в Німеччині</a></li>\n                            <li class=\"item-wrap\"><a href=\"glossary.html\" class=\"text-white\">Глосарій</a></li>\n                            <li class=\"item-wrap\"><a href=\"learning-german.html\" class=\"text-white\">Вивчення німецької</a></li>\n                            <li class=\"item-wrap\"><a href=\"refugee-rights.html\" class=\"text-white\">Права біженців</a></li>\n                            <li class=\"item-wrap\"><a href=\"anna-shishoili.html\" class=\"text-white\">Анна Шишашвілі</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 2\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"how-to-help.html\" class=\"text-white\">Як ви можете допомогти</a></li>\n                            <li class=\"item-wrap\"><a href=\"social-activity.html\" class=\"text-white\">Соціальна діяльність</a></li>\n                            <li class=\"item-wrap\"><a href=\"faq.html\" class=\"text-white\">Часті запитання (FAQ)</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Регіони діяльності</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 3\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"emergency.html\" class=\"text-white\">Екстрена допомога</a></li>\n                            <li class=\"item-wrap\"><a href=\"Contact.html\" class=\"text-white\">Контакти</a></li>\n                            <li class=\"item-wrap\"><a href=\"https://wa.me/380637004615\" class=\"text-white\" target=\"_blank\">Підтримка у WhatsApp</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Локація</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 4\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"privacy.html\" class=\"text-white\">Політика конфіденційності</a></li>\n                            <li class=\"item-wrap\"><a href=\"usingtheweb.html\" class=\"text-white\">Умови використання</a></li>\n                            <li class=\"item-wrap\"><a href=\"impressum.html\" class=\"text-white\">Вихідні дані (Impressum)</a></li>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Офіційний сайт</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- אזור זכויות יוצרים ורשתות חברתיות -->\n            <div class=\"col-12\" mbr-if=\"showSocial || showCopy\">\n                <div class=\"copy-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://wa.me/380637004615\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-whatsapp\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"mailto:info@zusammenleben.de\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy, .social-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\">\n                        © Copyright 2026 Zusammenleben - Всі права захищені\n                    </p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "footer01-2b",
          "_isUserblock": true,
          "_cid": "vqpoIpWKp1",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "glossary.html": {
      "settings": {
        "title": "glossary",
        "order": "8",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/glossary.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/glossary.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/glossary.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/glossary.html\" />"
      },
      "components": [
        {
          "_name": "amenu1",
          "_sourceTheme": "solarm5",
          "_styles": {
            "& when (@sticky)": {
              "position": "sticky !important",
              "top": "0 !important",
              "z-index": "1030 !important",
              "width": "100%",
              "nav.navbar, .navbar-dropdown, .navbar-fixed-top": {
                "position": "relative !important"
              }
            },
            "& when not (@sticky)": {
              "position": "relative",
              "z-index": "1030",
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "body": {
              "position": "relative"
            },
            ".navbar": {
              "min-height": "80px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".navbar-logo img": {
                "width": "auto"
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-logo img": {
                  "height": "2.5rem !important"
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".container, .container-fluid": {
              "display": "flex",
              "flex-wrap": "wrap",
              "margin": "auto",
              "align-items": "center"
            },
            ".brand-container": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding-bottom": "4px",
              "padding-top": "4px",
              "width": "100%"
            },
            ".navbar-brand": {
              "min-height": "60px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "5px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              "display": "flex",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            "@media (min-width: 992px)": {
              ".brand-container": {
                "width": "auto",
                "flex-grow": "1",
                "justify-content": "flex-start"
              },
              ".navbar-brand": {
                "padding-right": "20px"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "padding-top": "10px",
                "padding-bottom": "10px",
                "display": "flex !important",
                "flex-basis": "auto",
                ".navbar-nav": {
                  "margin": "0 -0.5em",
                  "flex-grow": "1",
                  "justify-content": "flex-end"
                },
                ".mbr-section-btn": {
                  "margin-left": "auto"
                }
              },
              ".desktop-only-flex": {
                "display": "flex !important",
                "justify-content": "flex-end",
                "align-items": "center",
                "gap": "3px",
                "flex-wrap": "nowrap",
                "margin-left": "auto",
                "padding-right": "20px"
              },
              ".mobile-only": {
                "display": "none !important"
              }
            },
            "@media (max-width: 991px)": {
              ".navbar": {
                "min-height": "60px !important"
              },
              ".desktop-only-flex": {
                "display": "none !important"
              },
              ".mobile-only": {
                "display": "flex !important",
                "align-items": "center",
                "gap": "3px",
                "background": "rgba(0, 0, 0, 0.03)",
                "padding": "2px 5px",
                "border-radius": "20px",
                "border": "1px solid #eaeaea",
                "margin-left": "auto",
                "margin-right": "8px"
              },
              ".navbar-brand": {
                "flex-shrink": "initial",
                "flex-basis": "auto",
                "word-break": "break-word",
                "padding-right": "0.5rem",
                "min-height": "50px"
              },
              ".navbar-logo img": {
                "height": "2.3rem !important"
              },
              ".navbar-collapse": {
                "padding-top": "2px !important",
                "padding-bottom": "5px !important",
                "border-top": "1px solid #dddddd",
                "background": "@menuBgColor"
              },
              ".navbar-nav .nav-item": {
                "margin": "0 !important"
              },
              ".navbar-nav .nav-link": {
                "padding": "0.2rem 0.4rem !important",
                "font-size": "0.82rem !important",
                "margin": "0 !important",
                "justify-content": "center"
              },
              ".dropdown-menu .dropdown-item": {
                "padding": "0.25rem 0.8rem !important",
                "font-size": "0.78rem !important",
                "margin": "0 !important",
                "text-align": "center"
              },
              ".mbr-section-btn": {
                "display": "flex",
                "flex-wrap": "wrap",
                "justify-content": "center",
                "padding": "2px 0",
                ".btn": {
                  "padding": "0.35rem 0.8rem !important",
                  "font-size": "0.82rem !important",
                  "flex-grow": "1",
                  "margin": "4px 15px"
                }
              },
              "nav.opened .dropdown-menu": {
                "top": "0"
              }
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border-bottom": "1px solid #e6e6e6",
              "padding": "0.5rem 1.8rem",
              "transition": "all 0.25s ease-in-out",
              "&:hover, &:focus": {
                "background": "@primaryColor !important",
                "color": "white !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom": "none",
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative",
              "transition": "all 0.2s",
              "&:hover": {
                "color": "@primaryColor !important"
              }
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".navbar-buttons": {
              "text-align": "center",
              "min-width": "150px"
            },
            ".card-wrap": {
              "display": "flex",
              "align-items": "center",
              "padding": "2px 4px",
              "min-width": "auto"
            },
            ".contacts-menu .mbr-iconfont": {
              "color": "#ffffff"
            },
            ".contacts-menu .menu-divider": {
              "color": "#ccc",
              "font-weight": "300",
              "margin": "0 1px"
            },
            ".desktop-only-flex .mbr-iconfont": {
              "color": "@iconsContactColor"
            },
            ".flags-menu": {
              "display": "flex",
              "align-items": "center",
              "gap": "5px",
              "background": "rgba(0, 0, 0, 0.03)",
              "padding": "3px 8px",
              "border-radius": "20px",
              "border": "1px solid #eaeaea"
            },
            ".lang-link": {
              "display": "flex",
              "align-items": "center",
              "gap": "3px",
              "text-decoration": "none !important",
              "transition": "transform 0.2s ease",
              "&:hover": {
                "transform": "scale(1.08)"
              }
            },
            ".lang-code": {
              "font-size": "10px",
              "font-weight": "700",
              "color": "#333",
              "letter-spacing": "0.5px"
            },
            ".flag-divider": {
              "color": "#ccc",
              "font-size": "11px"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "28px",
              "height": "18px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "flex-basis": "auto",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "26px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "0",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "top": "6px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "top": "6px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "top": "12px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "6px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "6px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" global once=\"menu\">\n    <mbr-parameters>\n        <header>Розмір</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Повна ширина\" checked>\n        <header>Показати/Приховати</header>\n        <input type=\"checkbox\" title=\"Логотип\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Розмір логотипу\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Назва бренду\" name=\"showBrand\" checked>\n        <input type=\"checkbox\" title=\"Телефон\" name=\"showPhone\" checked>\n        <input type=\"checkbox\" title=\"Адреса\" name=\"showAddress\" checked>\n        <input type=\"color\" title=\"Колір іконок контактів\" name=\"iconsContactColor\" value=\"#0c2c68\" condition=\"showPhone || showAddress\">\n        <input type=\"checkbox\" title=\"Пункти меню\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Іконки\" name=\"showIcons\">\n        <select title=\"Кількість\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Колір іконок\" name=\"iconsColor\" value=\"#222222\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Кнопка\" name=\"showButtons\" checked>\n        <header>Стилі</header>\n        <input type=\"checkbox\" title=\"Закріплене\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Згорнуте\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Прозоре\" name=\"transparent\">\n        <input type=\"range\" title=\"Прозорість\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Колір\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Гамбургер\" name=\"hamburgerColor\" value=\"#222222\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                 'navbar-expand-lg':!collapsed,\n                 'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"brand-container\">\n                <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"Zusammen Leben\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                    <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-caption-wrap\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"index.html\" data-app-placeholder=\"Type Text\">Zusammen Leben</a></span>\n                </div>\n                \n                <!-- פרטי קשר + דגלים (מוצגים אך ורק במחשב) -->\n                <div class=\"contacts-menu desktop-only-flex\">\n                    <div class=\"card-wrap\">\n                        <span class=\"mobi-mbri-phone mobi-mbri\" style=\"font-size: 18px;\"></span>\n                        <div class=\"card-box\">\n                            <p class=\"mbr-text mbr-fonts-style mb-0 display-4\"><a href=\"tel:+380 63 700 4615\" class=\"text-primary\">+380 63 700 4615</a></p>\n                        </div>\n                    </div>\n                    \n                    <span class=\"menu-divider\">|</span>\n\n                    <div class=\"card-wrap\">\n                        <span class=\"mdi-maps-place\" style=\"font-size: 22px;\"></span>\n                        <div class=\"card-box\">\n                            <p class=\"mbr-text mbr-fonts-style mb-0 display-4\">Konradsreuth Alte Hofer Str. 1</p>\n                        </div>\n                    </div>\n\n                    <span class=\"menu-divider\">|</span>\n\n<div class=\"flags-menu\">\n    <a href=\"https://amit6630.github.io/ZusammenLeben/de/\" title=\"Deutsch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/de.png\" srcset=\"https://flagcdn.com/48x36/de.png 2x\" alt=\"Germany\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">DE</span>\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"https://amit6630.github.io/ZusammenLeben/\" title=\"English\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/us.png\" srcset=\"https://flagcdn.com/48x36/us.png 2x\" alt=\"United States\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">EN</span>\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"https://amit6630.github.io/ZusammenLeben/ua/\" title=\"Українська\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/ua.png\" srcset=\"https://flagcdn.com/48x36/ua.png 2x\" alt=\"Ukraine\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">UA</span>\n    </a>\n</div>\n                </div>\n\n                <!-- דגלים בלבד שיופיעו אך ורק בטלפון ליד ההמבורגר -->\n<div class=\"flags-menu mobile-only\">\n    <a href=\"https://amit6630.github.io/ZusammenLeben/de/\" title=\"Deutsch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/de.png\" alt=\"DE\" width=\"18\" height=\"13\">\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"https://amit6630.github.io/ZusammenLeben/\" title=\"English\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/us.png\" alt=\"EN\" width=\"18\" height=\"13\">\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"https://amit6630.github.io/ZusammenLeben/ua/\" title=\"Українська\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/ua.png\" alt=\"UA\" width=\"18\" height=\"13\">\n    </a>\n</div>\n\n                <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                    <div class=\"hamburger\">\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                </button>\n            </div>\n            \n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-scroll-collapse>\n                <ul class=\"navbar-nav nav-dropdown\" data-app-modern-menu=\"true\" mbr-menu><li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"index.html\" data-app-placeholder=\"Type Text\">Головна</a>\n                    </li>\n    \n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Про нас</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"social-activity.html\" data-app-placeholder=\"Type Text\">Наша діяльність</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"anna-shishoili.html\" data-app-placeholder=\"Type Text\">Анна Шишойлі</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"services.html\" data-app-placeholder=\"Type Text\">Послуги</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"request-assistance.html\" data-app-placeholder=\"Type Text\">Запит на допомогу</a>\n                    </li>\n    \n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Життя в Німеччині</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"glossary.html\" data-app-placeholder=\"Type Text\">Глосарій</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"learning-german.html\" data-app-placeholder=\"Type Text\">Вивчення німецької</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"refugee-rights.html\" data-app-placeholder=\"Type Text\">Права українських біженців</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"areasweserve.html#amenu1-1m\" data-app-placeholder=\"Type Text\">Регіони обслуговування</a>\n                    </li>\n\n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Спільнота</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"community.html\" data-app-placeholder=\"Type Text\">Наша спільнота</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"family-stories.html\" data-app-placeholder=\"Type Text\">Історії родин</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"faq.html#list01-b\" data-app-placeholder=\"Type Text\">Часті запитання</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"how-to-help.html\" data-app-placeholder=\"Type Text\">Як ви можете допомогти</a>\n                    </li>\n    \n                    <!-- Emergency - Highlighted in a separate prominent color -->\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link font-weight-bold display-4 text-primary\" href=\"emergency.html\" style=\"color: #ff3333 !important;\" data-app-placeholder=\"Type Text\">Екстрена допомога</a>\n                    </li></ul>\n                \n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary display-4\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">Зв'яжіться з нами</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
