    "guide-house-rules-waste.html": {
      "settings": {
        "title": "Правила будинку, сортування сміття та сусіди в Німеччині",
        "order": "39",
        "meta_descr": "Час тиші, сортування сміття, провітрювання, прибирання під'їзду і добросусідство: писані та неписані правила життя в німецькій орендованій квартирі.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-house-rules-waste.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-house-rules-waste.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-house-rules-waste.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-house-rules-waste.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-house-rules-waste.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Правила будинку, сортування сміття та сусіди в Німеччині\" />\n<meta property=\"og:description\" content=\"Час тиші, сортування сміття, провітрювання, прибирання під'їзду і добросусідство: писані та неписані правила життя в німецькій орендованій квартирі.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-house-rules-waste.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Правила будинку, сортування сміття та добросусідство\",\"description\":\"Час тиші, сортування сміття, провітрювання, прибирання під'їзду і добросусідство: писані та неписані правила життя в німецькій орендованій квартирі.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-house-rules-waste.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-house-rules-waste.html\",\"wordCount\":930,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Коли діє час тиші?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Зазвичай з 22:00 до 6:00 чи 7:00, часто також в обід і цілий день у неділю та свята.\"}},{\"@type\":\"Question\",\"name\":\"Що кидати в жовтий мішок?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Пластикову, металеву та комбіновану упаковку, як-от пакети з-під напоїв. Не папір і не скло.\"}},{\"@type\":\"Question\",\"name\":\"Як позбутися старих меблів?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Як великогабаритне сміття, зазвичай за записом у службі поводження з відходами району.\"}},{\"@type\":\"Question\",\"name\":\"Як запобігти цвілі?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Кілька разів на день на кілька хвилин повністю відчиняйте вікна, особливо після готування й душу.\"}},{\"@type\":\"Question\",\"name\":\"Чи можна тримати собаку?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Часто лише за згодою орендодавця. Собаку треба зареєструвати, і за неї сплачують податок.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Правила будинку, сортування сміття та добросусідство\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-house-rules-waste.html\"}]}]}</script>"
      },
