    "guide-long-term-stay.html": {
      "settings": {
        "title": "Залишитися в Німеччині надовго після тимчасового захисту",
        "order": "49",
        "meta_descr": "Перехід з тимчасового захисту на дозвіл для роботи, навчання чи родини, постійний дозвіл і громадянство: що українці можуть підготувати вже зараз.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-long-term-stay.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-long-term-stay.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-long-term-stay.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-long-term-stay.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-long-term-stay.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Залишитися в Німеччині надовго після тимчасового захисту\" />\n<meta property=\"og:description\" content=\"Перехід з тимчасового захисту на дозвіл для роботи, навчання чи родини, постійний дозвіл і громадянство: що українці можуть підготувати вже зараз.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-long-term-stay.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Як планувати довгострокове майбутнє в Німеччині\",\"description\":\"Перехід з тимчасового захисту на дозвіл для роботи, навчання чи родини, постійний дозвіл і громадянство: що українці можуть підготувати вже зараз.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-long-term-stay.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-long-term-stay.html\",\"wordCount\":901,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Як довго діє тимчасовий захист?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Наразі до 4 березня 2027 року. Стежте за офіційними повідомленнями щодо рішень на час після цього.\"}},{\"@type\":\"Question\",\"name\":\"Чи треба змінювати дозвіл зараз?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ні. З чинним дозволом за § 24 нічого змінювати не потрібно; плануйте перехід ретельно з консультацією.\"}},{\"@type\":\"Question\",\"name\":\"Який дозвіл можливий за наявності роботи?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Часто дозвіл для фахівців або Блакитна карта ЄС, якщо кваліфікацію визнано й робота відповідає.\"}},{\"@type\":\"Question\",\"name\":\"Коли можна стати громадянином Німеччини?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Як правило, після п'яти років законного перебування, з німецькою B1, тестом і забезпеченим утриманням.\"}},{\"@type\":\"Question\",\"name\":\"Що можна зробити вже сьогодні?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Вчити німецьку, визнати диплом, працювати за належним договором і тримати документи чинними.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Як планувати довгострокове майбутнє в Німеччині\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-long-term-stay.html\"}]}]}</script>"
      },
