    "guide-disability.html": {
      "settings": {
        "title": "Інвалідність у Німеччині: посвідчення, права та підтримка",
        "order": "44",
        "meta_descr": "Посвідчення інвалідності, ступінь GdB, безкоштовний проїзд, допомога дітям, робота й безкоштовні консультації для українських родин.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-disability.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-disability.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-disability.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-disability.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-disability.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Інвалідність у Німеччині: посвідчення, права та підтримка\" />\n<meta property=\"og:description\" content=\"Посвідчення інвалідності, ступінь GdB, безкоштовний проїзд, допомога дітям, робота й безкоштовні консультації для українських родин.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-disability.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Життя з інвалідністю в Німеччині\",\"description\":\"Посвідчення інвалідності, ступінь GdB, безкоштовний проїзд, допомога дітям, робота й безкоштовні консультації для українських родин.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-disability.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-disability.html\",\"wordCount\":935,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Чи діє моя українська група інвалідності в Німеччині?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Не автоматично. Потрібне нове німецьке оцінювання; українські медичні документи допомагають.\"}},{\"@type\":\"Question\",\"name\":\"Куди звертатися в Баварії?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"До Баварського центру у справах родини та соціальних питань (ZBFS), регіональний відділ Верхньої Франконії.\"}},{\"@type\":\"Question\",\"name\":\"З якого GdB видають посвідчення?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"З GdB 50 ви вважаєтеся особою з тяжкою інвалідністю й отримуєте посвідчення.\"}},{\"@type\":\"Question\",\"name\":\"Чи можна їздити автобусом безкоштовно?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"З певними позначками, як-от G, і маркою (Wertmarke) місцевий транспорт безкоштовний чи дешевший.\"}},{\"@type\":\"Question\",\"name\":\"Де отримати безкоштовну консультацію?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"У центрах незалежних консультацій з участі (EUTB), безкоштовно й незалежно від установ.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Життя з інвалідністю в Німеччині\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-disability.html\"}]}]}</script>"
      },
