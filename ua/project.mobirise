        },
        {
          "_name": "footer4",
          "_sourceTheme": "restaurantm4",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "*:focus": {
              "outline": "none",
              "box-shadow": "none"
            },
            ".form-control": {
              "width": "100%",
              "background": "@inputBg",
              "border-radius": "0 !important",
              "border": "none !important",
              "min-height": "47px",
              "&::-webkit-input-placeholder": {
                "color": "contrast(@inputBg)"
              },
              "&::-moz-placeholder": {
                "color": "contrast(@inputBg)"
              },
              "&:-ms-input-placeholder": {
                "color": "contrast(@inputBg)"
              },
              "&:-moz-placeholder": {
                "color": "contrast(@inputBg)"
              }
            },
            "input.form-control": {
              "padding": "0.5rem"
            },
            ".soc-item": {
              "display": "inline-block",
              "margin": "0 0.1rem 0.2rem 0.1rem",
              "padding": "10px 11px 0 11px",
              "border": "2px solid @iconsColor !important",
              "border-radius": "50% !important",
              "&:hover": {
                "opacity": "0.5"
              },
              ".socicon": {
                "font-size": "1.5rem",
                "color": "@iconsColor"
              }
            },
            ".days-column, .hours-column": {
              "display": "inline-block",
              "span": {
                "display": "block"
              }
            },
            ".logo": {
              "img": {
                "width": "auto",
                "display": "inline-block"
              }
            },
            "@media (max-width: 767px)": {
              ".days-column": {
                "padding-right": "0 !important"
              },
              ".hours-column": {
                "max-width": "50% !important"
              },
              ".opening-hours": {
                "padding-bottom": "48px !important"
              },
              ".services-grid, .team-grid, .transparency-grid, .pillars-grid, .three-column-grid, .grid-3, .grid-2, .faq-grid, .survival-grid, .portal-grid-2, .city-directory-grid, .details-cards-stack, .two-column-grid, .levels-grid, .cert-grid, .benefits-grid, .links-grid, .timeline-wrapper": {
                "display": "flex !important",
                "flex-wrap": "nowrap !important",
                "flex-direction": "row !important",
                "grid-template-columns": "none !important",
                "gap": "12px !important",
                "overflow-x": "auto",
                "overscroll-behavior-x": "contain",
                "scroll-snap-type": "x mandatory",
                "padding": "4px 2px 14px !important",
                "scrollbar-width": "none"
              },
              ".services-grid::-webkit-scrollbar, .team-grid::-webkit-scrollbar, .transparency-grid::-webkit-scrollbar, .pillars-grid::-webkit-scrollbar, .three-column-grid::-webkit-scrollbar, .grid-3::-webkit-scrollbar, .grid-2::-webkit-scrollbar, .faq-grid::-webkit-scrollbar, .survival-grid::-webkit-scrollbar, .portal-grid-2::-webkit-scrollbar, .city-directory-grid::-webkit-scrollbar, .details-cards-stack::-webkit-scrollbar, .two-column-grid::-webkit-scrollbar, .levels-grid::-webkit-scrollbar, .cert-grid::-webkit-scrollbar, .benefits-grid::-webkit-scrollbar, .links-grid::-webkit-scrollbar, .timeline-wrapper::-webkit-scrollbar": {
                "display": "none"
              },
              ".services-grid > *, .team-grid > *, .transparency-grid > *, .pillars-grid > *, .three-column-grid > *, .grid-3 > *, .grid-2 > *, .faq-grid > *, .survival-grid > *, .portal-grid-2 > *, .city-directory-grid > *, .details-cards-stack > *, .two-column-grid > *, .levels-grid > *, .cert-grid > *, .benefits-grid > *, .links-grid > *, .timeline-wrapper > *": {
                "flex": "0 0 84% !important",
                "max-width": "84% !important",
                "min-width": "0",
                "margin": "0 !important",
                "scroll-snap-align": "start"
              },
              ".timeline-wrapper::before": {
                "display": "none !important"
              },
              ".metrics-section, .services-section, .process-section, .region-section, .team-section, .transparency-section, .cta-section": {
                "padding-top": "44px !important",
                "padding-bottom": "44px !important"
              },
              ".metrics-grid": {
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr) !important",
                "gap": "10px !important"
              },
              ".word-grid": {
                "max-height": "62vh",
                "overflow-y": "auto",
                "overscroll-behavior": "contain",
                "padding-right": "4px"
              },
              ".metrics-grid > *": {
                "min-width": "0",
                "padding": "18px 10px !important"
              },
              ".metrics-grid .metric-value": {
                "font-size": "2rem !important"
              },
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            },
            ".form-title, .btn-row": {
              "color": "#0c2c68"
            },
            ".follow-title, .social-list, .logo": {
              "color": "#0c2c68"
            },
            ".address-title, .address-block": {
              "color": "#0c2c68"
            },
            ".hours-column": {
              "color": "#0c2c68"
            },
            ".opening-hours-title, .opening-hours": {
              "color": "#0c2c68"
            },
            ".contacts-title, .contacts-block": {
              "color": "#0c2c68",
              "text-align": "center"
            },
            "LABEL": {
              "color": "#0c2c68"
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            },
            "@media (max-width: 575px)": {
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            "@media (max-width: 991px)": {
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer4 restaurantm4_footer4\" group=\"Footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"1\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n\t\t<input type=\"range\" title=\"Logo\" inline name=\"logoSize\" min=\"5\" max=\"13\" step=\"0.1\" value=\"8\" condition=\"showLogo\">\n\t\t<select title=\"Icons\" name=\"iconsCount\" condition=\"showIcons\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t</select>\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n\t\t<input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#0c2c68\" condition=\"showIcons\">\n\t\t<input type=\"checkbox\" title=\"Address\" name=\"showAddress\">\n\t\t<input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n\t\t<input type=\"checkbox\" title=\"Opening Hours\" name=\"showOpeningHours\">\n\t\t<input type=\"checkbox\" title=\"Form\" name=\"showForm\" checked>\n\t\t<input type=\"color\" title=\"Input Bg\" name=\"inputBg\" value=\"#ffffff\" condition=\"showForm\">\n\t\t<input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background8.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#f7f7f7\" selected>\n\t\t</fieldset>\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t<input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row content justify-content-center align-items-start mbr-white\">\n\t\t\t<div class=\"col-12 col-md-6 col-lg-4 pb-3\" mbr-if=\"showLogo || showAddress || showContacts || showIcons\">\n\t\t\t\t<div class=\"address\" mbr-if=\"showAddress\">\n\t\t\t\t\t<h3 class=\"address-title mbr-fonts-style pb-2 align-center\" mbr-theme-style=\"display-5\" data-app-selector=\".address-title, .address-block\">Зв'язатися з нами</h3>\n\t\t\t\t\t<p class=\"address-block mbr-fonts-style pb-3 align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".address-title, .address-block\">\n\t\t\t\t\t\tKonradsreuth Alte Hofer Str. 1<br>\n\t\t\t\t\t\tНімеччина\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"contacts\" mbr-if=\"showContacts\">\n\t\t\t\t\t<h3 class=\"contacts-title mbr-fonts-style pb-2 align-center\" mbr-theme-style=\"display-5\" data-app-selector=\".contacts-title, .contacts-block\"><b>Зв'язатися з нами</b></h3>\n\t\t\t\t\t<p class=\"contacts-block mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".contacts-title, .contacts-block\">Для підтримки<br><a href=\"tel:+380637004615\" class=\"text-primary\">+380 63 700 4615</a><br><br>Konradsreuth Alte Hofer Str. 1 ⚲\n<br><br><a href=\"mailto:kotovaanna101010@gmail.com\" class=\"text-primary\">kotovaanna101010@gmail.com ✉&nbsp;</a><br><br></p>\n\t\t\t\t</div>\n                <div class=\"social-list pb-3 align-center\" mbr-if=\"showIcons\">\n\t\t\t\t\t<div class=\"soc-item\">\n\t\t\t\t\t\t<a href=\"#\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-whatsapp socicon\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 1\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-facebook socicon\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 2\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 3\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"socicon-instagram socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 4\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"socicon-googleplus socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 5\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\" rel=\"noopener\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"socicon-behance socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"form-1 col-sm-12 col-md-5 col-xl-4\" mbr-class=\"{'col-lg-4': !showOpeningHours || (!showLogo && !showIcons && !showContacts && !showAddress), \n\t\t\t\t'col-lg-3': showOpeningHours && (showLogo || showIcons || showContacts || showAddress)}\" mbr-if=\"showForm\">\n\t\t\t\t<h3 class=\"form-title pb-3 mbr-fonts-style align-center\" mbr-theme-style=\"display-5\" data-app-selector=\".form-title, .btn-row\"><b>Зв'яжіться з нами</b></h3>\n                <div mbr-form>\n<!--Formbuilder Form-->\n<form action=\"kotovaanna101010@gmail.com\" name=\"My Mobirise Form\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"kotovaanna101010@gmail.com\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Дякуємо за заповнення форми!</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">\n</div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-lg-6 col-md-12 col-sm-12 form-group\" data-for=\"tel\" style>\n<input type=\"tel\" name=\"tel\" placeholder=\"*Телефон\" data-form-field=\"tel\" mbr-theme-style=\"display-7\" required=\"required\" style=\"text-align:left\" class=\"form-control\" value>\n</div>\n<div class=\"col-lg-6 col-md-12 col-sm-12 form-group\" data-for=\"full name\">\n<input type=\"text\" name=\"full name\" data-form-field=\"full name\" style=\"text-align:left\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" placeholder=\"*Повне ім'я\" value>\n</div>\n<div data-for=\"email\" class=\"col-md-12 form-group mb-3 \">\n<input type=\"text\" name=\"email\" placeholder=\"Електронна пошта\" style=\"text-align:left\" data-form-field=\"E-mail\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value>\n</div>\n<div data-for=\"message\" class=\"col-md-12 form-group mb-3 pb-2\">\n<textarea name=\"message\" placeholder=\"Як ми можемо вам допомогти?\" data-form-field=\"Message\" style=\"text-align:left\" mbr-theme-style=\"display-7\" class=\"form-control\"></textarea>\n</div>\n    <div class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<div class=\"form-control-label\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"checkbox\" class=\"mbr-fonts-style\">\n</label>\n</div>\n<div data-for=\"I agree to the terms and conditions and privacy policy\" class=\"form-check ms-2\">\n  <input type=\"checkbox\" value=\"Yes\" name=\"I agree to the terms and conditions and privacy policy\" data-form-field=\"I agree to the terms and conditions\" mbr-theme-style=\"display-7\" class=\"form-check-input\" required=\"required\">\n  <label mbr-text for=\"I agree to the terms and conditions and privacy policy\" mbr-theme-style=\"display-7\" class=\"form-check-label\">\n    Я погоджуюся з <a href=\"usingtheweb.html\" class=\"text-black\">Умовами використання</a> та <a href=\"privacy.html\" class=\"text-black\">Політикою конфіденційності</a>\n  </label>\n</div>\n\n</div>\n<div class=\"col-md-12 input-group-btn align-center \" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"w-100 btn btn-form btn-primary\" data-app-placeholder=\"Type Text\">Надіслати</a></div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\t\t\t</div>\n\n\t\t\t<div class=\"col-sm-12 col-md-6 col-lg-5 col-xl-4 opening-hours pb-3 align-center\" mbr-if=\"showOpeningHours\">\n\t\t\t\t<div class=\"logo pb-3 align-center\" mbr-if=\"showLogo\">\n\t\t\t\t\t<a href=\"https://mobiri.se\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-327x327.png\" alt=\"ZusammenLeben\" mbr-style=\"{'height': logoSize + 'rem'}\">\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n            <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\">\n                    <a class=\"nav-link link text-primary\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Часті запитання (FAQ)</a>\n                </li></ul>\n        </div>\n\t\t</div>\n\t</div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "footer4-19",
          "_isUserblock": true,
          "_cid": "vqcVLCsuXG",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            },
            "a[href*=\"thebwas.com\"]": {
              "text-decoration": "underline",
              "text-underline-offset": "3px"
            },
            ".soc-item a": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-width": "44px",
              "min-height": "44px"
            },
            ".item-wrap a": {
              "word-break": "normal !important",
              "overflow-wrap": "normal !important",
              "hyphens": "auto",
              "-webkit-hyphens": "auto"
            },
            "@media (max-width: 767px)": {
              ".lists-wrapper": {
                "display": "grid !important",
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr)",
                "column-gap": "16px"
              },
              ".lists-wrapper .list-wrap": {
                "width": "auto !important",
                "max-width": "none !important",
                "margin": "0 !important"
              },
              ".lists-wrapper .item-wrap a": {
                "overflow-wrap": "break-word !important"
              }
            },
            "@media (min-width: 768px)": {
              ".lists-wrapper": {
                "display": "grid !important",
                "grid-template-columns": "repeat(4, minmax(0, 1fr))",
                "column-gap": "16px"
              },
              ".lists-wrapper .list-wrap": {
                "width": "auto !important",
                "max-width": "none !important",
                "margin": "0 !important",
                "min-width": "0"
              },
              ".lists-wrapper .item-wrap a": {
                "overflow-wrap": "break-word !important"
              }
            }
          },
          "_name": "footer01",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 scalem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"50\" max=\"400\" step=\"10\" value=\"150\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Lists\" name=\"showLists\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"list\" min=\"1\" max=\"5\" step=\"1\" value=\"4\" condition=\"showLists\">\n        <input type=\"color\" title=\"List Active Color\" value=\"#ffffff\" name=\"activeList\" condition=\"showLists\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Social Active Color\" value=\"#FF5753\" name=\"active\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#635d60\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#0c2c68\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#292325\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            \n            <!-- עמודת טקסט וכותרת ראשית -->\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showTitle || showText || showButtons || showLogo\">\n                <div class=\"content-wrapper\">\n                    <!-- תוספת המקום ללוגו -->\n                    <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"ZusammenLeben\" width=\"171\" height=\"171\">\n                        </a>\n                    </div>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>\n                        ZUSAMMENLEBEN\n                    </b></h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                        Підтримка інтеграції, пошук житла та зв'язок зі спільнотою для новоприбулих і місцевих жителів регіону.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-phone mbr-iconfont mbr-iconfont-btn\"></span>\n                            Зв'язатися з нами\n                        </a></div>\n                </div>\n            </div>\n\n            <!-- עמודות הקישורים -->\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLists\">\n                <div class=\"lists-wrapper\">\n                    <div class=\"list-wrap\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Головна</a></li>\n                            <li class=\"item-wrap\"><a href=\"family-stories.html\" class=\"text-white\">Історії родин</a></li>\n                            <li class=\"item-wrap\"><a href=\"services.html\" class=\"text-white\">Послуги</a></li>\n                            <li class=\"item-wrap\"><a href=\"request-assistance.html\" class=\"text-white\">Запит на допомогу</a></li>\n                            <li class=\"item-wrap\"><a href=\"community.html\" class=\"text-white\">Спільнота</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"living-in-germany.html\" class=\"text-white\">Життя в Німеччині</a></li>\n                            <li class=\"item-wrap\"><a href=\"glossary.html\" class=\"text-white\">Глосарій</a></li>\n                            <li class=\"item-wrap\"><a href=\"learning-german.html\" class=\"text-white\">Вивчення німецької</a></li>\n                            <li class=\"item-wrap\"><a href=\"refugee-rights.html\" class=\"text-white\">Права біженців</a></li>\n                            <li class=\"item-wrap\"><a href=\"guides.html\" class=\"text-white\">Посібники</a></li>\n                            <li class=\"item-wrap\"><a href=\"anna-shishoili.html\" class=\"text-white\">Анна Чеішвілі</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 2\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"how-to-help.html\" class=\"text-white\">Як ви можете допомогти</a></li>\n                            <li class=\"item-wrap\"><a href=\"social-activity.html\" class=\"text-white\">Соціальна діяльність</a></li>\n                            <li class=\"item-wrap\"><a href=\"faq.html\" class=\"text-white\">Часті запитання (FAQ)</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Регіони діяльності</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 3\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"emergency.html\" class=\"text-white\">Екстрена допомога</a></li>\n                            <li class=\"item-wrap\"><a href=\"Contact.html\" class=\"text-white\">Контакти</a></li>\n                            <li class=\"item-wrap\"><a href=\"https://wa.me/380637004615\" class=\"text-white\" target=\"_blank\" rel=\"noopener\">Підтримка у WhatsApp</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Локація</a></li>\n                            <li class=\"item-wrap\"><a href=\"impressum.html\" class=\"text-white\">Вихідні дані</a></li>\n                            <li class=\"item-wrap\"><a href=\"privacy.html\" class=\"text-white\">Політика конфіденційності</a></li>\n                            <li class=\"item-wrap\"><a href=\"usingtheweb.html\" class=\"text-white\">Умови використання</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 4\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"privacy.html\" class=\"text-white\">Політика конфіденційності</a></li>\n                            <li class=\"item-wrap\"><a href=\"usingtheweb.html\" class=\"text-white\">Умови використання</a></li>\n                            <li class=\"item-wrap\"><a href=\"impressum.html\" class=\"text-white\">Вихідні дані (Impressum)</a></li>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Офіційний сайт</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- אזור זכויות יוצרים ורשתות חברתיות -->\n            <div class=\"col-12\" mbr-if=\"showSocial || showCopy\">\n                <div class=\"copy-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://wa.me/380637004615\" target=\"_blank\" rel=\"noopener\" aria-label=\"WhatsApp\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-whatsapp\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"mailto:zusammenleben.de@gmail.com\" aria-label=\"E-Mail\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy, .social-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\">\n                        © Copyright 2026 Zusammenleben - Всі права захищені · Сайт створив <a href=\"https://thebwas.com/\" class=\"text-white\">Amit Shechter</a>\n                    </p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
