        "meta_descr": "Як ZusammenLeben обробляє персональні дані на zusammenleben-ukraine.de: форма зв'язку, WhatsApp, хостинг, шрифти та ваші права за GDPR.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/privacy.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/privacy.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/privacy.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/privacy.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/privacy.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Політика конфіденційності | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"Як ZusammenLeben обробляє персональні дані на zusammenleben-ukraine.de: форма зв'язку, WhatsApp, хостинг, шрифти та ваші права за GDPR.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/privacy.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"url\":\"https://zusammenleben-ukraine.de/ua/privacy.html\",\"name\":\"Політика конфіденційності\",\"inLanguage\":\"uk\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Політика конфіденційності\",\"item\":\"https://zusammenleben-ukraine.de/ua/privacy.html\"}]}]}</script>"
