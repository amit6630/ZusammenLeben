              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "20px"
            },
            ".guide-subcard": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "28px",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.02)"
