    "guide-clubs-volunteering.html": {
      "settings": {
        "title": "Клуби та волонтерство в Німеччині: знайдіть спільноту",
        "order": "42",
        "meta_descr": "Спортивні клуби, музика, хори, пожежна команда, церковні групи та волонтерство: як українські родини у Верхній Франконії знаходять друзів і вчать німецьку.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-clubs-volunteering.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-clubs-volunteering.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-clubs-volunteering.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-clubs-volunteering.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-clubs-volunteering.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Клуби та волонтерство в Німеччині: знайдіть спільноту\" />\n<meta property=\"og:description\" content=\"Спортивні клуби, музика, хори, пожежна команда, церковні групи та волонтерство: як українські родини у Верхній Франконії знаходять друзів і вчать німецьку.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-clubs-volunteering.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Клуби та волонтерство: знайдіть своє місце\",\"description\":\"Спортивні клуби, музика, хори, пожежна команда, церковні групи та волонтерство: як українські родини у Верхній Франконії знаходять друзів і вчать німецьку.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-clubs-volunteering.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-clubs-volunteering.html\",\"wordCount\":915,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Чи можна волонтерити з дозволом §24?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так. Волонтерство дозволене. Повідомляйте Jobcenter про компенсації витрат, якщо отримуєте виплати.\"}},{\"@type\":\"Question\",\"name\":\"Хто платить за спортивний клуб дитини?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Пакет освіти й участі оплачує щомісячну суму, якщо ваша родина отримує виплати.\"}},{\"@type\":\"Question\",\"name\":\"Чи потрібна добра німецька, щоб вступити до клубу?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ні. Клуби — чудове місце для вивчення німецької. Більшість тепло приймають нових учасників.\"}},{\"@type\":\"Question\",\"name\":\"Чи можуть дорослі вступити до добровільної пожежної команди?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так, після базового навчання. Діти й підлітки можуть приєднатися до молодіжної пожежної команди.\"}},{\"@type\":\"Question\",\"name\":\"Як знайти клуби поблизу?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"На сайті громади, на дошках оголошень, у місцевій газеті або запитайте в школі та в сусідів.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Клуби та волонтерство: знайдіть своє місце\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-clubs-volunteering.html\"}]}]}</script>"
      },
