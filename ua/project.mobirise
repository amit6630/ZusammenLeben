              "color": "#166534"
            },
            ".guide-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "32px",
              "margin-bottom": "20px",
              "box-shadow": "0 4px 20px rgba(0, 0, 0, 0.03)",
              "width": "100%"
            },
            ".cta-box": {
              "text-align": "center",
              "margin-top": "10px",
              "padding": "40px 32px",
