    "guide-child-benefit.html": {
      "settings": {
        "title": "Допомога на дітей і сімейні виплати для українців",
        "order": "31",
        "meta_descr": "Kindergeld, дитяча доплата, батьківська допомога та шкільна підтримка: які сімейні виплати отримують українські родини в Німеччині і як подати заяву.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-child-benefit.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-child-benefit.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-child-benefit.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-child-benefit.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-child-benefit.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Допомога на дітей і сімейні виплати для українців\" />\n<meta property=\"og:description\" content=\"Kindergeld, дитяча доплата, батьківська допомога та шкільна підтримка: які сімейні виплати отримують українські родини в Німеччині і як подати заяву.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-child-benefit.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Допомога на дітей і сімейні виплати в Німеччині\",\"description\":\"Kindergeld, дитяча доплата, батьківська допомога та шкільна підтримка: які сімейні виплати отримують українські родини в Німеччині і як подати заяву.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-child-benefit.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-child-benefit.html\",\"wordCount\":919,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Чи можуть українці з §24 отримувати Kindergeld?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так. Батьки з дозволом на проживання за §24 можуть отримувати Kindergeld. Заяву подають до сімейної каси.\"}},{\"@type\":\"Question\",\"name\":\"Чи зменшує Kindergeld виплати від Jobcenter?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так. Він зараховується як дохід дитини, але подавати заяву все одно треба.\"}},{\"@type\":\"Question\",\"name\":\"За який період Kindergeld виплачують заднім числом?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Зазвичай до шести місяців до місяця подання. Подавайте заяву рано.\"}},{\"@type\":\"Question\",\"name\":\"Що таке дитяча доплата?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Додаткова виплата для працюючих батьків, чийого доходу не вистачає на дітей. Вона також відкриває доступ до шкільної підтримки.\"}},{\"@type\":\"Question\",\"name\":\"Хто виплачує Elterngeld у Баварії?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Баварський центр у справах родини та соціальних питань (ZBFS). Звертайтеся рано, найкраще під час вагітності.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Допомога на дітей і сімейні виплати в Німеччині\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-child-benefit.html\"}]}]}</script>"
      },
