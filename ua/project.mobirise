              "color": "#475569",
              "margin": "0"
            },
            ".notice-callout": {
              "max-width": "850px",
              "margin": "0 auto",
              "background": "#fff1f2",
              "border": "1px solid #fecdd3",
              "border-left": "5px solid #e11d48",
              "padding": "24px",
              "border-radius": "16px",
              "display": "flex",
              "gap": "16px",
              "align-items": "center"
            },
            ".notice-icon": {
              "font-size": "1.8rem"
            },
            ".notice-text": {
              "font-size": "0.95rem",
              "color": "#881337"
            },
            ".region-section": {
              "padding": "100px 0",
              "background": "#ffffff"
            },
            ".pills-cloud": {
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "center",
              "gap": "12px",
              "max-width": "900px",
              "margin": "0 auto 40px"
            },
            ".city-pill": {
              "background": "#f1f5f9",
              "border": "1px solid #e2e8f0",
              "color": "#334155",
              "padding": "10px 22px",
              "border-radius": "100px",
              "font-weight": "600",
              "font-size": "0.95rem",
              "transition": "all 0.2s ease"
            },
            ".city-pill:hover": {
              "background": "#e2e8f0"
            },
            ".city-pill.highlighted": {
              "border-color": "#bfdbfe",
              "background": "#eff6ff",
              "color": "#1d4ed8"
            },
            ".city-pill.highlighted:hover": {
              "background": "#dbeafe"
            },
            ".city-pill.info-tag": {
              "background": "#2563eb",
              "color": "#ffffff",
              "border": "none"
            },
            ".city-pill.info-tag:hover": {
              "background": "#1d4ed8"
            },
            ".region-focus-card": {
              "max-width": "850px",
              "margin": "0 auto",
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "padding": "35px",
              "border-radius": "20px",
              "text-align": "center"
            },
            ".region-focus-card h3": {
              "font-size": "1.35rem",
              "color": "#0f172a",
              "font-weight": "700",
              "margin-bottom": "15px"
            },
            ".region-focus-card p": {
              "color": "#475569",
              "font-size": "1.05rem",
              "margin-bottom": "10px"
            },
            ".team-section": {
              "padding": "80px 16px",
              "background": "#f8fafc",
              "border-top": "1px solid #e2e8f0"
            },
            ".team-section .portal-container": {
              "max-width": "800px"
            },
            ".team-grid": {
              "display": "grid",
              "grid-template-columns": "1fr",
              "gap": "20px",
              "max-width": "1000px",
              "margin": "0 auto"
            },
            ".team-profile-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "padding": "24px",
              "border-radius": "16px",
              "display": "flex",
              "gap": "20px",
              "align-items": "flex-start",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.03)"
            },
            ".team-avatar": {
              "width": "75px",
              "height": "75px",
              "border-radius": "50%",
              "object-fit": "cover",
              "flex-shrink": "0",
              "border": "3px solid #f1f5f9"
            },
            ".team-info": {
              "flex": "1"
            },
            ".team-info h3": {
              "font-size": "1.15rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 6px 0"
            },
            ".role-pill": {
              "display": "inline-block",
              "font-size": "0.75rem",
              "font-weight": "700",
              "color": "#475569",
              "text-transform": "uppercase",
              "margin-bottom": "10px",
              "padding": "4px 10px",
              "background": "#f1f5f9",
              "border-radius": "12px",
              "letter-spacing": "0.5px"
            },
            ".role-pill.manager": {
              "color": "#2563eb",
              "background": "#eff6ff"
            },
            ".team-info p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.5"
            },
            ".transparency-section": {
              "padding": "100px 0",
              "background": "#ffffff"
            },
            ".transparency-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "30px",
              "max-width": "950px",
              "margin": "0 auto"
            },
            ".matrix-card": {
              "background": "#ffffff",
              "border-radius": "24px",
              "padding": "40px",
              "border": "1px solid #e2e8f0",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.04)"
            },
            ".free-card": {
              "border-top": "6px solid #16a34a"
            },
            ".external-card": {
              "border-top": "6px solid #d97706"
            },
            ".matrix-status": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#16a34a",
              "letter-spacing": "1px"
            },
            ".matrix-status.warning": {
              "color": "#d97706"
            },
            ".matrix-header h3": {
              "font-size": "1.35rem",
              "color": "#0f172a",
              "font-weight": "800",
              "margin-top": "6px",
              "margin-bottom": "24px"
            },
            ".matrix-list": {
              "list-style": "none",
              "padding": "0",
              "margin": "0 0 20px 0"
            },
            ".matrix-list li": {
              "font-size": "1rem",
              "color": "#334155",
              "margin-bottom": "14px",
              "display": "flex",
              "gap": "12px"
            },
            ".matrix-list li span": {
              "color": "#16a34a",
              "font-weight": "bold"
            },
            ".matrix-list.warning-list li span": {
              "color": "#d97706"
            },
            ".matrix-footer-note": {
              "font-size": "0.85rem",
              "color": "#64748b",
              "margin": "0"
            },
            ".cta-section": {
              "padding": "100px 0",
              "background": "#f8fafc",
              "border-top": "1px solid #e2e8f0"
            },
            ".cta-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "30px"
            },
            ".cta-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "padding": "45px",
              "border-radius": "28px",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.04)"
            },
            ".cta-families": {
              "background": "linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%)",
              "border-color": "#bae6fd"
            },
            ".cta-supporters": {
              "background": "linear-gradient(135deg, #ffffff 0%, #f8fafc 100%)"
            },
            ".cta-badge": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "1.2px"
            },
            ".cta-card h3": {
              "font-size": "1.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "10px 0 14px"
            },
            ".cta-card p": {
              "color": "#475569",
              "font-size": "1.05rem",
              "margin-bottom": "30px"
            },
            ".cta-card .mbr-section-btn": {
              "justify-content": "flex-start",
              "margin-bottom": "0"
            },
            "@media (max-width: 992px)": {
              ".hero-title": {
                "font-size": "2.8rem"
              },
              ".manifesto-card": {
                "padding": "35px"
              },
              ".services-section, .process-section, .region-section, .transparency-section, .cta-section": {
                "padding": "80px 0"
              }
            },
            "@media (max-width: 768px)": {
              ".mobirise-home-section .portal-container": {
                "padding-left": "16px !important",
                "padding-right": "16px !important"
              },
              ".services-section, .process-section, .region-section, .transparency-section, .cta-section": {
                "padding": "60px 0"
              },
              ".hero-wrapper": {
                "padding": "60px 0 50px"
              },
              ".hero-title": {
                "font-size": "2.2rem"
              },
              ".section-main-title": {
                "font-size": "2rem"
              }
            },
            "@media (max-width: 640px)": {
              ".hero-title": {
                "font-size": "1.9rem"
              },
              ".mobirise-home-section .btn": {
                "width": "100% !important",
                "justify-content": "center !important"
              },
              ".team-profile-card": {
                "flex-direction": "column",
                "align-items": "center",
                "text-align": "center",
                "padding": "30px 20px"
              },
              ".team-avatar": {
                "margin-bottom": "8px",
                "width": "85px",
                "height": "85px"
              },
              ".timeline-step": {
                "flex-direction": "column",
                "align-items": "flex-start",
                "padding": "24px"
              },
              ".step-badge": {
                "margin-bottom": "10px"
              },
              ".notice-callout": {
                "flex-direction": "column",
                "text-align": "center"
              },
              ".matrix-card, .cta-card, .manifesto-card": {
                "padding": "24px"
              }
            },
            "@media (max-width: 400px)": {
              ".metrics-grid, .services-grid, .transparency-grid, .cta-grid": {
                "grid-template-columns": "1fr"
              },
              ".mobirise-home-section .btn": {
                "padding": "14px 20px !important",
                "font-size": "0.95rem !important"
              }
            },
            "P": {
              "text-align": "left"
            },
            "H3": {
              "text-align": "left"
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            },
            "@media (max-width: 575px)": {
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            "@media (max-width: 767px)": {
              ".services-grid, .team-grid, .transparency-grid, .pillars-grid, .three-column-grid, .grid-3, .grid-2, .faq-grid, .survival-grid, .portal-grid-2, .city-directory-grid, .details-cards-stack, .two-column-grid, .levels-grid, .cert-grid, .benefits-grid, .links-grid, .timeline-wrapper": {
                "display": "flex !important",
                "flex-wrap": "nowrap !important",
                "flex-direction": "row !important",
                "grid-template-columns": "none !important",
                "gap": "12px !important",
                "overflow-x": "auto",
                "overscroll-behavior-x": "contain",
                "scroll-snap-type": "x mandatory",
                "padding": "4px 2px 14px !important",
                "scrollbar-width": "none"
              },
              ".services-grid::-webkit-scrollbar, .team-grid::-webkit-scrollbar, .transparency-grid::-webkit-scrollbar, .pillars-grid::-webkit-scrollbar, .three-column-grid::-webkit-scrollbar, .grid-3::-webkit-scrollbar, .grid-2::-webkit-scrollbar, .faq-grid::-webkit-scrollbar, .survival-grid::-webkit-scrollbar, .portal-grid-2::-webkit-scrollbar, .city-directory-grid::-webkit-scrollbar, .details-cards-stack::-webkit-scrollbar, .two-column-grid::-webkit-scrollbar, .levels-grid::-webkit-scrollbar, .cert-grid::-webkit-scrollbar, .benefits-grid::-webkit-scrollbar, .links-grid::-webkit-scrollbar, .timeline-wrapper::-webkit-scrollbar": {
                "display": "none"
              },
              ".services-grid > *, .team-grid > *, .transparency-grid > *, .pillars-grid > *, .three-column-grid > *, .grid-3 > *, .grid-2 > *, .faq-grid > *, .survival-grid > *, .portal-grid-2 > *, .city-directory-grid > *, .details-cards-stack > *, .two-column-grid > *, .levels-grid > *, .cert-grid > *, .benefits-grid > *, .links-grid > *, .timeline-wrapper > *": {
                "flex": "0 0 84% !important",
                "max-width": "84% !important",
                "min-width": "0",
                "margin": "0 !important",
                "scroll-snap-align": "start"
              },
              ".timeline-wrapper::before": {
                "display": "none !important"
              },
              ".metrics-section, .services-section, .process-section, .region-section, .team-section, .transparency-section, .cta-section": {
                "padding-top": "44px !important",
                "padding-bottom": "44px !important"
              },
              ".metrics-grid": {
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr) !important",
                "gap": "10px !important"
              },
              ".word-grid": {
                "max-height": "62vh",
                "overflow-y": "auto",
                "overscroll-behavior": "contain",
                "padding-right": "4px"
              },
              ".metrics-grid > *": {
                "min-width": "0",
                "padding": "18px 10px !important"
              },
              ".metrics-grid .metric-value": {
                "font-size": "2rem !important"
              },
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            },
            "@media (max-width: 991px)": {
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_name": "article01",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"mobirise-home-section\" id=\"global-home-portal\">\n    <div class=\"portal-wrapper\">\n        \n        <!-- Hero Section -->\n        <div class=\"hero-wrapper\">\n            <div class=\"portal-container\">\n                <div class=\"hero-badge-group\">\n                    <span class=\"pulse-indicator\"></span>\n                    <span class=\"badge-text\">Офіційна волонтерська ініціатива • Верхня Франконія, Баварія</span>\n                </div>\n                \n                <h1 class=\"hero-title\">\n                    Гідна підтримка, житло та спільнота для українських родин у Північній Баварії\n                </h1>\n                \n                <p class=\"hero-subtitle\">\n                    Комплексна, 100% безкоштовна допомога у проходженні німецької бюрократії, пошуку житла, перекладі та влаштуванні дітей до шкіл.\n                </p>\n\n                <!-- Mobirise Interactive CTA Buttons -->\n                <div class=\"mbr-section-btn hero-cta-bar\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn btn-success display-4\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\" style=\"background-color: #0f7a3e !important; border-color: #0f7a3e !important;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 6px;\"><path d=\"M12.031 2c-5.514 0-9.996 4.482-9.996 9.996 0 1.763.459 3.486 1.332 5.013l-1.417 5.176 5.297-1.389c1.474.804 3.141 1.226 4.784 1.226 5.514 0 9.996-4.482 9.996-9.996 0-5.514-4.482-9.996-9.996-9.996zm0 18.286c-1.479 0-2.929-.396-4.195-1.147l-.301-.179-3.12.818.832-3.041-.197-.313c-.822-1.309-1.256-2.825-1.256-4.372 0-4.413 3.587-8 8-8s8 3.587 8 8-3.587 8.034-8 8.034z\"></path></svg> Написати нам у WhatsApp\n                    </a>\n                    <a class=\"btn btn-primary\" href=\"Contact.html#footer4-19\" data-app-placeholder=\"Type Text\">\n                        <span class=\"btn-icon\" style=\"display: inline-flex; align-items: center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 6px;\"><path d=\"M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z\"></path></svg></span> Зв'язатися електронною поштою\n                    </a></div>\n\n                <!-- White Manifesto Box -->\n                <div class=\"manifesto-card\">\n                    <div class=\"manifesto-header\">\n                        <span class=\"manifesto-tag\">НАША МІСІЯ ТА ДІЯЛЬНІСТЬ</span>\n                        <h2>Місцева особиста опора у Верхній Франконії</h2>\n                    </div>\n                    <div class=\"manifesto-body\">\n                        <p> \n                            З початку війни в Україні ми постійно супроводжуємо родини та окремих людей, які облаштовуються у Північній Баварії. Ми — це не далека бюрократична структура, не офіційна корпорація та не автоматизована гаряча лінія. Ми — віддана місцева команда, яка має глибокі коріння у Верхній Франконії. Ми використовуємо наші прямі зв'язки з органами влади, школами, орендодавцями та управляючими компаніями, щоб дати сім'ям справжню стабільність.\n                        </p>\n                        <p>\n                            Проходження німецьких муніципальних процедур вимагає більше, ніж просто добрих намірів — це вимагає розуміння складної мови дедлайнів, зустрічей у Jobcenter та офіційної кореспонденції. Ми заповнюємо саме цю прогалину за допомогою зрозумілої та постійної людської підтримки.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Live Impact Metrics -->\n        <div class=\"metrics-section\">\n            <div class=\"portal-container\">\n                <div class=\"metrics-grid\">\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value blue-val\">200+</div>\n                        <div class=\"metric-label\">Сім'ям надано підтримку</div>\n                        <div class=\"metric-sub\">Особистий супровід</div>\n                    </div>\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value emerald-val\">70+</div>\n                        <div class=\"metric-label\">Житлових об'єктів</div>\n                        <div class=\"metric-sub\">Знайдено та облаштовано</div>\n                    </div>\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value purple-val\">100%</div>\n                        <div class=\"metric-label\">Волонтерство та безкоштовно</div>\n                        <div class=\"metric-sub\">Без комісій чи прихованих платежів</div>\n                    </div>\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value amber-val\">2022+</div>\n                        <div class=\"metric-label\">Постійна присутність</div>\n                        <div class=\"metric-sub\">Активна підтримка з початку війни</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Comprehensive Support Grid -->\n        <div class=\"services-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">ЕКОСИСТЕМА ПІДТРИМКИ</span>\n                    <h2 class=\"section-main-title\">Як ми допомагаємо на вашому шляху</h2>\n                    <p class=\"section-description\">Повний комплекс людської допомоги, адаптований до місцевої баварської системи.</p>\n                </div>\n\n                <div class=\"services-grid\">\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-blue\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\"></path></svg>\n                        </div>\n                        <h3>Допомога з житлом</h3>\n                        <p>Пошук відповідних варіантів житла в регіоні, включаючи квартири безпосередньо з нашої мережі місцевих партнерів.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-emerald\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\"></path></svg>\n                        </div>\n                        <h3>Реєстрація (Anmeldung)</h3>\n                        <p>Покрокова підготовка до реєстрації за місцем проживання — обов'язкової основи для всіх юридичних процедур у Німеччині.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-purple\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z\"></path></svg>\n                        </div>\n                        <h3>Процеси в Jobcenter</h3>\n                        <p>Розшифровка офіційних листів, підготовка до обов'язкових зустрічей та супровід у процесі затвердження житла.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-amber\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z\"></path></svg>\n                        </div>\n                        <h3>Школи та дитячі садки</h3>\n                        <p>Пошук навчальних закладів у регіоні, подача необхідних документів та пряма координація з керівництвом шкіл.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-rose\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12.87 15.07l-2.54-2.51.03-.03c1.74-1.94 2.98-4.17 3.71-6.53H17V4h-7V2H8v2H1v2h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2.1l1.1-3h4.6l1.1 3H23l-4.5-12zm-2.62 7l1.62-4.41L19.12 17h-3.24z\"></path></svg>\n                        </div>\n                        <h3>Мова та переклад</h3>\n                        <p>Поєднання сімей із сертифікованими перекладачами української, російської та німецької мов для важливих офіційних візитів.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-indigo\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 10V7c0-1.1-.9-2-2-2H6c-1.1 0-2 .9-2 2v3c-1.1 0-2 .9-2 2v5h1.33L4 19h2l.67-2h10.66l.67 2h2l.67-2H22v-5c0-1.1-.9-2-2-2zm-9 0H6V7h5v3zm7 0h-5V7h5v3z\"></path></svg>\n                        </div>\n                        <h3>Меблі та побутові речі</h3>\n                        <p>Координація отримання базових меблів, кухонного приладдя та побутових промов на основі місцевих пожертв та наявності.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-teal\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"></path></svg>\n                        </div>\n                        <h3>Особистий куратор</h3>\n                        <p>Єдиний закріплений контакт, який особисто знає вашу історію, сімейну ситуацію та поточний статус.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-sky\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\"></path></svg>\n                        </div>\n                        <h3>Інтеграція в спільноту</h3>\n                        <p>Пряме знайомство з досвідченими українськими родинами у вашому місті, які вже пройшли цей процес.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Process Workflow Timeline -->\n        <div class=\"process-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">ПОКРОКОВИЙ ПРОЦЕС</span>\n                    <h2 class=\"section-main-title\">Як працює процес допомоги</h2>\n                </div>\n\n                <div class=\"timeline-wrapper\">\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">01</div>\n                        <div class=\"step-content\">\n                            <h3>Прямий контакт</h3>\n                            <p>Надішліть повідомлення у WhatsApp або на Email українською, російською, німецькою або англійською мовою. Онлайн-реєстрація чи заповнення форм не потрібні.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">02</div>\n                        <div class=\"step-content\">\n                            <h3>Первинна розмова</h3>\n                            <p>Ми аналізуємо склад вашої сім'ї, поточне місцеперебування, нагальні потреби безпеки та пріоритетні адміністративні кроки.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">03</div>\n                        <div class=\"step-content\">\n                            <h3>Оцінка можливостей</h3>\n                            <p>Ми оцінюємо місцеві можливості, доступність державних органів у регіоні та наявність житла, щоб дати вам реалістичну відповідь.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">04</div>\n                        <div class=\"step-content\">\n                            <h3>Персоналізований план дій</h3>\n                            <p>Якщо ми можемо допомогти, ми окреслюємо першочергові кроки. Якщо ресурси обмежені, ми одразу повідомляємо про це та надаємо альтернативні контакти.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">05</div>\n                        <div class=\"step-content\">\n                            <h3>Довгостроковий супровід</h3>\n                            <p>Наша підтримка виходить далеко за межі підписання договору оренди — ми допомагаємо з першими комунальними договорами та адаптацією у громаді.</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Callout Warning Box -->\n                <div class=\"notice-callout\">\n                    <div class=\"notice-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z\"></path></svg>\n                    </div>\n                    <div class=\"notice-text\">\n                        <strong>Важлива примітка про прозорість:</strong> Звернення до нашої команди не гарантує автоматичного надання житла, схвалення від Jobcenter чи місць у школі. Ми розглядаємо кожен випадок індивідуально та спілкуємося чесно. Ми надаємо перевагу швидкій та правдивій комунікації замість невиконаних обіцянок.\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Geographic Focus Section -->\n        <div class=\"region-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">РЕГІОНАЛЬНА СПЕЦІАЛІЗАЦІЯ</span>\n                    <h2 class=\"section-main-title\">Муніципалітети, де ми працюємо</h2>\n                    <p class=\"section-description\">Глибока місцева експертиза у Верхній Франконії (Oberfranken) та Північній Баварії.</p>\n                </div>\n\n                <div class=\"pills-cloud\">\n                    <span class=\"city-pill highlighted\">Helmbrechts</span>\n                    <span class=\"city-pill highlighted\">Münchberg</span>\n                    <span class=\"city-pill highlighted\">Hof</span>\n                    <span class=\"city-pill\">Selb</span>\n                    <span class=\"city-pill\">Wunsiedel</span>\n                    <span class=\"city-pill\">Arzberg</span>\n                    <span class=\"city-pill\">Marktredwitz</span>\n                    <span class=\"city-pill\">Naila</span>\n                    <span class=\"city-pill\">Kulmbach</span>\n                    <span class=\"city-pill\">Bad Steben</span>\n                    <span class=\"city-pill info-tag\">+ Наколишні міста Північної Баварії</span>\n                </div>\n\n                <div class=\"region-focus-card\">\n                    <h3>Чому регіональний фокус дає кращі результати</h3>\n                    <p>\n                        Фокусуючись виключно на цьому географічному регіоні, ми підтримуємо прямі зв'язки з місцевими муніципальними службовцями, знаємо, які школи мають місця для україномовних дітей, та які орендодавці приймають гарантії від Jobcenter.\n                    </p>\n                    <p>\n                        <em>Будь ласка, зверніть увагу: Ми не надаємо повного супроводу чи допомоги з житлом за межами нашого основного регіону діяльності.</em>\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"team-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">КЕРІВНИЦТВО ІНІЦІАТИВИ</span>\n                    <h2 class=\"section-main-title\">Хто стоїть за мережею підтримки</h2>\n                </div>\n\n                <div class=\"team-grid\">\n                    <div class=\"team-profile-card\">\n                        <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2026-07-26-at-6.16.22-pm.jpeg-120x120.jpg\" width=\"120\" height=\"120\" alt=\"Бен Шамір\" class=\"team-avatar\">\n                        <div class=\"team-info\">\n                            <h3>Бен Шамір</h3>\n                            <span class=\"role-pill\">Засновник та координатор</span>\n                            <p>Підприємець у сфері нерухомості з великим досвідом роботи в Німеччині. З початком війни Бен задіяв власні ресурси, інфраструктуру та регіональні зв'язки для створення структурованої мережі прийому та підтримки сімей.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"team-profile-card\">\n                        <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2026-07-26-at-6.17.22-pm.jpeg-120x120.jpg\" width=\"120\" height=\"120\" alt=\"Анна Чеішвілі\" class=\"team-avatar\">\n                        <div class=\"team-info\">\n                            <h3>Анна Чеішвілі</h3>\n                            <span class=\"role-pill manager\">Операційний менеджер</span>\n                            <p>Керує щоденною діяльністю повністю на волонтерських засадах. Анна є прямим та основним контактом для сімей, ведучи щоденну комунікацію у WhatsApp їхньою рідною мовою.</p>\n                            <a href=\"anna-shishoili.html\" style=\"color: #2563eb; font-weight: 600; text-decoration: underline; font-size: 0.9rem; margin-top: 10px; display: inline-block;\">Читати повну історію Анни →</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Transparency Matrix -->\n        <div class=\"transparency-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">ФІНАНСОВА ПРОЗОРІСТЬ</span>\n                    <h2 class=\"section-main-title\">100% безкоштовна модель послуг</h2>\n                </div>\n\n                <div class=\"transparency-grid\">\n                    <div class=\"matrix-card free-card\">\n                        <div class=\"matrix-header\">\n                            <span class=\"matrix-status\">ЗАВЖДИ 100% БЕЗКОШТОВНО</span>\n                            <h3>Волонтерська підтримка включає</h3>\n                        </div>\n                        <ul class=\"matrix-list\">\n                            <li><span>✓</span> Особистий супровід та ведення справи</li>\n                            <li><span>✓</span> Переклад та перевірка бюрократичних документів</li>\n                            <li><span>✓</span> Координація візитів до муніципальних органів</li>\n                            <li><span>✓</span> Пошук житла та переговори з орендодавцями</li>\n                            <li><span>✓</span> Допомога у реєстрації до шкіл та дитячих садків</li>\n                        </ul>\n                    </div>\n\n                    <div class=\"matrix-card external-card\">\n                        <div class=\"matrix-header\">\n                            <span class=\"matrix-status warning\">ЗОВНІШНІ ЗБОРИ ТА ВИТРАТИ</span>\n                            <h3>Оплата безпосередньо постачальникам послуг</h3>\n                        </div>\n                        <ul class=\"matrix-list warning-list\">\n                            <li><span>•</span> Муніципальні або офіційні державні збори</li>\n                            <li><span>•</span> Застава за оренду квартиры (Kautio) та щомісячна оренда</li>\n                            <li><span>•</span> Договори на електроенергію, опалення, газ та комунальні послуги</li>\n                            <li><span>•</span> Провайдери інтернету та телекомунікацій</li>\n                        </ul>\n                        <p class=\"matrix-footer-note\">* Жодні платежі чи кошти ніколи не проходять через нашу ініціативу.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Global Dual CTA with Mobirise Buttons -->\n        <div class=\"cta-section\">\n            <div class=\"portal-container\">\n                <div class=\"cta-grid\">\n                    <div class=\"cta-card cta-families\">\n                        <span class=\"cta-badge\">ДЛЯ НОВОПРИБУЛИХ СІМЕЙ</span>\n                        <h3>Потрібна допомога у Верхній Франконії?</h3>\n                        <p>Напишіть Анні напряму у WhatsApp або на Email українською, російською, німецькою чи англійською мовою.</p>\n                        \n                        <div class=\"mbr-section-btn cta-buttons-wrapper\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\">\n                            <a class=\"btn custom-btn whatsapp-btn display-4 btn-warning\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\">\n                                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                                WhatsApp Анни\n                            </a>\n                            <a class=\"btn btn-primary\" href=\"Contact.html#footer4-19\" data-app-placeholder=\"Type Text\">\n                                Надіслати Email\n                            </a>\n                        </div>\n                    </div>\n\n                    <div class=\"cta-card cta-supporters\">\n                        <span class=\"cta-badge dark\">ДЛЯ МІСЦЕВИХ БЛАГОДІЙНИКІВ</span>\n                        <h3>Бажаєте підтримати нашу роботу?</h3>\n                        <p>Вільне житло, меблі, допомога з перекладом або транспортом — ваш час створює реальні зміни.</p>\n                        \n                        <div class=\"mbr-section-btn cta-buttons\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn btn-outline-primary\" href=\"how-to-help.html\" data-app-placeholder=\"Type Text\">\n                                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 6px;\"><path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\"></path></svg> Долучитися\n                            </a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n    </div>\n</section>",
