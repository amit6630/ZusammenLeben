    "guide-ukrainian-documents.html": {
      "settings": {
        "title": "Українські документи в Німеччині: паспорт, апостиль",
        "order": "47",
        "meta_descr": "Як оформити закордонний паспорт за кордоном, консульський облік, дитина, народжена в Німеччині, апостиль, присяжні переклади й утрачені документи.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-ukrainian-documents.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-ukrainian-documents.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-ukrainian-documents.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-ukrainian-documents.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-ukrainian-documents.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Українські документи в Німеччині: паспорт, апостиль\" />\n<meta property=\"og:description\" content=\"Як оформити закордонний паспорт за кордоном, консульський облік, дитина, народжена в Німеччині, апостиль, присяжні переклади й утрачені документи.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-ukrainian-documents.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Як зберегти чинність українських документів у Німеччині\",\"description\":\"Як оформити закордонний паспорт за кордоном, консульський облік, дитина, народжена в Німеччині, апостиль, присяжні переклади й утрачені документи.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-ukrainian-documents.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-ukrainian-documents.html\",\"wordCount\":890,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Де оформити український паспорт у Баварії?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"У Генеральному консульстві України в Мюнхені або в паспортному сервісі за кордоном, зазвичай за онлайн-записом.\"}},{\"@type\":\"Question\",\"name\":\"Чи потрібен апостиль на українські свідоцтва?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Часто так. РАЦС зазвичай вимагає апостиль і присяжний переклад; запитайте заздалегідь.\"}},{\"@type\":\"Question\",\"name\":\"Чи приймають переклади, зроблені в Україні?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Часто ні. Німецькі установи зазвичай вимагають перекладача, уповноваженого в Німеччині.\"}},{\"@type\":\"Question\",\"name\":\"Чи визнається «Дія» в Німеччині як документ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ні. Німецькі установи не визнають документи в «Дії» як посвідчення особи.\"}},{\"@type\":\"Question\",\"name\":\"Що робити, якщо паспорт викрали?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Повідомити поліцію, відомство у справах іноземців і подати заяву на новий паспорт у консульстві.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Як зберегти чинність українських документів у Німеччині\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-ukrainian-documents.html\"}]}]}</script>"
      },
      "components": [
