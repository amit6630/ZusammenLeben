    "guide-jobcenter-letters.html": {
      "settings": {
        "title": "Як читати листи від Jobcenter і відповідати на них",
        "order": "18",
        "meta_descr": "Bescheid, Einladung, Mitwirkung: що означають найчастіші листи Jobcenter, які строки важливі та як відповісти вчасно, не втративши виплат.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-jobcenter-letters.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-jobcenter-letters.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-jobcenter-letters.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-jobcenter-letters.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-jobcenter-letters.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Як читати листи від Jobcenter і відповідати на них\" />\n<meta property=\"og:description\" content=\"Bescheid, Einladung, Mitwirkung: що означають найчастіші листи Jobcenter, які строки важливі та як відповісти вчасно, не втративши виплат.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-jobcenter-letters.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Як читати листи від Jobcenter і відповідати на них\",\"description\":\"Bescheid, Einladung, Mitwirkung: що означають найчастіші листи Jobcenter, які строки важливі та як відповісти вчасно, не втративши виплат.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-jobcenter-letters.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-jobcenter-letters.html\",\"wordCount\":865,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Скільки часу є на заперечення проти рішення Jobcenter?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Зазвичай один місяць після отримання рішення. Точне правило вказане в Rechtsbehelfsbelehrung наприкінці листа.\"}},{\"@type\":\"Question\",\"name\":\"Що робити, якщо я не можу прийти на зустріч?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Повідомте Jobcenter до зустрічі та вкажіть причину. Якщо ви хворі, надішліть довідку від лікаря.\"}},{\"@type\":\"Question\",\"name\":\"Чи коштує заперечення грошей?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ні. Процедура заперечення безкоштовна, як і розгляд у соціальному суді для вас як отримувача виплат.\"}},{\"@type\":\"Question\",\"name\":\"Коли подавати заяву на продовження?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"До завершення поточного періоду призначення. Дата завершення вказана в останньому рішенні; подайте заяву за кілька тижнів.\"}},{\"@type\":\"Question\",\"name\":\"Чи може ZusammenLeben прочитати листи разом зі мною?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так. Надішліть нам фото у WhatsApp, і ми пояснимо, що вимагають і який строк. Юридичних консультацій ми не надаємо.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Як читати листи від Jobcenter і відповідати на них\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-jobcenter-letters.html\"}]}]}</script>"
      },
