            "&": {
              "background": "#f8fafc",
              "color": "#1e293b",
              "padding": "120px 16px 72px",
              "font-family": "'Inter Tight', sans-serif",
              "line-height": "1.65"
            },
            ".zl-wrap": {
              "max-width": "780px",
              "margin": "0 auto"
            },
            ".zl-wrap--wide": {
              "max-width": "1100px"
            },
            ".zl-crumbs ol": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "6px",
              "list-style": "none",
              "padding": "0",
              "margin": "0 0 18px",
              "font-size": "14px",
              "color": "#475569"
            },
            ".zl-crumbs li + li::before": {
              "content": "\"/\"",
              "margin-right": "6px",
              "color": "#94a3b8"
            },
            ".zl-crumbs a": {
              "color": "#1d4ed8",
              "text-decoration": "underline",
              "text-underline-offset": "2px"
            },
            ".zl-tag": {
              "display": "inline-block",
              "padding": "4px 12px",
              "border-radius": "999px",
              "background": "#e0e7ff",
              "color": "#0c2c68",
              "font-size": "13px",
              "font-weight": "700",
              "letter-spacing": ".04em",
              "text-transform": "uppercase"
            },
            "h1": {
              "margin": "14px 0 12px",
              "font-size": "clamp(30px, 4.4vw, 46px)",
              "line-height": "1.12",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-.01em"
            },
            ".zl-lead": {
              "font-size": "clamp(17px, 1.6vw, 20px)",
              "color": "#475569",
              "margin": "0 0 14px",
              "line-height": "1.5 !important"
            },
            ".zl-meta": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "14px",
              "font-size": "14px",
              "color": "#475569",
              "margin-bottom": "26px"
            },
            ".zl-card": {
              "background": "#fff",
              "border": "1px solid #e2e8f0",
              "border-radius": "18px",
              "padding": "clamp(22px, 3.4vw, 40px)",
              "box-shadow": "0 10px 30px -18px rgba(15, 23, 42, .25)"
            },
            ".zl-body h2": {
              "font-size": "clamp(21px, 2.2vw, 26px)",
              "line-height": "1.25",
              "margin": "30px 0 10px",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-body h2:first-child": {
              "margin-top": "0"
            },
            ".zl-body p, .zl-body li": {
              "font-size": "17px"
            },
            ".zl-body p": {
              "margin": "0 0 14px"
            },
            "p, li, summary": {
              "line-height": "1.65 !important"
            },
            ".zl-body ul, .zl-body ol": {
              "padding-left": "1.3em",
              "margin": "0 0 16px"
            },
            ".zl-body li": {
              "margin-bottom": "8px"
            },
            ".zl-body a": {
              "color": "#1d4ed8",
              "text-decoration": "underline",
              "text-underline-offset": "2px",
              "font-weight": "600"
            },
            ".zl-body a[target=\"_blank\"]::after": {
              "content": "\" \\2197\"",
              "font-weight": "400"
            },
            ".zl-note": {
              "margin": "20px 0",
              "padding": "16px 18px",
              "border-radius": "12px",
              "background": "#eff6ff",
              "border-left": "4px solid #1d4ed8",
              "font-size": "16px"
            },
            ".zl-note--warn": {
              "background": "#fffbeb",
              "border-left-color": "#b45309"
            },
