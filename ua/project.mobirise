    "guide-tax-return.html": {
      "settings": {
        "title": "Податки в Німеччині: Steuer-ID, класи та декларація",
        "order": "37",
        "meta_descr": "Податковий номер, податкові класи, церковний податок, коли декларація обов'язкова, що можна відрахувати і як подати безкоштовно через ELSTER.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-tax-return.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-tax-return.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-tax-return.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-tax-return.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-tax-return.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Податки в Німеччині: Steuer-ID, класи та декларація\" />\n<meta property=\"og:description\" content=\"Податковий номер, податкові класи, церковний податок, коли декларація обов'язкова, що можна відрахувати і як подати безкоштовно через ELSTER.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-tax-return.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Податки в Німеччині: основи для найманих працівників\",\"description\":\"Податковий номер, податкові класи, церковний податок, коли декларація обов'язкова, що можна відрахувати і як подати безкоштовно через ELSTER.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-tax-return.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-tax-return.html\",\"wordCount\":952,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Чи обов'язково подавати декларацію?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Часто ні, але в деяких випадках так, наприклад при двох роботах чи класах III/V.\"}},{\"@type\":\"Question\",\"name\":\"Чи вигідна добровільна декларація?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Часто так. Багато працівників отримують гроші назад, особливо якщо почали працювати посеред року.\"}},{\"@type\":\"Question\",\"name\":\"За скільки років назад можна подати?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Добровільну декларацію можна подати за чотири роки назад.\"}},{\"@type\":\"Question\",\"name\":\"Що таке церковний податок?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Податок для членів католицької та євангелічної церков, який утримують разом із податком на зарплату. Він залежить від релігії, вказаної при реєстрації.\"}},{\"@type\":\"Question\",\"name\":\"Чи безкоштовний ELSTER?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так. ELSTER — безкоштовний офіційний онлайн-портал податкових органів.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Податки в Німеччині: основи для найманих працівників\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-tax-return.html\"}]}]}</script>"
      },
      "components": [
