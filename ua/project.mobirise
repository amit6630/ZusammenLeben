              "letter-spacing": "-.01em"
            },
            ".zl-lead": {
              "font-size": "clamp(17px, 1.6vw, 20px)",
              "color": "#475569",
              "margin": "0 0 14px",
              "line-height": "1.5 !important"
            },
            ".zl-meta": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "14px",
              "font-size": "14px",
              "color": "#475569",
              "margin-bottom": "26px"
            },
            ".zl-card": {
              "background": "#fff",
              "border": "1px solid #e2e8f0",
              "border-radius": "18px",
              "padding": "clamp(22px, 3.4vw, 40px)",
              "box-shadow": "0 10px 30px -18px rgba(15, 23, 42, .25)"
            },
            ".zl-body h2": {
              "font-size": "clamp(21px, 2.2vw, 26px)",
              "line-height": "1.25",
              "margin": "30px 0 10px",
              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-body h2:first-child": {
              "margin-top": "0"
            },
            ".zl-body p, .zl-body li": {
              "font-size": "17px"
            },
            ".zl-body p": {
              "margin": "0 0 14px"
            },
            "p, li, summary": {
              "line-height": "1.65 !important"
            },
            ".zl-body ul, .zl-body ol": {
              "padding-left": "1.3em",
              "margin": "0 0 16px"
            },
            ".zl-body li": {
              "margin-bottom": "8px"
            },
            ".zl-body a": {
              "color": "#1d4ed8",
              "text-decoration": "underline",
              "text-underline-offset": "2px",
