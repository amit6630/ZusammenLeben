            },
            ".btn-whatsapp": {
              "background-color": "#16a34a",
              "color": "#fff",
              "border": "2px solid #16a34a",
              "box-shadow": "0 4px 10px rgba(22, 163, 74, 0.3)"
            },
            ".btn-whatsapp:hover": {
              "background-color": "#15803d",
              "border-color": "#15803d",
              "color": "#fff",
              "transform": "translateY(-2px)"
            },
            ".btn-outline": {
              "background-color": "transparent",
              "color": "#2563eb",
              "border": "2px solid #2563eb"
            },
            ".btn-outline:hover": {
              "background-color": "#2563eb",
              "color": "#fff"
            },
            ".portal-footer-reminder": {
              "background": "#0f172a",
              "color": "#000000",
              "padding": "40px",
              "border-radius": "12px",
              "text-align": "center",
              "margin-top": "60px"
            },
            ".portal-footer-reminder h3": {
              "color": "#000000",
              "margin-bottom": "25px",
              "font-size": "1.5rem",
              "text-align": "center"
            },
            ".footer-numbers-grid": {
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "center",
              "gap": "20px",
              "font-size": "1.1rem"
            },
            ".footer-numbers-grid div": {
              "background": "rgba(255, 255, 255, 0.1)",
              "padding": "10px 20px",
              "border-radius": "6px",
              "backdrop-filter": "blur(5px)"
            },
            ".footer-emergency-warning": {
              "margin-top": "25px",
              "font-size": "0.95rem",
              "color": "#94a3b8",
              "border-top": "1px solid rgba(255, 255, 255, 0.1)",
              "padding-top": "20px"
            },
            "@media (max-width: 768px)": {
              ".portal-container": {
                "padding": "20px 10px"
              },
              ".portal-alert": {
                "flex-direction": "column",
                "gap": "10px"
              },
              ".emergency-number a": {
                "font-size": "2.8rem"
              },
              ".action-buttons-group": {
                "flex-direction": "column"
              },
              ".portal-btn": {
                "width": "100%",
                "justify-content": "center"
              },
              ".footer-numbers-grid": {
                "flex-direction": "column",
                "gap": "10px"
              },
              ".block-heading h3": {
                "font-size": "1.4rem"
              }
            },
            "H3": {
              "color": "#000000"
            },
            "P": {
              "text-align": "left"
            }
          },
          "_name": "people04",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"portal-container\" dir=\"ltr\" lang=\"uk\" style=\"max-width: 1140px; margin: 0 auto; box-sizing: border-box;\">\n    \n    <!-- Main Header -->\n    <div class=\"portal-header text-center\">\n        <span class=\"badge-tag badge-primary mb-2\"><i class=\"fa-solid fa-shield-halved\"></i> Перевірені ресурси та центр підтримки</span>\n        <h1>Гайд з екстреної допомоги та служби підтримки</h1>\n        <h2>Північна Баварія — Телефонні номери, адреси та допомога</h2>\n        <p class=\"portal-lead mt-2\">Комплексний каталог екстрених служб, медичних центрів, юридичної допомоги, сприяння з житлом та мереж соціальної підтримки в регіоні, структурований для швидкого доступу під час кризи.</p>\n    </div>\n\n    <!-- Quick Jump Navigation Bar -->\n    <nav class=\"portal-nav-bar\" aria-label=\"Quick Navigation\">\n        <a href=\"#immediate-danger\" class=\"nav-pill pill-danger\"><i class=\"fa-solid fa-triangle-exclamation\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M12 2v3\"></path><path d=\"M4.93 4.93l2.12 2.12\"></path><path d=\"M19.07 4.93l-2.12 2.12\"></path><path d=\"M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V10a6 6 0 0 0-12 0v9z\"></path><path d=\"M4 19h16\"></path></svg> Безпосередня небезпека</a>\n        <a href=\"#medical\" class=\"nav-pill\"><i class=\"fa-solid fa-stethoscope\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M3 21h18\"></path><path d=\"M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16\"></path><path d=\"M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4\"></path><path d=\"M10 9h4\"></path><path d=\"M12 7v4\"></path></svg> Медицина та отруєння</a>\n        <a href=\"#women-aid\" class=\"nav-pill\"><i class=\"fa-solid fa-person-dress\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M12 2a5 5 0 0 0-5 5c0 2 1 3.5 2.5 4.5A8 8 0 0 0 2 19v1h20v-1a8 8 0 0 0-7.5-7.5C16 10.5 17 9 17 7a5 5 0 0 0-5-5z\"></path></svg> Допомога жінкам</a>\n        <a href=\"#youth-family\" class=\"nav-pill\"><i class=\"fa-solid fa-children\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><circle cx=\"19\" cy=\"7\" r=\"2\"></circle><circle cx=\"5\" cy=\"7\" r=\"2\"></circle><path d=\"M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a3 3 0 0 0 3 3h2a3 3 0 0 0 3-3v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z\"></path></svg> Молодь і сім'я</a>\n        <a href=\"#housing-food\" class=\"nav-pill\"><i class=\"fa-solid fa-house-crack\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg> Житло та харчування</a>\n        <a href=\"#cities\" class=\"nav-pill\"><i class=\"fa-solid fa-city\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"></line><path d=\"M12 20V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v16\"></path><path d=\"M4 20V10a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v10\"></path><line x1=\"2\" y1=\"20\" x2=\"22\" y2=\"20\"></line></svg> Каталог міст</a>\n        <a href=\"#contact-team\" class=\"nav-pill pill-highlight\"><i class=\"fa-solid fa-users\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m11 17 2 2a1 1 0 0 0 1.4 0l4.3-4.3a1 1 0 0 0 0-1.4l-2.1-2.1a1 1 0 0 0-1.4 0L12 14\"></path><path d=\"m13 11 2-2a1 1 0 0 0 0-1.4L12.9 5.5a1 1 0 0 0-1.4 0L8.4 8.6a1 1 0 0 0 0 1.4l2.1 2.1a1 1 0 0 0 1.4 0z\"></path><path d=\"M2 11l4.5-4.5a2 2 0 0 1 2.8 0l1.2 1.2\"></path><path d=\"M22 13l-4.5 4.5a2 2 0 0 1-2.8 0l-1.2-1.2\"></path></svg> Наша команда</a>\n    </nav>\n\n    <!-- Important Disclaimer -->\n    <div class=\"portal-alert\">\n        <div class=\"alert-icon\"><i class=\"fa-solid fa-triangle-exclamation fa-2x\"></i></div>\n        <div>\n            <h3 class=\"h5 fw-bold\" style=\"color: inherit; margin-top: 0;\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg> Важливе оперативне застереження</h3>\n            <p class=\"mb-2\">Наша соціальна ініціатива є волонтерською мережею підтримки та <strong>не замінює</strong> офіційні диспетчерські служби екстреного реагування, поліцію, пожежну службу, лікарні чи Ведомство у справах молоді (Jugendamt).</p>\n            <p class=\"mb-0\"><strong>У будь-якій ситуації, що становить безпосередню загрозу життю, у разі серйозної аварії, пожежі або активного насильства — негайно телефонуйте за номерами <a href=\"tel:112\" style=\"color: inherit; text-decoration: underline; font-weight: 700;\">112</a> або <a href=\"tel:110\" style=\"color: inherit; text-decoration: underline; font-weight: 700;\">110</a>.</strong> Ми не можемо гарантувати цілодобову доступність 24/7 або миттєве розв'язання кожного випадку.</p>\n        </div>\n    </div>\n\n    <!-- Section 1: Immediate Danger -->\n    <div id=\"immediate-danger\" class=\"portal-block\">\n        <div class=\"block-heading\">\n            <h3><i class=\"fa-solid fa-phone-volume\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M12 2v3\"></path><path d=\"M4.93 4.93l2.12 2.12\"></path><path d=\"M19.07 4.93l-2.12 2.12\"></path><path d=\"M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V10a6 6 0 0 0-12 0v9z\"></path><path d=\"M4 19h16\"></path></svg> Безпосередня небезпека — телефонуйте зараз</h3>\n            <p class=\"text-muted\" style=\"color: var(--portal-text-muted) !important;\">Використовуйте ці номери, коли відлік іде на секунди. Безкоштовно з будь-якого міського чи мобільного телефону по всій Німеччині та ЄС.</p>\n        </div>\n        \n        <div class=\"portal-grid-2\">\n            <div class=\"portal-card emergency-card red-theme\">\n                <div class=\"card-top-meta\">\n                    <span class=\"badge-tag badge-danger\">Безпека життя</span>\n                    <span class=\"badge-tag badge-secondary\">24/7 Безкоштовно</span>\n                </div>\n                <div class=\"emergency-number\"><a href=\"tel:112\" style=\"text-decoration: none;\">112</a></div>\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Швидка допомога, черговий лікар та пожежна служба</h4>\n                <p class=\"text-muted\" style=\"color: var(--portal-text-muted);\">Телефонуйте у випадках, які включають:</p>\n                <ul>\n                    <li>Загрозливі для життя медичні стани та тяжкі розлади дихання</li>\n                    <li>Втрату свідомості або серйозні нещасні випадки</li>\n                    <li>Пожежі та важкі травми</li>\n                    <li>Підозру на отруєння та виклик термінової медичної допомоги</li>\n                </ul>\n                <div class=\"card-footer-note\">Дійсно в усіх країнах-членах ЄС.</div>\n            </div>\n\n            <div class=\"portal-card emergency-card blue-theme\">\n                <div class=\"card-top-meta\">\n                    <span class=\"badge-tag badge-primary\">Правоохоронні органи</span>\n                    <span class=\"badge-tag badge-secondary\">24/7 Безкоштовно</span>\n                </div>\n                <div class=\"emergency-number\"><a href=\"tel:110\" style=\"text-decoration: none;\">110</a></div>\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Екстрений виклик поліції</h4>\n                <p class=\"text-muted\" style=\"color: var(--portal-text-muted);\">Телефонуйте у випадках, які включають:</p>\n                <ul>\n                    <li>Активне насильство або загрозу фізичного покарання</li>\n                    <li>Пограбування або злочини, що відбуваються безпосередньо зараз</li>\n                    <li>Безпосередню небезпеку для дитини або домашнє насильство</li>\n                    <li>Серйозне переслідування, сталкінг або загрози безпеці</li>\n                </ul>\n                <div class=\"card-footer-note\">У разі активної небезпеки немає потреби відвідувати відділок.</div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Section 2: Medical & Poison Control -->\n    <div id=\"medical\" class=\"portal-block\">\n        <div class=\"block-heading\">\n            <h3><i class=\"fa-solid fa-stethoscope\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M3 21h18\"></path><path d=\"M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16\"></path><path d=\"M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4\"></path><path d=\"M10 9h4\"></path><path d=\"M12 7v4\"></path></svg> Невідкладна медична допомога та токсикологічний центр</h3>\n        </div>\n        <div class=\"portal-grid-2\">\n            <div class=\"portal-card\">\n                <div class=\"card-top-meta\">\n                    <span class=\"badge-tag badge-warning\">Без загрози для життя</span>\n                </div>\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\"><a href=\"tel:116117\" style=\"color: var(--portal-primary); text-decoration: none;\">116 117</a> — Чергова медична служба</h4>\n                <p style=\"color: var(--portal-text-muted);\">Для невідкладних медичних питань у неробочий час клінік (вечори, ночі, вихідні):</p>\n                <ul>\n                    <li>Висока температура без безпосереднього ризику для життя</li>\n                    <li>Сильний біль, що потребує термінового огляду</li>\n                    <li>Пошук відкритої чергової практики (Bereitschaftspraxis)</li>\n                </ul>\n                <div class=\"inline-warning\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg> У випадках, що становлять загрозу для життя, завжди набирайте 112.</div>\n            </div>\n\n            <div class=\"portal-card\">\n                <div class=\"card-top-meta\">\n                    <span class=\"badge-tag badge-warning\">Токсикологія</span>\n                </div>\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Центр контролю отруєнь (Баварія / Мюнхен)</h4>\n                <div class=\"highlight-number-box\"><a href=\"tel:08919240\" style=\"color: inherit; text-decoration: none;\">089 19240</a></div>\n                <p style=\"color: var(--portal-text-muted); font-size: 0.95rem;\">Звертайтеся у разі проковтування або контакту з токсичними речовинами, хімікатами чи небезпечними рослинами. Опубліковано Klinikum Fichtelgebirge.</p>\n                <div class=\"inline-warning\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg> Якщо людина непритомна або має труднощі з диханням, спочатку набирайте 112.</div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Section 3: Emergency Call Guide & Phrases -->\n    <div class=\"portal-block\">\n        <div class=\"portal-card bg-subtle\">\n            <h4 class=\"h5 fw-bold mb-3\" style=\"color: #0f172a;\"><i class=\"fa-solid fa-headset\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg> Що говорити під час екстреного виклику</h4>\n            <p style=\"color: var(--portal-text-muted);\">Будьте готові чітко та спокійно відповісти на <strong>5 питань (5 W)</strong>:</p>\n            <div class=\"steps-grid mb-4\">\n                <div class=\"step-box\"><strong>1. Де? (Wo?)</strong> Місто, вулиця, номер будинку, поверх, прізвище на дзвінку.</div>\n                <div class=\"step-box\"><strong>2. Що сталося? (Was?)</strong> Короткий опис інциденту.</div>\n                <div class=\"step-box\"><strong>3. Хто постраждав? (Wer?)</strong> Кількість залучених людей та категорії (діти, літні люди).</div>\n                <div class=\"step-box\"><strong>4. Який стан? (Wie?)</strong> Притомність, дихання, наявність травм.</div>\n                <div class=\"step-box\"><strong>5. Чекайте! (Warten?)</strong> Не кладіть слухавку, поки диспетчер сам не скаже це зробити.</div>\n            </div>\n            \n            <h5 class=\"h6 fw-bold mb-3\" style=\"color: #0f172a;\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path></svg> Основні німецькі фрази для тих, хто не володіє німецькою мовою:</h5>\n            <div class=\"phrases-grid\">\n                <div class=\"phrase-item\"><strong>Ich spreche nur Englisch</strong><span>Я розмовляю тільки англійською</span></div>\n                <div class=\"phrase-item\"><strong>Ich spreche Ukrainisch</strong><span>Я розмовляю українською</span></div>\n                <div class=\"phrase-item\"><strong>Ich brauche einen Dolmetscher</strong><span>Мені потрібен перекладач</span></div>\n                <div class=\"phrase-item\"><strong>Es ist ein Notfall</strong><span>Це екстрений випадок</span></div>\n                <div class=\"phrase-item\"><strong>Meine Adresse ist...</strong><span>Моя адреса...</span></div>\n                <div class=\"phrase-item\"><strong>Ein Kind ist in Gefahr</strong><span>Дитина в небезпеці</span></div>\n                <div class=\"phrase-item\"><strong>Ich brauche einen Krankenwagen</strong><span>Мені потрібна швидка допомога</span></div>\n                <div class=\"phrase-item\"><strong>Ich brauche die Polizei</strong><span>Мені потрібна поліція</span></div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Section 4: Women's Assistance -->\n    <div id=\"women-aid\" class=\"portal-block\">\n        <div class=\"block-heading\">\n            <h3><i class=\"fa-solid fa-person-dress\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M12 2a5 5 0 0 0-5 5c0 2 1 3.5 2.5 4.5A8 8 0 0 0 2 19v1h20v-1a8 8 0 0 0-7.5-7.5C16 10.5 17 9 17 7a5 5 0 0 0-5-5z\"></path></svg> Підтримка жінок, які зазнають насильства або перебувають у скруті</h3>\n        </div>\n        <div class=\"portal-grid-2\">\n            <div class=\"portal-card\">\n                <div class=\"card-top-meta\">\n                    <span class=\"badge-tag badge-danger\">Конфіденційно</span>\n                    <span class=\"badge-tag badge-secondary\">24/7 Безкоштовно</span>\n                </div>\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Лінія допомоги «Насильство проти жінок»</h4>\n                <div class=\"highlight-number-box\" style=\"color: var(--portal-danger);\"><a href=\"tel:116016\" style=\"color: inherit; text-decoration: none;\">116 016</a></div>\n                <p style=\"color: var(--portal-text-muted); font-size: 0.95rem;\">Національна консультаційна служба у випадках домашнього насильства, сталкінгу, сексуального насильства та торгівлі людьми (Hilfetelefon Gewalt gegen Frauen).</p>\n                <ul>\n                    <li>Абсолютно анонімно та безкоштовно</li>\n                    <li>Доступно українською, англійською та іншими мовами</li>\n                    <li>Пряме перенаправлення до місцевих притулків та безпечних будинків</li>\n                </ul>\n            </div>\n\n            <div class=\"portal-card\">\n                <div class=\"card-top-meta\">\n                    <span class=\"badge-tag badge-primary\">Підтримка вагітних</span>\n                </div>\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Вагітні жінки у скруті</h4>\n                <div class=\"highlight-number-box\"><a href=\"tel:08004040020\" style=\"color: inherit; text-decoration: none;\">0800 40 40 020</a></div>\n                <p style=\"color: var(--portal-text-muted); font-size: 0.95rem;\">Конфіденційна допомога вагітним жінкам, які опинилися у фінансовій, соціальній або особистій кризі без належної підтримки (Hilfetelefon Schwangere in Not).</p>\n                <div class=\"card-footer-note\">Доступно 24/7 багатьма мовами, безкоштовно та анонімно.</div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Section 5: Youth & Family -->\n    <div id=\"youth-family\" class=\"portal-block\">\n        <div class=\"block-heading\">\n            <h3><i class=\"fa-solid fa-children\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><circle cx=\"19\" cy=\"7\" r=\"2\"></circle><circle cx=\"5\" cy=\"7\" r=\"2\"></circle><path d=\"M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a3 3 0 0 0 3 3h2a3 3 0 0 0 3-3v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z\"></path></svg> Допомога дітям, молоді та батькам</h3>\n        </div>\n        \n        <div class=\"portal-card mb-4\" style=\"background: #fffbe0; border-color: #fef3c7;\">\n            <h4 class=\"h5 fw-bold\" style=\"color: #92400e; margin-top: 0;\"><i class=\"fa-solid fa-child-reaching\"></i> Негайне повідомлення про захист дитини</h4>\n            <p style=\"color: #78350f; font-size: 0.95rem; margin-bottom: 0;\">Якщо дитина перебуває у безпосередній небезпеці, зазнає занедбаності або насильства, негайно зверніться до <strong>Поліції (<a href=\"tel:110\" style=\"color: inherit; text-decoration: underline;\">110</a>)</strong> або <strong>Швидкої допомоги (<a href=\"tel:112\" style=\"color: inherit; text-decoration: underline;\">112</a>)</strong>. Для неекстрених перевірок добробуту звертайтеся до місцевого <strong>Jugendamt (Ведомство у справах молоді)</strong>. Вам не обов'язково бути родичем, щоб повідомити про реальну загрозу безпеці дитини.</p>\n        </div>\n\n        <div class=\"portal-grid-2 mb-4\">\n            <div class=\"portal-card\">\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Гаряча лінія для молоді (Nummer gegen Kummer)</h4>\n                <div class=\"highlight-number-box\"><a href=\"tel:116111\" style=\"color: inherit; text-decoration: none;\">116 111</a></div>\n                <p style=\"color: var(--portal-text-muted); font-size: 0.95rem; margin-bottom: 0;\">Для дітей та підлітків, які зіштовхнулися зі стресом, сімейними конфліктами, тиском у школі, булінгом або емоційними труднощами. Пн–Сб, 14:00–20:00. Безкоштовно та анонімно.</p>\n            </div>\n\n            <div class=\"portal-card\">\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Гаряча лінія для батьків</h4>\n                <div class=\"highlight-number-box\"><a href=\"tel:08001110550\" style=\"color: inherit; text-decoration: none;\">0800 111 0550</a></div>\n                <p style=\"color: var(--portal-text-muted); font-size: 0.95rem; margin-bottom: 0;\">Консультації для батьків щодо сімейного стресу, викликів виховання та благополуччя дітей. Пн/Ср/Пт 09:00–17:00, Вт/Чт 09:00–19:00.</p>\n            </div>\n        </div>\n        \n        <div class=\"portal-card mb-4\">\n            <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M3 21h18\"></path><path d=\"M6 18v-7\"></path><path d=\"M10 18v-7\"></path><path d=\"M14 18v-7\"></path><path d=\"M18 18v-7\"></path><path d=\"M12 2 2 7h20L12 2z\"></path></svg> Jugendamt Landkreis Hof (Управління у справах молоді району Гоф)</h4>\n            <p style=\"color: var(--portal-text-muted); font-size: 0.95rem; margin-bottom: 6px;\">Обслуговує Хельмбрехтс, Мюнхберг, Найлу, Бад-Штебен та прилеглі міста в районі Гоф.</p>\n            <p style=\"color: var(--portal-text-muted); font-size: 0.95rem; margin-bottom: 0;\">\n                <strong>Головна гаряча лінія:</strong> <a href=\"tel:0928157275\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 57-275</a> | <strong>Загальна соціальна служба (ASD):</strong> <a href=\"tel:0928157404\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 57-404</a><br>\n                <strong>Email:</strong> <a href=\"mailto:kreisjugendamt@landkreis-hof.de\" style=\"color: var(--portal-primary); text-decoration: none;\">kreisjugendamt@landkreis-hof.de</a>\n            </p>\n        </div>\n        <!-- Emotional Support / TelefonSeelsorge -->\n  <div class=\"portal-card mb-4\">\n            <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -0.125em; color: #16a34a;\"><path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"></path></svg> Емоційна підтримка та TelefonSeelsorge</h4>\n            <p style=\"color: var(--portal-text-muted); font-size: 0.95rem;\">Для кожного, хто зіштовхнувся з особистою кризою, самотністю, страхом або емоційним стражданням. Доступно 24/7, безкоштовно та анонімно:</p>\n            <p style=\"color: var(--portal-text-muted); font-size: 0.95rem; margin-bottom: 0;\">\n                <strong>Безкоштовні номери:</strong> <a href=\"tel:08001110111\" style=\"color: var(--portal-primary); text-decoration: none;\">0800 111 0 111</a> | <a href=\"tel:08001110222\" style=\"color: var(--portal-primary); text-decoration: none;\">0800 111 0 222</a> | <a href=\"tel:116123\" style=\"color: var(--portal-primary); text-decoration: none;\">116 123</a>\n            </p>\n        </div>\n\n        <!-- Official Ukraine & Jobcenter info -->\n        <div class=\"portal-card\">\n            <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\"><svg width=\"1.2em\" height=\"0.9em\" viewBox=\"0 0 640 480\" style=\"vertical-align: -0.125em; display: inline-block; border-radius: 2px; overflow: hidden;\"><g fill-rule=\"evenodd\" stroke-width=\"1pt\"><path fill=\"#0057b7\" d=\"M0 0h640v240H0z\"></path><path fill=\"#ffd700\" d=\"M0 240h640v240H0z\"></path></g></svg> Офіційна підтримка українців та працевлаштування</h4>\n            <ul style=\"margin-top: 10px; padding-left: 20px;\">\n                <li><strong>Портал Germany4Ukraine:</strong> Офіційний федеральний портал для реєстрації, пошуку житла, роботи та допомоги.</li>\n                <li><strong>Федеральне агентство з працевлаштування (Первинна гаряча лінія українською/російською):</strong> <a href=\"tel:+499111787915\" style=\"color: var(--portal-primary); text-decoration: none;\">+49 911 178 7915</a></li>\n                <li style=\"color: var(--portal-danger); font-weight: 600; margin-top: 4px;\"><em>Примітка:</em> Старіші довідники, де згадується Helpline Ukraine (0800 500 225 0), є неактивними.</li>\n            </ul>\n        </div>\n    </div>\n\n    <!-- Section 6: Housing, Food & Infrastructure -->\n    <div id=\"housing-food\" class=\"portal-block\">\n        <div class=\"block-heading\">\n            <h3><i class=\"fa-solid fa-house-crack\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg> Безпритульність, брак продуктів та аварії комунальних служб</h3>\n        </div>\n        <div class=\"portal-grid-2\">\n            <div class=\"portal-card\">\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Ризик виселення або відсутність притулку на ніч</h4>\n                <ul style=\"padding-left: 20px;\">\n                    <li>Негайно зверніться до міського <strong>Ordnungsamt</strong> або міської адміністрації.</li>\n                    <li>У позаробочий час звертайтеся до поліції за номером <a href=\"tel:110\" style=\"color: var(--portal-primary); text-decoration: none;\">110</a>, якщо вам із дітьми немає де безпечно зупинитися.</li>\n                    <li>Письмово повідомте вашого куратора в Jobcenter одразу після отримання повідомлення про виселення. Не зволікайте.</li>\n                    <li>Зберігайте копії договору оренди, офіційних повідомлень та листування.</li>\n                </ul>\n            </div>\n\n            <div class=\"portal-card\">\n                <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\">Брак продуктів харчування та речей першої потреби</h4>\n                <ul style=\"padding-left: 20px;\">\n                    <li>Зверніться до <strong>Jobcenter</strong> або <strong>Sozialamt</strong>, якщо виплати допомоги затримуються.</li>\n                    <li>Зверніться до місцевих продовольчих банків (<strong>Tafel</strong>), Caritas або Diakonie для отримання екстреної допомоги.</li>\n                </ul>\n            </div>\n        </div>\n\n        <div class=\"portal-card mt-4\">\n            <h4 class=\"h5 fw-bold\" style=\"color: #0f172a;\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg> Аварії комунальних служб, витік газу та втрата документів</h4>\n            <ul style=\"margin-top: 10px; padding-left: 20px;\">\n                <li><strong>Запах газу:</strong> Не використовуйте вимикачі світла та відкритий вогонь. Негайно залишіть приміщення та телефонуйте <a href=\"tel:112\" style=\"color: var(--portal-danger); text-decoration: none; font-weight: bold;\">112</a>.</li>\n                <li><strong>Відключення опалення / водопостачання:</strong> Зафіксуйте проблему на фото, негайно письмово повідомте орендодавця або управляючу компанію.</li>\n                <li><strong>Гаряча лінія водоканалу Арцберга:</strong> З питань міського водопостачання та прориву труб в Арцбергу: <a href=\"tel:0923340440\" style=\"color: var(--portal-primary); text-decoration: none;\">09233 404-40</a>.</li>\n                <li><strong>Втрата документів:</strong> Подайте заяву до поліції у разі крадіжки, негайно заблокуйте банківські картки та зверніться до відомства у справах іноземців щодо посвідки на проживання.</li>\n            </ul>\n        </div>\n    </div>\n\n    <!-- Section 7: City Directories -->\n    <div id=\"cities\" class=\"portal-block\">\n        <div class=\"block-heading\">\n            <h3><i class=\"fa-solid fa-city\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"></line><path d=\"M12 20V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v16\"></path><path d=\"M4 20V10a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v10\"></path><line x1=\"2\" y1=\"20\" x2=\"22\" y2=\"20\"></line></svg> Регіональні органи влади та каталоги міст</h3>\n            <p class=\"text-muted\" style=\"color: var(--portal-text-muted) !important;\">Ключові адміністративні установи, відділки поліції та місцеві відділення екстреної допомоги у Північній Баварії.</p>\n        </div>\n        \n        <div class=\"city-directory-grid\">\n            <!-- Hof -->\n            <div class=\"city-card\">\n                <h4>Гоф (Місто та район)</h4>\n                <p><strong>Ратуша:</strong> Klosterstraße 1, 95028 Hof | <a href=\"tel:092818150\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 815-0</a></p>\n                <p><strong>Отдел реєстрації:</strong> Karolinenstraße 40 | <a href=\"tel:092818151450\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 815-1450</a></p>\n                <p><strong>Jobcenter Hof Stadt:</strong> Äußere Bayreuther Str. 2 | <a href=\"tel:09281785950\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 785-950</a></p>\n                <p><strong>Jobcenter Hof Land (Мюнхберг):</strong> Amtsgasse 4 | <a href=\"tel:092817396888\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 7396888</a></p>\n                <p><strong>Поліція (PI Hof):</strong> Kulmbacher Str. 101 | <a href=\"tel:092817040\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 704-0</a> (Екстрен: <a href=\"tel:110\" style=\"color: var(--portal-primary); text-decoration: none;\">110</a>)</p>\n                <p><strong>Лікарня (Sana Klinikum Hof):</strong> Eppenreuther Str. 9 | Приймальне: <a href=\"tel:09281983399\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 98-3399</a></p>\n            </div>\n\n            <!-- Helmbrechts -->\n            <div class=\"city-card\">\n                <h4>Хельмбрехтс</h4>\n                <p><strong>Ратуша:</strong> Luitpoldstraße 21, 95233 Helmbrechts | <a href=\"tel:092527010\" style=\"color: var(--portal-primary); text-decoration: none;\">09252 701-0</a></p>\n                <p><strong>Jobcenter:</strong> Обслуговується через Jobcenter Hof Land (Філія Мюнхберг: <a href=\"tel:092817396833\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 7396833</a>)</p>\n                <p><strong>Поліція (PI Münchberg):</strong> Angerstraße 29, 95213 Münchberg | <a href=\"tel:09251870040\" style=\"color: var(--portal-primary); text-decoration: none;\">09251 87004-0</a></p>\n            </div>\n\n            <!-- Münchberg -->\n            <div class=\"city-card\">\n                <h4>Мюнхберг</h4>\n                <p><strong>Ратуша:</strong> Ludwigstraße 15, 95213 Münchberg | <a href=\"tel:092518740\" style=\"color: var(--portal-primary); text-decoration: none;\">09251 874-0</a></p>\n                <p><strong>Філія Jobcenter:</strong> Amtsgasse 4 | <a href=\"tel:092817396833\" style=\"color: var(--portal-primary); text-decoration: none;\">09281 7396833</a></p>\n                <p><strong>Відділок поліції:</strong> Angerstraße 29 | <a href=\"tel:09251870040\" style=\"color: var(--portal-primary); text-decoration: none;\">09251 87004-0</a></p>\n            </div>\n\n            <!-- Naila & Bad Steben -->\n            <div class=\"city-card\">\n                <h4>Найла та Бад-Штебен</h4>\n                <p><strong>Ратуша Найла:</strong> Marktplatz 12 | <a href=\"tel:09282680\" style=\"color: var(--portal-primary); text-decoration: none;\">09282 68-0</a></p>\n                <p><strong>Ратуша Бад-Штебен:</strong> Hauptstraße 2 | <a href=\"tel:09288740\" style=\"color: var(--portal-primary); text-decoration: none;\">09288 74-0</a></p>\n                <p><strong>Поліція (PI Naila):</strong> Anger 24, 95119 Naila | <a href=\"tel:09282979040\" style=\"color: var(--portal-primary); text-decoration: none;\">09282 97904-0</a></p>\n            </div>\n\n            <!-- Selb -->\n            <div class=\"city-card\">\n                <h4>Зельб</h4>\n                <p><strong>Ратуша та реєстрація:</strong> Ludwigstraße 6 | <a href=\"tel:092878830\" style=\"color: var(--portal-primary); text-decoration: none;\">09287 883-0</a></p>\n                <p><strong>Jobcenter Fichtelgebirge:</strong> Poststraße 7 | <a href=\"tel:09287991176\" style=\"color: var(--portal-primary); text-decoration: none;\">09287 9911-76</a></p>\n                <p><strong>Медицина:</strong> Medizincampus Selb / Klinikum Fichtelgebirge | <a href=\"tel:092879710\" style=\"color: var(--portal-primary); text-decoration: none;\">09287 971-0</a></p>\n                <p><strong>Відділок поліції:</strong> Försterstraße 2a | <a href=\"tel:0928799140\" style=\"color: var(--portal-primary); text-decoration: none;\">09287 9914-0</a></p>\n            </div>\n\n            <!-- Wunsiedel -->\n            <div class=\"city-card\">\n                <h4>Вунзідель</h4>\n                <p><strong>Ратуша:</strong> Marktplatz 6 | <a href=\"tel:092326020\" style=\"color: var(--portal-primary); text-decoration: none;\">09232 602-0</a></p>\n                <p><strong>Центральне приймальне відділення лікарні (Марктредвіц):</strong> Schillerhain 1–8 | Приймальне: <a href=\"tel:092318092120\" style=\"color: var(--portal-primary); text-decoration: none;\">09231 809-2120</a></p>\n                <p><strong>Поліція (PI Wunsiedel):</strong> Kemnather Straße 31 | <a href=\"tel:0923299470\" style=\"color: var(--portal-primary); text-decoration: none;\">09232 9947-0</a></p>\n            </div>\n\n            <!-- Arzberg & Marktredwitz -->\n            <div class=\"city-card\">\n                <h4>Арцберг та Марктредвіц</h4>\n                <p><strong>Ратуша Арцберг:</strong> Friedrich-Ebert-Straße 6 | <a href=\"tel:092334040\" style=\"color: var(--portal-primary); text-decoration: none;\">09233 404-0</a></p>\n                <p><strong>Ратуша Марктредвіц:</strong> Egerstraße 2 | <a href=\"tel:092315010\" style=\"color: var(--portal-primary); text-decoration: none;\">09231 501-0</a></p>\n                <p><strong>Приймальне відділення лікарні:</strong> Klinikum Fichtelgebirge Marktredwitz | Приймальне: <a href=\"tel:092318092120\" style=\"color: var(--portal-primary); text-decoration: none;\">09231 809-2120</a></p>\n                <p><strong>Поліція (PI Marktredwitz):</strong> Karlsbader Straße 2 | <a href=\"tel:0923196760\" style=\"color: var(--portal-primary); text-decoration: none;\">09231 9676-0</a></p>\n            </div>\n\n            <!-- Kulmbach -->\n            <div class=\"city-card\">\n                <h4>Кульмбах</h4>\n                <p><strong>Ратуша:</strong> Marktplatz 1, 95326 Kulmbach | <a href=\"tel:092219400\" style=\"color: var(--portal-primary); text-decoration: none;\">09221 940-0</a></p>\n                <p><strong>Jobcenter Kulmbach:</strong> <a href=\"tel:0922182732200\" style=\"color: var(--portal-primary); text-decoration: none;\">09221 82732-200</a></p>\n                <p><strong>Лікарня (Klinikum Kulmbach):</strong> Albert-Schweitzer-Str. 10 | Приймальне: <a href=\"tel:09221980\" style=\"color: var(--portal-primary); text-decoration: none;\">09221 98-0</a></p>\n                <p><strong>Поліція (PI Kulmbach):</strong> Hardenbergstraße 2 | <a href=\"tel:092216090\" style=\"color: var(--portal-primary); text-decoration: none;\">09221 609-0</a></p>\n            </div>\n        </div>\n    </div>\n\n    <!-- Section 8: Direct Contact with Initiative -->\n    <div id=\"contact-team\" class=\"portal-block\">\n        <div class=\"portal-card contact-highlight-box text-center\" style=\"padding: 40px 20px;\">\n            <h3 class=\"fw-bold mb-3\" style=\"color: #0f172a;\"><i class=\"fa-solid fa-users\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m11 17 2 2a1 1 0 0 0 1.4 0l4.3-4.3a1 1 0 0 0 0-1.4l-2.1-2.1a1 1 0 0 0-1.4 0L12 14\"></path><path d=\"m13 11 2-2a1 1 0 0 0 0-1.4L12.9 5.5a1 1 0 0 0-1.4 0L8.4 8.6a1 1 0 0 0 0 1.4l2.1 2.1a1 1 0 0 0 1.4 0z\"></path><path d=\"M2 11l4.5-4.5a2 2 0 0 1 2.8 0l1.2 1.2\"></path><path d=\"M22 13l-4.5 4.5a2 2 0 0 1-2.8 0l-1.2-1.2\"></path></svg> Зв'язатися з нашою волонтерською командою підтримки</h3>\n            <p class=\"text-muted mx-auto mb-4\" style=\"max-width: 700px; color: var(--portal-text-muted);\">Звертайтеся до нас у ситуаціях, що не становлять загрози для життя, за допомогою з перекладом, документами Jobcenter, консультаціями щодо Anmeldung або нагальними базовими потребами:</p>\n            \n            <div class=\"services-pills-wrap\">\n                <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M12 2C6.5 2 2 4.5 2 8c0 1.5.8 2.8 2 3.8V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.2c1.2-1 2-2.3 2-3.8 0-3.5-4.5-6-10-6z\"></path></svg> Брак продуктів • <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z\"></path></svg> Необхідний одяг • <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline></svg> Питання з Jobcenter • <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><rect x=\"4\" y=\"2\" width=\"16\" height=\"20\" rx=\"2\" ry=\"2\"></rect><line x1=\"9\" y1=\"6\" x2=\"9\" y2=\"6.01\"></line><line x1=\"15\" y1=\"6\" x2=\"15\" y2=\"6.01\"></line><line x1=\"9\" y1=\"10\" x2=\"9\" y2=\"10.01\"></line><line x1=\"15\" y1=\"10\" x2=\"15\" y2=\"10.01\"></line><line x1=\"9\" y1=\"14\" x2=\"9\" y2=\"14.01\"></line><line x1=\"15\" y1=\"14\" x2=\"15\" y2=\"14.01\"></line><line x1=\"9\" y1=\"18\" x2=\"15\" y2=\"18\"></line></svg> Допомога з Anmeldung • <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg> Ризик виселення • <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"></rect><circle cx=\"9\" cy=\"10\" r=\"2\"></circle><path d=\"M15 8h2\"></path><path d=\"M15 12h2\"></path><path d=\"M7 16h10\"></path></svg> Втрата документів\n            </div>\n\n            <div class=\"contact-methods-grid mb-4\">\n                <div class=\"method-box\"><strong>WhatsApp:</strong> <a href=\"https://wa.me/4917631189912\" target=\"_blank\" style=\"color: #16a34a; text-decoration: none;\">Зв'язатися з Анною та Беном</a></div>\n                <div class=\"method-box\"><strong>Email:</strong> <a href=\"mailto:support@ukraine-oberfranken.de\" style=\"color: var(--portal-primary); text-decoration: none;\">Надіслати прямий Email</a></div>\n            </div>\n\n            <p style=\"color: var(--portal-text-muted); font-size: 0.9rem; max-width: 800px; margin: 0 auto 25px auto;\">Усі послуги супроводу, які надає наша соціальна ініціатива, є повністю волонтерськими та безкоштовними. Ми працюємо переважно в містах Гоф, Хельмбрехтс, Мюнхберг, Зельб, Вунзідель, Арцберг, Марктредвіц, Найла, Кульмбах та Бад-Штебен.</p>\n\n            <!-- Action Buttons: WhatsApp + Link to Details Page -->\n            <div class=\"action-buttons-group\">\n                <a href=\"https://wa.me/4917631189912\" target=\"_blank\" class=\"portal-btn btn-whatsapp\"><i class=\"fa-brands fa-whatsapp\"></i> Терміновий запит через WhatsApp</a>\n                <a href=\"request-assistance.html\" class=\"portal-btn btn-outline\"><i class=\"fa-solid fa-file-pen\"></i> Форма запиту про допомогу</a>\n            </div>\n        </div>\n    </div>\n\n    <!-- Footer Quick Reminder -->\n    <div class=\"portal-footer-reminder\">\n        <h3><i class=\"fa-solid fa-bell\"></i> <svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -0.125em;\"><path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"></path><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"></path></svg> Короткий довідник важливих номерів</h3>\n        <div class=\"footer-numbers-grid mb-3\">\n            <div><strong>Швидка / Пожежна:</strong> <a href=\"tel:112\" style=\"color: #000000; text-decoration: underline;\">112</a></div>\n            <div><strong>Поліція:</strong> <a href=\"tel:110\" style=\"color: #000000; text-decoration: underline;\">110</a></div>\n            <div><strong>Черговий лікар:</strong> <a href=\"tel:116117\" style=\"color: #000000; text-decoration: underline;\">116 117</a></div>\n            <div><strong>Допомога жінкам:</strong> <a href=\"tel:116016\" style=\"color: #000000; text-decoration: underline;\">116 016</a></div>\n            <div><strong>Гаряча лінія для молоді:</strong> <a href=\"tel:116111\" style=\"color: #000000; text-decoration: underline;\">116 111</a></div>\n            <div><strong>Токсикологія:</strong> <a href=\"tel:08919240\" style=\"color: #000000; text-decoration: underline;\">089 19240</a></div>\n        </div>\n        <div class=\"footer-emergency-warning\">У разі сумнівів щодо тяжкості кризової ситуації завжди негайно телефонуйте за номерами 112 або 110.</div>\n    </div>\n\n</section>",
          "_cid": "vqd8N2Jfnd",
          "_anchor": "people04-1k",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 scalem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"50\" max=\"400\" step=\"10\" value=\"150\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Lists\" name=\"showLists\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"list\" min=\"1\" max=\"5\" step=\"1\" value=\"4\" condition=\"showLists\">\n        <input type=\"color\" title=\"List Active Color\" value=\"#ffffff\" name=\"activeList\" condition=\"showLists\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Social Active Color\" value=\"#FF5753\" name=\"active\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#635d60\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#0c2c68\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#292325\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            \n            <!-- עמודת טקסט וכותרת ראשית -->\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showTitle || showText || showButtons || showLogo\">\n                <div class=\"content-wrapper\">\n                    <!-- תוספת המקום ללוגו -->\n                    <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"Logo\">\n                        </a>\n                    </div>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>\n                        ZUSAMMENLEBEN\n                    </b></h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                        Підтримка інтеграції, пошук житла та зв'язок зі спільнотою для новоприбулих і місцевих жителів регіону.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-phone mbr-iconfont mbr-iconfont-btn\"></span>\n                            Зв'язатися з нами\n                        </a></div>\n                </div>\n            </div>\n\n            <!-- עמודות הקישורים -->\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLists\">\n                <div class=\"lists-wrapper\">\n                    <div class=\"list-wrap\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Головна</a></li>\n                            <li class=\"item-wrap\"><a href=\"family-stories.html\" class=\"text-white\">Історії родин</a></li>\n                            <li class=\"item-wrap\"><a href=\"services.html\" class=\"text-white\">Послуги</a></li>\n                            <li class=\"item-wrap\"><a href=\"request-assistance.html\" class=\"text-white\">Запит на допомогу</a></li>\n                            <li class=\"item-wrap\"><a href=\"community.html\" class=\"text-white\">Спільнота</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"living-in-germany.html\" class=\"text-white\">Життя в Німеччині</a></li>\n                            <li class=\"item-wrap\"><a href=\"glossary.html\" class=\"text-white\">Глосарій</a></li>\n                            <li class=\"item-wrap\"><a href=\"learning-german.html\" class=\"text-white\">Вивчення німецької</a></li>\n                            <li class=\"item-wrap\"><a href=\"refugee-rights.html\" class=\"text-white\">Права біженців</a></li>\n                            <li class=\"item-wrap\"><a href=\"anna-shishoili.html\" class=\"text-white\">Анна Шишашвілі</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 2\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"how-to-help.html\" class=\"text-white\">Як ви можете допомогти</a></li>\n                            <li class=\"item-wrap\"><a href=\"social-activity.html\" class=\"text-white\">Соціальна діяльність</a></li>\n                            <li class=\"item-wrap\"><a href=\"faq.html\" class=\"text-white\">Часті запитання (FAQ)</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Регіони діяльності</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 3\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"emergency.html\" class=\"text-white\">Екстрена допомога</a></li>\n                            <li class=\"item-wrap\"><a href=\"Contact.html\" class=\"text-white\">Контакти</a></li>\n                            <li class=\"item-wrap\"><a href=\"https://wa.me/380637004615\" class=\"text-white\" target=\"_blank\">Підтримка у WhatsApp</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Локація</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 4\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"privacy.html\" class=\"text-white\">Політика конфіденційності</a></li>\n                            <li class=\"item-wrap\"><a href=\"usingtheweb.html\" class=\"text-white\">Умови використання</a></li>\n                            <li class=\"item-wrap\"><a href=\"impressum.html\" class=\"text-white\">Вихідні дані (Impressum)</a></li>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Офіційний сайт</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- אזור זכויות יוצרים ורשתות חברתיות -->\n            <div class=\"col-12\" mbr-if=\"showSocial || showCopy\">\n                <div class=\"copy-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://wa.me/380637004615\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-whatsapp\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"mailto:info@zusammenleben.de\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy, .social-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\">\n                        © Copyright 2026 Zusammenleben - Всі права захищені\n                    </p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "footer01-2b",
          "_isUserblock": true,
          "_cid": "vqpoIpWKp1",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "family-stories.html": {
      "settings": {
        "title": "Family Stories",
        "order": "14",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/family-stories.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/family-stories.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/family-stories.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/family-stories.html\" />"
      },
      "components": [
        {
          "_name": "amenu1",
          "_sourceTheme": "solarm5",
          "_styles": {
            "& when (@sticky)": {
              "position": "sticky !important",
              "top": "0 !important",
              "z-index": "1030 !important",
              "width": "100%",
              "nav.navbar, .navbar-dropdown, .navbar-fixed-top": {
                "position": "relative !important"
              }
            },
            "& when not (@sticky)": {
              "position": "relative",
              "z-index": "1030",
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "body": {
              "position": "relative"
            },
            ".navbar": {
              "min-height": "80px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".navbar-logo img": {
                "width": "auto"
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-logo img": {
                  "height": "2.5rem !important"
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".container, .container-fluid": {
              "display": "flex",
              "flex-wrap": "wrap",
              "margin": "auto",
              "align-items": "center"
            },
            ".brand-container": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding-bottom": "4px",
              "padding-top": "4px",
              "width": "100%"
            },
            ".navbar-brand": {
              "min-height": "60px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "5px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              "display": "flex",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            "@media (min-width: 992px)": {
              ".brand-container": {
                "width": "auto",
                "flex-grow": "1",
                "justify-content": "flex-start"
              },
              ".navbar-brand": {
                "padding-right": "20px"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "padding-top": "10px",
                "padding-bottom": "10px",
                "display": "flex !important",
                "flex-basis": "auto",
                ".navbar-nav": {
                  "margin": "0 -0.5em",
                  "flex-grow": "1",
                  "justify-content": "flex-end"
                },
                ".mbr-section-btn": {
                  "margin-left": "auto"
                }
              },
              ".desktop-only-flex": {
                "display": "flex !important",
                "justify-content": "flex-end",
                "align-items": "center",
                "gap": "3px",
                "flex-wrap": "nowrap",
                "margin-left": "auto",
                "padding-right": "20px"
              },
              ".mobile-only": {
                "display": "none !important"
              }
            },
            "@media (max-width: 991px)": {
              ".navbar": {
                "min-height": "60px !important"
              },
              ".desktop-only-flex": {
                "display": "none !important"
              },
              ".mobile-only": {
                "display": "flex !important",
                "align-items": "center",
                "gap": "3px",
                "background": "rgba(0, 0, 0, 0.03)",
                "padding": "2px 5px",
                "border-radius": "20px",
                "border": "1px solid #eaeaea",
                "margin-left": "auto",
                "margin-right": "8px"
              },
              ".navbar-brand": {
                "flex-shrink": "initial",
                "flex-basis": "auto",
                "word-break": "break-word",
                "padding-right": "0.5rem",
                "min-height": "50px"
              },
              ".navbar-logo img": {
                "height": "2.3rem !important"
              },
              ".navbar-collapse": {
                "padding-top": "2px !important",
                "padding-bottom": "5px !important",
                "border-top": "1px solid #dddddd",
                "background": "@menuBgColor"
              },
              ".navbar-nav .nav-item": {
                "margin": "0 !important"
              },
              ".navbar-nav .nav-link": {
                "padding": "0.2rem 0.4rem !important",
                "font-size": "0.82rem !important",
                "margin": "0 !important",
                "justify-content": "center"
              },
              ".dropdown-menu .dropdown-item": {
                "padding": "0.25rem 0.8rem !important",
                "font-size": "0.78rem !important",
                "margin": "0 !important",
                "text-align": "center"
              },
              ".mbr-section-btn": {
                "display": "flex",
                "flex-wrap": "wrap",
                "justify-content": "center",
                "padding": "2px 0",
                ".btn": {
                  "padding": "0.35rem 0.8rem !important",
                  "font-size": "0.82rem !important",
                  "flex-grow": "1",
                  "margin": "4px 15px"
                }
              },
              "nav.opened .dropdown-menu": {
                "top": "0"
              }
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border-bottom": "1px solid #e6e6e6",
              "padding": "0.5rem 1.8rem",
              "transition": "all 0.25s ease-in-out",
              "&:hover, &:focus": {
                "background": "@primaryColor !important",
                "color": "white !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom": "none",
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative",
              "transition": "all 0.2s",
              "&:hover": {
                "color": "@primaryColor !important"
              }
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".navbar-buttons": {
              "text-align": "center",
              "min-width": "150px"
            },
            ".card-wrap": {
              "display": "flex",
              "align-items": "center",
              "padding": "2px 4px",
              "min-width": "auto"
            },
            ".contacts-menu .mbr-iconfont": {
              "color": "#ffffff"
            },
            ".contacts-menu .menu-divider": {
              "color": "#ccc",
              "font-weight": "300",
              "margin": "0 1px"
            },
            ".desktop-only-flex .mbr-iconfont": {
              "color": "@iconsContactColor"
            },
            ".flags-menu": {
              "display": "flex",
              "align-items": "center",
              "gap": "5px",
              "background": "rgba(0, 0, 0, 0.03)",
              "padding": "3px 8px",
              "border-radius": "20px",
              "border": "1px solid #eaeaea"
            },
            ".lang-link": {
              "display": "flex",
              "align-items": "center",
              "gap": "3px",
              "text-decoration": "none !important",
              "transition": "transform 0.2s ease",
              "&:hover": {
                "transform": "scale(1.08)"
              }
            },
            ".lang-code": {
              "font-size": "10px",
              "font-weight": "700",
              "color": "#333",
              "letter-spacing": "0.5px"
            },
            ".flag-divider": {
              "color": "#ccc",
              "font-size": "11px"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "28px",
              "height": "18px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "flex-basis": "auto",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "26px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "0",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "top": "6px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "top": "6px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "top": "12px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "6px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "6px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" global once=\"menu\">\n    <mbr-parameters>\n        <header>Розмір</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Повна ширина\" checked>\n        <header>Показати/Приховати</header>\n        <input type=\"checkbox\" title=\"Логотип\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Розмір логотипу\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Назва бренду\" name=\"showBrand\" checked>\n        <input type=\"checkbox\" title=\"Телефон\" name=\"showPhone\" checked>\n        <input type=\"checkbox\" title=\"Адреса\" name=\"showAddress\" checked>\n        <input type=\"color\" title=\"Колір іконок контактів\" name=\"iconsContactColor\" value=\"#0c2c68\" condition=\"showPhone || showAddress\">\n        <input type=\"checkbox\" title=\"Пункти меню\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Іконки\" name=\"showIcons\">\n        <select title=\"Кількість\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Колір іконок\" name=\"iconsColor\" value=\"#222222\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Кнопка\" name=\"showButtons\" checked>\n        <header>Стилі</header>\n        <input type=\"checkbox\" title=\"Закріплене\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Згорнуте\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Прозоре\" name=\"transparent\">\n        <input type=\"range\" title=\"Прозорість\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Колір\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Гамбургер\" name=\"hamburgerColor\" value=\"#222222\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                 'navbar-expand-lg':!collapsed,\n                 'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"brand-container\">\n                <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"Zusammen Leben\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                    <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-caption-wrap\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"index.html\" data-app-placeholder=\"Type Text\">Zusammen Leben</a></span>\n                </div>\n                \n                <!-- פרטי קשר + דגלים (מוצגים אך ורק במחשב) -->\n                <div class=\"contacts-menu desktop-only-flex\">\n                    <div class=\"card-wrap\">\n                        <span class=\"mobi-mbri-phone mobi-mbri\" style=\"font-size: 18px;\"></span>\n                        <div class=\"card-box\">\n                            <p class=\"mbr-text mbr-fonts-style mb-0 display-4\"><a href=\"tel:+380 63 700 4615\" class=\"text-primary\">+380 63 700 4615</a></p>\n                        </div>\n                    </div>\n                    \n                    <span class=\"menu-divider\">|</span>\n\n                    <div class=\"card-wrap\">\n                        <span class=\"mdi-maps-place\" style=\"font-size: 22px;\"></span>\n                        <div class=\"card-box\">\n                            <p class=\"mbr-text mbr-fonts-style mb-0 display-4\">Konradsreuth Alte Hofer Str. 1</p>\n                        </div>\n                    </div>\n\n                    <span class=\"menu-divider\">|</span>\n\n<div class=\"flags-menu\">\n    <a href=\"https://amit6630.github.io/ZusammenLeben/de/\" title=\"Deutsch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/de.png\" srcset=\"https://flagcdn.com/48x36/de.png 2x\" alt=\"Germany\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">DE</span>\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"https://amit6630.github.io/ZusammenLeben/\" title=\"English\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/us.png\" srcset=\"https://flagcdn.com/48x36/us.png 2x\" alt=\"United States\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">EN</span>\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"https://amit6630.github.io/ZusammenLeben/ua/\" title=\"Українська\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/ua.png\" srcset=\"https://flagcdn.com/48x36/ua.png 2x\" alt=\"Ukraine\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">UA</span>\n    </a>\n</div>\n                </div>\n\n                <!-- דגלים בלבד שיופיעו אך ורק בטלפון ליד ההמבורגר -->\n<div class=\"flags-menu mobile-only\">\n    <a href=\"https://amit6630.github.io/ZusammenLeben/de/\" title=\"Deutsch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/de.png\" alt=\"DE\" width=\"18\" height=\"13\">\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"https://amit6630.github.io/ZusammenLeben/\" title=\"English\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/us.png\" alt=\"EN\" width=\"18\" height=\"13\">\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"https://amit6630.github.io/ZusammenLeben/ua/\" title=\"Українська\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/ua.png\" alt=\"UA\" width=\"18\" height=\"13\">\n    </a>\n</div>\n\n                <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                    <div class=\"hamburger\">\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                </button>\n            </div>\n            \n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-scroll-collapse>\n                <ul class=\"navbar-nav nav-dropdown\" data-app-modern-menu=\"true\" mbr-menu><li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"index.html\" data-app-placeholder=\"Type Text\">Головна</a>\n                    </li>\n    \n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Про нас</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"social-activity.html\" data-app-placeholder=\"Type Text\">Наша діяльність</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"anna-shishoili.html\" data-app-placeholder=\"Type Text\">Анна Шишойлі</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"services.html\" data-app-placeholder=\"Type Text\">Послуги</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"request-assistance.html\" data-app-placeholder=\"Type Text\">Запит на допомогу</a>\n                    </li>\n    \n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Життя в Німеччині</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"glossary.html\" data-app-placeholder=\"Type Text\">Глосарій</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"learning-german.html\" data-app-placeholder=\"Type Text\">Вивчення німецької</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"refugee-rights.html\" data-app-placeholder=\"Type Text\">Права українських біженців</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"areasweserve.html#amenu1-1m\" data-app-placeholder=\"Type Text\">Регіони обслуговування</a>\n                    </li>\n\n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Спільнота</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"community.html\" data-app-placeholder=\"Type Text\">Наша спільнота</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"family-stories.html\" data-app-placeholder=\"Type Text\">Історії родин</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"faq.html#list01-b\" data-app-placeholder=\"Type Text\">Часті запитання</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"how-to-help.html\" data-app-placeholder=\"Type Text\">Як ви можете допомогти</a>\n                    </li>\n    \n                    <!-- Emergency - Highlighted in a separate prominent color -->\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link font-weight-bold display-4 text-primary\" href=\"emergency.html\" style=\"color: #ff3333 !important;\" data-app-placeholder=\"Type Text\">Екстрена допомога</a>\n                    </li></ul>\n                \n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary display-4\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">Зв'яжіться з нами</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
