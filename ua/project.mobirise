              "color": "#0f172a",
              "font-weight": "750"
            },
            ".zl-body h2:first-child": {
              "margin-top": "0"
            },
            ".zl-body p, .zl-body li": {
              "font-size": "17px"
            },
            ".zl-body p": {
              "margin": "0 0 14px"
            },
            "p, li, summary": {
              "line-height": "1.65 !important"
            },
            ".zl-body ul, .zl-body ol": {
              "padding-left": "1.3em",
              "margin": "0 0 16px"
            },
            ".zl-body li": {
              "margin-bottom": "8px"
            },
            ".zl-body a": {
              "color": "#1d4ed8",
              "text-decoration": "underline",
              "text-underline-offset": "2px",
