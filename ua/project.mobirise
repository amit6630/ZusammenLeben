              "color": "#2563eb",
              "margin-bottom": "16px"
            },
            ".link-card ul": {
              "list-style": "none",
              "padding": "0",
              "margin": "0"
            },
            ".link-card li": {
              "margin-bottom": "12px",
              "font-size": "0.95rem",
              "color": "#475569",
              "padding-left": "16px",
              "position": "relative"
            },
            ".link-card li::before": {
              "content": "\"•\"",
              "color": "#cbd5e1",
              "font-weight": "bold",
              "position": "absolute",
              "left": "0"
            },
            ".link-card a": {
              "color": "#0f172a",
              "text-decoration": "none",
              "font-weight": "600",
              "transition": "color 0.2s ease"
            },
            ".link-card a:hover": {
              "color": "#2563eb",
              "text-decoration": "underline"
            },
            ".cant-find-text": {
              "text-align": "center",
              "margin-top": "30px",
              "padding-top": "24px",
              "border-top": "1px solid #e2e8f0",
              "font-weight": "600",
              "color": "#475569"
            },
            "@media (max-width: 768px)": {
              ".faq-executive-section": {
                "padding": "40px 0 !important"
              },
              ".header-title": {
                "font-size": "2rem"
              },
              ".links-grid": {
                "grid-template-columns": "1fr"
              },
              ".disclaimer-card": {
                "flex-direction": "column",
                "gap": "12px",
                "padding": "20px"
              },
              ".custom-accordion .accordion-button": {
                "padding": "16px",
