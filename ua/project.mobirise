    "guide-mental-health.html": {
      "settings": {
        "title": "Психічне здоров'я: допомога українцям у Німеччині",
        "order": "33",
        "meta_descr": "Стрес, безсоння, горе й травма після війни: психологічна допомога, кризові лінії, психотерапія та підтримка дітей у Верхній Франконії.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-mental-health.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-mental-health.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-mental-health.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-mental-health.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-mental-health.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Психічне здоров'я: допомога українцям у Німеччині\" />\n<meta property=\"og:description\" content=\"Стрес, безсоння, горе й травма після війни: психологічна допомога, кризові лінії, психотерапія та підтримка дітей у Верхній Франконії.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-mental-health.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Психічне здоров'я: де знайти психологічну підтримку\",\"description\":\"Стрес, безсоння, горе й травма після війни: психологічна допомога, кризові лінії, психотерапія та підтримка дітей у Верхній Франконії.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-mental-health.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-mental-health.html\",\"wordCount\":922,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Чи безкоштовна психотерапія?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так. Психотерапію в ліцензованих терапевтів оплачує державна медична страховка.\"}},{\"@type\":\"Question\",\"name\":\"Чи потрібне направлення?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ні. Первинну консультацію можна записати напряму або через 116 117.\"}},{\"@type\":\"Question\",\"name\":\"Куди телефонувати вночі?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"У кризові служби Баварії за номером 0800 655 3000 або на телефон довіри 0800 111 0 111. У разі небезпеки — 112.\"}},{\"@type\":\"Question\",\"name\":\"Чи вплине терапія на мій дозвіл на проживання?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ні. Психологічна допомога не впливає на статус перебування і є конфіденційною.\"}},{\"@type\":\"Question\",\"name\":\"Чи є допомога для дітей?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так. Соціальні працівники шкіл, центри сімейного консультування та дитячі психотерапевти.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Психічне здоров'я: де знайти психологічну підтримку\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-mental-health.html\"}]}]}</script>"
      },
