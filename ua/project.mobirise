    "guide-bank-account-phone.html": {
      "settings": {
        "title": "Банківський рахунок, телефон і радіозбір: перші кроки",
        "order": "25",
        "meta_descr": "Як людям з України відкрити рахунок у Німеччині, безпечно обрати мобільний тариф і що робити з листом про радіомовний збір. Поради та права.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-bank-account-phone.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-bank-account-phone.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-bank-account-phone.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-bank-account-phone.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-bank-account-phone.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Банківський рахунок, телефон і радіозбір: перші кроки\" />\n<meta property=\"og:description\" content=\"Як людям з України відкрити рахунок у Німеччині, безпечно обрати мобільний тариф і що робити з листом про радіомовний збір. Поради та права.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-bank-account-phone.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Банківський рахунок, мобільний зв'язок і радіомовний збір\",\"description\":\"Як людям з України відкрити рахунок у Німеччині, безпечно обрати мобільний тариф і що робити з листом про радіомовний збір. Поради та права.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-bank-account-phone.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-bank-account-phone.html\",\"wordCount\":899,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Чи може банк відмовити мені в рахунку?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Кожен, хто законно проживає в ЄС, має право на базовий рахунок (Basiskonto). Банк може відмовити лише з вузьких законних підстав.\"}},{\"@type\":\"Question\",\"name\":\"Чи маю я платити радіомовний збір?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Його платить кожне домогосподарство, але ті, хто отримує виплати від Jobcenter, можуть подати заяву на звільнення.\"}},{\"@type\":\"Question\",\"name\":\"Чи можна відкликати договір, підписаний біля дверей?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Здебільшого так, протягом 14 днів. Відкликайте письмово і зберігайте підтвердження.\"}},{\"@type\":\"Question\",\"name\":\"Що таке P-Konto?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Захищений рахунок, що зберігає базову суму від арешту в разі боргів. Будь-який рахунок можна перетворити.\"}},{\"@type\":\"Question\",\"name\":\"Чи потрібне страхування відповідальності?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Воно не обов'язкове, але дуже рекомендоване. Воно недороге і покриває шкоду, заподіяну іншим.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Банківський рахунок, мобільний зв'язок і радіомовний збір\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-bank-account-phone.html\"}]}]}</script>"
      },
