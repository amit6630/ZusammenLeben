    "guide-university-study.html": {
      "settings": {
        "title": "Навчання в університеті Німеччини: посібник для українців",
        "order": "34",
        "meta_descr": "Вступ до університету, uni-assist, Studienkolleg, мовні іспити, BAföG і студентське життя: як молоді українці можуть навчатися в Баварії та інших землях.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-university-study.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-university-study.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-university-study.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-university-study.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-university-study.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Навчання в університеті Німеччини: посібник для українців\" />\n<meta property=\"og:description\" content=\"Вступ до університету, uni-assist, Studienkolleg, мовні іспити, BAföG і студентське життя: як молоді українці можуть навчатися в Баварії та інших землях.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-university-study.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Навчання в університеті Німеччини\",\"description\":\"Вступ до університету, uni-assist, Studienkolleg, мовні іспити, BAföG і студентське життя: як молоді українці можуть навчатися в Баварії та інших землях.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-university-study.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-university-study.html\",\"wordCount\":924,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Чи можна вступити з українським шкільним атестатом?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Часто не напряму. Можуть знадобитися завершені роки навчання в Україні або Studienkolleg. Університет чи uni-assist перевіряє ваш випадок.\"}},{\"@type\":\"Question\",\"name\":\"Який рівень німецької потрібен?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Для програм німецькою зазвичай C1, підтверджений DSH, TestDaF чи подібним іспитом.\"}},{\"@type\":\"Question\",\"name\":\"Чи є в Баварії плата за навчання?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"На більшості державних програм немає, але є семестровий внесок.\"}},{\"@type\":\"Question\",\"name\":\"Чи можу я отримувати BAföG?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Багато студентів із тимчасовим захистом можуть мати право. Запитайте у відділі BAföG студентської служби.\"}},{\"@type\":\"Question\",\"name\":\"Чи збережу я виплати Jobcenter як студент?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Як правило, ні, якщо програму можна фінансувати через BAföG. З'ясуйте до зарахування.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Навчання в університеті Німеччини\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-university-study.html\"}]}]}</script>"
      },
