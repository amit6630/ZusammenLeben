        {
          "alias": false,
          "_styles": {
            ".regional-executive-section": {
              "padding": "70px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.6",
              "direction": "ltr",
              "text-align": "left"
            },
            ".regional-executive-section *": {
              "box-sizing": "border-box"
            },
            ".executive-container": {
              "max-width": "1050px",
              "margin": "0 auto",
              "padding": "0 24px",
              "width": "100%"
            },
            ".executive-header": {
              "text-align": "center",
              "max-width": "780px",
              "margin": "0 auto 50px"
            },
            ".header-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-top": "50px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "border": "1px solid #bfdbfe"
            },
            ".header-title": {
              "font-size": "2.6rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.02em",
              "margin": "0 0 16px 0",
              "line-height": "1.2"
            },
            ".header-lead": {
              "font-size": "1.2rem",
              "color": "#475569",
              "margin": "0"
            },
            ".section-block": {
              "margin-bottom": "60px"
            },
            ".block-title": {
              "font-size": "1.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "24px",
              "display": "flex",
              "align-items": "center",
              "gap": "10px"
            },
            ".title-icon": {
              "font-size": "1.3rem",
              "display": "inline-flex",
              "align-items": "center"
            },
            ".philosophy-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "40px",
              "position": "relative",
              "overflow": "hidden",
              "margin-bottom": "60px",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.03)"
            },
            ".card-accent-line": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "6px",
              "height": "100%",
              "background": "#2563eb"
            },
            ".philosophy-card h2": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "margin": "0 0 14px 0",
              "color": "#0f172a"
            },
            ".philosophy-card p": {
              "font-size": "1.08rem",
              "color": "#334155",
              "margin": "0",
              "line-height": "1.7"
            },
            ".pillars-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(280px, 1fr))",
              "gap": "20px"
            },
            ".pillar-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "14px",
              "padding": "24px",
              "display": "flex",
              "gap": "16px",
              "transition": "transform 0.2s ease, box-shadow 0.2s ease",
              "min-width": "0"
            },
            ".pillar-card:hover": {
              "transform": "translateY(-3px)",
              "box-shadow": "0 12px 24px rgba(0, 0, 0, 0.04)",
              "border-color": "#cbd5e1"
            },
            ".pillar-icon": {
              "font-size": "1.8rem",
              "flex-shrink": "0",
              "background": "#f1f5f9",
              "width": "48px",
              "height": "48px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "border-radius": "10px"
            },
            ".pillar-content h3": {
              "font-size": "1.1rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 6px 0"
            },
            ".pillar-content p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.5"
            },
            ".map-layout-grid": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "gap": "24px",
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "20px",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.02)"
            },
            ".map-wrapper": {
              "width": "100%",
              "min-height": "420px",
              "border-radius": "12px",
              "overflow": "hidden",
              "border": "1px solid #cbd5e1"
            },
            ".towns-scroll-list": {
              "max-height": "420px",
              "overflow-y": "auto",
              "padding-right": "8px",
              "display": "flex",
              "flex-direction": "column",
              "gap": "12px"
            },
            ".town-row": {
              "background": "#f8fafc",
              "border": "1px solid #f1f5f9",
              "padding": "14px 16px",
              "border-radius": "10px"
            },
            ".town-row.focus-row": {
              "background": "#eff6ff",
              "border-color": "#bfdbfe"
            },
            ".town-name": {
              "font-size": "1rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "4px",
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center"
            },
            ".badge-tag": {
              "font-size": "0.7rem",
              "background": "#2563eb",
              "color": "#ffffff",
              "padding": "2px 8px",
              "border-radius": "100px",
              "font-weight": "700"
            },
            ".town-row p": {
              "font-size": "0.88rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.45"
            },
            ".towns-footnote": {
              "font-size": "0.88rem",
              "color": "#64748b",
              "margin-top": "14px",
              "font-style": "italic"
            },
            ".reality-comparison-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(280px, 1fr))",
              "gap": "24px"
            },
            ".reality-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "30px",
              "position": "relative"
            },
            ".reality-card.advantages": {
              "border-top": "4px solid #16a34a"
            },
            ".reality-card.considerations": {
              "border-top": "4px solid #d97706"
            },
            ".reality-badge": {
              "font-size": "0.7rem",
              "font-weight": "800",
              "color": "#16a34a",
              "letter-spacing": "1px",
              "margin-bottom": "8px"
            },
            ".warning-badge": {
              "color": "#d97706"
            },
            ".reality-card h3": {
              "font-size": "1.25rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "0 0 12px 0"
            },
            ".reality-card p": {
              "font-size": "0.98rem",
              "color": "#334155",
              "margin": "0",
              "line-height": "1.6"
            },
            ".scope-notice-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-left": "4px solid #64748b",
              "border-radius": "12px",
              "padding": "24px",
              "display": "flex",
              "gap": "16px",
              "margin-bottom": "50px"
            },
            ".notice-icon": {
              "font-size": "1.5rem",
              "flex-shrink": "0"
            },
            ".notice-body h4": {
              "font-size": "1rem",
              "font-weight": "700",
              "color": "#334155",
              "margin": "0 0 6px 0"
            },
            ".notice-body p": {
              "font-size": "0.92rem",
              "color": "#64748b",
              "margin": "0",
              "line-height": "1.5"
            },
            ".executive-cta-wrapper": {
              "text-align": "center"
            },
            ".regional-executive-section .btn-success": {
              "background-color": "#25d366 !important",
              "border-color": "#25d366 !important",
              "color": "#ffffff !important",
              "padding": "18px 36px !important",
              "border-radius": "100px !important",
              "font-weight": "700 !important",
              "font-size": "1.05rem !important",
              "display": "inline-flex !important",
              "align-items": "center !important",
              "justify-content": "center !important",
              "gap": "10px !important",
              "box-shadow": "0 8px 20px rgba(37, 211, 102, 0.2) !important",
              "transition": "all 0.25s ease !important",
              "text-decoration": "none !important",
              "max-width": "100%"
            },
            ".regional-executive-section .btn-success:hover": {
              "background-color": "#20bd5a !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 12px 25px rgba(37, 211, 102, 0.3) !important"
            },
            "@media (max-width: 900px)": {
              ".map-layout-grid": {
                "grid-template-columns": "1fr",
                "padding": "16px"
              },
              ".map-wrapper": {
                "min-height": "280px"
              },
              ".towns-scroll-list": {
                "max-height": "350px"
              }
            },
            "@media (max-width: 640px)": {
              ".regional-executive-section": {
                "padding": "40px 0 !important"
              },
              ".executive-container": {
                "padding": "0 16px"
              },
              ".executive-header": {
                "margin-bottom": "32px"
              },
              ".header-title": {
                "font-size": "1.8rem"
              },
              ".header-lead": {
                "font-size": "1rem"
              },
              ".section-block": {
                "margin-bottom": "40px"
              },
              ".block-title": {
                "font-size": "1.25rem"
              },
              ".philosophy-card": {
                "padding": "20px 16px 20px 22px",
                "margin-bottom": "40px"
              },
              ".philosophy-card h2": {
                "font-size": "1.2rem"
              },
              ".philosophy-card p": {
                "font-size": "0.98rem"
              },
              ".pillars-grid, .reality-comparison-grid": {
                "grid-template-columns": "1fr",
                "gap": "14px"
              },
              ".pillar-card": {
                "padding": "16px"
              },
              ".reality-card": {
                "padding": "20px 16px"
              },
              ".scope-notice-card": {
                "flex-direction": "row",
                "padding": "16px",
                "gap": "12px",
                "margin-bottom": "32px"
              },
              ".regional-executive-section .btn-success": {
                "width": "100% !important",
                "padding": "16px 20px !important",
                "font-size": "1rem !important"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
