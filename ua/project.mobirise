    "guide-vocational-training.html": {
      "settings": {
        "title": "Професійне навчання (Ausbildung) у Німеччині просто",
        "order": "35",
        "meta_descr": "Як працює дуальна система навчання, яким професіям можна навчитися, оплата, як подаватися і яка підтримка є для молоді та дорослих з України.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-vocational-training.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-vocational-training.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-vocational-training.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-vocational-training.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-vocational-training.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Професійне навчання (Ausbildung) у Німеччині просто\" />\n<meta property=\"og:description\" content=\"Як працює дуальна система навчання, яким професіям можна навчитися, оплата, як подаватися і яка підтримка є для молоді та дорослих з України.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-vocational-training.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Професійне навчання (Ausbildung) простими словами\",\"description\":\"Як працює дуальна система навчання, яким професіям можна навчитися, оплата, як подаватися і яка підтримка є для молоді та дорослих з України.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-vocational-training.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-vocational-training.html\",\"wordCount\":953,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Чи оплачується професійне навчання?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так. Учні отримують щомісячну стипендію, яка зростає щороку, і мають повне соціальне страхування.\"}},{\"@type\":\"Question\",\"name\":\"Чи є вікове обмеження?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ні. Дорослі можуть почати професійне навчання в будь-якому віці.\"}},{\"@type\":\"Question\",\"name\":\"Наскільки добре треба знати німецьку?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Більшість підприємств очікують щонайменше B1, краще B2. Мовна підтримка під час навчання можлива.\"}},{\"@type\":\"Question\",\"name\":\"Коли починається навчання?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Зазвичай 1 серпня або 1 вересня. Подавайтеся до року наперед; у ремеслах місця часто є ще влітку.\"}},{\"@type\":\"Question\",\"name\":\"Що таке Einstiegsqualifizierung?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Оплачувана довготривала практика на 6–12 місяців, яка готує до навчання і часто веде до місця на тому ж підприємстві.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Професійне навчання (Ausbildung) простими словами\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-vocational-training.html\"}]}]}</script>"
      },
