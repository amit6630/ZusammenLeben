    "guide-winter-heating.html": {
      "settings": {
        "title": "Зима в Німеччині: опалення, пліснява та рахунки",
        "order": "48",
        "meta_descr": "Як правильно опалювати й провітрювати, уникати плісняви, читати рахунки за енергію, економити електрику й отримати допомогу з витратами.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-winter-heating.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-winter-heating.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-winter-heating.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-winter-heating.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-winter-heating.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Зима в Німеччині: опалення, пліснява та рахунки\" />\n<meta property=\"og:description\" content=\"Як правильно опалювати й провітрювати, уникати плісняви, читати рахунки за енергію, економити електрику й отримати допомогу з витратами.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-winter-heating.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Як пережити німецьку зиму\",\"description\":\"Як правильно опалювати й провітрювати, уникати плісняви, читати рахунки за енергію, економити електрику й отримати допомогу з витратами.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-winter-heating.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-winter-heating.html\",\"wordCount\":879,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Що означає рівень 3 на радіаторі?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Близько 20 °C. Цифри — цільові температури, а не потужність; рівень 5 не гріє швидше.\"}},{\"@type\":\"Question\",\"name\":\"Як правильно провітрювати взимку?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Відчиняти вікна навстіж на п'ять–десять хвилин двічі–чотири рази на день, а не тримати їх відкритими на провітрювання годинами.\"}},{\"@type\":\"Question\",\"name\":\"Хто платить за видалення плісняви?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Орендодавець, якщо причина в будівельних дефектах. Повідомте про плісняву письмово з фото.\"}},{\"@type\":\"Question\",\"name\":\"Чи оплачує Jobcenter опалення?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так, обґрунтовані витрати на опалення додатково до оренди, зокрема доплати. Електрика входить до базової виплати.\"}},{\"@type\":\"Question\",\"name\":\"Чи мушу я прибирати сніг?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Часто так, по черзі з іншими орендарями. Перевірте договір оренди чи правила будинку.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Як пережити німецьку зиму\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-winter-heating.html\"}]}]}</script>"
      },
