              "font-size": "1.05rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".guide-mini-card p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.5"
            },
            ".subsection-title": {
              "font-size": "1.1rem",
              "font-weight": "700",
              "margin-top": "32px",
              "margin-bottom": "16px",
              "color": "#0f172a"
            },
            ".action-steps-list": {
