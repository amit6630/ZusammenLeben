              "border-top": "1px solid #e2e8f0"
            },
            ".cta-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "30px"
            },
            ".cta-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "padding": "45px",
              "border-radius": "28px",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.04)"
            },
            ".cta-families": {
              "background": "linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%)",
              "border-color": "#bae6fd"
            },
            ".cta-supporters": {
              "background": "linear-gradient(135deg, #ffffff 0%, #f8fafc 100%)"
            },
            ".cta-badge": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "1.2px"
            },
            ".cta-card h3": {
              "font-size": "1.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "10px 0 14px"
            },
            ".cta-card p": {
              "color": "#475569",
              "font-size": "1.05rem",
              "margin-bottom": "30px"
            },
            ".cta-card .mbr-section-btn": {
              "justify-content": "flex-start",
              "margin-bottom": "0"
            },
            "@media (max-width: 992px)": {
              ".hero-title": {
                "font-size": "2.8rem"
              },
              ".manifesto-card": {
                "padding": "35px"
              },
              ".services-section, .process-section, .region-section, .transparency-section, .cta-section": {
                "padding": "80px 0"
              }
            },
            "@media (max-width: 768px)": {
              ".mobirise-home-section .portal-container": {
                "padding-left": "16px !important",
                "padding-right": "16px !important"
              },
              ".services-section, .process-section, .region-section, .transparency-section, .cta-section": {
                "padding": "60px 0"
              },
              ".hero-wrapper": {
                "padding": "60px 0 50px"
              },
              ".hero-title": {
                "font-size": "2.2rem"
              },
              ".section-main-title": {
                "font-size": "2rem"
              }
            },
            "@media (max-width: 640px)": {
              ".hero-title": {
                "font-size": "1.9rem"
              },
              ".mobirise-home-section .btn": {
                "width": "100% !important",
                "justify-content": "center !important"
              },
              ".team-profile-card": {
                "flex-direction": "column",
                "align-items": "center",
                "text-align": "center",
                "padding": "30px 20px"
              },
              ".team-avatar": {
                "margin-bottom": "8px",
                "width": "85px",
                "height": "85px"
              },
              ".timeline-step": {
                "flex-direction": "column",
                "align-items": "flex-start",
                "padding": "24px"
              },
              ".step-badge": {
                "margin-bottom": "10px"
              },
              ".notice-callout": {
                "flex-direction": "column",
                "text-align": "center"
              },
              ".matrix-card, .cta-card, .manifesto-card": {
                "padding": "24px"
              }
            },
            "@media (max-width: 400px)": {
              ".metrics-grid, .services-grid, .transparency-grid, .cta-grid": {
                "grid-template-columns": "1fr"
              },
              ".mobirise-home-section .btn": {
                "padding": "14px 20px !important",
                "font-size": "0.95rem !important"
              }
            },
            "P": {
              "text-align": "left"
            },
            "H3": {
              "text-align": "left"
            }
          },
          "_name": "article01",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"mobirise-home-section\" id=\"global-home-portal\">\n    <div class=\"portal-wrapper\">\n        \n        <!-- Hero Section -->\n        <div class=\"hero-wrapper\">\n            <div class=\"portal-container\">\n                <div class=\"hero-badge-group\">\n                    <span class=\"pulse-indicator\"></span>\n                    <span class=\"badge-text\">Офіційна волонтерська ініціатива • Верхня Франконія, Баварія</span>\n                </div>\n                \n                <h1 class=\"hero-title\">\n                    Гідна підтримка, житло та спільнота для українських родин у Північній Баварії\n                </h1>\n                \n                <p class=\"hero-subtitle\">\n                    Комплексна, 100% безкоштовна допомога у проходженні німецької бюрократії, пошуку житла, перекладі та влаштуванні дітей до шкіл.\n                </p>\n\n                <!-- Mobirise Interactive CTA Buttons -->\n                <div class=\"mbr-section-btn hero-cta-bar\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn btn-success display-4\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\" style=\"background-color: #25D366 !important; border-color: #25D366 !important;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 6px;\"><path d=\"M12.031 2c-5.514 0-9.996 4.482-9.996 9.996 0 1.763.459 3.486 1.332 5.013l-1.417 5.176 5.297-1.389c1.474.804 3.141 1.226 4.784 1.226 5.514 0 9.996-4.482 9.996-9.996 0-5.514-4.482-9.996-9.996-9.996zm0 18.286c-1.479 0-2.929-.396-4.195-1.147l-.301-.179-3.12.818.832-3.041-.197-.313c-.822-1.309-1.256-2.825-1.256-4.372 0-4.413 3.587-8 8-8s8 3.587 8 8-3.587 8.034-8 8.034z\"></path></svg> Написати нам у WhatsApp\n                    </a>\n                    <a class=\"btn btn-primary\" href=\"Contact.html#footer4-19\" data-app-placeholder=\"Type Text\">\n                        <span class=\"btn-icon\" style=\"display: inline-flex; align-items: center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 6px;\"><path d=\"M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z\"></path></svg></span> Зв'язатися електронною поштою\n                    </a></div>\n\n                <!-- White Manifesto Box -->\n                <div class=\"manifesto-card\">\n                    <div class=\"manifesto-header\">\n                        <span class=\"manifesto-tag\">НАША МІСІЯ ТА ДІЯЛЬНІСТЬ</span>\n                        <h2>Місцева особиста опора у Верхній Франконії</h2>\n                    </div>\n                    <div class=\"manifesto-body\">\n                        <p> \n                            З початку війни в Україні ми постійно супроводжуємо родини та окремих людей, які облаштовуються у Північній Баварії. Ми — це не далека бюрократична структура, не офіційна корпорація та не автоматизована гаряча лінія. Ми — віддана місцева команда, яка має глибокі коріння у Верхній Франконії. Ми використовуємо наші прямі зв'язки з органами влади, школами, орендодавцями та управляючими компаніями, щоб дати сім'ям справжню стабільність.\n                        </p>\n                        <p>\n                            Проходження німецьких муніципальних процедур вимагає більше, ніж просто добрих намірів — це вимагає розуміння складної мови дедлайнів, зустрічей у Jobcenter та офіційної кореспонденції. Ми заповнюємо саме цю прогалину за допомогою зрозумілої та постійної людської підтримки.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Live Impact Metrics -->\n        <div class=\"metrics-section\">\n            <div class=\"portal-container\">\n                <div class=\"metrics-grid\">\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value blue-val\">200+</div>\n                        <div class=\"metric-label\">Сім'ям надано підтримку</div>\n                        <div class=\"metric-sub\">Особистий супровід</div>\n                    </div>\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value emerald-val\">70+</div>\n                        <div class=\"metric-label\">Житлових об'єктів</div>\n                        <div class=\"metric-sub\">Знайдено та облаштовано</div>\n                    </div>\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value purple-val\">100%</div>\n                        <div class=\"metric-label\">Волонтерство та безкоштовно</div>\n                        <div class=\"metric-sub\">Без комісій чи прихованих платежів</div>\n                    </div>\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value amber-val\">2022+</div>\n                        <div class=\"metric-label\">Постійна присутність</div>\n                        <div class=\"metric-sub\">Активна підтримка з початку війни</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Comprehensive Support Grid -->\n        <div class=\"services-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">ЕКОСИСТЕМА ПІДТРИМКИ</span>\n                    <h2 class=\"section-main-title\">Як ми допомагаємо на вашому шляху</h2>\n                    <p class=\"section-description\">Повний комплекс людської допомоги, адаптований до місцевої баварської системи.</p>\n                </div>\n\n                <div class=\"services-grid\">\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-blue\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\"></path></svg>\n                        </div>\n                        <h3>Допомога з житлом</h3>\n                        <p>Пошук відповідних варіантів житла в регіоні, включаючи квартири безпосередньо з нашої мережі місцевих партнерів.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-emerald\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\"></path></svg>\n                        </div>\n                        <h3>Реєстрація (Anmeldung)</h3>\n                        <p>Покрокова підготовка до реєстрації за місцем проживання — обов'язкової основи для всіх юридичних процедур у Німеччині.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-purple\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z\"></path></svg>\n                        </div>\n                        <h3>Процеси в Jobcenter</h3>\n                        <p>Розшифровка офіційних листів, підготовка до обов'язкових зустрічей та супровід у процесі затвердження житла.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-amber\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z\"></path></svg>\n                        </div>\n                        <h3>Школи та дитячі садки</h3>\n                        <p>Пошук навчальних закладів у регіоні, подача необхідних документів та пряма координація з керівництвом шкіл.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-rose\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12.87 15.07l-2.54-2.51.03-.03c1.74-1.94 2.98-4.17 3.71-6.53H17V4h-7V2H8v2H1v2h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2.1l1.1-3h4.6l1.1 3H23l-4.5-12zm-2.62 7l1.62-4.41L19.12 17h-3.24z\"></path></svg>\n                        </div>\n                        <h3>Мова та переклад</h3>\n                        <p>Поєднання сімей із сертифікованими перекладачами української, російської та німецької мов для важливих офіційних візитів.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-indigo\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 10V7c0-1.1-.9-2-2-2H6c-1.1 0-2 .9-2 2v3c-1.1 0-2 .9-2 2v5h1.33L4 19h2l.67-2h10.66l.67 2h2l.67-2H22v-5c0-1.1-.9-2-2-2zm-9 0H6V7h5v3zm7 0h-5V7h5v3z\"></path></svg>\n                        </div>\n                        <h3>Меблі та побутові речі</h3>\n                        <p>Координація отримання базових меблів, кухонного приладдя та побутових промов на основі місцевих пожертв та наявності.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-teal\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"></path></svg>\n                        </div>\n                        <h3>Особистий куратор</h3>\n                        <p>Єдиний закріплений контакт, який особисто знає вашу історію, сімейну ситуацію та поточний статус.</p>\n                    </div>\n\n                    <div class=\"service-box\">\n                        <div class=\"service-icon-wrapper icon-sky\">\n                            <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\"></path></svg>\n                        </div>\n                        <h3>Інтеграція в спільноту</h3>\n                        <p>Пряме знайомство з досвідченими українськими родинами у вашому місті, які вже пройшли цей процес.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Process Workflow Timeline -->\n        <div class=\"process-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">ПОКРОКОВИЙ ПРОЦЕС</span>\n                    <h2 class=\"section-main-title\">Як працює процес допомоги</h2>\n                </div>\n\n                <div class=\"timeline-wrapper\">\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">01</div>\n                        <div class=\"step-content\">\n                            <h3>Прямий контакт</h3>\n                            <p>Надішліть повідомлення у WhatsApp або на Email українською, російською, німецькою або англійською мовою. Онлайн-реєстрація чи заповнення форм не потрібні.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">02</div>\n                        <div class=\"step-content\">\n                            <h3>Первинна розмова</h3>\n                            <p>Ми аналізуємо склад вашої сім'ї, поточне місцеперебування, нагальні потреби безпеки та пріоритетні адміністративні кроки.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">03</div>\n                        <div class=\"step-content\">\n                            <h3>Оцінка можливостей</h3>\n                            <p>Ми оцінюємо місцеві можливості, доступність державних органів у регіоні та наявність житла, щоб дати вам реалістичну відповідь.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">04</div>\n                        <div class=\"step-content\">\n                            <h3>Персоналізований план дій</h3>\n                            <p>Якщо ми можемо допомогти, ми окреслюємо першочергові кроки. Якщо ресурси обмежені, ми одразу повідомляємо про це та надаємо альтернативні контакти.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"timeline-step\">\n                        <div class=\"step-badge\">05</div>\n                        <div class=\"step-content\">\n                            <h3>Довгостроковий супровід</h3>\n                            <p>Наша підтримка виходить далеко за межі підписання договору оренди — ми допомагаємо з першими комунальними договорами та адаптацією у громаді.</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Callout Warning Box -->\n                <div class=\"notice-callout\">\n                    <div class=\"notice-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z\"></path></svg>\n                    </div>\n                    <div class=\"notice-text\">\n                        <strong>Важлива примітка про прозорість:</strong> Звернення до нашої команди не гарантує автоматичного надання житла, схвалення від Jobcenter чи місць у школі. Ми розглядаємо кожен випадок індивідуально та спілкуємося чесно. Ми надаємо перевагу швидкій та правдивій комунікації замість невиконаних обіцянок.\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Geographic Focus Section -->\n        <div class=\"region-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">РЕГІОНАЛЬНА СПЕЦІАЛІЗАЦІЯ</span>\n                    <h2 class=\"section-main-title\">Муніципалітети, де ми працюємо</h2>\n                    <p class=\"section-description\">Глибока місцева експертиза у Верхній Франконії (Oberfranken) та Північній Баварії.</p>\n                </div>\n\n                <div class=\"pills-cloud\">\n                    <span class=\"city-pill highlighted\">Helmbrechts</span>\n                    <span class=\"city-pill highlighted\">Münchberg</span>\n                    <span class=\"city-pill highlighted\">Hof</span>\n                    <span class=\"city-pill\">Selb</span>\n                    <span class=\"city-pill\">Wunsiedel</span>\n                    <span class=\"city-pill\">Arzberg</span>\n                    <span class=\"city-pill\">Marktredwitz</span>\n                    <span class=\"city-pill\">Naila</span>\n                    <span class=\"city-pill\">Kulmbach</span>\n                    <span class=\"city-pill\">Bad Steben</span>\n                    <span class=\"city-pill info-tag\">+ Наколишні міста Північної Баварії</span>\n                </div>\n\n                <div class=\"region-focus-card\">\n                    <h3>Чому регіональний фокус дає кращі результати</h3>\n                    <p>\n                        Фокусуючись виключно на цьому географічному регіоні, ми підтримуємо прямі зв'язки з місцевими муніципальними службовцями, знаємо, які школи мають місця для україномовних дітей, та які орендодавці приймають гарантії від Jobcenter.\n                    </p>\n                    <p>\n                        <em>Будь ласка, зверніть увагу: Ми не надаємо повного супроводу чи допомоги з житлом за межами нашого основного регіону діяльності.</em>\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"team-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">КЕРІВНИЦТВО ІНІЦІАТИВИ</span>\n                    <h2 class=\"section-main-title\">Хто стоїть за мережею підтримки</h2>\n                </div>\n\n                <div class=\"team-grid\">\n                    <div class=\"team-profile-card\">\n                        <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2026-07-26-at-6.16.22-pm.jpeg-120x120.jpg\" alt=\"Бен Шамір\" class=\"team-avatar\">\n                        <div class=\"team-info\">\n                            <h3>Бен Шамір</h3>\n                            <span class=\"role-pill\">Засновник та координатор</span>\n                            <p>Підприємець у сфері нерухомості з великим досвідом роботи в Німеччині. З початком війни Бен задіяв власні ресурси, інфраструктуру та регіональні зв'язки для створення структурованої мережі прийому та підтримки сімей.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"team-profile-card\">\n                        <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2026-07-26-at-6.17.22-pm.jpeg-120x120.jpg\" alt=\"Анна Шишашвілі\" class=\"team-avatar\">\n                        <div class=\"team-info\">\n                            <h3>Анна Шишашвілі</h3>\n                            <span class=\"role-pill manager\">Операційний менеджер</span>\n                            <p>Керує щоденною діяльністю повністю на волонтерських засадах. Анна є прямим та основним контактом для сімей, ведучи щоденну комунікацію у WhatsApp їхньою рідною мовою.</p>\n                            <a href=\"anna-shishoili.html\" style=\"color: #2563eb; font-weight: 600; text-decoration: underline; font-size: 0.9rem; margin-top: 10px; display: inline-block;\">Читати повну історію Анни →</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Transparency Matrix -->\n        <div class=\"transparency-section\">\n            <div class=\"portal-container\">\n                <div class=\"section-header\">\n                    <span class=\"section-badge\">ФІНАНСОВА ПРОЗОРІСТЬ</span>\n                    <h2 class=\"section-main-title\">100% безкоштовна модель послуг</h2>\n                </div>\n\n                <div class=\"transparency-grid\">\n                    <div class=\"matrix-card free-card\">\n                        <div class=\"matrix-header\">\n                            <span class=\"matrix-status\">ЗАВЖДИ 100% БЕЗКОШТОВНО</span>\n                            <h3>Волонтерська підтримка включає</h3>\n                        </div>\n                        <ul class=\"matrix-list\">\n                            <li><span>✓</span> Особистий супровід та ведення справи</li>\n                            <li><span>✓</span> Переклад та перевірка бюрократичних документів</li>\n                            <li><span>✓</span> Координація візитів до муніципальних органів</li>\n                            <li><span>✓</span> Пошук житла та переговори з орендодавцями</li>\n                            <li><span>✓</span> Допомога у реєстрації до шкіл та дитячих садків</li>\n                        </ul>\n                    </div>\n\n                    <div class=\"matrix-card external-card\">\n                        <div class=\"matrix-header\">\n                            <span class=\"matrix-status warning\">ЗОВНІШНІ ЗБОРИ ТА ВИТРАТИ</span>\n                            <h3>Оплата безпосередньо постачальникам послуг</h3>\n                        </div>\n                        <ul class=\"matrix-list warning-list\">\n                            <li><span>•</span> Муніципальні або офіційні державні збори</li>\n                            <li><span>•</span> Застава за оренду квартиры (Kautio) та щомісячна оренда</li>\n                            <li><span>•</span> Договори на електроенергію, опалення, газ та комунальні послуги</li>\n                            <li><span>•</span> Провайдери інтернету та телекомунікацій</li>\n                        </ul>\n                        <p class=\"matrix-footer-note\">* Жодні платежі чи кошти ніколи не проходять через нашу ініціативу.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Global Dual CTA with Mobirise Buttons -->\n        <div class=\"cta-section\">\n            <div class=\"portal-container\">\n                <div class=\"cta-grid\">\n                    <div class=\"cta-card cta-families\">\n                        <span class=\"cta-badge\">ДЛЯ НОВОПРИБУЛИХ СІМЕЙ</span>\n                        <h3>Потрібна допомога у Верхній Франконії?</h3>\n                        <p>Напишіть Анні напряму у WhatsApp або на Email українською, російською, німецькою чи англійською мовою.</p>\n                        \n                        <div class=\"mbr-section-btn cta-buttons-wrapper\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\">\n                            <a class=\"btn custom-btn whatsapp-btn display-4 btn-warning\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\">\n                                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                                WhatsApp Анни\n                            </a>\n                            <a class=\"btn btn-primary\" href=\"Contact.html#footer4-19\" data-app-placeholder=\"Type Text\">\n                                Надіслати Email\n                            </a>\n                        </div>\n                    </div>\n\n                    <div class=\"cta-card cta-supporters\">\n                        <span class=\"cta-badge dark\">ДЛЯ МІСЦЕВИХ БЛАГОДІЙНИКІВ</span>\n                        <h3>Бажаєте підтримати нашу роботу?</h3>\n                        <p>Вільне житло, меблі, допомога з перекладом або транспортом — ваш час створює реальні зміни.</p>\n                        \n                        <div class=\"mbr-section-btn cta-buttons\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn btn-outline-primary\" href=\"how-to-help.html\" data-app-placeholder=\"Type Text\">\n                                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 6px;\"><path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\"></path></svg> Долучитися\n                            </a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n    </div>\n</section>",
          "_cid": "vqdKEkNwfT",
          "_anchor": "article01-1u",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "footer4",
          "_sourceTheme": "restaurantm4",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "*:focus": {
              "outline": "none",
              "box-shadow": "none"
            },
            ".form-control": {
              "width": "100%",
              "background": "@inputBg",
              "border-radius": "0 !important",
              "border": "none !important",
              "min-height": "47px",
              "&::-webkit-input-placeholder": {
                "color": "contrast(@inputBg)"
              },
              "&::-moz-placeholder": {
                "color": "contrast(@inputBg)"
              },
              "&:-ms-input-placeholder": {
                "color": "contrast(@inputBg)"
              },
              "&:-moz-placeholder": {
                "color": "contrast(@inputBg)"
              }
            },
            "input.form-control": {
              "padding": "0.5rem"
            },
            ".soc-item": {
              "display": "inline-block",
              "margin": "0 0.1rem 0.2rem 0.1rem",
              "padding": "10px 11px 0 11px",
              "border": "2px solid @iconsColor !important",
              "border-radius": "50% !important",
              "&:hover": {
                "opacity": "0.5"
              },
              ".socicon": {
                "font-size": "1.5rem",
                "color": "@iconsColor"
              }
            },
            ".days-column, .hours-column": {
              "display": "inline-block",
              "span": {
                "display": "block"
              }
            },
            ".logo": {
              "img": {
                "width": "auto",
                "display": "inline-block"
              }
            },
            "@media (max-width: 767px)": {
              ".days-column": {
                "padding-right": "0 !important"
              },
              ".hours-column": {
                "max-width": "50% !important"
              },
              ".opening-hours": {
                "padding-bottom": "48px !important"
              }
            },
            ".form-title, .btn-row": {
              "color": "#0c2c68"
            },
            ".follow-title, .social-list, .logo": {
              "color": "#0c2c68"
            },
            ".address-title, .address-block": {
              "color": "#0c2c68"
            },
            ".hours-column": {
              "color": "#0c2c68"
            },
            ".opening-hours-title, .opening-hours": {
              "color": "#0c2c68"
            },
            ".contacts-title, .contacts-block": {
              "color": "#0c2c68",
              "text-align": "center"
            },
            "LABEL": {
              "color": "#0c2c68"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer4 restaurantm4_footer4\" group=\"Footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"1\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n\t\t<input type=\"range\" title=\"Logo\" inline name=\"logoSize\" min=\"5\" max=\"13\" step=\"0.1\" value=\"8\" condition=\"showLogo\">\n\t\t<select title=\"Icons\" name=\"iconsCount\" condition=\"showIcons\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t</select>\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Logo\" name=\"showLogo\">\n\t\t<input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n\t\t<input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#0c2c68\" condition=\"showIcons\">\n\t\t<input type=\"checkbox\" title=\"Address\" name=\"showAddress\">\n\t\t<input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n\t\t<input type=\"checkbox\" title=\"Opening Hours\" name=\"showOpeningHours\">\n\t\t<input type=\"checkbox\" title=\"Form\" name=\"showForm\" checked>\n\t\t<input type=\"color\" title=\"Input Bg\" name=\"inputBg\" value=\"#ffffff\" condition=\"showForm\">\n\t\t<input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background8.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#f7f7f7\" selected>\n\t\t</fieldset>\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t<input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row content justify-content-center align-items-start mbr-white\">\n\t\t\t<div class=\"col-12 col-md-6 col-lg-4 pb-3\" mbr-if=\"showLogo || showAddress || showContacts || showIcons\">\n\t\t\t\t<div class=\"address\" mbr-if=\"showAddress\">\n\t\t\t\t\t<h3 class=\"address-title mbr-fonts-style pb-2 align-center\" mbr-theme-style=\"display-5\" data-app-selector=\".address-title, .address-block\">Зв'яжіться з нами</h3>\n\t\t\t\t\t<p class=\"address-block mbr-fonts-style pb-3 align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".address-title, .address-block\">\n\t\t\t\t\t\tKonradsreuth Alte Hofer Str. 1<br>\n\t\t\t\t\t\tНімеччина\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"contacts\" mbr-if=\"showContacts\">\n\t\t\t\t\t<h3 class=\"contacts-title mbr-fonts-style pb-2 align-center\" mbr-theme-style=\"display-5\" data-app-selector=\".contacts-title, .contacts-block\"><b>Зв'яжіться з нами</b></h3>\n\t\t\t\t\t<p class=\"contacts-block mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".contacts-title, .contacts-block\">Для підтримки / технічних питань\n<br><a href=\"tel:+380637004615\" class=\"text-primary\">+380 63 700 4615</a><br><br>Konradsreuth Alte Hofer Str. 1 ⚲\n<br><br><a href=\"mailto:kotovaanna101010@gmail.com\" class=\"text-primary\">kotovaanna101010@gmail.com✉&nbsp;</a><br><br></p>\n\t\t\t\t</div>\n                <div class=\"social-list pb-3 align-center\" mbr-if=\"showIcons\">\n\t\t\t\t\t<div class=\"soc-item\">\n\t\t\t\t\t\t<a href=\"#\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-whatsapp socicon\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 1\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-facebook socicon\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 2\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mbr-iconfont-social socicon-instagram socicon\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 3\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"socicon-instagram socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 4\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"socicon-googleplus socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"iconsCount > 5\">\n\t\t\t\t\t\t<a href=\"#\" target=\"_blank\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"socicon-behance socicon mbr-iconfont mbr-iconfont-social\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\n\t\t\t<div class=\"form-1 col-sm-12 col-md-5 col-xl-4\" mbr-class=\"{'col-lg-4': !showOpeningHours || (!showLogo && !showIcons && !showContacts && !showAddress), \n\t\t\t\t'col-lg-3': showOpeningHours && (showLogo || showIcons || showContacts || showAddress)}\" mbr-if=\"showForm\">\n\t\t\t\t<h3 class=\"form-title pb-3 mbr-fonts-style align-center\" mbr-theme-style=\"display-5\" data-app-selector=\".form-title, .btn-row\"><b>Напишіть нам</b></h3>\n                <div mbr-form>\n<!--Formbuilder Form-->\n<form action=\"kotovaanna101010@gmail.com\" name=\"My Mobirise Form\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"kotovaanna101010@gmail.com\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Дякуємо за заповнення форми!</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">\n</div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-lg-6 col-md-12 col-sm-12 form-group\" data-for=\"tel\" style>\n<input type=\"tel\" name=\"tel\" placeholder=\"*Телефон\" data-form-field=\"tel\" mbr-theme-style=\"display-7\" required=\"required\" style=\"text-align:left\" class=\"form-control\" value>\n</div>\n<div class=\"col-lg-6 col-md-12 col-sm-12 form-group\" data-for=\"full name\">\n<input type=\"text\" name=\"full name\" data-form-field=\"full name\" style=\"text-align:left\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" placeholder=\"*Повне ім'я\" value>\n</div>\n<div data-for=\"email\" class=\"col-md-12 form-group mb-3 \">\n<input type=\"text\" name=\"email\" placeholder=\"Email\" style=\"text-align:left\" data-form-field=\"E-mail\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value>\n</div>\n<div data-for=\"message\" class=\"col-md-12 form-group mb-3 pb-2\">\n<textarea name=\"message\" placeholder=\"Як ми можемо вам допомогти?\" data-form-field=\"Message\" style=\"text-align:left\" mbr-theme-style=\"display-7\" class=\"form-control\"></textarea>\n</div>\n    <div class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<div class=\"form-control-label\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"checkbox\" class=\"mbr-fonts-style\">\n</label>\n</div>\n<div data-for=\"I agree to the terms and conditions and privacy policy\" class=\"form-check ms-2\">\n  <input type=\"checkbox\" value=\"Yes\" name=\"I agree to the terms and conditions and privacy policy\" data-form-field=\"I agree to the terms and conditions\" mbr-theme-style=\"display-7\" class=\"form-check-input\" required=\"required\">\n  <label mbr-text for=\"I agree to the terms and conditions and privacy policy\" mbr-theme-style=\"display-7\" class=\"form-check-label\">\n    Я погоджуюся з <a href=\"usingtheweb.html\" class=\"text-black\">Умовами використання</a> та <a href=\"privacy.html\" class=\"text-black\">Політикою конфіденційності</a>\n  </label>\n</div>\n\n</div>\n<div class=\"col-md-12 input-group-btn align-center \" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"w-100 btn btn-form btn-primary\" data-app-placeholder=\"Type Text\">Надіслати</a></div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\t\t\t</div>\n\n\t\t\t<div class=\"col-sm-12 col-md-6 col-lg-5 col-xl-4 opening-hours pb-3 align-center\" mbr-if=\"showOpeningHours\">\n\t\t\t\t<div class=\"logo pb-3 align-center\" mbr-if=\"showLogo\">\n\t\t\t\t\t<a href=\"https://mobiri.se\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-327x327.png\" alt=\"Mobirise\" mbr-style=\"{'height': logoSize + 'rem'}\">\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n            <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\">\n                    <a class=\"nav-link link text-primary\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Головна</a>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link link text-primary\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Про нас</a>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link link text-primary\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Послуги</a>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link link text-primary\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Запит на допомогу</a>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link link text-primary\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Життя в Німеччині</a>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link link text-primary\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Регіони діяльності</a>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link link text-primary\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Спільнота</a>\n                </li>\n                <li class=\"nav-item\">\n                    <a class=\"nav-link link text-primary\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Часті запитання (FAQ)</a>\n                </li></ul>\n        </div>\n\t\t</div>\n\t</div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "footer4-i",
          "_isUserblock": true,
          "_cid": "vqcv5WubKh",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 scalem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"50\" max=\"400\" step=\"10\" value=\"150\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Lists\" name=\"showLists\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"list\" min=\"1\" max=\"5\" step=\"1\" value=\"4\" condition=\"showLists\">\n        <input type=\"color\" title=\"List Active Color\" value=\"#ffffff\" name=\"activeList\" condition=\"showLists\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Social Active Color\" value=\"#FF5753\" name=\"active\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#635d60\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#0c2c68\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#292325\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            \n            <!-- עמודת טקסט וכותרת ראשית -->\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showTitle || showText || showButtons || showLogo\">\n                <div class=\"content-wrapper\">\n                    <!-- תוספת המקום ללוגו -->\n                    <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"Logo\">\n                        </a>\n                    </div>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>\n                        ZUSAMMENLEBEN\n                    </b></h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                        Підтримка інтеграції, пошук житла та зв'язок зі спільнотою для новоприбулих і місцевих жителів регіону.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-phone mbr-iconfont mbr-iconfont-btn\"></span>\n                            Зв'язатися з нами\n                        </a></div>\n                </div>\n            </div>\n\n            <!-- עמודות הקישורים -->\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLists\">\n                <div class=\"lists-wrapper\">\n                    <div class=\"list-wrap\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Головна</a></li>\n                            <li class=\"item-wrap\"><a href=\"family-stories.html\" class=\"text-white\">Історії родин</a></li>\n                            <li class=\"item-wrap\"><a href=\"services.html\" class=\"text-white\">Послуги</a></li>\n                            <li class=\"item-wrap\"><a href=\"request-assistance.html\" class=\"text-white\">Запит на допомогу</a></li>\n                            <li class=\"item-wrap\"><a href=\"community.html\" class=\"text-white\">Спільнота</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"living-in-germany.html\" class=\"text-white\">Життя в Німеччині</a></li>\n                            <li class=\"item-wrap\"><a href=\"glossary.html\" class=\"text-white\">Глосарій</a></li>\n                            <li class=\"item-wrap\"><a href=\"learning-german.html\" class=\"text-white\">Вивчення німецької</a></li>\n                            <li class=\"item-wrap\"><a href=\"refugee-rights.html\" class=\"text-white\">Права біженців</a></li>\n                            <li class=\"item-wrap\"><a href=\"anna-shishoili.html\" class=\"text-white\">Анна Шишашвілі</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 2\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"how-to-help.html\" class=\"text-white\">Як ви можете допомогти</a></li>\n                            <li class=\"item-wrap\"><a href=\"social-activity.html\" class=\"text-white\">Соціальна діяльність</a></li>\n                            <li class=\"item-wrap\"><a href=\"faq.html\" class=\"text-white\">Часті запитання (FAQ)</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Регіони діяльності</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 3\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"emergency.html\" class=\"text-white\">Екстрена допомога</a></li>\n                            <li class=\"item-wrap\"><a href=\"Contact.html\" class=\"text-white\">Контакти</a></li>\n                            <li class=\"item-wrap\"><a href=\"https://wa.me/380637004615\" class=\"text-white\" target=\"_blank\">Підтримка у WhatsApp</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Локація</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 4\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"privacy.html\" class=\"text-white\">Політика конфіденційності</a></li>\n                            <li class=\"item-wrap\"><a href=\"usingtheweb.html\" class=\"text-white\">Умови використання</a></li>\n                            <li class=\"item-wrap\"><a href=\"impressum.html\" class=\"text-white\">Вихідні дані (Impressum)</a></li>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Офіційний сайт</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- אזור זכויות יוצרים ורשתות חברתיות -->\n            <div class=\"col-12\" mbr-if=\"showSocial || showCopy\">\n                <div class=\"copy-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://wa.me/380637004615\" target=\"_blank\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-whatsapp\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"mailto:info@zusammenleben.de\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy, .social-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\">\n                        © Copyright 2026 Zusammenleben - Всі права захищені\n                    </p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
