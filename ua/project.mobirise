              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
