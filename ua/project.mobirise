              "color": "#0f172a",
              "line-height": "1.6",
              "direction": "ltr",
              "text-align": "left",
              "-webkit-font-smoothing": "antialiased"
            },
            ".guide-executive-section *": {
              "box-sizing": "border-box"
            },
            ".executive-container": {
              "max-width": "980px",
              "margin": "0 auto",
              "padding": "0 24px"
            },
            ".guide-header": {
              "text-align": "center",
              "max-width": "820px",
              "margin": "0 auto 40px"
            },
            ".header-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "margin-top": "50px",
              "border": "1px solid #bfdbfe"
            },
            ".header-title": {
              "font-size": "2.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.025em",
              "margin": "0 0 16px 0",
              "line-height": "1.25",
              "text-align": "center"
            },
            ".header-lead": {
              "font-size": "1.15rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.6"
            },
            ".disclaimer-banner": {
              "background": "#fffbeb",
              "border": "1px solid #fde68a",
              "border-radius": "14px",
              "padding": "20px 24px",
              "display": "flex",
              "gap": "16px",
              "align-items": "flex-start",
              "margin-bottom": "45px",
              "box-shadow": "0 2px 8px rgba(245, 158, 11, 0.05)"
            },
            ".disclaimer-icon": {
              "color": "#d97706",
              "flex-shrink": "0",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#fef3c7",
              "padding": "10px",
              "border-radius": "10px"
            },
