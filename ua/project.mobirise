              "justify-content": "space-between",
              "align-items": "center",
              "padding": "12px 0",
              "border-bottom": "1px solid #e2e8f0",
              "color": "#2563eb",
              "text-decoration": "none",
              "font-size": "0.95rem",
              "transition": "opacity 0.2s"
            },
            ".resource-link:hover": {
              "opacity": "0.8",
              "text-decoration": "underline"
            },
            ".resource-link strong": {
