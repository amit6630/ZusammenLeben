    "guide-school-kita-bavaria.html": {
      "settings": {
        "title": "Школа та дитсадок для українських дітей у Баварії",
        "order": "19",
        "meta_descr": "Як записати дитину з України до школи чи дитсадка в Баварії: обов'язкове навчання, класи німецької, документи та реальні строки очікування.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-school-kita-bavaria.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-school-kita-bavaria.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-school-kita-bavaria.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-school-kita-bavaria.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-school-kita-bavaria.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Школа та дитсадок для українських дітей у Баварії\" />\n<meta property=\"og:description\" content=\"Як записати дитину з України до школи чи дитсадка в Баварії: обов'язкове навчання, класи німецької, документи та реальні строки очікування.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-school-kita-bavaria.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Запис дитини до школи чи дитсадка в Баварії\",\"description\":\"Як записати дитину з України до школи чи дитсадка в Баварії: обов'язкове навчання, класи німецької, документи та реальні строки очікування.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-school-kita-bavaria.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-school-kita-bavaria.html\",\"wordCount\":905,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Чи має моя дитина ходити до школи в Баварії?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так. Для дітей шкільного віку, які живуть у Баварії, навчання обов'язкове, зокрема для дітей з України.\"}},{\"@type\":\"Question\",\"name\":\"Чи є право на місце в дитсадку?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так, з одного року. Оскільки місць мало, записуйте дитину заздалегідь до кількох закладів.\"}},{\"@type\":\"Question\",\"name\":\"Чи обов'язкове щеплення від кору?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так. Для школи та дитсадка в Німеччині потрібне підтвердження захисту від кору.\"}},{\"@type\":\"Question\",\"name\":\"Чи може дитина продовжувати українське онлайн-навчання?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так, додатково. Але воно не замінює відвідування німецької школи, яке є обов'язковим.\"}},{\"@type\":\"Question\",\"name\":\"Хто платить за екскурсії та обіди?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Родини з низьким доходом можуть подати заяву на пакет освіти й участі, який покриває екскурсії, обіди та шкільне приладдя.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Запис дитини до школи чи дитсадка в Баварії\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-school-kita-bavaria.html\"}]}]}</script>"
      },
