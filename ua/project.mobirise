              "border": "2px solid #2563eb"
            },
            ".services-pills-wrap": {
              "display": "inline-block",
              "background": "#f1f5f9",
              "padding": "10px 20px",
              "border-radius": "30px",
              "font-size": "0.9rem",
              "font-weight": "600",
              "color": "#334155",
              "margin-bottom": "25px"
