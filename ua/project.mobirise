    "guide-public-transport.html": {
      "settings": {
        "title": "Громадський транспорт у Верхній Франконії: квитки",
        "order": "40",
        "meta_descr": "Deutschland-Ticket, регіональні потяги, автобуси та транспорт за викликом у сільській Верхній Франконії, дорога до школи, ціни, штрафи та далекі поїздки.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-public-transport.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-public-transport.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-public-transport.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-public-transport.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-public-transport.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Громадський транспорт у Верхній Франконії: квитки\" />\n<meta property=\"og:description\" content=\"Deutschland-Ticket, регіональні потяги, автобуси та транспорт за викликом у сільській Верхній Франконії, дорога до школи, ціни, штрафи та далекі поїздки.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-public-transport.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Як пересуватися: громадський транспорт у Верхній Франконії\",\"description\":\"Deutschland-Ticket, регіональні потяги, автобуси та транспорт за викликом у сільській Верхній Франконії, дорога до школи, ціни, штрафи та далекі поїздки.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-public-transport.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-public-transport.html\",\"wordCount\":900,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Що покриває Deutschland-Ticket?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Увесь місцевий і регіональний транспорт Німеччини, але не далекі потяги, як-от ICE чи IC.\"}},{\"@type\":\"Question\",\"name\":\"Чи можна купити квиток у потязі?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"У багатьох регіональних потягах Баварії ні. Купуйте до посадки в застосунку чи автоматі.\"}},{\"@type\":\"Question\",\"name\":\"Що робити, якщо ввечері немає автобуса?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Перевірте автобуси за викликом чи спільні таксі, які їздять після попереднього замовлення.\"}},{\"@type\":\"Question\",\"name\":\"Чи безкоштовна дорога до школи?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"У Баварії часто так, якщо відстань перевищує певну межу. Запитайте в шкільній канцелярії.\"}},{\"@type\":\"Question\",\"name\":\"Що буде без дійсного квитка?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ви сплатите підвищений тариф у кілька десятків євро, а за повторний безквитковий проїзд можливе покарання.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Як пересуватися: громадський транспорт у Верхній Франконії\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-public-transport.html\"}]}]}</script>"
      },
