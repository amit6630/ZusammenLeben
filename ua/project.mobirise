    "guide-anmeldung.html": {
      "settings": {
        "title": "Anmeldung: реєстрація адреси в Німеччині",
        "order": "30",
        "meta_descr": "Як зареєструвати адресу (Anmeldung) у Верхній Франконії: строк, документи, підтвердження від орендодавця і чому від цього залежать майже всі наступні кроки.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-anmeldung.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-anmeldung.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-anmeldung.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-anmeldung.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-anmeldung.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Anmeldung: реєстрація адреси в Німеччині\" />\n<meta property=\"og:description\" content=\"Як зареєструвати адресу (Anmeldung) у Верхній Франконії: строк, документи, підтвердження від орендодавця і чому від цього залежать майже всі наступні кроки.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-anmeldung.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Anmeldung: реєстрація адреси в Німеччині\",\"description\":\"Як зареєструвати адресу (Anmeldung) у Верхній Франконії: строк, документи, підтвердження від орендодавця і чому від цього залежать майже всі наступні кроки.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-anmeldung.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-anmeldung.html\",\"wordCount\":924,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Скільки часу є на реєстрацію?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Два тижні після заселення, у бюро громадян вашого міста.\"}},{\"@type\":\"Question\",\"name\":\"Чи може одна особа зареєструвати всю родину?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Часто так, із довіреністю та документами інших. Запитайте у своєму бюро громадян.\"}},{\"@type\":\"Question\",\"name\":\"Що робити, якщо орендодавець відмовляє в підтвердженні?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Орендодавець зобов'язаний його надати за законом. Попросіть письмово, а якщо відмова триває, зверніться до бюро громадян.\"}},{\"@type\":\"Question\",\"name\":\"Чи платна реєстрація?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ні. Реєстрація і перша довідка безкоштовні.\"}},{\"@type\":\"Question\",\"name\":\"Коли прийде податковий номер?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Зазвичай через кілька тижнів після реєстрації, автоматично поштою.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Anmeldung: реєстрація адреси в Німеччині\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-anmeldung.html\"}]}]}</script>"
      },
