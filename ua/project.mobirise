                "background": "linear-gradient(rgba(255, 255, 255, 0), #fff)",
                "pointer-events": "none"
              },
              ".zl-clamp.is-open": {
                "max-height": "none"
              },
              ".zl-clamp.is-open::after": {
                "display": "none"
              },
              ".zl-more-btn": {
                "display": "flex",
                "align-items": "center",
                "justify-content": "center",
                "gap": "6px",
