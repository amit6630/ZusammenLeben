              "margin-bottom": "10px",
              "font-size": "0.92rem",
              "color": "#334155"
            },
            ".numbered-list li strong": {
              "color": "#0f172a"
            },
            ".resource-group-title": {
              "font-size": "0.8rem",
              "font-weight": "800",
              "letter-spacing": "1px",
              "display": "block",
              "margin-top": "24px",
              "margin-bottom": "8px",
              "color": "#64748b",
              "text-transform": "uppercase"
            },
            ".resource-link": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "padding": "12px 0",
              "border-bottom": "1px solid #e2e8f0",
              "color": "#2563eb",
              "text-decoration": "none",
              "font-size": "0.95rem",
              "transition": "opacity 0.2s"
            },
            ".resource-link:hover": {
              "opacity": "0.8",
              "text-decoration": "underline"
            },
            ".resource-link strong": {
              "color": "#0f172a"
            },
            ".icon-danger": {
              "color": "#ef4444",
              "display": "inline-flex"
            },
            ".icon-primary": {
              "color": "#2563eb",
              "display": "inline-flex"
            },
            ".notice-highlight": {
              "background": "#f0f9ff",
              "border-left": "4px solid #0284c7",
              "padding": "16px 20px",
              "border-radius": "8px",
              "font-size": "0.95rem",
              "color": "#0369a1",
              "margin-top": "20px",
              "line-height": "1.6"
            },
            ".notice-highlight.compact-notice": {
              "font-size": "0.88rem",
              "padding": "12px 16px"
            },
            ".cta-box": {
              "text-align": "center",
              "margin-top": "30px",
              "padding": "40px 32px",
              "background": "linear-gradient(180deg, #ffffff 0%, #f8fafc 100%)"
            },
            ".cta-box h3": {
              "font-size": "1.5rem",
              "margin-bottom": "14px"
            },
            ".cta-description": {
              "max-width": "700px",
              "margin": "0 auto 16px",
              "color": "#475569",
              "font-size": "1rem"
            },
            ".cta-statement": {
              "font-weight": "700",
              "color": "#0f172a",
              "margin-bottom": "28px",
              "font-size": "1.05rem"
            },
            ".guide-executive-section .mbr-section-btn": {
              "display": "flex",
              "gap": "12px",
              "flex-wrap": "wrap",
              "margin": "0",
              "justify-content": "center"
            },
            ".guide-executive-section .btn.custom-btn": {
              "padding": "14px 28px !important",
              "border-radius": "100px !important",
              "font-weight": "700 !important",
              "font-size": "0.95rem !important",
              "display": "inline-flex !important",
              "align-items": "center !important",
              "justify-content": "center !important",
              "gap": "8px !important",
              "transition": "all 0.25s ease !important",
              "border-width": "1px !important",
              "text-decoration": "none !important"
            },
            ".guide-executive-section .btn.outline-btn": {
              "background-color": "#ffffff !important",
              "border-color": "#cbd5e1 !important",
              "color": "#0f172a !important"
            },
            ".guide-executive-section .btn.outline-btn:hover": {
              "background-color": "#f1f5f9 !important",
              "border-color": "#94a3b8 !important",
              "transform": "translateY(-2px) !important"
            },
            ".guide-executive-section .btn.whatsapp-btn": {
              "background-color": "#25d366 !important",
              "border-color": "#25d366 !important",
              "color": "#ffffff !important",
              "box-shadow": "0 4px 12px rgba(37, 211, 102, 0.2) !important"
            },
            ".guide-executive-section .btn.whatsapp-btn:hover": {
              "background-color": "#20bd5a !important",
              "border-color": "#20bd5a !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 6px 18px rgba(37, 211, 102, 0.3) !important"
            },
            "@media (max-width: 768px)": {
              ".guide-executive-section": {
                "padding": "40px 0 !important"
              },
              ".executive-container": {
                "padding": "0 16px"
              },
              ".header-title": {
                "font-size": "1.85rem"
              },
              ".guide-card, .cta-box": {
                "padding": "22px 16px"
              },
              ".guide-subcard": {
                "padding": "20px"
              },
              ".guide-executive-section .mbr-section-btn": {
                "flex-direction": "column",
                "width": "100%"
              },
              ".guide-executive-section .btn.custom-btn": {
                "width": "100% !important"
              },
              ".disclaimer-banner": {
                "flex-direction": "column",
                "align-items": "flex-start",
                "gap": "12px"
              },
              ".resource-link": {
                "flex-direction": "column",
                "align-items": "flex-start",
                "gap": "4px"
              }
            },
            "@media (max-width: 480px)": {
              ".card-details-grid, .two-column-grid, .three-column-grid": {
                "grid-template-columns": "1fr"
              },
              ".block-title": {
                "font-size": "1.25rem"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            },
            "@media (max-width: 575px)": {
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            "@media (max-width: 767px)": {
              ".services-grid, .team-grid, .transparency-grid, .pillars-grid, .three-column-grid, .grid-3, .grid-2, .faq-grid, .survival-grid, .portal-grid-2, .city-directory-grid, .details-cards-stack, .two-column-grid, .levels-grid, .cert-grid, .benefits-grid, .links-grid, .timeline-wrapper": {
                "display": "flex !important",
                "flex-wrap": "nowrap !important",
                "flex-direction": "row !important",
                "grid-template-columns": "none !important",
                "gap": "12px !important",
                "overflow-x": "auto",
                "overscroll-behavior-x": "contain",
                "scroll-snap-type": "x mandatory",
                "padding": "4px 2px 14px !important",
                "scrollbar-width": "none"
              },
              ".services-grid::-webkit-scrollbar, .team-grid::-webkit-scrollbar, .transparency-grid::-webkit-scrollbar, .pillars-grid::-webkit-scrollbar, .three-column-grid::-webkit-scrollbar, .grid-3::-webkit-scrollbar, .grid-2::-webkit-scrollbar, .faq-grid::-webkit-scrollbar, .survival-grid::-webkit-scrollbar, .portal-grid-2::-webkit-scrollbar, .city-directory-grid::-webkit-scrollbar, .details-cards-stack::-webkit-scrollbar, .two-column-grid::-webkit-scrollbar, .levels-grid::-webkit-scrollbar, .cert-grid::-webkit-scrollbar, .benefits-grid::-webkit-scrollbar, .links-grid::-webkit-scrollbar, .timeline-wrapper::-webkit-scrollbar": {
                "display": "none"
              },
              ".services-grid > *, .team-grid > *, .transparency-grid > *, .pillars-grid > *, .three-column-grid > *, .grid-3 > *, .grid-2 > *, .faq-grid > *, .survival-grid > *, .portal-grid-2 > *, .city-directory-grid > *, .details-cards-stack > *, .two-column-grid > *, .levels-grid > *, .cert-grid > *, .benefits-grid > *, .links-grid > *, .timeline-wrapper > *": {
                "flex": "0 0 84% !important",
                "max-width": "84% !important",
                "min-width": "0",
                "margin": "0 !important",
                "scroll-snap-align": "start"
              },
              ".timeline-wrapper::before": {
                "display": "none !important"
              },
              ".metrics-section, .services-section, .process-section, .region-section, .team-section, .transparency-section, .cta-section": {
                "padding-top": "44px !important",
                "padding-bottom": "44px !important"
              },
              ".metrics-grid": {
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr) !important",
                "gap": "10px !important"
              },
              ".word-grid": {
                "max-height": "62vh",
                "overflow-y": "auto",
                "overscroll-behavior": "contain",
                "padding-right": "4px"
              },
              ".metrics-grid > *": {
                "min-width": "0",
                "padding": "18px 10px !important"
              },
              ".metrics-grid .metric-value": {
                "font-size": "2rem !important"
              },
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            },
            "@media (max-width: 991px)": {
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_name": "header01",
          "_sourceTheme": "holidaym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"guide-executive-section\" id=\"refugee-rights-guide\">\n    <div class=\"executive-container\">\n        \n        <!-- Header -->\n        <header class=\"guide-header\">\n            <span class=\"header-tag\">ПОВНИЙ ГАЙД</span>\n            <h1 class=\"header-title\">Реалізація ваших прав як біженця з України в Німеччині</h1>\n            <p class=\"header-lead\">\n                Від юридичного статусу до практичних процедур: на що ви маєте право, куди звертатися та що саме робити, якщо ви застрягли в бюрократичній системі.\n            </p>\n        </header>\n\n        <!-- General Disclaimer / Notice -->\n        <div class=\"disclaimer-banner\">\n            <div class=\"disclaimer-icon\">\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z\"></path><path d=\"m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z\"></path><path d=\"M7 21h10\"></path><path d=\"M12 3v18\"></path><path d=\"M3 7h18\"></path></svg>\n            </div>\n            <div class=\"disclaimer-text\">\n                <strong>Важливе юридичне повідомлення:</strong> Статус тимчасового захисту (§ 24) періодично продовжується Радою ЄС. Процедури, суми фінансової допомоги та критерії відповідності відрізняються залежно від міста та постійно змінюються. Завжди перевіряйте поточний загальний термін та термін дії вашої особистої посвідки в місцевому відомстві у справах іноземців (Ausländerbehörde).\n            </div>\n        </div>\n\n        <!-- Section 1: The Legal Basis -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"3\" y1=\"22\" x2=\"21\" y2=\"22\"></line><line x1=\"6\" y1=\"18\" x2=\"6\" y2=\"11\"></line><line x1=\"10\" y1=\"18\" x2=\"10\" y2=\"11\"></line><line x1=\"14\" y1=\"18\" x2=\"14\" y2=\"11\"></line><line x1=\"18\" y1=\"18\" x2=\"18\" y2=\"11\"></line><polygon points=\"12 2 20 7 4 7 12 2\"></polygon></svg>\n                </span>\n                Правова основа: чому ваш статус відрізняється\n            </h2>\n            \n            <div class=\"guide-card\">\n                <p>Біженці з України в Німеччині не проходять стандартну процедуру отримання притулку (Asyl). Натомість вони підпадають під дію <strong>Директиви ЄС про тимчасовий захист</strong>, яка була активована вперше в історії у березні 2022 року.</p>\n                <p>У Німеччині це трансформується у посвідку на проживання згідно з <strong>Параграфом 24 Закону про перебування (§ 24 AufenthG)</strong>. Практичні наслідки цього величезні: відсутність тривалих процедур отримання притулку, відсутність довгих співбесід, негайний доступ до ринку праці та право на стандартну соціальну підтримку.</p>\n                \n                <div class=\"rule-box green-rule\">\n                    <h3>\n                        <span class=\"inline-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"></path><path d=\"M9 18h6\"></path><path d=\"M10 22h4\"></path></svg>\n                        </span>\n                        Критична відмінність\n                    </h3>\n                    <p>Звичайний шукач притулку отримує обмежену підтримку за Законом про допомогу шукачам притулку (AsylbLG). Як власник статусу за § 24, ви отримуєте підтримку через Jobcenter (Bürgergeld) згідно з SGB II — <strong>за тією ж системою, яка обслуговує жителів Німеччини.</strong> Це величезна перевага, яку ви повинні знати та використовувати.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 2: The Three Documents -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"></line></svg>\n                </span>\n                Три документи, від яких залежить усе\n            </h2>\n            <p class=\"section-intro-text\">Перш ніж обговорювати права, ви повинні отримати ці три базові документи. Без них німецька система вас просто \"не бачить\".</p>\n            \n            <div class=\"three-column-grid\">\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>\n                    </div>\n                    <h3>Anmeldung (Реєстрація адреси)</h3>\n                    <p>Перший і найважливіший крок. Оформлюється в ратуші (<em>Bürgerbüro</em>). Без цього ви не зможете відкрити банківський рахунок, оформити страховку або подати заяву до Jobcenter. Записуйтеся негайно, очікування може тривати тижнями.</p>\n                </div>\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>\n                    </div>\n                    <h3>Посвідка на проживання (§ 24)</h3>\n                    <p>Видається відомством з справ іноземців (<em>Ausländerbehörde</em>). Прострочений документ зупиняє виплати та страховку. Починайте процес продовження щонайменше за 8 тижнів до закінчення терміну. Тимчасові довідки (<em>Fiktionsbescheinigung</em>) також мають юридичну силу.</p>\n                </div>\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\" ry=\"2\"></rect><line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"></line></svg>\n                    </div>\n                    <h3>Банківський рахунок</h3>\n                    <p>Необхідний для виплат від Jobcenter, оплати оренди та укладення договорів. Ви маєте законне право на базовий рахунок (<em>Basiskonto</em>) у Німеччині. Якщо банк відмовляє, вимагайте письмову відмову та повідомляйте регулятор BaFin.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 3: Financial Support -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"2\"></rect><circle cx=\"12\" cy=\"12\" r=\"2\"></circle><path d=\"M6 12h.01M18 12h.01\"></path></svg>\n                </span>\n                Фінансова підтримка (Bürgergeld)\n            </h2>\n            \n            <div class=\"guide-card\">\n                <div class=\"card-header\">\n                    <h3>Базові виплати від Jobcenter</h3>\n                    <span class=\"status-tag info\">Стандартна підтримка</span>\n                </div>\n                \n                <div class=\"card-details-grid\">\n                    <div class=\"detail-box\">\n                        <h4>Regelbedarf (Базова допомога на проживання)</h4>\n                        <p>Базова сума для щоденного життя, яка виплачується безпосередньо на ваш рахунок на кожного члена домогосподарства, розрахована залежно від віку та сімейного стану.</p>\n                    </div>\n                    <div class=\"detail-box\">\n                        <h4>Kosten der Unterkunft (KdU - Витрати на житло)</h4>\n                        <p>Витрати на житло, включаючи базову орендну плату, комунальні послуги та опалення. Оплачуються суворо в тому випадку, якщо квартира вважається \"доцільною\" (<em>angemessen</em>).</p>\n                    </div>\n                </div>\n\n                <div class=\"rule-box amber-rule\">\n                    <h3>\n                        <span class=\"inline-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg>\n                        </span>\n                        Правило \"відповідної/доцільної квартири\"\n                    </h3>\n                    <p>Це те, на чому спотикається більшість сімей. Кожен район визначає свої суворі максимальні ліміти оренди. <strong>Ніколи не підписуйте договір оренди до отримання письмового схвалення від Jobcenter (Mietbescheinigung).</strong> Якщо ви підпишете договір передчасно, вам доведеться платити різницю в оренді з власної кишені.</p>\n                </div>\n\n                <h3 class=\"subsection-title\">Додаткові виплати (потребують окремих заявок):</h3>\n                <div class=\"three-column-grid compact-grid\">\n                    <div class=\"guide-mini-card\">\n                        <div class=\"card-title-with-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg>\n                            <h3>Erstausstattung</h3>\n                        </div>\n                        <p>Одноразова фінансова допомога на первинне придбання меблів, побутової техніки та одягу. <em>Не надається автоматично.</em></p>\n                    </div>\n                    <div class=\"guide-mini-card\">\n                        <div class=\"card-title-with-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"16\"></line><line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"></line></svg>\n                            <h3>Mehrbedarf</h3>\n                        </div>\n                        <p>Додаткові щомісячні надбавки для вагітних жінок, батьків-одинаків або при особливих медичних дієтах.</p>\n                    </div>\n                    <div class=\"guide-mini-card\">\n                        <div class=\"card-title-with-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 10v6M2 10l10-5 10 5-10 5z\"></path><path d=\"M6 12v5c3 3 9 3 12 0v-5\"></path></svg>\n                            <h3>BuT (Освіта та розвиток)</h3>\n                        </div>\n                        <p>Пакет допомоги для дітей, що покриває шкільне приладдя, обіди, репетиторство та гуртки чи спортивні секції.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 4: Health & Work -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"></path></svg>\n                </span>\n                Медичне страхування, робота та освіта\n            </h2>\n            \n            <div class=\"two-column-grid\">\n                <!-- Health -->\n                <div class=\"guide-subcard\">\n                    <h3>Медичне страхування (Krankenkasse)</h3>\n                    <p>Страхування є обов'язковим. Отримувачі Bürgergeld застраховані через державні медичні каси, які оплачує Jobcenter.</p>\n                    <p><strong>Чи знаєте ви?</strong> Ви можете подати заяву на звільнення від доплати за ліки (<em>Zuzahlungsbefreiung</em>). Крім того, у екстрених випадках лікарні зобов'язані надати вам допомогу, навіть якщо у вас ще немає з собою страхової картки.</p>\n                </div>\n\n                <!-- Work -->\n                <div class=\"guide-subcard\">\n                    <h3>Право на роботу</h3>\n                    <p>Ваша посвідка за § 24 надає вам <strong>повний та необмежений доступ</strong> до ринку праці.</p>\n                    <p>Робота не скасовує підтримку Jobcenter; якщо ваш дохід низький, вони просто доплачують різницю (з урахуванням неоподатковуваних пільг). Однак ви <strong>зобов'язані негайно повідомляти</strong> про будь-який дохід, щоб уникнути суворих штрафів.</p>\n                </div>\n                \n                <!-- Housing Rights -->\n                <div class=\"guide-subcard\">\n                    <h3>Житло та права орендарів</h3>\n                    <p>Орендарі в Німеччині дуже захищені. Орендодавці не можуть виселити вас без судового процесу, а застава (<em>Kaution</em>) суворо обмежена сумою 3 місячних базових орендних плат.</p>\n                    <p><strong>Важливо:</strong> Завжди заповнюйте акт прийому-передачі (<em>Übergabeprotokoll</em>) з фотографіями під час заселення. Настійно рекомендується приєднатися до місцевого союзу орендарів (<em>Mieterverein</em>).</p>\n                </div>\n\n                <!-- Education -->\n                <div class=\"guide-subcard\">\n                    <h3>Школа та визнання дипломів</h3>\n                    <p>Відвідування школи є юридично обов'язковим (<em>Schulpflicht</em>) для дітей. Прогули призводять до негайних проблем із владою.</p>\n                    <p>Для дорослих з регламентованими професіями (наприклад, медицина, викладання) необхідно пройти офіційну процедуру визнання (<em>Anerkennung</em>). Jobcenter часто може профінансувати цю коштовну процедуру.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 5: Bescheid & Widerspruch -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polyline points=\"12 6 12 12 16 14\"></polyline></svg>\n                </span>\n                Найважливіший процес: Bescheid та Widerspruch\n            </h2>\n            \n            <div class=\"guide-card alert-card-border\">\n                <div class=\"card-header\">\n                    <h3>Як спілкується німецька бюрократія</h3>\n                    <span class=\"status-tag critical\">Критично за часом</span>\n                </div>\n                <p>Кожне офіційне рішення надходить у письмовому вигляді через документ, який називається <strong>Bescheid</strong> (Офіційне рішення). Наприкінці є розділ, який пояснює ваше право на оскарження (<em>Rechtsbehelfsbelehrung</em>).</p>\n                \n                <div class=\"rule-box red-rule\">\n                    <h3>\n                        <span class=\"inline-icon\">\n                            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line></svg>\n                        </span>\n                        Один місяць. Це весь час, який у вас є.\n                    </h3>\n                    <p>Стандартний термін для подачі апеляції/заперечення (<strong>Widerspruch</strong>) становить рівно один місяць з дня вручення рішення. Якщо ви пропустите це вікно, рішення стає остаточним та його майже неможливо змінити.</p>\n                </div>\n\n                <div class=\"detail-box full-width-detail\">\n                    <h4>Що вам потрібно зробити на практиці:</h4>\n                    <ol class=\"action-steps-list\">\n                        <li>Відкривайте кожен лист негайно та перевіряйте дату.</li>\n                        <li>Якщо рішення неправильне, напишіть простий <em>Widerspruch</em> (Заперечення). Це не має бути складний юридичний текст. Просто напишіть своє ім'я, номер справи, дату та \"Я не згоден з цим рішенням\". Детальне обґрунтування можна надіслати пізніше.</li>\n                        <li>Надішліть його рекомендованим листом (<em>Einschreiben</em>) або віддайте особисто та отримайте штамп про вручення. Збережіть копію.</li>\n                        <li><strong>Ніколи не ігноруйте листи.</strong> У Німеччині мовчання означає згоду.</li>\n                    </ol>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 6: Mistakes & Links -->\n        <div class=\"guide-block\">\n            <div class=\"two-column-grid\">\n                \n                <!-- 8 Mistakes -->\n                <div class=\"guide-subcard\">\n                    <h3 class=\"card-title-flex\">\n                        <span class=\"icon-danger\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"15\" y1=\"9\" x2=\"9\" y2=\"15\"></line><line x1=\"9\" y1=\"9\" x2=\"15\" y2=\"15\"></line></svg>\n                        </span>\n                        8 найпоширеніших помилок\n                    </h3>\n                    <ul class=\"numbered-list\">\n                        <li><strong>1. Не подавати заяви на додаткові виплати.</strong> Кошти на меблі та освіту не призначаються автоматично.</li>\n                        <li><strong>2. Наосліп підписувати договір оренди.</strong> Спочатку дочекайтеся схвалення Jobcenter.</li>\n                        <li><strong>3. Пропуск 1-місячного терміну апеляції.</strong></li>\n                        <li><strong>4. Неповідомлення про зміни в житті.</strong> Про зміни доходу/адреси потрібно повідомляти негайно.</li>\n                        <li><strong>5. Покладатися на телефонні дзвінки.</strong> Якщо цього немає у письмовому вигляді, цього не було.</li>\n                        <li><strong>6. Втрата документів.</strong> Заведіть папку та фотографуйте кожен лист.</li>\n                        <li><strong>7. Затягування з визнанням диплома.</strong> Процес займає місяці.</li>\n                        <li><strong>8. Підписання документів без розуміння.</strong> Вимагайте перекладача або пояснень.</li>\n                    </ul>\n                </div>\n\n                <!-- Links -->\n                <div class=\"guide-subcard\">\n                    <h3 class=\"card-title-flex\">\n                        <span class=\"icon-primary\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\"></path><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\"></path></svg>\n                        </span>\n                        Офіційні ресурси\n                    </h3>\n                    \n                    <span class=\"resource-group-title\">Портали та підтримка</span>\n                    <a href=\"https://www.germany4ukraine.de\" target=\"_blank\" rel=\"noopener\" class=\"resource-link\"><strong>Germany4Ukraine</strong> Офіційний державний портал</a>\n                    <a href=\"https://handbookgermany.de\" target=\"_blank\" rel=\"noopener\" class=\"resource-link\"><strong>Handbook Germany</strong> Довідник (UA/RU/EN)</a>\n                    <a href=\"https://www.arbeitsagentur.de\" target=\"_blank\" rel=\"noopener\" class=\"resource-link\"><strong>Agentur für Arbeit</strong> Агентство з працевлаштування</a>\n                    <a href=\"https://www.jobcenter-ge.de\" target=\"_blank\" rel=\"noopener\" class=\"resource-link\"><strong>Jobcenter Portal</strong> Знайти своє відділення</a>\n\n                    <span class=\"resource-group-title\">Права та юридична допомога</span>\n                    <a href=\"https://www.bamf.de/DE/Themen/Integration/ZugewanderteTeilnehmende/Migrationsberatung/migrationsberatung-node.html\" target=\"_blank\" rel=\"noopener\" class=\"resource-link\"><strong>Центри MBE</strong> Безкоштовні міграційні консультації</a>\n                    <a href=\"https://www.mieterbund.de\" target=\"_blank\" rel=\"noopener\" class=\"resource-link\"><strong>Deutscher Mieterbund</strong> Німецький союз орендарів</a>\n                    <a href=\"https://anwaltauskunft.de\" target=\"_blank\" rel=\"noopener\" class=\"resource-link\"><strong>Anwaltverein</strong> Знайти адвоката</a>\n                    \n                    <div class=\"notice-highlight compact-notice\">\n                        <strong>Потрібна юридична допомога?</strong> Запитайте у місцевому суді талон на юридичну консультацію (<em>Beratungshilfeschein</em>) для отримання недорогої юридичної допомоги.\n                    </div>\n                </div>\n\n            </div>\n        </div>\n\n        <!-- Section 7: CTA -->\n        <div class=\"guide-block\">\n            <div class=\"guide-card cta-box\">\n                <h3>Як ZusammenLeben може допомогти</h3>\n                <p class=\"cta-description\">\n                    Ми пояснюємо листи простими словами, допомагаємо зрозуміти терміни, готуємо вас до візитів в установи та зв'язуємо з консультантами. <em>(Примітка: Ми не є юристами та не можемо надавати юридичні консультації або подавати апеляції від вашого імені).</em>\n                </p>\n                <p class=\"cta-statement\">\n                    Зв'яжіться з нами негайно, якщо ви отримали лист з дедлайном, перед підписанням договору оренди або якщо термін дії вашої посвідки закінчується!\n                </p>\n                \n                <!-- BUTTONS -->\n                <div class=\"mbr-section-btn cta-buttons-wrapper\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn custom-btn whatsapp-btn display-4 btn-warning\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                        Написати Ганні у WhatsApp\n                    </a>\n                    <a class=\"btn custom-btn outline-btn btn-primary\" href=\"mailto:zusammenleben.de@gmail.com\" data-app-placeholder=\"Type Text\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"></path><polyline points=\"22,6 12,13 2,6\"></polyline></svg>\n                        Надіслати нам Email\n                    </a></div>\n            </div>\n        </div>\n\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "header01-2a",
          "_isUserblock": true,
          "_cid": "vqj8NxcbaH",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            },
            "a[href*=\"thebwas.com\"]": {
              "text-decoration": "underline",
              "text-underline-offset": "3px"
            },
            ".soc-item a": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-width": "44px",
              "min-height": "44px"
            },
            ".item-wrap a": {
              "word-break": "normal !important",
              "overflow-wrap": "normal !important",
              "hyphens": "auto",
              "-webkit-hyphens": "auto"
            },
            "@media (max-width: 767px)": {
              ".lists-wrapper": {
                "display": "grid !important",
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr)",
                "column-gap": "16px"
              },
              ".lists-wrapper .list-wrap": {
                "width": "auto !important",
                "max-width": "none !important",
                "margin": "0 !important"
              },
              ".lists-wrapper .item-wrap a": {
                "overflow-wrap": "break-word !important"
              }
            },
            "@media (min-width: 768px)": {
              ".lists-wrapper": {
                "display": "grid !important",
                "grid-template-columns": "repeat(4, minmax(0, 1fr))",
                "column-gap": "16px"
              },
              ".lists-wrapper .list-wrap": {
                "width": "auto !important",
                "max-width": "none !important",
                "margin": "0 !important",
                "min-width": "0"
              },
              ".lists-wrapper .item-wrap a": {
                "overflow-wrap": "break-word !important"
              }
            }
