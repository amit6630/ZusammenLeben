          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            ".regional-executive-section": {
              "padding": "70px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.6",
              "direction": "ltr",
              "text-align": "left"
            },
            ".regional-executive-section *": {
              "box-sizing": "border-box"
            },
            ".executive-container": {
              "max-width": "1050px",
              "margin": "0 auto",
              "padding": "0 24px",
              "width": "100%"
            },
            ".executive-header": {
              "text-align": "center",
              "max-width": "780px",
              "margin": "0 auto 50px"
            },
            ".header-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-top": "50px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "border": "1px solid #bfdbfe"
            },
            ".header-title": {
              "font-size": "2.6rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.02em",
              "margin": "0 0 16px 0",
              "line-height": "1.2"
            },
            ".header-lead": {
              "font-size": "1.2rem",
              "color": "#475569",
              "margin": "0"
            },
            ".section-block": {
              "margin-bottom": "60px"
            },
            ".block-title": {
              "font-size": "1.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "24px",
              "display": "flex",
              "align-items": "center",
              "gap": "10px"
            },
            ".title-icon": {
              "font-size": "1.3rem",
              "display": "inline-flex",
              "align-items": "center"
            },
            ".philosophy-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "40px",
              "position": "relative",
              "overflow": "hidden",
              "margin-bottom": "60px",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.03)"
            },
            ".card-accent-line": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "6px",
              "height": "100%",
              "background": "#2563eb"
            },
            ".philosophy-card h2": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "margin": "0 0 14px 0",
              "color": "#0f172a"
            },
            ".philosophy-card p": {
              "font-size": "1.08rem",
              "color": "#334155",
              "margin": "0",
              "line-height": "1.7"
            },
            ".pillars-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(280px, 1fr))",
              "gap": "20px"
            },
            ".pillar-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "14px",
              "padding": "24px",
              "display": "flex",
              "gap": "16px",
              "transition": "transform 0.2s ease, box-shadow 0.2s ease",
              "min-width": "0"
            },
            ".pillar-card:hover": {
              "transform": "translateY(-3px)",
              "box-shadow": "0 12px 24px rgba(0, 0, 0, 0.04)",
              "border-color": "#cbd5e1"
            },
            ".pillar-icon": {
              "font-size": "1.8rem",
              "flex-shrink": "0",
              "background": "#f1f5f9",
              "width": "48px",
              "height": "48px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "border-radius": "10px"
            },
            ".pillar-content h3": {
              "font-size": "1.1rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 6px 0"
            },
            ".pillar-content p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.5"
            },
            ".map-layout-grid": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "gap": "24px",
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "20px",
              "box-shadow": "0 10px 30px rgba(0, 0, 0, 0.02)"
            },
            ".map-wrapper": {
              "width": "100%",
              "min-height": "420px",
              "border-radius": "12px",
              "overflow": "hidden",
              "border": "1px solid #cbd5e1"
            },
            ".towns-scroll-list": {
              "max-height": "420px",
              "overflow-y": "auto",
              "padding-right": "8px",
              "display": "flex",
              "flex-direction": "column",
              "gap": "12px"
            },
            ".town-row": {
              "background": "#f8fafc",
              "border": "1px solid #f1f5f9",
              "padding": "14px 16px",
              "border-radius": "10px"
            },
            ".town-row.focus-row": {
              "background": "#eff6ff",
              "border-color": "#bfdbfe"
            },
            ".town-name": {
              "font-size": "1rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "4px",
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center"
            },
            ".badge-tag": {
              "font-size": "0.7rem",
              "background": "#2563eb",
              "color": "#ffffff",
              "padding": "2px 8px",
              "border-radius": "100px",
              "font-weight": "700"
            },
            ".town-row p": {
              "font-size": "0.88rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.45"
            },
            ".towns-footnote": {
              "font-size": "0.88rem",
              "color": "#64748b",
              "margin-top": "14px",
              "font-style": "italic"
            },
            ".reality-comparison-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(280px, 1fr))",
              "gap": "24px"
            },
            ".reality-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "30px",
              "position": "relative"
            },
            ".reality-card.advantages": {
              "border-top": "4px solid #16a34a"
            },
            ".reality-card.considerations": {
              "border-top": "4px solid #d97706"
            },
            ".reality-badge": {
              "font-size": "0.7rem",
              "font-weight": "800",
              "color": "#16a34a",
              "letter-spacing": "1px",
              "margin-bottom": "8px"
            },
            ".warning-badge": {
              "color": "#d97706"
            },
            ".reality-card h3": {
              "font-size": "1.25rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "0 0 12px 0"
            },
            ".reality-card p": {
              "font-size": "0.98rem",
              "color": "#334155",
              "margin": "0",
              "line-height": "1.6"
            },
            ".scope-notice-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-left": "4px solid #64748b",
              "border-radius": "12px",
              "padding": "24px",
              "display": "flex",
              "gap": "16px",
              "margin-bottom": "50px"
            },
            ".notice-icon": {
              "font-size": "1.5rem",
              "flex-shrink": "0"
            },
            ".notice-body h4": {
              "font-size": "1rem",
              "font-weight": "700",
              "color": "#334155",
              "margin": "0 0 6px 0"
            },
            ".notice-body p": {
              "font-size": "0.92rem",
              "color": "#64748b",
              "margin": "0",
              "line-height": "1.5"
            },
            ".executive-cta-wrapper": {
              "text-align": "center"
            },
            ".regional-executive-section .btn-success": {
              "background-color": "#25d366 !important",
              "border-color": "#25d366 !important",
              "color": "#ffffff !important",
              "padding": "18px 36px !important",
              "border-radius": "100px !important",
              "font-weight": "700 !important",
              "font-size": "1.05rem !important",
              "display": "inline-flex !important",
              "align-items": "center !important",
              "justify-content": "center !important",
              "gap": "10px !important",
              "box-shadow": "0 8px 20px rgba(37, 211, 102, 0.2) !important",
              "transition": "all 0.25s ease !important",
              "text-decoration": "none !important",
              "max-width": "100%"
            },
            ".regional-executive-section .btn-success:hover": {
              "background-color": "#20bd5a !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 12px 25px rgba(37, 211, 102, 0.3) !important"
            },
            "@media (max-width: 900px)": {
              ".map-layout-grid": {
                "grid-template-columns": "1fr",
                "padding": "16px"
              },
              ".map-wrapper": {
                "min-height": "280px"
              },
              ".towns-scroll-list": {
                "max-height": "350px"
              }
            },
            "@media (max-width: 640px)": {
              ".regional-executive-section": {
                "padding": "40px 0 !important"
              },
              ".executive-container": {
                "padding": "0 16px"
              },
              ".executive-header": {
                "margin-bottom": "32px"
              },
              ".header-title": {
                "font-size": "1.8rem"
              },
              ".header-lead": {
                "font-size": "1rem"
              },
              ".section-block": {
                "margin-bottom": "40px"
              },
              ".block-title": {
                "font-size": "1.25rem"
              },
              ".philosophy-card": {
                "padding": "20px 16px 20px 22px",
                "margin-bottom": "40px"
              },
              ".philosophy-card h2": {
                "font-size": "1.2rem"
              },
              ".philosophy-card p": {
                "font-size": "0.98rem"
              },
              ".pillars-grid, .reality-comparison-grid": {
                "grid-template-columns": "1fr",
                "gap": "14px"
              },
              ".pillar-card": {
                "padding": "16px"
              },
              ".reality-card": {
                "padding": "20px 16px"
              },
              ".scope-notice-card": {
                "flex-direction": "row",
                "padding": "16px",
                "gap": "12px",
                "margin-bottom": "32px"
              },
              ".regional-executive-section .btn-success": {
                "width": "100% !important",
                "padding": "16px 20px !important",
                "font-size": "1rem !important"
              }
            }
          },
          "_name": "article07",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"regional-executive-section\" id=\"regional-focus-page\">\n    <div class=\"executive-container\">\n        \n        <!-- Top Editorial Header -->\n        <header class=\"executive-header\">\n            <div class=\"header-tag\">РЕГІОНАЛЬНА СПЕЦІАЛІЗАЦІЯ</div>\n            <h1 class=\"header-title\">Північна Баварія та Верхня Франконія</h1>\n            <p class=\"header-lead\">\n                Чому ми працюємо в одному конкретному регіоні — і як цей цілеспрямований підхід забезпечує реальну стабільність для новоприбулих родин.\n            </p>\n        </header>\n\n        <!-- Core Philosophy Card -->\n        <div class=\"executive-card philosophy-card\">\n            <div class=\"card-accent-line\"></div>\n            <h2>Глибина замість масштабу</h2>\n            <p>\n                Ми могли б легко заявити, що працюємо по всій Німеччині. Це звучало б солідніше, але на практиці було б набагато менш ефективно. Справжній, надійний супровід вимагає глибокого знання місцевої специфіки: знати конкретного муніципального службовця, який веде вашу справу, яка школа має вільні місця для україномовних детей, яка управляюча компанія готова працювати безпосередньо з Jobcenter, і де саме зараз є реальні вільні квартири.\n            </p>\n        </div>\n\n        <!-- 6 Core Pillars Grid with Icons -->\n        <div class=\"section-block\">\n            <h2 class=\"block-title\"><span class=\"title-icon\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 4px;\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm0-14c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z\"></path></svg></span> Що дає наша місцева специализация</h2>\n            \n            <div class=\"pillars-grid\">\n                <div class=\"pillar-card\">\n                    <div class=\"pillar-icon\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 1L2 6v2h20V6L12 1zm-7 8v8h2V9H5zm4 0v8h2V9H9zm4 0v8h2V9h-2zm4 0v8h2V9h-2zM2 19v2h20v-2H2z\"></path></svg></div>\n                    <div class=\"pillar-content\">\n                        <h3>Муніципальні органи влади</h3>\n                        <p>Ми знаємо, як працюють міські адміністрації в кожному місті, їхні специфічні вимоги та реальні терміни обробки документів.</p>\n                    </div>\n                </div>\n\n                <div class=\"pillar-card\">\n                    <div class=\"pillar-icon\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v2h2v-2h2v-2h-8.35zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z\"></path></svg></div>\n                    <div class=\"pillar-content\">\n                        <h3>Орендодавці та управляючі компанії</h3>\n                        <p>Відносини, побудовані роками. Орендодавці, які знають нас, реагують швидше та готові йти на співпрацю в незнайомих для них ситуаціях прийому нових мешканців.</p>\n                    </div>\n                </div>\n\n                <div class=\"pillar-card\">\n                    <div class=\"pillar-icon\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z\"></path></svg></div>\n                    <div class=\"pillar-content\">\n                        <h3>Робота місцевих Jobcenter</h3>\n                        <p>Накопичений досвід щодо очікувань регіональних Jobcenter, необхідних документів та стандартів узгодження.</p>\n                    </div>\n                </div>\n\n                <div class=\"pillar-card\">\n                    <div class=\"pillar-icon\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z\"></path></svg></div>\n                    <div class=\"pillar-content\">\n                        <h3>Освітні заклади</h3>\n                        <p>Ми знаємо, які школи та дитячі садки приймають нових дітей і де діють спеціальні класи мовної підтримки.</p>\n                    </div>\n                </div>\n\n                <div class=\"pillar-card\">\n                    <div class=\"pillar-icon\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\"></path></svg></div>\n                    <div class=\"pillar-content\">\n                        <h3>Існуюча спільнота</h3>\n                        <p>Нові родини прибувають у регіон, де інші вже успішно пройшли точно такий самий шлях.</p>\n                    </div>\n                </div>\n\n                <div class=\"pillar-card\">\n                    <div class=\"pillar-icon\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"></path></svg></div>\n                    <div class=\"pillar-content\">\n                        <h3>Особиста підтримка</h3>\n                        <p>Реальна фізична присутність — ми можемо зустрітися з вами на місці, супроводити на офіційні візити та особисто оглянути квартиры.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Regional Interactive Map & Cities Overview -->\n        <div class=\"section-block\">\n            <h2 class=\"block-title\"><span class=\"title-icon\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 4px;\"><path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\"></path></svg></span> Ключові населені пункти в нашому регіоні діяльності</h2>\n            \n            <div class=\"map-layout-grid\">\n                <!-- Google Map Embed -->\n                <div class=\"map-wrapper\">\n                    <iframe title=\"Northern Bavaria Map\" src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d326922.3888365874!2d11.668512534575822!3d50.22237077651036!2m3!1f0!f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47a10fbc2867e0eb%3A0x10132fed3273ed0!2sOberfranken%2C%20Germany!5e0!3m2!1sen!2sde!4v1710000000000!5m2!1sen!2sde\" width=\"100%\" height=\"100%\" style=\"border:0;\" allowfullscreen loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\">\n                    </iframe>\n                </div>\n\n                <!-- Municipalities List -->\n                <div class=\"towns-scroll-list\">\n                    <div class=\"town-row focus-row\">\n                        <div class=\"town-name\">Helmbrechts <span class=\"badge-tag\">Головний хаб</span></div>\n                        <p>Середнє місто з необхідними місцевими послугами та доступним житлом. Основний центр нашої діяльності.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Münchberg</div>\n                        <p>Місто з хорошим залізничним та автомобільним сполученням, місцевими навчальними закладами та послугами для жителів.</p>\n                    </div>\n\n                    <div class=\"town-row focus-row\">\n                        <div class=\"town-name\">Hof <span class=\"badge-tag\">Регіональний центр</span></div>\n                        <p>Найбільше місто в цьому районі. Найвища концентрація установ та послуг, різноманітні школи, комплексне медичне обслуговування та громадський транспорт.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Selb</div>\n                        <p>Промислове місто з досвідом інтеграції робітників, місцевими послугами та наявним житловим фондом.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Wunsiedel</div>\n                        <p>Районний центр, де розміщені органи місцевого самоврядування та регіональні службы.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Arzberg</div>\n                        <p>Менше поселення з тихим житловим характером і наявністю житла, яка змінюється з часом.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Marktredwitz</div>\n                        <p>Регіональний вузоל з хорошими комерційними можливостями, послугами та транспортним сполученням.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Naila</div>\n                        <p>Місто, що пропонує місцеві послуги та навчальні заклади в відносно сільській атмосфері.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Kulmbach</div>\n                        <p>Місто з місцевою владою, освітніми та медичними послугами та розвиненою інфраструктурою.</p>\n                    </div>\n\n                    <div class=\"town-row\">\n                        <div class=\"town-name\">Bad Steben</div>\n                        <p>Невелике курортне та оздоровче місто, тихе та з більш обмеженими загальними послугами.</p>\n                    </div>\n                </div>\n            </div>\n\n            <p class=\"towns-footnote\">\n                * А також додаткові навколишні міста та громади по всій Північній Баварії та Верхній Франконії залежно від потреб та наявності місць.\n            </p>\n        </div>\n\n        <!-- Regional Reality / Characteristics -->\n        <div class=\"section-block\">\n            <h2 class=\"block-title\"><span class=\"title-icon\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"vertical-align: -3px; margin-right: 4px;\"><path d=\"M14 9.5V6h3V4H7v2h3v3.5L3 13v2h2.2c.4 1.7 1.9 3 3.8 3s3.4-1.3 3.8-3H15c.4 1.7 1.9 3 3.8 3s3.4-1.3 3.8-3H21v-2l-7-3.5zM9 16c-.8 0-1.5-.7-1.5-1.5S8.2 13 9 13s1.5.7 1.5 1.5S9.8 16 9 16zm9.8 0c-.8 0-1.5-.7-1.5-1.5s.7-1.5 1.5-1.5 1.5.7 1.5 1.5-.7 1.5-1.5 1.5z\"></path></svg></span> Що варто знати про регіон</h2>\n            \n            <div class=\"reality-comparison-grid\">\n                <div class=\"reality-card advantages\">\n                    <div class=\"reality-badge\">ПЕРЕВАГИ</div>\n                    <h3>&gt;Очевидні переваги</h3>\n                    <p>Це сільсько-міський регіон, а не мегаполіс. Переваги очевидні: нижчі витрати на житло, ніж у великих містах, тиха обстановка, менші освітні заклади та менше адміністративне перевантаження.</p>\n                </div>\n\n                <div class=\"reality-card considerations\">\n                    <div class=\"reality-badge warning-badge\">ОЧІКУВАННЯ</div>\n                    <h3>Фактори, які слід враховувати</h3>\n                    <p>Громадський транспорт у менших містах ходить рідше, ніж у мегаполісах, можливості працевлаштування більш обмежені, а для отримання певних послуг може знадобитися поїздка до сусіднього міста. Родини, які приїжджають з Києва чи Харкова, часто відчувають зміну темпу життя. Ми говорим про це відкрито, щоб сформувати реалістичні очікування.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Geographic Scope Clarification -->\n        <div class=\"scope-notice-card\">\n            <div class=\"notice-icon\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z\"></path></svg></div>\n            <div class=\"notice-body\">\n                <h4>Уточнення щодо географиї діяльності</h4>\n                <p>\n                    Наша операційна підтримка не поширюється повністю на всю Німеччину. Запити з інших регіонів будуть розглянуті, але в більшості випадків ми не можемо надати практичну допомогу за межами нашего основного регіону. За можливості ми постараємося перенаправити вас до відповідного місцевого контакту.\n                </p>\n            </div>\n        </div>\n\n        <!-- Direct WhatsApp Action Button -->\n        <div class=\"mbr-section-btn cta-buttons-wrapper\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn custom-btn whatsapp-btn display-4 btn-warning\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\">\n                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                Написати Анні у WhatsApp\n            </a></div>\n\n    </div>\n</section>",
          "_cid": "vqdOIvJmvE",
          "_anchor": "article07-1w",
