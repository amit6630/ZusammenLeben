              "min-width": "28px",
              "height": "28px",
              "padding": "0 8px",
              "border-radius": "999px",
              "background": "#e0e7ff",
              "color": "#0c2c68",
              "font-size": "14px",
              "font-weight": "700"
            },
            ".zl-rail": {
              "display": "flex",
              "gap": "16px",
              "overflow-x": "auto",
              "scroll-snap-type": "x mandatory",
              "overscroll-behavior-x": "contain",
              "padding": "4px 2px 16px",
              "scrollbar-width": "none"
            },
            ".zl-rail::-webkit-scrollbar": {
              "display": "none"
            },
            ".zl-rail > .zl-tile": {
              "flex": "0 0 calc((100% - 48px) / 3.6)",
              "min-width": "230px",
              "scroll-snap-align": "start"
            },
            ".zl-rail-wrap": {
              "position": "relative"
            },
            ".zl-rail-btn": {
              "position": "absolute",
              "top": "calc(50% - 30px)",
              "z-index": "2",
              "width": "44px",
              "height": "44px",
              "border-radius": "50%",
              "border": "1px solid #e2e8f0",
              "background": "#fff",
              "color": "#0c2c68",
              "display": "grid",
              "place-items": "center",
              "cursor": "pointer",
              "box-shadow": "0 6px 18px rgba(15, 23, 42, .14)"
            },
            ".zl-rail-btn svg": {
              "width": "20px",
              "height": "20px"
            },
            ".zl-rail-btn:hover": {
              "background": "#e0e7ff"
            },
            ".zl-rail-btn[hidden]": {
              "display": "none"
            },
            ".zl-rail-prev": {
              "left": "4px"
            },
            ".zl-rail-next": {
              "right": "4px"
            },
            ".zl-rail .zl-tile h3": {
              "font-size": "17px"
            },
            ".zl-rail .zl-tile p": {
              "display": "-webkit-box",
              "-webkit-line-clamp": "3",
              "-webkit-box-orient": "vertical",
              "overflow": "hidden"
            },
            ".zl-comm-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(230px, 1fr))",
              "gap": "16px",
              "margin": "6px 0 0"
            },
            ".zl-comm-grid .zl-tile:hover": {
              "transform": "none",
              "box-shadow": "none",
              "border-color": "#e2e8f0"
            },
            "@media (max-width: 575px)": {
              ".zl-grid": {
                "grid-template-columns": "1fr 1fr",
                "gap": "10px"
              },
              ".zl-grid .zl-tile": {
                "padding": "14px",
                "gap": "8px"
              },
              ".zl-grid .zl-tile p, .zl-grid .zl-tile .zl-more": {
                "display": "none"
              },
              ".zl-grid .zl-tile h2, .zl-grid .zl-tile h3": {
                "font-size": "15px"
              },
              ".zl-grid .zl-ico": {
                "width": "34px",
                "height": "34px"
              },
              ".zl-rail > .zl-tile": {
                "flex-basis": "72%",
                "min-width": "0",
                "padding": "14px"
              },
              ".zl-rail .zl-tile p": {
                "-webkit-line-clamp": "2",
                "font-size": "14px"
              },
              ".zl-rail-btn": {
                "display": "none"
              },
              ".zl-cat": {
                "font-size": "19px",
                "margin-top": "22px"
              },
              ".zl-comm-grid": {
                "gap": "10px"
              },
              ".zl-comm-grid .zl-tile": {
                "padding": "16px"
              },
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            },
            "@media (max-width: 991px)": {
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_name": "article08",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"zl-page\">\n<div class=\"zl-wrap\">\n<nav class=\"zl-crumbs\" aria-label=\"Навігація\"><ol><li><a href=\"index.html\">Головна</a></li><li aria-current=\"page\">Вихідні дані (Impressum)</li></ol></nav>\n<h1>Вихідні дані (Impressum)</h1>\n<div class=\"zl-card zl-body\"><h2>Інформація згідно з § 5 DDG</h2>\n<p>ZusammenLeben, волонтерська ініціатива<br>Ben Shamir<br>Alte Hofer Str. 1<br>95176 Konradsreuth<br>Німеччина</p>\n<h2>Контакти</h2>\n<p>Телефон: <a href=\"tel:+380637004615\">+380 63 700 4615</a><br>E-mail: <a href=\"mailto:zusammenleben.de@gmail.com\">zusammenleben.de@gmail.com</a></p>\n<h2>Відповідальний за зміст згідно з § 18 (2) MStV</h2>\n<p>Ben Shamir, адреса як вище.</p>\n<h2>Відповідальність</h2>\n<p>Ми ретельно готуємо матеріали сайту, але не гарантуємо їхньої повноти, точності та актуальності. За зміст зовнішніх сайтів, на які ми посилаємося, відповідають їхні власники. Див. також <a href=\"usingtheweb.html\">умови використання</a> та <a href=\"privacy.html\">політику конфіденційності</a>.</p></div>\n</div>\n</section>",
          "_cid": "zlae6383be",
          "_anchor": "zl-page-45",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            },
            "a[href*=\"thebwas.com\"]": {
              "text-decoration": "underline",
              "text-underline-offset": "3px"
            },
            ".soc-item a": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-width": "44px",
              "min-height": "44px"
            },
            ".item-wrap a": {
              "word-break": "normal !important",
              "overflow-wrap": "normal !important",
              "hyphens": "auto",
              "-webkit-hyphens": "auto"
            },
            "@media (max-width: 767px)": {
              ".lists-wrapper": {
                "display": "grid !important",
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr)",
                "column-gap": "16px"
              },
              ".lists-wrapper .list-wrap": {
                "width": "auto !important",
                "max-width": "none !important",
                "margin": "0 !important"
              },
              ".lists-wrapper .item-wrap a": {
                "overflow-wrap": "break-word !important"
              }
            },
            "@media (min-width: 768px)": {
              ".lists-wrapper": {
                "display": "grid !important",
                "grid-template-columns": "repeat(4, minmax(0, 1fr))",
                "column-gap": "16px"
              },
              ".lists-wrapper .list-wrap": {
                "width": "auto !important",
                "max-width": "none !important",
                "margin": "0 !important",
                "min-width": "0"
              },
              ".lists-wrapper .item-wrap a": {
                "overflow-wrap": "break-word !important"
              }
            }
