              },
              ".dropdown-menu .dropdown-item": {
                "padding": "0.25rem 0.8rem !important",
                "font-size": "0.78rem !important",
                "margin": "0 !important",
                "text-align": "center"
              },
              ".mbr-section-btn": {
                "display": "flex",
                "flex-wrap": "wrap",
                "justify-content": "center",
                "padding": "2px 0",
                ".btn": {
                  "padding": "0.35rem 0.8rem !important",
                  "font-size": "0.82rem !important",
                  "flex-grow": "1",
                  "margin": "4px 15px"
                }
              },
              "nav.opened .dropdown-menu": {
                "top": "0"
              },
              ".mobile-only .lang-link": {
                "min-width": "30px",
                "min-height": "40px",
                "justify-content": "center"
              },
              ".navbar-caption": {
                "word-break": "normal !important",
                "overflow-wrap": "normal !important"
              },
              "button.navbar-toggler": {
                "width": "44px !important",
                "height": "44px !important",
                "padding": "13px 9px !important"
              },
              "button.navbar-toggler .hamburger": {
                "position": "relative",
                "width": "26px",
                "height": "18px"
              }
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border-bottom": "1px solid #e6e6e6",
              "padding": "0.5rem 1.8rem",
              "transition": "all 0.25s ease-in-out",
              "&:hover, &:focus": {
                "background": "@primaryColor !important",
                "color": "white !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom": "none",
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative",
              "transition": "all 0.2s",
              "&:hover": {
                "color": "@primaryColor !important"
              }
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".navbar-buttons": {
              "text-align": "center",
              "min-width": "0",
              "flex-shrink": "0"
            },
            ".card-wrap": {
              "display": "flex",
              "align-items": "center",
              "padding": "2px 4px",
              "min-width": "auto"
            },
            ".contacts-menu .mbr-iconfont": {
              "color": "#ffffff"
            },
            ".contacts-menu .menu-divider": {
              "color": "#ccc",
              "font-weight": "300",
              "margin": "0 1px"
            },
            ".desktop-only-flex .mbr-iconfont": {
              "color": "@iconsContactColor"
            },
            ".flags-menu": {
              "display": "flex",
              "align-items": "center",
              "gap": "5px",
              "background": "rgba(0, 0, 0, 0.03)",
              "padding": "3px 8px",
              "border-radius": "20px",
              "border": "1px solid #eaeaea"
            },
            ".lang-link": {
              "display": "flex",
              "align-items": "center",
              "gap": "3px",
              "text-decoration": "none !important",
              "transition": "transform 0.2s ease",
              "&:hover": {
                "transform": "scale(1.08)"
              },
              "white-space": "nowrap",
              "flex-shrink": "0"
            },
            ".lang-code": {
              "font-size": "12px",
              "font-weight": "700",
              "color": "#333",
              "letter-spacing": "0.5px",
              "white-space": "nowrap"
            },
            ".flag-divider": {
              "color": "#ccc",
              "font-size": "12px"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "28px",
              "height": "18px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "flex-basis": "auto",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "26px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "0",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "top": "6px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "top": "6px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "top": "12px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "6px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "6px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".navbar-nav .nav-link": {
              "white-space": "nowrap"
            },
            ".navbar-buttons .btn": {
              "white-space": "nowrap"
            },
            "@media (min-width: 992px) and (max-width: 1399px)": {
              ".navbar-nav .nav-link, .navbar-nav .dropdown-item": {
                "font-size": "14px !important"
              },
              ".navbar-nav .nav-link": {
                "padding-left": ".3em !important",
                "padding-right": ".3em !important"
              },
              ".navbar-buttons .btn": {
                "padding": ".55rem 1rem !important",
                "font-size": "14px !important"
              },
              ".navbar-nav": {
                "margin": "0 !important"
              }
            },
            "@media (min-width: 992px) and (max-width: 1199px)": {
              ".navbar-buttons .btn": {
                "padding": ".5rem .8rem !important",
                "font-size": "13.5px !important"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" global once=\"menu\">\n    <mbr-parameters>\n        <header>Розмір</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Повна ширина\" checked>\n        <header>Показати/Приховати</header>\n        <input type=\"checkbox\" title=\"Логотип\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Розмір логотипу\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Назва бренду\" name=\"showBrand\" checked>\n        <input type=\"checkbox\" title=\"Телефон\" name=\"showPhone\" checked>\n        <input type=\"checkbox\" title=\"Адреса\" name=\"showAddress\" checked>\n        <input type=\"color\" title=\"Колір іконок контактів\" name=\"iconsContactColor\" value=\"#0c2c68\" condition=\"showPhone || showAddress\">\n        <input type=\"checkbox\" title=\"Пункти меню\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Іконки\" name=\"showIcons\">\n        <select title=\"Кількість\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Колір іконок\" name=\"iconsColor\" value=\"#222222\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Кнопка\" name=\"showButtons\" checked>\n        <header>Стилі</header>\n        <input type=\"checkbox\" title=\"Закріплене\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Згорнуте\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Прозоре\" name=\"transparent\">\n        <input type=\"range\" title=\"Прозорість\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Колір\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Гамбургер\" name=\"hamburgerColor\" value=\"#222222\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                 'navbar-expand-lg':!collapsed,\n                 'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"brand-container\">\n                <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"Zusammen Leben\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                    <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-caption-wrap\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"index.html\" data-app-placeholder=\"Type Text\">Zusammen Leben</a></span>\n                </div>\n                \n                <!-- פרטי קשר + דגלים (מוצגים אך ורק במחשב) -->\n                <div class=\"contacts-menu desktop-only-flex\">\n                    <div class=\"card-wrap\">\n                        <span class=\"mobi-mbri-phone mobi-mbri\" style=\"font-size: 18px;\"></span>\n                        <div class=\"card-box\">\n                            <p class=\"mbr-text mbr-fonts-style mb-0 display-4\"><a href=\"tel:+380 63 700 4615\" class=\"text-primary\">+380 63 700 4615</a></p>\n                        </div>\n                    </div>\n                    \n                    <span class=\"menu-divider\">|</span>\n\n                    <div class=\"card-wrap\">\n                        <span class=\"mdi-maps-place\" style=\"font-size: 22px;\"></span>\n                        <div class=\"card-box\">\n                            <p class=\"mbr-text mbr-fonts-style mb-0 display-4\">Konradsreuth Alte Hofer Str. 1</p>\n                        </div>\n                    </div>\n\n                    <span class=\"menu-divider\">|</span>\n\n<div class=\"flags-menu\">\n    <a href=\"../de/index.html\" title=\"Deutsch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/de.png\" srcset=\"https://flagcdn.com/48x36/de.png 2x\" alt=\"Germany\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">DE</span>\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"../index.html\" title=\"English\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/us.png\" srcset=\"https://flagcdn.com/48x36/us.png 2x\" alt=\"United States\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">EN</span>\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"index.html\" title=\"Українська\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/ua.png\" srcset=\"https://flagcdn.com/48x36/ua.png 2x\" alt=\"Ukraine\" width=\"18\" height=\"13\">\n        <span class=\"lang-code\">UA</span>\n    </a>\n</div>\n                </div>\n\n                <!-- דגלים בלבד שיופיעו אך ורק בטלפון ליד ההמבורגר -->\n<div class=\"flags-menu mobile-only\">\n    <a href=\"../de/index.html\" title=\"Deutsch\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/de.png\" alt=\"DE\" width=\"18\" height=\"13\">\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"../index.html\" title=\"English\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/us.png\" alt=\"EN\" width=\"18\" height=\"13\">\n    </a>\n    <span class=\"flag-divider\">|</span>\n    <a href=\"index.html\" title=\"Українська\" class=\"lang-link\">\n        <img src=\"https://flagcdn.com/24x18/ua.png\" alt=\"UA\" width=\"18\" height=\"13\">\n    </a>\n</div>\n\n                <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                    <div class=\"hamburger\">\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                </button>\n            </div>\n            \n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-scroll-collapse>\n                <ul class=\"navbar-nav nav-dropdown\" data-app-modern-menu=\"true\" mbr-menu><li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"index.html\" data-app-placeholder=\"Type Text\">Головна</a>\n                    </li>\n    \n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Про нас</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"social-activity.html\" data-app-placeholder=\"Type Text\">Наша діяльність</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"anna-shishoili.html\" data-app-placeholder=\"Type Text\">Анна Чеішвілі</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"services.html\" data-app-placeholder=\"Type Text\">Послуги</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"request-assistance.html\" data-app-placeholder=\"Type Text\">Запит на допомогу</a>\n                    </li>\n    \n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Життя в Німеччині</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"glossary.html\" data-app-placeholder=\"Type Text\">Глосарій</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"learning-german.html\" data-app-placeholder=\"Type Text\">Вивчення німецької</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"refugee-rights.html\" data-app-placeholder=\"Type Text\">Права українських біженців</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"guides.html\">Посібники та статті</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"areasweserve.html\" data-app-placeholder=\"Type Text\">Регіони обслуговування</a>\n                    </li>\n\n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link dropdown-toggle display-4 text-primary\" href=\"#\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\" data-app-placeholder=\"Type Text\">Спільнота</a>\n                        <div class=\"dropdown-menu\">\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"community.html\" data-app-placeholder=\"Type Text\">Наша спільнота</a>\n                            <a class=\"dropdown-item display-4 text-primary\" href=\"family-stories.html\" data-app-placeholder=\"Type Text\">Історії родин</a>\n                        </div>\n                    </li>\n\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"faq.html#list01-b\" data-app-placeholder=\"Type Text\">Часті запитання</a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link display-4 text-primary\" href=\"how-to-help.html\" data-app-placeholder=\"Type Text\">Як ви можете допомогти</a>\n                    </li>\n    \n                    <!-- Emergency - Highlighted in a separate prominent color -->\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link font-weight-bold display-4 text-primary\" href=\"emergency.html\" style=\"color: #c81e1e !important;\" data-app-placeholder=\"Type Text\">Екстрена допомога</a>\n                    </li></ul>\n                \n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary display-4\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">Зв'яжіться з нами</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "amenu1-2l",
          "_isUserblock": true,
          "_cid": "vquIWTRKB4",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "_styles": {
            ".guide-executive-section": {
              "padding": "100px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.6",
              "direction": "ltr",
              "text-align": "left"
            },
            ".guide-executive-section *": {
              "box-sizing": "border-box"
            },
            ".executive-container": {
              "max-width": "1000px",
              "margin": "0 auto",
              "padding": "0 24px"
            },
            ".guide-header": {
              "text-align": "center",
              "max-width": "820px",
              "margin": "0 auto 40px"
            },
            ".header-tag": {
              "font-size": "0.8rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-bottom": "12px",
              "margin-top": "50px",
              "display": "block",
              "text-transform": "uppercase"
            },
            ".header-title": {
              "font-size": "2.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.02em",
              "margin": "0 0 16px 0",
              "line-height": "1.25"
            },
            ".header-lead": {
              "font-size": "1.15rem",
              "color": "#475569",
              "margin": "0"
            },
            ".disclaimer-banner": {
              "background": "#fffbeb",
              "border": "1px solid #fde68a",
              "border-radius": "12px",
              "padding": "20px 24px",
              "display": "flex",
              "gap": "16px",
              "align-items": "flex-start",
              "margin-bottom": "50px"
            },
            ".disclaimer-icon": {
              "font-size": "1.4rem",
              "flex-shrink": "0"
            },
            ".disclaimer-text": {
              "font-size": "0.95rem",
              "color": "#92400e",
              "line-height": "1.55"
            },
            ".guide-block": {
              "margin-bottom": "55px"
            },
            ".block-title": {
              "font-size": "1.45rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "24px",
              "display": "flex",
              "align-items": "center",
              "gap": "10px",
              "border-bottom": "2px solid #e2e8f0",
              "padding-bottom": "12px"
            },
            ".title-icon": {
              "font-size": "1.3rem"
            },
            ".guide-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "32px",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.02)"
            },
            ".two-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "20px"
            },
            ".three-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(240px, 1fr))",
              "gap": "20px"
            },
            ".guide-subcard": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "14px",
              "padding": "24px",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.02)"
            },
            ".guide-subcard h3": {
              "font-size": "1.15rem",
              "font-weight": "800",
              "margin": "0 0 12px 0",
              "text-transform": "uppercase",
              "letter-spacing": "0.5px"
            },
            ".guide-subcard p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin-bottom": "0"
            },
            ".detail-box h4": {
              "font-size": "1rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".detail-box p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.5"
            },
            ".rule-box": {
              "padding": "24px",
              "border-radius": "14px",
              "border": "1px solid",
              "border-left-width": "5px"
            },
            ".numbered-list": {
              "padding-left": "0",
              "margin": "0",
              "list-style": "none"
            },
            ".numbered-list li": {
              "background": "#f8fafc",
              "border": "1px solid #f1f5f9",
              "padding": "16px 20px",
              "border-radius": "10px",
              "margin-bottom": "12px",
              "font-size": "0.95rem",
              "color": "#1e293b",
              "line-height": "1.6"
            },
            ".numbered-list li strong": {
              "color": "#0f172a"
            },
            ".numbered-list li:last-child": {
              "margin-bottom": "0"
            },
            ".guide-executive-section .btn.custom-btn": {
              "padding": "14px 28px !important",
              "border-radius": "100px !important",
              "font-weight": "600 !important",
              "font-size": "1rem !important",
              "margin": "0 !important",
              "transition": "all 0.3s ease !important",
              "border-width": "2px !important",
              "text-decoration": "none"
            },
            ".guide-executive-section .btn.outline-btn": {
              "background-color": "transparent !important",
              "border-color": "#2563eb !important",
              "color": "#2563eb !important"
            },
            ".guide-executive-section .btn.outline-btn:hover": {
              "background-color": "#eff6ff !important",
              "color": "#1d4ed8 !important",
              "border-color": "#1d4ed8 !important",
              "transform": "translateY(-2px) !important"
            },
            ".guide-executive-section .btn.whatsapp-btn": {
              "background-color": "#25d366 !important",
              "border-color": "#25d366 !important",
              "color": "#ffffff !important",
              "box-shadow": "0 4px 14px rgba(37, 211, 102, 0.2) !important"
            },
            ".guide-executive-section .btn.whatsapp-btn:hover": {
              "background-color": "#20bd5a !important",
              "border-color": "#20bd5a !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 6px 20px rgba(37, 211, 102, 0.3) !important"
            },
            "@media (max-width: 768px)": {
              ".header-title": {
                "font-size": "2rem"
              },
              ".guide-card, .guide-subcard, .rule-box": {
                "padding": "20px"
              },
              ".mbr-section-btn": {
                "flex-direction": "column",
                "width": "100%"
              },
              ".guide-executive-section .btn.custom-btn": {
                "width": "100%",
                "justify-content": "center",
                "text-align": "center"
              },
              ".disclaimer-banner": {
                "flex-direction": "column",
                "align-items": "center",
                "text-align": "center"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            },
            "@media (max-width: 575px)": {
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            "@media (max-width: 767px)": {
              ".services-grid, .team-grid, .transparency-grid, .pillars-grid, .three-column-grid, .grid-3, .grid-2, .faq-grid, .survival-grid, .portal-grid-2, .city-directory-grid, .details-cards-stack, .two-column-grid, .levels-grid, .cert-grid, .benefits-grid, .links-grid, .timeline-wrapper": {
                "display": "flex !important",
                "flex-wrap": "nowrap !important",
                "flex-direction": "row !important",
                "grid-template-columns": "none !important",
                "gap": "12px !important",
                "overflow-x": "auto",
                "overscroll-behavior-x": "contain",
                "scroll-snap-type": "x mandatory",
                "padding": "4px 2px 14px !important",
                "scrollbar-width": "none"
              },
              ".services-grid::-webkit-scrollbar, .team-grid::-webkit-scrollbar, .transparency-grid::-webkit-scrollbar, .pillars-grid::-webkit-scrollbar, .three-column-grid::-webkit-scrollbar, .grid-3::-webkit-scrollbar, .grid-2::-webkit-scrollbar, .faq-grid::-webkit-scrollbar, .survival-grid::-webkit-scrollbar, .portal-grid-2::-webkit-scrollbar, .city-directory-grid::-webkit-scrollbar, .details-cards-stack::-webkit-scrollbar, .two-column-grid::-webkit-scrollbar, .levels-grid::-webkit-scrollbar, .cert-grid::-webkit-scrollbar, .benefits-grid::-webkit-scrollbar, .links-grid::-webkit-scrollbar, .timeline-wrapper::-webkit-scrollbar": {
                "display": "none"
              },
              ".services-grid > *, .team-grid > *, .transparency-grid > *, .pillars-grid > *, .three-column-grid > *, .grid-3 > *, .grid-2 > *, .faq-grid > *, .survival-grid > *, .portal-grid-2 > *, .city-directory-grid > *, .details-cards-stack > *, .two-column-grid > *, .levels-grid > *, .cert-grid > *, .benefits-grid > *, .links-grid > *, .timeline-wrapper > *": {
                "flex": "0 0 84% !important",
                "max-width": "84% !important",
                "min-width": "0",
                "margin": "0 !important",
                "scroll-snap-align": "start"
              },
              ".timeline-wrapper::before": {
                "display": "none !important"
              },
              ".metrics-section, .services-section, .process-section, .region-section, .team-section, .transparency-section, .cta-section": {
                "padding-top": "44px !important",
                "padding-bottom": "44px !important"
              },
              ".metrics-grid": {
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr) !important",
                "gap": "10px !important"
              },
              ".word-grid": {
                "max-height": "62vh",
                "overflow-y": "auto",
                "overscroll-behavior": "contain",
                "padding-right": "4px"
              },
              ".metrics-grid > *": {
                "min-width": "0",
                "padding": "18px 10px !important"
              },
              ".metrics-grid .metric-value": {
                "font-size": "2rem !important"
              },
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            },
            "@media (max-width: 991px)": {
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_name": "list01",
          "_sourceTheme": "guidem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"guide-executive-section\" id=\"contact-guide-section\">\n    <div class=\"executive-container\">\n        \n        <!-- Header -->\n        <header class=\"guide-header\">\n            <span class=\"header-tag\">ЗВ'ЯЗАТИСЯ З НАМИ</span>\n            <h1 class=\"header-title\">Контакти</h1>\n            <p class=\"header-lead\">\n                Прямий зв'язок, без форм та черг.\n            </p>\n        </header>\n\n        <!-- General Disclaimer / Intro -->\n        <div class=\"disclaimer-banner\" style=\"background: #eff6ff; border-color: #bfdbfe;\">\n            <div class=\"disclaimer-icon\" style=\"display: flex; align-items: center; justify-content: center;\">\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#1e3a8a\"><path d=\"M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z\"></path></svg>\n            </div>\n            <div class=\"disclaimer-text\" style=\"color: #1e3a8a;\">\n                <strong>Пряме спілкування:</strong> Ми не використовуємо онлайн-форми та не збираємо інформацію через сайт. Спосіб зв’язатися з нами простий і прямий: повідомлення у WhatsApp або електронний лист. Пишіть зручною для вас мовою — українською, німецькою, англійською чи російською.\n            </div>\n        </div>\n\n        <!-- Section 1: Contact Details (Grid) -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\" style=\"display: flex; align-items: center; gap: 10px;\">\n                <span class=\"title-icon\" style=\"display: inline-flex; align-items: center;\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z\"></path></svg>\n                </span> \n                Наша контактна інформація\n            </h2>\n            \n            <div class=\"two-column-grid\">\n                <!-- WhatsApp -->\n                <div class=\"guide-subcard\" style=\"border-top: 4px solid #25d366;\">\n                    <h3><span style=\"color: #0f7a3e; display: inline-flex; align-items: center; gap: 8px;\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12.031 2c-5.514 0-9.996 4.482-9.996 9.996 0 1.763.459 3.486 1.332 5.013l-1.417 5.176 5.297-1.389c1.474.804 3.141 1.226 4.784 1.226 5.514 0 9.996-4.482 9.996-9.996 0-5.514-4.482-9.996-9.996-9.996zm0 18.286c-1.479 0-2.929-.396-4.195-1.147l-.301-.179-3.12.818.832-3.041-.197-.313c-.822-1.309-1.256-2.825-1.256-4.372 0-4.413 3.587-8 8-8s8 3.587 8 8-3.587 8.034-8 8.034z\"></path></svg>\n                        WhatsApp\n                    </span></h3>\n                    <p style=\"font-size: 1.1rem; font-weight: 700; color: #0f172a; margin-bottom: 8px;\"><a href=\"https://wa.me/380637004615\" class=\"text-primary\">+380 63 700 4615</a></p>\n                    <p>Найшвидший та найбільш рекомендований спосіб зв'язку. Ви можете надіслати текстове повідомлення, голосове повідомлення або фотографію отриманого листа.</p>\n                </div>\n\n                <!-- Email -->\n                <div class=\"guide-subcard\" style=\"border-top: 4px solid #3b82f6;\">\n                    <h3><span style=\"color: #1d4ed8; display: inline-flex; align-items: center; gap: 8px;\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z\"></path></svg>\n                        Електронна пошта\n                    </span></h3>\n                    <p style=\"font-size: 1.1rem; font-weight: 700; color: #0f172a; margin-bottom: 8px;\"><a href=\"mailto:zusammenleben.de@gmail.com\" class=\"text-primary\">zusammenleben.de@gmail.com</a></p>\n                    <p>Підходить для більш детальних запитів, листування з офіційними органами та організаціями, а також усього, що потребує документального супроводу.</p>\n                </div>\n            </div>\n\n            <!-- Quick Info Bar -->\n            <div class=\"guide-card\" style=\"margin-top: 24px; padding: 24px;\">\n                <div class=\"three-column-grid\">\n                    <div class=\"detail-box\" style=\"background: #ffffff; border: none; padding: 0;\">\n                        <h4 style=\"display: flex; align-items: center; gap: 8px;\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#2563eb\"><path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\"></path></svg>\n                            Адреса для пожертв\n                        </h4>\n                        <p><strong>Konradsreuth, Alte Hofer Str. 1</strong><br>Для передачі: продукти харчування, одяг та меблі.</p>\n                    </div>\n                    <div class=\"detail-box\" style=\"background: #ffffff; border: none; padding: 0;\">\n                        <h4 style=\"display: flex; align-items: center; gap: 8px;\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#2563eb\"><path d=\"M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z\"></path></svg>\n                            Години відповідей\n                        </h4>\n                        <p><strong>Щодня, 09:00 – 21:00</strong><br>Ми намагаємося бути на зв'язку. Повідомлення, надіслані в інший час, будуть прочитані та опрацьовані пізніше.</p>\n                    </div>\n                    <div class=\"detail-box\" style=\"background: #ffffff; border: none; padding: 0;\">\n                        <h4 style=\"display: flex; align-items: center; gap: 8px;\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#2563eb\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z\"></path></svg>\n                            Інформація про послуги\n                        </h4>\n                        <p><strong>Регіон:</strong> Північна Баварія та Верхня Франконія.<br><strong>Мови:</strong> українська, німецька, англійська, російська.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 2: By Type of Inquiry -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\" style=\"display: flex; align-items: center; gap: 10px;\">\n                <span class=\"title-icon\" style=\"display: inline-flex; align-items: center;\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 16H5V5h2v2h10V5h2v14z\"></path></svg>\n                </span> \n                За типом звернення\n            </h2>\n            <p style=\"margin-bottom: 20px; color: #475569;\">Щоб ваше повідомлення якнайшвидше потрапило до потрібної людини, будь ласка, вкажіть тип звернення у першому рядку:</p>\n            \n            <div class=\"guide-card\">\n                <ul class=\"numbered-list\" style=\"list-style: none; padding-left: 0;\">\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\"></path></svg>\n                        <span><strong>Запит на допомогу сім'ї:</strong> Будь ласка, вкажіть місто, в якому ви перебуваєте, кількість осіб, вік дітей і яка саме допомога потрібна зараз насамперед.</span>\n                    </li>\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"></path></svg>\n                        <span><strong>Особисте звернення до Анни:</strong> Пишіть безпосередньо у WhatsApp. Якщо ви вже спілкуєтеся з нею, продовжуйте в тому ж чаті.</span>\n                    </li>\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\"></path></svg>\n                        <span><strong>Пропозиція житла:</strong> Вкажіть місто, площу квартири (кв. м), кількість кімнат, поверх, наявність ліфта, базову орендну плату (Kaltmiete) та комунальні послуги (Nebenkosten), можливу дату заселення і чи мебльована квартира. Ми зв'яжемося з вами та детально пояснимо весь процес.</span>\n                    </li>\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"></path></svg>\n                        <span><strong>Волонтерство:</strong> Напишіть, як саме ви можете допомогти, у якому регіоні та який ваш графік/доступність.</span>\n                    </li>\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z\"></path></svg>\n                        <span><strong>Пожертва речей/меблів:</strong> Вкажіть, що саме у вас є, у якому стані, в якому місті знаходиться і чи можете ви допомогти з транспортуванням.</span>\n                    </li>\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z\"></path></svg>\n                        <span><strong>Співпраця:</strong> Бізнеси, фахівці та постачальники послуг у регіоні можуть звертатися до нас електронною поштою.</span>\n                    </li>\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M4 10v7h3v-7H4zm6 0v7h3v-7h-3zM2 22h19v-3H2v3zm14-12v7h3v-7h-3zm-4.5-9L2 6v2h19V6l-9.5-5z\"></path></svg>\n                        <span><strong>Офіційні органи та організації:</strong> З метою обліку та документального супроводу перевага надається електронній пошті.</span>\n                    </li>\n                    <li style=\"margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z\"></path></svg>\n                        <span><strong>Запити від ЗМІ:</strong> Тільки електронною поштою. Ми відкриті до спілкування за умови абсолютного захисту приватності сімей.</span>\n                    </li>\n                    <li style=\"margin-bottom: 0; display: flex; align-items: flex-start; gap: 8px;\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#2563eb\" style=\"flex-shrink: 0; margin-top: 3px;\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 16h-2v-2h2v2zm1.07-7.75l-.9.92C12.45 11.9 12 12.5 12 14h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z\"></path></svg>\n                        <span><strong>Загальні запитання:</strong> Будь-які питання, великі чи малі. Якщо відповідь належить до компетенції іншої організації, ми підкажемо, куди звернутися.</span>\n                    </li>\n                </ul>\n            </div>\n        </div>\n\n        <!-- Section 3: Attachments & Expectations -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\" style=\"display: flex; align-items: center; gap: 10px;\">\n                <span class=\"title-icon\" style=\"display: inline-flex; align-items: center;\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4s-4 1.79-4 4v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z\"></path></svg>\n                </span> \n                Що варто додавати, а що ні\n            </h2>\n            \n            <div class=\"two-column-grid\">\n                <div class=\"rule-box\" style=\"margin-top: 0; background: #f0fdf4; border-color: #bbf7d0; border-left-color: #22c55e;\">\n                    <h3 style=\"color: #166534; margin-top: 0; font-size: 1.1rem; display: flex; align-items: center; gap: 8px;\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#22c55e\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"></path></svg>\n                        Корисно додати\n                    </h3>\n                    <p style=\"margin-bottom: 0; color: #15803d;\">Чітке фото офіційного листа, зміст якого вам незрозумілий, або копію документа, який ви допомагаєте розшифрувати.</p>\n                </div>\n                \n                <div class=\"rule-box mail-rule\" style=\"margin-top: 0; background: #fef2f2; border-color: #fecaca; border-left-color: #ef4444;\">\n                    <h3 style=\"color: #991b1b; margin-top: 0; font-size: 1.1rem; display: flex; align-items: center; gap: 8px;\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#ef4444\"><path d=\"M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z\"></path></svg>\n                        Не потрібно надсилати\n                    </h3>\n                    <p style=\"margin-bottom: 0; color: #b91c1c;\">Посвідчення особи, медичні картки або фінансову інформацію на початковому етапі. Якщо щось із цього знадобиться пізніше, ми чітко попросимо про це та пояснимо навіщо. <strong>Бережіть свою приватність навіть у спілкуванні з нами.</strong></p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 4: Honesty about response times & Emergency -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\" style=\"display: flex; align-items: center; gap: 10px;\">\n                <span class=\"title-icon\" style=\"display: inline-flex; align-items: center;\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M6 2v6l4 4-4 4v6h12v-6l-4-4 4-4V2H6zm10 14.5V18H8v-1.5l4-4 4 4zm-4-5l-4-4V6h8v3.5l-4 4z\"></path></svg>\n                </span> \n                Терміни відповідей — чесно\n            </h2>\n            \n            <div class=\"guide-card\" style=\"margin-bottom: 24px;\">\n                <p>Ми команда волонтерів, а не кол-центр підтримки клієнтів. Ми робимо все можливе, щоб відповісти в той самий день, але у завантажені дні відповідь може надійти наступного дня. Якщо ви не отримали відповіді протягом двох днів, будь ласка, м'яко нагадайте про себе — іноді повідомлення може просто загубитися.</p>\n            </div>\n\n            <div class=\"guide-card\" style=\"background: #fff1f2; border-color: #fecaca; padding: 24px;\">\n                <h3 style=\"color: #be123c; margin-top: 0; margin-bottom: 10px; font-size: 1.25rem; display: flex; align-items: center; gap: 8px;\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#e11d48\"><path d=\"M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z\"></path></svg>\n                    Важливо: це не екстрена служба\n                </h3>\n                <p style=\"margin-bottom: 0; color: #9f1239;\">У ситуаціях безпосередньої загрози — медичної, безпекової тощо — будь ласка, негайно звертайтеся до офіційних екстрених служб Німеччини: <strong>телефонуйте 112</strong> (швидка допомога та пожежна служба) або <strong>телефонуйте 110</strong> (поліція).</p>\n            </div>\n        </div>\n\n        <!-- CTA Buttons -->\n        <div class=\"guide-block\">\n            <div class=\"mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\" style=\"display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; margin-top: 40px;\"><a class=\"btn custom-btn whatsapp-btn display-4 btn-warning\" href=\"https://wa.me/380637004615\" data-app-placeholder=\"Type Text\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                        WhatsApp Анни\n                    </a>\n                <a class=\"btn btn-primary custom-btn outline-btn display-4\" href=\"Contact.html#footer4-19\" data-app-placeholder=\"Type Text\" style=\"display: inline-flex; align-items: center; gap: 8px;\">\n                    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z\"></path></svg>\n                    Надіслати Email\n                </a></div>\n        </div>\n\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
