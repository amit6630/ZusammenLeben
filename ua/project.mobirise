          "_styles": {
            "& when (@sticky)": {
              "position": "sticky !important",
              "top": "0 !important",
              "z-index": "1030 !important",
              "width": "100%",
              "nav.navbar, .navbar-dropdown, .navbar-fixed-top": {
                "position": "relative !important"
              }
            },
            "& when not (@sticky)": {
              "position": "relative",
              "z-index": "1030",
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "body": {
              "position": "relative"
            },
            ".navbar": {
              "min-height": "80px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".navbar-logo img": {
                "width": "auto"
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-logo img": {
                  "height": "2.5rem !important"
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".container, .container-fluid": {
              "display": "flex",
              "flex-wrap": "wrap",
              "margin": "auto",
              "align-items": "center"
            },
            ".brand-container": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding-bottom": "4px",
              "padding-top": "4px",
              "width": "100%"
            },
            ".navbar-brand": {
              "min-height": "60px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "5px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              "display": "flex",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            "@media (min-width: 992px)": {
