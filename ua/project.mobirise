    "guides.html": {
      "settings": {
        "title": "Посібники для українських родин у Німеччині | ZusammenLeben",
        "order": "16",
        "meta_descr": "Практичні посібники для українських родин у Верхній Франконії: житло, листи Jobcenter, школа, здоров'я, робота, дозвіл на проживання та побут.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guides.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guides.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guides.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guides.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guides.html\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Посібники для українських родин у Німеччині | ZusammenLeben\" />\n<meta property=\"og:description\" content=\"Практичні посібники для українських родин у Верхній Франконії: житло, листи Jobcenter, школа, здоров'я, робота, дозвіл на проживання та побут.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guides.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"CollectionPage\",\"url\":\"https://zusammenleben-ukraine.de/ua/guides.html\",\"name\":\"Посібники для українських родин у Німеччині\",\"description\":\"Практичні посібники для українських родин у Верхній Франконії: житло, листи Jobcenter, школа, здоров'я, робота, дозвіл на проживання та побут.\",\"inLanguage\":\"uk\",\"isPartOf\":{\"@id\":\"https://zusammenleben-ukraine.de/#site\"}},{\"@type\":\"ItemList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-finding-apartment.html\",\"name\":\"Пошук житла у Верхній Франконії з підтримкою Jobcenter\"},{\"@type\":\"ListItem\",\"position\":2,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-jobcenter-letters.html\",\"name\":\"Як читати листи від Jobcenter і відповідати на них\"},{\"@type\":\"ListItem\",\"position\":3,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-school-kita-bavaria.html\",\"name\":\"Запис дитини до школи чи дитсадка в Баварії\"},{\"@type\":\"ListItem\",\"position\":4,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-health-insurance-doctor.html\",\"name\":\"Медичне страхування та візит до лікаря в Німеччині\"},{\"@type\":\"ListItem\",\"position\":5,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-recognition-qualifications.html\",\"name\":\"Визнання українських кваліфікацій у Німеччині\"},{\"@type\":\"ListItem\",\"position\":6,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-integration-course.html\",\"name\":\"Інтеграційний курс: найшвидший шлях до німецької мови\"},{\"@type\":\"ListItem\",\"position\":7,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-residence-permit-24.html\",\"name\":\"Ваш дозвіл на проживання за §24: головне\"},{\"@type\":\"ListItem\",\"position\":8,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-first-job.html\",\"name\":\"Як знайти першу роботу в Німеччині\"},{\"@type\":\"ListItem\",\"position\":9,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-bank-account-phone.html\",\"name\":\"Банківський рахунок, мобільний зв'язок і радіомовний збір\"},{\"@type\":\"ListItem\",\"position\":10,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-driving-licence.html\",\"name\":\"Керування авто в Німеччині з українськими правами\"},{\"@type\":\"ListItem\",\"position\":11,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-anmeldung.html\",\"name\":\"Anmeldung: реєстрація адреси в Німеччині\"},{\"@type\":\"ListItem\",\"position\":12,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-child-benefit.html\",\"name\":\"Допомога на дітей і сімейні виплати в Німеччині\"},{\"@type\":\"ListItem\",\"position\":13,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-pregnancy-birth.html\",\"name\":\"Вагітність і пологи в Німеччині\"},{\"@type\":\"ListItem\",\"position\":14,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-mental-health.html\",\"name\":\"Психічне здоров'я: де знайти психологічну підтримку\"},{\"@type\":\"ListItem\",\"position\":15,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-university-study.html\",\"name\":\"Навчання в університеті Німеччини\"},{\"@type\":\"ListItem\",\"position\":16,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-vocational-training.html\",\"name\":\"Професійне навчання (Ausbildung) простими словами\"},{\"@type\":\"ListItem\",\"position\":17,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-self-employment.html\",\"name\":\"Як стати самозайнятим у Німеччині\"},{\"@type\":\"ListItem\",\"position\":18,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-tax-return.html\",\"name\":\"Податки в Німеччині: основи для найманих працівників\"},{\"@type\":\"ListItem\",\"position\":19,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-social-insurance.html\",\"name\":\"Соціальне страхування в Німеччині\"},{\"@type\":\"ListItem\",\"position\":20,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-house-rules-waste.html\",\"name\":\"Правила будинку, сортування сміття та добросусідство\"},{\"@type\":\"ListItem\",\"position\":21,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-public-transport.html\",\"name\":\"Як пересуватися: громадський транспорт у Верхній Франконії\"},{\"@type\":\"ListItem\",\"position\":22,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-saving-money.html\",\"name\":\"Як заощаджувати в повсякденні\"},{\"@type\":\"ListItem\",\"position\":23,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-clubs-volunteering.html\",\"name\":\"Клуби та волонтерство: знайдіть своє місце\"},{\"@type\":\"ListItem\",\"position\":24,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-elderly-care.html\",\"name\":\"Літні люди та тривалий догляд у Німеччині\"},{\"@type\":\"ListItem\",\"position\":25,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-disability.html\",\"name\":\"Життя з інвалідністю в Німеччині\"},{\"@type\":\"ListItem\",\"position\":26,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-legal-help.html\",\"name\":\"Юридична допомога в Німеччині\"},{\"@type\":\"ListItem\",\"position\":27,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-violence-protection.html\",\"name\":\"Захист від насильства: де отримати допомогу\"},{\"@type\":\"ListItem\",\"position\":28,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-ukrainian-documents.html\",\"name\":\"Як зберегти чинність українських документів у Німеччині\"},{\"@type\":\"ListItem\",\"position\":29,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-winter-heating.html\",\"name\":\"Як пережити німецьку зиму\"},{\"@type\":\"ListItem\",\"position\":30,\"url\":\"https://zusammenleben-ukraine.de/ua/guide-long-term-stay.html\",\"name\":\"Як планувати довгострокове майбутнє в Німеччині\"}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"}]}]}</script>"
