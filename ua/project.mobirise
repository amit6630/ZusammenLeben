    "guide-health-insurance-doctor.html": {
      "settings": {
        "title": "Медичне страхування і лікарі в Німеччині: посібник",
        "order": "20",
        "meta_descr": "Як працює медичне страхування для людей з України в Німеччині, як обрати сімейного лікаря і які номери телефонувати вночі та в екстрених випадках.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-health-insurance-doctor.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-health-insurance-doctor.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-health-insurance-doctor.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-health-insurance-doctor.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-health-insurance-doctor.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Медичне страхування і лікарі в Німеччині: посібник\" />\n<meta property=\"og:description\" content=\"Як працює медичне страхування для людей з України в Німеччині, як обрати сімейного лікаря і які номери телефонувати вночі та в екстрених випадках.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-health-insurance-doctor.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Медичне страхування та візит до лікаря в Німеччині\",\"description\":\"Як працює медичне страхування для людей з України в Німеччині, як обрати сімейного лікаря і які номери телефонувати вночі та в екстрених випадках.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-health-insurance-doctor.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-health-insurance-doctor.html\",\"wordCount\":908,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Хто платить за мою медичну страховку?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Якщо ви отримуєте виплати від Jobcenter, внески сплачує Jobcenter. Якщо ви працюєте, вас страхує роботодавець.\"}},{\"@type\":\"Question\",\"name\":\"Куди телефонувати, коли практика зачинена?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Телефонуйте 116 117 до чергової медичної служби. У разі загрози життю — 112.\"}},{\"@type\":\"Question\",\"name\":\"Чи потрібен мені сімейний лікар?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Дуже рекомендуємо. Сімейний лікар координує лікування та направляє до спеціалістів.\"}},{\"@type\":\"Question\",\"name\":\"Чи застраховані мої діти?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так. Діти застраховані через Jobcenter або через сімейне страхування без доплати.\"}},{\"@type\":\"Question\",\"name\":\"Чи оплачується психотерапія?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Так. Після первинної консультації психотерапію оплачує державне медичне страхування.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Медичне страхування та візит до лікаря в Німеччині\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-health-insurance-doctor.html\"}]}]}</script>"
      },
