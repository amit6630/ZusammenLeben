              "line-height": "1.25"
            },
            ".header-lead": {
              "font-size": "1.15rem",
              "color": "#475569",
              "margin": "0"
            },
            ".guide-block": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "36px",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.02)"
            },
            ".block-title": {
              "font-size": "1.6rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "16px",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "border-bottom": "2px solid #f1f5f9",
              "padding-bottom": "16px"
            },
            ".icon-wrapper": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "width": "40px",
              "height": "40px",
              "background": "#eff6ff",
              "color": "#2563eb",
              "border-radius": "10px",
              "flex-shrink": "0"
            },
            ".intro-text": {
              "font-size": "1.05rem",
              "color": "#475569",
              "margin-bottom": "20px"
            },
            ".benefits-grid, .cert-grid, .faq-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(300px, 1fr))",
              "gap": "20px"
            },
            ".benefit-card, .faq-card": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "padding": "20px",
              "border-radius": "12px"
            },
            ".benefit-card h4, .faq-card h4": {
              "font-size": "1.1rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin-bottom": "10px"
            },
            ".benefit-card p, .faq-card p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin": "0"
            },
            ".levels-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(250px, 1fr))",
