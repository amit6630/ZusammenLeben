              "box-shadow": "0 2px 5px rgba(0, 0, 0, 0.02)"
            },
            ".action-buttons-group": {
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "center",
              "gap": "15px",
              "margin-top": "20px"
            },
            ".portal-btn": {
