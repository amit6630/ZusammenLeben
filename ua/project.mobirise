            ".guide-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "32px",
              "margin-bottom": "20px",
              "box-shadow": "0 4px 20px rgba(0, 0, 0, 0.03)"
