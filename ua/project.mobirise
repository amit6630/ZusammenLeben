                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".navbar-logo img": {
                "width": "auto"
              },
              "&.navbar-short": {
                "min-height": "60px",
                ".navbar-logo img": {
                  "height": "2.5rem !important"
                },
                ".navbar-brand": {
                  "min-height": "60px",
                  "padding": "0"
                }
              }
            },
            ".container, .container-fluid": {
              "display": "flex",
              "flex-wrap": "wrap",
              "margin": "auto",
              "align-items": "center"
            },
            ".brand-container": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding-bottom": "4px",
              "padding-top": "4px",
              "width": "100%"
            },
            ".navbar-brand": {
              "min-height": "60px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "5px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              "display": "flex",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            "@media (min-width: 992px)": {
              ".brand-container": {
                "width": "auto",
                "flex-grow": "1",
                "justify-content": "flex-start"
              },
              ".navbar-brand": {
                "padding-right": "20px"
              },
              ".navbar-collapse": {
