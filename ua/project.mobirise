              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#eff6ff",
              "padding": "10px",
              "border-radius": "10px",
              "border": "1px solid #dbeafe"
            },
            ".card-title-with-icon": {
              "display": "flex",
              "align-items": "center",
              "gap": "8px",
