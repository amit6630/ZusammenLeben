              "border": "1px solid #e2e8f0",
              "padding": "30px",
              "border-radius": "16px",
              "text-align": "center"
            },
            ".support-box h4": {
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "10px"
            },
