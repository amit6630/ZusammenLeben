              "color": "#475569",
              "margin-bottom": "24px",
              "font-size": "1rem"
            },
            ".block-title": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "20px",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "border-bottom": "2px solid #e2e8f0",
              "padding-bottom": "12px"
            },
            ".title-icon": {
              "color": "#2563eb",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#eff6ff",
              "width": "36px",
              "height": "36px",
              "border-radius": "8px",
              "border": "1px solid #dbeafe",
