        {
          "_name": "slider01",
          "_sourceTheme": "smartm5",
          "_styles": {
            ".guide-executive-section": {
              "padding": "80px 0 !important",
              "background-color": "#f8fafc !important",
              "font-family": "'Inter', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
              "color": "#0f172a",
              "line-height": "1.65",
              "direction": "ltr",
              "text-align": "left",
              "-webkit-font-smoothing": "antialiased"
            },
            ".guide-executive-section *": {
              "box-sizing": "border-box"
            },
            ".executive-container": {
              "max-width": "1000px",
              "margin": "0 auto",
              "padding": "0 24px"
            },
            ".guide-header": {
              "text-align": "center",
              "max-width": "820px",
              "margin": "0 auto 40px"
            },
            ".header-tag": {
              "font-size": "0.75rem",
              "font-weight": "800",
              "color": "#2563eb",
              "letter-spacing": "2px",
              "margin-top": "50px",
              "margin-bottom": "12px",
              "display": "inline-block",
              "text-transform": "uppercase",
              "background": "#eff6ff",
              "padding": "6px 16px",
              "border-radius": "100px",
              "border": "1px solid #bfdbfe"
            },
            ".header-title": {
              "font-size": "2.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "letter-spacing": "-0.02em",
              "margin": "12px 0 16px 0",
              "line-height": "1.25"
            },
            ".header-lead": {
              "font-size": "1.15rem",
              "color": "#475569",
              "margin": "0"
            },
            ".disclaimer-banner": {
              "background": "#fffbeb",
              "border": "1px solid #fde68a",
              "border-radius": "14px",
              "padding": "20px 24px",
              "display": "flex",
              "gap": "16px",
              "align-items": "flex-start",
              "margin-bottom": "45px",
              "box-shadow": "0 4px 12px rgba(217, 119, 6, 0.05)"
            },
            ".disclaimer-icon": {
              "color": "#d97706",
              "flex-shrink": "0",
              "background": "#fef3c7",
              "width": "38px",
              "height": "38px",
              "border-radius": "10px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "border": "1px solid #fde68a"
            },
            ".disclaimer-text": {
              "font-size": "0.95rem",
              "color": "#92400e",
              "line-height": "1.6"
            },
            ".guide-block": {
              "margin-bottom": "45px"
            },
            ".block-title": {
              "font-size": "1.4rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin-bottom": "24px",
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "border-bottom": "2px solid #e2e8f0",
              "padding-bottom": "12px"
            },
            ".title-icon": {
              "color": "#2563eb",
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "background": "#eff6ff",
              "width": "36px",
              "height": "36px",
              "border-radius": "8px",
              "border": "1px solid #dbeafe"
            },
            ".guide-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "18px",
              "padding": "32px",
              "margin-bottom": "24px",
              "box-shadow": "0 4px 20px rgba(0, 0, 0, 0.02)",
              "transition": "border-color 0.25s ease"
            },
            ".guide-card:hover": {
              "border-color": "#cbd5e1"
            },
            ".card-header": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "margin-bottom": "16px",
              "flex-wrap": "wrap",
              "gap": "10px"
            },
            ".card-header h3": {
              "font-size": "1.3rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "0"
            },
            ".status-tag": {
              "font-size": "0.75rem",
              "font-weight": "700",
              "padding": "5px 14px",
              "border-radius": "100px",
              "text-transform": "uppercase",
              "letter-spacing": "0.5px"
            },
            ".status-tag.critical": {
              "background": "#fef3c7",
              "color": "#92400e",
              "border": "1px solid #fde68a"
            },
            ".status-tag.info": {
              "background": "#eff6ff",
              "color": "#1e40af",
              "border": "1px solid #bfdbfe"
            },
            ".card-details-grid": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "gap": "20px",
              "margin-top": "20px"
            },
            ".detail-box": {
              "background": "#f8fafc",
              "border": "1px solid #e2e8f0",
              "padding": "20px",
              "border-radius": "12px"
            },
            ".detail-box-spacing": {
              "margin-top": "20px"
            },
            ".detail-box h4": {
              "font-size": "0.95rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".detail-box p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0"
            },
            ".rule-box": {
              "border-radius": "12px",
              "padding": "20px",
              "margin-top": "20px",
              "font-size": "0.92rem",
              "line-height": "1.55"
            },
            ".rule-header": {
              "display": "flex",
              "align-items": "center",
              "gap": "8px",
              "margin-bottom": "6px"
            },
            ".rule-header h3": {
              "margin": "0",
              "font-size": "1.05rem",
              "font-weight": "700"
            },
            ".danger-rule": {
              "background": "#fef2f2",
              "border": "1px solid #fecaca",
              "color": "#991b1b"
            },
            ".danger-rule .rule-header, .danger-rule .rule-icon": {
              "color": "#dc2626"
            },
            ".danger-rule p": {
              "color": "#991b1b",
              "margin": "0"
            },
            ".info-rule": {
              "background": "#f0fdf4",
              "border": "1px solid #bbf7d0",
              "color": "#166534"
            },
            ".info-rule .rule-header, .info-rule .rule-icon": {
              "color": "#16a34a"
            },
            ".info-rule p": {
              "color": "#166534",
              "margin": "0"
            },
            ".notice-highlight": {
              "background": "#f0f9ff",
              "border-left": "4px solid #0284c7",
              "padding": "14px 18px",
              "border-radius": "8px",
              "font-size": "0.92rem",
              "color": "#0369a1",
              "margin-top": "16px"
            },
            ".two-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(320px, 1fr))",
              "gap": "20px"
            },
            ".guide-subcard": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "26px",
              "display": "flex",
              "flex-direction": "column"
            },
            ".guide-subcard h3": {
              "font-size": "1.15rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 12px 0"
            },
            ".guide-subcard p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin-bottom": "12px"
            },
            ".subcard-rule": {
              "background": "#fff8f1",
              "border": "1px solid #ffedd5",
              "color": "#9a3412",
              "padding": "14px 18px",
              "margin-top": "auto"
            },
            ".three-column-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(auto-fit, minmax(260px, 1fr))",
              "gap": "20px"
            },
            ".guide-mini-card": {
              "background": "#ffffff",
              "border": "1px solid #e2e8f0",
              "border-radius": "16px",
              "padding": "24px",
              "transition": "transform 0.25s ease"
            },
            ".guide-mini-card:hover": {
              "transform": "translateY(-3px)"
            },
            ".mini-icon": {
              "width": "42px",
              "height": "42px",
              "border-radius": "10px",
              "background": "#eff6ff",
              "color": "#2563eb",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "margin-bottom": "14px",
              "border": "1px solid #dbeafe"
            },
            ".guide-mini-card h3": {
              "font-size": "1.05rem",
              "font-weight": "700",
              "color": "#0f172a",
              "margin": "0 0 8px 0"
            },
            ".guide-mini-card p": {
              "font-size": "0.9rem",
              "color": "#475569",
              "margin": "0",
              "line-height": "1.55"
            },
            ".mini-card-note": {
              "margin-top": "12px !important",
              "font-size": "0.85rem !important",
              "color": "#64748b !important"
            },
            ".extreme-block": {
              "margin-top": "-10px"
            },
            ".extreme-card": {
              "background": "#fffbeb",
              "border": "1px solid #fde68a"
            },
            ".extreme-header": {
              "display": "flex",
              "align-items": "center",
              "gap": "10px",
              "color": "#b45309",
              "margin-bottom": "10px"
            },
            ".extreme-header h3": {
              "font-size": "1.2rem",
              "font-weight": "800",
              "color": "#92400e",
              "margin": "0"
            },
            ".extreme-card p": {
              "margin": "0",
              "color": "#92400e",
              "font-size": "0.95rem"
            },
            ".summary-cta-card": {
              "text-align": "center",
              "padding": "40px 32px",
              "background": "#ffffff",
              "border-radius": "20px"
            },
            ".summary-title": {
              "font-size": "1.5rem",
              "font-weight": "800",
              "color": "#0f172a",
              "margin": "0 0 16px 0"
            },
            ".summary-text": {
              "max-width": "750px",
              "margin": "0 auto 20px",
              "color": "#475569",
              "font-size": "0.98rem",
              "line-height": "1.6"
            },
            ".summary-tagline": {
              "font-weight": "700",
              "color": "#0f172a",
              "margin-bottom": "28px",
              "font-size": "1.05rem"
            },
            ".cta-buttons-wrapper": {
              "display": "flex",
              "justify-content": "center",
              "gap": "14px",
              "flex-wrap": "wrap"
            },
            ".guide-executive-section .btn.custom-btn": {
              "padding": "14px 28px !important",
              "border-radius": "100px !important",
              "font-weight": "700 !important",
              "font-size": "0.95rem !important",
              "display": "inline-flex !important",
              "align-items": "center !important",
              "justify-content": "center !important",
              "gap": "10px !important",
              "transition": "all 0.25s ease !important",
              "text-decoration": "none !important",
              "border-width": "1px !important",
              "margin": "0 !important"
            },
            ".guide-executive-section .btn.whatsapp-btn": {
              "background-color": "#25d366 !important",
              "border-color": "#25d366 !important",
              "color": "#ffffff !important",
              "box-shadow": "0 4px 12px rgba(37, 211, 102, 0.2) !important"
            },
            ".guide-executive-section .btn.whatsapp-btn:hover": {
              "background-color": "#20bd5a !important",
              "border-color": "#20bd5a !important",
              "transform": "translateY(-2px) !important",
              "box-shadow": "0 6px 18px rgba(37, 211, 102, 0.3) !important"
            },
            ".guide-executive-section .btn.outline-btn": {
              "background-color": "transparent !important",
              "border-color": "#2563eb !important",
              "color": "#2563eb !important"
            },
            ".guide-executive-section .btn.outline-btn:hover": {
              "background-color": "#eff6ff !important",
              "color": "#1d4ed8 !important",
              "border-color": "#1d4ed8 !important",
              "transform": "translateY(-2px) !important"
            },
            "@media (max-width: 768px)": {
              ".guide-executive-section": {
                "padding": "50px 0 !important"
              },
              ".executive-container": {
                "padding": "0 16px"
              },
              ".card-details-grid": {
                "grid-template-columns": "1fr"
              },
              ".header-title": {
                "font-size": "1.9rem"
              },
              ".guide-card": {
                "padding": "22px 18px"
              },
              ".summary-cta-card": {
                "padding": "28px 18px"
              },
              ".cta-buttons-wrapper": {
                "flex-direction": "column",
                "width": "100%"
              },
              ".guide-executive-section .btn.custom-btn": {
                "width": "100% !important"
              },
              ".disclaimer-banner": {
                "flex-direction": "column",
                "align-items": "center",
                "text-align": "center"
              }
            },
            ".matrix-status.matrix-status.matrix-status, .highlight-green-title.highlight-green-title.highlight-green-title, .info-rule .rule-header h3.rule-x, .info-rule.info-rule .rule-header h3, .reality-badge.reality-badge.reality-badge": {
              "color": "#15803d !important"
            },
            ".matrix-status.warning.warning, .warning-badge.warning-badge.warning-badge": {
              "color": "#b45309 !important"
            },
            ".danger-rule.danger-rule .rule-header h3, .emergency-title.emergency-title.emergency-title, .pill-danger.pill-danger.pill-danger": {
              "color": "#b91c1c !important"
            },
            ".alert-heading.alert-heading.alert-heading": {
              "color": "#be123c !important"
            },
            ".btn-whatsapp.btn-whatsapp.btn-whatsapp": {
              "background-color": "#15803d !important",
              "border-color": "#15803d !important"
            },
            ".whatsapp-btn.whatsapp-btn.whatsapp-btn, .custom-btn.whatsapp-btn.whatsapp-btn": {
              "background-color": "#0f7a3e !important",
              "border-color": "#0f7a3e !important",
              "color": "#fff !important"
            },
            ".portal-footer-reminder.portal-footer-reminder h3, .footer-numbers-grid.footer-numbers-grid strong, .footer-numbers-grid.footer-numbers-grid a": {
              "color": "#fff !important"
            },
            "@media (max-width: 575px)": {
              ".btn": {
                "white-space": "normal !important",
                "max-width": "100%"
              }
            },
            "@media (max-width: 767px)": {
              ".services-grid, .team-grid, .transparency-grid, .pillars-grid, .three-column-grid, .grid-3, .grid-2, .faq-grid, .survival-grid, .portal-grid-2, .city-directory-grid, .details-cards-stack, .two-column-grid, .levels-grid, .cert-grid, .benefits-grid, .links-grid, .timeline-wrapper": {
                "display": "flex !important",
                "flex-wrap": "nowrap !important",
                "flex-direction": "row !important",
                "grid-template-columns": "none !important",
                "gap": "12px !important",
                "overflow-x": "auto",
                "overscroll-behavior-x": "contain",
                "scroll-snap-type": "x mandatory",
                "padding": "4px 2px 14px !important",
                "scrollbar-width": "none"
              },
              ".services-grid::-webkit-scrollbar, .team-grid::-webkit-scrollbar, .transparency-grid::-webkit-scrollbar, .pillars-grid::-webkit-scrollbar, .three-column-grid::-webkit-scrollbar, .grid-3::-webkit-scrollbar, .grid-2::-webkit-scrollbar, .faq-grid::-webkit-scrollbar, .survival-grid::-webkit-scrollbar, .portal-grid-2::-webkit-scrollbar, .city-directory-grid::-webkit-scrollbar, .details-cards-stack::-webkit-scrollbar, .two-column-grid::-webkit-scrollbar, .levels-grid::-webkit-scrollbar, .cert-grid::-webkit-scrollbar, .benefits-grid::-webkit-scrollbar, .links-grid::-webkit-scrollbar, .timeline-wrapper::-webkit-scrollbar": {
                "display": "none"
              },
              ".services-grid > *, .team-grid > *, .transparency-grid > *, .pillars-grid > *, .three-column-grid > *, .grid-3 > *, .grid-2 > *, .faq-grid > *, .survival-grid > *, .portal-grid-2 > *, .city-directory-grid > *, .details-cards-stack > *, .two-column-grid > *, .levels-grid > *, .cert-grid > *, .benefits-grid > *, .links-grid > *, .timeline-wrapper > *": {
                "flex": "0 0 84% !important",
                "max-width": "84% !important",
                "min-width": "0",
                "margin": "0 !important",
                "scroll-snap-align": "start"
              },
              ".timeline-wrapper::before": {
                "display": "none !important"
              },
              ".metrics-section, .services-section, .process-section, .region-section, .team-section, .transparency-section, .cta-section": {
                "padding-top": "44px !important",
                "padding-bottom": "44px !important"
              },
              ".metrics-grid": {
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr) !important",
                "gap": "10px !important"
              },
              ".word-grid": {
                "max-height": "62vh",
                "overflow-y": "auto",
                "overscroll-behavior": "contain",
                "padding-right": "4px"
              },
              ".metrics-grid > *": {
                "min-width": "0",
                "padding": "18px 10px !important"
              },
              ".metrics-grid .metric-value": {
                "font-size": "2rem !important"
              },
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            },
            "@media (max-width: 991px)": {
              ".guide-block > .mbr-section-btn": {
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"guide-executive-section\" id=\"services-guide\">\n    <div class=\"executive-container\">\n        \n        <!-- Header -->\n        <header class=\"guide-header\">\n            <span class=\"header-tag\">НАШІ ПОСЛУГИ</span>\n            <h1 class=\"header-title\">Чим ми насправді займаємося</h1>\n            <p class=\"header-lead\">\n                Комплексна соціальна підтримка для родин з України у Північній Баварії — безкоштовно, залежно від нашої завантаженості та можливостей.\n            </p>\n        </header>\n\n        <!-- General Disclaimer / Notice -->\n        <div class=\"disclaimer-banner\">\n            <div class=\"disclaimer-icon\">\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg>\n            </div>\n            <div class=\"disclaimer-text\">\n                <strong>Важливе зауваження:</strong> Перелічені нижче послуги надаються на волонтерських засадах і залежать від нашої завантаженості та можливостей у конкретний момент. У кожному випадку ми прагнемо чесно й одразу сказати, що є реалістичним. Ми вважаємо, що краще дати чесну та швидку відповідь, ніж залишати вас із марними очікуваннями.\n            </div>\n        </div>\n\n        <!-- Section 1: Housing & Jobcenter (The Big Pillars) -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg>\n                </span> \n                Житло та фінансова підтримка\n            </h2>\n            \n            <!-- Housing Card -->\n            <div class=\"guide-card\">\n                <div class=\"card-header\">\n                    <h3>Пошук житлових рішень</h3>\n                    <span class=\"status-tag info\">Основна послуга</span>\n                </div>\n                <p>Частина квартир перебуває під безпосереднім управлінням у межах нашої ініціативи. В інших випадках ми допомагаємо знайти відповідне житло через орендодавців та управляючі компанії регіону й координуємо процес — пояснюємо орендодавцю всі деталі, залученість Jobcenter та які саме документи від нього потрібні.</p>\n                \n                <div class=\"card-details-grid\">\n                    <div class=\"detail-box\">\n                        <h4>Для кого це?</h4>\n                        <p>Для родин та приватних осіб, які вже перебувають у регіоні нашої діяльності або планують сюди переїхати.</p>\n                    </div>\n                    <div class=\"detail-box\">\n                        <h4>Що вказати у вашому зверненні:</h4>\n                        <p>Кількість осіб та вік дітей, місто, де ви зараз перебуваєте, часові рамки, коли потрібне рішення, та ваш статус у Jobcenter (якщо є).</p>\n                    </div>\n                </div>\n\n                <div class=\"rule-box danger-rule\">\n                    <div class=\"rule-header\">\n                        <svg class=\"rule-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line></svg>\n                        <h3>Важливо знати</h3>\n                    </div>\n                    <p>Ми не можемо гарантувати обов'язковий пошук квартири. Наявність вільних варіантів суттєво змінюється залежно від періоду та міста, і іноді відповідного житла в регіоні просто немає. Ми повідомляємо про це одразу і не змушуємо вас марно чекати.</p>\n                </div>\n            </div>\n\n            <!-- Jobcenter Card -->\n            <div class=\"guide-card\">\n                <div class=\"card-header\">\n                    <h3>Підтримка з Jobcenter</h3>\n                    <span class=\"status-tag info\">Бюрократична допомога</span>\n                </div>\n                <p>Загальний супровід процесів, допомога в розумінні отриманих листів, підготовка до зустрічей, координація з вашим куратором (Caseworker), залучення перекладача за потреби та підтримка під час процедури затвердження житла.</p>\n                \n                <div class=\"detail-box detail-box-spacing\">\n                    <h4>Що це включає на практиці:</h4>\n                    <p>Пояснення того, що саме від вас вимагають, визначення відсутніх документів, розшифровка змісту отриманих листів та роз'яснення, чому важливо відповісти вчасно.</p>\n                </div>\n\n                <div class=\"rule-box info-rule\">\n                    <div class=\"rule-header\">\n                        <svg class=\"rule-icon\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"></path><path d=\"M9 18h6\"></path><path d=\"M10 22h4\"></path></svg>\n                        <h3>Важливо знати</h3>\n                    </div>\n                    <p>Усі рішення приймаються виключно Jobcenter. Ми не гарантуємо схвалення виплат, їхній розмір чи терміни розгляду, а також не надаємо юридичних консультацій. Наше завдання — переконатися, що ви розумієте процес і підготовлені до нього.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 2: Registrations & Education (2 Columns) -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 10v6M2 10l10-5 10 5-10 5z\"></path><path d=\"M6 12v5c3 3 9 3 12 0v-5\"></path></svg>\n                </span> \n                Реєстрація та освіта\n            </h2>\n            \n            <div class=\"two-column-grid\">\n                <!-- Anmeldung -->\n                <div class=\"guide-subcard\">\n                    <h3>Anmeldung (Реєстрація місця проживання)</h3>\n                    <p>Реєстрація адреси в місцевих органах влади — це базовий крок, від якого залежить майже все інше: медична страховка, відкриття банківського рахунку, виплати, запис до школи та іноді навіть офіційний договір оренди.</p>\n                    <p>Ми пояснюємо базові вимоги, допомагаємо записатися на прийом (Termin) до державних установ та підказуємо, як діяти у разі відсутності певного документа або якщо найближчий запис доступний лише задовго.</p>\n                    <div class=\"notice-highlight\">\n                        <strong>Важливо:</strong> Вимоги та терміни різняться залежно від міста та установи. Наша інформація має загальний характер і базується на місцевому досвіді; її необхідно перевіряти в конкретному органі влади.\n                    </div>\n                </div>\n\n                <!-- Schools -->\n                <div class=\"guide-subcard\">\n                    <h3>Запис до школи</h3>\n                    <p>Допомога у підборі навчального закладу відповідно до віку та рівня володіння мовою вашої дитини, пояснення переліку документів, переклад та координація зі школою.</p>\n                    <p>У багатьох випадках також потрібна попередня розмова зі шкільним персоналом щодо мовних класів або спеціальної навчальної підтримки.</p>\n                    <div class=\"notice-highlight\">\n                        <strong>Важливо:</strong> Розподіл по школах здійснюється органами влади та самими навчальними закладами. Ми можемо супроводжувати та пояснювати процес, але не впливаємо на остаточне рішення.\n                    </div>\n                </div>\n\n                <!-- Kindergarten -->\n                <div class=\"guide-subcard\">\n                    <h3>Запис до дитячого садка (Kindergarten)</h3>\n                    <p>Кількість місць у дитячих садках регіону обмежена, а в деяких містах черга може тривати місяцями. Ми допомагаємо розібратися з процедурою, подати заявку, координуємо зв'язок та шукаємо альтернативи в сусідніх містах.</p>\n                    <div class=\"rule-box mail-rule subcard-rule\">\n                        <strong>Важливо:</strong> Ми не можемо гарантувати наявність місця. У певні періоди чесна відповідь полягає в тому, що вільних місць наразі немає.\n                    </div>\n                </div>\n\n                <!-- Translation -->\n                <div class=\"guide-subcard\">\n                    <h3>Українсько-німецький переклад</h3>\n                    <p>Залучення перекладачів для особливо важливих зустрічей — у Jobcenter, органах влади, школі, у лікаря — та для перекладу документів, зміст яких потребує абсолютної точності.</p>\n                    <div class=\"notice-highlight\">\n                        <strong>Важливо:</strong> Перекладачі працюють на волонтерських засадах, і їхня доступність залежить від особистого графіку. Чим раніше ви звернетеся, тим вища ймовірність отримати допомогу в потрібний час.\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Section 3: Living & Community (3 Columns) -->\n        <div class=\"guide-block\">\n            <h2 class=\"block-title\">\n                <span class=\"title-icon\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 9v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9\"></path><path d=\"M9 22V12h6v10\"></path><path d=\"M2 10.6L12 2l10 8.6\"></path></svg>\n                </span> \n                Побут, спільнота та тривала підтримка\n            </h2>\n            \n            <div class=\"three-column-grid\">\n                <!-- Furniture -->\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 12V8H4v4\"></path><path d=\"M2 12h20v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-4z\"></path><path d=\"M6 18v3\"></path><path d=\"M18 18v3\"></path></svg>\n                    </div>\n                    <h3>Базові меблі та обладнання</h3>\n                    <p>У певних випадках ми можемо допомогти з базовими меблями, побутовими речами та першочерговим обладнанням — ліжка, стіл, стільці, кухонне приладдя. Це повністю залежить від того, що було передано як пожертва та є в наявності, іноді за сприяння інших родин спільноти, які переїхали або оновили речі.</p>\n                    <p class=\"mini-card-note\"><strong>Примітка:</strong> Йдеться про функціональні вживані речі (Second-hand), а не про нові товари; наявність суттєво змінюється протягом року.</p>\n                </div>\n\n                <!-- Post-Move-In -->\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"7.5\" cy=\"15.5\" r=\"5.5\"></circle><path d=\"m21 2-9.6 9.6\"></path><path d=\"m15.5 7.5 3 3L22 7l-3-3\"></path></svg>\n                    </div>\n                    <h3>Підтримка після переїзду</h3>\n                    <p>Наша допомога не закінчується після отримання ключів. Ми продовжуємо супроводжувати вас у підключенні електроенергії, газу та інтернету, оформленні медичного страхування, розшифровці офіційних листів на нову адресу, взаємодії з сусідами та роз'ясненні правил проживання в Німеччині — питанні, яке здається дрібницею, поки не виникають реальні непорозуміння.</p>\n                </div>\n\n                <!-- Community -->\n                <div class=\"guide-mini-card\">\n                    <div class=\"mini-icon\">\n                        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg>\n                    </div>\n                    <h3>Зв'язок зі спільнотою</h3>\n                    <p>Ми сприяємо організації зустрічей, місцевих WhatsApp-груп, обміну речами та налагодженню контактів між родинами, які живуть тут довше, та новоприбулими. Часто найкращу відповідь на запитання дає саме та родина, яка пройшла цей шлях пів року тому в тому ж самому місті.</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- Extreme Cases -->\n        <div class=\"guide-block extreme-block\">\n            <div class=\"guide-card extreme-card\">\n                <div class=\"extreme-header\">\n                    <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m4.93 4.93 4.24 4.24\"></path><path d=\"m14.83 9.17 4.24-4.24\"></path><path d=\"m14.83 14.83 4.24 4.24\"></path><path d=\"m9.17 14.83-4.24 4.24\"></path><circle cx=\"12\" cy=\"12\" r=\"4\"></circle></svg>\n                    <h3>Допомога у надзвичайних ситуаціях</h3>\n                </div>\n                <p>У виняткових випадках — таких як гостра нестача продуктів харчування, базового одягу чи інших невідкладних потреб — допомога надається відповідно до наших можливостей та конкретних обставин справи. Кожна така ситуація розглядається індивідуально та суворо конфіденційно.</p>\n            </div>\n        </div>\n\n        <!-- Section 4: Summary & CTA -->\n        <div class=\"guide-block\">\n            <div class=\"guide-card summary-cta-card\">\n                <h3 class=\"summary-title\">Підсумок та важливі вказівки</h3>\n                <p class=\"summary-text\">\n                    <strong>Щодо всіх послуг:</strong> Соціальна підтримка надається повністю безкоштовно та виключно на волонтерських засадах. Можливі сторонні платежі на користь державних органів, постачальників послуг або орендодавців — вони сплачуються їм напряму і за жодних обставин не проходять через нашу ініціативу.\n                </p>\n                <p class=\"summary-tagline\">\n                    Не впевнені, чи ми є відповідною адресою для вашого запитання? Все одно напишіть нам — ми чесно скажемо, чи зможемо допомогти.\n                </p>\n                \n                <!-- BUTTONS (Mobirise Compatible) -->\n                <div class=\"mbr-section-btn cta-buttons-wrapper\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\"><a class=\"btn custom-btn whatsapp-btn display-4 btn-warning\" href=\"request-assistance.html\" data-app-placeholder=\"Type Text\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path></svg>\n                        WhatsApp Анна\n                    </a> \n                    <a class=\"btn btn-primary custom-btn outline-btn display-4\" href=\"living-in-germany.html\" data-app-placeholder=\"Type Text\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z\"></path><path d=\"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\"></path></svg>\n                        Гайд: Життя в Німеччині\n                    </a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "slider01-2c",
          "_isUserblock": true,
          "_cid": "vqpqVIly1Q",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 56px",
                "@media (max-width: 992px)": {
                  "padding": "0 22px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 22px"
              }
            },
            ".row": {
              "justify-content": "space-between"
            },
            ".logo-wrapper": {
              "margin-bottom": "1.5rem",
              "img": {
                "width": "(@logoWidth * 1px)",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "contain"
              }
            },
            ".content-wrapper": {
              "margin-bottom": "32px",
              ".mbr-section-title": {
                "margin-bottom": "32px"
              },
              ".mbr-text": {
                "margin-bottom": "32px"
              }
            },
            ".lists-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr 1fr 1fr",
              "gap": "1rem",
              "margin-bottom": "32px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr 1fr 1fr"
              },
              "@media (max-width: 768px)": {
                "grid-template-columns": "1fr"
              },
              ".list-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "8px",
                    "cursor": "pointer",
                    "transition": "all 0.3s ease-in-out",
                    "&:first-child": {
                      "color": "@activeList"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeList"
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "& when (@showBorder)": {
                "border-top": "1px solid @border",
                "padding-top": "16px"
              },
              "& when not (@showSocial)": {
                "justify-content": "center"
              },
              "& when not (@showCopy)": {
                "justify-content": "center"
              },
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".social-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "16px"
                },
                ".social-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  ".soc-item": {
                    "margin-left": "32px",
                    "&:first-child": {
                      "margin-left": "0"
                    },
                    "a": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "font-size": "16px",
                        "color": "@socColor",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "width": "50%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ff5753"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#635d60"
            },
            ".mbr-copy": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".list, .item-wrap": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            },
            "a[href*=\"thebwas.com\"]": {
              "text-decoration": "underline",
              "text-underline-offset": "3px"
            },
            ".soc-item a": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "min-width": "44px",
              "min-height": "44px"
            },
            ".item-wrap a": {
              "word-break": "normal !important",
              "overflow-wrap": "normal !important",
              "hyphens": "auto",
              "-webkit-hyphens": "auto"
            },
            "@media (max-width: 767px)": {
              ".lists-wrapper": {
                "display": "grid !important",
                "grid-template-columns": "minmax(0, 1fr) minmax(0, 1fr)",
                "column-gap": "16px"
              },
              ".lists-wrapper .list-wrap": {
                "width": "auto !important",
                "max-width": "none !important",
                "margin": "0 !important"
              },
              ".lists-wrapper .item-wrap a": {
                "overflow-wrap": "break-word !important"
              }
            },
            "@media (min-width: 768px)": {
              ".lists-wrapper": {
                "display": "grid !important",
                "grid-template-columns": "repeat(4, minmax(0, 1fr))",
                "column-gap": "16px"
              },
              ".lists-wrapper .list-wrap": {
                "width": "auto !important",
                "max-width": "none !important",
                "margin": "0 !important",
                "min-width": "0"
              },
              ".lists-wrapper .item-wrap a": {
                "overflow-wrap": "break-word !important"
              }
            }
          },
          "_name": "footer01",
          "_sourceTheme": "scalem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 scalem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"50\" max=\"400\" step=\"10\" value=\"150\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Lists\" name=\"showLists\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"list\" min=\"1\" max=\"5\" step=\"1\" value=\"4\" condition=\"showLists\">\n        <input type=\"color\" title=\"List Active Color\" value=\"#ffffff\" name=\"activeList\" condition=\"showLists\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#ffffff\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Social Active Color\" value=\"#FF5753\" name=\"active\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#635d60\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#0c2c68\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#292325\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            \n            <!-- עמודת טקסט וכותרת ראשית -->\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showTitle || showText || showButtons || showLogo\">\n                <div class=\"content-wrapper\">\n                    <!-- תוספת המקום ללוגו -->\n                    <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                        <a href=\"index.html\">\n                            <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" alt=\"ZusammenLeben\" width=\"171\" height=\"171\">\n                        </a>\n                    </div>\n\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\"><b>\n                        ZUSAMMENLEBEN\n                    </b></h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                        Підтримка інтеграції, пошук житла та зв'язок зі спільнотою для новоприбулих і місцевих жителів регіону.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"Contact.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-phone mbr-iconfont mbr-iconfont-btn\"></span>\n                            Зв'язатися з нами\n                        </a></div>\n                </div>\n            </div>\n\n            <!-- עמודות הקישורים -->\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLists\">\n                <div class=\"lists-wrapper\">\n                    <div class=\"list-wrap\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Головна</a></li>\n                            <li class=\"item-wrap\"><a href=\"family-stories.html\" class=\"text-white\">Історії родин</a></li>\n                            <li class=\"item-wrap\"><a href=\"services.html\" class=\"text-white\">Послуги</a></li>\n                            <li class=\"item-wrap\"><a href=\"request-assistance.html\" class=\"text-white\">Запит на допомогу</a></li>\n                            <li class=\"item-wrap\"><a href=\"community.html\" class=\"text-white\">Спільнота</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"living-in-germany.html\" class=\"text-white\">Життя в Німеччині</a></li>\n                            <li class=\"item-wrap\"><a href=\"glossary.html\" class=\"text-white\">Глосарій</a></li>\n                            <li class=\"item-wrap\"><a href=\"learning-german.html\" class=\"text-white\">Вивчення німецької</a></li>\n                            <li class=\"item-wrap\"><a href=\"refugee-rights.html\" class=\"text-white\">Права біженців</a></li>\n                            <li class=\"item-wrap\"><a href=\"guides.html\" class=\"text-white\">Посібники</a></li>\n                            <li class=\"item-wrap\"><a href=\"anna-shishoili.html\" class=\"text-white\">Анна Чеішвілі</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 2\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"how-to-help.html\" class=\"text-white\">Як ви можете допомогти</a></li>\n                            <li class=\"item-wrap\"><a href=\"social-activity.html\" class=\"text-white\">Соціальна діяльність</a></li>\n                            <li class=\"item-wrap\"><a href=\"faq.html\" class=\"text-white\">Часті запитання (FAQ)</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Регіони діяльності</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 3\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"emergency.html\" class=\"text-white\">Екстрена допомога</a></li>\n                            <li class=\"item-wrap\"><a href=\"Contact.html\" class=\"text-white\">Контакти</a></li>\n                            <li class=\"item-wrap\"><a href=\"https://wa.me/380637004615\" class=\"text-white\" target=\"_blank\" rel=\"noopener\">Підтримка у WhatsApp</a></li>\n                            <li class=\"item-wrap\"><a href=\"areasweserve.html\" class=\"text-white\">Локація</a></li>\n                            <li class=\"item-wrap\"><a href=\"impressum.html\" class=\"text-white\">Вихідні дані</a></li>\n                            <li class=\"item-wrap\"><a href=\"privacy.html\" class=\"text-white\">Політика конфіденційності</a></li>\n                            <li class=\"item-wrap\"><a href=\"usingtheweb.html\" class=\"text-white\">Умови використання</a></li>\n                        </ul>\n                    </div>\n                    <div class=\"list-wrap\" mbr-if=\"list > 4\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"privacy.html\" class=\"text-white\">Політика конфіденційності</a></li>\n                            <li class=\"item-wrap\"><a href=\"usingtheweb.html\" class=\"text-white\">Умови використання</a></li>\n                            <li class=\"item-wrap\"><a href=\"impressum.html\" class=\"text-white\">Вихідні дані (Impressum)</a></li>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-white\">Офіційний сайт</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- אזור זכויות יוצרים ורשתות חברתיות -->\n            <div class=\"col-12\" mbr-if=\"showSocial || showCopy\">\n                <div class=\"copy-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://wa.me/380637004615\" target=\"_blank\" rel=\"noopener\" aria-label=\"WhatsApp\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-whatsapp\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"mailto:zusammenleben.de@gmail.com\" aria-label=\"E-Mail\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-telegram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"#\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mbr-copy mbr-fonts-style\" data-app-selector=\".mbr-copy, .social-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\">\n                        © Copyright 2026 Zusammenleben - Всі права захищені · Сайт створив <a href=\"https://thebwas.com/\" class=\"text-white\">Amit Shechter</a>\n                    </p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
