    "guide-finding-apartment.html": {
      "settings": {
        "title": "Пошук житла у Верхній Франконії з Jobcenter",
        "order": "17",
        "meta_descr": "Крок за кроком: як українським родинам знайти квартиру у Верхній Франконії, отримати погодження оренди від Jobcenter і уникнути типових помилок.",
        "header_custom": "<link rel=\"alternate\" hreflang=\"en\" href=\"https://zusammenleben-ukraine.de/guide-finding-apartment.html\" />\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://zusammenleben-ukraine.de/de/guide-finding-apartment.html\" />\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://zusammenleben-ukraine.de/ua/guide-finding-apartment.html\" />\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://zusammenleben-ukraine.de/guide-finding-apartment.html\" />\n<link rel=\"canonical\" href=\"https://zusammenleben-ukraine.de/ua/guide-finding-apartment.html\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:site_name\" content=\"ZusammenLeben\" />\n<meta property=\"og:title\" content=\"Пошук житла у Верхній Франконії з Jobcenter\" />\n<meta property=\"og:description\" content=\"Крок за кроком: як українським родинам знайти квартиру у Верхній Франконії, отримати погодження оренди від Jobcenter і уникнути типових помилок.\" />\n<meta property=\"og:url\" content=\"https://zusammenleben-ukraine.de/ua/guide-finding-apartment.html\" />\n<meta property=\"og:locale\" content=\"uk_UA\" />\n<meta property=\"og:image\" content=\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\" />\n<meta name=\"twitter:card\" content=\"summary\" />\n<link rel=\"stylesheet\" href=\"assets/zl/zl.css\" />\n<script src=\"assets/zl/zl.js\" defer></script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"Пошук житла у Верхній Франконії з підтримкою Jobcenter\",\"description\":\"Крок за кроком: як українським родинам знайти квартиру у Верхній Франконії, отримати погодження оренди від Jobcenter і уникнути типових помилок.\",\"inLanguage\":\"uk\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"url\":\"https://zusammenleben-ukraine.de/ua/guide-finding-apartment.html\",\"mainEntityOfPage\":\"https://zusammenleben-ukraine.de/ua/guide-finding-apartment.html\",\"wordCount\":891,\"author\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\"},\"publisher\":{\"@id\":\"https://zusammenleben-ukraine.de/#org\",\"@type\":\"NGO\",\"name\":\"ZusammenLeben\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://zusammenleben-ukraine.de/assets/images/gemini-generated-image-3uwvbn3uwvbn3uwv.png-171x171.png\"}},\"about\":[\"Ukraine\",\"Germany\",\"Upper Franconia\"]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Чи можна підписати договір до погодження Jobcenter?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Можна, але ризик на вас. Якщо Jobcenter згодом вважатиме оренду зависокою, він може оплатити лише належну частину. Завжди спершу отримуйте письмове погодження.\"}},{\"@type\":\"Question\",\"name\":\"Хто платить заставу?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Здебільшого Jobcenter надає заставу як позику, яку повертають невеликими частинами з виплат.\"}},{\"@type\":\"Question\",\"name\":\"Як швидко треба зареєструвати адресу?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Протягом двох тижнів після заселення, у бюро громадян вашого міста, з підтвердженням від орендодавця.\"}},{\"@type\":\"Question\",\"name\":\"Чи можна переїхати до іншого району?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Лише якщо у вашому дозволі немає умови щодо місця проживання або якщо відомство у справах іноземців погодить зміну. Запитайте до пошуку в іншому районі.\"}},{\"@type\":\"Question\",\"name\":\"Що робити, якщо в квартирі немає кухні?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"У Німеччині це звично. Запитайте в Jobcenter про початкове облаштування до покупки або в нас про подароване кухонне приладдя.\"}}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Головна\",\"item\":\"https://zusammenleben-ukraine.de/ua/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Посібники\",\"item\":\"https://zusammenleben-ukraine.de/ua/guides.html\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Пошук житла у Верхній Франконії з підтримкою Jobcenter\",\"item\":\"https://zusammenleben-ukraine.de/ua/guide-finding-apartment.html\"}]}]}</script>"
      },
