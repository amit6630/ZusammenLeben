            },
            ".zl-meta": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "14px",
              "font-size": "14px",
              "color": "#475569",
              "margin-bottom": "26px"
            },
            ".zl-card": {
              "background": "#fff",
              "border": "1px solid #e2e8f0",
              "border-radius": "18px",
              "padding": "clamp(22px, 3.4vw, 40px)",
              "box-shadow": "0 10px 30px -18px rgba(15, 23, 42, .25)"
            },
            ".zl-body h2": {
