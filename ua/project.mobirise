            },
            ".guide-subcard h3": {
              "font-size": "1.15rem",
              "font-weight": "800",
              "margin": "0 0 12px 0",
              "text-transform": "uppercase",
              "letter-spacing": "0.5px"
            },
            ".guide-subcard p": {
              "font-size": "0.95rem",
              "color": "#475569",
              "margin-bottom": "0"
            },
            ".detail-box h4": {
